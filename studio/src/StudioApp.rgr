; ==============================================================================
; StudioApp — Sliqtly Game Studio, the window
; ==============================================================================
;
;   ┌──────────────────────────────────────────────────────────────────────┐
;   │ Sliqtly Game Studio · project · game        [Tallenna] [Käynnistä]   │
;   ├──────────┬──────────────────────────────────────┬────────────────────┤
;   │ games    │ code editor (Ranger's own,           │ the game, running  │
;   │ files    │ JS/TSX checked as you type)          │ natively           │
;   │          ├──────────────────────────────────────┤                    │
;   │          │ log                                  │                    │
;   └──────────┴──────────────────────────────────────┴────────────────────┘
;
; The project is a folder on disk. The Studio never copies it anywhere: an AI
; agent in a terminal (Claude Code, Cursor, OpenCode) edits the same files,
; and the Studio notices within a second, reloads the open file and restarts
; the game. Ctrl+S saves and restarts at once.
;
;   sliqtly-studio <folder> [--game id] [--file rel] [--frames N]
;                           [--shot out.png] [--dump] [--scene name]
;                           [--speed N] [--hidden] [--size WxH]
;
; --frames N runs N frames at a fixed 60 fps and quits; --shot saves the
; window then, --dump prints the last frame's draw commands. With xvfb-run
; (Linux) this needs no screen: an AI agent can run it and look at the PNG.
; ==============================================================================

Import "../../datagrid/src/script/ScriptEditor.rgr"
Import "../../datagrid/src/script/lang/EditorLanguage.rgr"
Import "../../datagrid/src/script/lang/JsLanguage.rgr"
Import "../../game_engine/framebuffer.rgr"
Import "../../game_engine/ui/UIContext.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGColor.rgr"
Import "../native/gfx_studio.rgr"
Import "StudioImages.rgr"
Import "StudioPainter.rgr"
Import "GamePreview.rgr"
Import "CartoonEditor.rgr"

class StudioFile {
    def rel:string ""
    def size:int 0
    def text:boolean false
}

; A comment left on the game: what the person (or an agent) saw and wants.
; Kept in <project>/.studio/comments.jsonl, one JSON object per line, with a
; screenshot of the game area in .studio/shots/ (a dot folder: never mounted
; into the engine, never listed as a game file).
class StudioComment {
    def id:string ""
    def time:string ""
    def game:string ""
    def scene:string ""
    def frame:int 0
    def text:string ""
    def shot:string ""
    def done:boolean false
    def note:string ""
}

; A clickable place drawn this frame, and what a click there does.
class StudioHit {
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    def action:string ""
}

class StudioApp {
    def W:int 1280
    def H:int 800
    def topH:int 40
    def leftW:int 220
    def logH:int 130
    def rowH:int 22
    def previewW:int 400
    def fontFamily:string "Open Sans"
    def fontDir:string "fonts"

    def canvas:SoftCanvas (new SoftCanvas)
    def ctx:UIContext (new UIContext)
    def painter:StudioPainter (new StudioPainter)
    def editor:ScriptEditor (new ScriptEditor)
    def languages:LanguageRegistry (new LanguageRegistry)
    def preview:GamePreview (new GamePreview)
    ; the comic editor ("Sarjakuva" in the top bar)
    def cartoon:CartoonEditor (new CartoonEditor)
    def cartoonBrief:string ""
    ; the Nano Banana job whose reference screenshot is taken this frame
    def nbJob:string ""
    def nbPromptText:string ""
    def nbRel:string ""

    def files:[StudioFile]
    def fileScroll:int 0
    def openRel:string ""
    def openDisk:string ""
    def openStamp:double 0.0
    def savedVersion:int -1
    def status:string ""
    def logScroll:int 0
    ; "editor" or "game": where the keys go
    def focus:string "editor"
    def lastMouseDown:boolean false
    def lastFrameMs:double 0.0
    def frameMsAvg:double 16.0
    def hasWindow:boolean false
    ; the bar above the game: speed, pause, step and the game's scenes
    def toolH:int 34
    def hits:[StudioHit]

    ; the asset view: a picture shown where the editor is
    def viewSrc:string ""
    def viewDisk:string ""
    def viewTitle:string ""
    def viewComment:string ""
    ; resource folders (studio.json) opened in the left panel, and their files
    def openMounts:[string:boolean]
    def mountFiles:[string:[string]]

    ; comments
    def comments:[StudioComment]
    def commentsStamp:double 0.0
    def commentMode:boolean false
    def commentText:string ""
    def draft:StudioComment (new StudioComment)
    ; a screenshot to take once this frame is drawn
    def shotPath:string ""
    def shotArea:string "game"
    def shotFor:string ""
    def frameNo:int 0

    ; MCP over stdio
    def mcp:boolean false
    def mcpQuit:boolean false

    def bg:EVGColor (EVGColor.rgb(15 16 22))
    def panel:EVGColor (EVGColor.rgb(22 24 33))
    def bar:EVGColor (EVGColor.rgb(30 32 44))
    def line:EVGColor (EVGColor.rgb(48 52 70))
    def ink:EVGColor (EVGColor.rgb(206 214 234))
    def muted:EVGColor (EVGColor.rgb(118 128 154))
    def accent:EVGColor (EVGColor.rgb(122 162 247))
    def good:EVGColor (EVGColor.rgb(158 206 106))
    def warn:EVGColor (EVGColor.rgb(224 175 104))

    Constructor () {
    }

    ; --- start ---------------------------------------------------------------------
    fn initFonts:void () {
        canvas.init(4 4)
        ctx.attach(canvas)
        ctx.tr.addFontDir(fontDir)
        def ok:boolean (ctx.tr.loadFont(fontFamily "Open_Sans/OpenSans-Regular.ttf"))
        ctx.tr.fm.loadFont("Open_Sans/OpenSans-Bold.ttf")
        ctx.tr.fm.loadFont("Noto_Sans/NotoSans-Regular.ttf")
        ctx.tr.fm.loadFont("Noto_Sans/NotoSans-Bold.ttf")
        ; emoji as outlines (games use them for icons); colour emoji are not drawn
        ctx.tr.fm.loadFont("Noto_Emoji/NotoEmoji-Regular.ttf")
        if (ok == false) {
            print ("[studio] no fonts in " + fontDir + " (set SLIQTLY_STUDIO_FONTS)")
        }
        painter.fontFamily = fontFamily
        cartoon.setText(ctx.tr)
        languages.add((new JsLanguage))
    }

    fn openProject:void (folder:string) {
        preview.open(folder)
        this.loadComments()
        this.refreshFiles()
        this.openFirstFile()
        status = preview.status
    }

    ; the folder of the game being shown
    fn gameDir:string () {
        if preview.single {
            return preview.root
        }
        return (GamePreview.joinPath(preview.root preview.gameId))
    }

    sfn isTextFile:boolean (rel:string) {
        def e:string (GamePreview.extOf(rel))
        def kinds:[string] ([] _:string ("tsx" "ts" "jsx" "js" "css" "json" "md" "txt" "html" "svg" "rgr" "yml" "yaml" "glsl"))
        return ((indexOf kinds e) >= 0)
    }

    fn refreshFiles:void () {
        clear files
        def listing:string (sh_list_files (this.gameDir()))
        def lines:[string] (strsplit listing "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) "\t")
            if ((array_length parts) >= 2) {
                def f:StudioFile (new StudioFile)
                f.rel = (itemAt parts 0)
                f.size = (?? (to_int (itemAt parts 1)) 0)
                f.text = (StudioApp.isTextFile(f.rel))
                push files f
            }
            i = (i + 1)
        }
    }

    fn openFirstFile:void () {
        def want:[string] ([] _:string ("game.tsx" "game.ts" "game.jsx" "game.js" "game.json"))
        def i:int 0
        while (i < (array_length want)) {
            def rel:string (itemAt want i)
            if ((sh_exists (GamePreview.joinPath((this.gameDir()) rel))) == 1) {
                this.openFile(rel)
                return
            }
            i = (i + 1)
        }
        this.openFile("")
    }

    fn dirty:boolean () {
        return (((strlen openRel) > 0) && (editor.buf.version != savedVersion))
    }

    fn openFile:void (rel:string) {
        if (this.dirty()) {
            this.save()
        }
        openRel = rel
        if ((strlen rel) == 0) {
            openDisk = ""
            editor.init("")
            savedVersion = editor.buf.version
            return
        }
        openDisk = (GamePreview.joinPath((this.gameDir()) rel))
        editor.init((sh_read_text openDisk))
        editor.setLanguage((languages.forFile(rel)))
        editor.focused = true
        focus = "editor"
        savedVersion = editor.buf.version
        openStamp = (sh_file_mtime openDisk)
    }

    fn save:void () {
        if ((strlen openDisk) == 0) {
            return
        }
        def ok:int (sh_write_text openDisk (editor.text()))
        if (ok == 1) {
            savedVersion = editor.buf.version
            openStamp = (sh_file_mtime openDisk)
            status = ("saved " + openRel)
            def changed:int (preview.syncFiles(false))
            if (changed > 0) {
                preview.restart()
            }
        } {
            status = ("could not save " + openDisk)
        }
    }

    ; Someone else (an AI agent, git, another editor) changed the open file.
    fn checkOpenFile:void () {
        if ((strlen openDisk) == 0) {
            return
        }
        def now:double (sh_file_mtime openDisk)
        if (now == openStamp) {
            return
        }
        openStamp = now
        if (this.dirty()) {
            status = (openRel + " changed on disk; you have unsaved edits (Ctrl+S keeps yours)")
            return
        }
        def caretLine:int editor.sel.caret.line
        def scroll:int editor.layout.scrollLine
        editor.init((sh_read_text openDisk))
        editor.setLanguage((languages.forFile(openRel)))
        savedVersion = editor.buf.version
        editor.moveCaret(caretLine 0 false)
        editor.layout.scrollLine = scroll
        status = ("reloaded " + openRel + " from disk")
    }

    ; --- layout --------------------------------------------------------------------
    fn layoutPreview:void () {
        def pw:int (to_int ((to_double W) * 0.34))
        if (pw > 480) {
            pw = 480
        }
        if (pw < 240) {
            pw = 240
        }
        previewW = pw
        toolH = (this.toolbarHeight())
        preview.setPanel((to_double (W - pw)) (to_double (topH + toolH)) (to_double pw) (to_double ((H - topH) - toolH)))
    }

    ; --- the bar above the game ---------------------------------------------------------
    fn chipW:double (label:string) {
        return ((ctx.tr.measureWidth(label 12.0)) + 16.0)
    }

    ; Lays the bar out (paint false: only measures). Answers its height.
    fn layoutToolbar:int (dl:EVGDisplayList paint:boolean) {
        def x0:double (to_double ((W - previewW) + 6))
        def xmax:double (to_double (W - 6))
        def x:double x0
        def y:double (to_double (topH + 5))
        def labels:[string]
        def actions:[string]
        if preview.paused {
            push labels "Jatka"
            push actions "pause"
            push labels "Askel"
            push actions "step"
        } {
            push labels "Tauko"
            push actions "pause"
        }
        def speeds:[int] ([] _:int (1 4 16 64))
        def si:int 0
        while (si < 4) {
            def sp:int (itemAt speeds si)
            push labels ("x" + (to_string sp))
            push actions ("speed:" + (to_string sp))
            si = (si + 1)
        }
        push labels "Kommentoi"
        push actions "comment"
        def ci:int 0
        while (ci < (array_length preview.scenes)) {
            def name:string (itemAt preview.scenes ci)
            push labels name
            push actions ("scene:" + name)
            ci = (ci + 1)
        }
        def i:int 0
        while (i < (array_length labels)) {
            def label:string (itemAt labels i)
            def act:string (itemAt actions i)
            def cw:double (this.chipW(label))
            if (((x + cw) > xmax) && (x > x0)) {
                x = x0
                y = (y + 28.0)
            }
            if paint {
                def on:boolean false
                if (act == ("speed:" + (to_string preview.speed))) {
                    on = true
                }
                if ((act == "pause") && preview.paused) {
                    on = true
                }
                if (act == ("scene:" + preview.currentScene)) {
                    on = true
                }
                def col:EVGColor line
                if (on) {
                    col = (EVGColor.rgb(61 89 161))
                }
                if ((act == "comment") && commentMode) {
                    on = true
                }
                if ((act == "comment") && (on == false)) {
                    col = (EVGColor.rgb(82 64 30))
                }
                if ((indexOf act "scene:") == 0) {
                    if (on == false) {
                        col = (EVGColor.rgb(38 64 52))
                    }
                }
                this.roundRect(dl x y cw 22.0 col 4.0)
                this.text(dl label (x + 8.0) (y + 3.0) 12.0 ink false)
                def hit:StudioHit (new StudioHit)
                hit.x = x
                hit.y = y
                hit.w = cw
                hit.h = 22.0
                hit.action = act
                push hits hit
            }
            x = ((x + cw) + 6.0)
            i = (i + 1)
        }
        return (to_int (((y + 22.0) + 6.0) - (to_double topH)))
    }

    fn toolbarHeight:int () {
        def none:EVGDisplayList (new EVGDisplayList)
        return (this.layoutToolbar(none false))
    }

    fn act:void (action:string) {
        if (action == "save") {
            this.save()
            return
        }
        if (action == "restart") {
            preview.restart()
            status = "restarted"
            return
        }
        if (action == "pause") {
            preview.paused = (preview.paused == false)
            return
        }
        if (action == "step") {
            preview.stepOnce = true
            return
        }
        if ((indexOf action "speed:") == 0) {
            preview.speed = (?? (to_int (substring action 6 (strlen action))) 1)
            return
        }
        if ((indexOf action "scene:") == 0) {
            preview.jump((substring action 6 (strlen action)))
            focus = "game"
            editor.focused = false
            return
        }
        if (action == "comment") {
            this.startComment()
            return
        }
        if (action == "cartoon") {
            this.toggleCartoon((cartoon.active == false))
            return
        }
        if (action == "closeview") {
            this.closeView()
            return
        }
        if ((indexOf action "game:") == 0) {
            if (this.dirty()) {
                this.save()
            }
            this.closeView()
            preview.select((substring action 5 (strlen action)))
            this.refreshFiles()
            this.openFirstFile()
            return
        }
        if ((indexOf action "file:") == 0) {
            this.clickFile((substring action 5 (strlen action)))
            return
        }
        if ((indexOf action "mount:") == 0) {
            this.toggleMount((?? (to_int (substring action 6 (strlen action))) 0))
            return
        }
        if ((indexOf action "res:") == 0) {
            def rest:string (substring action 4 (strlen action))
            def bar:int (indexOf rest ":")
            def mi:int (?? (to_int (substring rest 0 bar)) 0)
            def m:GameMount (itemAt preview.mounts mi)
            def rel:string (substring rest (bar + 1) (strlen rest))
            this.showAsset((m.vfs + "/" + rel) (GamePreview.joinPath(m.disk rel)) (m.label + " / " + rel) (sh_file_size (GamePreview.joinPath(m.disk rel))))
            return
        }
        if ((indexOf action "cshow:") == 0) {
            this.showComment((substring action 6 (strlen action)))
            return
        }
        if ((indexOf action "cdone:") == 0) {
            this.markDone((substring action 6 (strlen action)) "")
            return
        }
    }

    ; --- assets ----------------------------------------------------------------------
    sfn isPicture:boolean (rel:string) {
        def e:string (GamePreview.extOf(rel))
        def kinds:[string] ([] _:string ("png" "jpg" "jpeg" "webp" "gif" "bmp"))
        return ((indexOf kinds e) >= 0)
    }

    fn clickFile:void (rel:string) {
        if (StudioApp.isTextFile(rel)) {
            this.closeView()
            this.openFile(rel)
            return
        }
        def disk:string (GamePreview.joinPath((this.gameDir()) rel))
        this.showAsset(("/games/" + preview.gameId + "/" + rel) disk rel (sh_file_size disk))
    }

    ; A picture in the editor's place; other files only tell their size.
    fn showAsset:void (src:string disk:string title:string size:double) {
        if ((StudioApp.isPicture(disk)) == false) {
            status = (title + " · " + (StudioApp.kb(size)) + " (not a picture or text)")
            return
        }
        viewSrc = src
        viewDisk = disk
        viewComment = ""
        def img:StudioImage (preview.images.get(src disk))
        viewTitle = (title + " · " + (StudioApp.kb(size)))
        if img.ok {
            viewTitle = (viewTitle + " · " + (to_string img.width) + " x " + (to_string img.height) + " px")
        } {
            viewTitle = (viewTitle + " · " + img.note)
        }
        editor.focused = false
        status = viewTitle
    }

    fn closeView:void () {
        viewSrc = ""
        viewDisk = ""
        viewComment = ""
        if (focus == "editor") {
            editor.focused = true
        }
    }

    fn viewing:boolean () {
        return ((strlen viewSrc) > 0)
    }

    fn toggleMount:void (index:int) {
        if ((index < 0) || (index >= (array_length preview.mounts))) {
            return
        }
        def m:GameMount (itemAt preview.mounts index)
        if (has openMounts m.label) {
            map_clear openMounts
            return
        }
        map_clear openMounts
        set openMounts m.label true
        def rels:[string]
        def lines:[string] (strsplit (sh_list_files m.disk) "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) "\t")
            if ((array_length parts) >= 2) {
                push rels (itemAt parts 0)
            }
            i = (i + 1)
        }
        set mountFiles m.label rels
    }

    ; --- comments --------------------------------------------------------------------
    fn studioDir:string () {
        return (GamePreview.joinPath(preview.root ".studio"))
    }

    fn commentsFile:string () {
        return (GamePreview.joinPath((this.studioDir()) "comments.jsonl"))
    }

    sfn q:string (s:string) {
        def out:string "\""
        def start:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            def r:string ""
            if (ch == 34) {
                r = "\\\""
            }
            if (ch == 92) {
                r = "\\\\"
            }
            if (ch == 10) {
                r = "\\n"
            }
            if (ch == 13) {
                r = "\\r"
            }
            if (ch == 9) {
                r = "\\t"
            }
            if ((strlen r) > 0) {
                out = (out + (substring s start i) + r)
                start = (i + 1)
            }
            i = (i + 1)
        }
        return (out + (substring s start n) + "\"")
    }

    ; One field of a flat JSON object written by commentJson.
    sfn jsonField:string (line:string key:string) {
        def at:int (indexOf line ("\"" + key + "\":"))
        if (at < 0) {
            return ""
        }
        def i:int ((at + (strlen key)) + 3)
        def n:int (strlen line)
        if ((i < n) && ((charAt line i) == 34)) {
            def out:string ""
            i = (i + 1)
            def start:int i
            while ((i < n) && ((charAt line i) != 34)) {
                if ((charAt line i) == 92) {
                    out = (out + (substring line start i))
                    def e:int (charAt line (i + 1))
                    if (e == 110) {
                        out = (out + "\n")
                    } {
                        if (e == 116) {
                            out = (out + "\t")
                        } {
                            if (e != 114) {
                                out = (out + (substring line (i + 1) (i + 2)))
                            }
                        }
                    }
                    i = (i + 2)
                    start = i
                } {
                    i = (i + 1)
                }
            }
            return (out + (substring line start i))
        }
        def st:int i
        while ((i < n) && ((charAt line i) != 44) && ((charAt line i) != 125)) {
            i = (i + 1)
        }
        return (trim (substring line st i))
    }

    fn commentJson:string (c:StudioComment) {
        def done:string "false"
        if c.done {
            done = "true"
        }
        return ("{\"id\":" + (StudioApp.q(c.id)) + ",\"time\":" + (StudioApp.q(c.time)) + ",\"game\":" + (StudioApp.q(c.game)) + ",\"scene\":" + (StudioApp.q(c.scene)) + ",\"frame\":" + (to_string c.frame) + ",\"text\":" + (StudioApp.q(c.text)) + ",\"shot\":" + (StudioApp.q(c.shot)) + ",\"done\":" + done + ",\"note\":" + (StudioApp.q(c.note)) + "}")
    }

    fn loadComments:void () {
        clear comments
        def path:string (this.commentsFile())
        commentsStamp = (sh_file_mtime path)
        def lines:[string] (strsplit (sh_read_text path) "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def line:string (itemAt lines i)
            if ((indexOf line "\"id\":") >= 0) {
                def c:StudioComment (new StudioComment)
                c.id = (StudioApp.jsonField(line "id"))
                c.time = (StudioApp.jsonField(line "time"))
                c.game = (StudioApp.jsonField(line "game"))
                c.scene = (StudioApp.jsonField(line "scene"))
                c.frame = (?? (to_int (StudioApp.jsonField(line "frame"))) 0)
                c.text = (StudioApp.jsonField(line "text"))
                c.shot = (StudioApp.jsonField(line "shot"))
                c.done = ((StudioApp.jsonField(line "done")) == "true")
                c.note = (StudioApp.jsonField(line "note"))
                push comments c
            }
            i = (i + 1)
        }
    }

    fn saveComments:void () {
        sh_mkdirs (this.studioDir())
        def out:string ""
        def i:int 0
        while (i < (array_length comments)) {
            out = (out + (this.commentJson((itemAt comments i))) + "\n")
            i = (i + 1)
        }
        sh_write_text (this.commentsFile()) out
        commentsStamp = (sh_file_mtime (this.commentsFile()))
    }

    ; An agent or an editor changed comments.jsonl: read it again.
    fn checkComments:void () {
        def now:double (sh_file_mtime (this.commentsFile()))
        if (now != commentsStamp) {
            this.loadComments()
        }
    }

    fn newCommentId:string () {
        def t:string (sh_local_time)
        def id:string ""
        def i:int 0
        while (i < (strlen t)) {
            def ch:int (charAt t i)
            if ((ch >= 48) && (ch <= 57)) {
                id = (id + (substring t i (i + 1)))
            }
            i = (i + 1)
        }
        def base:string id
        def k:int 2
        while ((this.commentIndex(id)) >= 0) {
            id = (base + "-" + (to_string k))
            k = (k + 1)
        }
        return id
    }

    fn commentIndex:int (id:string) {
        def i:int 0
        while (i < (array_length comments)) {
            def c:StudioComment (itemAt comments i)
            if (c.id == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; A new comment on the game as it is now; its screenshot is taken once
    ; this frame is drawn.
    fn newComment:StudioComment (text:string) {
        def c:StudioComment (new StudioComment)
        c.id = (this.newCommentId())
        c.time = (sh_local_time)
        c.game = preview.gameId
        c.scene = preview.currentScene
        c.frame = preview.frames
        c.text = text
        c.shot = (".studio/shots/" + c.id + ".png")
        sh_mkdirs (GamePreview.joinPath((this.studioDir()) "shots"))
        shotPath = (GamePreview.joinPath(preview.root c.shot))
        shotArea = "game"
        return c
    }

    ; "Kommentoi": the game stops, its picture is kept, and the keys write the comment.
    fn startComment:void () {
        if commentMode {
            return
        }
        preview.paused = true
        draft = (this.newComment(""))
        commentMode = true
        commentText = ""
        focus = "comment"
        editor.focused = false
        status = "write the comment: Enter saves, Esc cancels"
    }

    fn finishComment:void (keep:boolean) {
        commentMode = false
        focus = "editor"
        if ((this.viewing()) == false) {
            editor.focused = true
        }
        if (keep && ((strlen (trim commentText)) > 0)) {
            draft.text = (trim commentText)
            push comments draft
            this.saveComments()
            status = ("comment saved (" + draft.id + ")")
        } {
            status = "comment cancelled"
        }
        commentText = ""
    }

    fn commentKey:void (k:int) {
        if (k == 2) {
            this.finishComment(true)
            return
        }
        if (k == 4) {
            this.finishComment(false)
            return
        }
        if ((k == 1) && ((strlen commentText) > 0)) {
            ; drop the last character, with its UTF-8 continuation bytes
            def n:int ((strlen commentText) - 1)
            def going:boolean true
            while going {
                def b:int (charAt commentText n)
                if (b < 0) {
                    b = (b + 256)
                }
                if ((n > 0) && (b >= 128) && (b < 192)) {
                    n = (n - 1)
                } {
                    going = false
                }
            }
            commentText = (substring commentText 0 n)
        }
    }

    fn showComment:void (id:string) {
        def ci:int (this.commentIndex(id))
        if (ci < 0) {
            return
        }
        def c:StudioComment (itemAt comments ci)
        if ((indexOf c.scene "cartoon:") == 0) {
            this.openCartoonRef(c.scene)
            viewComment = c.id
            cartoon.status = ("kommentti " + c.id + ": " + c.text)
            return
        }
        if (((strlen c.game) > 0) && (c.game != preview.gameId) && ((indexOf preview.games c.game) >= 0)) {
            preview.select(c.game)
            this.refreshFiles()
        }
        if ((strlen c.scene) > 0) {
            preview.jump(c.scene)
        }
        def disk:string (GamePreview.joinPath(preview.root c.shot))
        this.showAsset(("disk:" + disk) disk ("comment " + c.id) (sh_file_size disk))
        viewComment = c.id
        viewTitle = (c.time + "  " + c.scene + "  frame " + (to_string c.frame))
    }

    fn markDone:boolean (id:string note:string) {
        def ci:int (this.commentIndex(id))
        if (ci < 0) {
            return false
        }
        def c:StudioComment (itemAt comments ci)
        c.done = (c.done == false)
        if ((strlen note) > 0) {
            c.done = true
            c.note = note
        }
        this.saveComments()
        return true
    }

    fn openComments:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length comments)) {
            def c:StudioComment (itemAt comments i)
            if (c.done == false) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; Take the screenshot asked for this frame (after evg_flush).
    fn afterFlush:void () {
        if ((strlen shotPath) == 0) {
            return
        }
        def ok:int 0
        if (shotArea == "window") {
            ok = (sh_screenshot shotPath)
        }
        if (shotArea == "cartoon") {
            def pr:[double] (cartoon.pageRect())
            ok = (sh_screenshot_rect shotPath (itemAt pr 0) (itemAt pr 1) (itemAt pr 2) (itemAt pr 3))
            cartoon.clean = false
            this.afterCartoonShot(ok)
        }
        if (shotArea == "cartoon-nb") {
            def nr:[double] (cartoon.nbShotRect())
            ok = (sh_screenshot_rect shotPath (itemAt nr 0) (itemAt nr 1) (itemAt nr 2) (itemAt nr 3))
            cartoon.clean = false
            cartoon.render.hideBubbles = false
            this.startNanoBanana(ok)
            shotPath = ""
            shotFor = ""
            return
        }
        if ((shotArea != "window") && (shotArea != "cartoon")) {
            ok = (sh_screenshot_rect shotPath preview.px preview.py preview.pw preview.ph)
        }
        if (shotFor == "mcp") {
            if ((ok == 1) && (shotArea == "cartoon")) {
                sh_mcp_reply_image shotPath ("cartoon " + cartoon.doc.rel + " scene " + (to_string cartoon.sceneIx) + " · " + shotPath)
                shotPath = ""
                shotFor = ""
                return
            }
            if (ok == 1) {
                sh_mcp_reply_image shotPath ("game " + preview.gameId + " scene " + preview.currentScene + " frame " + (to_string preview.frames) + " · " + shotPath)
            } {
                sh_mcp_reply ("screenshot failed: " + shotPath) 1
            }
        }
        if (shotFor == "mcp-comment") {
            sh_mcp_reply ("comment saved with screenshot " + shotPath) 0
        }
        shotPath = ""
        shotFor = ""
    }

    fn editorX:int () {
        return leftW
    }

    fn editorW:int () {
        return ((W - leftW) - previewW)
    }

    fn editorH:int () {
        return (((H - topH) - logH) - 24)
    }

    fn buttonX:int (index:int) {
        return ((W - previewW) - ((2 - index) * 112))
    }

    ; --- input ---------------------------------------------------------------------
    fn handleInput:void () {
        sh_poll
        def ww:int (sh_window_w)
        def wh:int (sh_window_h)
        if ((ww >= 640) && (wh >= 400)) {
            W = ww
            H = wh
        }
        this.layoutPreview()
        def mx:int (sh_mouse_x)
        def my:int (sh_mouse_y)
        def down:boolean ((bit_and (sh_mouse_buttons) 1) != 0)
        def pressed:boolean (down && (lastMouseDown == false))
        def released:boolean ((down == false) && lastMouseDown)
        lastMouseDown = down
        def shift:boolean ((sh_shift) == 1)
        def ctrl:boolean ((sh_ctrl) == 1)
        editor.setBounds((this.editorX()) topH (this.editorW()) (this.editorH()))

        if cartoon.active {
            this.cartoonInput(mx my down pressed released ctrl shift)
            return
        }
        if pressed {
            if (preview.inside(mx my)) {
                focus = "game"
                editor.focused = false
            } {
                if ((editor.insideRect(mx my)) && ((this.viewing()) == false) && (commentMode == false)) {
                    focus = "editor"
                    editor.focused = true
                    editor.pointerDown(ctx.tr mx my shift)
                } {
                    this.clickChrome(mx my)
                }
            }
        } {
            if (down && (focus == "editor") && editor.focused) {
                editor.pointerDrag(ctx.tr mx my)
            }
        }
        preview.pointer(mx my down pressed released)

        def wy:int (sh_wheel_y)
        def wx:int (sh_wheel_x)
        if (wy != 0) {
            if (editor.insideRect(mx my)) {
                editor.scrollBy((0 - wy))
            } {
                if ((mx < leftW) && (my > topH)) {
                    fileScroll = (fileScroll - wy)
                    if (fileScroll < 0) {
                        fileScroll = 0
                    }
                } {
                    if ((mx >= leftW) && (mx < (W - previewW)) && (my > (H - logH))) {
                        logScroll = (logScroll + wy)
                        if (logScroll < 0) {
                            logScroll = 0
                        }
                    }
                }
            }
        }
        if ((wx != 0) && (editor.insideRect(mx my))) {
            editor.scrollByX((wx * 24))
        }

        def gameKeys:string (sh_take_game_keys)
        def text:string (sh_take_text)
        if (focus == "game") {
            preview.keys(gameKeys)
        }
        if (commentMode) {
            if ((strlen text) > 0) {
                if ctrl {
                    if ((indexOf text "v") >= 0) {
                        commentText = (commentText + (sh_get_clipboard))
                    }
                } {
                    commentText = (commentText + text)
                }
            }
            def ck:int (sh_pop_key)
            while (ck != 0) {
                this.commentKey(ck)
                ck = (sh_pop_key)
            }
            return
        }
        if ((strlen text) > 0) {
            if ctrl {
                def i:int 0
                while (i < (strlen text)) {
                    this.ctrlChar((charAt text i))
                    i = (i + 1)
                }
            } {
                if ((focus == "editor") && ((this.viewing()) == false)) {
                    editor.handleText(text)
                }
            }
        }
        def k:int (sh_pop_key)
        while (k != 0) {
            if (k == 15) {
                preview.restart()
                status = "restarted"
            } {
                if (this.viewing()) {
                    if (k == 4) {
                        this.closeView()
                    }
                } {
                    if (focus == "editor") {
                        editor.handleKey(k shift ctrl)
                    }
                }
            }
            k = (sh_pop_key)
        }
    }

    fn ctrlChar:void (ch:int) {
        if ((ch == 115) || (ch == 83)) {
            this.save()
            return
        }
        if ((ch == 114) || (ch == 82)) {
            preview.restart()
            status = "restarted"
            return
        }
        if (focus != "editor") {
            return
        }
        if ((ch == 99) || (ch == 67)) {
            sh_set_clipboard (editor.selectionText())
            return
        }
        if ((ch == 120) || (ch == 88)) {
            sh_set_clipboard (editor.cutSelection())
            return
        }
        if ((ch == 118) || (ch == 86)) {
            def clip:string (sh_get_clipboard)
            if ((strlen clip) > 0) {
                editor.handleText(clip)
            }
            return
        }
        if (ch == 32) {
            editor.requestCompletions()
            return
        }
        editor.handleCtrlChar(ch)
    }

    fn clickChrome:void (mx:int my:int) {
        def fx:double (to_double mx)
        def fy:double (to_double my)
        def hi:int 0
        while (hi < (array_length hits)) {
            def h:StudioHit (itemAt hits hi)
            if ((fx >= h.x) && (fy >= h.y) && (fx < (h.x + h.w)) && (fy < (h.y + h.h))) {
                this.act(h.action)
                return
            }
            hi = (hi + 1)
        }
    }

    ; --- painting ------------------------------------------------------------------
    fn rect:void (dl:EVGDisplayList x:double y:double w:double h:double col:EVGColor) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 0
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    fn roundRect:void (dl:EVGDisplayList x:double y:double w:double h:double col:EVGColor radius:double) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 0
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.radius = radius
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    fn text:double (dl:EVGDisplayList s:string x:double y:double size:double col:EVGColor bold:boolean) {
        if ((strlen s) == 0) {
            return 0.0
        }
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 3
        c.x = x
        c.y = y
        c.w = (ctx.tr.measureWidth(s size))
        c.h = (ctx.tr.lineHeight(size))
        c.text = s
        c.fontFamily = fontFamily
        c.fontSize = size
        if bold {
            c.fontWeight = "bold"
        }
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
        return c.w
    }

    fn clip:void (dl:EVGDisplayList x:double y:double w:double h:double) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 4
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        push dl.cmds c
    }

    fn unclip:void (dl:EVGDisplayList) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 5
        push dl.cmds c
    }

    sfn kb:string (bytes:double) {
        if (bytes > 1048576.0) {
            return ((to_string (to_int (bytes / 1048576.0))) + " MB")
        }
        return ((to_string (to_int (bytes / 1024.0))) + " kB")
    }

    fn paintStatus:void (dl:EVGDisplayList ex:double sy:double) {
        def caret:string ("L" + (to_string (editor.sel.caret.line + 1)) + ":" + (to_string (editor.sel.caret.col + 1)))
        def sx:double ((ex + 10.0) + (this.text(dl caret (ex + 10.0) (sy + 5.0) 12.0 accent false)) + 12.0)
        def fname:string openRel
        if (this.dirty()) {
            fname = (fname + " ●")
        }
        sx = (sx + (this.text(dl fname sx (sy + 5.0) 12.0 ink false)) + 12.0)
        def problems:int (editor.problemCount())
        if (problems > 0) {
            sx = (sx + (this.text(dl ((to_string problems) + " problem(s)") sx (sy + 5.0) 12.0 warn false)) + 12.0)
        }
        this.text(dl status sx (sy + 5.0) 12.0 muted false)
    }

    ; A picture in the editor's place, fitted, with its name and size above it.
    fn paintView:void (dl:EVGDisplayList) {
        def ex:double (to_double (this.editorX()))
        def ey:double (to_double topH)
        def ew:double (to_double (this.editorW()))
        def eh:double (to_double (this.editorH()))
        this.rect(dl ex ey ew eh (EVGColor.rgb(12 13 18)))
        this.rect(dl ex ey ew 34.0 bar)
        this.clip(dl ex ey ew eh)
        def bx:double ((ex + ew) - 74.0)
        this.roundRect(dl bx (ey + 6.0) 66.0 22.0 line 4.0)
        this.text(dl "Sulje" (bx + 9.0) (ey + 9.0) 12.0 ink false)
        def hit:StudioHit (new StudioHit)
        hit.x = bx
        hit.y = (ey + 6.0)
        hit.w = 66.0
        hit.h = 22.0
        hit.action = "closeview"
        push hits hit
        def titleW:double ((bx - ex) - 20.0)
        if ((strlen viewComment) > 0) {
            def ci:int (this.commentIndex(viewComment))
            if (ci >= 0) {
                def c:StudioComment (itemAt comments ci)
                def label:string "Merkitse tehdyksi"
                if c.done {
                    label = "Avaa uudelleen"
                }
                def cw:double (this.chipW(label))
                def cx:double ((bx - cw) - 8.0)
                this.roundRect(dl cx (ey + 6.0) cw 22.0 (EVGColor.rgb(38 64 52)) 4.0)
                this.text(dl label (cx + 8.0) (ey + 9.0) 12.0 ink false)
                def dh:StudioHit (new StudioHit)
                dh.x = cx
                dh.y = (ey + 6.0)
                dh.w = cw
                dh.h = 22.0
                dh.action = ("cdone:" + c.id)
                push hits dh
                titleW = ((cx - ex) - 20.0)
                this.text(dl c.text (ex + 12.0) (ey + 44.0) 14.0 ink true)
                if ((strlen c.note) > 0) {
                    this.text(dl ("> " + c.note) (ex + 12.0) (ey + 64.0) 12.0 good false)
                }
            }
        }
        this.clip(dl ex ey titleW 34.0)
        this.text(dl viewTitle (ex + 12.0) (ey + 10.0) 12.0 muted false)
        this.unclip(dl)
        def top:double (ey + 44.0)
        if ((strlen viewComment) > 0) {
            top = (ey + 86.0)
        }
        def img:StudioImage (preview.images.get(viewSrc viewDisk))
        if (img.ok && (img.width > 0) && (img.height > 0)) {
            def aw:double (ew - 24.0)
            def ah:double ((eh - (top - ey)) - 12.0)
            def k:double (aw / (to_double img.width))
            if (((to_double img.height) * k) > ah) {
                k = (ah / (to_double img.height))
            }
            if (k > 4.0) {
                k = 4.0
            }
            def iw:double ((to_double img.width) * k)
            def ih:double ((to_double img.height) * k)
            def ix:double (ex + ((ew - iw) / 2.0))
            this.rect(dl (ix - 1.0) (top - 1.0) (iw + 2.0) (ih + 2.0) line)
            def c2:EVGDrawCmd (new EVGDrawCmd)
            c2.kind = 2
            c2.src = viewSrc
            c2.x = ix
            c2.y = top
            c2.w = iw
            c2.h = ih
            c2.a = 1.0
            push dl.cmds c2
        } {
            this.text(dl ("cannot show: " + img.note) (ex + 12.0) top 12.0 warn false)
        }
        this.unclip(dl)
    }

    fn buildDisplayList:EVGDisplayList () {
        def dl:EVGDisplayList (new EVGDisplayList)
        clear hits
        def fw:double (to_double W)
        def fh:double (to_double H)
        this.rect(dl 0.0 0.0 fw fh bg)

        ; top bar
        this.rect(dl 0.0 0.0 fw (to_double topH) bar)
        this.rect(dl 0.0 (to_double (topH - 1)) fw 1.0 line)
        def tx:double 14.0
        tx = (tx + (this.text(dl "Sliqtly Game Studio" tx 10.0 14.0 ink true)) + 16.0)
        def proj:string (GamePreview.baseName(preview.root))
        tx = (tx + (this.text(dl proj tx 11.0 13.0 accent false)) + 10.0)
        if (preview.single == false) {
            tx = (tx + (this.text(dl ("/ " + preview.gameId) tx 11.0 13.0 accent false)) + 10.0)
        }
        def labels:[string] ([] _:string ("Tallenna  ^S" "Käynnistä  F5"))
        def bi:int 0
        while (bi < 2) {
            def bx:double (to_double (this.buttonX(bi)))
            def bcol:EVGColor line
            if ((bi == 0) && (this.dirty())) {
                bcol = (EVGColor.rgb(61 89 161))
            }
            this.roundRect(dl bx 7.0 104.0 26.0 bcol 5.0)
            def tb:StudioHit (new StudioHit)
            tb.x = bx
            tb.y = 7.0
            tb.w = 104.0
            tb.h = 26.0
            tb.action = "restart"
            if (bi == 0) {
                tb.action = "save"
            }
            push hits tb
            this.text(dl (itemAt labels bi) (bx + 10.0) 11.0 12.0 ink false)
            bi = (bi + 1)
        }
        def cbx:double (to_double ((this.buttonX(0)) - 112))
        def ccol:EVGColor (EVGColor.rgb(82 64 30))
        def clabel:string "Sarjakuva"
        if cartoon.active {
            ccol = (EVGColor.rgb(61 89 161))
            clabel = "Koodi ja peli"
        }
        this.roundRect(dl cbx 7.0 104.0 26.0 ccol 5.0)
        this.text(dl clabel (cbx + 10.0) 11.0 12.0 ink false)
        def cb:StudioHit (new StudioHit)
        cb.x = cbx
        cb.y = 7.0
        cb.w = 104.0
        cb.h = 26.0
        cb.action = "cartoon"
        push hits cb
        if cartoon.active {
            cartoon.X0 = 0.0
            cartoon.Y0 = (to_double topH)
            cartoon.W = fw
            cartoon.H = (fh - (to_double topH))
            cartoon.paint(dl preview.images)
            return dl
        }

        ; left: games, files, resource folders, comments
        def lx:double 0.0
        this.rect(dl lx (to_double topH) (to_double leftW) (fh - (to_double topH)) panel)
        this.rect(dl (to_double (leftW - 1)) (to_double topH) 1.0 (fh - (to_double topH)) line)
        this.clip(dl 0.0 (to_double topH) (to_double (leftW - 1)) (fh - (to_double topH)))
        def row:int 0
        if (preview.single == false) {
            this.row(dl row "PELIT" muted true false "")
            row = (row + 1)
            def gi:int 0
            while (gi < (array_length preview.games)) {
                def gid:string (itemAt preview.games gi)
                this.row(dl row ("  " + gid) ink false (gid == preview.gameId) ("game:" + gid))
                row = (row + 1)
                gi = (gi + 1)
            }
        }
        this.row(dl row "TIEDOSTOT" muted true false "")
        row = (row + 1)
        def fi:int 0
        while (fi < (array_length files)) {
            def f:StudioFile (itemAt files fi)
            def col:EVGColor ink
            if (f.text == false) {
                col = muted
            }
            def label:string ("  " + f.rel)
            if (f.text == false) {
                label = (label + "  " + (StudioApp.kb((to_double f.size))))
            }
            def sel:boolean ((f.rel == openRel) && ((this.viewing()) == false))
            if ((strlen viewDisk) > 0) {
                if (viewDisk == (GamePreview.joinPath((this.gameDir()) f.rel))) {
                    sel = true
                }
            }
            this.row(dl row label col false sel ("file:" + f.rel))
            row = (row + 1)
            fi = (fi + 1)
        }
        def mi:int 0
        def shownRes:boolean false
        while (mi < (array_length preview.mounts)) {
            def m:GameMount (itemAt preview.mounts mi)
            if ((indexOf m.label "resource ") == 0) {
                if (shownRes == false) {
                    this.row(dl row "RESURSSIT (studio.json)" muted true false "")
                    row = (row + 1)
                    shownRes = true
                }
                def opened:boolean (has openMounts m.label)
                def arrow:string "+ "
                if opened {
                    arrow = "- "
                }
                this.row(dl row ("  " + arrow + (substring m.label 9 (strlen m.label))) accent false false ("mount:" + (to_string mi)))
                row = (row + 1)
                if opened {
                    def rels@(optional):[string] (get mountFiles m.label)
                    if (!null? rels) {
                        def list:[string] (unwrap rels)
                        def ri:int 0
                        def cap:int (array_length list)
                        if (cap > 400) {
                            cap = 400
                        }
                        while (ri < cap) {
                            def rel:string (itemAt list ri)
                            def rdisk:string (GamePreview.joinPath(m.disk rel))
                            this.row(dl row ("      " + rel) muted false (rdisk == viewDisk) ("res:" + (to_string mi) + ":" + rel))
                            row = (row + 1)
                            ri = (ri + 1)
                        }
                        if ((array_length list) > cap) {
                            this.row(dl row ("      ... " + (to_string ((array_length list) - cap)) + " more") muted false false "")
                            row = (row + 1)
                        }
                    }
                }
            }
            mi = (mi + 1)
        }
        if ((array_length comments) > 0) {
            this.row(dl row ("KOMMENTIT (" + (to_string (this.openComments())) + " avoinna)") muted true false "")
            row = (row + 1)
            def ci:int ((array_length comments) - 1)
            while (ci >= 0) {
                def c:StudioComment (itemAt comments ci)
                def mark:string "[ ]  "
                def ccol:EVGColor warn
                if c.done {
                    mark = "[x]  "
                    ccol = muted
                }
                this.row(dl row ("  " + mark + c.text) ccol false (c.id == viewComment) ("cshow:" + c.id))
                row = (row + 1)
                ci = (ci - 1)
            }
        }
        this.unclip(dl)

        ; centre: editor, status line and log
        def ex:double (to_double (this.editorX()))
        def ew:double (to_double (this.editorW()))
        editor.setBounds((this.editorX()) topH (this.editorW()) (this.editorH()))
        if (this.viewing()) {
            this.paintView(dl)
        } {
            editor.ensureTokens()
            def blink:int (to_int ((sh_now_ms) / 500.0))
            editor.paint(dl ctx.tr blink)
        }
        def sy:double (to_double (topH + (this.editorH())))
        this.rect(dl ex sy ew 24.0 bar)
        if commentMode {
            this.rect(dl ex sy ew 24.0 (EVGColor.rgb(52 44 22)))
            def cursor:string ""
            if (((to_int ((sh_now_ms) / 500.0)) % 2) == 0) {
                cursor = "|"
            }
            def pw2:double (this.text(dl "Kommentti (Enter tallentaa, Esc peruu):" (ex + 10.0) (sy + 5.0) 12.0 warn true))
            this.text(dl (commentText + cursor) ((ex + 18.0) + pw2) (sy + 5.0) 12.0 ink false)
        }
        if (commentMode == false) {
            this.paintStatus(dl ex sy)
        }


        def ly:double (sy + 24.0)
        this.rect(dl ex ly ew (fh - ly) panel)
        this.rect(dl ex ly ew 1.0 line)
        this.clip(dl ex ly ew (fh - ly))
        def perf:string ("game " + preview.status + " · " + (to_string (to_int frameMsAvg)) + " ms/frame · " + (to_string preview.cmdsLast) + " draw cmds · engine holds " + (StudioApp.kb(preview.bytesPut)) + ", read from disk " + (StudioApp.kb(preview.bytesKept)) + " · " + (to_string preview.images.decodes) + " pictures")
        this.text(dl perf (ex + 10.0) (ly + 6.0) 11.0 good false)
        def maxRows:int (to_int (((fh - ly) - 26.0) / 16.0))
        def nlog:int (array_length preview.logLines)
        def first:int ((nlog - maxRows) - logScroll)
        if (first < 0) {
            first = 0
        }
        def li:int first
        def ry:double (ly + 24.0)
        while ((li < nlog) && (ry < (fh - 4.0))) {
            this.text(dl (itemAt preview.logLines li) (ex + 10.0) ry 11.0 muted false)
            ry = (ry + 16.0)
            li = (li + 1)
        }
        this.unclip(dl)

        ; right: the game
        def gx:double (to_double (W - previewW))
        this.rect(dl (gx - 1.0) (to_double topH) 1.0 (fh - (to_double topH)) line)
        this.rect(dl gx (to_double topH) (to_double previewW) (to_double toolH) panel)
        this.layoutToolbar(dl true)
        preview.paint(dl ctx.tr)
        if (focus == "game") {
            def fc:EVGDrawCmd (new EVGDrawCmd)
            fc.kind = 1
            fc.x = gx
            fc.y = (to_double (topH + toolH))
            fc.w = (to_double previewW)
            fc.h = (fh - (to_double (topH + toolH)))
            fc.thickness = 2.0
            fc.r = (accent.red())
            fc.g = (accent.green())
            fc.b = (accent.blue())
            fc.a = 0.8
            push dl.cmds fc
        }
        if (preview.running == false) {
            this.text(dl preview.status (gx + 16.0) (to_double ((topH + toolH) + 16)) 12.0 warn false)
        }
        return dl
    }

    fn row:void (dl:EVGDisplayList index:int label:string col:EVGColor bold:boolean selected:boolean action:string) {
        def r:int (index - fileScroll)
        if (r < 0) {
            return
        }
        def y:double (to_double ((topH + 8) + (r * rowH)))
        if (y > (to_double H)) {
            return
        }
        if ((strlen action) > 0) {
            def hit:StudioHit (new StudioHit)
            hit.x = 0.0
            hit.y = y
            hit.w = (to_double (leftW - 1))
            hit.h = (to_double rowH)
            hit.action = action
            push hits hit
        }
        if selected {
            this.rect(dl 0.0 y (to_double (leftW - 1)) (to_double rowH) (EVGColor.rgb(40 46 70)))
        }
        def size:double 12.0
        if bold {
            size = 11.0
        }
        this.text(dl label 10.0 (y + 3.0) size col bold)
    }

    ; --- MCP: an agent drives the Studio ---------------------------------------------
    fn logTail:string (n:int) {
        def total:int (array_length preview.logLines)
        def first:int (total - n)
        if (first < 0) {
            first = 0
        }
        def out:string ""
        def i:int first
        while (i < total) {
            out = (out + (itemAt preview.logLines i) + "\n")
            i = (i + 1)
        }
        return out
    }

    fn statusText:string () {
        def out:string ("project: " + preview.root + "\n")
        out = (out + "game: " + preview.gameId + " (" + preview.status + ")\n")
        if (preview.single == false) {
            out = (out + "games: " + (join preview.games ", ") + "\n")
        }
        out = (out + "game size: " + (to_string (to_int (sh_rg_view 3))) + " x " + (to_string (to_int (sh_rg_view 4))) + "\n")
        out = (out + "scene: " + preview.currentScene + "\n")
        out = (out + "scenes: " + (join preview.scenes ", ") + "\n")
        out = (out + "speed: x" + (to_string preview.speed) + ", paused: " + (to_string preview.paused) + ", frames: " + (to_string preview.frames) + "\n")
        out = (out + "open comments: " + (to_string (this.openComments())) + "\n")
        out = (out + "mounts:\n" + (preview.mountReport()))
        out = (out + "\nlog (last 12):\n" + (this.logTail(12)))
        return out
    }

    fn assetList:string (filter:string) {
        def out:string ""
        def mi:int 0
        while (mi < (array_length preview.mounts)) {
            def m:GameMount (itemAt preview.mounts mi)
            def lines:[string] (strsplit (sh_list_files m.disk) "\n")
            def i:int 0
            while (i < (array_length lines)) {
                def parts:[string] (strsplit (itemAt lines i) "\t")
                if ((array_length parts) >= 2) {
                    def rel:string (itemAt parts 0)
                    def vfs:string (m.vfs + "/" + rel)
                    def keep:boolean (((StudioApp.isTextFile(rel)) == false) || ((strlen filter) > 0))
                    if ((strlen filter) > 0) {
                        keep = ((indexOf vfs filter) >= 0)
                    }
                    if keep {
                        def line:string (vfs + "\t" + (StudioApp.kb((?? (to_double (itemAt parts 1)) 0.0))) + "\t" + (GamePreview.joinPath(m.disk rel)))
                        if (preview.images.known(vfs)) {
                            def img:StudioImage (preview.images.get(vfs ""))
                            if img.ok {
                                line = (line + "\t" + (to_string img.width) + "x" + (to_string img.height))
                            }
                        }
                        out = (out + line + "\n")
                    }
                }
                i = (i + 1)
            }
            mi = (mi + 1)
        }
        if ((strlen out) == 0) {
            return "no assets"
        }
        return ("engine path\tsize\tdisk path\tpixels (when drawn)\n" + out)
    }

    fn commentLines:string (all:boolean) {
        def out:string ""
        def i:int 0
        while (i < (array_length comments)) {
            def c:StudioComment (itemAt comments i)
            if (all || (c.done == false)) {
                def line:string (this.commentJson(c))
                out = (out + line + "\n")
            }
            i = (i + 1)
        }
        if ((strlen out) == 0) {
            return ("no comments (file " + (this.commentsFile()) + ")")
        }
        return ("screenshots are relative to " + preview.root + "\n" + out)
    }

    ; One waiting tool call per window frame. A screenshot is answered after
    ; the frame is drawn (afterFlush).
    fn mcpPoll:void () {
        def name:string (sh_mcp_next)
        if ((strlen name) == 0) {
            return
        }
        if (name == "__quit") {
            mcpQuit = true
            return
        }
        if (name == "status") {
            sh_mcp_reply (this.statusText()) 0
            return
        }
        if (name == "jump_scene") {
            def scene:string (sh_mcp_arg "name")
            if (preview.jump(scene)) {
                sh_mcp_reply ("scene " + scene + " · frame " + (to_string preview.frames) + "\n" + (this.logTail(8))) 0
            } {
                sh_mcp_reply ("no scene " + scene + "; scenes: " + (join preview.scenes ", ")) 1
            }
            return
        }
        if (name == "restart") {
            preview.syncFiles(false)
            preview.restart()
            sh_mcp_reply (preview.status + "\n" + (this.logTail(8))) 0
            return
        }
        if (name == "run_frames") {
            def n:int (?? (to_int (sh_mcp_arg "frames")) 60)
            if (n > 36000) {
                n = 36000
            }
            def before:int (array_length preview.logLines)
            def ran:int (preview.advance(n))
            def total:int (array_length preview.logLines)
            def news:int (total - before)
            if (news > 60) {
                news = 60
            }
            sh_mcp_reply ("ran " + (to_string ran) + " frames, now frame " + (to_string preview.frames) + " · " + preview.status + "\n" + (this.logTail(news))) 0
            return
        }
        if (name == "screenshot") {
            sh_mkdirs (GamePreview.joinPath((this.studioDir()) "shots"))
            shotArea = (sh_mcp_arg "area")
            if (shotArea == "cartoon") {
                this.toggleCartoon(true)
            }
            shotPath = (GamePreview.joinPath((this.studioDir()) "shots/mcp-last.png"))
            shotFor = "mcp"
            return
        }
        if (name == "eval") {
            def r:string (preview.evalJs((sh_mcp_arg "code")))
            sh_mcp_reply r 0
            return
        }
        if (name == "log") {
            def n2:int (?? (to_int (sh_mcp_arg "lines")) 40)
            sh_mcp_reply (this.logTail(n2)) 0
            return
        }
        if (name == "set_speed") {
            def sp:string (sh_mcp_arg "speed")
            if ((strlen sp) > 0) {
                preview.speed = (?? (to_int sp) 1)
                if (preview.speed < 1) {
                    preview.speed = 1
                }
                if (preview.speed > 256) {
                    preview.speed = 256
                }
            }
            def pa:string (sh_mcp_arg "paused")
            if ((strlen pa) > 0) {
                preview.paused = (pa == "true")
            }
            sh_mcp_reply ("speed x" + (to_string preview.speed) + ", paused " + (to_string preview.paused)) 0
            return
        }
        if (name == "press_key") {
            def key:string (sh_mcp_arg "key")
            def mode:string (sh_mcp_arg "mode")
            def hold:int (?? (to_int (sh_mcp_arg "frames")) 1)
            if ((strlen mode) == 0) {
                mode = "tap"
            }
            if (mode == "down") {
                sh_rg_key 1 key
            } {
                if (mode == "up") {
                    sh_rg_key 0 key
                } {
                    sh_rg_key 1 key
                    preview.advance(hold)
                    sh_rg_key 0 key
                    preview.advance(1)
                }
            }
            sh_mcp_reply ("key " + key + " " + mode + " · frame " + (to_string preview.frames) + "\n" + (this.logTail(6))) 0
            return
        }
        if (name == "tap") {
            def x:double (?? (to_double (sh_mcp_arg "x")) 0.0)
            def y:double (?? (to_double (sh_mcp_arg "y")) 0.0)
            preview.tapGame(x y)
            sh_mcp_reply ("tapped " + (to_string x) + "," + (to_string y) + "\n" + (this.logTail(6))) 0
            return
        }
        if (name == "comments_list") {
            sh_mcp_reply (this.commentLines(((sh_mcp_arg "all") == "true"))) 0
            return
        }
        if (name == "comment_add") {
            def c:StudioComment (this.newComment((sh_mcp_arg "text")))
            push comments c
            this.saveComments()
            shotFor = "mcp-comment"
            return
        }
        if (name == "comment_done") {
            def cid:string (sh_mcp_arg "id")
            def note:string (sh_mcp_arg "note")
            if ((strlen note) == 0) {
                note = "done"
            }
            if (this.markDone(cid note)) {
                sh_mcp_reply ("comment " + cid + " marked done") 0
            } {
                sh_mcp_reply ("no comment " + cid) 1
            }
            return
        }
        if (name == "cartoon_open") {
            this.toggleCartoon(true)
            if ((sh_mcp_arg "new") == "true") {
                cartoon.act("newdoc")
            }
            def cf:string (sh_mcp_arg "file")
            if ((strlen cf) > 0) {
                cartoon.act(("doc:" + cf))
            }
            def cs:string (sh_mcp_arg "scene")
            if ((strlen cs) > 0) {
                cartoon.act(("scene:" + cs))
            }
            sh_mcp_reply (this.cartoonInfo()) 0
            return
        }
        if (name == "cartoon_get") {
            this.toggleCartoon(true)
            sh_mcp_reply (this.cartoonInfo()) 0
            return
        }
        if (name == "list_assets") {
            sh_mcp_reply (this.assetList((sh_mcp_arg "filter"))) 0
            return
        }
        sh_mcp_reply ("unknown tool " + name) 1
    }

    ; --- the comic editor ----------------------------------------------------------
    fn toggleCartoon:void (on:boolean) {
        if on {
            if (this.dirty()) {
                this.save()
            }
            cartoon.open((this.gameDir()))
            cartoon.active = true
            editor.focused = false
            focus = "cartoon"
            preview.paused = true
        } {
            if cartoon.dirty {
                cartoon.save()
            }
            cartoon.active = false
            focus = "editor"
            editor.focused = true
            preview.paused = false
        }
    }

    fn openCartoonRef:void (ref:string) {
        ; cartoon:<rel>#<scene>
        def rest:string (substring ref 8 (strlen ref))
        def hash:int (indexOf rest "#")
        def rel:string rest
        def sc:int 0
        if (hash >= 0) {
            rel = (substring rest 0 hash)
            sc = (?? (to_int (substring rest (hash + 1) (strlen rest))) 0)
        }
        this.toggleCartoon(true)
        if (rel != cartoon.doc.rel) {
            cartoon.act(("doc:" + rel))
        }
        cartoon.act(("scene:" + (to_string sc)))
    }

    fn cartoonInput:void (mx:int my:int down:boolean pressed:boolean released:boolean ctrl:boolean shift:boolean) {
        def wy:int (sh_wheel_y)
        def gk:string (sh_take_game_keys)
        def text:string (sh_take_text)
        def keys:[int]
        def k:int (sh_pop_key)
        while (k != 0) {
            push keys k
            k = (sh_pop_key)
        }
        if (pressed && (my < topH)) {
            this.clickChrome(mx my)
            return
        }
        if (ctrl && (((indexOf text "s") >= 0) || ((indexOf text "S") >= 0))) {
            cartoon.save()
            cartoon.status = ("tallennettu " + cartoon.doc.rel)
            return
        }
        cartoon.input(mx my down pressed released wy shift ctrl text keys)
    }

    ; once a frame: autosave, the file on disk, the comments of this cartoon,
    ; and what the editor asked for (a PNG, a comment, an AI request)
    fn cartoonFrame:void () {
        if (cartoon.active == false) {
            return
        }
        cartoon.frameTick(lastMouseDown)
        if ((frameNo % 30) == 0) {
            cartoon.checkDisk()
            cartoon.nbCheck()
            clear cartoon.notes
            def prefix:string ("cartoon:" + cartoon.doc.rel)
            def i:int 0
            while (i < (array_length comments)) {
                def c:StudioComment (itemAt comments i)
                if ((c.done == false) && ((indexOf c.scene prefix) == 0)) {
                    def t:string c.text
                    if ((strlen t) > 34) {
                        t = ((substring t 0 32) + "...")
                    }
                    push cartoon.notes t
                }
                i = (i + 1)
            }
        }
        def kind:string cartoon.pendingKind
        if ((strlen kind) == 0) {
            return
        }
        def text:string cartoon.pendingText
        cartoon.pendingKind = ""
        cartoon.pendingText = ""
        if cartoon.dirty {
            cartoon.save()
        }
        if (kind == "png") {
            def base:string (substring cartoon.doc.rel 0 (indexOf cartoon.doc.rel ".cartoon.json"))
            def rel:string (base + "-" + (to_string (cartoon.sceneIx + 1)) + ".png")
            sh_mkdirs (GamePreview.joinPath((this.gameDir()) "cartoons"))
            shotPath = (GamePreview.joinPath((this.gameDir()) rel))
            shotArea = "cartoon"
            shotFor = "cartoon-png"
            cartoon.clean = true
            cartoon.status = ("vienti: " + rel + " (pelissä rg.asset(\"" + rel + "\"))")
            return
        }
        if (kind == "nb") {
            this.queueNanoBanana(text)
            return
        }
        if (kind == "styleshot") {
            ; the whole page without bubbles: Nano Banana's style reference
            def sbase:string (substring cartoon.doc.rel 0 (indexOf cartoon.doc.rel ".cartoon.json"))
            if ((indexOf sbase "cartoons/") == 0) {
                sbase = (substring sbase 9 (strlen sbase))
            }
            def sdir:string (GamePreview.joinPath((this.studioDir()) "nano-banana"))
            sh_mkdirs sdir
            shotPath = (GamePreview.joinPath(sdir (sbase + "-style.png")))
            shotArea = "cartoon"
            shotFor = "cartoon-style"
            cartoon.clean = true
            cartoon.render.hideBubbles = true
            return
        }
        def label:string text
        if (kind == "ai") {
            label = ("[AI] " + text)
        }
        def c2:StudioComment (this.newComment(label))
        c2.scene = (cartoon.sceneRef())
        c2.frame = 0
        shotArea = "cartoon"
        shotFor = ("cartoon-" + kind)
        cartoon.clean = true
        push comments c2
        this.saveComments()
        cartoonBrief = ""
        if (kind == "ai") {
            def dir:string (GamePreview.joinPath((this.studioDir()) "cartoon-requests"))
            sh_mkdirs dir
            cartoonBrief = (GamePreview.joinPath(dir (c2.id + ".md")))
            sh_write_text cartoonBrief (cartoon.aiBrief(text (GamePreview.joinPath(preview.root c2.shot)) c2.id))
        }
        cartoon.status = ("tallennettu " + c2.id)
    }

    fn afterCartoonShot:void (ok:int) {
        if (shotFor == "cartoon-png") {
            if (ok == 1) {
                this.refreshFiles()
            } {
                cartoon.status = ("PNG-vienti epäonnistui: " + shotPath)
            }
        }
        if (shotFor == "cartoon-comment") {
            cartoon.status = "kommentti tallennettu kuvakaappauksen kanssa"
        }
        if (shotFor == "cartoon-style") {
            cartoon.render.hideBubbles = false
            if (ok == 1) {
                def gd:string ((this.gameDir()) + "/")
                def srel:string shotPath
                if ((indexOf srel gd) == 0) {
                    srel = (substring srel (strlen gd) (strlen srel))
                }
                cartoon.doc.styleRef = srel
                def ssc:CartoonScene (cartoon.scene())
                cartoon.doc.styleName = ssc.name
                cartoon.dirty = true
                cartoon.status = ("Nano Banana piirtää nyt skenen \"" + cartoon.doc.styleName + "\" tyyliin")
            } {
                cartoon.status = "tyylikuvan otto epäonnistui"
            }
        }
        if ((shotFor == "cartoon-ai") && ((strlen cartoonBrief) > 0)) {
            ; SLIQTLY_STUDIO_AI, or by default Claude Code's own CLI. It runs in
            ; a login shell with the usual install folders on PATH: a Studio
            ; started from the Dock or Finder does not get the terminal's PATH.
            def cmd:string (sh_env "SLIQTLY_STUDIO_AI")
            def how:string "SLIQTLY_STUDIO_AI"
            if ((strlen cmd) == 0) {
                cmd = "claude -p --permission-mode acceptEdits"
                how = "claude -p"
            }
            if ((cmd != "off") && (cmd != "none")) {
                def logPath:string ((substring cartoonBrief 0 ((strlen cartoonBrief) - 3)) + ".log")
                def inner:string ("export PATH=\"$HOME/.claude/local:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; " + cmd + " < \"" + cartoonBrief + "\" > \"" + logPath + "\" 2>&1; echo \"[studio] exit $?\" >> \"" + logPath + "\"")
                def line:string ("cd '" + (this.gameDir()) + "' && \"${SHELL:-/bin/sh}\" -lc '" + inner + "'")
                sh_spawn line
                cartoon.status = ("AI käynnistetty (" + how + "), loki " + logPath + ". Muutokset näkyvät, kun se kirjoittaa tiedoston.")
            } {
                cartoon.status = ("pyyntö tallennettu: " + cartoonBrief + " · Studion MCP:hen liitetty agentti näkee sen (comments_list)")
            }
            cartoonBrief = ""
        }
    }

    ; Nano Banana (Gemini's image model) draws the selected panel: first a
    ; screenshot of the panel without bubbles (this frame), then the call.
    fn queueNanoBanana:void (text:string) {
        if ((strlen (sh_image_key)) == 0) {
            cartoon.status = "Nano Banana: Google API -avain puuttuu. Aseta GEMINI_API_KEY tai kirjoita avain tiedostoon ~/.config/sliqtly-studio/gemini-api-key ja yritä uudelleen."
            return
        }
        def base:string (substring cartoon.doc.rel 0 (indexOf cartoon.doc.rel ".cartoon.json"))
        def n:int 1
        def rel:string (base + "-nb-" + (to_string n) + ".png")
        while ((sh_exists (GamePreview.joinPath((this.gameDir()) rel))) == 1) {
            n = (n + 1)
            rel = (base + "-nb-" + (to_string n) + ".png")
        }
        def name:string (substring rel 0 ((strlen rel) - 4))
        if ((indexOf name "cartoons/") == 0) {
            name = (substring name 9 (strlen name))
        }
        nbJob = (GamePreview.joinPath((GamePreview.joinPath((this.studioDir()) "nano-banana")) name))
        sh_mkdirs nbJob
        nbRel = rel
        nbPromptText = (cartoon.nbPrompt(text))
        sh_write_text (GamePreview.joinPath(nbJob "prompt.txt")) nbPromptText
        shotPath = (GamePreview.joinPath(nbJob "ref.png"))
        shotArea = "cartoon-nb"
        shotFor = "cartoon-nb"
        cartoon.clean = true
        cartoon.render.hideBubbles = true
    }

    fn startNanoBanana:void (ok:int) {
        def model:string (sh_env "SLIQTLY_STUDIO_IMAGE_MODEL")
        if ((strlen model) == 0) {
            model = "gemini-3.1-flash-image"
        }
        def ref:string (GamePreview.joinPath(nbJob "ref.png"))
        if (ok != 1) {
            ref = ""
        }
        ; the style reference goes second (the prompt says so)
        def styleDisk:string (GamePreview.joinPath((this.gameDir()) cartoon.doc.styleRef))
        if ((indexOf cartoon.doc.styleRef "/") == 0) {
            styleDisk = cartoon.doc.styleRef
        }
        if (((strlen cartoon.doc.styleRef) > 0) && ((sh_exists styleDisk) == 1) && ((strlen ref) > 0)) {
            ref = (ref + "\n" + styleDisk)
        }
        def b:[double] (cartoon.nbTarget())
        def aspect:string (CartoonEditor.nbAspect((itemAt b 2) (itemAt b 3)))
        def out:string (GamePreview.joinPath((this.gameDir()) nbRel))
        def started:int (sh_nano_banana nbJob model nbPromptText ref out aspect (cartoon.nbMask()))
        if (started == 1) {
            cartoon.nbStarted(nbRel)
            cartoon.status = ("Nano Banana piirtää (" + model + ", " + aspect + ")... kuva tulee ruutuun, kun se on valmis (noin 10-40 s)")
        } {
            cartoon.status = "Nano Banana: Google API -avain puuttuu"
        }
        nbJob = ""
        nbRel = ""
        nbPromptText = ""
    }

    fn cartoonInfo:string () {
        if (cartoon.hasDoc == false) {
            return ("no cartoons in " + (cartoon.dirOf()) + "; call cartoon_open with new=true")
        }
        def out:string ("open: " + cartoon.doc.rel + " scene " + (to_string cartoon.sceneIx) + "\ncartoons: " + (join cartoon.docs ", ") + "\n\n")
        out = (out + (cartoon.aiBrief("(no request: this is the current state)" "(take one: screenshot with area cartoon)" "-")))
        out = (out + "\n## JSON (" + (cartoon.docDisk()) + ")\n\n" + (cartoon.doc.toJson()))
        return out
    }

    ; --- the loop ------------------------------------------------------------------
    fn frame:void (dt:double) {
        frameNo = (frameNo + 1)
        this.handleInput()
        this.cartoonFrame()
        preview.watch()
        this.checkOpenFile()
        if ((frameNo % 30) == 0) {
            this.checkComments()
        }
        preview.step(dt)
        if mcp {
            this.mcpPoll()
        }
        def dl:EVGDisplayList (this.buildDisplayList())
        painter.draw(dl W H ctx.tr preview.images)
    }

    sfn argValue:string (i:int) {
        if ((i + 1) < (shell_arg_cnt)) {
            return (shell_arg (i + 1))
        }
        return ""
    }

    sfn main:void () {
        def app:StudioApp (new StudioApp)
        def folder:string ""
        def game:string ""
        def file:string ""
        def frames:int 0
        def shot:string ""
        def hidden:int 0
        def dump:boolean false
        def scene:string ""
        def speed:int 1
        def i:int 0
        def n:int (shell_arg_cnt)
        while (i < n) {
            def a:string (shell_arg i)
            if (a == "--game") {
                game = (StudioApp.argValue(i))
                i = (i + 1)
            } {
                if (a == "--file") {
                    file = (StudioApp.argValue(i))
                    i = (i + 1)
                } {
                    if (a == "--frames") {
                        frames = (?? (to_int (StudioApp.argValue(i))) 0)
                        i = (i + 1)
                    } {
                        if (a == "--shot") {
                            shot = (StudioApp.argValue(i))
                            i = (i + 1)
                        } {
                            if (a == "--hidden") {
                                hidden = 1
                            } {
                            if (a == "--mcp") {
                                app.mcp = true
                            } {
                            if (a == "--dump") {
                                dump = true
                            } {
                            if (a == "--scene") {
                                scene = (StudioApp.argValue(i))
                                i = (i + 1)
                            } {
                            if (a == "--speed") {
                                speed = (?? (to_int (StudioApp.argValue(i))) 1)
                                i = (i + 1)
                            } {
                                if (a == "--size") {
                                    def wh:[string] (strsplit (StudioApp.argValue(i)) "x")
                                    if ((array_length wh) == 2) {
                                        app.W = (?? (to_int (itemAt wh 0)) 1280)
                                        app.H = (?? (to_int (itemAt wh 1)) 800)
                                    }
                                    i = (i + 1)
                                } {
                                    folder = a
                                }
                            }
                            }
                            }
                            }
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        if app.mcp {
            sh_mcp_start
        }
        if ((strlen folder) == 0) {
            print "usage: sliqtly-studio <game or collection folder> [--game id] [--file rel] [--frames N] [--shot out.png] [--dump] [--scene name] [--speed N] [--hidden] [--size WxH] [--mcp]"
            return
        }
        if ((sh_is_dir folder) == 0) {
            print ("not a folder: " + folder)
            return
        }
        ; fonts/ beside the program, or SLIQTLY_STUDIO_FONTS
        app.fontDir = ((sh_base_path) + "fonts")
        def fonts:string (sh_env "SLIQTLY_STUDIO_FONTS")
        if ((strlen fonts) > 0) {
            app.fontDir = fonts
        }
        app.initFonts()
        def ok:int (sh_open "Sliqtly Game Studio" app.W app.H hidden)
        if (ok == 0) {
            print "[studio] could not open a window (no display?)"
            return
        }
        app.hasWindow = true
        app.openProject(folder)
        if ((strlen game) > 0) {
            if ((indexOf app.preview.games game) >= 0) {
                app.preview.gameId = game
                app.refreshFiles()
                app.openFirstFile()
            } {
                print ("[studio] no game " + game + " in " + folder)
            }
        }
        if ((strlen file) > 0) {
            if ((indexOf file "comment:") == 0) {
                app.showComment((substring file 8 (strlen file)))
            } {
                app.clickFile(file)
            }
        }
        app.layoutPreview()
        app.preview.restart()
        sh_print ("[studio] " + app.preview.status)
        sh_print ("[studio] scenes: " + (join app.preview.scenes ", "))
        app.preview.speed = speed
        if ((strlen scene) > 0) {
            app.preview.jump(scene)
        }
        def mounts:string (app.preview.mountReport())
        sh_print ("[studio] mounts:\n" + mounts)
        def count:int 0
        def last:double (sh_now_ms)
        def running:boolean true
        while running {
            def now:double (sh_now_ms)
            def dt:double (now - last)
            last = now
            if (frames > 0) {
                ; a recorded run steps at a fixed 60 fps, whatever the machine
                dt = (1000.0 / 60.0)
            }
            if (dt > 100.0) {
                dt = 100.0
            }
            def t0:double (sh_now_ms)
            app.frame(dt)
            def t1:double (sh_now_ms)
            app.frameMsAvg = ((app.frameMsAvg * 0.9) + ((t1 - t0) * 0.1))
            count = (count + 1)
            ; the log goes to stdout too, for an agent driving the Studio
            def oi:int 0
            while (oi < (array_length app.preview.outbox)) {
                sh_print ("[game] " + (itemAt app.preview.outbox oi))
                oi = (oi + 1)
            }
            clear app.preview.outbox
            if ((frames > 0) && ((count + 1) == frames) && dump) {
                app.preview.dumpNext = true
            }
            if ((strlen app.shotPath) > 0) {
                evg_flush
                app.afterFlush()
            }
            if app.mcpQuit {
                running = false
            }
            if ((frames > 0) && (count >= frames)) {
                evg_flush
                if ((strlen shot) > 0) {
                    def wrote:int (sh_screenshot shot)
                    if (wrote == 1) {
                        sh_print ("[studio] screenshot " + shot)
                    } {
                        sh_print ("[studio] screenshot failed: " + shot)
                    }
                }
                running = false
            }
            sh_swap
            if ((sh_should_close) == 1) {
                running = false
            }
        }
        sh_print ("[studio] done: frames=" + (to_string count) + " game=" + app.preview.gameId + " running=" + (to_string app.preview.running) + " ms/frame=" + (to_string (to_int app.frameMsAvg)))
        sh_close
    }
}
