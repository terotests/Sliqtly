; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; GamePreview — the RangerGames engine inside the Studio window
; ==============================================================================
;
; The engine (librg_studio.a, the same Rust code as the web and phone hosts)
; runs in-process. This class:
;
;   - mounts folders from disk into the engine's file system: the project
;     (one game, or a collection of them) and the shared resource folders
;     that studio.json names;
;   - keeps them in step with the disk: every second the folders are listed,
;     and a file whose size or time changed is put again (an AI agent in a
;     terminal edits a file, the game restarts with it);
;   - keeps big pictures, sounds and videos OUT of the engine's memory: the
;     engine gets only their header (it reads a picture's size from it), and
;     the Studio's painter reads the picture from disk itself;
;   - turns each frame's draw stream (RangerGames crates/rg_engine/src/draw.rs)
;     into EVG draw commands placed in the preview panel, so one painter draws
;     the Studio and the game.
; ==============================================================================

Import "pkg:evg/EVGDisplayList.rgr"
Import "../../game_engine/ui/UIContext.rgr"
Import "../native/gfx_studio.rgr"
Import "StudioImages.rgr"

class GameMount {
    ; engine path without the trailing slash, e.g. "/games/pupu"
    def vfs:string ""
    ; folder on disk
    def disk:string ""
    def label:string ""
}

class GamePreview {
    def root:string ""
    def single:boolean false
    def mounts:[GameMount]
    def games:[string]
    def gameId:string ""
    def running:boolean false
    def status:string ""
    def logLines:[string]
    ; lines not yet printed to stdout
    def outbox:[string]
    def stamps:[string:string]
    def present:[string:boolean]
    ; files above this size whose kind the engine does not read get only their head
    def bigLimit:int 65536
    def headBytes:int 65536
    def bytesPut:double 0.0
    def bytesKept:double 0.0
    def filesPut:int 0
    def lastSync:double 0.0
    def syncEveryMs:double 1000.0
    ; the panel, in window units
    def px:double 0.0
    def py:double 0.0
    def pw:double 360.0
    def ph:double 640.0
    def sizedW:double 0.0
    def sizedH:double 0.0
    def downInside:boolean false
    def frames:int 0
    def cmdsLast:int 0
    def sounds:int 0
    def changedSinceStart:boolean false
    ; print the next frame's draw commands (game units) to stdout
    def dumpNext:boolean false
    def images:StudioImages (new StudioImages)
    ; files (relative) that the last sync found changed
    def lastChanged:[string]
    ; the game's SCENES, and the one jumped to last
    def scenes:[string]
    def currentScene:string ""
    ; game frames per window frame, and pause / single step
    def speed:int 1
    def paused:boolean false
    def stepOnce:boolean false

    Constructor () {
    }

    fn note:void (text:string) {
        push logLines text
        push outbox text
    }

    ; --- project -------------------------------------------------------------------
    sfn baseName:string (path:string) {
        def p:string path
        while (((strlen p) > 1) && ((charAt p ((strlen p) - 1)) == 47)) {
            p = (substring p 0 ((strlen p) - 1))
        }
        def cut:int -1
        def i:int 0
        while (i < (strlen p)) {
            if ((charAt p i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        return (substring p (cut + 1) (strlen p))
    }

    sfn joinPath:string (a:string b:string) {
        if ((strlen a) == 0) {
            return b
        }
        if ((charAt a ((strlen a) - 1)) == 47) {
            return (a + b)
        }
        return (a + "/" + b)
    }

    sfn lower:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def ch:int (charAt s i)
            if ((ch >= 65) && (ch <= 90)) {
                out = (out + (strfromcode (ch + 32)))
            } {
                out = (out + (substring s i (i + 1)))
            }
            i = (i + 1)
        }
        return out
    }

    sfn extOf:string (path:string) {
        def dot:int -1
        def i:int 0
        while (i < (strlen path)) {
            def ch:int (charAt path i)
            if (ch == 46) {
                dot = i
            }
            if (ch == 47) {
                dot = -1
            }
            i = (i + 1)
        }
        if (dot < 0) {
            return ""
        }
        return (GamePreview.lower((substring path (dot + 1) (strlen path))))
    }

    ; Pictures, sounds and video: the engine needs a picture's header (its
    ; size), never the rest.
    sfn isMedia:boolean (path:string) {
        def e:string (GamePreview.extOf(path))
        def kinds:[string] ([] _:string ("png" "jpg" "jpeg" "webp" "gif" "mp3" "ogg" "wav" "m4a" "aac" "flac" "mp4" "webm" "mov"))
        return ((indexOf kinds e) >= 0)
    }

    ; Open a project folder: a game (it holds game.json) or a collection of
    ; games (its folders hold game.json).
    fn open:void (folder:string) {
        root = (sh_real_path folder)
        clear mounts
        clear games
        map_clear stamps
        map_clear present
        sh_rg_reset
        images.clearAll()
        bytesPut = 0.0
        bytesKept = 0.0
        filesPut = 0
        def gameJson:string (GamePreview.joinPath(root "game.json"))
        if ((sh_exists gameJson) == 1) {
            single = true
            def id:string (GamePreview.baseName(root))
            this.addMount(("/games/" + id) root "project")
            push games id
        } {
            single = false
            this.addMount("/games" root "project")
            def listing:string (sh_list_files root)
            def lines:[string] (strsplit listing "\n")
            def i:int 0
            while (i < (array_length lines)) {
                def line:string (itemAt lines i)
                def parts:[string] (strsplit line "\t")
                if ((array_length parts) >= 1) {
                    def rel:string (itemAt parts 0)
                    def segs:[string] (strsplit rel "/")
                    if (((array_length segs) == 2) && ((itemAt segs 1) == "game.json")) {
                        push games (itemAt segs 0)
                    }
                }
                i = (i + 1)
            }
        }
        this.readResources()
        this.syncFiles(true)
        if ((array_length games) > 0) {
            gameId = (itemAt games 0)
        }
        status = ("project " + root + " · " + (to_string (array_length games)) + " game(s)")
    }

    fn addMount:void (vfs:string disk:string label:string) {
        def m:GameMount (new GameMount)
        m.vfs = vfs
        m.disk = disk
        m.label = label
        push mounts m
    }

    ; studio.json beside the game(s):
    ;   { "resources": { "tiles": "../big-tiles", "planets": "/data/planets" } }
    ; Each folder is mounted under the game ("/games/<id>/tiles/…") for a single
    ; game, or under "/games/tiles/…" for a collection. Folders stay where they
    ; are on disk: in another (possibly private) repository, never copied.
    fn readResources:void () {
        def conf:string (sh_read_text (GamePreview.joinPath(root "studio.json")))
        if ((strlen conf) == 0) {
            return
        }
        def at:int (indexOf conf "\"resources\"")
        if (at < 0) {
            return
        }
        def open:int (indexOfFrom conf "{" at)
        def close:int (indexOfFrom conf "}" at)
        if ((open < 0) || (close < open)) {
            return
        }
        def body:string (substring conf (open + 1) close)
        def strs:[string]
        def i:int 0
        def n:int (strlen body)
        while (i < n) {
            if ((charAt body i) == 34) {
                def j:int (i + 1)
                def s:string ""
                while ((j < n) && ((charAt body j) != 34)) {
                    s = (s + (substring body j (j + 1)))
                    j = (j + 1)
                }
                push strs s
                i = j
            }
            i = (i + 1)
        }
        def k:int 0
        while ((k + 1) < (array_length strs)) {
            def alias:string (itemAt strs k)
            def path:string (itemAt strs (k + 1))
            def disk:string path
            if (((strlen path) > 0) && ((charAt path 0) != 47)) {
                disk = (GamePreview.joinPath(root path))
            }
            disk = (sh_real_path disk)
            if ((sh_is_dir disk) == 1) {
                def vfs:string ("/games/" + alias)
                if single {
                    vfs = ("/games/" + (GamePreview.baseName(root)) + "/" + alias)
                }
                this.addMount(vfs disk ("resource " + alias))
            } {
                this.note(("studio.json: no folder " + disk + " for " + alias))
            }
            k = (k + 2)
        }
    }

    ; The engine path of a file on disk, or "" when no mount holds it.
    fn diskFor:string (vfsPath:string) {
        def best:string ""
        def bestLen:int -1
        def i:int 0
        while (i < (array_length mounts)) {
            def m:GameMount (itemAt mounts i)
            def pre:string (m.vfs + "/")
            if (((strlen pre) > bestLen) && ((indexOf vfsPath pre) == 0)) {
                best = (GamePreview.joinPath(m.disk (substring vfsPath (strlen pre) (strlen vfsPath))))
                bestLen = (strlen pre)
            }
            i = (i + 1)
        }
        return best
    }

    ; Put every new or changed file into the engine. Answers how many changed.
    ; A file that disappeared needs a fresh engine (it cannot forget a file).
    fn syncFiles:int (first:boolean) {
        def changed:int 0
        clear lastChanged
        def gone:boolean false
        def seen:[string:boolean]
        def mi:int 0
        while (mi < (array_length mounts)) {
            def m:GameMount (itemAt mounts mi)
            def listing:string (sh_list_files m.disk)
            def lines:[string] (strsplit listing "\n")
            def i:int 0
            while (i < (array_length lines)) {
                def parts:[string] (strsplit (itemAt lines i) "\t")
                if ((array_length parts) >= 3) {
                    def rel:string (itemAt parts 0)
                    def size:int (?? (to_int (itemAt parts 1)) 0)
                    def stamp:string ((itemAt parts 1) + ":" + (itemAt parts 2))
                    def vfs:string (m.vfs + "/" + rel)
                    def disk:string (GamePreview.joinPath(m.disk rel))
                    set seen vfs true
                    def old:string (?? (get stamps vfs) "")
                    if (old != stamp) {
                        if ((size > bigLimit) && (GamePreview.isMedia(rel))) {
                            sh_rg_put_head vfs disk headBytes
                            bytesKept = (bytesKept + (to_double size))
                        } {
                            sh_rg_put_file vfs disk
                            bytesPut = (bytesPut + (to_double size))
                        }
                        filesPut = (filesPut + 1)
                        set stamps vfs stamp
                        if (first == false) {
                            changed = (changed + 1)
                            push lastChanged rel
                            this.note(("changed " + vfs))
                            if (images.known(vfs)) {
                                images.forget(vfs)
                            }
                        }
                    }
                }
                i = (i + 1)
            }
            mi = (mi + 1)
        }
        def known:[string] (keys stamps)
        def ki:int 0
        while (ki < (array_length known)) {
            def k:string (itemAt known ki)
            if ((has seen k) == false) {
                gone = true
            }
            ki = (ki + 1)
        }
        if gone {
            this.note("a file was removed: the engine starts again from the disk")
            map_clear stamps
            sh_rg_reset
            images.clearAll()
            this.syncFiles(true)
            changed = (changed + 1)
            push lastChanged "(removed)"
        }
        return changed
    }

    ; Poll the disk now and then; a change restarts the game.
    fn watch:boolean () {
        def now:double (sh_now_ms)
        if ((now - lastSync) < syncEveryMs) {
            return false
        }
        lastSync = now
        def changed:int (this.syncFiles(false))
        if (changed > 0) {
            this.reload()
            return true
        }
        return false
    }

    ; After files changed on disk, as little as it takes:
    ;   pictures, sounds only  → nothing (pictures are read again when drawn)
    ;   style.css only         → the engine re-reads the style, the game goes on
    ;   code                   → restart, then the game's own state back
    ;                            (hotSave/hotLoad) or the scene it was in
    fn reload:void () {
        def code:boolean false
        def css:boolean false
        def i:int 0
        while (i < (array_length lastChanged)) {
            def rel:string (itemAt lastChanged i)
            def e:string (GamePreview.extOf(rel))
            if (e == "css") {
                css = true
            } {
                if ((GamePreview.isMedia(rel)) == false) {
                    code = true
                }
            }
            i = (i + 1)
        }
        if ((code == false) && (css == false)) {
            this.note("hot reload: pictures/sounds only, the game goes on")
            return
        }
        if ((code == false) && running) {
            def ok:int (sh_rg_restyle)
            this.takeLog()
            if (ok == 1) {
                this.note("hot reload: style.css, the game goes on")
                return
            }
        }
        this.hotRestart()
    }

    ; Restart with the game's state carried over when the game can give it.
    fn hotRestart:void () {
        def saved:string ""
        if running {
            saved = (this.evalJs("typeof hotSave === 'function' ? JSON.stringify(hotSave()) : ''"))
            if ((indexOf saved "Error") == 0) {
                this.note(("hotSave failed: " + saved))
                saved = ""
            }
        }
        def scene:string currentScene
        this.restart()
        if (running == false) {
            return
        }
        if ((strlen saved) > 0) {
            def r:string (this.evalJs(("hotLoad(JSON.parse(" + (GamePreview.jsString(saved)) + "))")))
            currentScene = scene
            this.note("hot reload: code, state kept (hotLoad)")
            if ((strlen r) > 0) {
                if ((indexOf r "rror") >= 0) {
                    this.note(("hotLoad: " + r))
                }
            }
            return
        }
        if (((strlen scene) > 0) && ((indexOf scenes scene) >= 0)) {
            this.jump(scene)
            this.note(("hot reload: code, back to scene " + scene))
            return
        }
        this.note("hot reload: code, restarted")
    }

    ; --- scenes ----------------------------------------------------------------------
    ; A game that wants jump points defines a global object of functions:
    ;   const SCENES = { "kuu-laskeutuminen": () => { ...set the state... } };
    ; and, to keep its state across a code change:
    ;   function hotSave() { return {...} }     function hotLoad(s) { ... }
    ; Other hosts never call them, so nothing changes for them.
    sfn jsString:string (s:string) {
        def out:string "\""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if (ch == 34) {
                out = (out + "\\\"")
            } {
                if (ch == 92) {
                    out = (out + "\\\\")
                } {
                    if (ch == 10) {
                        out = (out + "\\n")
                    } {
                        if (ch == 13) {
                            out = (out + "\\r")
                        } {
                            out = (out + (substring s i (i + 1)))
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return (out + "\"")
    }

    fn evalJs:string (src:string) {
        def r:string (sh_rg_eval src)
        this.takeLog()
        return r
    }

    fn readScenes:void () {
        clear scenes
        def r:string (this.evalJs("typeof SCENES === 'object' && SCENES ? JSON.stringify(Object.keys(SCENES)) : '[]'"))
        if (((strlen r) < 2) || ((charAt r 0) != 91)) {
            return
        }
        def parts:[string] (strsplit r "\"")
        def i:int 1
        while (i < (array_length parts)) {
            push scenes (itemAt parts i)
            i = (i + 2)
        }
    }

    fn jump:boolean (name:string) {
        if (running == false) {
            return false
        }
        if ((indexOf scenes name) < 0) {
            this.note(("no scene " + name + " (the game's SCENES has: " + (join scenes ", ") + ")"))
            return false
        }
        def r:string (this.evalJs(("SCENES[" + (GamePreview.jsString(name)) + "]()")))
        if ((indexOf r "rror") >= 0) {
            this.note(("scene " + name + ": " + r))
        }
        currentScene = name
        this.note(("scene " + name))
        return true
    }

    fn mountReport:string () {
        def out:string ""
        def i:int 0
        while (i < (array_length mounts)) {
            def m:GameMount (itemAt mounts i)
            out = (out + m.vfs + " <- " + m.disk + "\n")
            i = (i + 1)
        }
        return out
    }

    ; --- running -------------------------------------------------------------------
    fn setPanel:void (x:double y:double w:double h:double) {
        px = x
        py = y
        pw = w
        ph = h
        if ((w != sizedW) || (h != sizedH)) {
            sizedW = w
            sizedH = h
            sh_rg_resize w h
        }
    }

    fn restart:void () {
        if ((strlen gameId) == 0) {
            status = "no game in this folder (a game folder holds game.json)"
            running = false
            return
        }
        sh_rg_resize pw ph
        sizedW = pw
        sizedH = ph
        def r:int (sh_rg_start gameId)
        this.takeLog()
        currentScene = ""
        if (r == 0) {
            running = true
            status = ("running " + gameId)
            this.readScenes()
        } {
            running = false
            status = ("could not start " + gameId + " (see the log)")
        }
    }

    fn select:void (id:string) {
        gameId = id
        this.restart()
    }

    fn takeLog:void () {
        def text:string (sh_rg_log)
        if ((strlen text) == 0) {
            return
        }
        def lines:[string] (strsplit text "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def l:string (itemAt lines i)
            if ((strlen l) > 0) {
                this.note(l)
            }
            i = (i + 1)
        }
        while ((array_length logLines) > 400) {
            remove_index logLines 0
        }
    }

    fn takeImageProblems:void () {
        def i:int 0
        while (i < (array_length images.problems)) {
            this.note(("picture " + (itemAt images.problems i)))
            i = (i + 1)
        }
        clear images.problems
    }

    fn takeCommands:void () {
        def cmds:string (sh_rg_cmds)
        if ((strlen cmds) > 2) {
            ; sounds and speech are not played yet; count them for the status
            if ((indexOf cmds "\"sound\"") >= 0) {
                sounds = (sounds + 1)
            }
            if ((indexOf cmds "\"say\"") >= 0) {
                sounds = (sounds + 1)
            }
        }
    }

    fn inside:boolean (x:int y:int) {
        def fx:double (to_double x)
        def fy:double (to_double y)
        return ((fx >= px) && (fy >= py) && (fx < (px + pw)) && (fy < (py + ph)))
    }

    ; Mouse to the engine as a touch (id 1), in the panel's own coordinates.
    fn pointer:void (x:int y:int down:boolean pressed:boolean released:boolean) {
        if (running == false) {
            return
        }
        def lx:double ((to_double x) - px)
        def ly:double ((to_double y) - py)
        if pressed {
            if (this.inside(x y)) {
                downInside = true
                sh_rg_pointer 0 1 lx ly
            }
            return
        }
        if released {
            if downInside {
                downInside = false
                sh_rg_pointer 2 1 lx ly
            }
            return
        }
        if (downInside && down) {
            sh_rg_pointer 1 1 lx ly
        }
    }

    ; "1 ArrowLeft\n0 ArrowLeft\n" from the window, to the game
    fn keys:void (lines:string) {
        if (running == false) {
            return
        }
        def ls:[string] (strsplit lines "\n")
        def i:int 0
        while (i < (array_length ls)) {
            def l:string (itemAt ls i)
            if ((strlen l) > 2) {
                def down:int 0
                if ((charAt l 0) == 49) {
                    down = 1
                }
                sh_rg_key down (substring l 2 (strlen l))
            }
            i = (i + 1)
        }
    }

    ; One window frame: `speed` game frames (fast forward), none while paused
    ; unless a single step was asked for. A fast frame gives up when it has
    ; used 40 ms, so the window stays responsive.
    fn step:void (dtMs:double) {
        if (running == false) {
            return
        }
        def times:int speed
        if paused {
            if (stepOnce == false) {
                return
            }
            stepOnce = false
            times = 1
        }
        def t0:double (sh_now_ms)
        def k:int 0
        while (k < times) {
            def r:int (sh_rg_frame dtMs)
            frames = (frames + 1)
            this.takeLog()
            this.takeCommands()
            if (r != 0) {
                running = false
                status = ("the game stopped on an error (see the log)")
                k = times
            }
            k = (k + 1)
            if (((sh_now_ms) - t0) > 40.0) {
                k = times
            }
        }
    }

    ; n frames at 60 fps right now, also while paused: an agent moving time on.
    fn advance:int (n:int) {
        def k:int 0
        while ((k < n) && running) {
            def r:int (sh_rg_frame (1000.0 / 60.0))
            frames = (frames + 1)
            this.takeLog()
            this.takeCommands()
            if (r != 0) {
                running = false
                status = "the game stopped on an error (see the log)"
            }
            k = (k + 1)
        }
        return k
    }

    ; A tap at x,y in the game's own coordinates (its width and height).
    fn tapGame:void (x:double y:double) {
        if (running == false) {
            return
        }
        def lx:double ((sh_rg_view 1) + (x * (sh_rg_view 0)))
        def ly:double ((sh_rg_view 2) + (y * (sh_rg_view 0)))
        sh_rg_pointer 0 1 lx ly
        this.advance(1)
        sh_rg_pointer 2 1 lx ly
        this.advance(1)
    }

    ; --- the draw stream → EVG commands --------------------------------------------
    fn color:void (c:EVGDrawCmd r:double g:double b:double a:double) {
        c.r = (to_int r)
        c.g = (to_int g)
        c.b = (to_int b)
        c.a = a
    }

    ; Append this frame's picture to `dl`, placed in the panel.
    fn paint:void (dl:EVGDisplayList tr:UITextRenderer) {
        def scale:double (sh_rg_view 0)
        def ox:double (px + (sh_rg_view 1))
        def oy:double (py + (sh_rg_view 2))
        def gw:double (sh_rg_view 3)
        def gh:double (sh_rg_view 4)
        ; the game's background, then its box as a clip
        def bgc:EVGDrawCmd (new EVGDrawCmd)
        bgc.kind = 0
        bgc.x = px
        bgc.y = py
        bgc.w = pw
        bgc.h = ph
        push dl.cmds bgc
        def clipIn:EVGDrawCmd (new EVGDrawCmd)
        clipIn.kind = 4
        clipIn.x = ox
        clipIn.y = oy
        clipIn.w = (gw * scale)
        clipIn.h = (gh * scale)
        push dl.cmds clipIn
        def opened:int 0
        def n:int (sh_rg_draw_len)
        def i:int 0
        def count:int 0
        while ((i + 23) <= n) {
            def k:int (to_int (sh_rg_draw_at i))
            def x:double (sh_rg_draw_at (i + 1))
            def y:double (sh_rg_draw_at (i + 2))
            def w:double (sh_rg_draw_at (i + 3))
            def h:double (sh_rg_draw_at (i + 4))
            def cr:double (sh_rg_draw_at (i + 5))
            def cg:double (sh_rg_draw_at (i + 6))
            def cb:double (sh_rg_draw_at (i + 7))
            def ca:double (sh_rg_draw_at (i + 8))
            def tl:double (sh_rg_draw_at (i + 9))
            def t:double (sh_rg_draw_at (i + 13))
            def rot:double (sh_rg_draw_at (i + 14))
            def rox:double (sh_rg_draw_at (i + 15))
            def roy:double (sh_rg_draw_at (i + 16))
            def flags:int (to_int (sh_rg_draw_at (i + 17)))
            def s0:int (to_int (sh_rg_draw_at (i + 18)))
            def s1:int (to_int (sh_rg_draw_at (i + 19)))
            def s2:int (to_int (sh_rg_draw_at (i + 20)))
            def nx:int (to_int (sh_rg_draw_at (i + 22)))
            def e:int (i + 23)
            i = (e + nx)
            count = (count + 1)
            if dumpNext {
                def line:string ("[draw] " + (to_string k) + " x=" + (to_string (to_int x)) + " y=" + (to_string (to_int y)) + " w=" + (to_string (to_int w)) + " h=" + (to_string (to_int h)))
                if ((k == 2) || (k == 3)) {
                    line = (line + " " + (sh_rg_string s0))
                }
                sh_print line
            }
            def c:EVGDrawCmd (new EVGDrawCmd)
            c.kind = k
            c.x = (ox + (x * scale))
            c.y = (oy + (y * scale))
            c.w = (w * scale)
            c.h = (h * scale)
            c.radius = (tl * scale)
            this.color(c cr cg cb ca)
            c.rotate = rot
            if ((bit_and flags 128) != 0) {
                c.hasRotOrigin = true
                c.rotOriginX = (ox + (rox * scale))
                c.rotOriginY = (oy + (roy * scale))
            }
            if ((bit_and flags 1) != 0) {
                c.hasGrad = true
                if ((bit_and flags 2) != 0) {
                    c.gradDir = 1
                }
                c.r2 = (to_int (sh_rg_draw_at e))
                c.g2 = (to_int (sh_rg_draw_at (e + 1)))
                c.b2 = (to_int (sh_rg_draw_at (e + 2)))
                c.a2 = (sh_rg_draw_at (e + 3))
                e = (e + 4)
            }
            if ((bit_and flags 4) != 0) {
                c.hasShadow = true
                c.shadowX = ((sh_rg_draw_at e) * scale)
                c.shadowY = ((sh_rg_draw_at (e + 1)) * scale)
                c.shadowBlur = ((sh_rg_draw_at (e + 2)) * scale)
                c.shadowR = (to_int (sh_rg_draw_at (e + 3)))
                c.shadowG = (to_int (sh_rg_draw_at (e + 4)))
                c.shadowB = (to_int (sh_rg_draw_at (e + 5)))
                c.shadowA = (sh_rg_draw_at (e + 6))
                e = (e + 7)
            }
            def hasCrop:boolean false
            def c0:double 0.0
            def c1:double 0.0
            def c2:double 1.0
            def c3:double 1.0
            if ((bit_and flags 64) != 0) {
                hasCrop = true
                c0 = (sh_rg_draw_at e)
                c1 = (sh_rg_draw_at (e + 1))
                c2 = (sh_rg_draw_at (e + 2))
                c3 = (sh_rg_draw_at (e + 3))
                e = (e + 4)
            }
            def hasTile:boolean false
            def tx0:double 0.0
            def ty0:double 0.0
            def tw:double 0.0
            def th:double 0.0
            if ((bit_and flags 1024) != 0) {
                hasTile = true
                tx0 = (sh_rg_draw_at e)
                ty0 = (sh_rg_draw_at (e + 1))
                tw = (sh_rg_draw_at (e + 2))
                th = (sh_rg_draw_at (e + 3))
                e = (e + 4)
            }
            if (k == 4) {
                opened = (opened + 1)
                push dl.cmds c
            }
            if (k == 5) {
                if (opened > 0) {
                    opened = (opened - 1)
                    push dl.cmds c
                }
            }
            def visible:boolean ((ca > 0.0) || c.hasGrad)
            if (((k == 0) || (k == 1)) && visible) {
                c.thickness = (t * scale)
                push dl.cmds c
            }
            if (k == 2) {
                this.paintImage(dl c (sh_rg_string s0) flags hasCrop c0 c1 c2 c3 hasTile ((ox + (tx0 * scale))) ((oy + (ty0 * scale))) (tw * scale) (th * scale))
            }
            if ((k == 3) && visible) {
                c.text = (sh_rg_string s0)
                c.fontFamily = (sh_rg_string s1)
                c.fontWeight = (sh_rg_string s2)
                c.fontSize = (t * scale)
                if ((bit_and flags 256) != 0) {
                    c.textAlign = "italic"
                }
                if (((strlen c.text) > 0) && (c.fontSize > 0.5)) {
                    ; centred on its box's middle line, as the web painter does;
                    ; a run whose width differs much from EVG's is centred
                    def size:double c.fontSize
                    def runW:double (tr.measureWidth(c.text size))
                    def lh:double (tr.lineHeight(size))
                    def boxW:double c.w
                    if ((boxW > 0.0) && (runW > 0.0)) {
                        def ratio:double (boxW / runW)
                        if ((ratio < 0.9) || (ratio > 1.1)) {
                            c.x = (c.x + ((boxW - runW) / 2.0))
                        }
                    }
                    c.y = (((c.y + (c.h / 2.0)) - (lh / 2.0)) + (size * 0.04))
                    c.w = runW
                    c.h = lh
                    push dl.cmds c
                }
            }
            if (((k == 6) || (k == 7)) && visible && (nx > 0)) {
                def np:int (to_int (sh_rg_draw_at e))
                def pi:int 0
                while (pi < np) {
                    def v:double (sh_rg_draw_at ((e + 1) + pi))
                    if ((pi % 2) == 0) {
                        push c.pts (ox + (v * scale))
                    } {
                        push c.pts (oy + (v * scale))
                    }
                    pi = (pi + 1)
                }
                def ne:int (to_int (sh_rg_draw_at ((e + 1) + np)))
                def ri:int 0
                while (ri < ne) {
                    push c.ringEnds (to_int (sh_rg_draw_at (((e + 2) + np) + ri)))
                    ri = (ri + 1)
                }
                c.evenOdd = ((bit_and flags 32) != 0)
                c.thickness = (t * scale)
                if (c.thickness <= 0.0) {
                    c.thickness = scale
                }
                if (c.rotate != 0.0) {
                    ; the painter turns about the box's centre when no origin
                    ; is given; a path's box is its stream box
                    if (c.hasRotOrigin == false) {
                        c.hasRotOrigin = true
                        c.rotOriginX = (c.x + (c.w / 2.0))
                        c.rotOriginY = (c.y + (c.h / 2.0))
                    }
                }
                push dl.cmds c
            }
            ; a textured globe: the camera numbers go along as they are (game
            ; units); the box in game units rides in the crop fields
            if ((k == 8) && (nx >= 20)) {
                def src8:string (sh_rg_string s0)
                def globe:StudioImage (images.get(src8 (this.diskFor(src8))))
                if (globe.ok && (w > 0.0) && (h > 0.0)) {
                    c.src = src8
                    c.cropX = x
                    c.cropY = y
                    c.cropW = w
                    c.cropH = h
                    def gi:int 0
                    while (gi < nx) {
                        push c.pts (sh_rg_draw_at (e + gi))
                        gi = (gi + 1)
                    }
                    push dl.cmds c
                }
            }
        }
        while (opened > 0) {
            def pop:EVGDrawCmd (new EVGDrawCmd)
            pop.kind = 5
            push dl.cmds pop
            opened = (opened - 1)
        }
        def clipOut:EVGDrawCmd (new EVGDrawCmd)
        clipOut.kind = 5
        push dl.cmds clipOut
        cmdsLast = count
        dumpNext = false
        this.takeImageProblems()
    }

    fn paintImage:void (dl:EVGDisplayList c:EVGDrawCmd src:string flags:int hasCrop:boolean c0:double c1:double c2:double c3:double hasTile:boolean tx0:double ty0:double tw:double th:double) {
        if (((strlen src) == 0) || (c.w <= 0.0) || (c.h <= 0.0)) {
            return
        }
        def img:StudioImage (images.get(src (this.diskFor(src))))
        if (img.ok == false) {
            return
        }
        c.src = src
        c.flipH = ((bit_and flags 8) != 0)
        c.flipV = ((bit_and flags 16) != 0)
        if ((c.a <= 0.0) || (c.a > 1.0)) {
            c.a = 1.0
        }
        if (hasTile && (tw > 0.5) && (th > 0.5)) {
            def clipIn:EVGDrawCmd (new EVGDrawCmd)
            clipIn.kind = 4
            clipIn.x = c.x
            clipIn.y = c.y
            clipIn.w = c.w
            clipIn.h = c.h
            push dl.cmds clipIn
            def placed:int 0
            def yy:double ty0
            while ((yy < (c.y + c.h)) && (placed < 2000)) {
                def xx:double tx0
                while ((xx < (c.x + c.w)) && (placed < 2000)) {
                    if (((xx + tw) > c.x) && ((yy + th) > c.y)) {
                        def one:EVGDrawCmd (new EVGDrawCmd)
                        one.kind = 2
                        one.src = src
                        one.x = xx
                        one.y = yy
                        one.w = tw
                        one.h = th
                        one.a = c.a
                        push dl.cmds one
                        placed = (placed + 1)
                    }
                    xx = (xx + tw)
                }
                yy = (yy + th)
            }
            def clipOut:EVGDrawCmd (new EVGDrawCmd)
            clipOut.kind = 5
            push dl.cmds clipOut
            return
        }
        if hasCrop {
            c.hasCrop = true
            c.cropX = c0
            c.cropY = c1
            c.cropW = (c2 - c0)
            c.cropH = (c3 - c1)
        } {
            ; object-fit: cover, as EVG's other painters do
            def iw:double (to_double img.width)
            def ih:double (to_double img.height)
            def sc:double (c.w / iw)
            if ((c.h / ih) > sc) {
                sc = (c.h / ih)
            }
            def sw:double (c.w / sc)
            def sh:double (c.h / sc)
            c.hasCrop = true
            c.cropX = (((iw - sw) / 2.0) / iw)
            c.cropY = (((ih - sh) / 2.0) / ih)
            c.cropW = (sw / iw)
            c.cropH = (sh / ih)
        }
        push dl.cmds c
    }
}
