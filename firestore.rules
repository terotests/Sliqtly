rules_version = '2';

// decks: a presentation, its owner's alone.
// shares: the copy made when a deck is shared. Anyone holding the short id
// reads it; only its owner lists its own (a query on owner), changes or
// deletes it.
// mcp_keys, mcp_oauth_*: the MCP server's edit keys and sign-in state
// (mcp-go/). No rule matches them, so only the Admin SDK reads or writes them.
// stats, stats_salt, stats_seen: the visitor counts (mcp-go/rgr/Stats.rgr); no
// rule either.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /decks/{deckId} {
      allow read, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
    }

    match /shares/{shareId} {
      allow get: if true;
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}
