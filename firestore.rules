rules_version = '2';

// decks: a presentation, its owner's alone.
// shares: the copy made when a deck is shared. Anyone holding the short id
// reads it; nobody can list the ids; only its owner changes or deletes it.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /decks/{deckId} {
      allow read, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
    }

    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}
