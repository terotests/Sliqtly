; =============================================================================
; PresFigma — the shared Figma files, as a deck and an assistant see them
; =============================================================================
; A design file is put in the shared Files once. The server reads it with
; DesignViewer and keeps an INDEX beside it (DesignViewer's FigIndex JSON:
; pages, screens, the words on them, their named parts, the metadata the file
; carries) and one cut per screen. Everything here works on those indexes and
; never on a file: what a reference in the Markdown points at, which screens a
; search finds, what the Files panel lists. The editor (JavaScript) and the
; server (Go) both run it, so a search in the panel and one an assistant makes
; through MCP find the same screens in the same order.
;
; A screen on a slide is a picture whose address is
;
;     figma:<file id>/<layer>
;
; where the layer is the Figma id of a screen ("12:34") or of any layer inside
; one (a part: "12:40"), or the name of a screen ("Login") when the name is
; unique in the file. The picture's key in the deck's store is
; `/figma/<file id>/<layer>.png`.
; =============================================================================

Import "JsonValue.rgr"

class FigmaRef {
    def ok:boolean false
    def file:string ""
    def node:string ""
    def err:string ""

    Constructor () {
    }

    sfn isFigma:boolean (dest:string) {
        def t:string (trim dest)
        if ((strlen t) < 6) {
            return false
        }
        return ((to_lowercase (substring t 0 6)) == "figma:")
    }

    ; `figma:app-design/12:34`, read. The file id is everything up to the
    ; first slash, the layer everything after it: an id inside an instance
    ; is a path of ids and may hold slashes of its own.
    sfn parse:FigmaRef (dest:string) {
        def r (new FigmaRef())
        if ((FigmaRef.isFigma(dest)) == false) {
            r.err = "not a figma: address"
            return r
        }
        def t:string (trim dest)
        def rest:string (substring t 6 (strlen t))
        ; a leading // is tolerated: figma://app-design/12:34
        while (((strlen rest) > 0) && ((charAt rest 0) == 47)) {
            rest = (substring rest 1 (strlen rest))
        }
        def slash:int (indexOf rest "/")
        if (slash <= 0) {
            r.err = "a figma: address is figma:<file>/<screen or layer>"
            return r
        }
        r.file = (trim (substring rest 0 slash))
        r.node = (trim (FigmaRef.unescape((substring rest (slash + 1) (strlen rest)))))
        if ((strlen r.node) == 0) {
            r.err = "no screen or layer after the file"
            return r
        }
        r.ok = true
        return r
    }

    ; A Markdown link destination cannot hold a space unless it is escaped,
    ; and a name is written as %20 or + by whoever escaped it.
    sfn unescape:string (s:string) {
        if (((indexOf s "%20") < 0) && ((indexOf s "+") < 0)) {
            return s
        }
        def parts:[string] (strsplit s "%20")
        def joined:string (join parts " ")
        def plus:[string] (strsplit joined "+")
        return (join plus " ")
    }

    ; A Figma layer id ("12:34"), or a layer inside an instance, which
    ; DesignViewer names "<layer id>#<path of the instance>". It starts with
    ; a digit and has a colon; a screen's name is anything else.
    sfn isNodeId:boolean (s:string) {
        if ((strlen s) < 3) {
            return false
        }
        def c:int (charAt s 0)
        if ((c < 48) || (c > 57)) {
            return false
        }
        return ((indexOf s ":") > 0)
    }

    sfn address:string (file:string node:string) {
        return ("figma:" + file + "/" + node)
    }

    sfn pictureKey:string (file:string node:string) {
        return ("/figma/" + file + "/" + node + ".png")
    }

    fn key:string () {
        return (FigmaRef.pictureKey(file node))
    }

    ; The address back out of a picture key, or a FigmaRef that is not ok.
    sfn fromKey:FigmaRef (key:string) {
        def r (new FigmaRef())
        if ((strlen key) < 12) {
            return r
        }
        if ((substring key 0 7) != "/figma/") {
            return r
        }
        if ((substring key ((strlen key) - 4) (strlen key)) != ".png") {
            return r
        }
        def inner:string (substring key 7 ((strlen key) - 4))
        return (FigmaRef.parse(("figma:" + inner)))
    }

    ; Markdown for a picture of a layer: alt text is its name, made safe for
    ; the brackets it goes in.
    sfn markdown:string (file:string node:string name:string) {
        def alt:string (trim (join (strsplit (join (strsplit name "[") "") "]") ""))
        return ("![" + alt + "](" + (FigmaRef.address(file node)) + ")")
    }
}

class FigmaPart {
    def id:string ""
    def name:string ""
    def type:string ""
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0

    Constructor () {
    }
}

class FigmaScreen {
    def fileId:string ""
    def id:string ""
    def page:string ""
    def pageName:string ""
    def name:string ""
    def section:string ""
    def type:string ""
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    def text:string ""
    def parts:[FigmaPart]
    def components:[string]
    def linksTo:[string]
    def description:string ""
    def flowStart:string ""
    def status:string ""
    def notes:[string]

    Constructor () {
    }

    fn partById@(optional):FigmaPart (id:string) {
        def r@(optional):FigmaPart
        def i:int 0
        while (i < (array_length parts)) {
            def p:FigmaPart (itemAt parts i)
            if (p.id == id) {
                r = p
                return r
            }
            i = (i + 1)
        }
        return r
    }
}

class FigmaPage {
    def id:string ""
    def name:string ""
    def screens:int 0

    Constructor () {
    }
}

class FigmaFile {
    def id:string ""
    def name:string ""
    def kind:string "figma"
    def bytes:int 0
    ; indexing | ready | failed
    def status:string "ready"
    def err:string ""
    def updated:string ""
    def background:string ""
    def pages:[FigmaPage]
    def screens:[FigmaScreen]

    Constructor () {
    }

    ; A file from its index JSON. `id`, `name` and the rest of what the host
    ; knows (size, status) are set by the caller; the index says the rest.
    sfn fromIndex:FigmaFile (id:string json:string) {
        def f (new FigmaFile())
        f.id = id
        def v:JVal (JVal.parse(json))
        if ((v.valid()) == false) {
            f.status = "failed"
            f.err = "the index is not JSON"
            return f
        }
        f.name = (v.strOr("file" id))
        f.bytes = (v.intOr("bytes" 0))
        def meta:JVal (v.get("meta"))
        f.background = (meta.strOr("background" ""))
        def pages:JVal (v.get("pages"))
        def pi:int 0
        while (pi < (pages.len())) {
            def pv:JVal (pages.at(pi))
            def pg (new FigmaPage())
            pg.id = (pv.strOr("id" ""))
            pg.name = (pv.strOr("name" ""))
            pg.screens = (pv.intOr("screens" 0))
            push f.pages pg
            pi = (pi + 1)
        }
        def screens:JVal (v.get("screens"))
        def si:int 0
        while (si < (screens.len())) {
            push f.screens (FigmaFile.screenOf(f (screens.at(si))))
            si = (si + 1)
        }
        return f
    }

    sfn screenOf:FigmaScreen (f:FigmaFile sv:JVal) {
        def s (new FigmaScreen())
        s.fileId = f.id
        s.id = (sv.strOr("id" ""))
        s.page = (sv.strOr("page" ""))
        s.pageName = (f.pageName(s.page))
        s.name = (sv.strOr("name" ""))
        s.section = (sv.strOr("section" ""))
        s.type = (sv.strOr("type" ""))
        s.x = (sv.numOr("x" 0.0))
        s.y = (sv.numOr("y" 0.0))
        s.w = (sv.numOr("w" 0.0))
        s.h = (sv.numOr("h" 0.0))
        s.text = (sv.strOr("text" ""))
        s.description = (sv.strOr("description" ""))
        s.flowStart = (sv.strOr("flowStart" ""))
        s.status = (sv.strOr("status" ""))
        def parts:JVal (sv.get("parts"))
        def i:int 0
        while (i < (parts.len())) {
            def pv:JVal (parts.at(i))
            def p (new FigmaPart())
            p.id = (pv.strOr("id" ""))
            p.name = (pv.strOr("name" ""))
            p.type = (pv.strOr("type" ""))
            p.x = (pv.numOr("x" 0.0))
            p.y = (pv.numOr("y" 0.0))
            p.w = (pv.numOr("w" 0.0))
            p.h = (pv.numOr("h" 0.0))
            push s.parts p
            i = (i + 1)
        }
        s.components = (FigmaFile.strings((sv.get("components"))))
        s.notes = (FigmaFile.strings((sv.get("notes"))))
        def links:JVal (sv.get("links"))
        def li:int 0
        while (li < (links.len())) {
            def to:string ((links.at(li)).strOr("to" ""))
            if (((strlen to) > 0) && ((FigmaFile.listHas(s.linksTo to)) == false)) {
                push s.linksTo to
            }
            li = (li + 1)
        }
        return s
    }

    sfn strings:[string] (v:JVal) {
        def out:[string]
        def i:int 0
        while (i < (v.len())) {
            def s:string ((v.at(i)).asStr(""))
            if ((strlen s) > 0) {
                push out s
            }
            i = (i + 1)
        }
        return out
    }

    sfn listHas:boolean (list:[string] s:string) {
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == s) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn pageName:string (id:string) {
        def i:int 0
        while (i < (array_length pages)) {
            def p:FigmaPage (itemAt pages i)
            if (p.id == id) {
                return p.name
            }
            i = (i + 1)
        }
        return ""
    }

    fn screenById@(optional):FigmaScreen (id:string) {
        def r@(optional):FigmaScreen
        def i:int 0
        while (i < (array_length screens)) {
            def s:FigmaScreen (itemAt screens i)
            if (s.id == id) {
                r = s
                return r
            }
            i = (i + 1)
        }
        return r
    }

    ; The screens with that name, any case.
    fn screensNamed:[FigmaScreen] (name:string) {
        def out:[FigmaScreen]
        def want:string (to_lowercase (trim name))
        def i:int 0
        while (i < (array_length screens)) {
            def s:FigmaScreen (itemAt screens i)
            if ((to_lowercase (trim s.name)) == want) {
                push out s
            }
            i = (i + 1)
        }
        return out
    }

    ; The screen a layer is on: the screen itself, the one listing it as a
    ; part, or the one whose id its path starts with (a layer inside an
    ; instance is "<instance id>;<layer id>" or a path below the screen's).
    fn screenOfNode@(optional):FigmaScreen (id:string) {
        def own@(optional):FigmaScreen (this.screenById(id))
        if (!null? own) {
            return own
        }
        def r@(optional):FigmaScreen
        def i:int 0
        while (i < (array_length screens)) {
            def s:FigmaScreen (itemAt screens i)
            def part@(optional):FigmaPart (s.partById(id))
            if (!null? part) {
                r = s
                return r
            }
            i = (i + 1)
        }
        return r
    }
}

; What a reference resolves to.
class FigmaTarget {
    def ok:boolean false
    def err:string ""
    def file:string ""
    ; the layer id to draw (a screen's or a part's)
    def node:string ""
    def name:string ""
    def screen:string ""
    def isPart:boolean false

    Constructor () {
    }
}

class FigmaHit {
    def fileId:string ""
    def fileName:string ""
    def screen:FigmaScreen (new FigmaScreen())
    ; set when the query named a part of the screen
    def partId:string ""
    def partName:string ""
    def score:int 0
    def snippet:string ""

    Constructor () {
    }

    fn node:string () {
        if ((strlen partId) > 0) {
            return partId
        }
        return screen.id
    }

    fn name:string () {
        if ((strlen partName) > 0) {
            return partName
        }
        return screen.name
    }

    fn markdown:string () {
        return (FigmaRef.markdown(fileId (this.node()) (this.name())))
    }
}

class FigmaLibrary {
    def files:[FigmaFile]

    Constructor () {
    }

    fn add:void (f:FigmaFile) {
        def kept:[FigmaFile]
        def i:int 0
        while (i < (array_length files)) {
            def e:FigmaFile (itemAt files i)
            if (e.id != f.id) {
                push kept e
            }
            i = (i + 1)
        }
        push kept f
        files = kept
    }

    fn fileById@(optional):FigmaFile (id:string) {
        def r@(optional):FigmaFile
        def i:int 0
        while (i < (array_length files)) {
            def f:FigmaFile (itemAt files i)
            if (f.id == id) {
                r = f
                return r
            }
            i = (i + 1)
        }
        return r
    }

    ; What `figma:<file>/<layer>` draws: a layer id is taken as it is when it
    ; is a screen or a listed part, and otherwise trusted to be a layer under
    ; a screen whose cut has it (the cut is the authority, not the index);
    ; a name must name exactly one screen.
    fn resolve:FigmaTarget (dest:string) {
        def t (new FigmaTarget())
        def ref:FigmaRef (FigmaRef.parse(dest))
        if (ref.ok == false) {
            t.err = ref.err
            return t
        }
        t.file = ref.file
        def fo@(optional):FigmaFile (this.fileById(ref.file))
        if (null? fo) {
            t.err = ("no shared file " + ref.file)
            return t
        }
        def f:FigmaFile (unwrap fo)
        if (f.status != "ready") {
            t.err = (f.name + " is " + f.status)
            return t
        }
        if (FigmaRef.isNodeId(ref.node)) {
            t.node = ref.node
            def so@(optional):FigmaScreen (f.screenOfNode(ref.node))
            if (null? so) {
                t.ok = true
                t.isPart = true
                t.name = ref.node
                return t
            }
            def s:FigmaScreen (unwrap so)
            t.screen = s.id
            t.isPart = (s.id != ref.node)
            t.name = s.name
            if t.isPart {
                def po@(optional):FigmaPart (s.partById(ref.node))
                if (!null? po) {
                    def part:FigmaPart (unwrap po)
                    t.name = part.name
                }
            }
            t.ok = true
            return t
        }
        def named:[FigmaScreen] (f.screensNamed(ref.node))
        if ((array_length named) == 0) {
            t.err = ("no screen called \"" + ref.node + "\" in " + f.name)
            return t
        }
        if ((array_length named) > 1) {
            t.err = (((to_string (array_length named)) + " screens are called \"" + ref.node + "\" in " + f.name) + "; use the screen's id")
            return t
        }
        def one:FigmaScreen (itemAt named 0)
        t.node = one.id
        t.screen = one.id
        t.name = one.name
        t.ok = true
        return t
    }

    ; --- search ---------------------------------------------------------------
    ;
    ; Every word of the query must be found somewhere on a screen: in its
    ; name, its section or page, a part's name, a component, its notes or
    ; description, or the words on it. Where it is found decides how much it
    ; counts — a screen CALLED "Login" before one that only says "log in" in
    ; a footer. A word found in a part's name makes the hit that part, so
    ; "checkout pay button" finds the button rather than the whole screen.
    ; Ties keep the files' and screens' own order.

    sfn words:[string] (q:string) {
        def out:[string]
        def low:string (to_lowercase q)
        def n:int (strlen low)
        def start:int 0
        def i:int 0
        while (i <= n) {
            def sep:boolean true
            if (i < n) {
                sep = (FigmaLibrary.isSep((charAt low i)))
            }
            if sep {
                if (i > start) {
                    push out (substring low start i)
                }
                start = (i + 1)
            }
            i = (i + 1)
        }
        return out
    }

    ; ASCII punctuation and white space part words; letters outside ASCII
    ; (ä, ö, an emoji) are kept inside them.
    sfn isSep:boolean (c:int) {
        if (c >= 128) {
            return false
        }
        if ((c >= 48) && (c <= 57)) {
            return false
        }
        if ((c >= 97) && (c <= 122)) {
            return false
        }
        if ((c >= 65) && (c <= 90)) {
            return false
        }
        return true
    }

    ; Is `word` a word of `text` (both lower case): whole, or the start of one.
    sfn hasWord:boolean (text:string word:string) {
        def n:int (strlen text)
        def m:int (strlen word)
        if ((m == 0) || (m > n)) {
            return false
        }
        def from:int 0
        while (from <= (n - m)) {
            def at:int (FigmaLibrary.findFrom(text word from))
            if (at < 0) {
                return false
            }
            if (at == 0) {
                return true
            }
            if (FigmaLibrary.isSep((charAt text (at - 1)))) {
                return true
            }
            from = (at + 1)
        }
        return false
    }

    sfn findFrom:int (text:string word:string from:int) {
        if (from == 0) {
            return (indexOf text word)
        }
        def rest:string (substring text from (strlen text))
        def at:int (indexOf rest word)
        if (at < 0) {
            return at
        }
        return (from + at)
    }

    fn search:[FigmaHit] (query:string fileId:string limit:int) {
        def ws:[string] (FigmaLibrary.words(query))
        def hits:[FigmaHit]
        if ((array_length ws) == 0) {
            return hits
        }
        def fi:int 0
        while (fi < (array_length files)) {
            def f:FigmaFile (itemAt files fi)
            def wanted:boolean (((strlen fileId) == 0) || (fileId == f.id))
            if (wanted && (f.status == "ready")) {
                def si:int 0
                while (si < (array_length f.screens)) {
                    def s:FigmaScreen (itemAt f.screens si)
                    def h@(optional):FigmaHit (FigmaLibrary.score(f s ws))
                    if (!null? h) {
                        push hits (unwrap h)
                    }
                    si = (si + 1)
                }
            }
            fi = (fi + 1)
        }
        def sorted:[FigmaHit] (FigmaLibrary.byScore(hits))
        def out:[FigmaHit]
        def k:int 0
        while ((k < (array_length sorted)) && ((limit <= 0) || (k < limit))) {
            push out (itemAt sorted k)
            k = (k + 1)
        }
        return out
    }

    ; Stable: an insertion sort, highest score first.
    sfn byScore:[FigmaHit] (hits:[FigmaHit]) {
        def out:[FigmaHit]
        def i:int 0
        while (i < (array_length hits)) {
            def h:FigmaHit (itemAt hits i)
            def placed:[FigmaHit]
            def done:boolean false
            def j:int 0
            while (j < (array_length out)) {
                def o:FigmaHit (itemAt out j)
                if ((done == false) && (h.score > o.score)) {
                    push placed h
                    done = true
                }
                push placed o
                j = (j + 1)
            }
            if (done == false) {
                push placed h
            }
            out = placed
            i = (i + 1)
        }
        return out
    }

    sfn score@(optional):FigmaHit (f:FigmaFile s:FigmaScreen ws:[string]) {
        def none@(optional):FigmaHit
        def name:string (to_lowercase s.name)
        def place:string (to_lowercase (s.section + " " + s.pageName))
        def comps:string (to_lowercase (join s.components " "))
        def about:string (to_lowercase (s.description + " " + s.flowStart + " " + (join s.notes " ")))
        def text:string (to_lowercase s.text)
        def total:int 0
        def bestPart:int (0 - 1)
        def bestPartHits:int 0
        def partHits:[int]
        def pi:int 0
        while (pi < (array_length s.parts)) {
            push partHits 0
            pi = (pi + 1)
        }
        def firstTextWord:string ""
        def wi:int 0
        while (wi < (array_length ws)) {
            def w:string (itemAt ws wi)
            def got:int 0
            if (FigmaLibrary.hasWord(name w)) {
                got = (got + 10)
            }
            if (FigmaLibrary.hasWord(place w)) {
                got = (got + 5)
            }
            def pj:int 0
            def inPart:boolean false
            while (pj < (array_length s.parts)) {
                def p:FigmaPart (itemAt s.parts pj)
                if (FigmaLibrary.hasWord((to_lowercase p.name) w)) {
                    set partHits pj ((itemAt partHits pj) + 1)
                    inPart = true
                }
                pj = (pj + 1)
            }
            if inPart {
                got = (got + 6)
            }
            if (FigmaLibrary.hasWord(comps w)) {
                got = (got + 4)
            }
            if (FigmaLibrary.hasWord(about w)) {
                got = (got + 3)
            }
            if (FigmaLibrary.hasWord(text w)) {
                got = (got + 2)
                if ((strlen firstTextWord) == 0) {
                    firstTextWord = w
                }
            }
            if (got == 0) {
                return none
            }
            total = (total + got)
            wi = (wi + 1)
        }
        def h (new FigmaHit())
        h.fileId = f.id
        h.fileName = f.name
        h.screen = s
        h.score = total
        ; The part named by the most query words, when one is named by at
        ; least one and the screen's own name does not already say it all.
        def pk:int 0
        while (pk < (array_length partHits)) {
            if ((itemAt partHits pk) > bestPartHits) {
                bestPartHits = (itemAt partHits pk)
                bestPart = pk
            }
            pk = (pk + 1)
        }
        if (bestPart >= 0) {
            def nameHits:int 0
            def nk:int 0
            while (nk < (array_length ws)) {
                if (FigmaLibrary.hasWord(name (itemAt ws nk))) {
                    nameHits = (nameHits + 1)
                }
                nk = (nk + 1)
            }
            if (nameHits < (array_length ws)) {
                def bp:FigmaPart (itemAt s.parts bestPart)
                h.partId = bp.id
                h.partName = bp.name
            }
        }
        if ((strlen firstTextWord) > 0) {
            h.snippet = (FigmaLibrary.snippet(s.text firstTextWord 90))
        }
        def found@(optional):FigmaHit h
        return found
    }

    ; About `span` units of `text` around the first place `word` (lower
    ; case) is found, cut at spaces, with … where it was cut.
    sfn snippet:string (original:string word:string span:int) {
        def low:string (to_lowercase original)
        def text:string original
        if ((strlen low) != (strlen original)) {
            ; lower case changed the length (a few scripts do); cut from the
            ; lower-case copy so the positions agree
            text = low
        }
        def at:int (indexOf low word)
        if (at < 0) {
            at = 0
        }
        def n:int (strlen text)
        def from:int (at - (idiv span 3))
        if (from < 0) {
            from = 0
        }
        def to:int (from + span)
        if (to > n) {
            to = n
        }
        while ((from > 0) && ((charAt text from) != 32)) {
            from = (from - 1)
        }
        while ((to < n) && ((charAt text to) != 32)) {
            to = (to + 1)
        }
        def out:string (trim (substring text from to))
        if (from > 0) {
            out = ("… " + out)
        }
        if (to < n) {
            out = (out + " …")
        }
        return out
    }
}
