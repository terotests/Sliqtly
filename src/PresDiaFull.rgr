; ============================================================================
; PresDiaFull.rgr — a small diagram opened over the whole slide
; ============================================================================
;
; While presenting, a diagram that the slide draws small carries a magnifier
; button. A press grows it over the whole slide (a veil in the slide's own
; colour under it), a second press, Esc or leaving the slide puts it back.
; The diagram keeps its camera, tour and choices: only the box it is painted
; in changes, so everything it does in its own box it does in the big one.
;
; Everything is on the host's wall clock (`now`, seconds); nothing here draws.
; `amount(now)` is how far open it is (0 in its place, 1 over the slide),
; `boxAt` the box to paint in at that point, `busy(now)` whether a frame now
; differs from the one before.

class PresDiaFull {
    ; seconds a whole grow or shrink takes
    def dur:double 0.3
    def open:boolean false
    ; where the last change began: when, and how far open it was then
    def at:double -100.0
    def from:double 0.0

    ; How far open, unshaped: 0..1 along the time.
    fn linear:double (now:double) {
        def d:double ((now - at) / dur)
        if (d < 0.0) {
            d = 0.0
        }
        if open {
            return (PresDiaFull.part((from + d)))
        }
        return (PresDiaFull.part((from - d)))
    }

    ; How far open, eased in and out.
    fn amount:double (now:double) {
        def p:double (this.linear(now))
        return ((p * p) * (3.0 - (2.0 * p)))
    }

    ; Anything of it over the slide: it is painted on top, not in its place.
    fn shown:boolean (now:double) {
        return (open || ((this.amount(now)) > 0.0))
    }

    fn busy:boolean (now:double) {
        def p:double (this.linear(now))
        return ((p > 0.0) && (p < 1.0))
    }

    ; Grow (or shrink) from wherever it is now, so a press half way turns it
    ; back without a jump.
    fn setOpen:void (now:double want:boolean) {
        if (want == open) {
            return
        }
        from = (this.linear(now))
        at = now
        open = want
    }

    fn toggle:void (now:double) {
        this.setOpen(now (! open))
    }

    ; Back in its place at once (the slide was left).
    fn reset:void () {
        open = false
        from = 0.0
        at = -100.0
    }

    ; The box to paint in: the diagram's own (sx, sy, sw, sh) moving to the
    ; whole slide's (fx, fy, fw, fh). [x, y, w, h].
    fn boxAt:[double] (now:double sx:double sy:double sw:double sh:double fx:double fy:double fw:double fh:double) {
        def a:double (this.amount(now))
        def x:double (sx + ((fx - sx) * a))
        def y:double (sy + ((fy - sy) * a))
        def w:double (sw + ((fw - sw) * a))
        def h:double (sh + ((fh - sh) * a))
        return ([] _:double (x y w h))
    }

    ; The whole slide's box: the page less a thin margin, room for the
    ; diagram's own buttons along its edges, and ending above `bottom` (a
    ; bar the host lays over the slide's foot, in slide units; 0 or less:
    ; none) so its buttons are not under the bar's.
    sfn fullBox:[double] (pageW:double pageH:double bottom:double) {
        def m:double (pageW * 0.025)
        if ((pageH * 0.025) < m) {
            m = (pageH * 0.025)
        }
        def foot:double (pageH - m)
        if ((bottom > 0.0) && ((bottom - (m * 0.5)) < foot)) {
            foot = (bottom - (m * 0.5))
        }
        if (foot < (pageH * 0.5)) {
            foot = (pageH * 0.5)
        }
        def w:double (pageW - (m * 2.0))
        def h:double (foot - m)
        return ([] _:double (m m w h))
    }

    ; Worth offering: over the slide the diagram would be drawn at least a
    ; quarter bigger than in its place (`fit` is the diagram's scale in each
    ; box). A diagram that already fills the slide gets no magnifier.
    sfn worth:boolean (smallFit:double fullFit:double) {
        if (smallFit <= 0.0) {
            return false
        }
        return (fullFit >= (smallFit * 1.25))
    }

    sfn part:double (v:double) {
        if (v < 0.0) {
            return 0.0
        }
        if (v > 1.0) {
            return 1.0
        }
        return v
    }
}
