; ============================================================================
; PresToolbar.rgr — the app's top bar, in EVGUI controls on the canvas
; ============================================================================
;
; The bar the page used to draw in HTML — the presentation and the theme to
; pick, play and present, open / save / PDF / PPTX / share / help, the status
; — as gallery/ui controls (SelectCtl, ButtonCtl) in a UiHost of its own, as
; big as the app, so a select's list opens over everything under it.
;
; The bar does not DO anything itself. A press is a request the page acts on
; the way it always has: a button is "click:<id>" (the page clicks the button
; of that id, kept but hidden), a choice is "select:<id>:<value>" (the page
; sets that select and says it changed). So opening a file, a download or a
; share keeps its user gesture, and the page's own logic stays where it is.
;
; What the selects offer comes from the page too: `setOptions(id, rows)`,
; one "value<TAB>label<TAB>group" row per line.
; ============================================================================

Import "../ui/src/UiHost.rgr"
Import "PresI18n.rgr"

class PresToolbar {
    def host:UiHost (new UiHost())
    def css:string ""
    ; the name at the start of the bar: the page's own (PresApp.setAppName)
    def brand:string "EVG Presentation"
    ; the page's own buttons after Ohje: "id<TAB>label<TAB>variant" rows
    ; (PresApp.setToolbarExtras); a press asks the page to click #id
    def extras:string ""
    def w:double 1200.0
    def h:double 700.0
    def barH:double 48.0
    def sample:SelectCtl (new SelectCtl())
    def theme:SelectCtl (new SelectCtl())
    ; the interface's language, after the page's own buttons (rows from the page)
    def langSel:SelectCtl (new SelectCtl())
    def langRows:string ""
    def langValue:string ""
    ; File and Help (a wide window), and the drawer the menu button opens
    ; (a narrow one, or a finger)
    def menubar:MenubarCtl (new MenubarCtl())
    def drawer:DrawerCtl (new DrawerCtl())
    def drawerOpen:boolean false
    ; "value<TAB>label<TAB>group" rows, per select
    def sampleRows:string ""
    def themeRows:string ""
    def sampleValue:string ""
    def themeValue:string ""
    def playing:boolean false
    def status:string ""
    def requests:[string]
    def rev:int 0
    def measurer@(optional):TTFTextMeasurer
    ; a finger rather than a mouse: `@media (pointer: coarse)`
    def coarse:boolean false

    Constructor () {
    }

    fn setOptions:void (id:string rows:string current:string) {
        if (id == "sample") {
            sampleRows = rows
            sampleValue = current
        }
        if (id == "theme") {
            themeRows = rows
            themeValue = current
        }
        if (id == "lang") {
            langRows = rows
            langValue = current
        }
        this.rebuild()
    }

    fn setExtras:void (rows:string) {
        if (rows != extras) {
            extras = rows
            this.rebuild()
        }
    }

    fn setState:void (isPlaying:boolean words:string) {
        if ((isPlaying != playing) || (words != status)) {
            playing = isPlaying
            status = words
            this.rebuild()
        }
    }

    ; --- building ---------------------------------------------------------------
    fn text:EVGElement (cls:string words:string) {
        def s (EVGElement.createSpan())
        s.className = cls
        s.textContent = words
        return s
    }

    fn div:EVGElement (cls:string) {
        def d (EVGElement.createDiv())
        d.className = cls
        return d
    }

    fn put:void (c:UiCtl parent:EVGElement) {
        push host.ctls c
        parent.addChild((unwrap c.rootEl))
    }

    fn button:ButtonCtl (id:string name:string variant:string parent:EVGElement) {
        def c (new ButtonCtl())
        c.tid = ("tb-" + id)
        c.name = name
        c.variant = variant
        c.build()
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r ("tb-button tb-b-" + id))
        if (variant == "accent") {
            UiTree.addClass(r "tb-accent")
        }
        ; a row of the drawer: full width, its label at the start
        if ((indexOf id "dr-") == 0) {
            UiTree.addClass(r "tb-drb")
        }
        if (((variant == "primary") || (variant == "accent")) && ((r.getChildCount()) > 0)) {
            UiTree.addClass((r.getChild(0)) "tb-onprimary")
        }
        this.put(c parent)
        return c
    }

    ; A select from its rows: a group starts with a disabled heading.
    fn select:SelectCtl (id:string name:string rows:string current:string parent:EVGElement) {
        def c (new SelectCtl())
        c.tid = ("tb-" + id)
        c.name = name
        def lines:[string] (strsplit rows (strfromcode 10))
        def group:string ""
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def g:string ""
                if ((array_length parts) >= 3) {
                    g = (itemAt parts 2)
                }
                if ((g != group) && ((strlen g) > 0)) {
                    c.addItem(("--" + g) g true)
                }
                group = g
                c.addItem((itemAt parts 0) (itemAt parts 1) false)
            }
            i = (i + 1)
        }
        c.value = current
        c.build()
        def sr:EVGElement (unwrap c.rootEl)
        UiTree.addClass(sr ("tb-select tb-select-" + id))
        ; the trigger has a class of its own, for its width per select
        if ((sr.getChildCount()) > 0) {
            UiTree.addClass((sr.getChild(0)) ("tb-trig-" + id))
        }
        this.put(c parent)
        return c
    }

    ; A narrow window or a finger: the bar keeps the menu button, the name,
    ; Present and the page's own buttons; the rest is in the drawer.
    fn compact:boolean () {
        return ((w < 980.0) || coarse)
    }

    ; What a menu's or the drawer's row asks of the page: a sample
    ; ("s-<key>") and a theme ("t-<key>") are the page's selects changed,
    ; "css" opens the theme's CSS tab, "new" a new deck, the rest the page's
    ; button of that id.
    sfn requestFor:string (id:string) {
        if (id == "new") {
            return "files:new"
        }
        if (id == "css") {
            return "showtab:css"
        }
        if (id == "openbox") {
            return "openbox"
        }
        if ((indexOf id "s-") == 0) {
            return ("select:sample:" + (substring id 2 (strlen id)))
        }
        if ((indexOf id "t-") == 0) {
            return ("select:theme:" + (substring id 2 (strlen id)))
        }
        return ("click:" + id)
    }

    ; A select's rows as menu rows: a group's name a heading (disabled), the
    ; current one ticked.
    fn menuRows:void (mb:MenubarCtl menu:string prefix:string rows:string current:string heading:string) {
        if ((strlen heading) > 0) {
            mb.addItem(menu ("h-" + prefix) heading true)
        }
        def lines:[string] (strsplit rows (strfromcode 10))
        def group:string ""
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def g:string ""
                if ((array_length parts) >= 3) {
                    g = (itemAt parts 2)
                }
                if ((g != group) && ((strlen g) > 0)) {
                    mb.addItem(menu ((("h-" + prefix) + "-") + g) g true)
                }
                group = g
                def v:string (itemAt parts 0)
                def mark:string "    "
                if (v == current) {
                    mark = "✓  "
                }
                mb.addItem(menu (prefix + v) (mark + (itemAt parts 1)) false)
            }
            i = (i + 1)
        }
    }

    ; A select's rows as the drawer's rows, the current one ticked.
    fn drawerRows:void (body:EVGElement prefix:string rows:string current:string) {
        def lines:[string] (strsplit rows (strfromcode 10))
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def v:string (itemAt parts 0)
                def mark:string "    "
                if (v == current) {
                    mark = "✓  "
                }
                this.button((("dr-" + prefix) + v) (mark + (itemAt parts 1)) "ghost" body)
            }
            i = (i + 1)
        }
    }

    ; The page's own buttons (PresApp.setToolbarExtras), in order.
    fn extraButtons:void (parent:EVGElement) {
        def rows:[string] (strsplit extras (strfromcode 10))
        def k:int 0
        while (k < (array_length rows)) {
            def parts:[string] (strsplit (itemAt rows k) (strfromcode 9))
            if ((array_length parts) >= 3) {
                this.button((itemAt parts 0) (itemAt parts 1) (itemAt parts 2) parent)
            }
            k = (k + 1)
        }
    }

    fn rebuild:void () {
        def keepSample:boolean sample.open
        def keepTheme:boolean theme.open
        def keepLang:boolean langSel.open
        def keepMenu:string menubar.openValue
        def fresh (new UiHost())
        host = fresh
        host.addStyleSheet(css)
        host.setTheme("tb")
        host.setPageSize(w h)
        def root:EVGElement (unwrap host.root)
        root.className = "ui-root tb-page"
        def bar:EVGElement (this.div("tb-bar"))
        def play:string (PresI18n.t("▶ Play"))
        if playing {
            play = (PresI18n.t("⏸ Pause"))
        }
        def small:boolean (this.compact())
        if small {
            this.button("menu" "☰" "ghost" bar)
            bar.addChild((this.text("tb-brand" brand)))
            bar.addChild((this.div("tb-grow")))
            this.button("present" (PresI18n.t("⛶ Present")) "primary" bar)
            this.extraButtons(bar)
        } {
            bar.addChild((this.text("tb-brand" brand)))
            def mb (new MenubarCtl())
            mb.tid = "tb-mb"
            mb.addMenu("file" (PresI18n.t("File")))
            mb.addItem("file" "new" (PresI18n.t("New presentation")) false)
            mb.addItem("file" "openbox" (PresI18n.t("Open…")) false)
            mb.addItem("file" "save" (PresI18n.t("Save .md")) false)
            mb.addMenu("slide" (PresI18n.t("Slide")))
            this.menuRows(mb "slide" "t-" themeRows themeValue (PresI18n.t("Theme")))
            mb.addItem("slide" "css" (PresI18n.t("Edit theme CSS…")) false)
            mb.addMenu("export" (PresI18n.t("Export")))
            mb.addItem("export" "pdf" (PresI18n.t("PDF")) false)
            mb.addItem("export" "pptx" (PresI18n.t("PowerPoint (PPTX)")) false)
            mb.addMenu("help" (PresI18n.t("Help")))
            mb.addItem("help" "helpBtn" (PresI18n.t("Help for this slide")) false)
            mb.openValue = keepMenu
            mb.build()
            menubar = mb
            this.put(mb bar)
            bar.addChild((this.div("tb-sep")))
            this.button("play" play "outline" bar)
            this.button("present" (PresI18n.t("⛶ Present")) "primary" bar)
            this.button("share" (PresI18n.t("Share")) "secondary" bar)
            bar.addChild((this.div("tb-grow")))
            bar.addChild((this.text("tb-status" status)))
            this.extraButtons(bar)
            if ((strlen langRows) > 0) {
                langSel = (this.select("lang" (PresI18n.t("Language")) langRows langValue bar))
            }
        }
        root.addChild(bar)

        ; the drawer: everything the narrow bar leaves out, as a list
        def dr (new DrawerCtl())
        dr.tid = "tb-drawer"
        dr.side = "left"
        dr.title = brand
        dr.closeLabel = (PresI18n.t("Close"))
        def dw:double 300.0
        if (dw > (w - 24.0)) {
            dw = (w - 24.0)
        }
        dr.width = dw
        dr.top = barH
        dr.panelHeight = (h - barH)
        dr.durationMs = 0.0
        def showDrawer:boolean (drawerOpen && small)
        if showDrawer {
            dr.open = true
            dr.progress = 1.0
        }
        dr.build()
        drawer = dr
        push host.ctls dr
        root.addChild((unwrap dr.rootEl))
        if showDrawer {
            def body:EVGElement (dr.body())
            this.button("dr-play" play "ghost" body)
            this.button("dr-share" (PresI18n.t("Share")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("File")))))
            this.button("dr-new" (PresI18n.t("New presentation")) "ghost" body)
            this.button("dr-openbox" (PresI18n.t("Open…")) "ghost" body)
            this.button("dr-save" (PresI18n.t("Save .md")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Slide")))))
            this.drawerRows(body "t-" themeRows themeValue)
            this.button("dr-css" (PresI18n.t("Edit theme CSS…")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Export")))))
            this.button("dr-pdf" (PresI18n.t("PDF")) "ghost" body)
            this.button("dr-pptx" (PresI18n.t("PowerPoint (PPTX)")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Help")))))
            this.button("dr-helpBtn" (PresI18n.t("Help for this slide")) "ghost" body)
            if ((strlen langRows) > 0) {
                body.addChild((this.text("tb-dr-label" (PresI18n.t("Language")))))
                langSel = (this.select("lang" (PresI18n.t("Language")) langRows langValue body))
            }
        }
        if keepSample {
            sample.openList()
            sample.build()
        }
        if keepTheme {
            theme.openList()
            theme.build()
        }
        if keepLang {
            langSel.openList()
            langSel.build()
        }
        rev = (rev + 1)
    }

    ; --- drawing ------------------------------------------------------------------
    fn page:EVGElement () {
        def r:EVGElement (unwrap host.root)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h coarse)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        lay.layout(pg)
        host.lastPage = pg
        return pg
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.page())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; --- the pointer --------------------------------------------------------------
    fn listOpen:boolean () {
        return (((sample.open || theme.open) || langSel.open) || (((strlen menubar.openValue) > 0) || drawerOpen))
    }

    ; The bar, or anywhere while a list is open (a press outside closes it).
    fn has:boolean (px:double py:double) {
        return ((py < barH) || (this.listOpen()))
    }

    fn press:void (px:double py:double) {
        if (null? host.lastPage) {
            this.page()
        }
        def tid:string (host.hitTest(px py))
        def ctlTid:string ""
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            ctlTid = owner.tid
        }
        def isSel:boolean (((strlen ctlTid) > 0) && (((ctlTid == sample.tid) || (ctlTid == theme.tid)) || (ctlTid == langSel.tid)))
        def isMenu:boolean (ctlTid == "tb-mb")
        def inDrawer:boolean ((ctlTid == "tb-drawer") || ((indexOf ctlTid "tb-dr-") == 0))
        ; the menu button opens and closes the drawer
        if (ctlTid == "tb-menu") {
            drawerOpen = (drawerOpen == false)
            this.closeSelects()
            this.rebuild()
            return
        }
        ; an open drawer: a press outside it closes it and does nothing else
        if (drawerOpen && ((inDrawer || isSel) == false)) {
            this.closeLists()
            return
        }
        ; a press outside an open list or menu closes it and does nothing else
        def selOpen:boolean ((sample.open || theme.open) || langSel.open)
        def menuOpen:boolean ((strlen menubar.openValue) > 0)
        if ((selOpen && (isSel == false)) || (menuOpen && (isMenu == false))) {
            this.closeSelects()
            if menuOpen {
                menubar.closeMenu()
            }
            rev = (rev + 1)
            return
        }
        if isMenu {
            ; the row chosen, read before the click closes the menu
            def item:string (menubar.itemOf(tid))
            host.click(tid)
            if ((strlen item) > 0) {
                push requests (PresToolbar.requestFor(item))
            }
            rev = (rev + 1)
            return
        }
        if (ctlTid == "tb-drawer") {
            host.click(tid)
            if (drawer.open == false) {
                drawerOpen = false
                this.rebuild()
            }
            return
        }
        if ((indexOf ctlTid "tb-dr-") == 0) {
            push requests (PresToolbar.requestFor((substring ctlTid 6 (strlen ctlTid))))
            drawerOpen = false
            this.rebuild()
            return
        }
        if isSel {
            def sel:SelectCtl sample
            if (ctlTid == theme.tid) {
                sel = theme
            }
            if (ctlTid == langSel.tid) {
                sel = langSel
            }
            ; another open list closes
            if (sample.open && (sel.tid != sample.tid)) {
                sample.closeList()
                sample.build()
            }
            if (theme.open && (sel.tid != theme.tid)) {
                theme.closeList()
                theme.build()
            }
            if (langSel.open && (sel.tid != langSel.tid)) {
                langSel.closeList()
                langSel.build()
            }
            def before:string sel.value
            host.click(tid)
            sel.build()
            if ((sel.value != before) && ((indexOf sel.value "--") != 0)) {
                def id:string (substring sel.tid 3 (strlen sel.tid))
                push requests ("select:" + id + ":" + sel.value)
                if (id == "sample") {
                    sampleValue = sel.value
                }
                if (id == "theme") {
                    themeValue = sel.value
                }
                if (id == "lang") {
                    langValue = sel.value
                }
            }
            rev = (rev + 1)
            return
        }
        if ((indexOf ctlTid "tb-") == 0) {
            push requests ("click:" + (substring ctlTid 3 (strlen ctlTid)))
        }
    }

    fn closeLists:void () {
        this.closeSelects()
        if ((strlen menubar.openValue) > 0) {
            menubar.closeMenu()
        }
        if drawerOpen {
            drawerOpen = false
            this.rebuild()
        }
        rev = (rev + 1)
    }

    fn closeSelects:void () {
        if sample.open {
            sample.closeList()
            sample.build()
        }
        if theme.open {
            theme.closeList()
            theme.build()
        }
        if langSel.open {
            langSel.closeList()
            langSel.build()
        }
        rev = (rev + 1)
    }

    ; The pointer over the bar or an open list: what it is over lights up.
    fn hoverAt:void (px:double py:double) {
        if (null? host.lastPage) {
            return
        }
        def tid:string ""
        if (this.has(px py)) {
            tid = (host.hitTest(px py))
        }
        if (tid != host.hoverTid) {
            if ((strlen tid) > 0) {
                host.hover(tid)
            } {
                host.unhover()
            }
            rev = (rev + 1)
        }
    }

    fn cursorAt:string (px:double py:double) {
        if (null? host.lastPage) {
            return ""
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return "default"
        }
        return "pointer"
    }
}
