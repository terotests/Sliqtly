; ============================================================================
; PresToolbar.rgr — the app's top bar, in EVGUI controls on the canvas
; ============================================================================
;
; The bar the page used to draw in HTML — the presentation and the theme to
; pick, play and present, open / save / PDF / PPTX / share / help, the status
; — as EVGUI controls (SelectCtl, ButtonCtl) in a UiHost of its own, as
; big as the app, so a select's list opens over everything under it.
;
; The bar does not DO anything itself. A press is a request the page acts on
; the way it always has: a button is "click:<id>" (the page clicks the button
; of that id, kept but hidden), a choice is "select:<id>:<value>" (the page
; sets that select and says it changed). So opening a file, a download or a
; share keeps its user gesture, and the page's own logic stays where it is.
;
; What the selects offer comes from the page too: `setOptions(id, rows)`,
; one "value<TAB>label<TAB>group" row per line.
; ============================================================================

Import "../evgui/src/UiHost.rgr"
Import "PresI18n.rgr"

class PresToolbar {
    def host:UiHost (new UiHost())
    def css:string ""
    ; the name at the start of the bar: the page's own (PresApp.setAppName)
    def brand:string "EVG Presentation"
    ; the page's own buttons after Ohje: "id<TAB>label<TAB>variant" rows
    ; (PresApp.setToolbarExtras); a press asks the page to click #id
    def extras:string ""
    def w:double 1200.0
    def h:double 700.0
    def barH:double 48.0
    def sample:SelectCtl (new SelectCtl())
    def theme:SelectCtl (new SelectCtl())
    ; the interface's language, after the page's own buttons (rows from the page)
    def langSel:SelectCtl (new SelectCtl())
    def langRows:string ""
    def langValue:string ""
    ; File and Help (a wide window), and the drawer the menu button opens
    ; (a narrow one, or a finger)
    ; File, Slide, Export and Help: dropdown menus (MenuCtl, which has
    ; submenus: Slide → Theme → the themes)
    def menus:[MenuCtl]
    def drawer:DrawerCtl (new DrawerCtl())
    def drawerOpen:boolean false
    ; the drawer's Theme row opened: the themes listed under it
    def drawerThemes:boolean false
    ; "value<TAB>label<TAB>group" rows, per select
    def sampleRows:string ""
    def themeRows:string ""
    def sampleValue:string ""
    def themeValue:string ""
    ; File → Recent: "<deck id>\t<name>" a line, the latest first
    def recentRows:string ""
    def playing:boolean false
    def status:string ""
    def requests:[string]
    def rev:int 0
    def measurer@(optional):TTFTextMeasurer
    ; a finger rather than a mouse: `@media (pointer: coarse)`
    def coarse:boolean false
    ; a Mac: the menus' keys read ⌘ rather than Ctrl
    def mac:boolean false
    ; the deck is taller than wide: Slide → Orientation ticks Portrait
    def portrait:boolean false

    Constructor () {
    }

    fn setOptions:void (id:string rows:string current:string) {
        if (id == "sample") {
            sampleRows = rows
            sampleValue = current
        }
        if (id == "theme") {
            themeRows = rows
            themeValue = current
        }
        if (id == "recent") {
            recentRows = rows
        }
        if (id == "lang") {
            langRows = rows
            langValue = current
        }
        this.rebuild()
    }

    fn setExtras:void (rows:string) {
        if (rows != extras) {
            extras = rows
            this.rebuild()
        }
    }

    fn setState:void (isPlaying:boolean words:string) {
        if ((isPlaying != playing) || (words != status)) {
            playing = isPlaying
            status = words
            this.rebuild()
        }
    }

    ; --- building ---------------------------------------------------------------
    fn text:EVGElement (cls:string words:string) {
        def s (EVGElement.createSpan())
        s.className = cls
        s.textContent = words
        return s
    }

    fn div:EVGElement (cls:string) {
        def d (EVGElement.createDiv())
        d.className = cls
        return d
    }

    fn put:void (c:UiCtl parent:EVGElement) {
        push host.ctls c
        parent.addChild((unwrap c.rootEl))
    }

    fn button:ButtonCtl (id:string name:string variant:string parent:EVGElement) {
        def c (new ButtonCtl())
        c.tid = ("tb-" + id)
        c.name = name
        c.variant = variant
        c.build()
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r ("tb-button tb-b-" + id))
        if (variant == "accent") {
            UiTree.addClass(r "tb-accent")
        }
        ; a row of the drawer: full width, its label at the start
        if ((indexOf id "dr-") == 0) {
            UiTree.addClass(r "tb-drb")
        }
        if (((variant == "primary") || (variant == "accent")) && ((r.getChildCount()) > 0)) {
            UiTree.addClass((r.getChild(0)) "tb-onprimary")
        }
        this.put(c parent)
        return c
    }

    ; A select from its rows: a group starts with a disabled heading.
    fn select:SelectCtl (id:string name:string rows:string current:string parent:EVGElement) {
        def c (new SelectCtl())
        c.tid = ("tb-" + id)
        c.name = name
        def lines:[string] (strsplit rows (strfromcode 10))
        def group:string ""
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def g:string ""
                if ((array_length parts) >= 3) {
                    g = (itemAt parts 2)
                }
                if ((g != group) && ((strlen g) > 0)) {
                    c.addItem(("--" + g) g true)
                }
                group = g
                c.addItem((itemAt parts 0) (itemAt parts 1) false)
            }
            i = (i + 1)
        }
        c.value = current
        c.build()
        def sr:EVGElement (unwrap c.rootEl)
        UiTree.addClass(sr ("tb-select tb-select-" + id))
        ; the trigger has a class of its own, for its width per select
        if ((sr.getChildCount()) > 0) {
            UiTree.addClass((sr.getChild(0)) ("tb-trig-" + id))
        }
        this.put(c parent)
        return c
    }

    ; A narrow window or a finger: the bar keeps the menu button, the name,
    ; Present and the page's own buttons; the rest is in the drawer.
    fn compact:boolean () {
        return ((w < 980.0) || coarse)
    }

    ; What a menu's or the drawer's row asks of the page: a sample
    ; ("s-<key>") and a theme ("t-<key>") are the page's selects changed,
    ; "css" opens the theme's CSS tab, "new" a new deck, "duplicate" a copy
    ; of this one, the rest the page's button of that id.
    sfn requestFor:string (id:string) {
        if (id == "new") {
            return "files:new"
        }
        if (id == "duplicate") {
            return "files:duplicate"
        }
        if (id == "css") {
            return "showtab:css"
        }
        if (id == "slideNew") {
            return "slide:new"
        }
        if (id == "slideDuplicate") {
            return "slide:duplicate"
        }
        if (id == "slideDelete") {
            return "slide:delete"
        }
        if ((indexOf id "o-") == 0) {
            return ("slide:" + (substring id 2 (strlen id)))
        }
        if (id == "openbox") {
            return "openbox"
        }
        if (id == "browse") {
            return "showtab:files"
        }
        if ((indexOf id "r-") == 0) {
            return ("files:doc:" + (substring id 2 (strlen id)))
        }
        if ((indexOf id "s-") == 0) {
            return ("select:sample:" + (substring id 2 (strlen id)))
        }
        if ((indexOf id "t-") == 0) {
            return ("select:theme:" + (substring id 2 (strlen id)))
        }
        return ("click:" + id)
    }

    ; A menu of the bar: a trigger with the menu's name, rows added after.
    fn dropdown:MenuCtl (id:string name:string) {
        def m (new MenuCtl())
        m.tid = ("tb-m-" + id)
        m.name = name
        push menus m
        return m
    }

    ; A select's rows as a submenu's rows: a group's name a heading
    ; (disabled), the current one ticked.
    fn subRows:void (parent:UiItem prefix:string rows:string current:string) {
        def lines:[string] (strsplit rows (strfromcode 10))
        def group:string ""
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def g:string ""
                if ((array_length parts) >= 3) {
                    g = (itemAt parts 2)
                }
                if ((g != group) && ((strlen g) > 0)) {
                    MenuCtl.addKid(parent ((("h-" + prefix) + "-") + g) g true)
                }
                group = g
                def v:string (itemAt parts 0)
                def mark:string "    "
                if (v == current) {
                    mark = "✓  "
                }
                MenuCtl.addKid(parent (prefix + v) (mark + (itemAt parts 1)) false)
            }
            i = (i + 1)
        }
    }

    ; A chord with the platform's command key: ⌘ on a Mac, Ctrl elsewhere,
    ; in aria-keyshortcuts form ("Meta+D", "Control+D").
    fn modKey:string (key:string) {
        if mac {
            return ("Meta+" + key)
        }
        return ("Control+" + key)
    }

    ; Orientation's two rows, the deck's one ticked.
    fn orientationKids:void (parent:UiItem) {
        def lm:string "✓  "
        def pm:string "    "
        if portrait {
            lm = "    "
            pm = "✓  "
        }
        MenuCtl.addKid(parent "o-landscape" (lm + (PresI18n.t("Landscape"))) false)
        MenuCtl.addKid(parent "o-portrait" (pm + (PresI18n.t("Portrait"))) false)
    }

    ; Recent's rows: every deck first (the Files tab), then the latest ones.
    fn recentKids:void (parent:UiItem) {
        MenuCtl.addKid(parent "browse" (PresI18n.t("Browse all…")) false)
        def lines:[string] (strsplit recentRows (strfromcode 10))
        def first:boolean true
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                if first {
                    MenuCtl.addKidSeparator(parent)
                    first = false
                }
                MenuCtl.addKid(parent ("r-" + (itemAt parts 0)) (itemAt parts 1) false)
            }
            i = (i + 1)
        }
    }

    ; The open menu, if any.
    fn openMenu:string () {
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if m.open {
                return m.tid
            }
            i = (i + 1)
        }
        return ""
    }

    ; The clock, for a submenu the pointer rests on: it opens once MenuCtl's
    ; delay has passed, as a browser's menu does. Only while one is waiting.
    fn tick:void (dtMs:double) {
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if ((strlen m.pendingTid) > 0) {
                host.tick(dtMs)
                if ((strlen m.pendingTid) == 0) {
                    rev = (rev + 1)
                }
                return
            }
            i = (i + 1)
        }
    }

    fn closeMenus:void () {
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if m.open {
                m.closeMenu()
            }
            i = (i + 1)
        }
    }

    ; A select's rows as the drawer's rows, the current one ticked.
    fn drawerRows:void (body:EVGElement prefix:string rows:string current:string) {
        def lines:[string] (strsplit rows (strfromcode 10))
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def v:string (itemAt parts 0)
                def mark:string "    "
                if (v == current) {
                    mark = "✓  "
                }
                def rb:ButtonCtl (this.button((("dr-" + prefix) + v) (mark + (itemAt parts 1)) "ghost" body))
                UiTree.addClass((unwrap rb.rootEl) "tb-drsub")
            }
            i = (i + 1)
        }
    }

    ; The page's own buttons (PresApp.setToolbarExtras), in order.
    fn extraButtons:void (parent:EVGElement) {
        def rows:[string] (strsplit extras (strfromcode 10))
        def k:int 0
        while (k < (array_length rows)) {
            def parts:[string] (strsplit (itemAt rows k) (strfromcode 9))
            if ((array_length parts) >= 3) {
                this.button((itemAt parts 0) (itemAt parts 1) (itemAt parts 2) parent)
            }
            k = (k + 1)
        }
    }

    fn rebuild:void () {
        def keepSample:boolean sample.open
        def keepTheme:boolean theme.open
        def keepLang:boolean langSel.open
        ; the menu open, and its open submenus, carried over the rebuild
        def keepMenu:string ""
        def keepPath:[string]
        def mi:int 0
        while (mi < (array_length menus)) {
            def om:MenuCtl (itemAt menus mi)
            if om.open {
                keepMenu = om.tid
                keepPath = om.openPath
            }
            mi = (mi + 1)
        }
        def noMenus:[MenuCtl]
        menus = noMenus
        def fresh (new UiHost())
        host = fresh
        host.addStyleSheet(css)
        host.setTheme("tb")
        host.setPageSize(w h)
        def root:EVGElement (unwrap host.root)
        root.className = "ui-root tb-page"
        def bar:EVGElement (this.div("tb-bar"))
        def play:string (PresI18n.t("▶ Play"))
        if playing {
            play = (PresI18n.t("⏸ Pause"))
        }
        def small:boolean (this.compact())
        if small {
            this.button("menu" "☰" "ghost" bar)
            bar.addChild((this.text("tb-brand" brand)))
            bar.addChild((this.div("tb-grow")))
            this.button("present" (PresI18n.t("⛶ Present")) "primary" bar)
            this.extraButtons(bar)
        } {
            bar.addChild((this.text("tb-brand" brand)))
            def file:MenuCtl (this.dropdown("file" (PresI18n.t("File"))))
            ; groups as in a desktop app: new | open | save | the assistants
            file.addItem("new" (PresI18n.t("New presentation")) false)
            file.addItem("duplicate" (PresI18n.t("Duplicate")) false)
            file.addSeparator()
            file.addItem("openbox" (PresI18n.t("Open…")) false)
            def rc:UiItem (file.addSub("recent" (PresI18n.t("Recent")) false))
            this.recentKids(rc)
            file.addSeparator()
            file.addItem("save" (PresI18n.t("Save .md")) false)
            file.addSeparator()
            file.addItem("aiClaude" (PresI18n.t("Edit in Claude…")) false)
            file.addItem("aiChatgpt" (PresI18n.t("Edit in ChatGPT…")) false)
            file.setShortcut("openbox" (this.modKey("O")))
            file.setShortcut("save" (this.modKey("S")))
            def slide:MenuCtl (this.dropdown("slide" (PresI18n.t("Slide"))))
            slide.addItem("slideNew" (PresI18n.t("New slide")) false)
            slide.addItem("slideDuplicate" (PresI18n.t("Duplicate slide")) false)
            slide.addItem("slideDelete" (PresI18n.t("Delete slide")) false)
            slide.setShortcut("slideNew" "Control+M")
            slide.setShortcut("slideDuplicate" (this.modKey("D")))
            slide.addSeparator()
            def ori:UiItem (slide.addSub("orientation" (PresI18n.t("Orientation")) false))
            this.orientationKids(ori)
            slide.addSeparator()
            def th:UiItem (slide.addSub("theme" (PresI18n.t("Theme")) false))
            this.subRows(th "t-" themeRows themeValue)
            slide.addSeparator()
            slide.addItem("css" (PresI18n.t("Edit theme CSS…")) false)
            def ex:MenuCtl (this.dropdown("export" (PresI18n.t("Export"))))
            ex.addItem("pdf" (PresI18n.t("PDF")) false)
            ex.addItem("pptx" (PresI18n.t("PowerPoint (PPTX)")) false)
            def hp:MenuCtl (this.dropdown("help" (PresI18n.t("Help"))))
            hp.addItem("helpBtn" (PresI18n.t("Help for this slide")) false)

            def k:int 0
            while (k < (array_length menus)) {
                def m:MenuCtl (itemAt menus k)
                if (m.tid == keepMenu) {
                    m.open = true
                    m.openPath = keepPath
                }
                m.build()
                this.put(m bar)
                k = (k + 1)
            }
            bar.addChild((this.div("tb-sep")))
            this.button("play" play "outline" bar)
            this.button("present" (PresI18n.t("⛶ Present")) "primary" bar)
            this.button("share" (PresI18n.t("Share")) "secondary" bar)
            bar.addChild((this.div("tb-grow")))
            bar.addChild((this.text("tb-status" status)))
            this.extraButtons(bar)
            if ((strlen langRows) > 0) {
                langSel = (this.select("lang" (PresI18n.t("Language")) langRows langValue bar))
            }
        }
        root.addChild(bar)

        ; the drawer: everything the narrow bar leaves out, as a list
        def dr (new DrawerCtl())
        dr.tid = "tb-drawer"
        dr.side = "left"
        dr.title = brand
        dr.closeLabel = (PresI18n.t("Close"))
        def dw:double 300.0
        if (dw > (w - 24.0)) {
            dw = (w - 24.0)
        }
        dr.width = dw
        dr.top = barH
        dr.panelHeight = (h - barH)
        dr.durationMs = 0.0
        def showDrawer:boolean (drawerOpen && small)
        if showDrawer {
            dr.open = true
            dr.progress = 1.0
        }
        dr.build()
        drawer = dr
        push host.ctls dr
        root.addChild((unwrap dr.rootEl))
        if showDrawer {
            def body:EVGElement (dr.body())
            this.button("dr-play" play "ghost" body)
            this.button("dr-share" (PresI18n.t("Share")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("File")))))
            this.button("dr-new" (PresI18n.t("New presentation")) "ghost" body)
            this.button("dr-duplicate" (PresI18n.t("Duplicate")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-openbox" (PresI18n.t("Open…")) "ghost" body)
            this.button("dr-browse" (PresI18n.t("Browse all…")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-save" (PresI18n.t("Save .md")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-aiClaude" (PresI18n.t("Edit in Claude…")) "ghost" body)
            this.button("dr-aiChatgpt" (PresI18n.t("Edit in ChatGPT…")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            def arrow:string "▸  "
            if drawerThemes {
                arrow = "▾  "
            }
            this.button("dr-slideNew" (PresI18n.t("New slide")) "ghost" body)
            this.button("dr-slideDuplicate" (PresI18n.t("Duplicate slide")) "ghost" body)
            this.button("dr-slideDelete" (PresI18n.t("Delete slide")) "ghost" body)
            def otherWay:string "o-portrait"
            def otherName:string (PresI18n.t("Portrait"))
            if portrait {
                otherWay = "o-landscape"
                otherName = (PresI18n.t("Landscape"))
            }
            this.button(("dr-" + otherWay) (((PresI18n.t("Orientation")) + ": ") + otherName) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-themes" (arrow + (PresI18n.t("Theme"))) "ghost" body)
            if drawerThemes {
                this.drawerRows(body "t-" themeRows themeValue)
            }
            this.button("dr-css" (PresI18n.t("Edit theme CSS…")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Export")))))
            this.button("dr-pdf" (PresI18n.t("PDF")) "ghost" body)
            this.button("dr-pptx" (PresI18n.t("PowerPoint (PPTX)")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Help")))))
            this.button("dr-helpBtn" (PresI18n.t("Help for this slide")) "ghost" body)
            if ((strlen langRows) > 0) {
                body.addChild((this.text("tb-dr-label" (PresI18n.t("Language")))))
                langSel = (this.select("lang" (PresI18n.t("Language")) langRows langValue body))
            }
        }
        if keepSample {
            sample.openList()
            sample.build()
        }
        if keepTheme {
            theme.openList()
            theme.build()
        }
        if keepLang {
            langSel.openList()
            langSel.build()
        }
        rev = (rev + 1)
    }

    ; --- the assistants' marks ------------------------------------------------------
    ; Claude's and ChatGPT's marks before "Edit in Claude…" / "Edit in
    ; ChatGPT…", in the File menu and in the drawer. MenuCtl draws a row as
    ; its text alone and builds its rows again whenever the menu changes, so
    ; the marks are put in on each drawing: the row's text becomes a mark and
    ; a label beside it, as MenuCtl's own sub-trigger rows are.
    ; Paths: Simple Icons (CC0) for Claude, Lobe Icons (MIT) for OpenAI.
    sfn markFor:string (id:string) {
        if ((id == "tb-m-file-item-aiClaude") || (id == "tb-dr-aiClaude")) {
            return "claude"
        }
        if ((id == "tb-m-file-item-aiChatgpt") || (id == "tb-dr-aiChatgpt")) {
            return "openai"
        }
        return ""
    }

    sfn markPath:string (mark:string) {
        if (mark == "claude") {
