; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresToolbar.rgr — the app's top bar, in EVGUI controls on the canvas
; ============================================================================
;
; The bar the page used to draw in HTML — the presentation and the theme to
; pick, play and present, open / save / PDF / PPTX / share / help, the status
; — as EVGUI controls (SelectCtl, ButtonCtl) in a UiHost of its own, as
; big as the app, so a select's list opens over everything under it.
;
; The bar does not DO anything itself. A press is a request the page acts on
; the way it always has: a button is "click:<id>" (the page clicks the button
; of that id, kept but hidden), a choice is "select:<id>:<value>" (the page
; sets that select and says it changed). So opening a file, a download or a
; share keeps its user gesture, and the page's own logic stays where it is.
;
; What the selects offer comes from the page too: `setOptions(id, rows)`,
; one "value<TAB>label<TAB>group" row per line.
; ============================================================================

Import "../evgui/src/UiHost.rgr"
Import "PresI18n.rgr"
Import "../evgui/src/UiText.rgr"
Import "../evgui/src/UiShapes.rgr"

class PresToolbar {
    def host:UiHost (new UiHost())
    def css:string ""
    ; The editor's skin ("" or "retro"): a theme name added to this host's own.
    def skin:string ""
    ; while the bar is built: its buttons stand on the brand's frame
    def onFrame:boolean false
    ; the name at the start of the bar: the page's own (PresApp.setAppName)
    def brand:string "EVG Presentation"
    ; the page's own buttons after Ohje: "id<TAB>label<TAB>variant" rows
    ; (PresApp.setToolbarExtras); a press asks the page to click #id
    def extras:string ""
    ; The bar did not fit at this width with these buttons (`fitKey`): first
    ; the page's buttons take their short labels (`short`), and if it still
    ; does not fit, the bar is the narrow one (`tight`, as under 980 px).
    def short:boolean false
    def tight:boolean false
    def fitKey:string ""
    def barEl@(optional):EVGElement
    def w:double 1200.0
    def h:double 700.0
    def barH:double 48.0
    def sample:SelectCtl (new SelectCtl())
    def theme:SelectCtl (new SelectCtl())
    ; the interface's language, after the page's own buttons (rows from the page)
    def langSel:SelectCtl (new SelectCtl())
    def langRows:string ""
    def langValue:string ""
    ; File and Help (a wide window), and the drawer the menu button opens
    ; (a narrow one, or a finger)
    ; File, Slide, Export and Help: dropdown menus (MenuCtl, which has
    ; submenus: Slide → Orientation)
    def menus:[MenuCtl]
    def drawer:DrawerCtl (new DrawerCtl())
    def drawerOpen:boolean false
    ; "value<TAB>label<TAB>group" rows, per select
    def sampleRows:string ""
    def themeRows:string ""
    def sampleValue:string ""
    def themeValue:string ""
    ; File → Recent: "<deck id>\t<name>" a line, the latest first
    def recentRows:string ""
    def playing:boolean false
    ; the deck has a recording (Record → Play recording), played through
    ; this voice
    def hasRec:boolean false
    def recVoice:string "clean"
    def status:string ""
    def requests:[string]
    def rev:int 0
    def measurer@(optional):TTFTextMeasurer
    ; a finger rather than a mouse: `@media (pointer: coarse)`
    def coarse:boolean false
    ; a Mac: the menus' keys read ⌘ rather than Ctrl
    def mac:boolean false
    ; the deck is taller than wide: Slide → Orientation ticks Portrait
    def portrait:boolean false
    ; slides picked on the strip: Export and the strip's menu offer them
    def picked:int 0
    ; The filmstrip's context menu (PresApp.openSlideMenu): open, where it
    ; was asked for, and which of its rows can act on the slide.
    def ctxOpen:boolean false
    def ctxX:double 0.0
    def ctxY:double 0.0
    def ctxLeft:boolean true
    def ctxRight:boolean true
    def ctxDelete:boolean true
    ; the element picked on the slide the menu is for ("chart", "text", …;
    ; "" none): its Copy row
    def ctxElement:string ""
    ; a presentation of the Rooms panel the context menu is for ("" the
    ; strip's slide menu): the File menu's rows for that deck
    def ctxDeck:string ""
    ; where that presentation's row is: "room" (Rooms) or "tab" (the deck
    ; tabs), its name and whether it is the open deck
    def ctxDeckFrom:string "room"
    def ctxDeckName:string ""
    def ctxDeckCurrent:boolean false
    ; The left rail (a wide window): the places, Slack's way, an icon and a
    ; name each; the bar starts after it. `railValue` is the one open now
    ; (PresApp says: the editor, the Files tab or Rooms).
    def railW:double 72.0
    def rail:RailCtl (new RailCtl())
    def railValue:string "edit"
    def reviewOn:boolean false
    ; Rooms beside the rail (a mock over ADR 0001 until the server has them)
    def roomsOpen:boolean false
    def roomsW:double 248.0
    def roomOpen:string "general"
    ; the server's rooms ("<id>\t<title>\t<presentations>" a line) and the
    ; open room's presentations ("<deck id>\t<name>\t<1 for the open deck>");
    ; none: the panel shows its sketch
    def roomRows:string ""
    def roomDecks:string ""
    ; The document's name at the start of the bar (Google Drive's way);
    ; pressed, it is a field: Enter or a press elsewhere renames, Esc not.
    def docTitle:string ""
    def titleEditing:boolean false
    ; a drag selecting in the name or search field, and the press's click
    ; count and shift (a double click picks a word)
    def titleSelecting:boolean false
    def pressClicks:int 1
    def pressShift:boolean false
    ; what the field is for: "title" the deck's name, "search" the rooms'
    def editFor:string "title"
    ; the editor's look is dark (the rail's switch shows Light then)
    def darkOn:boolean false
    ; the Rooms panel's search row ("Search rooms…", with how many rooms
    ; only search finds), from the page
    def roomSearchLabel:string ""
    ; while searching, the presentations whose words hold the query, from
    ; the page: "id TAB name TAB room TAB text around the first word"
    def roomFound:string ""
    ; a presentation of a room's list pressed: dragged onto another room it
    ; moves there, let go where it was pressed it opens
    def dragDeck:string ""
    def dragName:string ""
    def dragX0:double 0.0
    def dragY0:double 0.0
    def dragX:double 0.0
    def dragY:double 0.0
    def dragOn:boolean false
    def dropRoom:string ""
    ; ...or onto a folder of the open room (its id): the deck is filed there
    def dropFolder:string ""
    ; a made room's row pressed: dragged, it goes before the room it is let
    ; go on (onto a built-in one: first); let go where it was pressed, the
    ; room opens
    def dragRoom:string ""
    ; a deck's tab dragged from the tab row over the rooms (PresApp moves it)
    def dragTab:string ""
    def titleIn:InputCtl (new InputCtl())
    def eng@(optional):EVGTextEngine

    Constructor () {
    }

    fn setOptions:void (id:string rows:string current:string) {
        if (id == "sample") {
            sampleRows = rows
            sampleValue = current
        }
        if (id == "theme") {
            themeRows = rows
            themeValue = current
        }
        if (id == "recent") {
            recentRows = rows
        }
        if (id == "lang") {
            langRows = rows
            langValue = current
        }
        ; the open room changes only with its presentations ("roomdecks", which
        ; the page always sends after the rooms): a room shown open with
        ; another one's list, or none, for a frame flickered
        if (id == "rooms") {
            roomRows = rows
        }
        if (id == "dark") {
            darkOn = (current == "1")
        }
        if (id == "roomsearch") {
            roomSearchLabel = current
        }
        if (id == "roomfound") {
            roomFound = rows
        }
        if (id == "roomdecks") {
            roomDecks = rows
            roomOpen = current
        }
        this.rebuild()
    }

    fn setExtras:void (rows:string) {
        if (rows != extras) {
            extras = rows
            this.rebuild()
        }
    }

    fn setState:void (isPlaying:boolean words:string) {
        if ((isPlaying != playing) || (words != status)) {
            playing = isPlaying
            status = words
            this.rebuild()
        }
    }

    ; --- building ---------------------------------------------------------------
    fn text:EVGElement (cls:string words:string) {
        def s (EVGElement.createSpan())
        s.className = cls
        s.textContent = words
        return s
    }

    fn div:EVGElement (cls:string) {
        def d (EVGElement.createDiv())
        d.className = cls
        return d
    }

    fn put:void (c:UiCtl parent:EVGElement) {
        push host.ctls c
        parent.addChild((unwrap c.rootEl))
    }

    fn button:ButtonCtl (id:string name:string variant:string parent:EVGElement) {
        return (this.iconButton(id name variant "" parent))
    }

    ; A button drawn as an icon alone (a path on a 24 grid, centred by its
    ; box, where a glyph sits wherever its font puts it); `name` is what a
    ; reader is told. "" draws the words.
    fn iconButton:ButtonCtl (id:string name:string variant:string icon:string parent:EVGElement) {
        def c (new ButtonCtl())
        c.tid = ("tb-" + id)
        c.name = name
        c.variant = variant
        c.icon = icon
        c.iconOnly = ((strlen icon) > 0)
        ; sized by its own class: "tb-icon-room-new", every room's gear
        ; and "+" "tb-icon-roomgear"
        c.iconClass = ("tb-icon-" + id)
        if ((indexOf id "roomgear-") == 0) {
            c.iconClass = "tb-icon-roomgear"
        }
        if ((indexOf id "roomadd-") == 0) {
            c.iconClass = "tb-icon-roomgear"
        }
        if ((indexOf id "roomfolder-") == 0) {
            c.iconClass = "tb-icon-roomgear"
        }
        c.build()
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r ("tb-button tb-b-" + id))
        if (variant == "accent") {
            UiTree.addClass(r "tb-accent")
        }
        ; a row of the drawer: full width, its label at the start
        if ((indexOf id "dr-") == 0) {
            UiTree.addClass(r "tb-drb")
        }
        if (((variant == "primary") || (variant == "accent")) && ((r.getChildCount()) > 0)) {
            UiTree.addClass((r.getChild(0)) "tb-onprimary")
        }
        ; on the frame: drawn light on its colour (toolbar.css .tb-fb-*)
        if onFrame {
            UiTree.addClass(r ("tb-fb tb-fb-" + variant))
            if ((r.getChildCount()) > 0) {
                UiTree.addClass((r.getChild(0)) ("tb-fb-label tb-fb-label-" + variant))
            }
        }
        this.put(c parent)
        return c
    }

    ; A select from its rows: a group starts with a disabled heading.
    fn select:SelectCtl (id:string name:string rows:string current:string parent:EVGElement) {
        def c (new SelectCtl())
        c.tid = ("tb-" + id)
        c.name = name
        def lines:[string] (strsplit rows (strfromcode 10))
        def group:string ""
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def g:string ""
                if ((array_length parts) >= 3) {
                    g = (itemAt parts 2)
                }
                if ((g != group) && ((strlen g) > 0)) {
                    c.addItem(("--" + g) g true)
                }
                group = g
                c.addItem((itemAt parts 0) (itemAt parts 1) false)
            }
            i = (i + 1)
        }
        c.value = current
        c.build()
        def sr:EVGElement (unwrap c.rootEl)
        UiTree.addClass(sr ("tb-select tb-select-" + id))
        ; the trigger has a class of its own, for its width per select
        if ((sr.getChildCount()) > 0) {
            UiTree.addClass((sr.getChild(0)) ("tb-trig-" + id))
        }
        this.put(c parent)
        return c
    }

    ; A narrow window or a finger: the bar keeps the menu button, the name,
    ; Present and the page's own buttons; the rest is in the drawer.
    fn compact:boolean () {
        return (((w < 980.0) || coarse) || (tight && (fitKey == (this.fitNow()))))
    }

    ; what the bar's fit depends on
    fn fitNow:string () {
        return (((to_string w) + "|") + extras)
    }

    ; the page's buttons in their short form
    fn shortNow:boolean () {
        return (short && (fitKey == (this.fitNow())))
    }

    ; After a layout: whether the bar's buttons run past its right edge.
    ; Then the short labels, then the narrow bar; each once for this width
    ; and these buttons.
    fn refit:boolean () {
        if ((this.compact()) || (null? barEl)) {
            return false
        }
        def bar:EVGElement (unwrap barEl)
        def right:double 0.0
        def i:int 0
        while (i < (bar.getChildCount())) {
            def c:EVGElement (bar.getChild(i))
            def r:double (c.calculatedX + c.calculatedWidth)
            if (r > right) {
                right = r
            }
            i = (i + 1)
        }
        if (right <= (w + 0.5)) {
            return false
        }
        if (fitKey != (this.fitNow())) {
            fitKey = (this.fitNow())
            short = false
            tight = false
        }
        if (short == false) {
            short = true
        } {
            tight = true
        }
        this.rebuild()
        return true
    }

    ; What a menu's or the drawer's row asks of the page: a sample
    ; ("s-<key>") and a theme ("t-<key>") are the page's selects changed,
    ; "css" opens the theme's CSS tab, "new" a new deck, "duplicate" a copy
    ; of this one, the rest the page's button of that id.
    sfn requestFor:string (id:string) {
        if ((id == "new") || (id == "newPres")) {
            return "files:new"
        }
        if (id == "newSheet") {
            return "files:newsheet"
        }
        if (id == "duplicate") {
            return "files:duplicate"
        }
        if (id == "rename") {
            return "rename"
        }
        if (id == "deleteDeck") {
            return "files:deletedeck"
        }
        ; File → Export's rows: the page's own export buttons
        ; Copy's rows: to the clipboard (the page writes it)
        if ((indexOf id "cp-") == 0) {
            return ("clip:" + (substring id 3 (strlen id)))
        }
        if ((indexOf id "x-") == 0) {
            return ("click:" + (substring id 2 (strlen id)))
        }
        if (id == "css") {
            return "showtab:css"
        }
        ; the theme picker's window (PresChartEditor "themes")
        if (id == "themes") {
            return "themes"
        }
        ; Edit's rows, and the slide menu's Copy and Paste
        if ((indexOf id "ed-") == 0) {
            return ("edit:" + (substring id 3 (strlen id)))
        }
        if (id == "slideNew") {
            return "slide:new"
        }
        if (id == "slideDuplicate") {
            return "slide:duplicate"
        }
        if (id == "slideDelete") {
            return "slide:delete"
        }
        if (id == "slideDraw") {
            return "slide:draw"
        }
        if (id == "slideLeft") {
            return "slide:left"
        }
        if (id == "slideRight") {
            return "slide:right"
        }
        if ((indexOf id "o-") == 0) {
            return ("slide:" + (substring id 2 (strlen id)))
        }
        if (id == "openbox") {
            return "openbox"
        }
        if ((indexOf id "rec-") == 0) {
            return ("rec:" + (substring id 4 (strlen id)))
        }
        if (id == "settings") {
            return "settings"
        }
        if (id == "about") {
            return "about"
        }
        if (id == "helpGuide") {
            return "help-guide"
        }
        if (id == "docset") {
            return "docset"
        }
        if ((id == "browse") || (id == "decks")) {
            return "decks"
        }
        if ((indexOf id "r-") == 0) {
            return ("files:doc:" + (substring id 2 (strlen id)))
        }
        if ((indexOf id "s-") == 0) {
            return ("select:sample:" + (substring id 2 (strlen id)))
        }
        if ((indexOf id "t-") == 0) {
            return ("select:theme:" + (substring id 2 (strlen id)))
        }
        return ("click:" + id)
    }

    ; A menu of the bar: a trigger with the menu's name, rows added after.
    fn dropdown:MenuCtl (id:string name:string) {
        def m (new MenuCtl())
        m.tid = ("tb-m-" + id)
        m.name = name
        push menus m
        return m
    }

    ; A chord with the platform's command key: ⌘ on a Mac, Ctrl elsewhere,
    ; in aria-keyshortcuts form ("Meta+D", "Control+D").
    fn modKey:string (key:string) {
        if mac {
            return ("Meta+" + key)
        }
        return ("Control+" + key)
    }

    ; Record's Voice rows: the host's filters (web/recorder.js), the one in
    ; use ticked.
    fn voiceKids:void (parent:UiItem) {
        ; i18n: "Clean" "Warm" "Radio" "Phone" "Echo" "Robot" "As recorded"
        def ids:[string] ([] _:string ("clean" "warm" "radio" "phone" "echo" "robot" "none"))
        def names:[string] ([] _:string ("Clean" "Warm" "Radio" "Phone" "Echo" "Robot" "As recorded"))
        def i:int 0
        while (i < (array_length ids)) {
            def mark:string "    "
            if ((itemAt ids i) == recVoice) {
                mark = "✓  "
            }
            MenuCtl.addKid(parent ("rec-voice-" + (itemAt ids i)) (mark + (PresI18n.t((itemAt names i)))) false)
            i = (i + 1)
        }
    }

    ; Orientation's two rows, the deck's one ticked.
    fn orientationKids:void (parent:UiItem) {
        def lm:string "✓  "
        def pm:string "    "
        if portrait {
            lm = "    "
            pm = "✓  "
        }
        MenuCtl.addKid(parent "o-landscape" (lm + (PresI18n.t("Landscape"))) false)
        MenuCtl.addKid(parent "o-portrait" (pm + (PresI18n.t("Portrait"))) false)
    }

    ; Export's file formats, as "value<TAB>label" rows ("" a separator): the
    ; Markdown, PowerPoint, Word, a web page, a player that plays the deck
    ; from one file, PDF, a zip of every file, and with slides picked the
    ; picked slides' formats.
    fn exportFormats:[string] () {
        def t:string (strfromcode 9)
        def out:[string]
        push out ("x-save" + t + (PresI18n.t("Markdown (.md)")))
        push out ("x-pptx" + t + (PresI18n.t("PowerPoint (.pptx)")))
        push out ("x-docx" + t + (PresI18n.t("Word (.docx)")))
        push out ("x-html" + t + (PresI18n.t("Web page (.html)")))
        push out ("x-player" + t + (PresI18n.t("Presentation player (.html)")))
        push out ("x-pdf" + t + (PresI18n.t("PDF (.pdf)")))
        push out ("x-zip" + t + (PresI18n.t("All files (.zip)")))
        if (picked > 0) {
            push out ""
            push out ("x-pptxPicked" + t + (this.pickedLabel("PowerPoint (.pptx)")))
            push out ("x-docxPicked" + t + (this.pickedLabel("Word (.docx)")))
            push out ("x-htmlPicked" + t + (this.pickedLabel("Web page (.html)")))
            push out ("x-pdfPicked" + t + (this.pickedLabel("PDF (.pdf)")))
        }
        return out
    }

    ; The file formats as kids of the submenu `parent`.
    fn exportKids:void (parent:UiItem) {
        def rows:[string] (this.exportFormats())
        def i:int 0
        while (i < (array_length rows)) {
            def fr:[string] (strsplit (itemAt rows i) (strfromcode 9))
            if ((array_length fr) < 2) {
                MenuCtl.addKidSeparator(parent)
            }
            if ((array_length fr) >= 2) {
                MenuCtl.addKid(parent (itemAt fr 0) (itemAt fr 1) false)
            }
            i = (i + 1)
        }
    }

    ; The file formats as the root rows of the menu `m`.
    fn exportItems:void (m:MenuCtl) {
        def rows:[string] (this.exportFormats())
        def i:int 0
        while (i < (array_length rows)) {
            def fr:[string] (strsplit (itemAt rows i) (strfromcode 9))
            if ((array_length fr) < 2) {
                m.addSeparator()
            }
            if ((array_length fr) >= 2) {
                m.addItem((itemAt fr 0) (itemAt fr 1) false)
            }
            i = (i + 1)
        }
    }

    ; Copy's rows (to the clipboard): the Markdown, the Markdown with the
    ; open comments as footnotes, the open comments with their slides; with
    ; `forSlide` (the slide's own menu) the selected slide's first, and the
    ; picked slides' when some are.
    fn clipboardKids:void (parent:UiItem forSlide:boolean) {
        if forSlide {
            MenuCtl.addKid(parent "cp-mdSlide" ((PresI18n.t("Markdown")) + " – " + (PresI18n.t("this slide"))) false)
            MenuCtl.addKid(parent "cp-mdcSlide" ((PresI18n.t("Markdown + comments")) + " – " + (PresI18n.t("this slide"))) false)
        }
        if (picked > 0) {
            MenuCtl.addKid(parent "cp-mdPicked" (this.pickedLabel("Markdown")) false)
            MenuCtl.addKid(parent "cp-mdcPicked" (this.pickedLabel("Markdown + comments")) false)
        }
        if (forSlide || (picked > 0)) {
            MenuCtl.addKidSeparator(parent)
        }
        def whole:string ""
        if (forSlide || (picked > 0)) {
            whole = (" – " + (PresI18n.t("whole presentation")))
        }
        MenuCtl.addKid(parent "cp-md" ((PresI18n.t("Markdown")) + whole) false)
        MenuCtl.addKid(parent "cp-mdc" ((PresI18n.t("Markdown + comments")) + whole) false)
        MenuCtl.addKid(parent "cp-comments" (PresI18n.t("Open comments")) false)
    }

    ; Export's rows under the submenu `xs`: the file formats, then
    ; Export to Clipboard ▸.
    fn exportGroups:void (xs:UiItem) {
        this.exportKids(xs)
        MenuCtl.addKidSeparator(xs)
        def clip:UiItem (MenuCtl.addKid(xs "x-clip" (PresI18n.t("Export to Clipboard")) false))
        this.clipboardKids(clip false)
    }

    ; "Copy slide", or "Copy 3 slides" with slides picked
    fn copySlidesLabel:string () {
        if (picked > 1) {
            return (join (strsplit (PresI18n.t("Copy {n} slides")) "{n}") (to_string picked))
        }
        return (PresI18n.t("Copy slide"))
    }

    ; "PDF (.pdf) – 3 selected slides"
    fn pickedLabel:string (format:string) {
        def what:string (PresI18n.t("selected slides"))
        if (picked == 1) {
            what = (PresI18n.t("selected slide"))
        }
        return ((PresI18n.t(format)) + " – " + (to_string picked) + " " + what)
    }

    ; Recent's rows: every deck first (the Files tab), then the latest ones.
    fn recentKids:void (parent:UiItem) {
        MenuCtl.addKid(parent "browse" (PresI18n.t("All presentations…")) false)
        def lines:[string] (strsplit recentRows (strfromcode 10))
        def first:boolean true
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                if first {
                    MenuCtl.addKidSeparator(parent)
                    first = false
                }
                MenuCtl.addKid(parent ("r-" + (itemAt parts 0)) (itemAt parts 1) false)
            }
            i = (i + 1)
        }
    }

    ; The open menu, if any.
    fn openMenu:string () {
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if m.open {
                return m.tid
            }
            i = (i + 1)
        }
        return ""
    }

    ; The clock, for a submenu the pointer rests on: it opens once MenuCtl's
    ; delay has passed, as a browser's menu does. Only while one is waiting.
    fn tick:void (dtMs:double) {
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if ((strlen m.pendingTid) > 0) {
                host.tick(dtMs)
                if ((strlen m.pendingTid) == 0) {
                    rev = (rev + 1)
                }
                return
            }
            i = (i + 1)
        }
    }

    fn closeMenus:void () {
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if m.open {
                m.closeMenu()
            }
            i = (i + 1)
        }
        ctxOpen = false
    }

    ; The filmstrip's context menu at x, y (another open menu or list closes).
    fn openContext:void (x:double y:double canLeft:boolean canRight:boolean canDelete:boolean) {
        this.closeSelects()
        this.closeMenus()
        drawerOpen = false
        ctxX = x
        ctxY = y
        ctxLeft = canLeft
        ctxRight = canRight
        ctxDelete = canDelete
        ctxDeck = ""
        ctxOpen = true
        this.rebuild()
    }

    ; The presentation of the open room under x, y ("" none): its row's id.
    fn roomDeckAt:string (px:double py:double) {
        if (roomsOpen == false) {
            return ""
        }
        if (null? host.lastPage) {
            this.page()
        }
        def maybe@(optional):UiCtl (host.ctlFor((host.hitTest(px py))))
        if (null? maybe) {
            return ""
        }
        def owner:UiCtl (unwrap maybe)
        if ((indexOf owner.tid "tb-roomdeck-d-") == 0) {
            return (substring owner.tid 14 (strlen owner.tid))
        }
        return ""
    }

    ; A presentation's context menu at x, y: the File menu's rows for it.
    ; from: "room" (a row of Rooms, `id` its deck) or "tab" (a deck tab, `id`
    ; its key).
    fn openDeckContext:void (x:double y:double from:string id:string name:string current:boolean) {
        ctxDeckFrom = from
        ctxDeckName = name
        ctxDeckCurrent = current
        this.closeSelects()
        this.closeMenus()
        drawerOpen = false
        dragDeck = ""
        dragOn = false
        ctxX = x
        ctxY = y
        ctxDeck = id
        ctxOpen = true
        this.rebuild()
    }

    ; Is the presentation `id` of the open room's list the open deck?
    fn roomDeckCurrent:boolean (id:string) {
        def ds:[string] (strsplit roomDecks (strfromcode 10))
        def k:int 0
        while (k < (array_length ds)) {
            def dp:[string] (strsplit (itemAt ds k) (strfromcode 9))
            if (((array_length dp) >= 3) && ((itemAt dp 0) == id)) {
                return ((itemAt dp 2) == "1")
            }
            k = (k + 1)
        }
        return false
    }

    ; The File menu's rows that act on the open deck: save and export | the
    ; assistant | settings | delete, red and last. File and a presentation's
    ; context menu in Rooms both have them.
    fn deckRows:void (m:MenuCtl canDelete:boolean) {
        m.addItem("save" (PresI18n.t("Save .md")) false)
        def xs:UiItem (m.addSub("export" (PresI18n.t("Export")) false))
        this.exportGroups(xs)
        m.addSeparator()
        m.addItem("aiClaude" (PresI18n.t("Edit in Claude…")) false)
        m.addSeparator()
        m.addItem("docset" (PresI18n.t("Document settings…")) false)
        if canDelete {
            m.addSeparator()
            m.addItem("deleteDeck" (PresI18n.t("Delete presentation…")) false)
            m.setVariant("deleteDeck" "destructive")
        }
    }

    ; A row of a presentation's context menu, as the page's request: the
    ; File request itself for the open deck, else the deck opened first
    ; ("deckdo:<room|tab>:<id>\t<request>"); Open only opens it.
    fn deckRequest:string (choice:string) {
        ; Move to folder: in the open room, the deck need not be open
        if (choice == "mvf-new") {
            return ("room:newfolder:" + roomOpen + ":" + ctxDeck)
        }
        if (choice == "mvf-top") {
            return ("room:file:" + roomOpen + "::" + ctxDeck)
        }
        if ((indexOf choice "mvf-") == 0) {
            return ("room:file:" + roomOpen + ":" + (substring choice 4 (strlen choice)) + ":" + ctxDeck)
        }
        if (choice == "deckOpen") {
            if (ctxDeckFrom == "tab") {
                return ("deck:switch:" + ctxDeck)
            }
            return ("room:deck:" + ctxDeck)
        }
        def r:string (PresToolbar.requestFor(choice))
        if ctxDeckCurrent {
            return r
        }
        return ((((("deckdo:" + ctxDeckFrom) + ":") + ctxDeck) + (strfromcode 9)) + r)
    }

    ; The context menu as rows: the Slide menu's, with Move left and right.
    ; Its trigger is an empty point where it was asked for, so the menu opens
    ; there (or above it, where the window ends).
    fn contextMenu:void (root:EVGElement keepActive:string) {
        def cm (new MenuCtl())
        cm.tid = "tb-m-ctx"
        cm.name = (PresI18n.t("Slide"))
        cm.contextMode = true
        if ((strlen ctxDeck) > 0) {
            this.deckContextRows(cm)
        } {
            this.slideContextRows(cm)
        }
        cm.openMenu()
        cm.activeTid = keepActive
        cm.build()
        def r:EVGElement (unwrap cm.rootEl)
        r.setAttribute("position" "absolute")
        r.setAttribute("left" ((EVGDisplayList.num(ctxX)) + "px"))
        r.setAttribute("top" ((EVGDisplayList.num(ctxY)) + "px"))
        push menus cm
        this.put(cm root)
    }

    ; A presentation's rows (Rooms, a deck tab): Open (not the open one),
    ; Rename and Duplicate, then the File menu's rows for the deck. A sample
    ; is not deleted.
    fn deckContextRows:void (cm:MenuCtl) {
        cm.name = ctxDeckName
        if (ctxDeckCurrent == false) {
            cm.addItem("deckOpen" (PresI18n.t("Open")) false)
        }
        cm.addItem("rename" (PresI18n.t("Rename…")) false)
        cm.addItem("duplicate" (PresI18n.t("Duplicate")) false)
        ; a presentation of a room (not a sample): into one of its folders
        if ((ctxDeckFrom == "room") && ((indexOf ctxDeck "sample:") != 0)) {
            this.folderKids((cm.addSub("moveFolder" (PresI18n.t("Move to folder")) false)))
        }
        cm.addSeparator()
        this.deckRows(cm ((indexOf ctxDeck "sample:") != 0))
    }

    ; Move to folder's rows: the open room's folders (the one the deck is in
    ; greyed), the room's top when it is in one, and a new folder.
    fn folderKids:void (parent:UiItem) {
        def inFolder:string ""
        def folder:string ""
        def ds:[string] (strsplit roomDecks (strfromcode 10))
        def k:int 0
        while (k < (array_length ds)) {
            def dp:[string] (strsplit (itemAt ds k) (strfromcode 9))
            if ((array_length dp) >= 4) {
                if ((itemAt dp 3) == "f") {
                    folder = (substring (itemAt dp 0) 2 (strlen (itemAt dp 0)))
                }
                if (((itemAt dp 3) == "i") && ((itemAt dp 0) == ctxDeck)) {
                    inFolder = folder
                }
            }
            k = (k + 1)
        }
        def any:boolean false
        k = 0
        while (k < (array_length ds)) {
            def fp:[string] (strsplit (itemAt ds k) (strfromcode 9))
            if (((array_length fp) >= 4) && ((itemAt fp 3) == "f")) {
                def fid:string (substring (itemAt fp 0) 2 (strlen (itemAt fp 0)))
                MenuCtl.addKid(parent ("mvf-" + fid) (itemAt fp 1) (fid == inFolder))
                any = true
            }
            k = (k + 1)
        }
        if ((strlen inFolder) > 0) {
            MenuCtl.addKid(parent "mvf-top" (PresI18n.t("Out of the folder")) false)
        }
        if any {
            MenuCtl.addKidSeparator(parent)
        }
        MenuCtl.addKid(parent "mvf-new" (PresI18n.t("New folder…")) false)
    }

    fn slideContextRows:void (cm:MenuCtl) {
        cm.addItem("slideNew" (PresI18n.t("New slide")) false)
        cm.addItem("slideDuplicate" (PresI18n.t("Duplicate slide")) false)
        cm.addItem("slideDraw" (PresI18n.t("Draw on slide")) false)
        cm.addSeparator()
        cm.addItem("slideLeft" (PresI18n.t("Move left")) (ctxLeft == false))
        cm.addItem("slideRight" (PresI18n.t("Move right")) (ctxRight == false))
        cm.addSeparator()
        cm.addItem("slideDelete" (PresI18n.t("Delete slide")) (ctxDelete == false))
        cm.addSeparator()
        cm.addItem("ed-copySlides" (this.copySlidesLabel()) false)
        if ((strlen ctxElement) > 0) {
            ; i18n: "Copy the chart" "Copy the diagram" "Copy the table" "Copy the picture" "Copy the code" "Copy the list" "Copy the text"
            cm.addItem("ed-copyElement" (PresI18n.t(("Copy the " + ctxElement))) false)
        }
        cm.addItem("ed-paste" (PresI18n.t("Paste")) false)
        cm.addItem("ed-pastePlain" (PresI18n.t("Paste without formatting")) false)
        def cp:UiItem (cm.addSub("ctx-copy" (PresI18n.t("Copy as")) false))
        this.clipboardKids(cp true)
        if (picked > 0) {
            cm.addSeparator()
            cm.addItem("x-pptxPicked" (this.pickedLabel("PowerPoint (.pptx)")) false)
            cm.addItem("x-docxPicked" (this.pickedLabel("Word (.docx)")) false)
            cm.addItem("x-htmlPicked" (this.pickedLabel("Web page (.html)")) false)
            cm.addItem("x-pdfPicked" (this.pickedLabel("PDF (.pdf)")) false)
            cm.addItem("x-share" (PresI18n.t("Share selected slides…")) false)
        }
        cm.setShortcut("slideNew" "Control+M")
        cm.setShortcut("slideDuplicate" (this.modKey("D")))
        cm.setShortcut("slideLeft" (this.modKey("ArrowLeft")))
        cm.setShortcut("slideRight" (this.modKey("ArrowRight")))
        cm.setShortcut("slideDelete" "Delete")
        cm.setShortcut("ed-copySlides" (this.modKey("C")))
        cm.setShortcut("ed-paste" (this.modKey("V")))
        cm.setShortcut("ed-pastePlain" (this.modKey("Shift+V")))
    }

    ; The context menu closed itself (a row chosen, Esc): it is not drawn again.
    fn syncContext:void () {
        if (ctxOpen == false) {
            return
        }
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if ((m.tid == "tb-m-ctx") && m.open) {
                return
            }
            i = (i + 1)
        }
        ctxOpen = false
        rev = (rev + 1)
    }

    ; The page's own buttons (PresApp.setToolbarExtras), in order.
    fn extraButtons:void (parent:EVGElement) {
        def rows:[string] (strsplit extras (strfromcode 10))
        def k:int 0
        while (k < (array_length rows)) {
            def parts:[string] (strsplit (itemAt rows k) (strfromcode 9))
            ; the dark/light switch is the rail's where the rail is drawn
            def onRail:boolean (((itemAt parts 0) == "modeBtn") && (this.railShown()))
            if (((array_length parts) >= 3) && (onRail == false)) {
                def label:string (itemAt parts 1)
                if (((array_length parts) >= 4) && (this.shortNow())) {
                    if ((strlen (itemAt parts 3)) > 0) {
                        label = (itemAt parts 3)
                    }
                }
                this.button((itemAt parts 0) label (itemAt parts 2) parent)
            }
            k = (k + 1)
        }
    }

    ; --- the left rail, Rooms and the document's name ----------------------------
    ; The rail is drawn where the window is wide enough for the menus too; a
    ; narrow one keeps the drawer.
    fn railShown:boolean () {
        return ((this.compact()) == false)
    }

    ; What the rail and Rooms take from the left of the page under the bar.
    fn leftW:double () {
        if ((this.railShown()) == false) {
            return 0.0
        }
        if roomsOpen {
            return (railW + roomsW)
        }
        return railW
    }

    ; The open place, review on or off and the deck's name, from PresApp each
    ; frame: the bar is built again only when one of them changed.
    fn setRailState:void (open:string review:boolean title:string) {
        def v:string open
        if roomsOpen {
            v = "rooms"
        }
        if (((v != railValue) || (review != reviewOn)) || ((title != docTitle) && (titleEditing == false))) {
            railValue = v
            reviewOn = review
            if (titleEditing == false) {
                docTitle = title
            }
            this.rebuild()
        }
    }

    ; The places' icons: strokes on a 24 grid (.ui-rail-icon sets the pen).
    sfn railIcon:string (id:string) {
        if (id == "dark") {
            return "M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"
        }
        if (id == "light") {
            return "M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8zM12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        }
        if (id == "rooms") {
            return "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"
        }
        if (id == "review") {
            return "M4 5h16v11H10l-5 4v-4H4zM8 9h8M8 12h5"
        }
        if (id == "history") {
            return "M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4M12 8v4l3 2"
        }
        if (id == "gear") {
            return "M12 15a3 3 0 1 0 0-6a3 3 0 1 0 0 6zM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3a1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5a1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8a1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1a1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5a1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"
        }
        if (id == "settings") {
            return "M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1M15 4v4M9 10v4M17 16v4"
        }
        return ""
    }

    ; Sliqtly's mark at the top of the rail: the icon's four shapes, filled.
    fn logoEl:EVGElement () {
        def box (EVGElement.createDiv())
        box.id = "tb-logo"
        box.className = "tb-logo"
        def parts:[string] (strsplit "ghost1 ghost2 card play" " ")
        def paths:[string]
        push paths "M21 85.41Q21 75.33 30.87 77.35L69.51 85.28Q79.38 87.3 79.38 97.38L79.38 127.62Q79.38 137.7 69.51 139.72L30.87 147.65Q21 149.67 21 139.59Z"
        push paths "M49 65.41Q49 47.89 66.16 51.41L133.31 65.18Q150.47 68.7 150.47 86.22L150.47 138.78Q150.47 156.3 133.31 159.82L66.16 173.59Q49 177.11 49 159.59Z"
        push paths "M89 48Q89 24 112.51 28.82L204.49 47.68Q228 52.5 228 76.5L228 148.5Q228 172.5 204.49 177.32L112.51 196.18Q89 201 89 177Z"
        push paths "M131 86Q131 73 142.23 79.55L191.77 108.45Q203 115 191.77 121.55L142.23 150.45Q131 157 131 144Z"
        def i:int 0
        while (i < 4) {
            def m (EVGElement.createDiv())
            m.className = ("tb-logo-part tb-logo-" + (itemAt parts i))
            m.tagName = "path"
            m.elementType = 3
            m.viewBox = "12 6 225 225"
            m.svgPath = (itemAt paths i)
            m.a11yHidden = true
            m.setAttribute("position" "absolute")
            m.setAttribute("left" "0px")
            m.setAttribute("top" "0px")
            box.addChild(m)
            i = (i + 1)
        }
        return box
    }

    fn railCtl:RailCtl (tone:string) {
        def r (new RailCtl())
        r.tid = "tb-rail"
        r.tone = tone
        r.name = (PresI18n.t("Places"))
        r.addItem("rooms" (PresI18n.t("Rooms")) (PresToolbar.railIcon("rooms")))
        r.addItem("review" (PresI18n.t("Review")) (PresToolbar.railIcon("review")))
        r.addItem("history" (PresI18n.t("Versions")) (PresToolbar.railIcon("history")))
        ; the editor's dark or light look, switched in one press
        if darkOn {
            r.addBottom("dark" (PresI18n.t("Light")) (PresToolbar.railIcon("light")))
        } {
            r.addBottom("dark" (PresI18n.t("Dark")) (PresToolbar.railIcon("dark")))
        }
        r.addBottom("settings" (PresI18n.t("Settings")) (PresToolbar.railIcon("settings")))
        if reviewOn {
            r.setBadge("review" "•")
        }
        r.value = railValue
        r.build()
        rail = r
        return r
    }

    ; The frame's piece over the work's top left corner at (x, y): it
    ; rounds the corner of whatever is there (Rooms, the tab row).
    fn frameCorner:EVGElement (x:double y:double) {
        def r:double 12.0
        def el (EVGElement.createPath())
        el.id = "tb-corner"
        el.className = "tb-corner"
        el.a11yHidden = true
        el.setAttribute("position" "absolute")
        el.setAttribute("left" ((EVGDisplayList.num(x)) + "px"))
        el.setAttribute("top" ((EVGDisplayList.num(y)) + "px"))
        el.setAttribute("width" ((EVGDisplayList.num(r)) + "px"))
        el.setAttribute("height" ((EVGDisplayList.num(r)) + "px"))
        el.setAttribute("viewBox" ("0 0 " + (EVGDisplayList.num(r)) + " " + (EVGDisplayList.num(r))))
        el.setAttribute("preserveAspectRatio" "none")
        el.setAttribute("d" (UiShapes.corner(r "tl")))
        return el
    }

    ; The rail's tone: on the brand's frame, except in the retro skin, which
    ; draws its own panel there.
    fn frameTone:string () {
        if ((indexOf skin "retro") >= 0) {
            return ""
        }
        return "frame"
    }

    fn frameUnder:EVGElement (x:double y:double fw:double fh:double) {
        def el:EVGElement (this.div("tb-frameunder"))
        el.a11yHidden = true
        el.setAttribute("position" "absolute")
        el.setAttribute("left" ((EVGDisplayList.num(x)) + "px"))
        el.setAttribute("top" ((EVGDisplayList.num(y)) + "px"))
        el.setAttribute("width" ((EVGDisplayList.num(fw)) + "px"))
        el.setAttribute("height" ((EVGDisplayList.num(fh)) + "px"))
        return el
    }

    fn buildRail:void (root:EVGElement) {
        def col:EVGElement (this.div("tb-railcol"))
        col.addChild((this.logoEl()))
        def r:RailCtl (this.railCtl((this.frameTone())))
        ; the column's height under the mark: the bottom places at its foot
        def re:EVGElement (unwrap r.rootEl)
        re.setAttribute("height" ((EVGDisplayList.num((h - 66.0))) + "px"))
        this.put(r col)
        root.addChild(col)
    }

    ; A phone's drawer: the same places, as a grid at its top.
    fn drawerRail:void (body:EVGElement) {
        def r:RailCtl (this.railCtl(""))
        def dre:EVGElement (unwrap r.rootEl)
        UiTree.addClass(dre "tb-drawer-rail")
        def g:int 0
        while (g < (dre.getChildCount())) {
            UiTree.addClass((dre.getChild(g)) "tb-drawer-group")
            g = (g + 1)
        }
        this.put(r body)
        body.addChild((this.div("tb-dr-sep")))
    }

    ; The name's button is always this wide, so the menus after it stay put
    ; whatever the name; a phone gives it what the bar has left.
    fn titleW:double () {
        if (this.compact()) {
            def room:double (w - 290.0)
            if (room < 80.0) {
                return 80.0
            }
            if (room > 280.0) {
                return 280.0
            }
            return room
        }
        return 280.0
    }

    fn engine:EVGTextEngine () {
        if (null? eng) {
            def l (new EVGLayout())
            eng = (l.getTextEngine())
        }
        return (unwrap eng)
    }

    ; The name measured into the button's width, "…" at the cut.
    fn titleFit:string (words:string) {
        return (UiText.fit((this.engine()) words "Open Sans" 16.0 ((this.titleW()) - 18.0)))
    }

    ; Rooms (ADR 0001): the rooms the page lists, the open one's presentations
    ; under it. The page fills both, from the server's rooms or from this
    ; browser's (web/rooms.js).
    ; `unread`: the room's chat has messages this browser has not read, a
    ; small blue dot after the name
    fn roomRow:void (body:EVGElement id:string name:string count:string unread:boolean) {
        def open:boolean (id == roomOpen)
        def row:ButtonCtl (this.button(("room-" + id) name "ghost" body))
        def rel:EVGElement (unwrap row.rootEl)
        UiTree.addClass(rel "tb-room")
        if open {
            UiTree.addClass(rel "tb-room-open")
        }
        if (dragOn && (id == dropRoom)) {
            if ((strlen dragRoom) > 0) {
                UiTree.addClass(rel "tb-room-before")
            } {
                UiTree.addClass(rel "tb-room-drop")
            }
        }
        if (dragOn && (id == dragRoom)) {
            UiTree.addClass(rel "tb-room-dragged")
        }
        if ((rel.getChildCount()) > 0) {
            ; a long name gives way to the count and the buttons after it
            def keep:double 40.0
            if ((strlen count) > 0) {
                keep = (keep + 22.0)
            }
            if unread {
                keep = (keep + 14.0)
            }
            if (id != "onboarding") {
                keep = (keep + 26.0)
            }
            if ((PresToolbar.builtInRoom(id)) == false) {
                keep = (keep + 26.0)
            }
            def lb:EVGElement (rel.getChild(0))
            lb.textContent = (UiText.fit((this.engine()) ("# " + name) "Open Sans" 13.0 (roomsW - keep)))
            UiTree.addClass(lb "tb-room-name")
        }
        if unread {
            rel.addChild((this.div("tb-room-dot")))
        }
        rel.addChild((this.div("tb-grow")))
        if ((strlen count) > 0) {
            rel.addChild((this.text("tb-room-count" count)))
        }
        ; a new presentation straight into the room
        if (id != "onboarding") {
            def add:ButtonCtl (this.iconButton(("roomadd-" + id) (PresI18n.t("New presentation in this room")) "ghost" "M12 5v14M5 12h14" rel))
            UiTree.addClass((unwrap add.rootEl) "tb-roomgear")
        }
        ; its settings at the end: a room made here its name, archive and
        ; delete; every room but Onboarding clearing its presentations
        if (id != "onboarding") {
            def gear:ButtonCtl (this.iconButton(("roomgear-" + id) (PresI18n.t("Room settings")) "ghost" (PresToolbar.railIcon("gear")) rel))
            UiTree.addClass((unwrap gear.rootEl) "tb-roomgear")
        }
    }

    sfn builtInRoom:boolean (id:string) {
        return (((id == "general") || (id == "playground")) || (id == "onboarding"))
    }

    fn roomDeck:void (body:EVGElement id:string name:string current:boolean) {
        def shown:string (UiText.fit((this.engine()) name "Open Sans" 13.0 (roomsW - 63.0)))
        def b:ButtonCtl (this.button(("roomdeck-" + id) shown "ghost" body))
        def el:EVGElement (unwrap b.rootEl)
        UiTree.addClass(el "tb-roomdeck")
        if ((el.getChildCount()) > 0) {
            UiTree.addClass((el.getChild(0)) "tb-roomdeck-label")
        }
        ; the name at the start, as the room's own row has it
        el.addChild((this.div("tb-grow")))
        if current {
            UiTree.addClass(el "tb-roomdeck-current")
            if ((el.getChildCount()) > 0) {
                UiTree.addClass((el.getChild(0)) "tb-roomdeck-label-current")
            }
        }
        ; "… Show all" and the row moving the open one here: the room's own
        ; actions, quieter than its presentations
        if (((id == "all") || (id == "new")) || (id == "newfolder")) {
            if ((el.getChildCount()) > 0) {
                UiTree.addClass((el.getChild(0)) "tb-roomdeck-act")
            }
        }
    }

    ; A folder of the open room: a folder icon (open or shut) and its name,
    ; its count, and its gear (rename, delete). Pressed, it opens or shuts; a
    ; presentation let go on it is filed there.
    fn roomFolder:void (body:EVGElement id:string name:string open:boolean count:string) {
        def keep:double 85.0
        if ((strlen count) > 0) {
            keep = (keep + 22.0)
        }
        def c (new ButtonCtl())
        c.tid = ("tb-roomdeck-f:" + id)
        c.name = (UiText.fit((this.engine()) name "Open Sans" 13.0 (roomsW - keep)))
        c.variant = "ghost"
        c.icon = "M3 6a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"
        if open {
            c.icon = "M3 19V6a1 1 0 0 1 1-1h5l2 2h7a1 1 0 0 1 1 1v3M3 19l3-8h16l-3 8z"
        }
        c.iconClass = "tb-icon-folder"
        c.build()
        def el:EVGElement (unwrap c.rootEl)
        UiTree.addClass(el "tb-button")
        this.put(c body)
        UiTree.addClass(el "tb-roomdeck")
        UiTree.addClass(el "tb-roomfolder")
        if ((el.getChildCount()) > 1) {
            UiTree.addClass((el.getChild(1)) "tb-roomdeck-label")
        }
        if (dragOn && (id == dropFolder)) {
            UiTree.addClass(el "tb-room-drop")
        }
        el.addChild((this.div("tb-grow")))
        if ((strlen count) > 0) {
            el.addChild((this.text("tb-room-count" count)))
        }
        def gear:ButtonCtl (this.iconButton(("roomfolder-" + id) (PresI18n.t("Folder settings")) "ghost" (PresToolbar.railIcon("gear")) el))
        UiTree.addClass((unwrap gear.rootEl) "tb-roomgear")
    }

    ; The open room's presentation `id` is in one of its folders.
    fn deckInFolder:boolean (id:string) {
        def ds:[string] (strsplit roomDecks (strfromcode 10))
        def k:int 0
        while (k < (array_length ds)) {
            def dp:[string] (strsplit (itemAt ds k) (strfromcode 9))
            if ((((array_length dp) >= 4) && ((itemAt dp 0) == id)) && ((itemAt dp 3) == "i")) {
                return true
            }
            k = (k + 1)
        }
        return false
    }

    ; The folder row under the pointer ("" none), its gear too.
    fn folderAt:string (px:double py:double) {
        def tid:string (host.hitTest(px py))
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            def ct:string owner.tid
            if (((indexOf ct "tb-roomdeck-f:") == 0) || ((indexOf ct "tb-roomfolder-") == 0)) {
                return (substring ct 14 (strlen ct))
            }
        }
        return ""
    }

    fn buildRooms:void (root:EVGElement) {
        def pane:EVGElement (this.div("tb-rooms"))
        def head:EVGElement (this.div("tb-rooms-head"))
        ; "‹" before the heading folds the panel away, on every screen
        def close:ButtonCtl (this.iconButton("room-close" (PresI18n.t("Close")) "ghost" "M15 5l-7 7 7 7" head))
        UiTree.addClass((unwrap close.rootEl) "tb-rooms-close")
        head.addChild((this.text("tb-rooms-title" (PresI18n.t("Rooms")))))
        head.addChild((this.div("tb-grow")))
        def add:ButtonCtl (this.iconButton("room-new" (PresI18n.t("New room")) "ghost" "M12 5v14M5 12h14" head))
        UiTree.addClass((unwrap add.rootEl) "tb-rooms-add")
        pane.addChild(head)
        ; "+" opens the room's window (PresApp); the search row is a field,
        ; the list then the rooms it finds
        def fieldOn:boolean (titleEditing && (editFor == "search"))
        if fieldOn {
            def c:InputCtl titleIn
            c.tid = "tb-title-in"
            c.name = (PresI18n.t("Search rooms"))
            c.placeholder = (PresI18n.t("Search rooms…"))
            c.boxClass = "tb-roomname-box"
            c.focused = true
            c.build()
            this.put(c pane)
        }
        if ((fieldOn == false) && ((strlen roomSearchLabel) > 0)) {
            def sb:ButtonCtl (this.button("roomsearch" roomSearchLabel "ghost" pane))
            def sel:EVGElement (unwrap sb.rootEl)
            UiTree.addClass(sel "tb-roomsearch")
            if ((sel.getChildCount()) > 0) {
                UiTree.addClass((sel.getChild(0)) "tb-roomsearch-label")
            }
            sel.addChild((this.div("tb-grow")))
        }
        this.liveRooms(pane)
        if fieldOn {
            this.foundDecks(pane)
        }
        root.addChild(pane)
    }

    ; Searching: under the rooms found, the presentations whose words hold
    ; the query, each with its room and the text around the first word.
    ; Pressed, one opens in its room.
    fn foundDecks:void (pane:EVGElement) {
        def lines:[string] (strsplit roomFound (strfromcode 10))
        def w:double (roomsW - 40.0)
        def head:boolean false
        for lines line:string i {
            def parts:[string] (strsplit line (strfromcode 9))
            if ((array_length parts) >= 2) {
                if (head == false) {
                    pane.addChild((this.div("tb-rooms-sep")))
                    pane.addChild((this.text("tb-found-head" (PresI18n.t("Presentations")))))
                    head = true
                }
                def id:string (itemAt parts 0)
                def b:ButtonCtl (this.button(("found-" + id) (UiText.fit((this.engine()) (itemAt parts 1) "Open Sans" 13.0 w)) "ghost" pane))
                def el:EVGElement (unwrap b.rootEl)
                UiTree.addClass(el "tb-found")
                if ((el.getChildCount()) > 0) {
                    UiTree.addClass((el.getChild(0)) "tb-found-name")
                }
                if (((array_length parts) >= 3) && ((strlen (itemAt parts 2)) > 0)) {
                    el.addChild((this.text("tb-found-room" (UiText.fit((this.engine()) ("# " + (itemAt parts 2)) "Open Sans" 11.0 w)))))
                }
                if (((array_length parts) >= 4) && ((strlen (itemAt parts 3)) > 0)) {
                    ; two lines at most, the second cut with "…"
                    def wrapped:[string] (UiText.wrapLines((this.engine()) (itemAt parts 3) "Open Sans" 11.0 w))
                    def k:int 0
                    while ((k < (array_length wrapped)) && (k < 2)) {
                        def words:string (itemAt wrapped k)
                        if ((k == 1) && ((array_length wrapped) > 2)) {
                            words = (UiText.fit((this.engine()) (words + " " + (itemAt wrapped 2)) "Open Sans" 11.0 w))
                        }
                        el.addChild((this.text("tb-found-text" words)))
                        k = (k + 1)
                    }
                }
            }
        }
    }

    ; The presentation being dragged, drawn at the pointer.
    fn dragChip:void (root:EVGElement) {
        def chip:EVGElement (this.div("tb-dragchip"))
        def label:string (UiText.fit((this.engine()) dragName "Open Sans" 13.0 200.0))
        chip.addChild((this.text("tb-dragchip-label" label)))
        ; as wide as its name (an absolute box takes the row's width else)
        def cw:double ((UiText.widthOf((this.engine()) label "Open Sans" 13.0)) + 24.0)
        chip.setAttribute("width" ((EVGDisplayList.num(cw)) + "px"))
        chip.setAttribute("position" "absolute")
        chip.setAttribute("left" ((EVGDisplayList.num((dragX + 12.0))) + "px"))
        chip.setAttribute("top" ((EVGDisplayList.num((dragY + 6.0))) + "px"))
        root.addChild(chip)
    }

    ; --- dragging a presentation onto another room (PresApp routes the pointer)
    fn roomDragging:boolean () {
        return (((strlen dragDeck) > 0) || ((strlen dragRoom) > 0))
    }

    ; The room row under the pointer ("" none): its gear and the head's
    ; buttons are not rooms.
    fn roomAt:string (px:double py:double) {
        def tid:string (host.hitTest(px py))
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            def ct:string owner.tid
            if (((indexOf ct "tb-room-") == 0) && ((ct != "tb-room-new") && (ct != "tb-room-close"))) {
                return (substring ct 8 (strlen ct))
            }
            if ((indexOf ct "tb-roomgear-") == 0) {
                return (substring ct 12 (strlen ct))
            }
            if ((indexOf ct "tb-roomadd-") == 0) {
                return (substring ct 11 (strlen ct))
            }
        }
        return ""
    }

    fn roomDragTo:void (px:double py:double) {
        dragX = px
        dragY = py
        if (dragOn == false) {
            def dx:double (px - dragX0)
            def dy:double (py - dragY0)
            if (((dx * dx) + (dy * dy)) < 36.0) {
                return
            }
            dragOn = true
        }
        dropRoom = (this.roomAt(px py))
        ; a presentation onto a folder of its room (a room is not dropped in one)
        dropFolder = ""
        if ((strlen dragDeck) > 0) {
            dropFolder = (this.folderAt(px py))
        }
        this.rebuild()
    }

    ; Let go: a presentation onto another room asks Move or Copy; a room
    ; goes before the one it is let go on. Where it was pressed (no drag)
    ; the presentation or the room opens.
    fn roomDragEnd:void () {
        if ((strlen dragRoom) > 0) {
            if dragOn {
                if (((strlen dropRoom) > 0) && (dropRoom != dragRoom)) {
                    push requests ("room:order:" + dragRoom + ":" + dropRoom)
                }
            } {
                ; the open room and its presentations change together when the
                ; page answers (setOptions "roomdecks"): no frame in between
                ; with the room shut, which flickered
                push requests ("room:open:" + dragRoom)
            }
        } {
            if dragOn {
                ; onto a folder: filed there; onto its own room: out of its
                ; folder to the room's top; onto another room: Move or Copy
                if ((strlen dropFolder) > 0) {
                    push requests ("room:file:" + roomOpen + ":" + dropFolder + ":" + dragDeck)
                } {
                    if (((strlen dropRoom) > 0) && (dropRoom != roomOpen)) {
                        push requests ("room:drop:" + dropRoom + ":" + dragDeck)
                    }
                    if ((dropRoom == roomOpen) && (this.deckInFolder(dragDeck))) {
                        push requests ("room:file:" + roomOpen + "::" + dragDeck)
                    }
                }
            } {
                push requests ("room:deck:" + dragDeck)
            }
        }
        dragDeck = ""
        dragRoom = ""
        dragOn = false
        dropRoom = ""
        dropFolder = ""
        this.rebuild()
    }

    ; A deck's tab dragged out of the tab row (PresApp): over the rooms it
    ; is drawn as the chip and lights the room it would go to; elsewhere
    ; ("" key) nothing.
    fn tabDragTo:void (key:string name:string px:double py:double) {
        def was:string (dragTab + dropRoom)
        def over:string ""
        if (roomsOpen && ((strlen key) > 0)) {
            over = (this.roomAt(px py))
        }
        def on:boolean (roomsOpen && ((strlen key) > 0))
        dragX = px
        dragY = py
        if on {
            dragTab = key
            dragName = name
            dragOn = true
            dropRoom = over
            this.rebuild()
            return
        }
        if ((strlen dragTab) > 0) {
            dragTab = ""
            dragOn = false
            dropRoom = ""
            this.rebuild()
        }
    }

    ; The tab let go: the room it is on ("" none), and the drag is over.
    fn tabDragEnd:string () {
        def room:string ""
        if ((strlen dragTab) > 0) {
            room = dropRoom
        }
        dragTab = ""
        dragOn = false
        dropRoom = ""
        this.rebuild()
        return room
    }

    ; Rows of "id TAB title TAB count TAB u" (u: unread chat messages); under the open room its presentations,
    ; "id TAB name TAB 1 if open TAB kind" (web/rooms.js deckLines).
    fn liveRooms:void (pane:EVGElement) {
        def lines:[string] (strsplit roomRows (strfromcode 10))
        def i:int 0
        ; the built-in rooms come last (web/rooms.js orderRooms), a group of
        ; their own under a line when made rooms are over them
        def madeAbove:boolean false
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def id:string (itemAt parts 0)
                def count:string ""
                if ((array_length parts) >= 3) {
                    count = (itemAt parts 2)
                }
                def unread:boolean false
                if ((array_length parts) >= 4) {
                    unread = ((itemAt parts 3) == "u")
                }
                if (PresToolbar.builtInRoom(id)) {
                    if madeAbove {
                        pane.addChild((this.div("tb-rooms-sep")))
                        madeAbove = false
                    }
                } {
                    madeAbove = true
                }
                this.roomRow(pane id (itemAt parts 1) count unread)
                if (id == roomOpen) {
                    ; the room's presentations hang from a thin line under its "#"
                    def nest:EVGElement (this.div("tb-roomdecks"))
                    nest.addChild((this.div("tb-roomdecks-line")))
                    def list:EVGElement (this.div("tb-roomdecks-list"))
                    nest.addChild(list)
                    def ds:[string] (strsplit roomDecks (strfromcode 10))
                    def k:int 0
                    while (k < (array_length ds)) {
                        def dp:[string] (strsplit (itemAt ds k) (strfromcode 9))
                        if ((array_length dp) >= 2) {
                            def cur:boolean false
                            if ((array_length dp) >= 3) {
                                cur = ((itemAt dp 2) == "1")
                            }
                            ; the last column: "a" the "… Show all" row, "n"
                            ; the one making a new presentation in the room
                            def kind:string ""
                            if ((array_length dp) >= 4) {
                                kind = (itemAt dp 3)
                            }
                            if (kind == "n") {
                                this.roomDeck(list "new" (itemAt dp 1) false)
                            }
                            if (kind == "a") {
                                this.roomDeck(list "all" (itemAt dp 1) false)
                            }
                            if (kind == "nf") {
                                this.roomDeck(list "newfolder" (itemAt dp 1) false)
                            }
                            ; a folder: "f:<id>", 1 when open, its count
                            if (kind == "f") {
                                def fcount:string ""
                                if ((array_length dp) >= 5) {
                                    fcount = (itemAt dp 4)
                                }
                                this.roomFolder(list (substring (itemAt dp 0) 2 (strlen (itemAt dp 0))) (itemAt dp 1) cur fcount)
                            }
                            if (((strlen kind) == 0) || (kind == "i")) {
                                this.roomDeck(list ("d-" + (itemAt dp 0)) (itemAt dp 1) cur)
                                ; one in an open folder, set in under it
                                if (kind == "i") {
                                    def last:EVGElement (list.getChild(((list.getChildCount()) - 1)))
                                    UiTree.addClass(last "tb-roomdeck-in")
                                }
                            }
                        }
                        k = (k + 1)
                    }
                    if ((list.getChildCount()) > 0) {
                        pane.addChild(nest)
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; The name at the start of the bar: a button, or the field it becomes.
    fn titlePart:void (bar:EVGElement) {
        ; a slot of fixed width holds the button or the field, so neither the
        ; name nor editing it moves the menus after it
        def slot:EVGElement (this.div("tb-title-slot"))
        slot.setAttribute("width" ((EVGDisplayList.num((this.titleW()))) + "px"))
        bar.addChild(slot)
        if (titleEditing && (editFor == "title")) {
            def c:InputCtl titleIn
            c.tid = "tb-title-in"
            c.name = (PresI18n.t("Presentation name"))
            ; the field's whole look is its box class, which its own rebuilds keep
            c.boxClass = "tb-title-box"
            c.focused = true
            c.build()
            this.put(c slot)
            return
        }
        def words:string docTitle
        if ((strlen words) == 0) {
            words = (PresI18n.t("Untitled"))
        }
        def b:ButtonCtl (this.button("title" (this.titleFit(words)) "ghost" slot))
        def tel:EVGElement (unwrap b.rootEl)
        UiTree.addClass(tel "tb-title")
        if ((tel.getChildCount()) > 0) {
            UiTree.addClass((tel.getChild(0)) "tb-title-label")
        }
    }

    fn titleBegin:void () {
        this.closeSelects()
        this.closeMenus()
        def c (new InputCtl())
        c.setValue(docTitle)
        c.selectAll()
        titleIn = c
        editFor = "title"
        titleEditing = true
        this.rebuild()
    }

    ; The search row pressed: the field, each key asking the page for the
    ; rooms it finds ("room:search:<text>").
    fn roomSearchBegin:void () {
        this.closeSelects()
        this.closeMenus()
        titleIn = (new InputCtl())
        editFor = "search"
        titleEditing = true
        push requests "room:search:"
        this.rebuild()
    }

    ; A room's name in the list.
    fn roomName:string (id:string) {
        def rs:[string] (strsplit roomRows (strfromcode 10))
        def k:int 0
        while (k < (array_length rs)) {
            def rp:[string] (strsplit (itemAt rs k) (strfromcode 9))
            if (((array_length rp) >= 2) && ((itemAt rp 0) == id)) {
                return (itemAt rp 1)
            }
            k = (k + 1)
        }
        return id
    }

    ; A presentation's name in the open room's list.
    fn roomDeckName:string (id:string) {
        def ds:[string] (strsplit roomDecks (strfromcode 10))
        def k:int 0
        while (k < (array_length ds)) {
            def dp:[string] (strsplit (itemAt ds k) (strfromcode 9))
            if (((array_length dp) >= 2) && ((itemAt dp 0) == id)) {
                return (itemAt dp 1)
            }
            k = (k + 1)
        }
        return id
    }

    ; Enter, or a press elsewhere: the name as typed, asked of the page.
    fn titleCommit:void () {
        if (titleEditing == false) {
            return
        }
        titleEditing = false
        def v:string (trim titleIn.value)
        if (editFor == "search") {
            ; Enter opens the first room found
            push requests ("room:searchgo:" + v)
            this.rebuild()
            return
        }
        if (((strlen v) > 0) && (v != docTitle)) {
            docTitle = v
            push requests ("title:" + v)
        }
        this.rebuild()
    }

    fn titleCancel:void () {
        titleEditing = false
        if (editFor == "search") {
            push requests "room:searchend"
        }
        this.rebuild()
    }

    ; The search field's text changed: the page lists what it finds.
    fn searchChanged:void () {
        if (titleEditing && (editFor == "search")) {
            push requests ("room:search:" + titleIn.value)
        }
    }

    fn titleType:void (s:string) {
        def line:string ""
        def i:int 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            if ((ch != (strfromcode 10)) && (ch != (strfromcode 13))) {
                line = (line + ch)
            }
            i = (i + 1)
        }
        if ((strlen line) > 0) {
            host.type(line)
        }
        this.searchChanged()
        rev = (rev + 1)
    }

    sfn kitKey:string (name:string) {
        if (name == "left") { return "ArrowLeft" }
        if (name == "right") { return "ArrowRight" }
        if (name == "home") { return "Home" }
        if (name == "end") { return "End" }
        if (name == "backspace") { return "Backspace" }
        if (name == "delete") { return "Delete" }
        return ""
    }

    fn titleKey:boolean (name:string shift:boolean ctrl:boolean) {
        if (name == "enter") {
            this.titleCommit()
            return true
        }
        if (name == "escape") {
            this.titleCancel()
            return true
        }
        if ((name == "a") && ctrl) {
            titleIn.selectAll()
            titleIn.build()
            rev = (rev + 1)
            return true
        }
        def k:string (PresToolbar.kitKey(name))
        if ((strlen k) > 0) {
            host.keyWith(k shift ctrl)
            this.searchChanged()
            rev = (rev + 1)
        }
        return true
    }

    fn rebuild:void () {
        def keepSample:boolean sample.open
        def keepTheme:boolean theme.open
        def keepLang:boolean langSel.open
        ; the menu open, and its open submenus, carried over the rebuild
        def keepMenu:string ""
        def keepPath:[string]
        def keepCtx:string ""
        def mi:int 0
        while (mi < (array_length menus)) {
            def om:MenuCtl (itemAt menus mi)
            if om.open {
                if (om.tid == "tb-m-ctx") {
                    keepCtx = om.activeTid
                } {
                    keepMenu = om.tid
                    keepPath = om.openPath
                }
            }
            mi = (mi + 1)
        }
        def noMenus:[MenuCtl]
        menus = noMenus
        def fresh (new UiHost())
        fresh.addStyleSheetFrom(css host)
        ; what the pointer is over stays hovered across a rebuild
        fresh.hoverTid = host.hoverTid
        host = fresh
        host.setTheme((trim ("tb " + skin)))
        host.setPageSize(w h)
        def root:EVGElement (unwrap host.root)
        root.className = "ui-root tb-page"
        ; under the frame's bar and rail, one pixel past their edges: every
        ; box's edge is smoothed, and over the light work below it would
        ; show as a pale seam between the frame and the work
        if ((this.frameTone()) == "frame") {
            root.addChild((this.frameUnder(0.0 0.0 w (barH + 1.0))))
            if ((this.compact()) == false) {
                root.addChild((this.frameUnder(0.0 0.0 (railW + 1.0) h)))
            }
        }
        def bar:EVGElement (this.div("tb-bar"))
        onFrame = ((this.frameTone()) == "frame")
        def play:string (PresI18n.t("▶ Play"))
        if playing {
            play = (PresI18n.t("⏸ Pause"))
        }
        def small:boolean (this.compact())
        if small {
            this.button("menu" "☰" "ghost" bar)
            this.titlePart(bar)
            bar.addChild((this.div("tb-grow")))
            this.button("present" (PresI18n.t("⛶ Present")) "primary" bar)
            this.extraButtons(bar)
        } {
            ; room for the rail, which runs the window's height beside the bar
            def pad:EVGElement (this.div("tb-railpad"))
            pad.setAttribute("width" ((EVGDisplayList.num(railW)) + "px"))
            pad.setAttribute("min-width" ((EVGDisplayList.num(railW)) + "px"))
            bar.addChild(pad)
            this.titlePart(bar)
            def file:MenuCtl (this.dropdown("file" (PresI18n.t("File"))))
            ; groups as in a desktop app: new | open | save and export | the
            ; assistants | settings | delete, red and last
            ; New ▸ a presentation (the window) or a datasheet (the spreadsheet
            ; editor, its workbook kept in the deck's data/)
            def nw:UiItem (file.addSub("new" (PresI18n.t("New")) false))
            MenuCtl.addKid(nw "newPres" (PresI18n.t("Presentation…")) false)
            MenuCtl.addKid(nw "newSheet" (PresI18n.t("Datasheet…")) false)
            file.addItem("rename" (PresI18n.t("Rename…")) false)
            file.addItem("duplicate" (PresI18n.t("Duplicate")) false)
            file.addSeparator()
            file.addItem("openbox" (PresI18n.t("Open…")) false)
            def rc:UiItem (file.addSub("recent" (PresI18n.t("Recent")) false))
            this.recentKids(rc)
            file.addSeparator()
            this.deckRows(file true)
            file.setShortcut("openbox" (this.modKey("O")))
            file.setShortcut("save" (this.modKey("S")))
            ; Edit: the keys' commands as rows, Paste without formatting
            ; among them (the theme's styles not taken along)
            def ed:MenuCtl (this.dropdown("edit" (PresI18n.t("Edit"))))
            ed.addItem("ed-undo" (PresI18n.t("Undo")) false)
            ed.addItem("ed-redo" (PresI18n.t("Redo")) false)
            ed.addSeparator()
            ed.addItem("ed-cut" (PresI18n.t("Cut")) false)
            ed.addItem("ed-copy" (PresI18n.t("Copy")) false)
            ed.addItem("ed-paste" (PresI18n.t("Paste")) false)
            ed.addItem("ed-pastePlain" (PresI18n.t("Paste without formatting")) false)
            ed.addSeparator()
            ed.addItem("ed-copySlides" (this.copySlidesLabel()) false)
            ed.setShortcut("ed-undo" (this.modKey("Z")))
            ed.setShortcut("ed-redo" (this.modKey("Y")))
            ed.setShortcut("ed-cut" (this.modKey("X")))
            ed.setShortcut("ed-copy" (this.modKey("C")))
            ed.setShortcut("ed-paste" (this.modKey("V")))
            ed.setShortcut("ed-pastePlain" (this.modKey("Shift+V")))
            def slide:MenuCtl (this.dropdown("slide" (PresI18n.t("Slide"))))
            slide.addItem("slideNew" (PresI18n.t("New slide")) false)
            slide.addItem("slideDuplicate" (PresI18n.t("Duplicate slide")) false)
            slide.addItem("slideDelete" (PresI18n.t("Delete slide")) false)
            slide.addSeparator()
            slide.addItem("slideDraw" (PresI18n.t("Draw on slide")) false)
            slide.setShortcut("slideNew" "Control+M")
            slide.setShortcut("slideDuplicate" (this.modKey("D")))
            slide.addSeparator()
            def ori:UiItem (slide.addSub("orientation" (PresI18n.t("Orientation")) false))
            this.orientationKids(ori)
            slide.addSeparator()
            slide.addItem("themes" (PresI18n.t("Theme…")) false)
            slide.addSeparator()
            slide.addItem("css" (PresI18n.t("Edit theme CSS…")) false)
            ; Record: the presentation with the voice, the pointer and what is
            ; drawn on it (PresRecord), played again from here
            def rc2:MenuCtl (this.dropdown("record" (PresI18n.t("Record"))))
            rc2.addItem("rec-start" (PresI18n.t("● Record presentation")) false)
            rc2.addItem("rec-play" (PresI18n.t("▶ Play recording")) (hasRec == false))
            ; the rest only once there is a recording
            if hasRec {
                rc2.addItem("rec-edit" (PresI18n.t("✂ Edit recording…")) false)
                def vo:UiItem (rc2.addSub("rec-voice" (PresI18n.t("Voice")) false))
                this.voiceKids(vo)
                rc2.addSeparator()
                rc2.addItem("rec-delete" (PresI18n.t("Delete recording…")) false)
                rc2.setVariant("rec-delete" "destructive")
            }
            def ex:MenuCtl (this.dropdown("export" (PresI18n.t("Export"))))
            this.exportItems(ex)
            ex.addSeparator()
            def exClip:UiItem (ex.addSub("x-clip" (PresI18n.t("Export to Clipboard")) false))
            this.clipboardKids(exClip false)
            def hp:MenuCtl (this.dropdown("help" (PresI18n.t("Help"))))
            hp.addItem("helpGuide" (PresI18n.t("How to use Sliqtly")) false)
            hp.addItem("helpBtn" (PresI18n.t("Help for this slide")) false)
            hp.addSeparator()
            hp.addItem("about" (PresI18n.t("About")) false)

            def k:int 0
            while (k < (array_length menus)) {
                def m:MenuCtl (itemAt menus k)
                if (m.tid == keepMenu) {
                    m.open = true
                    m.openPath = keepPath
                }
                m.build()
                this.put(m bar)
                k = (k + 1)
            }
            bar.addChild((this.div("tb-sep")))
            this.button("play" play "outline" bar)
            this.button("present" (PresI18n.t("⛶ Present")) "primary" bar)
            this.button("share" (PresI18n.t("Share")) "secondary" bar)
            bar.addChild((this.div("tb-grow")))
            bar.addChild((this.text("tb-status" status)))
            this.extraButtons(bar)
            if ((strlen langRows) > 0) {
                langSel = (this.select("lang" (PresI18n.t("Language")) langRows langValue bar))
            }
        }
        root.addChild(bar)
        barEl = bar
        onFrame = false
        if (small && roomsOpen) {
            this.buildRooms(root)
            def rp:EVGElement (root.getChild(((root.getChildCount()) - 1)))
            def pw:double roomsW
            if (pw > w) {
                pw = w
            }
            rp.setAttribute("position" "absolute")
            rp.setAttribute("left" "0px")
            rp.setAttribute("top" ((EVGDisplayList.num(barH)) + "px"))
            rp.setAttribute("width" ((EVGDisplayList.num(pw)) + "px"))
            rp.setAttribute("height" ((EVGDisplayList.num(((h - barH) - 20.0))) + "px"))
        }
        if (small == false) {
            this.buildRail(root)
            def colEl:EVGElement (root.getChild(((root.getChildCount()) - 1)))
            colEl.setAttribute("position" "absolute")
            colEl.setAttribute("left" "0px")
            colEl.setAttribute("top" "0px")
            colEl.setAttribute("width" ((EVGDisplayList.num(railW)) + "px"))
            colEl.setAttribute("height" ((EVGDisplayList.num(h)) + "px"))
            if roomsOpen {
                this.buildRooms(root)
                def rmEl:EVGElement (root.getChild(((root.getChildCount()) - 1)))
                rmEl.setAttribute("position" "absolute")
                rmEl.setAttribute("left" ((EVGDisplayList.num(railW)) + "px"))
                rmEl.setAttribute("top" ((EVGDisplayList.num(barH)) + "px"))
                rmEl.setAttribute("width" ((EVGDisplayList.num(roomsW)) + "px"))
                rmEl.setAttribute("height" ((EVGDisplayList.num(((h - barH) - 20.0))) + "px"))
            }
            ; the bar and the rail are a frame in the brand's colour; the
            ; work under the bar and right of the rail is set into it, its
            ; top left corner rounded (Slack's window)
            if ((this.frameTone()) == "frame") {
                root.addChild((this.frameCorner(railW barH)))
            }
        }
        if dragOn {
            this.dragChip(root)
        }
        if titleEditing {
            host.focus("tb-title-in")
        }
        if ctxOpen {
            this.contextMenu(root keepCtx)
        }

        ; the drawer: everything the narrow bar leaves out, as a list
        def dr (new DrawerCtl())
        dr.tid = "tb-drawer"
        dr.side = "left"
        dr.title = brand
        dr.closeLabel = (PresI18n.t("Close"))
        def dw:double 300.0
        if (dw > (w - 24.0)) {
            dw = (w - 24.0)
        }
        dr.width = dw
        dr.top = barH
        dr.panelHeight = (h - barH)
        dr.durationMs = 0.0
        def showDrawer:boolean (drawerOpen && small)
        if showDrawer {
            dr.open = true
            dr.progress = 1.0
        }
        dr.build()
        drawer = dr
        push host.ctls dr
        root.addChild((unwrap dr.rootEl))
        if showDrawer {
            def body:EVGElement (dr.body())
            this.drawerRail(body)
            this.button("dr-play" play "ghost" body)
            this.button("dr-share" (PresI18n.t("Share")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("File")))))
            this.button("dr-new" (PresI18n.t("New presentation")) "ghost" body)
            this.button("dr-newSheet" (PresI18n.t("New datasheet")) "ghost" body)
            this.button("dr-rename" (PresI18n.t("Rename…")) "ghost" body)
            this.button("dr-duplicate" (PresI18n.t("Duplicate")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-openbox" (PresI18n.t("Open…")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-save" (PresI18n.t("Save .md")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-aiClaude" (PresI18n.t("Edit in Claude…")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            def del:ButtonCtl (this.button("dr-deleteDeck" (PresI18n.t("Delete presentation…")) "ghost" body))
            def delEl:EVGElement (unwrap del.rootEl)
            if ((delEl.getChildCount()) > 0) {
                UiTree.addClass((delEl.getChild(0)) "tb-danger")
            }
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-slideNew" (PresI18n.t("New slide")) "ghost" body)
            this.button("dr-slideDuplicate" (PresI18n.t("Duplicate slide")) "ghost" body)
            this.button("dr-slideDelete" (PresI18n.t("Delete slide")) "ghost" body)
            this.button("dr-slideDraw" (PresI18n.t("Draw on slide")) "ghost" body)
            def otherWay:string "o-portrait"
            def otherName:string (PresI18n.t("Portrait"))
            if portrait {
                otherWay = "o-landscape"
                otherName = (PresI18n.t("Landscape"))
            }
            this.button(("dr-" + otherWay) (((PresI18n.t("Orientation")) + ": ") + otherName) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-themes" (PresI18n.t("Theme…")) "ghost" body)
            this.button("dr-css" (PresI18n.t("Edit theme CSS…")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Clipboard")))))
            this.button("dr-cp-md" (PresI18n.t("Markdown")) "ghost" body)
            this.button("dr-cp-mdc" (PresI18n.t("Markdown + comments")) "ghost" body)
            this.button("dr-cp-comments" (PresI18n.t("Open comments")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Export")))))
            this.button("dr-x-save" (PresI18n.t("Markdown (.md)")) "ghost" body)
            this.button("dr-pptx" (PresI18n.t("PowerPoint (.pptx)")) "ghost" body)
            this.button("dr-docx" (PresI18n.t("Word (.docx)")) "ghost" body)
            this.button("dr-html" (PresI18n.t("Web page (.html)")) "ghost" body)
            this.button("dr-player" (PresI18n.t("Presentation player (.html)")) "ghost" body)
            this.button("dr-pdf" (PresI18n.t("PDF (.pdf)")) "ghost" body)
            this.button("dr-zip" (PresI18n.t("All files (.zip)")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Record")))))
            this.button("dr-rec-start" (PresI18n.t("● Record presentation")) "ghost" body)
            if hasRec {
                this.button("dr-rec-play" (PresI18n.t("▶ Play recording")) "ghost" body)
                this.button("dr-rec-edit" (PresI18n.t("✂ Edit recording…")) "ghost" body)
            }
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Help")))))
            this.button("dr-helpGuide" (PresI18n.t("How to use Sliqtly")) "ghost" body)
            this.button("dr-helpBtn" (PresI18n.t("Help for this slide")) "ghost" body)
            this.button("dr-about" (PresI18n.t("About")) "ghost" body)
            if ((strlen langRows) > 0) {
                body.addChild((this.text("tb-dr-label" (PresI18n.t("Language")))))
                langSel = (this.select("lang" (PresI18n.t("Language")) langRows langValue body))
            }
        }
        if keepSample {
            sample.openList()
            sample.build()
        }
        if keepTheme {
            theme.openList()
            theme.build()
        }
        if keepLang {
            langSel.openList()
            langSel.build()
        }
        rev = (rev + 1)
    }

    ; --- the assistants' marks ------------------------------------------------------
    ; Claude's mark before "Edit in Claude…", in the File menu and in the
    ; drawer. MenuCtl draws a row as
    ; its text alone and builds its rows again whenever the menu changes, so
    ; the marks are put in on each drawing: the row's text becomes a mark and
    ; a label beside it, as MenuCtl's own sub-trigger rows are.
    ; Path: Simple Icons (CC0).
    sfn markFor:string (id:string) {
        if (((id == "tb-m-file-item-aiClaude") || (id == "tb-m-ctx-item-aiClaude")) || (id == "tb-dr-aiClaude")) {
            return "claude"
        }
        return ""
    }

    sfn markPath:string (mark:string) {
        if (mark == "claude") {
            return "m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z"
        }
        return ""
    }

    sfn markEl:EVGElement (mark:string) {
        def m (EVGElement.createDiv())
        m.className = ("tb-mark tb-mark-" + mark)
        m.tagName = "path"
        m.elementType = 3
        m.viewBox = "0 0 24 24"
        m.svgPath = (PresToolbar.markPath(mark))
        m.a11yHidden = true
        return m
    }

    fn addMarks:void (el:EVGElement) {
        def mark:string (PresToolbar.markFor(el.id))
        if ((strlen mark) > 0) {
            ; a menu row: its text, made a mark and a label
            if (el.elementType == 1) {
                def words:string el.textContent
                UiTree.clearChildren(el)
                el.textContent = ""
                el.elementType = 0
                UiTree.addClass(el "tb-marked")
                el.addChild((PresToolbar.markEl(mark)))
                el.addChild((UiTree.label("" "ui-dropdownmenu-item-label" words)))
                return
            }
            ; a drawer button: the mark before its label
            if ((el.getChildCount()) == 1) {
                UiTree.addClass(el "tb-marked")
                def lbl:EVGElement (el.getChild(0))
                UiTree.clearChildren(el)
                el.addChild((PresToolbar.markEl(mark)))
                el.addChild(lbl)
                return
            }
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.addMarks((el.getChild(i)))
            i = (i + 1)
        }
    }

    ; --- drawing ------------------------------------------------------------------
    fn page:EVGElement () {
        def r:EVGElement (unwrap host.root)
        this.addMarks(r)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h coarse)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        lay.layout(pg)
        ; buttons past the right edge: built again shorter (at most twice)
        if (this.refit()) {
            return (this.page())
        }
        ; a menu card as wide as its widest row (a submenu hangs off its row)
        if (UiHost.fitSurfaces(r lay)) {
            lay.layout(pg)
        }
        ; the fields' caret and selection onto the laid out text (UiHost.layout
        ; does this; the bar lays its tree out itself)
        host.placeText((lay.getTextEngine()))
        host.lastPage = pg
        return pg
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.page())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; --- the pointer --------------------------------------------------------------
    fn listOpen:boolean () {
        return ((((sample.open || theme.open) || langSel.open) || (((strlen (this.openMenu())) > 0) || drawerOpen)) || titleEditing)
    }

    ; Rooms over the page's left edge: a narrow window has no rail, so the
    ; panel lies over what is under the bar instead of beside it.
    fn roomsOver:boolean () {
        return (roomsOpen && (this.compact()))
    }

    ; The bar, or anywhere while a list is open (a press outside closes it).
    fn has:boolean (px:double py:double) {
        if ((this.roomsOver()) && (px < roomsW)) {
            return true
        }
        return (((py < barH) || (this.listOpen())) || (px < (this.leftW())))
    }

    ; A press with the page's click count and shift, for the name field.
    fn pressWith:void (px:double py:double clicks:int shift:boolean) {
        pressClicks = clicks
        pressShift = shift
        this.press(px py)
        pressClicks = 1
        pressShift = false
    }

    ; A drag from a press in the name or search field selects in it.
    fn titleDragTo:void (px:double) {
        if titleSelecting {
            host.textDragTo(px)
            rev = (rev + 1)
        }
    }

    fn titleRelease:void () {
        if titleSelecting {
            host.textRelease()
        }
        titleSelecting = false
    }

    fn press:void (px:double py:double) {
        if (null? host.lastPage) {
            this.page()
        }
        def tid:string (host.hitTest(px py))
        def ctlTid:string ""
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            ctlTid = owner.tid
        }
        def isSel:boolean (((strlen ctlTid) > 0) && (((ctlTid == sample.tid) || (ctlTid == theme.tid)) || (ctlTid == langSel.tid)))
        def isMenu:boolean ((indexOf ctlTid "tb-m-") == 0)
        def inDrawer:boolean ((ctlTid == "tb-drawer") || ((indexOf ctlTid "tb-dr-") == 0))
        ; the name being edited: a press in it moves the caret, one anywhere
        ; else renames (and does nothing else)
        if titleEditing {
            if (ctlTid == "tb-title-in") {
                titleSelecting = (host.textPress(tid px pressClicks pressShift))
                rev = (rev + 1)
                return
            }
            ; searching, a room found is opened by its press, and a
            ; presentation found in its room
            if (editFor == "search") {
                if ((indexOf ctlTid "tb-found-") == 0) {
                    titleEditing = false
                    roomFound = ""
                    push requests ("room:found:" + (substring ctlTid 9 (strlen ctlTid)))
                    this.rebuild()
                    return
                }
                if (((indexOf ctlTid "tb-room-") == 0) && (ctlTid != "tb-room-close")) {
                    titleEditing = false
                    roomOpen = (substring ctlTid 8 (strlen ctlTid))
                    push requests ("room:pick:" + roomOpen)
                    this.rebuild()
                    return
                }
                this.titleCancel()
                return
            }
            this.titleCommit()
            return
        }
        if (ctlTid == "tb-title") {
            this.titleBegin()
            return
        }
        if (ctlTid == "tb-rail") {
            drawerOpen = false
            this.closeLists()
            host.click(tid)
            def place:string (rail.takePressed())
            if (place == "rooms") {
                roomsOpen = (roomsOpen == false)
                push requests "rail:layout"
                if roomsOpen {
                    push requests "room:list"
                }
                this.rebuild()
                return
            }
            if ((strlen place) > 0) {
                push requests ("rail:" + place)
            }
            this.rebuild()
            return
        }
        if (ctlTid == "tb-room-close") {
            roomsOpen = false
            push requests "rail:layout"
            this.rebuild()
            return
        }
        if (ctlTid == "tb-room-new") {
            push requests "room:new"
            return
        }
        if ((indexOf ctlTid "tb-roomgear-") == 0) {
            push requests ("room:settings:" + (substring ctlTid 12 (strlen ctlTid)))
            return
        }
        if ((indexOf ctlTid "tb-roomadd-") == 0) {
            push requests ("room:newin:" + (substring ctlTid 11 (strlen ctlTid)))
            return
        }
        if ((indexOf ctlTid "tb-room-") == 0) {
            def id:string (substring ctlTid 8 (strlen ctlTid))
            ; a made room may be dragged to another place: it opens when let
            ; go where it was pressed (roomDragEnd)
            if ((PresToolbar.builtInRoom(id)) == false) {
                dragRoom = id
                dragName = ("# " + (this.roomName(id)))
                dragX0 = px
                dragY0 = py
                dragX = px
                dragY = py
                dragOn = false
                dropRoom = ""
                return
            }
            push requests ("room:open:" + id)
            return
        }
        if ((indexOf ctlTid "tb-roomfolder-") == 0) {
            push requests ("room:folderset:" + roomOpen + ":" + (substring ctlTid 14 (strlen ctlTid)))
            return
        }
        if ((indexOf ctlTid "tb-roomdeck-f:") == 0) {
            push requests ("room:fold:" + roomOpen + ":" + (substring ctlTid 14 (strlen ctlTid)))
            return
        }
        if (ctlTid == "tb-roomdeck-newfolder") {
            push requests ("room:newfolder:" + roomOpen)
            return
        }
        if ((indexOf ctlTid "tb-roomdeck-d-") == 0) {
            dragDeck = (substring ctlTid 14 (strlen ctlTid))
            dragName = (this.roomDeckName(dragDeck))
            dragX0 = px
            dragY0 = py
            dragX = px
            dragY = py
            dragOn = false
            dropRoom = ""
            return
        }
        if (ctlTid == "tb-roomsearch") {
            this.roomSearchBegin()
            return
        }
        if (ctlTid == "tb-roomdeck-all") {
            push requests ("room:all:" + roomOpen)
            return
        }
        if (ctlTid == "tb-roomdeck-new") {
            push requests ("room:newin:" + roomOpen)
            return
        }
        ; the menu button opens and closes the drawer
        if (ctlTid == "tb-menu") {
            drawerOpen = (drawerOpen == false)
            this.closeSelects()
            this.rebuild()
            return
        }
        ; an open drawer: a press outside it closes it and does nothing else
        if (drawerOpen && ((inDrawer || isSel) == false)) {
            this.closeLists()
            return
        }
        ; a press outside an open list or menu closes it and does nothing else
        def selOpen:boolean ((sample.open || theme.open) || langSel.open)
        def menuOpen:boolean ((strlen (this.openMenu())) > 0)
        if ((selOpen && (isSel == false)) || (menuOpen && (isMenu == false))) {
            this.closeSelects()
            this.closeMenus()
            rev = (rev + 1)
            ; a press on another control of the bar does its thing as well (the
            ; menu closing first); one anywhere else only closes the menu
            if (((strlen ctlTid) == 0) || (py >= barH)) {
                return
            }
            menuOpen = false
        }
        if isMenu {
            def i:int 0
            while (i < (array_length menus)) {
                def m:MenuCtl (itemAt menus i)
                if (m.tid == ctlTid) {
                    ; another menu's trigger: the open one closes first
                    if ((m.open == false) && menuOpen) {
                        this.closeMenus()
                    }
                    ; the row chosen, read before the click closes the menu
                    def idx:int (m.rowIndexOf(tid))
                    def choice:string ""
                    if (idx >= 0) {
                        if (((itemAt m.rowIsSub idx) == false) && ((itemAt m.rowDisabled idx) == false)) {
                            def it:UiItem (itemAt m.rowItem idx)
                            choice = it.value
                        }
                    }
                    host.click(tid)
                    if ((strlen choice) > 0) {
                        if m.open {
                            m.closeMenu()
                        }
                        def req:string (PresToolbar.requestFor(choice))
                        if ((m.tid == "tb-m-ctx") && ((strlen ctxDeck) > 0)) {
                            req = (this.deckRequest(choice))
                        }
                        ; Rename: the name at the start of the bar as a field
                        if (req == "rename") {
                            this.titleBegin()
                        } {
                            push requests req
                        }
                    }
                }
                i = (i + 1)
            }
            this.syncContext()
            rev = (rev + 1)
            return
        }
        if (ctlTid == "tb-drawer") {
            host.click(tid)
            if (drawer.open == false) {
                drawerOpen = false
                this.rebuild()
            }
            return
        }
        if ((indexOf ctlTid "tb-dr-") == 0) {
            def dreq:string (PresToolbar.requestFor((substring ctlTid 6 (strlen ctlTid))))
            drawerOpen = false
            if (dreq == "rename") {
                this.titleBegin()
                return
            }
            push requests dreq
            this.rebuild()
            return
        }
        if isSel {
            def sel:SelectCtl sample
            if (ctlTid == theme.tid) {
                sel = theme
            }
            if (ctlTid == langSel.tid) {
                sel = langSel
            }
            ; another open list closes
            if (sample.open && (sel.tid != sample.tid)) {
                sample.closeList()
                sample.build()
            }
            if (theme.open && (sel.tid != theme.tid)) {
                theme.closeList()
                theme.build()
            }
            if (langSel.open && (sel.tid != langSel.tid)) {
                langSel.closeList()
                langSel.build()
            }
            def before:string sel.value
            host.click(tid)
            sel.build()
            if ((sel.value != before) && ((indexOf sel.value "--") != 0)) {
                def id:string (substring sel.tid 3 (strlen sel.tid))
                push requests ("select:" + id + ":" + sel.value)
                if (id == "sample") {
                    sampleValue = sel.value
                }
                if (id == "theme") {
                    themeValue = sel.value
                }
                if (id == "lang") {
                    langValue = sel.value
                }
            }
            rev = (rev + 1)
            return
        }
        if ((indexOf ctlTid "tb-") == 0) {
            push requests ("click:" + (substring ctlTid 3 (strlen ctlTid)))
        }
    }

    fn closeLists:void () {
        if titleEditing {
            titleEditing = false
            this.rebuild()
        }
        this.closeSelects()
        this.closeMenus()
        if drawerOpen {
            drawerOpen = false
            this.rebuild()
        }
        rev = (rev + 1)
    }

    fn closeSelects:void () {
        if sample.open {
            sample.closeList()
            sample.build()
        }
        if theme.open {
            theme.closeList()
            theme.build()
        }
        if langSel.open {
            langSel.closeList()
            langSel.build()
        }
        rev = (rev + 1)
    }

    ; The pointer over the bar or an open list: what it is over lights up.
    fn hoverAt:void (px:double py:double) {
        if (null? host.lastPage) {
            return
        }
        def tid:string ""
        if (this.has(px py)) {
            tid = (host.hitTest(px py))
        }
        if (tid != host.hoverTid) {
            if ((strlen tid) > 0) {
                host.hover(tid)
            } {
                host.unhover()
            }
            rev = (rev + 1)
        }
    }

    fn cursorAt:string (px:double py:double) {
        if (null? host.lastPage) {
            return ""
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return "default"
        }
        return "pointer"
    }
}
