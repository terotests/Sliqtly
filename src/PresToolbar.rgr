; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresToolbar.rgr — the app's top bar, in EVGUI controls on the canvas
; ============================================================================
;
; The bar the page used to draw in HTML — the presentation and the theme to
; pick, play and present, open / save / PDF / PPTX / share / help, the status
; — as EVGUI controls (SelectCtl, ButtonCtl) in a UiHost of its own, as
; big as the app, so a select's list opens over everything under it.
;
; The bar does not DO anything itself. A press is a request the page acts on
; the way it always has: a button is "click:<id>" (the page clicks the button
; of that id, kept but hidden), a choice is "select:<id>:<value>" (the page
; sets that select and says it changed). So opening a file, a download or a
; share keeps its user gesture, and the page's own logic stays where it is.
;
; What the selects offer comes from the page too: `setOptions(id, rows)`,
; one "value<TAB>label<TAB>group" row per line.
; ============================================================================

Import "../evgui/src/UiHost.rgr"
Import "PresI18n.rgr"

class PresToolbar {
    def host:UiHost (new UiHost())
    def css:string ""
    ; The editor's skin ("" or "retro"): a theme name added to this host's own.
    def skin:string ""
    ; the name at the start of the bar: the page's own (PresApp.setAppName)
    def brand:string "EVG Presentation"
    ; the page's own buttons after Ohje: "id<TAB>label<TAB>variant" rows
    ; (PresApp.setToolbarExtras); a press asks the page to click #id
    def extras:string ""
    def w:double 1200.0
    def h:double 700.0
    def barH:double 48.0
    def sample:SelectCtl (new SelectCtl())
    def theme:SelectCtl (new SelectCtl())
    ; the interface's language, after the page's own buttons (rows from the page)
    def langSel:SelectCtl (new SelectCtl())
    def langRows:string ""
    def langValue:string ""
    ; File and Help (a wide window), and the drawer the menu button opens
    ; (a narrow one, or a finger)
    ; File, Slide, Export and Help: dropdown menus (MenuCtl, which has
    ; submenus: Slide → Theme → the themes)
    def menus:[MenuCtl]
    def drawer:DrawerCtl (new DrawerCtl())
    def drawerOpen:boolean false
    ; the drawer's Theme row opened: the themes listed under it
    def drawerThemes:boolean false
    ; "value<TAB>label<TAB>group" rows, per select
    def sampleRows:string ""
    def themeRows:string ""
    def sampleValue:string ""
    def themeValue:string ""
    ; File → Recent: "<deck id>\t<name>" a line, the latest first
    def recentRows:string ""
    def playing:boolean false
    def status:string ""
    def requests:[string]
    def rev:int 0
    def measurer@(optional):TTFTextMeasurer
    ; a finger rather than a mouse: `@media (pointer: coarse)`
    def coarse:boolean false
    ; a Mac: the menus' keys read ⌘ rather than Ctrl
    def mac:boolean false
    ; the deck is taller than wide: Slide → Orientation ticks Portrait
    def portrait:boolean false
    ; slides picked on the strip: Export and the strip's menu offer them
    def picked:int 0
    ; The filmstrip's context menu (PresApp.openSlideMenu): open, where it
    ; was asked for, and which of its rows can act on the slide.
    def ctxOpen:boolean false
    def ctxX:double 0.0
    def ctxY:double 0.0
    def ctxLeft:boolean true
    def ctxRight:boolean true
    def ctxDelete:boolean true

    Constructor () {
    }

    fn setOptions:void (id:string rows:string current:string) {
        if (id == "sample") {
            sampleRows = rows
            sampleValue = current
        }
        if (id == "theme") {
            themeRows = rows
            themeValue = current
        }
        if (id == "recent") {
            recentRows = rows
        }
        if (id == "lang") {
            langRows = rows
            langValue = current
        }
        this.rebuild()
    }

    fn setExtras:void (rows:string) {
        if (rows != extras) {
            extras = rows
            this.rebuild()
        }
    }

    fn setState:void (isPlaying:boolean words:string) {
        if ((isPlaying != playing) || (words != status)) {
            playing = isPlaying
            status = words
            this.rebuild()
        }
    }

    ; --- building ---------------------------------------------------------------
    fn text:EVGElement (cls:string words:string) {
        def s (EVGElement.createSpan())
        s.className = cls
        s.textContent = words
        return s
    }

    fn div:EVGElement (cls:string) {
        def d (EVGElement.createDiv())
        d.className = cls
        return d
    }

    fn put:void (c:UiCtl parent:EVGElement) {
        push host.ctls c
        parent.addChild((unwrap c.rootEl))
    }

    fn button:ButtonCtl (id:string name:string variant:string parent:EVGElement) {
        def c (new ButtonCtl())
        c.tid = ("tb-" + id)
        c.name = name
        c.variant = variant
        c.build()
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r ("tb-button tb-b-" + id))
        if (variant == "accent") {
            UiTree.addClass(r "tb-accent")
        }
        ; a row of the drawer: full width, its label at the start
        if ((indexOf id "dr-") == 0) {
            UiTree.addClass(r "tb-drb")
        }
        if (((variant == "primary") || (variant == "accent")) && ((r.getChildCount()) > 0)) {
            UiTree.addClass((r.getChild(0)) "tb-onprimary")
        }
        this.put(c parent)
        return c
    }

    ; A select from its rows: a group starts with a disabled heading.
    fn select:SelectCtl (id:string name:string rows:string current:string parent:EVGElement) {
        def c (new SelectCtl())
        c.tid = ("tb-" + id)
        c.name = name
        def lines:[string] (strsplit rows (strfromcode 10))
        def group:string ""
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def g:string ""
                if ((array_length parts) >= 3) {
                    g = (itemAt parts 2)
                }
                if ((g != group) && ((strlen g) > 0)) {
                    c.addItem(("--" + g) g true)
                }
                group = g
                c.addItem((itemAt parts 0) (itemAt parts 1) false)
            }
            i = (i + 1)
        }
        c.value = current
        c.build()
        def sr:EVGElement (unwrap c.rootEl)
        UiTree.addClass(sr ("tb-select tb-select-" + id))
        ; the trigger has a class of its own, for its width per select
        if ((sr.getChildCount()) > 0) {
            UiTree.addClass((sr.getChild(0)) ("tb-trig-" + id))
        }
        this.put(c parent)
        return c
    }

    ; A narrow window or a finger: the bar keeps the menu button, the name,
    ; Present and the page's own buttons; the rest is in the drawer.
    fn compact:boolean () {
        return ((w < 980.0) || coarse)
    }

    ; What a menu's or the drawer's row asks of the page: a sample
    ; ("s-<key>") and a theme ("t-<key>") are the page's selects changed,
    ; "css" opens the theme's CSS tab, "new" a new deck, "duplicate" a copy
    ; of this one, the rest the page's button of that id.
    sfn requestFor:string (id:string) {
        if ((id == "new") || (id == "newPres")) {
            return "files:new"
        }
        if (id == "newSheet") {
            return "files:newsheet"
        }
        if (id == "duplicate") {
            return "files:duplicate"
        }
        if (id == "deleteDeck") {
            return "files:deletedeck"
        }
        ; File → Export's rows: the page's own export buttons
        if ((indexOf id "x-") == 0) {
            return ("click:" + (substring id 2 (strlen id)))
        }
        if (id == "css") {
            return "showtab:css"
        }
        if (id == "slideNew") {
            return "slide:new"
        }
        if (id == "slideDuplicate") {
            return "slide:duplicate"
        }
        if (id == "slideDelete") {
            return "slide:delete"
        }
        if (id == "slideLeft") {
            return "slide:left"
        }
        if (id == "slideRight") {
            return "slide:right"
        }
        if ((indexOf id "o-") == 0) {
            return ("slide:" + (substring id 2 (strlen id)))
        }
        if (id == "openbox") {
            return "openbox"
        }
        if (id == "settings") {
            return "settings"
        }
        if (id == "about") {
            return "about"
        }
        if (id == "docset") {
            return "docset"
        }
        if ((id == "browse") || (id == "decks")) {
            return "decks"
        }
        if ((indexOf id "r-") == 0) {
            return ("files:doc:" + (substring id 2 (strlen id)))
        }
        if ((indexOf id "s-") == 0) {
            return ("select:sample:" + (substring id 2 (strlen id)))
        }
        if ((indexOf id "t-") == 0) {
            return ("select:theme:" + (substring id 2 (strlen id)))
        }
        return ("click:" + id)
    }

    ; A menu of the bar: a trigger with the menu's name, rows added after.
    fn dropdown:MenuCtl (id:string name:string) {
        def m (new MenuCtl())
        m.tid = ("tb-m-" + id)
        m.name = name
        push menus m
        return m
    }

    ; A select's rows as a submenu's rows: a group's name a heading
    ; (disabled), the current one ticked.
    fn subRows:void (parent:UiItem prefix:string rows:string current:string) {
        def lines:[string] (strsplit rows (strfromcode 10))
        def group:string ""
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def g:string ""
                if ((array_length parts) >= 3) {
                    g = (itemAt parts 2)
                }
                if ((g != group) && ((strlen g) > 0)) {
                    MenuCtl.addKid(parent ((("h-" + prefix) + "-") + g) g true)
                }
                group = g
                def v:string (itemAt parts 0)
                def mark:string "    "
                if (v == current) {
                    mark = "✓  "
                }
                MenuCtl.addKid(parent (prefix + v) (mark + (itemAt parts 1)) false)
            }
            i = (i + 1)
        }
    }

    ; A chord with the platform's command key: ⌘ on a Mac, Ctrl elsewhere,
    ; in aria-keyshortcuts form ("Meta+D", "Control+D").
    fn modKey:string (key:string) {
        if mac {
            return ("Meta+" + key)
        }
        return ("Control+" + key)
    }

    ; Orientation's two rows, the deck's one ticked.
    fn orientationKids:void (parent:UiItem) {
        def lm:string "✓  "
        def pm:string "    "
        if portrait {
            lm = "    "
            pm = "✓  "
        }
        MenuCtl.addKid(parent "o-landscape" (lm + (PresI18n.t("Landscape"))) false)
        MenuCtl.addKid(parent "o-portrait" (pm + (PresI18n.t("Portrait"))) false)
    }

    ; Export's rows: the Markdown, PowerPoint, Word, a web page, PDF, and a
    ; zip of every file.
    fn exportKids:void (parent:UiItem) {
        MenuCtl.addKid(parent "x-save" (PresI18n.t("Markdown (.md)")) false)
        MenuCtl.addKid(parent "x-pptx" (PresI18n.t("PowerPoint (.pptx)")) false)
        MenuCtl.addKid(parent "x-docx" (PresI18n.t("Word (.docx)")) false)
        MenuCtl.addKid(parent "x-html" (PresI18n.t("Web page (.html)")) false)
        MenuCtl.addKid(parent "x-pdf" (PresI18n.t("PDF (.pdf)")) false)
        MenuCtl.addKid(parent "x-zip" (PresI18n.t("All files (.zip)")) false)
        if (picked > 0) {
            MenuCtl.addKidSeparator(parent)
            MenuCtl.addKid(parent "x-pptxPicked" (this.pickedLabel("PowerPoint (.pptx)")) false)
            MenuCtl.addKid(parent "x-docxPicked" (this.pickedLabel("Word (.docx)")) false)
            MenuCtl.addKid(parent "x-htmlPicked" (this.pickedLabel("Web page (.html)")) false)
            MenuCtl.addKid(parent "x-pdfPicked" (this.pickedLabel("PDF (.pdf)")) false)
        }
    }

    ; "PDF (.pdf) – 3 selected slides"
    fn pickedLabel:string (format:string) {
        def what:string (PresI18n.t("selected slides"))
        if (picked == 1) {
            what = (PresI18n.t("selected slide"))
        }
        return ((PresI18n.t(format)) + " – " + (to_string picked) + " " + what)
    }

    ; Recent's rows: every deck first (the Files tab), then the latest ones.
    fn recentKids:void (parent:UiItem) {
        MenuCtl.addKid(parent "browse" (PresI18n.t("All presentations…")) false)
        def lines:[string] (strsplit recentRows (strfromcode 10))
        def first:boolean true
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                if first {
                    MenuCtl.addKidSeparator(parent)
                    first = false
                }
                MenuCtl.addKid(parent ("r-" + (itemAt parts 0)) (itemAt parts 1) false)
            }
            i = (i + 1)
        }
    }

    ; The open menu, if any.
    fn openMenu:string () {
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if m.open {
                return m.tid
            }
            i = (i + 1)
        }
        return ""
    }

    ; The clock, for a submenu the pointer rests on: it opens once MenuCtl's
    ; delay has passed, as a browser's menu does. Only while one is waiting.
    fn tick:void (dtMs:double) {
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if ((strlen m.pendingTid) > 0) {
                host.tick(dtMs)
                if ((strlen m.pendingTid) == 0) {
                    rev = (rev + 1)
                }
                return
            }
            i = (i + 1)
        }
    }

    fn closeMenus:void () {
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if m.open {
                m.closeMenu()
            }
            i = (i + 1)
        }
        ctxOpen = false
    }

    ; The filmstrip's context menu at x, y (another open menu or list closes).
    fn openContext:void (x:double y:double canLeft:boolean canRight:boolean canDelete:boolean) {
        this.closeSelects()
        this.closeMenus()
        drawerOpen = false
        ctxX = x
        ctxY = y
        ctxLeft = canLeft
        ctxRight = canRight
        ctxDelete = canDelete
        ctxOpen = true
        this.rebuild()
    }

    ; The context menu as rows: the Slide menu's, with Move left and right.
    ; Its trigger is an empty point where it was asked for, so the menu opens
    ; there (or above it, where the window ends).
    fn contextMenu:void (root:EVGElement keepActive:string) {
        def cm (new MenuCtl())
        cm.tid = "tb-m-ctx"
        cm.name = (PresI18n.t("Slide"))
        cm.contextMode = true
        cm.addItem("slideNew" (PresI18n.t("New slide")) false)
        cm.addItem("slideDuplicate" (PresI18n.t("Duplicate slide")) false)
        cm.addSeparator()
        cm.addItem("slideLeft" (PresI18n.t("Move left")) (ctxLeft == false))
        cm.addItem("slideRight" (PresI18n.t("Move right")) (ctxRight == false))
        cm.addSeparator()
        cm.addItem("slideDelete" (PresI18n.t("Delete slide")) (ctxDelete == false))
        if (picked > 0) {
            cm.addSeparator()
            cm.addItem("x-pptxPicked" (this.pickedLabel("PowerPoint (.pptx)")) false)
            cm.addItem("x-docxPicked" (this.pickedLabel("Word (.docx)")) false)
            cm.addItem("x-htmlPicked" (this.pickedLabel("Web page (.html)")) false)
            cm.addItem("x-pdfPicked" (this.pickedLabel("PDF (.pdf)")) false)
            cm.addItem("x-share" (PresI18n.t("Share selected slides…")) false)
        }
        cm.setShortcut("slideNew" "Control+M")
        cm.setShortcut("slideDuplicate" (this.modKey("D")))
        cm.setShortcut("slideLeft" (this.modKey("ArrowLeft")))
        cm.setShortcut("slideRight" (this.modKey("ArrowRight")))
        cm.setShortcut("slideDelete" "Delete")
        cm.openMenu()
        cm.activeTid = keepActive
        cm.build()
        def r:EVGElement (unwrap cm.rootEl)
        r.setAttribute("position" "absolute")
        r.setAttribute("left" ((EVGDisplayList.num(ctxX)) + "px"))
        r.setAttribute("top" ((EVGDisplayList.num(ctxY)) + "px"))
        push menus cm
        this.put(cm root)
    }

    ; The context menu closed itself (a row chosen, Esc): it is not drawn again.
    fn syncContext:void () {
        if (ctxOpen == false) {
            return
        }
        def i:int 0
        while (i < (array_length menus)) {
            def m:MenuCtl (itemAt menus i)
            if ((m.tid == "tb-m-ctx") && m.open) {
                return
            }
            i = (i + 1)
        }
        ctxOpen = false
        rev = (rev + 1)
    }

    ; A select's rows as the drawer's rows, the current one ticked.
    fn drawerRows:void (body:EVGElement prefix:string rows:string current:string) {
        def lines:[string] (strsplit rows (strfromcode 10))
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                def v:string (itemAt parts 0)
                def mark:string "    "
                if (v == current) {
                    mark = "✓  "
                }
                def rb:ButtonCtl (this.button((("dr-" + prefix) + v) (mark + (itemAt parts 1)) "ghost" body))
                UiTree.addClass((unwrap rb.rootEl) "tb-drsub")
            }
            i = (i + 1)
        }
    }

    ; The page's own buttons (PresApp.setToolbarExtras), in order.
    fn extraButtons:void (parent:EVGElement) {
        def rows:[string] (strsplit extras (strfromcode 10))
        def k:int 0
        while (k < (array_length rows)) {
            def parts:[string] (strsplit (itemAt rows k) (strfromcode 9))
            if ((array_length parts) >= 3) {
                this.button((itemAt parts 0) (itemAt parts 1) (itemAt parts 2) parent)
            }
            k = (k + 1)
        }
    }

    fn rebuild:void () {
        def keepSample:boolean sample.open
        def keepTheme:boolean theme.open
        def keepLang:boolean langSel.open
        ; the menu open, and its open submenus, carried over the rebuild
        def keepMenu:string ""
        def keepPath:[string]
        def keepCtx:string ""
        def mi:int 0
        while (mi < (array_length menus)) {
            def om:MenuCtl (itemAt menus mi)
            if om.open {
                if (om.tid == "tb-m-ctx") {
                    keepCtx = om.activeTid
                } {
                    keepMenu = om.tid
                    keepPath = om.openPath
                }
            }
            mi = (mi + 1)
        }
        def noMenus:[MenuCtl]
        menus = noMenus
        def fresh (new UiHost())
        host = fresh
        host.addStyleSheet(css)
        host.setTheme((trim ("tb " + skin)))
        host.setPageSize(w h)
        def root:EVGElement (unwrap host.root)
        root.className = "ui-root tb-page"
        def bar:EVGElement (this.div("tb-bar"))
        def play:string (PresI18n.t("▶ Play"))
        if playing {
            play = (PresI18n.t("⏸ Pause"))
        }
        def small:boolean (this.compact())
        if small {
            this.button("menu" "☰" "ghost" bar)
            bar.addChild((this.text("tb-brand" brand)))
            bar.addChild((this.div("tb-grow")))
            this.button("present" (PresI18n.t("⛶ Present")) "primary" bar)
            this.extraButtons(bar)
        } {
            bar.addChild((this.text("tb-brand" brand)))
            def file:MenuCtl (this.dropdown("file" (PresI18n.t("File"))))
            ; groups as in a desktop app: new | open | save and export | the
            ; assistants | settings | delete, red and last
            ; New ▸ a presentation (the window) or a datasheet (the spreadsheet
            ; editor, its workbook kept in the deck's data/)
            def nw:UiItem (file.addSub("new" (PresI18n.t("New")) false))
            MenuCtl.addKid(nw "newPres" (PresI18n.t("Presentation…")) false)
            MenuCtl.addKid(nw "newSheet" (PresI18n.t("Datasheet…")) false)
            file.addItem("duplicate" (PresI18n.t("Duplicate")) false)
            file.addSeparator()
            file.addItem("openbox" (PresI18n.t("Open…")) false)
            file.addItem("decks" (PresI18n.t("Presentations…")) false)
            def rc:UiItem (file.addSub("recent" (PresI18n.t("Recent")) false))
            this.recentKids(rc)
            file.addSeparator()
            file.addItem("save" (PresI18n.t("Save .md")) false)
            def xs:UiItem (file.addSub("export" (PresI18n.t("Export")) false))
            this.exportKids(xs)
            file.addItem("history" (PresI18n.t("Version history…")) false)
            file.addSeparator()
            file.addItem("aiClaude" (PresI18n.t("Edit in Claude…")) false)
            file.addSeparator()
            file.addItem("docset" (PresI18n.t("Document settings…")) false)
            file.addItem("settings" (PresI18n.t("Settings…")) false)
            file.addSeparator()
            file.addItem("deleteDeck" (PresI18n.t("Delete presentation…")) false)
            file.setVariant("deleteDeck" "destructive")
            file.setShortcut("openbox" (this.modKey("O")))
            file.setShortcut("save" (this.modKey("S")))
            def slide:MenuCtl (this.dropdown("slide" (PresI18n.t("Slide"))))
            slide.addItem("slideNew" (PresI18n.t("New slide")) false)
            slide.addItem("slideDuplicate" (PresI18n.t("Duplicate slide")) false)
            slide.addItem("slideDelete" (PresI18n.t("Delete slide")) false)
            slide.setShortcut("slideNew" "Control+M")
            slide.setShortcut("slideDuplicate" (this.modKey("D")))
            slide.addSeparator()
            def ori:UiItem (slide.addSub("orientation" (PresI18n.t("Orientation")) false))
            this.orientationKids(ori)
            slide.addSeparator()
            def th:UiItem (slide.addSub("theme" (PresI18n.t("Theme")) false))
            this.subRows(th "t-" themeRows themeValue)
            slide.addSeparator()
            slide.addItem("css" (PresI18n.t("Edit theme CSS…")) false)
            def ex:MenuCtl (this.dropdown("export" (PresI18n.t("Export"))))
            ex.addItem("x-save" (PresI18n.t("Markdown (.md)")) false)
            ex.addItem("pptx" (PresI18n.t("PowerPoint (.pptx)")) false)
            ex.addItem("docx" (PresI18n.t("Word (.docx)")) false)
            ex.addItem("html" (PresI18n.t("Web page (.html)")) false)
            ex.addItem("pdf" (PresI18n.t("PDF (.pdf)")) false)
            ex.addItem("zip" (PresI18n.t("All files (.zip)")) false)
            def hp:MenuCtl (this.dropdown("help" (PresI18n.t("Help"))))
            hp.addItem("helpBtn" (PresI18n.t("Help for this slide")) false)
            hp.addSeparator()
            hp.addItem("about" (PresI18n.t("About")) false)

            def k:int 0
            while (k < (array_length menus)) {
                def m:MenuCtl (itemAt menus k)
                if (m.tid == keepMenu) {
                    m.open = true
                    m.openPath = keepPath
                }
                m.build()
                this.put(m bar)
                k = (k + 1)
            }
            bar.addChild((this.div("tb-sep")))
            this.button("play" play "outline" bar)
            this.button("present" (PresI18n.t("⛶ Present")) "primary" bar)
            this.button("share" (PresI18n.t("Share")) "secondary" bar)
            bar.addChild((this.div("tb-grow")))
            bar.addChild((this.text("tb-status" status)))
            this.extraButtons(bar)
            if ((strlen langRows) > 0) {
                langSel = (this.select("lang" (PresI18n.t("Language")) langRows langValue bar))
            }
        }
        root.addChild(bar)
        if ctxOpen {
            this.contextMenu(root keepCtx)
        }

        ; the drawer: everything the narrow bar leaves out, as a list
        def dr (new DrawerCtl())
        dr.tid = "tb-drawer"
        dr.side = "left"
        dr.title = brand
        dr.closeLabel = (PresI18n.t("Close"))
        def dw:double 300.0
        if (dw > (w - 24.0)) {
            dw = (w - 24.0)
        }
        dr.width = dw
        dr.top = barH
        dr.panelHeight = (h - barH)
        dr.durationMs = 0.0
        def showDrawer:boolean (drawerOpen && small)
        if showDrawer {
            dr.open = true
            dr.progress = 1.0
        }
        dr.build()
        drawer = dr
        push host.ctls dr
        root.addChild((unwrap dr.rootEl))
        if showDrawer {
            def body:EVGElement (dr.body())
            this.button("dr-play" play "ghost" body)
            this.button("dr-share" (PresI18n.t("Share")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("File")))))
            this.button("dr-new" (PresI18n.t("New presentation")) "ghost" body)
            this.button("dr-newSheet" (PresI18n.t("New datasheet")) "ghost" body)
            this.button("dr-duplicate" (PresI18n.t("Duplicate")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-openbox" (PresI18n.t("Open…")) "ghost" body)
            this.button("dr-decks" (PresI18n.t("Presentations…")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-save" (PresI18n.t("Save .md")) "ghost" body)
            this.button("dr-history" (PresI18n.t("Version history…")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-aiClaude" (PresI18n.t("Edit in Claude…")) "ghost" body)
            this.button("dr-settings" (PresI18n.t("Settings…")) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            def del:ButtonCtl (this.button("dr-deleteDeck" (PresI18n.t("Delete presentation…")) "ghost" body))
            def delEl:EVGElement (unwrap del.rootEl)
            if ((delEl.getChildCount()) > 0) {
                UiTree.addClass((delEl.getChild(0)) "tb-danger")
            }
            body.addChild((this.div("tb-dr-sep")))
            def arrow:string "▸  "
            if drawerThemes {
                arrow = "▾  "
            }
            this.button("dr-slideNew" (PresI18n.t("New slide")) "ghost" body)
            this.button("dr-slideDuplicate" (PresI18n.t("Duplicate slide")) "ghost" body)
            this.button("dr-slideDelete" (PresI18n.t("Delete slide")) "ghost" body)
            def otherWay:string "o-portrait"
            def otherName:string (PresI18n.t("Portrait"))
            if portrait {
                otherWay = "o-landscape"
                otherName = (PresI18n.t("Landscape"))
            }
            this.button(("dr-" + otherWay) (((PresI18n.t("Orientation")) + ": ") + otherName) "ghost" body)
            body.addChild((this.div("tb-dr-sep")))
            this.button("dr-themes" (arrow + (PresI18n.t("Theme"))) "ghost" body)
            if drawerThemes {
                this.drawerRows(body "t-" themeRows themeValue)
            }
            this.button("dr-css" (PresI18n.t("Edit theme CSS…")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Export")))))
            this.button("dr-x-save" (PresI18n.t("Markdown (.md)")) "ghost" body)
            this.button("dr-pptx" (PresI18n.t("PowerPoint (.pptx)")) "ghost" body)
            this.button("dr-docx" (PresI18n.t("Word (.docx)")) "ghost" body)
            this.button("dr-html" (PresI18n.t("Web page (.html)")) "ghost" body)
            this.button("dr-pdf" (PresI18n.t("PDF (.pdf)")) "ghost" body)
            this.button("dr-zip" (PresI18n.t("All files (.zip)")) "ghost" body)
            body.addChild((this.text("tb-dr-label" (PresI18n.t("Help")))))
            this.button("dr-helpBtn" (PresI18n.t("Help for this slide")) "ghost" body)
            this.button("dr-about" (PresI18n.t("About")) "ghost" body)
            if ((strlen langRows) > 0) {
                body.addChild((this.text("tb-dr-label" (PresI18n.t("Language")))))
                langSel = (this.select("lang" (PresI18n.t("Language")) langRows langValue body))
            }
        }
        if keepSample {
            sample.openList()
            sample.build()
        }
        if keepTheme {
            theme.openList()
            theme.build()
        }
        if keepLang {
            langSel.openList()
            langSel.build()
        }
        rev = (rev + 1)
    }

    ; --- the assistants' marks ------------------------------------------------------
    ; Claude's mark before "Edit in Claude…", in the File menu and in the
    ; drawer. MenuCtl draws a row as
    ; its text alone and builds its rows again whenever the menu changes, so
    ; the marks are put in on each drawing: the row's text becomes a mark and
    ; a label beside it, as MenuCtl's own sub-trigger rows are.
    ; Path: Simple Icons (CC0).
    sfn markFor:string (id:string) {
        if ((id == "tb-m-file-item-aiClaude") || (id == "tb-dr-aiClaude")) {
            return "claude"
        }
        return ""
    }

    sfn markPath:string (mark:string) {
        if (mark == "claude") {
            return "m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z"
        }
        return ""
    }

    sfn markEl:EVGElement (mark:string) {
        def m (EVGElement.createDiv())
        m.className = ("tb-mark tb-mark-" + mark)
        m.tagName = "path"
        m.elementType = 3
        m.viewBox = "0 0 24 24"
        m.svgPath = (PresToolbar.markPath(mark))
        m.a11yHidden = true
        return m
    }

    fn addMarks:void (el:EVGElement) {
        def mark:string (PresToolbar.markFor(el.id))
        if ((strlen mark) > 0) {
            ; a menu row: its text, made a mark and a label
            if (el.elementType == 1) {
                def words:string el.textContent
                UiTree.clearChildren(el)
                el.textContent = ""
                el.elementType = 0
                UiTree.addClass(el "tb-marked")
                el.addChild((PresToolbar.markEl(mark)))
                el.addChild((UiTree.label("" "ui-dropdownmenu-item-label" words)))
                return
            }
            ; a drawer button: the mark before its label
            if ((el.getChildCount()) == 1) {
                UiTree.addClass(el "tb-marked")
                def lbl:EVGElement (el.getChild(0))
                UiTree.clearChildren(el)
                el.addChild((PresToolbar.markEl(mark)))
                el.addChild(lbl)
                return
            }
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.addMarks((el.getChild(i)))
            i = (i + 1)
        }
    }

    ; --- drawing ------------------------------------------------------------------
    fn page:EVGElement () {
        def r:EVGElement (unwrap host.root)
        this.addMarks(r)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h coarse)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        lay.layout(pg)
        ; a menu card as wide as its widest row (a submenu hangs off its row)
        if (UiHost.fitSurfaces(r lay)) {
            lay.layout(pg)
        }
        host.lastPage = pg
        return pg
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.page())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; --- the pointer --------------------------------------------------------------
    fn listOpen:boolean () {
        return (((sample.open || theme.open) || langSel.open) || (((strlen (this.openMenu())) > 0) || drawerOpen))
    }

    ; The bar, or anywhere while a list is open (a press outside closes it).
    fn has:boolean (px:double py:double) {
        return ((py < barH) || (this.listOpen()))
    }

    fn press:void (px:double py:double) {
        if (null? host.lastPage) {
            this.page()
        }
        def tid:string (host.hitTest(px py))
        def ctlTid:string ""
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            ctlTid = owner.tid
        }
        def isSel:boolean (((strlen ctlTid) > 0) && (((ctlTid == sample.tid) || (ctlTid == theme.tid)) || (ctlTid == langSel.tid)))
        def isMenu:boolean ((indexOf ctlTid "tb-m-") == 0)
        def inDrawer:boolean ((ctlTid == "tb-drawer") || ((indexOf ctlTid "tb-dr-") == 0))
        ; the menu button opens and closes the drawer
        if (ctlTid == "tb-menu") {
            drawerOpen = (drawerOpen == false)
            this.closeSelects()
            this.rebuild()
            return
        }
        ; an open drawer: a press outside it closes it and does nothing else
        if (drawerOpen && ((inDrawer || isSel) == false)) {
            this.closeLists()
            return
        }
        ; a press outside an open list or menu closes it and does nothing else
        def selOpen:boolean ((sample.open || theme.open) || langSel.open)
        def menuOpen:boolean ((strlen (this.openMenu())) > 0)
        if ((selOpen && (isSel == false)) || (menuOpen && (isMenu == false))) {
            this.closeSelects()
            this.closeMenus()
            rev = (rev + 1)
            ; a press on another control of the bar does its thing as well (the
            ; menu closing first); one anywhere else only closes the menu
            if (((strlen ctlTid) == 0) || (py >= barH)) {
                return
            }
            menuOpen = false
        }
        if isMenu {
            def i:int 0
            while (i < (array_length menus)) {
                def m:MenuCtl (itemAt menus i)
                if (m.tid == ctlTid) {
                    ; another menu's trigger: the open one closes first
                    if ((m.open == false) && menuOpen) {
                        this.closeMenus()
                    }
                    ; the row chosen, read before the click closes the menu
                    def idx:int (m.rowIndexOf(tid))
                    def choice:string ""
                    if (idx >= 0) {
                        if (((itemAt m.rowIsSub idx) == false) && ((itemAt m.rowDisabled idx) == false)) {
                            def it:UiItem (itemAt m.rowItem idx)
                            choice = it.value
                        }
                    }
                    host.click(tid)
                    if ((strlen choice) > 0) {
                        if m.open {
                            m.closeMenu()
                        }
                        push requests (PresToolbar.requestFor(choice))
                    }
                }
                i = (i + 1)
            }
            this.syncContext()
            rev = (rev + 1)
            return
        }
        if (ctlTid == "tb-drawer") {
            host.click(tid)
            if (drawer.open == false) {
                drawerOpen = false
                this.rebuild()
            }
            return
        }
        if (ctlTid == "tb-dr-themes") {
            drawerThemes = (drawerThemes == false)
            this.rebuild()
            return
        }
        if ((indexOf ctlTid "tb-dr-") == 0) {
            push requests (PresToolbar.requestFor((substring ctlTid 6 (strlen ctlTid))))
            drawerOpen = false
            this.rebuild()
            return
        }
        if isSel {
            def sel:SelectCtl sample
            if (ctlTid == theme.tid) {
                sel = theme
            }
            if (ctlTid == langSel.tid) {
                sel = langSel
            }
            ; another open list closes
            if (sample.open && (sel.tid != sample.tid)) {
                sample.closeList()
                sample.build()
            }
            if (theme.open && (sel.tid != theme.tid)) {
                theme.closeList()
                theme.build()
            }
            if (langSel.open && (sel.tid != langSel.tid)) {
                langSel.closeList()
                langSel.build()
            }
            def before:string sel.value
            host.click(tid)
            sel.build()
            if ((sel.value != before) && ((indexOf sel.value "--") != 0)) {
                def id:string (substring sel.tid 3 (strlen sel.tid))
                push requests ("select:" + id + ":" + sel.value)
                if (id == "sample") {
                    sampleValue = sel.value
                }
                if (id == "theme") {
                    themeValue = sel.value
                }
                if (id == "lang") {
                    langValue = sel.value
                }
            }
            rev = (rev + 1)
            return
        }
        if ((indexOf ctlTid "tb-") == 0) {
            push requests ("click:" + (substring ctlTid 3 (strlen ctlTid)))
        }
    }

    fn closeLists:void () {
        this.closeSelects()
        this.closeMenus()
        if drawerOpen {
            drawerOpen = false
            this.rebuild()
        }
        rev = (rev + 1)
    }

    fn closeSelects:void () {
        if sample.open {
            sample.closeList()
            sample.build()
        }
        if theme.open {
            theme.closeList()
            theme.build()
        }
        if langSel.open {
            langSel.closeList()
            langSel.build()
        }
        rev = (rev + 1)
    }

    ; The pointer over the bar or an open list: what it is over lights up.
    fn hoverAt:void (px:double py:double) {
        if (null? host.lastPage) {
            return
        }
        def tid:string ""
        if (this.has(px py)) {
            tid = (host.hitTest(px py))
        }
        if (tid != host.hoverTid) {
            if ((strlen tid) > 0) {
                host.hover(tid)
            } {
                host.unhover()
            }
            rev = (rev + 1)
        }
    }

    fn cursorAt:string (px:double py:double) {
        if (null? host.lastPage) {
            return ""
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return "default"
        }
        return "pointer"
    }
}
