; ============================================================================
; PresDocFlow.rgr — where each piece of the document view goes.
; ============================================================================
;
; The document view (PresDocView) reads a deck as one page that scrolls:
; the text laid out once as a continuous column, and the blocks only the
; stage can draw (a diagram, a chart, a list figure, a SmartArt) as they
; look on their slide. This file is the geometry of that page and nothing
; else, so it is checked without a layout or a painter:
;
;   items, in reading order ──► place() ──► y, height, scale of each
;
; A TEXT item keeps the room the continuous layout gave it and the gap it
; had to the item before it, so paragraphs and headings are spaced as the
; Markdown engine spaces them. A SHOT is as wide a share of the column as
; its block was of its slide (as in the Word and HTML exports) and as tall
; as that width makes it. NOTES are the speaker's notes under their slide.
; A shot the layout set text beside (a chart given `{width=62%}` with a
; list after it) is put in its slot, and that text beside it, at the same
; height from its top as in the layout: the page reads as the slide does.
; A new slide starts after a fixed gap, where the page draws a rule.
; ============================================================================

class PresDocItem {
    ; 0 text, 1 shot, 2 notes
    def kind:int 0
    ; the slide it is on
    def page:int 0
    ; the block's source range (its first character names it)
    def key:int 0
    def keyEnd:int 0
    ; TEXT: where the continuous layout put it; a SHOT: its slot there
    ; (both -1 when it had none)
    def top:double -1.0
    def bottom:double -1.0
    ; a SHOT: its rectangle's size on the slide. NOTES: their height
    def sw:double 0.0
    def sh:double 0.0
    ; a SHOT: its slot's left edge and width in the continuous layout (lw 0:
    ; none). Text the layout set beside the slot (MdLayout's float, a block
    ; given `{width=…}`) keeps its place there, so the shot takes the slot
    ; and not the middle of the column.
    def lx:double 0.0
    def lw:double 0.0
    ; --- placed ---
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    ; a SHOT's scale from slide units; TEXT: how far its boxes move down
    def scale:double 1.0
    def dy:double 0.0
    ; NOTES: which slide's notes, among the page's (PresDocView)
    def note:int -1
    ; the rectangle of its slide it shows (slide units; fw 0: none, as
    ; notes): a point on the slide and a point here map to each other
    def fx:double 0.0
    def fy:double 0.0
    def fw:double 0.0
    def fh:double 0.0

    Constructor () {
    }

    fn bottomEdge:double () {
        return (y + h)
    }
}

class PresDocFlow {
    def items:[PresDocItem]
    ; the page: its width, its margin, the text column inside it
    def width:double 720.0
    def margin:double 36.0
    ; the slides' width, which a shot's share of the column is taken from
    def pageW:double 960.0
    ; the room between two slides; the rule is drawn in its middle
    def slideGap:double 40.0
    ; the least room above a shot or notes
    def shotGap:double 10.0
    ; the page's height once placed
    def height:double 0.0
    ; where each slide starts (the first item's y), by slide; -1 for a slide
    ; with nothing on it
    def slideTops:[double]
    ; the rules between slides: their y, and the slide they open
    def ruleY:[double]
    def rulePage:[int]

    Constructor () {
    }

    fn add:PresDocItem (kind:int page:int key:int keyEnd:int) {
        def it (new PresDocItem())
        it.kind = kind
        it.page = page
        it.key = key
        it.keyEnd = keyEnd
        push items it
        return it
    }

    fn colX:double () {
        return margin
    }

    fn colW:double () {
        return (width - (margin * 2.0))
    }

    fn place:void (slides:int) {
        clear slideTops
        clear ruleY
        clear rulePage
        def s:int 0
        while (s < slides) {
            push slideTops -1.0
            s = (s + 1)
        }
        def cw:double (this.colW())
        def cursor:double margin
        def prevBottom:double -1.0
        def prevPage:int -1
        ; a shot with text beside it: its top in the layout and on the page,
        ; and its bottom in the layout (floatOn while text still goes beside)
        def floatOn:boolean false
        def floatTop:double 0.0
        def floatY:double 0.0
        def floatBottom:double 0.0
        def i:int 0
        while (i < (array_length items)) {
            def it:PresDocItem (itemAt items i)
            def newSlide:boolean (it.page != prevPage)
            def gap:double 0.0
            def beside:boolean false
            if floatOn {
                beside = (this.besideFloat(it prevPage floatBottom))
                floatOn = beside
            }
            if beside {
                it.x = (this.colX())
                it.w = cw
                it.y = (floatY + (it.top - floatTop))
                it.h = (it.bottom - it.top)
                it.dy = (it.y - it.top)
                it.scale = 1.0
                cursor = (PresDocFlow.maxD(cursor (it.bottomEdge())))
                prevBottom = (PresDocFlow.maxD(prevBottom it.bottom))
                i = (i + 1)
                continue
            }
            if (newSlide && (prevPage >= 0)) {
                push ruleY (cursor + (slideGap * 0.5))
                push rulePage it.page
                cursor = (cursor + slideGap)
            } {
                if (((prevBottom >= 0.0) && (it.top >= 0.0)) && (it.top > prevBottom)) {
                    gap = (it.top - prevBottom)
                }
            }
            if (it.kind == 0) {
                it.x = (this.colX())
                it.w = cw
                it.y = (cursor + gap)
                it.h = (it.bottom - it.top)
                if (it.h < 0.0) {
                    it.h = 0.0
                }
                it.dy = (it.y - it.top)
                it.scale = 1.0
            }
            if (it.kind == 1) {
                def share:double 1.0
                if (pageW > 0.0) {
                    share = (it.sw / pageW)
                }
                if (share > 1.0) {
                    share = 1.0
                }
                if (share < 0.25) {
                    share = 0.25
                }
                it.w = (cw * share)
                it.scale = 1.0
                if (it.sw > 0.0) {
                    it.scale = (it.w / it.sw)
                }
                it.x = ((this.colX()) + ((cw - it.w) * 0.5))
                def next:int (i + 1)
                if (((it.lw > 0.0) && (it.sw > 0.0)) && (next < (array_length items))) {
                    if (this.besideFloat((itemAt items next) it.page it.bottom)) {
                        it.w = (PresDocFlow.clampD(it.lw (cw * 0.25) cw))
                        it.x = (PresDocFlow.clampD(it.lx (this.colX()) ((this.colX()) + (cw - it.w))))
                        it.scale = (it.w / it.sw)
                        floatOn = true
                    }
                }
                it.h = (it.sh * it.scale)
                if ((gap < shotGap) && (newSlide == false)) {
                    gap = shotGap
                }
                it.y = (cursor + gap)
                floatTop = it.top
                floatY = it.y
                floatBottom = it.bottom
            }
            if (it.kind == 2) {
                it.x = (this.colX())
                it.w = cw
                it.h = it.sh
                it.y = (cursor + shotGap)
            }
            if (newSlide && ((it.page >= 0) && (it.page < slides))) {
                if ((itemAt slideTops it.page) < 0.0) {
                    set slideTops it.page it.y
                }
            }
            cursor = (it.bottomEdge())
            if (it.kind != 2) {
                prevBottom = it.bottom
            }
            prevPage = it.page
            i = (i + 1)
        }
        height = (cursor + margin)
    }

    ; Whether text item `it` is beside the shot before it on slide `page`,
    ; whose slot ends at `bottom` in the layout: the layout started it above
    ; that bottom, which it does only for text it set beside the slot.
    fn besideFloat:boolean (it:PresDocItem page:int bottom:double) {
        if ((it.kind != 0) || (it.page != page)) {
            return false
        }
        return ((it.top >= 0.0) && (it.top < (bottom - 0.5)))
    }

    sfn maxD:double (a:double b:double) {
        if (a > b) {
            return a
        }
        return b
    }

    ; The item at y on the page: the one it is in, else the nearest one
    ; above it (the gap under an item belongs to it), else the first.
    fn itemAt:int (y:double) {
        def best:int -1
        def i:int 0
        while (i < (array_length items)) {
            def it:PresDocItem (itemAt items i)
            if (it.y <= y) {
                best = i
            } {
                break
            }
            i = (i + 1)
        }
        if ((best < 0) && ((array_length items) > 0)) {
            best = 0
        }
        return best
    }

    ; The slide shown at y: the last one starting at or above it.
    fn pageAt:int (y:double) {
        def best:int 0
        def found:boolean false
        def s:int 0
        while (s < (array_length slideTops)) {
            def t:double (itemAt slideTops s)
            if (t >= 0.0) {
                if ((t <= y) || (found == false)) {
                    best = s
                    found = true
                }
                if (t > y) {
                    break
                }
            }
            s = (s + 1)
        }
        return best
    }

    ; A point of slide `page` (slide units) on the page: in the item that
    ; shows it (the smallest when several do), else in the nearest one of
    ; that slide; [] when nothing of the slide is on the page.
    fn toPage:[double] (page:int x:double y:double) {
        def out:[double]
        def best:int -1
        def bestD:double 0.0
        def bestA:double 0.0
        def i:int 0
        while (i < (array_length items)) {
            def it:PresDocItem (itemAt items i)
            if ((it.page == page) && ((it.fw > 0.0) && (it.fh > 0.0))) {
                def cx:double (PresDocFlow.clampD(x it.fx (it.fx + it.fw)))
                def cy:double (PresDocFlow.clampD(y it.fy (it.fy + it.fh)))
                def d:double (((cx - x) * (cx - x)) + ((cy - y) * (cy - y)))
                def a:double (it.fw * it.fh)
                if (((best < 0) || (d < bestD)) || ((d == bestD) && (a < bestA))) {
                    best = i
                    bestD = d
                    bestA = a
                }
            }
            i = (i + 1)
        }
        if (best < 0) {
            return out
        }
        def b:PresDocItem (itemAt items best)
        def u:double (((PresDocFlow.clampD(x b.fx (b.fx + b.fw))) - b.fx) / b.fw)
        def v:double (((PresDocFlow.clampD(y b.fy (b.fy + b.fh))) - b.fy) / b.fh)
        push out (b.x + (u * b.w))
        push out (b.y + (v * b.h))
        return out
    }

    ; A point of the page on its slide: [slide, x, y] (slide units), from
    ; the item there (notes, which show nothing of the slide, take the
    ; nearest item of their slide that does); [] when there is none.
    fn toSlide:[double] (x:double y:double) {
        def out:[double]
        def at:int (this.itemAt(y))
        if (at < 0) {
            return out
        }
        def hit:PresDocItem (itemAt items at)
        def page:int hit.page
        def best:int -1
        def bestD:double 0.0
        def i:int 0
        while (i < (array_length items)) {
            def it:PresDocItem (itemAt items i)
            if ((it.page == page) && ((it.fw > 0.0) && (it.fh > 0.0))) {
                def d:double 0.0
                if (y < it.y) {
                    d = (it.y - y)
                }
                if (y > (it.bottomEdge())) {
                    d = (y - (it.bottomEdge()))
                }
                if (i == at) {
                    d = -1.0
                }
                if ((best < 0) || (d < bestD)) {
                    best = i
                    bestD = d
                }
            }
            i = (i + 1)
        }
        if (best < 0) {
            return out
        }
        def b:PresDocItem (itemAt items best)
        def u:double 0.5
        def v:double 0.5
        if (b.w > 0.0) {
            u = (PresDocFlow.clampD(((x - b.x) / b.w) 0.0 1.0))
        }
        if (b.h > 0.0) {
            v = (PresDocFlow.clampD(((y - b.y) / b.h) 0.0 1.0))
        }
        push out (to_double page)
        push out (b.fx + (u * b.fw))
        push out (b.fy + (v * b.fh))
        return out
    }

    sfn clampD:double (v:double lo:double hi:double) {
        if (v > hi) {
            return hi
        }
        if (v < lo) {
            return lo
        }
        return v
    }

    ; Where slide p starts, or -1 when it has nothing on the page.
    ; The y of the block that starts at source offset `key`, -1 when no
    ; item is that block.
    fn yOfKey:double (key:int) {
        def i:int 0
        while (i < (array_length items)) {
            def it:PresDocItem (itemAt items i)
            if ((it.key == key) && (it.kind != 2)) {
                return it.y
            }
            i = (i + 1)
        }
        return -1.0
    }

    fn topOf:double (p:int) {
        if ((p < 0) || (p >= (array_length slideTops))) {
            return -1.0
        }
        return (itemAt slideTops p)
    }
}
