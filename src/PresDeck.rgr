; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresDeck.rgr — the markdown, laid out as slides, with what moves on them.
; ============================================================================
;
;   editor text ──► PresSource (lift ::: blocks) ──► MarkdownEdit (slides)
;                                                        │
;                   PresSlide[]  ◄── attributes, notes ──┤
;                        │                               │
;                        └──► PresTimeline ──► one EVGDisplayList per frame
;
; The layout is the markdown module's, unchanged: `layoutSlides` decides the
; breaks, `MdToEvg.paintBox` draws each box. What this file adds is WHICH
; boxes belong together on the timeline. A box knows the source offset it
; came from, and a `{.build}` list's items know their source ranges, so a box
; is given to the item whose range holds it. No second layout, no guessing
; from positions — except for a list marker, which carries its list's offset
; rather than its item's, and so goes with the item on its own line.
;
; Attributes this reads (all optional):
;
;   heading     {#id transition=fade|slide|zoom|morph|none seconds=0.6
;                duration=8 fx=starfield fx-density=1.6}
;   any block   {.build}           reveal in steps (a list: one per item)
;               {anim=fade|rise|fly|zoom seconds=0.5}
;   ![](drawings/a.ink)  a drawing made on the slide (PresSketch), over it
;   front matter  transition, seconds, fx, fx-*, step (seconds between
;                 build steps), hold (seconds after the last step)
; ============================================================================

Import "PresFonts.rgr"
Import "PresCssSupport.rgr"
Import "../markdown/web/markdown_web.rgr"
Import "PresSource.rgr"
Import "PresCodeLinks.rgr"
Import "FxLang.rgr"
Import "PresDiagram.rgr"
Import "PresChart.rgr"
Import "PresTable.rgr"
Import "PresSmartArt.rgr"
Import "PresFigma.rgr"
Import "PresSketch.rgr"
Import "PresStory.rgr"
Import "PresPuppet.rgr"
Import "PresPlay.rgr"
Import "PresPlayFiles.rgr"
Import "PresScript.rgr"
Import "Pres3DTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGStyleSheet.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class PresGroup {
    def slide:int 0
    ; 0 = arrives with the slide; 1.. = the build step that reveals it
    def step:int 0
    ; the source range whose boxes belong to it
    def start:int 0
    def end:int 0
    ; a code block's highlight step (MdBox.buildStep) when > 0: only the
    ; boxes of that step belong to it; the block's code comes with the slide
    def sub:int 0
    def anim:string "rise"
    def seconds:double 0.5
    ; seconds after the slide starts; set by PresTimeline
    def at:double 0.0
    ; a short label for the track: the first words
    def label:string ""
}

; A chart fence on a slide: its columns rise and its beam passes from when
; the group that reveals it arrives (or the slide does), and the slide is
; not held — at its end or at the next build step — before that is over.
class PresChartUse {
    def source:string ""
    def srcStart:int 0
    ; the block's own style: `{chart-style=neon}` or `{style=cartoon}`
    ; under the fence (a dressing or a look), "" for none
    def style:string ""
    ; seconds after the slide starts; set by PresTimeline (-1: not yet)
    def start:double -1.0
}

; A diagram fence on a slide, drawn by PresDiagram rather than as a picture.
class PresDiaUse {
    def diagram:PresDiagram (new PresDiagram())
    ; the fence's own text, which is what its layout box names
    def source:string ""
    def srcStart:int 0
    ; seconds after the slide starts; set by PresTimeline
    def start:double 0.0
    ; where it is drawn on the slide
    def bx:double 0.0
    def by:double 0.0
    def bw:double 0.0
    def bh:double 0.0

    ; The box it is painted in at wall-clock `now`: its own, or growing over
    ; the whole page (PresDiaFull). [x, y, w, h].
    ; For the view over the whole slide: the fence, and its diagram laid out
    ; again for the slide's shape (`PresDeck.bigOf`, built when first
    ; wanted). A wide strip over a whole slide grows only by the width; laid
    ; out for the slide it can use the height too.
    def fence:MdNode (new MdNode())
    def page:int 0
    def notation:string ""
    def classic:boolean false
    def big:PresDiagram (new PresDiagram())
    def bigTried:boolean false

    ; The diagram on screen: the big one while it is over the slide.
    fn active:PresDiagram (now:double) {
        def d:PresDiagram diagram
        if ((diagram.full.shown(now)) && big.ok) {
            d = big
        }
        return d
    }

    ; The time `active` is at: the big one is shown whole, its walk done.
    fn activeTime:double (t:double now:double) {
        if ((diagram.full.shown(now)) && big.ok) {
            return 1000000.0
        }
        return (t - start)
    }

    fn boxNow:[double] (now:double f:[double]) {
        return (diagram.full.boxAt(now bx by bw bh (itemAt f 0) (itemAt f 1) (itemAt f 2) (itemAt f 3)))
    }
}

; A drawing on a slide: its file, where its reference is written, and when
; it starts coming on (PresTimeline.plan).
class PresSketchUse {
    def path:string ""
    def srcStart:int 0
    def start:double 0.0
    def sketch:PresSketch (new PresSketch())
}

; A program on a slide (```app, PresPlay): which one, and where its fence is.
class PresPlayUse {
    ; the deck's name for it: its file and which use of that file it is
    ; ("apps/scaffold.tsx#1"), the same through edits of the deck
    def key:string ""
    def source:string ""
    def srcStart:int 0
    def page:int 0
    def spec:MdAppSpec (new MdAppSpec())

    Constructor () {
    }
}

class PresSlide {
    def index:int 0
    def id:string ""
    def title:string ""
    def transition:string "fade"
    def seconds:double 0.6
    def fx:string ""
    ; a picture behind this slide (`{bg=media/kansi.jpg}`), covering it, and
    ; how much of the paper is laid over it to keep the text readable
    ; (`{bg-dim=0.4}`)
    def bg:string ""
    def bgDim:double 0.0
    ; line art drawn behind the slide (`{art=waves}`, MdFigure.art) and the
    ; number that moves its curves (`{art-seed=3}`; the slide's own by
    ; default, so two slides with waves are not the same picture)
    def art:string ""
    def artSeed:int -1
    ; the art is the theme's (`deck { art: honeycomb }`): part of how the
    ; theme looks, drawn for everyone; art named in the document is PRO
    def artTheme:boolean false
    def fxNames:[string]
    def fxValues:[string]
    def notes:string ""
    def audio:string ""
    ; THE SLIDE'S OWN DATA, from the keys on its heading the engine does not
    ; know: `## Revenue {jira=ACME-412 owner=Tero}` (MdSlideMeta). Nothing
    ; draws it; it is read back per slide, `{jira}` in a header or a footer
    ; prints it, and an assistant can ask which slide carries a ticket.
    def meta:MdSlideMeta (new MdSlideMeta())
    ; the first and last source offsets laid out on this slide
    def srcStart:int -1
    def srcEnd:int -1
    ; seconds; set by PresTimeline
    def duration:double 0.0
    ; when everything on it has arrived (its builds, charts and diagram
    ; tours): the slide shown whole, before its hold
    def settled:double 0.0
    def wantDuration:double -1.0
    def stepGap:double 1.2
    def hold:double 2.5
    def groups:[PresGroup]
    def steps:int 0
    def diagrams:[PresDiaUse]
    def charts:[PresChartUse]
    def smartArts:[PresSmartArtUse]
    def sketches:[PresSketchUse]
    ; the presenter's lines (`::: story`), each a build step after the slide's own
    def story:[PresStoryBeat]
    def plays:[PresPlayUse]
    ; A program that drives this slide's own display list (`{script=
    ; apps/fx.tsx}` on its heading, PresScript): its file, what it may ask
    ; (`allow="slide.nav deck.data"`), the moment an export shows
    ; (`export-frame=3.5s`; -1: its final state), and whether it plays the
    ; slide's build steps itself (its `build(n)`), so the default rise and
    ; fade are left out
    def script:string ""
    def scriptAllow:[string]
    def exportFrame:double -1.0
    def scriptBuilds:boolean false

    Constructor () {
        def sal:[string]
        scriptAllow = sal
        def pu:[PresPlayUse]
        plays = pu
        def sau:[PresSmartArtUse]
        smartArts = sau
        def sku:[PresSketchUse]
        sketches = sku
        def du:[PresDiaUse]
        diagrams = du
        def cu:[PresChartUse]
        charts = cu
        def a:[string]
        fxNames = a
        def b:[string]
        fxValues = b
        def g:[PresGroup]
        groups = g
    }
}

class PresDeck {
    ; The engine: fonts, pictures, templates, the PDF and the PPTX.
    def md:MarkdownWeb (new MarkdownWeb())
    def src:PresSource (new PresSource())
    ; Which source files (code/) the diagrams' boxes are about: the deck's
    ; `::: code` blocks and Mermaid `click … "code:…"` lines, read on every
    ; rebuild (readCodeLinks).
    def codeLinks:PresCodeLinks (new PresCodeLinks())
    def slides:[PresSlide]
    def text:string ""
    ; moves on every rebuild, so a host can keep what it built from the last one
    def revision:int 0
    ; How many charts and figures drawn under old defaults one rebuild draws
    ; again (-1: all of them), and the source range drawn first whatever the
    ; count (the slide on the screen). A change to `chart { … }` used to draw
    ; every chart of the deck in the frame it was typed in; PresApp sets a
    ; few while editing and draws the rest in the frames after (`settle`).
    ; MdEmbedCache.redrawBudget.
    def redrawBudget:int -1
    def focusFrom:int -1
    def focusTo:int -1
    ; Only the charts and figures in view are drawn (MdEmbedCache.lazy): the
    ; focus, and viewFrom..viewTo (the thumbnails on screen). The rest are
    ; laid out with an estimate until they come into view. PresApp sets it;
    ; a deck made without it draws everything, as before.
    def lazy:boolean false
    def viewFrom:int -1
    def viewTo:int -1
    ; the host's wall clock, for the viewer's camera moves, and whether the
    ; list being built is the stage (controls drawn) or a thumbnail
    def uiNow:double 0.0
    def showControls:boolean false
    ; Painting for a page that does not move (the PDF): every diagram at
    ; rest, whole, rather than where its walk is at a moment.
    def still:boolean false
    ; The slides' line art is PRO: the page says whether it is drawn
    ; (`PresApp.setPro`). The layouts drawn from lists are free.
    def artAllowed:boolean false
    ; the theme's colours for them, as last read (`figureStyle`)
    def figStyle:MdFigureStyle (new MdFigureStyle)
    ; the deck's SmartArt files, by the path the picture store has them under
    ; (PresSmartArt), and the diagrams already laid out
    def smartArtPaths:[string]
    def smartArtCache:PresSmartArtCache (new PresSmartArtCache())
    ; Slides whose effect the host rendered to a picture for an export
    ; (`fxStillPath`); a still list draws the picture in place of the effect.
    def fxStills:[int]
    def pageW:double 960.0
    def pageH:double 540.0
    ; The front matter's `orientation` ("portrait", "landscape" or ""), and
    ; the page the deck has without it: whether it is tall, and turned on
    ; its side ("540x960pt"), for the stylesheet and `page:` it was measured
    ; with.
    def orientation:string ""
    def themeSizeOf:string ""
    def themeSizeTurned:string ""
    def themeTall:boolean false
    ; What the template says about the presentation beyond what markdown
    ; reads: `deck { fx: starfield; fx-hue: 280 }`, or the older comment
    ; `/* pres: fx=starfield fx-hue=280 */` anywhere in its CSS.
    def themeKeys:[string]
    def themeVals:[string]
    ; Diagrams by (notation, width, text): a keystroke elsewhere in the
    ; document must not lay every diagram out again.
    def diaKeys:[string]
    def diaVals:[PresDiagram]
    ; The faces the diagrams' looks draw with (comma-separated, for the page
    ; to load) and those it has loaded (handed to each diagram, which reads
    ; them as they arrive)
    def wantFaces:string ""
    ; The document's style (`style: cartoon` in its front matter): a look
    ; for every diagram and chart that does not name its own. `chart-style:`
    ; and `diagram-style:` say it for one kind only (`docChartStyle`,
    ; `docDiagramStyle`, which `style:` fills when they are not given).
    def docStyle:string ""
    ; the front matter's `lang:` (fi, sv, de…): how the charts write numbers
    def docLang:string ""
    def docChartStyle:string ""
    def docDiagramStyle:string ""
    ; The whole of a chart's cut words (an axis title too long even on two
    ; lines) under the pointer, shown in a tip over the slide: what, where
    ; (slide coordinates), on which slide; tipRev moves with every change and
    ; tipDrawn is the one painted, so a change asks for a frame.
    def tipText:string ""
    def tipX:double 0.0
    def tipY:double 0.0
    def tipSlide:int -1
    def tipRev:int 0
    def tipDrawn:int 0
    def haveFaces:[string:boolean]
    ; The deck's programs (```app): their pictures by key, kept across
    ; rebuilds so a running program is not started over by a keystroke; the
    ; looks they gave the slide's blocks (`el("#id")`); the values they set
    ; for `{key}` (`deck.set`); the one that has the keyboard ("" none); and
    ; what they asked that was refused.
    def playViews:[PresPlayView]
    def playStyle:PresPlayStyle (new PresPlayStyle())
    def liveKeys:[string]
    def liveVals:[string]
    def playFocus:string ""
    def playRefused:[string]
    ; the blocks that carry an id or a class, by source range, for the looks
    def tagStart:[int]
    def tagEnd:[int]
    def tagId:[string]
    def tagCls:[string]
    ; The slides' scripts (`{script=…}`, PresScript): their frames by key,
    ; kept across rebuilds like the programs' pictures
    def scriptRuns:[PresScriptRun]
    ; true: slideList draws the slide as the Markdown has it, whatever a
    ; script set (the tree a script is handed, the layout report)
    def scriptsOff:boolean false
    ; Every block node of the document with the source it spans and the
    ; block it is inside (-1 for the document), for what kind of thing a
    ; box of the layout is: what `find("li")` names
    def blkStart:[int]
    def blkEnd:[int]
    def blkKind:[string]
    def blkLevel:[int]
    def blkParent:[int]
    def blkId:[string]
    def blkCls:[string]
    def blkInfo:[string]
    ; Beside `boxOfCmd`: the part of its block each command was painted for
    ; (an index in `slideParts`: a chart's column, a diagram's node or
    ; line), -1 for none. A part's `parent` is the layout box it is in.
    def partOfCmd:[int]
    def slideParts:[PresEnt]
    ; the tree a script is handed, by slide, made once per revision
    def treeRev:int -1
    def treeJson:[string]

    Constructor () {
        def sr:[PresScriptRun]
        scriptRuns = sr
        def tj:[string]
        treeJson = tj
        def pv:[PresPlayView]
        playViews = pv
        def hf:[string:boolean]
        haveFaces = hf
        def s:[PresSlide]
        slides = s
        def tk:[string]
        themeKeys = tk
        def tv:[string]
        themeVals = tv
        def k:[string]
        diaKeys = k
        def v:[PresDiagram]
        diaVals = v
    }

    fn diagramFor:PresDiagram (notation:string text:string width:double look:string) {
        return (this.diagramAs(notation text width 0.0 look))
    }

    ; `aspect` > 0: the flow engine's column-wrapped layout for that room.
    ; `look`: the flow engine's look the scene is built in ("default", or
    ; "dark" for a classic drawing on a dark slide).
    fn diagramAs:PresDiagram (notation:string text:string width:double aspect:double look:string) {
        def key:string (notation + "|" + look + "|" + (to_string width) + "|" + (to_string aspect) + "|" + text)
        def i:int 0
        while (i < (array_length diaKeys)) {
            if ((itemAt diaKeys i) == key) {
                return (itemAt diaVals i)
            }
            i = (i + 1)
        }
        def d:PresDiagram (PresDiagram.wrapped(notation text width aspect look))
        push diaKeys key
        push diaVals d
        if ((array_length diaKeys) > 40) {
            remove_index diaKeys 0
            remove_index diaVals 0
        }
        return d
    }

    ; ------------------------------------------------------------------
    ; A diagram the viewer steers
    ; ------------------------------------------------------------------
    ; What a press at slide point (px, py) at slide time t means: "k:i" for
    ; option i of diagram k, "k:back", or "".
    fn diagramHit:string (i:int t:double px:double py:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return ""
        }
        def s:PresSlide (itemAt slides i)
        ; one over the whole slide covers the others
        def only:int (this.fullAt(i))
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            u.diagram.uiNow = uiNow
            def b:[double] (u.boxNow(uiNow (this.fullBoxNow())))
            def r:int -1
            if ((only < 0) || (only == k)) {
                def dd:PresDiagram (u.active(uiNow))
                dd.uiNow = uiNow
                r = (dd.hit((u.activeTime(t uiNow)) (itemAt b 0) (itemAt b 1) (itemAt b 2) (itemAt b 3) px py))
            }
            if (r == -12) {
                return ((to_string k) + ":full")
            }
            if (r == -2) {
                return ((to_string k) + ":back")
            }
            if (r == -3) {
                return ((to_string k) + ":zin")
            }
            if (r == -4) {
                return ((to_string k) + ":zout")
            }
            if (r == -5) {
                return ((to_string k) + ":fit")
            }
            if (r == -6) {
                return ((to_string k) + ":menu")
            }
            if (r == -7) {
                return ((to_string k) + ":restart")
            }
            if (r == -8) {
                return ((to_string k) + ":all")
            }
            if (r == -10) {
                return ((to_string k) + ":skip")
            }
            if (r == -11) {
                return ((to_string k) + ":tour")
            }
            if (r == -9) {
                return ((to_string k) + ":none")
            }
            if (r <= -1000) {
                return ((to_string k) + ":zoom" + (to_string (-1000 - r)))
            }
            if (r >= 3000) {
                return ((to_string k) + ":way" + (to_string (r - 3000)))
            }
            if (r >= 2000) {
                return ((to_string k) + ":way" + (to_string (r - 2000)))
            }
            if (r >= 1000) {
                return ((to_string k) + ":node" + (to_string (r - 1000)))
            }
            if (r >= 0) {
                return ((to_string k) + ":" + (to_string r))
            }
            k = (k + 1)
        }
        return ""
    }

    ; The charts (```vega-lite) laid out on slide i, as layout box indices.
    fn chartBoxes:[int] (i:int) {
        def out:[int]
        def l:MdLayout (this.layout())
        def k:int 0
        while (k < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes k)
            if (((b.page == i) && (b.kind == 3)) && ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(b.embedKind)))) == "vega")) {
                push out k
            }
            k = (k + 1)
        }
        return out
    }

    ; The table a laid-out box draws, if it is one.
    fn tableOf@(optional):PresTableUse (b:MdBox) {
        if (b.kind == 3) {
            def src0:string (trim b.embedSource)
            def i:int 0
            while (i < (array_length tables)) {
                def u:PresTableUse (itemAt tables i)
                if (u.key == src0) {
                    def hit@(optional):PresTableUse u
                    return hit
                }
                i = (i + 1)
            }
        }
        def miss@(optional):PresTableUse
        return miss
    }

    ; The live sheets (```sheet) laid out on slide i, in slide coordinates, as
    ; JSON for the page: it puts the workbook over each box while presenting.
    fn liveSheetsJson:string (i:int) {
        def l:MdLayout (this.layout())
        def out:string "["
        def first:boolean true
        def bi:int 0
        while (bi < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes bi)
            if (b.page == i) {
                def tu@(optional):PresTableUse (this.tableOf(b))
                if (!null? tu) {
                    def u:PresTableUse (unwrap tu)
                    if u.live {
                        if (first == false) {
                            out = (out + ",")
                        }
                        first = false
                        out = (out + "{\"key\":" + (EVGA11yTree.jsonString(u.key)))
                        out = (out + ",\"file\":" + (EVGA11yTree.jsonString(u.file)))
                        out = (out + ",\"sheet\":" + (EVGA11yTree.jsonString(u.sheet)))
                        out = (out + ",\"data\":" + (EVGA11yTree.jsonString(u.path)))
                        out = (out + ",\"box\":[" + (EVGDisplayList.num(b.x)) + "," + (EVGDisplayList.num(b.y)) + "," + (EVGDisplayList.num(b.w)) + "," + (EVGDisplayList.num(b.h)) + "]}")
                    }
                }
            }
            bi = (bi + 1)
        }
        return (out + "]")
    }

    ; Does slide i have a live sheet on it?
    fn hasLiveSheet:boolean (i:int) {
        return ((this.liveSheetsJson(i)) != "[]")
    }

    ; A press on slide i that turned a table's page.
    fn tablePress:boolean (i:int x:double y:double) {
        def k:int 0
        while (k < (array_length tables)) {
            def u:PresTableUse (itemAt tables k)
            if (u.slide == i) {
                def d:int (PresTable.hit(u x y))
                if (d != 0) {
                    def p:int (u.page + d)
                    if ((p >= 0) && (p < (u.pages()))) {
                        u.page = p
                    }
                    return true
                }
            }
            k = (k + 1)
        }
        return false
    }

    ; A chart as the stage shows it when it has finished, for an export.
    fn chartStill:EVGDisplayList (bi:int) {
        def l:MdLayout (this.layout())
        def b:MdBox (itemAt l.boxes bi)
        def dl (new EVGDisplayList())
        def tu@(optional):PresTableUse (this.tableOf(b))
        if (!null? tu) {
            def tb:PresTableUse (unwrap tu)
            PresTable.paint(dl tb b.x b.y b.w b.h tb.stillPage false l.style.textColor (this.themeColour("chart" "accent-color")) l)
            return dl
        }
        def painter (new MdToEvg())
        painter.paintBox(dl l b 0.0)
        this.dressChart(dl 0 1000000.0 true b.embedSource b.page)
        def ground:string (PresDeck.paperOn(l b.page))
        PresChart.flatten(dl 0 ground)
        return dl
    }

    ; Every diagram back on its own camera.
    ; Playing or presenting: questions offer a skip.
    def live:boolean false

    ; The seconds left before the waiting questions on slide i are skipped.
    fn setSkipLeft:void (i:int left:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if u.diagram.waiting {
                u.diagram.skipLeft = left
            }
            k = (k + 1)
        }
    }

    ; Let the questions on slide i go: the clock runs on past them.
    fn skipQuestions:void (i:int) {
        if ((i < 0) || (i >= (array_length slides))) {
            return
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if u.diagram.waiting {
                u.diagram.skipped = true
                u.diagram.skipLeft = -1.0
            }
            k = (k + 1)
        }
    }

    fn resetExplore:void () {
        def i:int 0
        while (i < (array_length slides)) {
            def s:PresSlide (itemAt slides i)
            def k:int 0
            while (k < (array_length s.diagrams)) {
                def u:PresDiaUse (itemAt s.diagrams k)
                u.diagram.resetExplore()
                k = (k + 1)
            }
            i = (i + 1)
        }
    }

    ; The first diagram on slide i with slide point (px, py) in its area, or -1.
    fn diagramAt:int (i:int px:double py:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return -1
        }
        def s:PresSlide (itemAt slides i)
        def only:int (this.fullAt(i))
        if (only >= 0) {
            return only
        }
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if ((((px >= u.bx) && (py >= u.by)) && (px <= (u.bx + u.bw))) && (py <= (u.by + u.bh))) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; Where the host's bar over the slide's foot starts, in slide units
    ; (-1: none): the view over the whole slide ends above it.
    def fullBottom:double -1.0

    fn fullBoxNow:[double] () {
        return (PresDiaFull.fullBox(pageW pageH fullBottom))
    }

    ; The diagram on slide i shown over the whole slide (opened, or still
    ; growing or shrinking), or -1.
    fn fullAt:int (i:int) {
        if ((i < 0) || (i >= (array_length slides))) {
            return -1
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if (u.diagram.full.shown(uiNow)) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; Diagram use u of slide s laid out for the whole slide's box, built the
    ; first time it is wanted: shown whole (no tour, no questions), sharing
    ; the small one's magnifier state. Not `ok` when it cannot be drawn.
    fn bigOf:PresDiagram (s:PresSlide u:PresDiaUse) {
        if (u.bigTried == false) {
            u.bigTried = true
            def fb:[double] (this.fullBoxNow())
            def b:PresDiagram (this.diagramIn(s u.fence u.page u.notation u.classic (itemAt fb 2) (itemAt fb 2) (itemAt fb 3) true))
            if b.ok {
                b.tour = false
                b.canTour = false
                b.choose = false
                b.plan()
                b.full = u.diagram.full
                b.canFull = true
                b.fitMax = 4.0
                u.big = b
            }
        }
        def out:PresDiagram u.big
        return out
    }

    ; How big diagram d's boxes draw in a box w x h (slide units).
    sfn drawnSize:double (d:PresDiagram w:double h:double) {
        return ((d.fitOf(w h)) * (d.boxSize()))
    }

    ; The magnifier of diagram k on slide i: over the whole slide, or back.
    fn toggleFull:void (i:int k:int) {
        def hit@(optional):PresDiaUse (this.diagramUse(i k))
        if (null? hit) {
            return
        }
        def u:PresDiaUse (unwrap hit)
        def s:PresSlide (itemAt slides i)
        this.bigOf(s u)
        u.diagram.full.toggle(uiNow)
        u.diagram.menuOpen = false
        u.diagram.zoomOpen = false
        if u.diagram.full.open {
            fullSlide = i
        }
    }

    ; Esc: a diagram open over slide i goes back to its place. True when one
    ; was open.
    fn closeFull:boolean (i:int) {
        def k:int (this.fullAt(i))
        if (k < 0) {
            return false
        }
        def s:PresSlide (itemAt slides i)
        def u:PresDiaUse (itemAt s.diagrams k)
        if (! u.diagram.full.open) {
            return false
        }
        u.diagram.full.setOpen(uiNow false)
        return true
    }

    ; The slide on screen is i: a diagram left open over another slide is
    ; back in its place when that slide shows again.
    def fullSlide:int -1
    fn showingSlide:void (i:int) {
        if ((fullSlide < 0) || (fullSlide == i)) {
            return
        }
        if (fullSlide < (array_length slides)) {
            def s:PresSlide (itemAt slides fullSlide)
            def k:int 0
            while (k < (array_length s.diagrams)) {
                def u:PresDiaUse (itemAt s.diagrams k)
                u.diagram.full.reset()
                k = (k + 1)
            }
        }
        fullSlide = -1
    }

    ; The pointer at slide point (px, py) on slide i, at slide time t: over
    ; diagram k (-1 none), whose buttons then show (PresControlsFade).
    fn diagramPointer:void (i:int k:int t:double px:double py:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return
        }
        def s:PresSlide (itemAt slides i)
        def j:int 0
        while (j < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams j)
            u.diagram.uiNow = uiNow
            def b:[double] (u.boxNow(uiNow (this.fullBoxNow())))
            def dd:PresDiagram (u.active(uiNow))
            dd.uiNow = uiNow
            dd.pointerAt((j == k) (u.activeTime(t uiNow)) (itemAt b 0) (itemAt b 1) (itemAt b 2) (itemAt b 3) px py)
            j = (j + 1)
        }
    }

    ; A finger on diagram k of slide i: its buttons come up for a while.
    fn diagramTouched:void (i:int k:int) {
        def hit@(optional):PresDiaUse (this.diagramUse(i k))
        if (!null? hit) {
            def u:PresDiaUse (unwrap hit)
            def dd:PresDiagram (u.active(uiNow))
            dd.ctl.press(uiNow)
        }
    }

    ; The pointer at (px, py) on slide i (or off it, px < -1e5): the tip with
    ; a chart's cut words when it is over them. True when the tip changed.
    fn chartPointer:boolean (i:int px:double py:double) {
        def text:string ""
        if ((i >= 0) && (i < (array_length slides))) {
            def l:MdLayout (this.layout())
            def bi:int 0
            while ((bi < (array_length l.boxes)) && ((strlen text) == 0)) {
                def b:MdBox (itemAt l.boxes bi)
                if (((b.page == i) && (b.kind == 3)) && ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(b.embedKind)))) == "vega")) {
                    ; a turned title stands just outside its box's left edge
                    if ((((px >= (b.x - 40.0)) && (px <= (b.x + b.w))) && (py >= b.y)) && (py <= (b.y + b.h))) {
                        text = (MdToEvg.cutTextAt(l b px py))
                    }
                }
                bi = (bi + 1)
            }
        }
        if ((strlen text) == 0) {
            if ((strlen tipText) == 0) {
                return false
            }
            tipText = ""
            tipRev = (tipRev + 1)
            return true
        }
        if (((text == tipText) && (tipSlide == i)) && (((fabs (px - tipX)) < 0.5) && ((fabs (py - tipY)) < 0.5))) {
            return false
        }
        tipText = text
        tipSlide = i
        tipX = px
        tipY = py
        tipRev = (tipRev + 1)
        return true
    }

    ; The tip: the words on a dark card above the pointer, kept on the page.
    fn paintTip:void (out:EVGDisplayList l:MdLayout) {
        def size:double 18.0
        def pad:double 8.0
        def tw:double (l.measureStyled(tipText "Open Sans" size false false))
        def w:double (tw + (pad * 2.0))
        def h:double ((size * 1.3) + (pad * 2.0))
        def x:double (tipX + 12.0)
        def y:double ((tipY - h) - 12.0)
        if ((x + w) > (pageW - 4.0)) {
            x = ((pageW - 4.0) - w)
        }
        if (x < 4.0) {
            x = 4.0
        }
        if (y < 4.0) {
            y = (tipY + 20.0)
        }
        def card (new EVGDrawCmd())
        card.kind = 0
        card.x = x
        card.y = y
        card.w = w
        card.h = h
        card.radius = 6.0
        card.r = 24
        card.g = 28
        card.b = 36
        card.a = 0.92
        card.hasShadow = true
        card.shadowY = 2.0
        card.shadowBlur = 8.0
        card.shadowA = 0.3
        push out.cmds card
        def t (new EVGDrawCmd())
        t.kind = 3
        t.x = (x + pad)
        t.y = (y + pad)
        t.w = tw
        t.h = (size * 1.3)
        t.text = tipText
        t.fontFamily = "Open Sans"
        t.fontSize = size
        t.r = 255
        t.g = 255
        t.b = 255
        t.a = 1.0
        push out.cmds t
    }

    fn uiBusy:boolean (i:int) {
        if (tipRev != tipDrawn) {
            return true
        }
        if ((i < 0) || (i >= (array_length slides))) {
            return false
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            def dd:PresDiagram (u.active(uiNow))
            dd.uiNow = uiNow
            u.diagram.uiNow = uiNow
            if ((dd.uiBusy()) || (u.diagram.uiBusy())) {
                return true
            }
            k = (k + 1)
        }
        return false
    }

    ; The diagram on slide i that is asking a question at slide time t, or -1.
    fn askingAt:int (i:int t:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return -1
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if (u.diagram.asking((t - u.start))) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; The slide time the clock stops at for a question on slide i, or -1.
    fn diagramHold:double (i:int) {
        if ((i < 0) || (i >= (array_length slides))) {
            return -1.0
        }
        def s:PresSlide (itemAt slides i)
        def best:double -1.0
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if (u.diagram.waiting && (! u.diagram.skipped)) {
                def at:double ((u.start + u.diagram.waitAt) + 0.8)
                if ((best < 0.0) || (at < best)) {
                    best = at
                }
            }
            k = (k + 1)
        }
        return best
    }

    fn diagramUse@(optional):PresDiaUse (i:int k:int) {
        if ((i < 0) || (i >= (array_length slides))) {
            def none@(optional):PresDiaUse
            return none
        }
        def s:PresSlide (itemAt slides i)
        if ((k < 0) || (k >= (array_length s.diagrams))) {
            def none2@(optional):PresDiaUse
            return none2
        }
        def u@(optional):PresDiaUse (itemAt s.diagrams k)
        return u
    }

    ; How tall a box may grow on its slide: down to the next box under it,
    ; or to the bottom margin.
    fn roomBelow:double (page:int box:MdBox) {
        def l:MdLayout (this.layout())
        def bottom:double (l.style.pageHeight - l.style.margin)
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.page == page) && (b.y >= ((box.y + box.h) - 0.5))) {
                if (b.y < bottom) {
                    bottom = (b.y - 12.0)
                }
            }
            i = (i + 1)
        }
        if (bottom < (box.y + box.h)) {
            return box.h
        }
        return (bottom - box.y)
    }

    ; Where a diagram paints across: the whole content width when nothing
    ; else on the slide sits beside it (a `{width=…}` that only kept the
    ; picture short enough to stay on its slide), else its own box. [x, w].
    fn diagramSpan:[double] (page:int box:MdBox) {
        def l:MdLayout (this.layout())
        def room:double (this.roomBelow(page box))
        def top:double box.y
        def bottom:double (box.y + room)
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (((b.page == page) && (b != box)) && ((b.y < (bottom - 0.5)) && ((b.y + b.h) > (top + 0.5)))) {
                def bx:double box.x
                def bw:double box.w
                return ([] _:double (bx bw))
            }
            i = (i + 1)
        }
        def x:double l.style.margin
        def w:double (l.style.pageWidth - (l.style.margin * 2.0))
        if (w < box.w) {
            x = box.x
            w = box.w
        }
        return ([] _:double (x w))
    }

    ; The layout box a fence was laid out in, or -1.
    fn embedBox:int (page:int text:string) {
        return (this.embedBoxAt(page text -1))
    }

    ; The box of the fence that starts at `srcStart` in the source: two
    ; fences with the same text on one page (one machine in two looks) are
    ; two boxes, and matched by text alone both found the first. -1 = the
    ; first with that text.
    fn embedBoxAt:int (page:int text:string srcStart:int) {
        def l:MdLayout (this.layout())
        def first:int -1
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (((b.page == page) && (b.kind == 3)) && (b.embedSource == text)) {
                if ((srcStart < 0) || (b.srcStart == srcStart)) {
                    return i
                }
                if (first < 0) {
                    first = i
                }
            }
            i = (i + 1)
        }
        return first
    }

    ; ------------------------------------------------------------------
    ; Programs on slides (```app, PresPlay)
    ; ------------------------------------------------------------------

    ; The program fences in a block, nested ones too.
    fn readPlays:void (s:PresSlide n:MdNode pg:int) {
        if ((n.kind == "embed") && ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(n.info)))) == "app")) {
            def u:PresPlayUse (new PresPlayUse())
            u.source = n.literal
            u.srcStart = n.srcStart
            u.page = s.index
            u.spec = (MdApp.read(n.literal))
            ; the n-th use of the same file in the deck
            def same:int 1
            def si:int 0
            while (si < (array_length slides)) {
                def os:PresSlide (itemAt slides si)
                def oi:int 0
                while (oi < (array_length os.plays)) {
                    def op:PresPlayUse (itemAt os.plays oi)
                    if (op.spec.src == u.spec.src) {
                        same = (same + 1)
                    }
                    oi = (oi + 1)
                }
                si = (si + 1)
            }
            u.key = (u.spec.src + "#" + (to_string same))
            push s.plays u
            return
        }
        def i:int 0
        while (i < (n.childCount())) {
            this.readPlays(s (n.childAt(i)) pg)
            i = (i + 1)
        }
    }

    ; Every program use in the deck, in slide order.
    fn playUses:[PresPlayUse] () {
        def out:[PresPlayUse]
        def i:int 0
        while (i < (array_length slides)) {
            def s:PresSlide (itemAt slides i)
            def k:int 0
            while (k < (array_length s.plays)) {
                push out (itemAt s.plays k)
                k = (k + 1)
            }
            i = (i + 1)
        }
        return out
    }

    fn playUse@(optional):PresPlayUse (key:string) {
        if (PresDeck.isScriptKey(key)) {
            return (this.scriptUse(key))
        }
        def all:[PresPlayUse] (this.playUses())
        def i:int 0
        while (i < (array_length all)) {
            def u:PresPlayUse (itemAt all i)
            if (u.key == key) {
                def hit@(optional):PresPlayUse u
                return hit
            }
            i = (i + 1)
        }
        def none@(optional):PresPlayUse
        return none
    }

    fn playView@(optional):PresPlayView (key:string) {
        def i:int 0
        while (i < (array_length playViews)) {
            def v:PresPlayView (itemAt playViews i)
            if (v.key == key) {
                def hit@(optional):PresPlayView v
                return hit
            }
            i = (i + 1)
        }
        def none@(optional):PresPlayView
        return none
    }

    ; The text the page handed over for a file of the deck, "" for none.
    fn dataText:string (path:string) {
        def want:string (MdVegaRender.bareUrl((MdVegaRender.resolveUrl(path))))
        def i:int 0
        while (i < (array_length dataUrls)) {
            if ((MdVegaRender.bareUrl((itemAt dataUrls i))) == want) {
                return (itemAt dataTexts i)
            }
            i = (i + 1)
        }
        return ""
    }

    fn hasDataText:boolean (path:string) {
        def want:string (MdVegaRender.bareUrl((MdVegaRender.resolveUrl(path))))
        def i:int 0
        while (i < (array_length dataUrls)) {
            if ((MdVegaRender.bareUrl((itemAt dataUrls i))) == want) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; One picture per program use: those still in the deck kept (running
    ; on), new ones made, the rest dropped; each given its size and, once
    ; the page has it, its stylesheet.
    fn keepPlays:void () {
        def all:[PresPlayUse] (this.playUses())
        def keep:[PresPlayView]
        def i:int 0
        while (i < (array_length all)) {
            def u:PresPlayUse (itemAt all i)
            def had@(optional):PresPlayView (this.playView(u.key))
            def v:PresPlayView (new PresPlayView())
            if (!null? had) {
                v = (unwrap had)
            }
            v.key = u.key
            v.allow3d = (u.spec.allows("3d"))
            def resized:boolean ((v.width != u.spec.width) || (v.height != u.spec.height))
            v.width = u.spec.width
            v.height = u.spec.height
            if (this.hasDataText(u.spec.css)) {
                v.setCss((this.dataText(u.spec.css)))
            } {
                if (resized && v.drawn) {
                    v.relayout()
                }
            }
            push keep v
            i = (i + 1)
        }
        playViews = keep
    }

    ; The files the programs need from the page: each one's source and
    ; stylesheet.
    fn playFiles:[string] () {
        def out:[string]
        def all:[PresPlayUse] (this.playUses())
        def i:int 0
        while (i < (array_length all)) {
            def u:PresPlayUse (itemAt all i)
            if (((strlen u.spec.src) > 0) && ((indexOf out u.spec.src) < 0)) {
                push out u.spec.src
            }
            if ((((strlen u.spec.css) > 0) && ((indexOf out u.spec.css) < 0)) && ((indexOf dataMissing (MdVegaRender.resolveUrl(u.spec.css))) < 0)) {
                push out u.spec.css
            }
            i = (i + 1)
        }
        def si:int 0
        while (si < (array_length slides)) {
            def ss:PresSlide (itemAt slides si)
            if (((strlen ss.script) > 0) && ((indexOf out ss.script) < 0)) {
                push out ss.script
            }
            si = (si + 1)
        }
        ; the files the programs read in import (PresPlayFiles)
        def progs:int (array_length out)
        def oi:int 0
        while (oi < progs) {
            def prog:string (itemAt out oi)
            if ((PresPlayFiles.isDeckFile(prog)) == false) {
                for (PresPlayFiles.specs((this.dataText(prog)))) spec:string spi {
                    def fp:string (PresPlayFiles.resolve(prog spec))
                    if (((indexOf out fp) < 0) && ((this.fileMissing(fp)) == false)) {
                        push out fp
                    }
                }
            }
            oi = (oi + 1)
        }
        return out
    }

    ; The page looked for `path` and the document does not have it.
    fn fileMissing:boolean (path:string) {
        return (((indexOf dataMissing path) >= 0) || ((indexOf dataMissing (MdVegaRender.resolveUrl(path))) >= 0))
    }

    ; The program at `path` as it runs: the deck's files it imports made
    ; modules on its first line (PresPlayFiles); "" while the page has not
    ; handed over the program or one of those files yet.
    fn linkedSource:string (path:string) {
        def src:string (this.dataText(path))
        if ((strlen src) == 0) {
            return ""
        }
        def files:[PresPlayFile]
        for (PresPlayFiles.specs(src)) spec:string si {
            def f:PresPlayFile (new PresPlayFile())
            f.spec = spec
            f.path = (PresPlayFiles.resolve(path spec))
            if (this.hasDataText(f.path)) {
                f.have = true
                f.text = (this.dataText(f.path))
            } {
                if ((this.fileMissing(f.path)) == false) {
                    return ""
                }
            }
            push files f
        }
        return ((PresPlayFiles.prelude(files)) + src)
    }

    ; The blocks with an id or a class (`{#tulos}`, `{.kortti}`) and the
    ; source each spans: what `el("#tulos")` names.
    fn readTags:void (doc:MdNode) {
        def a:[int]
        def b:[int]
        def c:[string]
        def d:[string]
        tagStart = a
        tagEnd = b
        tagId = c
        tagCls = d
        this.tagsIn(doc)
    }

    fn tagsIn:void (n:MdNode) {
        if (((strlen n.nodeId) > 0) || ((array_length n.classes) > 0)) {
            push tagStart n.srcStart
            push tagEnd n.srcEnd
            push tagId n.nodeId
            push tagCls (join n.classes " ")
        }
        def i:int 0
        while (i < (n.childCount())) {
            this.tagsIn((n.childAt(i)))
            i = (i + 1)
        }
    }

    ; The looks the programs gave a box's block.
    fn looksOfBox:[PresPlayLook] (b:MdBox) {
        def out:[PresPlayLook]
        if (((playStyle.count()) == 0) || (b.furniture > 0)) {
            return out
        }
        def at:int (PresDeck.boxSrc(b))
        if (at < 0) {
            return out
        }
        def i:int 0
        while (i < (array_length tagStart)) {
            if ((at >= (itemAt tagStart i)) && (at < (itemAt tagEnd i))) {
                def cls:[string] (strsplit (itemAt tagCls i) " ")
                def got:[PresPlayLook] (playStyle.looksFor((itemAt tagId i) cls))
                def g:int 0
                while (g < (array_length got)) {
                    if ((indexOf out (itemAt got g)) < 0) {
                        push out (itemAt got g)
                    }
                    g = (g + 1)
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; set by takeAsks when a deck.set rebuilt the slides: the host (PresApp)
    ; times them again, as after any rebuild
    def playRebuilt:boolean false

    ; A value for `{key}` set by a program (`deck.set`); "" as the key clears
    ; them all. The slides are laid out again when it changed anything.
    fn setLive:boolean (key0:string value:string) {
        def key:string (MdChar.lower((trim key0)))
        if ((strlen key) == 0) {
            if ((array_length liveKeys) == 0) {
                return false
            }
            def k:[string]
            def v:[string]
            liveKeys = k
            liveVals = v
            this.rebuild()
            return true
        }
        def i:int (indexOf liveKeys key)
        if (i >= 0) {
            if ((itemAt liveVals i) == value) {
                return false
            }
            set_at liveVals i value
        } {
            push liveKeys key
            push liveVals value
        }
        this.rebuild()
        return true
    }

    ; The deck's data a program reads each frame (`input.data`): the deck's
    ; own keys, the slide's over them, the live values over both.
    fn playData:JVal (page:int) {
        def out:JVal (JVal.mkObj())
        def l:MdLayout (this.layout())
        def dm:MdSlideMeta l.deckMeta
        def i:int 0
        while (i < (dm.count())) {
            out.setStr((itemAt dm.keys i) (itemAt dm.values i))
            i = (i + 1)
        }
        if ((page >= 0) && (page < (array_length slides))) {
            def ps:PresSlide (itemAt slides page)
            def sm:MdSlideMeta ps.meta
            def j:int 0
            while (j < (sm.count())) {
                out.setStr((itemAt sm.keys j) (itemAt sm.values j))
                j = (j + 1)
            }
        }
        def k:int 0
        while (k < (array_length liveKeys)) {
            out.setStr((itemAt liveKeys k) (itemAt liveVals k))
            k = (k + 1)
        }
        return out
    }

    ; What a frame of program `key` asked, taken in: the looks and the live
    ; values here, the moves between slides handed back for the host
    ; (PresApp) as a list of granted asks. Refusals are kept for the report.
    fn takeAsks:[PresPlayAsk] (key:string json:string) {
        def moves:[PresPlayAsk]
        def u@(optional):PresPlayUse (this.playUse(key))
        if (null? u) {
            return moves
        }
        def use:PresPlayUse (unwrap u)
        def asks:PresPlayAsks (PresPlayAsks.read(json use.spec (use.spec.name())))
        def r:int 0
        while (r < (array_length asks.refused)) {
            def line:string (itemAt asks.refused r)
            if ((indexOf playRefused line) < 0) {
                push playRefused line
            }
            r = (r + 1)
        }
        def i:int 0
        while (i < (array_length asks.granted)) {
            def a:PresPlayAsk (itemAt asks.granted i)
            if (a.kind == "deck.set") {
                if (this.setLive(a.key a.value)) {
                    playRebuilt = true
                }
            } {
                if ((indexOf a.kind "el.") == 0) {
                    if (playStyle.take(a)) {
                        revision = (revision + 1)
                    }
                } {
                    if (a.kind == "machine.send") {
                        ; state machines on slides come later: said, not dropped
                        def note:string ((use.spec.name()) + ": machine.send(\"" + a.event + "\"): this deck has no state machine to send it to")
                        if ((indexOf playRefused note) < 0) {
                            push playRefused note
                        }
                    } {
                        push moves a
                    }
                }
            }
            i = (i + 1)
        }
        return moves
    }

    ; Another deck opened: no program's looks, values or keyboard stay.
    fn clearPlays:void () {
        playStyle.clear()
        def k:[string]
        def v:[string]
        liveKeys = k
        liveVals = v
        playFocus = ""
        def r:[string]
        playRefused = r
        def pv:[PresPlayView]
        playViews = pv
        def sr:[PresScriptRun]
        scriptRuns = sr
    }

    ; The program whose box holds slide point (px, py) on slide i, "" none.
    fn playAt:string (i:int px:double py:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return ""
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.plays)) {
            def u:PresPlayUse (itemAt s.plays k)
            def bi:int (this.embedBox(i u.source))
            def v@(optional):PresPlayView (this.playView(u.key))
            if ((bi >= 0) && (!null? v)) {
                def lay:MdLayout (this.layout())
                def b:MdBox (itemAt lay.boxes bi)
                def pv:PresPlayView (unwrap v)
                def loc:[double] (pv.toLocal(b.x b.y b.w b.h px py))
                if ((itemAt loc 0) >= 0.0) {
                    return u.key
                }
            }
            k = (k + 1)
        }
        return ""
    }

    ; Slide point (px, py) in program `key`'s own units, and the id under
    ; it: {"x":…, "y":…, "id":"…"}, or "" when it is outside the program.
    ; A program whose 3-D world draws past its box has the whole slide
    ; ({"past": true}, PresPlayView.pointAt).
    fn playPoint:string (key:string px:double py:double) {
        def u@(optional):PresPlayUse (this.playUse(key))
        def v@(optional):PresPlayView (this.playView(key))
        if ((null? u) || (null? v)) {
            return ""
        }
        def use:PresPlayUse (unwrap u)
        def view:PresPlayView (unwrap v)
        def bi:int (this.embedBox(use.page use.source))
        if (bi < 0) {
            return ""
        }
        def lay:MdLayout (this.layout())
        def b:MdBox (itemAt lay.boxes bi)
        view.slideW = pageW
        view.slideH = pageH
        return (view.pointAt(b.x b.y b.w b.h px py true))
    }

    ; The worlds the programs on slide i draw past their boxes whose
    ; pictures are under slide point (px, py): [{"key", "src", "u", "v"}]
    ; (PresPlayView.pastAt). The page gives a press the first program whose
    ; world drew there.
    fn playPast:JVal (i:int px:double py:double) {
        def out:JVal (JVal.mkArr())
        if ((i < 0) || (i >= (array_length slides))) {
            return out
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.plays)) {
            def u:PresPlayUse (itemAt s.plays k)
            k = (k + 1)
            def bi:int (this.embedBox(i u.source))
            def v@(optional):PresPlayView (this.playView(u.key))
            if ((bi >= 0) && (!null? v)) {
                def lay:MdLayout (this.layout())
                def b:MdBox (itemAt lay.boxes bi)
                def pv:PresPlayView (unwrap v)
                pv.slideW = pageW
                pv.slideH = pageH
                def got:JVal (pv.pastAt(b.x b.y b.w b.h px py))
                def j:int 0
                while (j < (got.len())) {
                    def o:JVal (got.at(j))
                    o.setStr("key" u.key)
                    out.add(o)
                    j = (j + 1)
                }
            }
        }
        return out
    }

    ; Whether the program that has the keyboard takes the whole stage
    ; (PresPlayView.takesStage): while presenting, the slide's text and the
    ; controls give way to it.
    fn focusTakesStage:boolean () {
        if ((strlen playFocus) == 0) {
            return false
        }
        def u@(optional):PresPlayUse (this.playUse(playFocus))
        def v@(optional):PresPlayView (this.playView(playFocus))
        if ((null? u) || (null? v)) {
            return false
        }
        def use:PresPlayUse (unwrap u)
        def view:PresPlayView (unwrap v)
        def bi:int (this.embedBox(use.page use.source))
        if (bi < 0) {
            return false
        }
        def lay:MdLayout (this.layout())
        def b:MdBox (itemAt lay.boxes bi)
        view.slideW = pageW
        view.slideH = pageH
        return (view.takesStage(b.x b.y b.w b.h))
    }

    ; The program that has the keyboard over slide i, when it takes the
    ; stage (PresPlayView.paintOver), with its ring.
    fn paintFocusOver:void (out:EVGDisplayList i:int) {
        if ((this.focusTakesStage()) == false) {
            return
        }
        def use:PresPlayUse (unwrap (this.playUse(playFocus)))
        if (use.page != i) {
            return
        }
        def view:PresPlayView (unwrap (this.playView(playFocus)))
        def bi:int (this.embedBox(use.page use.source))
        def lay:MdLayout (this.layout())
        def b:MdBox (itemAt lay.boxes bi)
        view.paintOver(out b.x b.y b.w b.h)
        view.paintFocus(out b.x b.y b.w b.h "#58e1ff")
    }

    ; Whether a program on slide i drew a 3-D world in its last frame: the
    ; PPTX then takes the slide from its display list (PresExport), the
    ; world's picture with it.
    fn hasWorlds:boolean (i:int) {
        return (((this.playScenes(i)).len()) > 0)
    }

    ; The 3-D worlds the programs on slide i drew in their last frames,
    ; where they are on the slide: [{src, scene, x, y, w, h}] (PresPlayView
    ; scenesIn).
    fn playScenes:JVal (i:int) {
        def out:JVal (JVal.mkArr())
        if ((i < 0) || (i >= (array_length slides))) {
            return out
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.plays)) {
            def u:PresPlayUse (itemAt s.plays k)
            k = (k + 1)
            def bi:int (this.embedBox(i u.source))
            def v@(optional):PresPlayView (this.playView(u.key))
            if ((bi >= 0) && (!null? v)) {
                def lay:MdLayout (this.layout())
                def b:MdBox (itemAt lay.boxes bi)
                def sv:PresPlayView (unwrap v)
                sv.slideW = pageW
                sv.slideH = pageH
                def got:JVal (sv.scenesIn(b.x b.y b.w b.h))
                def j:int 0
                while (j < (got.len())) {
                    out.add((got.at(j)))
                    j = (j + 1)
                }
            }
        }
        return out
    }

    ; A program's box painted: its picture when it has one (a still list —
    ; a thumbnail, the PDF — shows the last), else the fence's plate; a ring
    ; when it has the keyboard. False when the box is no program's.
    ; true: a program's box is left empty where it has no picture yet (the
    ; public viewer, mcp-go/rgr/View.rgr, paints the plate itself and runs
    ; the program over it)
    def platesOff:boolean false

    fn paintPlay:boolean (out:EVGDisplayList s:PresSlide b:MdBox painter:MdToEvg l:MdLayout) {
        def k:int 0
        while (k < (array_length s.plays)) {
            def u:PresPlayUse (itemAt s.plays k)
            if (u.source == b.embedSource) {
                def v@(optional):PresPlayView (this.playView(u.key))
                def shown:boolean false
                def said:string ""
                if (!null? v) {
                    def pv:PresPlayView (unwrap v)
                    pv.slideW = pageW
                    pv.slideH = pageH
                    shown = (pv.paint(out b.x b.y b.w b.h))
                    said = (pv.note())
                    if ((shown == false) && ((strlen said) > 0)) {
                        pv.paintPlate(out u.spec b.x b.y b.w b.h)
                        shown = true
                    }
                }
                if ((shown == false) && (platesOff == false)) {
                    painter.paintBox(out l b 0.0)
                }
                if ((((!null? v) && (u.key == playFocus)) && showControls) && (still == false)) {
                    def fv:PresPlayView (unwrap v)
                    fv.paintFocus(out b.x b.y b.w b.h "#58e1ff")
                }
                return true
            }
            k = (k + 1)
        }
        return false
    }

    ; What the deck's programs got wrong, for the report: their fences'
    ; warnings, a source the page could not find, and what they asked and
    ; were refused.
    fn playNotes:[string] () {
        def out:[string]
        def all:[PresPlayUse] (this.playUses())
        def i:int 0
        while (i < (array_length all)) {
            def u:PresPlayUse (itemAt all i)
            def w:int 0
            while (w < (array_length u.spec.warnings)) {
                push out ("Slide " + (to_string (u.page + 1)) + ": " + (itemAt u.spec.warnings w))
                w = (w + 1)
            }
            if (((strlen u.spec.src) > 0) && ((indexOf dataMissing (MdVegaRender.resolveUrl(u.spec.src))) >= 0)) {
                push out ("Slide " + (to_string (u.page + 1)) + ": app: no file " + u.spec.src + " in this presentation")
            }
            ; its stylesheet's rules the layout does not take
            def v@(optional):PresPlayView (this.playView(u.key))
            if (!null? v) {
                def view:PresPlayView (unwrap v)
                for (view.cssErrors()) ce:string cei {
                    push out ("Slide " + (to_string (u.page + 1)) + ": " + u.spec.css + ": " + ce)
                }
            }
            i = (i + 1)
        }
        for (this.scriptNotes()) sn:string sni {
            push out sn
        }
        def vi:int 0
        while (vi < (array_length all)) {
            def u3:PresPlayUse (itemAt all vi)
            def v3@(optional):PresPlayView (this.playView(u3.key))
            if (!null? v3) {
                def pv3:PresPlayView (unwrap v3)
                if (pv3.asked3d && (pv3.allow3d == false)) {
                    push out ("Slide " + (to_string (u3.page + 1)) + ": app: " + u3.spec.src + " draws a <scene3d>, which needs allow: 3d")
                }
                ; what its worlds have that is not Three's (Pres3DTree)
                def wi:int 0
                while (wi < (array_length pv3.scenes)) {
                    def sc:PresPlayScene (itemAt pv3.scenes wi)
                    def world:Pres3DTree (Pres3DTree.read(sc.json))
                    for world.warnings wl:string wli {
                        def line:string ("Slide " + (to_string (u3.page + 1)) + ": app: " + u3.spec.src + ": " + wl)
                        if ((indexOf out line) < 0) {
                            push out line
                        }
                    }
                    wi = (wi + 1)
                }
            }
            vi = (vi + 1)
        }
        def r:int 0
        while (r < (array_length playRefused)) {
            push out (itemAt playRefused r)
            r = (r + 1)
        }
        return out
    }

    ; ------------------------------------------------------------------
    ; Slide scripts (`{script=apps/fx.tsx}` on a heading, PresScript)
    ; ------------------------------------------------------------------

    ; Slide i's script key, "script:<file>#<n>" (the n-th slide with that
    ; file), "" for a slide without one.
    fn scriptKeyOf:string (i:int) {
        def s:PresSlide (itemAt slides i)
        if ((strlen s.script) == 0) {
            return ""
        }
        def same:int 1
        def k:int 0
        while (k < i) {
            def o:PresSlide (itemAt slides k)
            if (o.script == s.script) {
                same = (same + 1)
            }
            k = (k + 1)
        }
        return ("script:" + s.script + "#" + (to_string same))
    }

    sfn isScriptKey:boolean (key:string) {
        return ((indexOf key "script:") == 0)
    }

    ; The slide of a script key, -1 for none.
    fn scriptPage:int (key:string) {
        if ((PresDeck.isScriptKey(key)) == false) {
            return -1
        }
        def i:int 0
        while (i < (array_length slides)) {
            if ((this.scriptKeyOf(i)) == key) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn scriptRun@(optional):PresScriptRun (key:string) {
        def i:int 0
        while (i < (array_length scriptRuns)) {
            def r:PresScriptRun (itemAt scriptRuns i)
            if (r.key == key) {
                def hit@(optional):PresScriptRun r
                return hit
            }
            i = (i + 1)
        }
        def none@(optional):PresScriptRun
        return none
    }

    ; Every slide's script, in slide order: the runs of those still in the
    ; deck kept (a keystroke does not start one over), new ones made.
    fn keepScripts:void () {
        def keep:[PresScriptRun]
        def i:int 0
        while (i < (array_length slides)) {
            def key:string (this.scriptKeyOf(i))
            if ((strlen key) > 0) {
                def had@(optional):PresScriptRun (this.scriptRun(key))
                def r:PresScriptRun (new PresScriptRun())
                if (!null? had) {
                    r = (unwrap had)
                }
                def s:PresSlide (itemAt slides i)
                r.key = key
                r.src = s.script
                r.page = i
                s.scriptBuilds = r.ownsBuild
                push keep r
            }
            i = (i + 1)
        }
        scriptRuns = keep
    }

    ; A script as the programs' host sees one (web/apps.js, PresApp): its
    ; slide, its file and its grants, as a program's use.
    fn scriptUse@(optional):PresPlayUse (key:string) {
        def pg:int (this.scriptPage(key))
        if (pg < 0) {
            def none@(optional):PresPlayUse
            return none
        }
        def s:PresSlide (itemAt slides pg)
        def u:PresPlayUse (new PresPlayUse())
        u.key = key
        u.page = pg
        u.spec.src = s.script
        u.spec.allow = s.scriptAllow
        u.spec.width = pageW
        u.spec.height = pageH
        def hit@(optional):PresPlayUse u
        return hit
    }

    ; A frame of script `key` ({p, a, build, click}): false when it was none.
    fn setScriptFrame:boolean (key:string json:string) {
        def ro@(optional):PresScriptRun (this.scriptRun(key))
        if (null? ro) {
            return false
        }
        def r:PresScriptRun (unwrap ro)
        def f:PresScriptFrame (PresScriptFrame.read(json))
        if ((strlen f.error) > 0) {
            return false
        }
        r.live = f
        r.hasLive = true
        r.hasLeave = false
        r.hasOpen = false
        this.takeOwns(r f)
        return true
    }

    ; What script `key`'s onLeave set as its slide was left: the slide on the
    ; stage while the next one arrives (until the script runs again).
    fn setScriptLeave:boolean (key:string json:string) {
        def ro@(optional):PresScriptRun (this.scriptRun(key))
        if (null? ro) {
            return false
        }
        def r:PresScriptRun (unwrap ro)
        def f:PresScriptFrame (PresScriptFrame.read(json))
        if ((strlen f.error) > 0) {
            return false
        }
        r.leave = f
        r.hasLeave = true
        return true
    }

    ; How script `key` opens (__scriptOpen): its slide as it arrives on the
    ; stage, through its transition, until the script's first frame.
    fn setScriptOpen:boolean (key:string json:string) {
        def ro@(optional):PresScriptRun (this.scriptRun(key))
        if (null? ro) {
            return false
        }
        def r:PresScriptRun (unwrap ro)
        def f:PresScriptFrame (PresScriptFrame.read(json))
        if ((strlen f.error) > 0) {
            return false
        }
        r.open = f
        r.hasOpen = true
        r.hasLeave = false
        this.takeOwns(r f)
        return true
    }

    ; Where script `key` ends, as its final() or its ticks run out say.
    fn setScriptFinal:boolean (key:string json:string) {
        def ro@(optional):PresScriptRun (this.scriptRun(key))
        if (null? ro) {
            return false
        }
        def r:PresScriptRun (unwrap ro)
        def f:PresScriptFrame (PresScriptFrame.read(json))
        if ((strlen f.error) > 0) {
            return false
        }
        r.final = f
        r.hasFinal = true
        r.finalJson = json
        this.takeOwns(r f)
        revision = (revision + 1)
        return true
    }

    fn takeOwns:void (r:PresScriptRun f:PresScriptFrame) {
        ; a script's presenter speaks in the hand face of `::: story`
        for f.adds ad:PresScriptAdd ai {
            if (ad.kind == "presenter") {
                this.wantFace((PresStory.face()))
            }
        }
        r.ownsClick = f.ownsClick
        if (r.ownsBuild != f.ownsBuild) {
            r.ownsBuild = f.ownsBuild
            if ((r.page >= 0) && (r.page < (array_length slides))) {
                def s:PresSlide (itemAt slides r.page)
                s.scriptBuilds = f.ownsBuild
            }
            revision = (revision + 1)
        }
    }

    ; One moment of script `key` (__scriptAt), drawn instead of its others
    ; until `clearScriptAt`: the server's picture of the slide at a time.
    fn setScriptAt:boolean (key:string json:string) {
        def ro@(optional):PresScriptRun (this.scriptRun(key))
        if (null? ro) {
            return false
        }
        def r:PresScriptRun (unwrap ro)
        def f:PresScriptFrame (PresScriptFrame.read(json))
        if ((strlen f.error) > 0) {
            return false
        }
        r.at = f
        r.hasAt = true
        this.takeOwns(r f)
        revision = (revision + 1)
        return true
    }

    fn clearScriptAt:void () {
        def i:int 0
        while (i < (array_length scriptRuns)) {
            def r:PresScriptRun (itemAt scriptRuns i)
            if r.hasAt {
                r.hasAt = false
                r.at = (new PresScriptFrame())
                revision = (revision + 1)
            }
            i = (i + 1)
        }
    }

    ; What script `key`'s final frame runs to (__scriptFinal's argument
    ; without the tree): {steps, seconds}, its slide's build steps and
    ; `export-frame` or the slide's length.
    fn scriptFinalArgs:JVal (key:string) {
        def o:JVal (JVal.mkObj())
        def pg:int (this.scriptPage(key))
        if (pg >= 0) {
            def s:PresSlide (itemAt slides pg)
            o.setInt("steps" s.steps)
            def secs:double s.duration
            if (s.exportFrame >= 0.0) {
                secs = s.exportFrame
            }
            o.setNum("seconds" secs)
        }
        return o
    }

    ; Whether slide i's script ends with the slide looking otherwise than
    ; the Markdown lays it out: an export draws it from its display list.
    fn scriptChanges:boolean (i:int) {
        def key:string (this.scriptKeyOf(i))
        if ((strlen key) == 0) {
            return false
        }
        def ro@(optional):PresScriptRun (this.scriptRun(key))
        if (null? ro) {
            return false
        }
        def r:PresScriptRun (unwrap ro)
        return (r.hasFinal && ((r.final.count()) > 0))
    }

    ; How slide `page`'s script leaves the Markdown from `from` to `to` where
    ; it ends: 0 untouched, 1 changed (moved, recoloured, a part of it
    ; changed), 2 hidden (the block made invisible or clear). A document
    ; (Word, HTML) draws a changed block as the stage shows it and leaves a
    ; hidden one out.
    fn scriptLeaves:int (page:int from:int to:int) {
        if ((this.scriptChanges(page)) == false) {
            return 0
        }
        def ro@(optional):PresScriptRun (this.scriptRun((this.scriptKeyOf(page))))
        def r:PresScriptRun (unwrap ro)
        def sc:PresScene (this.sceneOfSlide(page))
        def out:int 0
        def i:int 1
        while (i < (sc.count())) {
            def e:PresEnt (sc.at(i))
            def po@(optional):PresEntProps (r.final.propsOf(e.id))
            if (!null? po) {
                def p:PresEntProps (unwrap po)
                if (p.changes(e)) {
                    ; the block it is in
                    def bi:int i
                    def be:PresEnt e
                    while ((be.src < 0) && (be.parent > 0)) {
                        bi = be.parent
                        be = (sc.at(bi))
                    }
                    if ((be.src >= from) && (be.src < to)) {
                        ; the node itself hidden, not a part of it
                        if (((bi == i) && ((be.src == from) && (be.srcEnd == to))) && ((p.visible == false) || (p.opacity <= 0.0))) {
                            return 2
                        }
                        out = 1
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; Slide i drawn at rest, its script where it ends.
    fn stillSlide:EVGDisplayList (i:int) {
        def was:boolean still
        still = true
        def s:PresSlide (itemAt slides i)
        def g:[int]
        def dl:EVGDisplayList (this.slideList(i g s.duration))
        still = was
        return dl
    }

    ; Where the blocks from `from` to `to` of slide `page` are once its
    ; script ends: [x, y, w, h] around them and their parts, [] for none.
    fn scriptBlockRect:[double] (page:int from:int to:int) {
        def out:[double]
        def dl:EVGDisplayList (this.stillSlide(page))
        def sc:PresScene (this.sceneOfList(page dl))
        def x0:double 0.0
        def y0:double 0.0
        def x1:double 0.0
        def y1:double 0.0
        def any:boolean false
        def i:int 1
        while (i < (sc.count())) {
            def e:PresEnt (sc.at(i))
            if ((((e.src >= from) && (e.src < to)) && e.hasBox) && ((e.w > 0.0) && (e.h > 0.0))) {
                if ((any == false) || (e.x < x0)) {
                    x0 = e.x
                }
                if ((any == false) || (e.y < y0)) {
                    y0 = e.y
                }
                if ((any == false) || ((e.x + e.w) > x1)) {
                    x1 = (e.x + e.w)
                }
                if ((any == false) || ((e.y + e.h) > y1)) {
                    y1 = (e.y + e.h)
                }
                any = true
            }
            i = (i + 1)
        }
        if any {
            push out x0
            push out y0
            push out (x1 - x0)
            push out (y1 - y0)
        }
        return out
    }

    ; The scripts' keys, for a host that runs them itself (the server).
    fn scriptKeys:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length scriptRuns)) {
            def r:PresScriptRun (itemAt scriptRuns i)
            push out r.key
            i = (i + 1)
        }
        return out
    }

    ; The script left the stage (or was stopped): its slide is shown as it
    ; ends again. `why` says why it was stopped, "" when it only left.
    fn endScriptLive:void (key:string why:string) {
        def ro@(optional):PresScriptRun (this.scriptRun(key))
        if (null? ro) {
            return
        }
        def r:PresScriptRun (unwrap ro)
        r.hasLive = false
        r.live = (new PresScriptFrame())
        r.hasOpen = false
        r.stopped = why
    }

    ; What slide i is drawn with: the running frame on the stage, else where
    ; the script ends; none for a slide without one, or while scriptsOff.
    fn scriptFrameFor@(optional):PresScriptFrame (i:int) {
        def none@(optional):PresScriptFrame
        if scriptsOff {
            return none
        }
        def key:string (this.scriptKeyOf(i))
        if ((strlen key) == 0) {
            return none
        }
        def ro@(optional):PresScriptRun (this.scriptRun(key))
        if (null? ro) {
            return none
        }
        def r:PresScriptRun (unwrap ro)
        if r.hasAt {
            def av@(optional):PresScriptFrame r.at
            return av
        }
        if ((r.hasLive && showControls) && (still == false)) {
            def lv@(optional):PresScriptFrame r.live
            return lv
        }
        if ((r.hasOpen && showControls) && (still == false)) {
            def ov@(optional):PresScriptFrame r.open
            return ov
        }
        if ((r.hasLeave && showControls) && (still == false)) {
            def lfv@(optional):PresScriptFrame r.leave
            return lfv
        }
        if r.hasFinal {
            def fv@(optional):PresScriptFrame r.final
            return fv
        }
        return none
    }

    ; The block nodes of the document (`blk*`), parents first.
    fn readBlocks:void (doc:MdNode) {
        def a:[int]
        def b:[int]
        def c:[string]
        def d:[int]
        def e:[int]
        def f:[string]
        def g:[string]
        def h:[string]
        blkStart = a
        blkEnd = b
        blkKind = c
        blkLevel = d
        blkParent = e
        blkId = f
        blkCls = g
        blkInfo = h
        this.blocksIn(doc -1)
    }

    sfn isBlockKind:boolean (k:string) {
        return ((((((k == "heading") || (k == "paragraph")) || ((k == "item") || (k == "list"))) || ((k == "code_block") || (k == "block_quote"))) || ((k == "embed") || (k == "table"))) || (((k == "math_block") || (k == "html_block")) || (k == "container")))
    }

    fn blocksIn:void (n:MdNode parent:int) {
        def me:int parent
        if ((PresDeck.isBlockKind(n.kind)) && (n.srcStart >= 0)) {
            push blkStart n.srcStart
            push blkEnd n.srcEnd
            push blkKind n.kind
            push blkLevel n.level
            push blkParent parent
            push blkId n.nodeId
            push blkCls (join n.classes " ")
            push blkInfo n.info
            me = ((array_length blkStart) - 1)
        }
        def i:int 0
        while (i < (n.childCount())) {
            this.blocksIn((n.childAt(i)) me)
            i = (i + 1)
        }
    }

    ; The innermost block node at source offset `at`, -1 for none.
    fn blockAt:int (at:int) {
        def best:int -1
        def i:int 0
        while (i < (array_length blkStart)) {
            if ((at >= (itemAt blkStart i)) && (at < (itemAt blkEnd i))) {
                best = i
            }
            i = (i + 1)
        }
        return best
    }

    ; What a box of the layout is part of, as a script names it: its kind,
    ; its `{#id}` and classes, and (in `id`, for now) a key two boxes of one
    ; block share. Kind "marker": a list's bullet, given to its item later.
    fn boxBlock:PresEnt (b:MdBox bi:int) {
        def e:PresEnt (PresEnt.of("text"))
        if (b.furniture > 0) {
            e.kind = "header"
            if (b.furniture == 2) {
                e.kind = "footer"
            }
            if (b.furniture == 3) {
                e.kind = "note"
            }
            e.id = ("furniture:" + e.kind)
            return e
        }
        if (b.kind == 4) {
            e.kind = "image"
            e.id = ("box:" + (to_string bi))
            e.src = (PresDeck.boxSrc(b))
            e.data = ((JVal.mkObj()).setStr("src" b.imagePath).toJson())
            return e
        }
        def at:int (this.blockAt((PresDeck.boxSrc(b))))
        def pick:int -1
        def quote:int -1
        def para:int -1
        def list:int -1
        def name:string ""
        def cls:[string]
        def k:int at
        while (k >= 0) {
            def kd:string (itemAt blkKind k)
            if (pick < 0) {
                if ((strlen name) == 0) {
                    name = (itemAt blkId k)
                }
                def kc:[string] (strsplit (itemAt blkCls k) " ")
                def ci:int 0
                while (ci < (array_length kc)) {
                    def cn:string (itemAt kc ci)
                    if (((strlen cn) > 0) && ((indexOf cls cn) < 0)) {
                        push cls cn
                    }
                    ci = (ci + 1)
                }
            }
            if ((pick < 0) && ((((kd == "heading") || (kd == "item")) || ((kd == "embed") || (kd == "code_block"))) || (((kd == "table") || (kd == "math_block")) || (kd == "html_block")))) {
                pick = k
            }
            if ((quote < 0) && (kd == "block_quote")) {
                quote = k
            }
            if ((para < 0) && (kd == "paragraph")) {
                para = k
            }
            if ((list < 0) && (kd == "list")) {
                list = k
            }
            k = (itemAt blkParent k)
        }
        def use:int pick
        if (use < 0) {
            use = quote
        }
        if (use < 0) {
            use = para
        }
        if (b.kind == 5) {
            e.kind = "math"
        } {
            ; a bullet or number: no source text of its own, on an item's line
            if ((list >= 0) && ((b.kind == 0) && (b.segSrc < 0))) {
                use = -1
            }
            if (use < 0) {
                if (list >= 0) {
                    e.kind = "marker"
                    e.id = ("list:" + (to_string list))
                    return e
                }
                e.id = ("box:" + (to_string bi))
                return e
            }
            def kind:string (itemAt blkKind use)
            e.kind = "p"
            if (kind == "heading") {
                e.kind = ("h" + (to_string (itemAt blkLevel use)))
            }
            if (kind == "item") {
                e.kind = "li"
            }
            if (kind == "code_block") {
                e.kind = "code"
            }
            if (kind == "table") {
                e.kind = "table"
            }
            if (kind == "math_block") {
                e.kind = "math"
            }
            if (kind == "html_block") {
                e.kind = "html"
            }
            if (kind == "block_quote") {
                e.kind = "quote"
            }
            if (kind == "embed") {
                def nt:string (MdEmbedKinds.notationOf((MdEmbedKinds.firstWord((itemAt blkInfo use)))))
                e.kind = "diagram"
                if (nt == "vega") {
                    e.kind = "chart"
                }
                if (nt == "app") {
                    e.kind = "app"
                }
                if (nt == "figure") {
                    e.kind = "figure"
                }
            }
        }
        if (use >= 0) {
            e.id = ("blk:" + (to_string use))
            e.src = (itemAt blkStart use)
            e.srcEnd = (itemAt blkEnd use)
        } {
            e.id = ("box:" + (to_string bi))
        }
        e.name = name
        e.classes = cls
        return e
    }

    ; The block a layout box of slide i belongs to, as an index in `blocks`
    ; (made when first met), -1 for none.
    fn blockOfBox:int (i:int bi:int blocks:[PresEnt] seen:[string:int] l:MdLayout) {
        def memo@(optional):int (get seen ("#" + (to_string bi)))
        if (!null? memo) {
            return (unwrap memo)
        }
        def b:MdBox (itemAt l.boxes bi)
        def e:PresEnt (this.boxBlock(b bi))
        def out:int -1
        if (e.kind == "marker") {
            ; a bullet: the item on its line
            def best:int -1
            def bestD:double (b.h * 0.75)
            def mcy:double (b.y + (b.h * 0.5))
            for (l.boxesOnPage(i)) oi:int oidx {
                def ob:MdBox (itemAt l.boxes oi)
                if ((oi != bi) && (ob.kind == 0)) {
                    def oe:PresEnt (this.boxBlock(ob oi))
                    if (oe.kind == "li") {
                        def dd:double (fabs ((ob.y + (ob.h * 0.5)) - mcy))
                        if (dd < bestD) {
                            bestD = dd
                            best = oi
                        }
                    }
                }
            }
            if (best >= 0) {
                out = (this.blockOfBox(i best blocks seen l))
            }
        } {
            def had@(optional):int (get seen e.id)
            if (!null? had) {
                out = (unwrap had)
            } {
                push blocks e
                out = ((array_length blocks) - 1)
                set seen e.id out
            }
        }
        set seen ("#" + (to_string bi)) out
        return out
    }

    ; The entities of slide i's list `list` as slideList just drew it
    ; (`boxOfCmd`, `partOfCmd` and `slideParts` are that list's).
    fn sceneOfList:PresScene (i:int list:EVGDisplayList) {
        def l:MdLayout (this.layout())
        def blocks:[PresEnt]
        def seen:[string:int]
        def blockOfCmd:[int]
        def n:int (array_length list.cmds)
        def k:int 0
        while (k < n) {
            def bi:int -1
            if (k < (array_length boxOfCmd)) {
                bi = (itemAt boxOfCmd k)
            }
            if (bi >= 0) {
                push blockOfCmd (this.blockOfBox(i bi blocks seen l))
            } {
                push blockOfCmd -1
            }
            k = (k + 1)
        }
        ; the parts the painters marked (a chart's bars, a diagram's nodes);
        ; each command's part, -1 for none
        def parts:[PresEnt]
        def pi:int 0
        while (pi < (array_length slideParts)) {
            def pe:PresEnt (itemAt slideParts pi)
            if (pe.ofBox >= 0) {
                pe.parent = (this.blockOfBox(i pe.ofBox blocks seen l))
            }
            push parts pe
            pi = (pi + 1)
        }
        def partOf:[int]
        def bulletOf:[string:int]
        def q:int 0
        while (q < n) {
            def pq:int -1
            if (q < (array_length partOfCmd)) {
                pq = (itemAt partOfCmd q)
            }
            ; an item's bullet or number: a part of the item, not its text
            def qb:int -1
            if (q < (array_length boxOfCmd)) {
                qb = (itemAt boxOfCmd q)
            }
            if ((pq < 0) && (qb >= 0)) {
                def mb:MdBox (itemAt l.boxes qb)
                def me:PresEnt (this.boxBlock(mb qb))
                if (me.kind == "marker") {
                    def had@(optional):int (get bulletOf (to_string qb))
                    if (!null? had) {
                        pq = (unwrap had)
                    } {
                        push parts (PresEnt.of("marker"))
                        pq = ((array_length parts) - 1)
                        set bulletOf (to_string qb) pq
                    }
                }
            }
            push partOf pq
            q = (q + 1)
        }
        return (PresScene.build(list blockOfCmd blocks partOf parts l.engine pageW pageH))
    }

    ; The tree script `key` is handed: its slide as the Markdown has it,
    ; everything arrived, as JSON (PresScene.toJson). "" for no such script.
    fn scriptTree:string (key:string) {
        def pg:int (this.scriptPage(key))
        if (pg < 0) {
            return ""
        }
        if (treeRev != revision) {
            def tj:[string]
            treeJson = tj
            def ti:int 0
            while (ti < (array_length slides)) {
                push treeJson ""
                ti = (ti + 1)
            }
            treeRev = revision
        }
        if ((strlen (itemAt treeJson pg)) == 0) {
            def sc:PresScene (this.sceneOfSlide(pg))
            set_at treeJson pg (sc.toJson())
        }
        return (itemAt treeJson pg)
    }

    ; Slide i's entities as the Markdown lays them out, everything arrived
    ; and still (no camera, no controls): the tree a script is handed, and
    ; what get_display_list reads.
    def sceneRev:int -1
    def scenePage:int -1
    def sceneHeld:PresScene (new PresScene())

    ; sceneOfList for a list a script's frame is laid over, kept while the
    ; list is the one it was: a running script asks for it every frame, and
    ; measuring its words again each time was most of a frame's work
    def liveSceneRev:int -1
    def liveScenePage:int -1
    def liveSceneMark:double 0.0
    def liveSceneHeld:PresScene (new PresScene())

    fn sceneOfListHeld:PresScene (i:int list:EVGDisplayList) {
        def mark:double (PresDeck.listMark(list))
        if (((liveSceneRev == revision) && (liveScenePage == i)) && (liveSceneMark == mark)) {
            return liveSceneHeld
        }
        liveSceneHeld = (this.sceneOfList(i list))
        liveSceneRev = revision
        liveScenePage = i
        liveSceneMark = mark
        return liveSceneHeld
    }

    ; A number that changes when anything moves, grows or is added in a list.
    sfn listMark:double (list:EVGDisplayList) {
        def m:double (to_double (array_length list.cmds))
        def k:int 0
        while (k < (array_length list.cmds)) {
            def c:EVGDrawCmd (itemAt list.cmds k)
            def f:double (to_double ((k % 7) + 1))
            m = (m + (f * (((c.x + (c.y * 3.0)) + (c.w * 5.0)) + (c.h * 7.0))))
            m = (m + (c.a * 11.0))
            k = (k + 1)
        }
        return m
    }

    fn sceneOfSlide:PresScene (i:int) {
        if ((sceneRev == revision) && (scenePage == i)) {
            return sceneHeld
        }
        def wasOff:boolean scriptsOff
        def wasStill:boolean still
        def wasControls:boolean showControls
        scriptsOff = true
        still = true
        showControls = false
        def s:PresSlide (itemAt slides i)
        def g:[int]
        def dl:EVGDisplayList (this.slideList(i g s.duration))
        def sc:PresScene (this.sceneOfList(i dl))
        scriptsOff = wasOff
        still = wasStill
        showControls = wasControls
        sceneRev = revision
        scenePage = i
        sceneHeld = sc
        return sc
    }

    ; The ids a selector names on slide i as the Markdown lays it out:
    ; what a script's find() would give (PresSel), for an assistant and the
    ; tests.
    fn findOnSlide:[string] (i:int sel:string) {
        def out:[string]
        if ((i < 0) || (i >= (array_length slides))) {
            return out
        }
        def sc:PresScene (this.sceneOfSlide(i))
        for (PresSel.findIn(sc.ents sel)) at:int ai {
            def fe:PresEnt (sc.at(at))
            push out fe.id
        }
        return out
    }

    ; Slide i for a page that runs its script itself (the public viewer,
    ; PresScriptWeb): its list at rest as the Markdown has it, that list's
    ; scene (PresScene.wireJson), and the theme's text and accent colours,
    ; {"list", "scene", "ink", "accent"}.
    fn scriptBaseJson:string (i:int) {
        def l:MdLayout (this.layout())
        def wasOff:boolean scriptsOff
        scriptsOff = true
        def g:[int]
        def dl:EVGDisplayList (this.slideList(i g 0.0))
        def sc:PresScene (this.sceneOfList(i dl))
        scriptsOff = wasOff
        def o:JVal (JVal.mkObj())
        o.setStr("ink" l.style.textColor)
        o.setStr("accent" (this.themeColour("chart" "accent-color")))
        def a:string (o.toJson())
        return ("{\"list\":" + (dl.toJson()) + ",\"scene\":" + (sc.wireJson()) + "," + (substring a 1 (strlen a)))
    }

    ; The entity of slide i under slide point (px, py): the smallest whose
    ; box holds it, not a letter; "" for none.
    fn scriptEntityAt:string (i:int px:double py:double) {
        def sc:PresScene (this.sceneOfSlide(i))
        return (sc.entityAt(px py))
    }

    ; What the slides' scripts got wrong: a file the deck does not have,
    ; selectors in their find() calls that name nothing on their slide,
    ; and why the page stopped one.
    def scriptNotesRev:int -1
    def scriptNotesHad:[string]

    fn scriptNotes:[string] () {
        if (scriptNotesRev == revision) {
            return scriptNotesHad
        }
        def out:[string]
        def i:int 0
        while (i < (array_length scriptRuns)) {
            def r:PresScriptRun (itemAt scriptRuns i)
            def at:string ("Slide " + (to_string (r.page + 1)) + ": script " + r.src)
            if ((indexOf dataMissing (MdVegaRender.resolveUrl(r.src))) >= 0) {
                push out (at + ": no file " + r.src + " in this presentation")
            } {
                if (this.hasDataText(r.src)) {
                    def sc:PresScene (this.sceneOfSlide(r.page))
                    def miss:[string] (PresScriptCheck.misses((this.dataText(r.src)) sc))
                    def m:int 0
                    while (m < (array_length miss)) {
                        push out (at + ": " + (itemAt miss m))
                        m = (m + 1)
                    }
                }
            }
            if ((strlen r.stopped) > 0) {
                push out (at + ": " + r.stopped)
            }
            i = (i + 1)
        }
        scriptNotesHad = out
        scriptNotesRev = revision
        return out
    }

    ; Where a chart's columns are and what drew them: the commands from
    ; `before` on (the chart as drawn, then dressed) given to the columns
    ; `bars` (as the markdown module drew them, before the dressing), each
    ; label to the column it names, the rest of the words and the data's
    ; lines as parts of their own. `bi` is the chart's layout box.
    fn chartParts:void (out:EVGDisplayList before:int bars:[EVGDrawCmd] bi:int spec:string) {
        def base:int (array_length slideParts)
        def labels:[string]
        def values:[string]
        def j:int 0
        while (j < (array_length bars)) {
            def e:PresEnt (PresEnt.of("bar"))
            e.ofBox = bi
            push slideParts e
            push labels ""
            push values ""
            j = (j + 1)
        }
        while ((array_length partOfCmd) < before) {
            push partOfCmd -1
        }
        def k:int before
        while (k < (array_length out.cmds)) {
            def c:EVGDrawCmd (itemAt out.cmds k)
            def part:int -1
            if (c.kind == 3) {
                def lb:int (PresChart.labelBar(c bars))
                if (lb >= 0) {
                    part = (base + lb)
                    set_at values lb (trim c.text)
                } {
                    ; a category's name under its column
                    def cx:double (c.x + (c.w * 0.5))
                    def b2:int 0
                    while (b2 < (array_length bars)) {
                        def bb:EVGDrawCmd (itemAt bars b2)
                        if ((((cx >= bb.x) && (cx <= (bb.x + bb.w))) && (c.y >= ((bb.y + bb.h) - 2.0))) && (c.y <= ((bb.y + bb.h) + 40.0))) {
                            if ((strlen (itemAt labels b2)) == 0) {
                                set_at labels b2 (trim c.text)
                            }
                        }
                        b2 = (b2 + 1)
                    }
                    def le:PresEnt (PresEnt.of("label"))
                    le.ofBox = bi
                    push slideParts le
                    part = ((array_length slideParts) - 1)
                }
            } {
                if ((c.kind == 7) && (PresChart.isDataLine(c))) {
                    def ln:PresEnt (PresEnt.of("line"))
                    ln.ofBox = bi
                    push slideParts ln
                    part = ((array_length slideParts) - 1)
                } {
                    if ((c.kind != 4) && (c.kind != 5)) {
                        def bx:[double] (PresScene.boundsOf(c))
                        def b3:int 0
                        while ((b3 < (array_length bars)) && (part < 0)) {
                            def cb:EVGDrawCmd (itemAt bars b3)
                            if ((((itemAt bx 0) >= (cb.x - 3.0)) && (((itemAt bx 0) + (itemAt bx 2)) <= ((cb.x + cb.w) + 3.0))) && ((((itemAt bx 1) + (itemAt bx 3)) >= (cb.y - 12.0)) && ((itemAt bx 1) <= ((cb.y + cb.h) + 3.0)))) {
                                part = (base + b3)
                            }
                            b3 = (b3 + 1)
                        }
                    }
                }
            }
            push partOfCmd part
            k = (k + 1)
        }
        def d:int 0
        while (d < (array_length bars)) {
            def o:JVal (JVal.mkObj())
            if ((strlen (itemAt labels d)) > 0) {
                o.setStr("label" (itemAt labels d))
            }
            ; the value from the chart's data; else the number drawn on it
            def dv:[double] (PresChart.barValue(spec (itemAt labels d)))
            if ((array_length dv) > 0) {
                o.setNum("value" (itemAt dv 0))
            } {
                if ((strlen (itemAt values d)) > 0) {
                    o.set("value" (PresDeck.drawnValue((itemAt values d))))
                }
            }
            def be:PresEnt (itemAt slideParts (base + d))
            be.data = (o.toJson())
            if ((strlen (itemAt labels d)) > 0) {
                be.text = (itemAt labels d)
            }
            d = (d + 1)
        }
    }

    ; A value label as drawn ("1 234,5", "12 %"): its number when it reads
    ; as one, else the text itself.
    sfn drawnValue:JVal (t:string) {
        def digits:string ""
        def i:int 0
        def ok:boolean true
        def seen:boolean false
        while (i < (strlen t)) {
            def ch:string (substring t i (i + 1))
            if ((indexOf "0123456789" ch) >= 0) {
                digits = (digits + ch)
                seen = true
            } {
                if ((ch == ",") || (ch == ".")) {
                    digits = (digits + ".")
                } {
                    if ((ch == "-") || (ch == "−")) {
                        digits = (digits + "-")
                    } {
                        if (((ch != " ") && (ch != " ")) && (ch != " ")) {
                            if ((ch != "%") || (i != ((strlen t) - 1))) {
                                ok = false
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        if (ok && seen) {
            def v@(optional):double (to_double digits)
            if (!null? v) {
                return (JVal.mkNum((unwrap v)))
            }
        }
        return (JVal.mkStr(t))
    }

    ; A diagram's nodes and lines as parts (PresDiagram.partTags): each
    ; node by its id and label, each line by its ends. `bi` is its box.
    fn diagramParts:void (out:EVGDisplayList d:PresDiagram bi:int) {
        while ((array_length partOfCmd) < d.partFrom) {
            push partOfCmd -1
        }
        def tags:[string]
        def at:[int]
        def k:int 0
        while ((k < (array_length d.partTags)) && ((d.partFrom + k) < (array_length out.cmds))) {
            def tag:string (itemAt d.partTags k)
            def part:int -1
            if ((strlen tag) > 0) {
                def seen:int (indexOf tags tag)
                if (seen >= 0) {
                    part = (itemAt at seen)
                } {
                    def e:PresEnt (PresEnt.of("node"))
                    e.ofBox = bi
                    def name:string (substring tag 5 (strlen tag))
                    def label:string ""
                    if ((indexOf tag "node:") == 0) {
                        e.name = name
                        def ni:int 0
                        while (ni < (array_length d.nodes)) {
                            def nd:PresDNode (itemAt d.nodes ni)
                            if (nd.id == name) {
                                def ii:int 0
                                while (ii < (array_length nd.items)) {
                                    def it:SceneItem (itemAt nd.items ii)
                                    if ((it.kind == 1) && ((strlen it.text) > 0)) {
                                        label = (trim (label + " " + it.text))
                                    }
                                    ii = (ii + 1)
                                }
                            }
                            ni = (ni + 1)
                        }
                    } {
                        e.kind = "edge"
                        def ei:int 0
                        while (ei < (array_length d.edges)) {
                            def ed:PresDEdge (itemAt d.edges ei)
                            if (ed.id == name) {
                                if ((ed.from >= 0) && (ed.from < (array_length d.nodes))) {
                                    def fn0:PresDNode (itemAt d.nodes ed.from)
                                    e.from = fn0.id
                                }
                                if ((ed.to >= 0) && (ed.to < (array_length d.nodes))) {
                                    def tn0:PresDNode (itemAt d.nodes ed.to)
                                    e.to = tn0.id
                                }
                                def li:int 0
                                while (li < (array_length ed.labels)) {
                                    def lt:SceneItem (itemAt ed.labels li)
                                    if ((lt.kind == 1) && ((strlen lt.text) > 0)) {
                                        label = (trim (label + " " + lt.text))
                                    }
                                    li = (li + 1)
                                }
                            }
                            ei = (ei + 1)
                        }
                    }
                    e.text = label
                    if ((strlen label) > 0) {
                        e.data = ((JVal.mkObj()).setStr("label" label).toJson())
                    }
                    push slideParts e
                    part = ((array_length slideParts) - 1)
                    push tags tag
                    push at part
                }
            }
            push partOfCmd part
            k = (k + 1)
        }
    }

    ; The chart fences in a block, nested ones too (a chart inside a `:::`).
    fn readCharts:void (s:PresSlide n:MdNode) {
        if ((n.kind == "embed") && ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(n.info)))) == "vega")) {
            def u (new PresChartUse())
            u.source = n.literal
            u.srcStart = n.srcStart
            u.style = (trim (n.attrValue("chart-style")))
            if ((strlen u.style) == 0) {
                u.style = (trim (n.attrValue("style")))
            }
            push s.charts u
            ; a chart in a look: its faces asked of the page now
            def lk:string (this.chartLookFor(n.literal u.style))
            if ((strlen lk) > 0) {
                this.wantLookFaces((FlowLook.named(lk true)))
            }
            return
        }
        def i:int 0
        while (i < (n.childCount())) {
            this.readCharts(s (n.childAt(i)))
            i = (i + 1)
        }
    }

    ; When a chart's motion starts on its slide (0.0 for one not read).
    fn chartStart:double (s:PresSlide source:string) {
        def i:int 0
        while (i < (array_length s.charts)) {
            def u:PresChartUse (itemAt s.charts i)
            if ((u.source == source) && (u.start >= 0.0)) {
                return u.start
            }
            i = (i + 1)
        }
        return 0.0
    }

    ; Every picture the deck is given comes in here, from the editor's page
    ; and from the MCP server alike. A SmartArt file is stored as itself, at
    ; the natural size a diagram has before its Markdown says otherwise.
    fn addImage:boolean (name:string data:buffer contentType:string w:int h:int) {
        if (SaFile.isSmartArt(name contentType (SaFile.headOf(data)))) {
            if ((indexOf smartArtPaths name) < 0) {
                push smartArtPaths name
            }
            return (md.addImage(name data (SaFile.TYPE()) (SaFile.naturalW()) (SaFile.naturalH())))
        }
        return (md.addImage(name data contentType w h))
    }

    ; Another deck opened in this one's place: none of this one's pictures
    ; (nor its SmartArt files or SVG texts) is drawn, sized or exported as
    ; if it were the next one's. Its own come in again through addImage.
    fn clearImages:void () {
        md.clearFiles()
        def noPaths:[string]
        smartArtPaths = noPaths
        def p:[string]
        svgPaths = p
        def t:[string]
        svgTexts = t
        def b:[buffer]
        svgBytes = b
        def sm:[buffer]
        svgSmall = sm
        def c:[int]
        svgClean = c
    }

    ; --- SVG pictures as vectors in the exports ---------------------------------
    ; The slides draw an SVG picture from its PNG (web/picture.js); the page
    ; hands the SVG itself here too, with a small PNG for readers that cannot
    ; draw SVG. The PDF draws the SVG's paths (`svgVector`), the PPTX carries
    ; the SVG with the small PNG as its fallback.
    def svgPaths:[string]
    def svgTexts:[string]
    def svgBytes:[buffer]
    def svgSmall:[buffer]
    ; per path: 1 the PDF can draw it as paths, 0 it cannot, -1 not asked yet
    def svgClean:[int]

    fn addSvgPicture:void (name:string text:string bytes:buffer small:buffer) {
        def at:int (indexOf svgPaths name)
        if (at >= 0) {
            set svgTexts at text
            set svgBytes at bytes
            set svgSmall at small
            set svgClean at -1
            return
        }
        push svgPaths name
        push svgTexts text
        push svgBytes bytes
        push svgSmall small
        push svgClean -1
    }

    fn svgIndex:int (name:string) {
        return (indexOf svgPaths name)
    }

    ; Whether the PDF can draw the SVG at `name` as paths: EVG's importer
    ; (SvgParser) reads all of it — nothing refused (gradients, text, filters
    ; and the like are drawn from the PNG instead) and something to draw.
    fn svgVector:boolean (name:string) {
        def at:int (indexOf svgPaths name)
        if (at < 0) {
            return false
        }
        if ((itemAt svgClean at) < 0) {
            def doc:SvgDocument ((new SvgParser()).parse((itemAt svgTexts at)))
            def ok:int 0
            if ((((doc.hasErrors()) == false) && ((doc.hasWarnings()) == false)) && ((doc.itemCount()) > 0)) {
                ok = 1
            }
            set svgClean at ok
        }
        return ((itemAt svgClean at) == 1)
    }

    fn isSmartArtPath:boolean (path:string) {
        return ((indexOf smartArtPaths path) >= 0)
    }

    ; A picture reference that names a SmartArt file, with what its `{…}`
    ; says about the diagram.
    fn readSmartArt:void (s:PresSlide n:MdNode) {
        if ((array_length smartArtPaths) == 0) {
            return
        }
        def img:MdNode (MdLayout.loneImage(n))
        if (img.kind != "image") {
            return
        }
        def lay:MdLayout (this.layout())
        def path:string (lay.images.resolve(img.destination lay.docDir))
        if ((this.isSmartArtPath(path)) == false) {
            return
        }
        def u (new PresSmartArtUse())
        u.path = path
        u.srcStart = n.srcStart
        u.layout = (n.attrValue("layout"))
        u.colors = (n.attrValue("colors"))
        u.style = (n.attrValue("style"))
        u.sized = (((strlen (n.attrValue("width"))) > 0) || ((strlen (n.attrValue("height"))) > 0))
        push s.smartArts u
    }

    fn smartArtOf@(optional):PresSmartArtUse (s:PresSlide b:MdBox) {
        if ((b.kind != 4) || ((this.isSmartArtPath(b.imagePath)) == false)) {
            def none@(optional):PresSmartArtUse
            return none
        }
        def i:int 0
        while (i < (array_length s.smartArts)) {
            def u:PresSmartArtUse (itemAt s.smartArts i)
            if ((u.srcStart == b.srcStart) && (u.path == b.imagePath)) {
                def hit@(optional):PresSmartArtUse u
                return hit
            }
            i = (i + 1)
        }
        ; a reference whose block did not say anything: the file's own
        def plain (new PresSmartArtUse())
        plain.path = b.imagePath
        def p@(optional):PresSmartArtUse plain
        return p
    }

    ; Where a SmartArt diagram is laid out across, [x, w]: the whole content
    ; width when nothing sits beside it and its reference did not size it
    ; (PresDeck.diagramSpan, as for a diagram fence), else its own box. A
    ; row of steps fitted into a 16:9 box used a third of the slide.
    fn smartArtSpan:[double] (page:int b:MdBox u:PresSmartArtUse) {
        if u.sized {
            return ([] _:double (b.x b.w))
        }
        return (this.diagramSpan(page b))
    }

    ; --- <svg> written into the Markdown (MdSvg) -------------------------------
    ; The drawings the Markdown writes where they are shown, cleaned of
    ; anything that is not a drawing, that the picture store does not have
    ; yet. The page and the MCP server draw each into the store under its
    ; path ("/" + path), as they draw an SVG file, and the slide shows it.
    fn inlineSvgsMissing:[MdSvgUse] () {
        def out:[MdSvgUse]
        for (MdSvg.inDoc(md.edit.doc)) u:MdSvgUse i {
            def st:VfsStat (md.edit.imageStore.stat(("/" + u.path)))
            if (st.found == false) {
                push out u
            }
        }
        return out
    }

    ; --- screens of the shared Figma files (PresFigma) ---------------------------
    ; The figma: addresses the Markdown names whose drawn picture the store
    ; does not have yet. The page (or the server) draws each from the shared
    ; files into the store under `FigmaRef.pictureKey`, and the slide shows it.
    fn figmaMissing:[string] () {
        def out:[string]
        for (FigmaRef.inText(text)) dest:string i {
            def st:VfsStat (md.edit.imageStore.stat((FigmaRef.pictureKey(dest))))
            if (st.found == false) {
                push out dest
            }
        }
        return out
    }

    ; A `:::` line that closed no container and is shown as text
    ; (`MdContainer.strayFences`): most often `::: col` blocks inside a
    ; `::: columns` with as many colons, whose first `:::` closed the outer
    ; one. A sentence per slide it is on.
    fn fenceNotes:[string] () {
        def out:[string]
        def seen:[int]
        for (MdContainer.strayFences(md.edit.doc md.edit.source)) at:int fi {
            def page:int (this.pageOfOffset(at))
            if ((indexOf seen page) >= 0) {
                continue
            }
            push seen page
            def where:string ("slide " + (to_string (page + 1)))
            if ((page >= 0) && (page < (array_length slides))) {
                def t:string ((itemAt slides page).title)
                if ((strlen t) > 0) {
                    where = ("slide \"" + t + "\"")
                }
            }
            push out ("A `:::` line on " + where + " closes no container and is shown as text. A `:::` closes the outer container first, so `::: col` blocks inside `::: columns` need more colons on the outer one: `:::: columns` … `::::` (or leave the wrapper out: `::: col` blocks one after another are columns too).")
        }
        return out
    }

    ; What a heading's `{…}` had that could not be read (MdAttrs.headingAttrs):
    ; the good attributes were applied and the group is out of the title,
    ; and each left-out part is a sentence naming the slide.
    fn headingAttrNotes:[string] () {
        def out:[string]
        for (MdAttrs.notedHeadings(md.edit.doc)) h:MdNode hi {
            def page:int (this.pageOfOffset(h.srcStart))
            def where:string ("slide " + (to_string (page + 1)))
            if ((page >= 0) && (page < (array_length slides))) {
                def t:string ((itemAt slides page).title)
                if ((strlen t) > 0) {
                    where = ("slide \"" + t + "\"")
                }
            }
            for h.attrNotes note:string ni {
                push out ("The heading attributes on " + where + ": " + note + ".")
            }
        }
        return out
    }

    ; What the HTML in the Markdown does not show as written (a tag nobody
    ; draws, a style property nothing reads, a script handler or address),
    ; as sentences naming the slide (`MdLayout.htmlNotes`).
    fn htmlNotes:[string] () {
        def out:[string]
        def l:MdLayout (this.layout())
        def i:int 0
        while (i < (array_length l.htmlNotes)) {
            def where:string ""
            def at:int (itemAt l.htmlNoteSrc i)
            if (at >= 0) {
                def page:int (this.pageOfOffset(at))
                if ((page >= 0) && (page < (array_length slides))) {
                    def t:string ((itemAt slides page).title)
                    if ((strlen t) > 0) {
                        where = (" on slide \"" + t + "\"")
                    } {
                        where = (" on slide " + (to_string (page + 1)))
                    }
                }
            }
            push out ("HTML" + where + ": " + (itemAt l.htmlNotes i) + ".")
            i = (i + 1)
        }
        return out
    }

    ; What the SmartArt diagrams on the slides could not do as asked, as
    ; sentences for whoever wrote the deck: a file that is not a diagram, a
    ; layout or colour set the engine does not have, text that does not fit.
    fn smartArtNotes:[string] () {
        def out:[string]
        def l:MdLayout (this.layout())
        def i:int 0
        while (i < (array_length slides)) {
            def s:PresSlide (itemAt slides i)
            def where:string (" on slide " + (to_string (i + 1)))
            if ((strlen s.title) > 0) {
                where = (" on slide \"" + s.title + "\"")
            }
            def k:int 0
            while (k < (array_length s.smartArts)) {
                def u:PresSmartArtUse (itemAt s.smartArts k)
                def bi:int 0
                while (bi < (array_length l.boxes)) {
                    def b:MdBox (itemAt l.boxes bi)
                    if (((b.kind == 4) && (b.imagePath == u.path)) && (b.srcStart == u.srcStart)) {
                        def span:[double] (this.smartArtSpan(b.page b u))
                        def r:SaResult (PresSmartArt.laidOut(u md figStyle smartArtCache (itemAt span 1) b.h))
                        def name:string (substring u.path 1 (strlen u.path))
                        if (r.ok == false) {
                            push out ("The SmartArt " + name + where + " is not shown: " + r.error + ".")
                        }
                        def w:int 0
                        while (w < (array_length r.warnings)) {
                            push out ("The SmartArt " + name + where + ": " + (itemAt r.warnings w) + ".")
                            w = (w + 1)
                        }
                    }
                    bi = (bi + 1)
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        return out
    }

    ; The diagram of fence `n` on slide s (page `page`), laid out for a room
    ; roomW x roomH (the shape picks among the layouts), its scene `width`
    ; slide units wide, with the fence's options. Not `ok` when it cannot
    ; be drawn. `turn`: a class or state diagram may be turned too
    ; (`PresDiagram.turned`), as a flowchart always may.
    fn diagramIn:PresDiagram (s:PresSlide n:MdNode page:int notation:string classic:boolean width:double roomW:double roomH:double turn:boolean) {
        def lay:MdLayout (this.layout())
        def look:string "default"
        if (classic && (! (PresDiagram.isLight(lay.style.pageBackground)))) {
            look = "dark"
        }
        def base:PresDiagram (this.diagramFor(notation n.literal width look))
        if (! base.ok) {
            return base
        }
        ; The layout that draws largest in the room it has, among: the
        ; direction as written, the other direction, and each of them
        ; wrapped by the flow engine (a top-to-bottom chain into columns, a
        ; left-to-right one into rows: a long chain is a strip either way
        ; round).
        ; For a tour the room counts as at most half again as wide as it is
        ; tall, so a squarer shape wins over a strip that fits a wide slide.
        ; `{layout=keep}` keeps what was written, and so does a diagram
        ; whose author placed its boxes (`PresDiagram.arranged`).
        if (((n.attrValue("layout")) != "keep") && ((PresDiagram.arranged(notation n.literal)) == false)) {
            def aspect:double 1.5
            if (roomH > 0.0) {
                aspect = (roomW / roomH)
            }
            ; Toured, the camera goes in close, and a squarer shape reads
            ; better; shown whole, the room's own shape decides, so the
            ; diagram is as large as the slide allows.
            def most:double 4.0
            if ((n.attrValue("tour")) == "on") {
                most = 1.5
            }
            ; the room's own shape, which the whole diagram is drawn in
            ; before and after a tour
            def whole:double aspect
            if (whole > 4.0) { whole = 4.0 }
            if (whole < 0.6) { whole = 0.6 }
            if (aspect > most) { aspect = most }
            if (aspect < 0.6) { aspect = 0.6 }
            def cands:[PresDiagram]
            def texts:[string]
            push cands base
            push texts n.literal
            def other:string (PresDiagram.flipped(notation n.literal))
            if (((strlen other) == 0) && turn) {
                other = (PresDiagram.turned(notation n.literal))
            }
            if ((strlen other) > 0) {
                def alt:PresDiagram (this.diagramFor(notation other width look))
                if alt.ok {
                    push cands alt
                    push texts other
                }
            }
            ; each, cut by the flow engine for the room's shape
            def ci:int 0
            def m:int (array_length cands)
            while (ci < m) {
                def wr:PresDiagram (this.diagramAs(notation (itemAt texts ci) width aspect look))
                if wr.ok {
                    push cands wr
                }
                ci = (ci + 1)
            }
            ; A toured diagram prefers the squarer shape, but not at the
            ; cost of the whole: one drawn at less than three quarters of
            ; the size another draws at in the room is not a candidate
            ; (a loop held top to bottom by the tour's shape was 18 px
            ; text in a quarter of the slide).
            def bestWhole:double 0.0
            def cw:int 0
            while (cw < (array_length cands)) {
                def c1:PresDiagram (itemAt cands cw)
                if ((c1.readability(whole)) > bestWhole) {
                    bestWhole = (c1.readability(whole))
                }
                cw = (cw + 1)
            }
            def bf:double -1.0
            def cj:int 0
            while (cj < (array_length cands)) {
                def c2:PresDiagram (itemAt cands cj)
                if ((c2.readability(whole)) >= (bestWhole * 0.75)) {
                    if ((bf < 0.0) || ((c2.readability(aspect)) > (bf * 1.02))) {
                        base = c2
                        bf = (c2.readability(aspect))
                    }
                }
                cj = (cj + 1)
            }
        }
        ; the options are the fence's, the scene is shared
        def d (new PresDiagram())
        d.ok = true
        d.worldX = base.worldX
        d.worldY = base.worldY
        d.worldW = base.worldW
        d.worldH = base.worldH
        d.nodes = base.nodes
        d.edges = base.edges
        d.straight = base.straight
        d.rest = base.rest
        d.scene = base.scene
        ; what `readShapes` read off the shared scene: without the boxes'
        ; text size a line's name had no floor and no cap (`labelSizeFor`),
        ; and shrank to half its size to find a place, 15 px on a slide
        d.boxText = base.boxText
        ; The tour is the viewer's to start (▶ beside the zoom, T when
        ; presenting); `{tour=on}` starts it with the slide. Without it the
        ; whole diagram is shown, as large as it fits.
        d.tour = ((n.attrValue("tour")) == "on")
        ; A sequence diagram is read top to bottom, message by message; its
        ; "nodes" are lifelines, and a tour from one to the next would zoom
        ; into a thin line. It is shown whole, with no choices to make.
        def seq:boolean base.straight
        d.canTour = (seq == false)
        if seq {
            d.tour = false
        }
        d.ball = ((n.attrValue("ball")) != "off")
        if (n.hasAttr("zoom")) {
            d.zoom = (PresDeck.num((n.attrValue("zoom")) 3.0))
        }
        if (((n.attrValue("style")) == "sketch") || (((strlen (n.attrValue("style"))) == 0) && (docDiagramStyle == "sketch"))) {
            d.style = "sketch"
        }
        if classic {
            d.style = "classic"
            d.tour = false
            d.canTour = false
            d.ball = false
        }
        d.choose = ((n.attrValue("choose")) != "off")
        if seq {
            d.choose = false
        }
        def paper:string (PresDeck.paperOn(lay page))
        d.setPalette(paper (this.themeColour("diagram" "accent-color")) (this.themeColour("diagram" "color")))
        d.rimFade = (this.flatGround(s))
        ; `{style=mermaid}` and the other RangerFlow looks; their faces are
        ; asked of the page (`wantedFaces`) and drawn once it has them
        ; with none of its own, the document's (`style:` in the front matter)
        def lookName:string (trim (n.attrValue("style")))
        if ((strlen lookName) == 0) {
            lookName = docDiagramStyle
        }
        if ((! classic) && (FlowLook.knows(lookName))) {
            d.haveFaces = haveFaces
            d.useLook(lookName)
            this.wantLookFaces(d.look)
        }
        return d
    }

    fn readDiagram:void (s:PresSlide n:MdNode page:int) {
        if (n.kind != "embed") {
            return
        }
        def notation:string (MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(n.info))))
        if (((((strlen notation) == 0) || (notation == "vega")) || (notation == "figure")) || (notation == "app")) {
            return
        }
        ; `{diagram=classic}`: the document's own drawing, still, in the
        ; slide's colours (the engine's dark look on a dark slide) and as
        ; large as the room allows, chosen like the others
        def classic:boolean ((n.attrValue("diagram")) == "classic")
        def bi:int (this.embedBoxAt(page n.literal n.srcStart))
        if (bi < 0) {
            return
        }
        def lay:MdLayout (this.layout())
        def box:MdBox (itemAt lay.boxes bi)
        def room0:double (this.roomBelow(page box))
        def span0:[double] (this.diagramSpan(page box))
        def d:PresDiagram (this.diagramIn(s n page notation classic box.w (itemAt span0 1) room0 false))
        if (! d.ok) {
            return
        }
        def oi:int (this.takeOldUse(n.literal))
        if (oi >= 0) {
            def was:PresDiaUse (itemAt oldUses oi)
            remove_index oldUses oi
            d.takeChoices(was.diagram)
            ; a tour the viewer started goes on through an edit
            if (was.diagram.userTour && d.canTour) {
                d.tour = true
                d.userTour = true
            }
            d.plan()
            d.takeView(was.diagram)
        } {
            d.plan()
        }
        def u (new PresDiaUse())
        u.diagram = d
        u.source = n.literal
        u.srcStart = n.srcStart
        u.fence = n
        u.page = page
        u.notation = notation
        u.classic = classic
        def span:[double] (this.diagramSpan(page box))
        u.bx = (itemAt span 0)
        u.by = box.y
        u.bw = (itemAt span 1)
        u.bh = (this.roomBelow(page box))
        push s.diagrams u
    }

    ; The theme, for the deck and for the Markdown editor it lays out with,
    ; and no layout of its own: the next rebuild is the one layout.
    ; `MarkdownWeb.setStyleSheet` (and `addTheme`) lays the document out at
    ; once, as a continuous page the width of ITS view rather than as slides,
    ; and that pass drew every chart again at that width; the cache keeps a
    ; chart at one width, so the slides' pass that followed drew them all
    ; once more. A theme edit cost two layouts and every chart twice.
    ; "print" lays the deck out for paper: the stylesheet's `@media print`
    ; rules, its printed page and bleed. Back to "screen" after the file.
    fn setMedia:void (m:string) {
        def e:MarkdownEdit md.edit
        if (e.media == m) {
            return
        }
        e.media = m
        this.setTheme(themeCss)
        e.stale = true
        this.rebuild()
    }

    ; Whether the stylesheet says anything about paper.
    fn hasPrint:boolean () {
        return (md.edit.sheet.hasPrint())
    }

    ; What the sheet says that the slides do not use, one line each
    ; (PresCssSupport): the MCP report's warnings.
    def cssNotes:[string]

    fn lintCss:void (css:string) {
        cssNotes = (PresCssSupport.lines(css 12))
    }

    fn setStyleSheet:void (css:string) {
        ; the lint reads the CSS only, its `@effect` blocks blanked
        this.lintCss((this.takeEffects(css)))
        def own:string (this.useFonts(css))
        this.setTheme(own)
        md.edit.setStyleSheet(own)
    }

    ; What the sheet's `font-family` lists come to (PresFonts): the CSS with
    ; each one the first face there is, the faces that are not loaded with
    ; every page asked of it, and a line on what could not be had.
    def fontNote:string ""

    fn useFonts:string (css0:string) {
        ; the theme's own effects (`@effect … { … }`) are not CSS: lifted out
        ; here, where every way a theme arrives passes (FxLang)
        def css:string (this.takeEffects(css0))
        def f:PresFontsOut (PresFonts.read(css))
        fontNote = (PresFonts.note(f))
        for f.faces face:string fi {
            if ((indexOf ("," + wantFaces + ",") ("," + face + ",")) < 0) {
                if ((strlen wantFaces) > 0) {
                    wantFaces = (wantFaces + ",")
                }
                wantFaces = (wantFaces + face)
            }
        }
        return f.css
    }

    ; A named template (`theme: aurora` in the front matter), without a layout.
    fn addTemplate:void (name:string css:string) {
        md.edit.addTheme(name css)
    }

    ; Charts and figures the last rebuild left drawn under old defaults.
    fn redrawPending:int () {
        return md.edit.layout.embeds.pending
    }

    ; Charts and figures the last rebuild left undrawn because they were out
    ; of view.
    fn undrawn:int () {
        return md.edit.layout.embeds.deferred
    }

    ; Of those, and of the ones drawn under old defaults, how many start in
    ; the source range from..to.
    fn undrawnIn:int (from:int to:int) {
        return (md.edit.layout.embeds.undrawnIn(from to))
    }

    ; The theme's CSS as it was given, read again when the medium changes.
    def themeCss:string ""

    ; ------------------------------------------------------------------
    ; The deck's own effects (FxLang): ```fx blocks in the text and
    ; `@effect` blocks in the theme, compiled on every rebuild. A deck's
    ; block wins over the theme's of the same name.
    ; ------------------------------------------------------------------
    def fx:FxLang (new FxLang())
    ; the theme's effect text: the CSS with all but its `@effect` blocks
    ; blanked, so a line in it is the line in the theme
    def themeFx:string ""

    ; The CSS with its `@effect … { … }` blocks blanked (newlines kept, so
    ; every line and offset stays where the editor has it); the blocks go to
    ; `themeFx`.
    fn takeEffects:string (css:string) {
        def n:int (strlen css)
        def keep:string ""
        def fxOut:string ""
        def copied:int 0
        def i:int 0
        def any:boolean false
        while (i < n) {
            def c:int (charAt css i)
            ; a comment is skipped whole
            if (((c == 47) && ((i + 1) < n)) && ((charAt css (i + 1)) == 42)) {
                def close:int (indexOf (substring css (i + 2) n) "*/")
                if (close < 0) {
                    i = n
                } {
                    i = ((i + 4) + close)
                }
                continue
            }
            if ((c == 64) && (((i + 7) <= n) && ((substring css i (i + 7)) == "@effect"))) {
                ; to the brace that closes the block
                def j:int i
                while ((j < n) && ((charAt css j) != 123)) {
                    j = (j + 1)
                }
                def depth:int 0
                while (j < n) {
                    def cj:int (charAt css j)
                    if (cj == 123) {
                        depth = (depth + 1)
                    }
                    if (cj == 125) {
                        depth = (depth - 1)
                        if (depth == 0) {
                            j = (j + 1)
                            break
                        }
                    }
                    j = (j + 1)
                }
                keep = ((keep + (substring css copied i)) + (PresSource.blank(css i j)))
                fxOut = ((fxOut + (PresSource.blank(css copied i))) + (substring css i j))
                copied = j
                i = j
                any = true
                continue
            }
            i = (i + 1)
        }
        if (any == false) {
            themeFx = ""
            return css
        }
        keep = (keep + (substring css copied n))
        themeFx = fxOut
        return keep
    }

    fn compileFx:void () {
        def c (new FxLang())
        def k:int 0
        while (k < (array_length src.blocks)) {
            def blk:PresBlock (itemAt src.blocks k)
            if (blk.kind == "fx") {
                c.run(blk.body blk.bodyLine)
            }
            k = (k + 1)
        }
        def deckErrors:int (array_length c.errors)
        if ((strlen themeFx) > 0) {
            c.themeFrom = deckErrors
            c.keepFirst = true
            c.run(themeFx 1)
        }
        fx = c
        fxJsonText = ""
    }

    ; The deck's own effect of that name, if it has one.
    fn ownEffect@(optional):FxEffect (name:string) {
        def i:int 0
        while (i < (array_length fx.effects)) {
            def e:FxEffect (itemAt fx.effects i)
            if (e.name == name) {
                def r@(optional):FxEffect e
                return r
            }
            i = (i + 1)
        }
        def none@(optional):FxEffect
        return none
    }

    ; The deck's effects for the page to register (FxLang.json), made once
    ; per compile.
    def fxJsonText:string ""

    fn effectsJson:string () {
        if ((strlen fxJsonText) == 0) {
            fxJsonText = (fx.json())
        }
        return fxJsonText
    }

    ; What is wrong in the deck's effects, a line each, for the report.
    fn fxNotes:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length fx.errors)) {
            def where:string "In a ```fx block, "
            if (i >= fx.themeFrom) {
                where = "In the theme's @effect, "
            }
            push out (where + (itemAt fx.errors i) + ".")
            i = (i + 1)
        }
        ; `{fx=…}` under a block naming no effect: the block draws none
        def l:MdLayout (this.layout())
        def b:int 0
        while (b < (array_length l.boxes)) {
            def bx:MdBox (itemAt l.boxes b)
            if (bx.kind == 6) {
                def own@(optional):FxEffect (this.ownEffect(bx.embedKind))
                if ((null? own) && ((FxLang.isBuiltin(bx.embedKind)) == false)) {
                    push out ("Slide " + (to_string (bx.page + 1)) + ": {fx=" + bx.embedKind + "} under a block names no effect (the deck's own from ```fx, or a built-in one); the block is drawn without it.")
                }
            }
            b = (b + 1)
        }
        return out
    }

    fn setTheme:void (css:string) {
        themeCss = css
        clear themeKeys
        clear themeVals
        clear ruleKeys
        clear ruleVals
        ; `@media print { … }` counts only for paper, `@media screen` only on
        ; the stage (MdCss.splitMedia: the rest, print, screen)
        def parts:[string] (MdCss.splitMedia(css))
        def medium:string (itemAt parts 2)
        if (md.edit.media == "print") {
            medium = (itemAt parts 1)
        }
        this.readRules((((itemAt parts 0) + "\n") + medium))
        this.readPresComment(css)
        ; `deck { fx: starfield; fx-hue: 280 }`: the theme's effect as CSS,
        ; over the older comment
        def r:int 0
        while (r < (array_length ruleKeys)) {
            def rk:string (itemAt ruleKeys r)
            if (((indexOf rk "deck/fx") == 0) || ((rk == "deck/warm") || (rk == "deck/accent"))) {
                def rv:string (itemAt ruleVals r)
                ; `fx: none`: no effect, whatever the comment says
                if ((rk == "deck/fx") && (rv == "none")) {
                    rv = ""
                }
                this.putTheme((substring rk 5 (strlen rk)) rv)
            }
            r = (r + 1)
        }
    }

    fn putTheme:void (key:string value:string) {
        def i:int 0
        while (i < (array_length themeKeys)) {
            if ((itemAt themeKeys i) == key) {
                set themeVals i value
                return
            }
            i = (i + 1)
        }
        push themeKeys key
        push themeVals value
    }

    ; The older `/* pres: fx=starfield fx-hue=280 */` comment, which themes
    ; saved before the `deck` rule still carry.
    fn readPresComment:void (css:string) {
        def at:int (indexOf css "/* pres:")
        if (at < 0) {
            return
        }
        def rest:string (substring css (at + 8) (strlen css))
        def end:int (indexOf rest "*/")
        if (end < 0) {
            return
        }
        def body:string (substring rest 0 end)
        ; key=value pairs separated by spaces or newlines
        def n:int (strlen body)
        def i:int 0
        while (i < n) {
            while ((i < n) && (((charAt body i) == 32) || (((charAt body i) == 10) || ((charAt body i) == 13)))) {
                i = (i + 1)
            }
            def st:int i
            while ((i < n) && (((charAt body i) != 32) && (((charAt body i) != 10) && ((charAt body i) != 13)))) {
                i = (i + 1)
            }
            if (i > st) {
                def pair:string (substring body st i)
                def eq:int (indexOf pair "=")
                if (eq > 0) {
                    push themeKeys (substring pair 0 eq)
                    push themeVals (substring pair (eq + 1) (strlen pair))
                }
            }
        }
    }

    ; `chart { color; accent-color }` and `diagram { … }` in the theme: the
    ; stage's own selectors, which the markdown module does not know and
    ; leaves alone. Kept as "selector/property" = value.
    def ruleKeys:[string]
    def ruleVals:[string]

    fn readRules:void (css0:string) {
        ; comments out first: a `{` in one is not a rule
        def css:string ""
        def n0:int (strlen css0)
        def p:int 0
        while (p < n0) {
            def rest:string (substring css0 p n0)
            def c0:int (indexOf rest "/*")
            if (c0 < 0) {
                css = (css + rest)
                p = n0
            } {
                css = (css + (substring rest 0 c0))
                def after:string (substring rest (c0 + 2) (strlen rest))
                def c1:int (indexOf after "*/")
                if (c1 < 0) {
                    p = n0
                } {
                    p = ((p + c0) + (c1 + 4))
                }
            }
        }
        def n:int (strlen css)
        def at:int 0
        while (at < n) {
            def tail:string (substring css at n)
            def open:int (indexOf tail "{")
            if (open < 0) {
                return
            }
            def tail2:string (substring tail (open + 1) (strlen tail))
            def close:int (indexOf tail2 "}")
            if (close < 0) {
                return
            }
            def sels:string (trim (substring tail 0 open))
            def body:string (substring tail2 0 close)
            def selList:[string] (strsplit sels ",")
            def s:int 0
            while (s < (array_length selList)) {
                def sel0:string (trim (itemAt selList s))
                ; `#anchor chart`: the charts under one heading
                def sel:string (PresDeck.scopedSel(sel0))
                if (((((sel == "chart") || (sel == "diagram")) || ((indexOf sel "#") == 0)) || (sel == "page")) || ((sel == "figure") || ((sel == "document") || (sel == "deck")))) {
                    def decls:[string] (strsplit body ";")
                    def d:int 0
                    while (d < (array_length decls)) {
                        def decl:string (itemAt decls d)
                        def colon:int (indexOf decl ":")
                        if (colon > 0) {
                            push ruleKeys (sel + "/" + (trim (substring decl 0 colon)))
                            push ruleVals (trim (substring decl (colon + 1) (strlen decl)))
                        }
                        d = (d + 1)
                    }
                }
                s = (s + 1)
            }
            at = (((at + open) + 1) + (close + 1))
        }
    }

    ; A look's faces, asked of the page (once each).
    fn wantLookFaces:void (look:FlowLook) {
        def fs:[string] (look.faces())
        def fi:int 0
        while (fi < (array_length fs)) {
            def f:string (itemAt fs fi)
            if ((indexOf ("," + wantFaces + ",") ("," + f + ",")) < 0) {
                if ((strlen wantFaces) > 0) {
                    wantFaces = (wantFaces + ",")
                }
                wantFaces = (wantFaces + f)
            }
            fi = (fi + 1)
        }
    }

    ; The look a chart is drawn in ("" for the stage's own dressings): the
    ; chart's own choice (`presStyle`, the chart window's "Style on slide")
    ; when it made one, else the document's `style:`, else the theme's
    ; `chart { chart-style }`.
    fn chartLookName:string (spec:string) {
        return (this.chartLookFor(spec (this.blockChartStyle(spec))))
    }

    ; …with `block` the fence's own `{chart-style=…}`, under the chart
    ; window's choice and over the document's
    fn chartLookFor:string (spec:string block:string) {
        def own:string (PresChart.specString(spec "presStyle"))
        if ((strlen own) == 0) {
            own = block
        }
        return (PresChart.lookName(own docChartStyle (this.themeRule("chart" "chart-style"))))
    }

    ; The style written under a chart's fence (`{chart-style=neon}`), "" for
    ; none: the deck was read for its charts (`readCharts`).
    fn blockChartStyle:string (spec:string) {
        for slides sl:PresSlide si {
            for sl.charts u:PresChartUse ui {
                if (u.source == spec) {
                    return u.style
                }
            }
        }
        return ""
    }

    ; The charts whose `{chart-style=…}` names neither a dressing (flat,
    ; forge, neon, glass) nor a look: drawn as if it said nothing.
    fn chartStyleNotes:[string] () {
        def out:[string]
        for slides sl:PresSlide si {
            for sl.charts u:PresChartUse ui {
                if (((strlen u.style) > 0) && (((PresChart.isDressing(u.style)) == false) && ((FlowLook.knows(u.style)) == false))) {
                    def where:string ("slide " + (to_string (si + 1)))
                    if ((strlen sl.title) > 0) {
                        where = ("slide \"" + sl.title + "\"")
                    }
                    push out ("The chart on " + where + " has style \"" + u.style + "\", which is not one: flat, forge, neon, glass, or a look (mermaid, jurassic, cartoon, romantic).")
                }
            }
        }
        return out
    }

    ; ----------------------------------------------------------------------
    ; A slide's own data
    ; ----------------------------------------------------------------------
    ;
    ; `## Revenue {jira=ACME-412}`: what the engine does not claim belongs to
    ; the document (MdSlideMeta). Read back here so a host — the editor, an
    ; export, an assistant over MCP — can ask which slide carries what.

    fn slideMetaValue:string (i:int key:string) {
        if ((i < 0) || (i >= (array_length slides))) { return "" }
        def s:PresSlide (itemAt slides i)
        return (s.meta.value(key))
    }

    ; The slides carrying `key`, and `value` when one is given ("" = any).
    fn slidesWithMeta:[int] (key:string value:string) {
        def out:[int]
        def want:string (trim value)
        for slides sl:PresSlide si {
            if (sl.meta.has(key)) {
                if (((strlen want) == 0) || ((sl.meta.value(key)) == want)) {
                    push out si
                }
            }
        }
        return out
    }

    ; Every key any slide carries, each once, in the order they appear.
    fn metaKeysUsed:[string] () {
        def out:[string]
        for slides sl:PresSlide si {
            def i:int 0
            while (i < (sl.meta.count())) {
                def k:string (itemAt sl.meta.keys i)
                if ((indexOf out k) < 0) {
                    push out k
                }
                i = (i + 1)
            }
        }
        return out
    }

    ; The presentation's own data: front matter keys the engine does not
    ; read (`jira: ACME-400`). A slide's own value goes over it in `{jira}`.
    fn deckMeta:MdSlideMeta () {
        def l:MdLayout (this.layout())
        return l.deckMeta
    }

    ; One line per slide that carries data, and one per key that looks like a
    ; misspelt engine key — the report's business (MdLayout keeps both).
    fn slideMetaNotes:[string] () {
        def l:MdLayout (this.layout())
        return (l.slideMetaNotes())
    }

    fn slideMetaWarnings:[string] () {
        def l:MdLayout (this.layout())
        return (l.slideMetaWarnings())
    }

    ; A chart's commands from `before` on, dressed for the stage: in a look,
    ; or the theme's way (`PresChart.dress`).
    ; The slide a chart is being dressed on, for its paper (a slide rule can
    ; give one slide another, `.dark page`); -1: the theme's.
    def chartPage:int -1

    fn dressChart:void (out:EVGDisplayList before:int t:double still:boolean spec:string page:int) {
        chartPage = page
        this.dressChartOn(out before t still spec)
        chartPage = -1
    }

    fn chartPaper:string () {
        def l:MdLayout (this.layout())
        if (chartPage >= 0) {
            return (PresDeck.paperOn(l chartPage))
        }
        return l.style.pageBackground
    }

    fn dressChartOn:void (out:EVGDisplayList before:int t:double still:boolean spec:string) {
        def lk:string (this.chartLookName(spec))
        if ((strlen lk) > 0) {
            def l:MdLayout (this.layout())
            def paper:string (this.chartPaper())
            if ((strlen paper) == 0) {
                paper = "#ffffff"
            }
            def pc:EVGColor (EVGColor.parse(paper))
            def lum:double ((((to_double (pc.red())) * 0.299) + ((to_double (pc.green())) * 0.587)) + ((to_double (pc.blue())) * 0.114))
            def look:FlowLook (FlowLook.named(lk (lum > 150.0)))
            this.wantLookFaces(look)
            PresChart.dressLook(out before t still look spec paper l haveFaces)
            return
        }
        ; a block's own dressing (`{chart-style=neon}`) over the document's
        ; and the theme's; the chart window's (`presStyle`) still wins
        def words:string (this.chartStyleWords())
        def block:string (this.blockChartStyle(spec))
        if (PresChart.isDressing(block)) {
            def ws:[string] (strsplit (trim words) " ")
            def rest:string ""
            def wi:int 1
            while (wi < (array_length ws)) {
                rest = (rest + " " + (itemAt ws wi))
                wi = (wi + 1)
            }
            words = (block + rest)
        }
        PresChart.dress(out before t still (this.themeColour("chart" "accent-color")) (this.themeColour("chart" "color")) spec words)
    }

    ; The theme's chart-style and chart-effects, and "dark" on a dark slide
    ; (black marks are then drawn light, not left invisible).
    fn chartStyleWords:string () {
        def w:string ((this.themeRule("chart" "chart-style")) + " " + (this.themeRule("chart" "chart-effects")))
        ; the document's dressing (`chart-style: neon`) goes over the theme's
        if (PresChart.isDressing(docChartStyle)) {
            w = (docChartStyle + " " + (this.themeRule("chart" "chart-effects")))
        }
        def st:MdStyle (this.layout()).style
        def paper:string (this.chartPaper())
        def isDark:boolean false
        if ((strlen paper) > 0) {
            def c:EVGColor (EVGColor.parse(paper))
            def lum:double ((((to_double (c.red())) * 0.299) + ((to_double (c.green())) * 0.587)) + ((to_double (c.blue())) * 0.114))
            if (lum < 110.0) {
                w = (w + " dark")
                isDark = true
            }
        }
        ; the labels' colour: the chart rule's `label-color`, else (`contrast:
        ; auto`) the page's own text colour on a light slide
        def lc:string (trim (this.themeRule("chart" "label-color")))
        def contrast:string (trim (this.themeRule("chart" "contrast")))
        if (((strlen lc) == 0) && ((isDark == false) && (contrast != "off"))) {
            lc = st.textColor
        }
        if (((strlen lc) > 0) && ((indexOf lc " ") < 0)) {
            w = (w + " label=" + lc)
        }
        return w
    }

    ; "#mihin-raha-menee chart" as "#mihin-raha-menee", "#a list" as it is,
    ; other selectors as they are; "" for any other "#…".
    sfn scopedSel:string (sel:string) {
        if ((indexOf sel "#") != 0) {
            return sel
        }
        def parts:[string] (strsplit sel " ")
        def words:[string]
        def i:int 0
        while (i < (array_length parts)) {
            def w:string (trim (itemAt parts i))
            if ((strlen w) > 0) {
                push words w
            }
            i = (i + 1)
        }
        if (((array_length words) == 2) && ((itemAt words 1) == "chart")) {
            return (itemAt words 0)
        }
        ; "#anchor list": the lists under that heading (`list-style`)
        if (((array_length words) == 2) && ((itemAt words 1) == "list")) {
            return ((itemAt words 0) + " list")
        }
        return ""
    }

    ; A length's number: "18px", "18pt" and "18" are 18; "" when there is
    ; none. "18pxpx" or "18 apples" is not a length, and is read as nothing,
    ; the way the cascade reads it — it used to be read as 18, so a chart
    ; drew what the slides ignored.
    sfn lengthOf:string (v:string) {
        def t:string (trim v)
        def i:int 0
        def n:int (strlen t)
        while ((i < n) && ((((charAt t i) >= 48) && ((charAt t i) <= 57)) || ((charAt t i) == 46))) {
            i = (i + 1)
        }
        def u:string (MdChar.lower((trim (substring t i n))))
        if ((u != "") && ((u != "px") && (u != "pt"))) {
            return ""
        }
        return (substring t 0 i)
    }

    ; A length the theme states for `what`, as lengthOf reads it, held to
    ; its safety range against the slide (`MdCssLimits`): `chart {
    ; font-size: 2020px }` draws the chart's labels no taller than the
    ; slide. The sheet itself keeps what it says.
    fn themeLength:string (what:string sel:string prop:string) {
        def fs:string (PresDeck.lengthOf((this.themeRule(what prop))))
        if ((strlen fs) == 0) { return "" }
        def d@(optional):double (str2double fs)
        if (null? d) { return "" }
        def v:double (unwrap d)
        def c:double (MdCssLimits.clamp(prop sel v pageW pageH))
        if (c == v) { return fs }
        return (VlJson.formatNumber(c 1))
    }

    ; The chart defaults a rule states, as the JSON the markdown module lays
    ; the charts over (MdVegaRender.withDefaults): `font-size` the axis and
    ; legend labels (their titles one larger), `title-font-size` and
    ; `title-gap` the chart's title, `padding` the room round it. `key` is
    ; "chart" for every chart or "#anchor" for the charts under one heading;
    ; `roomy` adds the presentation's own defaults under the stated ones.
    fn chartDefaults:string (key:string roomy:boolean) {
        def fs:string (this.themeLength(key "chart" "font-size"))
        def tfs:string (this.themeLength(key "chart" "title-font-size"))
        def tg:string (this.themeLength(key "chart" "title-gap"))
        def pad:string (this.themeLength(key "chart" "padding"))
        if roomy {
            if ((strlen fs) == 0) { fs = "15" }
            if ((strlen tfs) == 0) { tfs = "22" }
            if ((strlen tg) == 0) { tg = "18" }
            if ((strlen pad) == 0) { pad = "14" }
        }
        def cfg:string ""
        if ((strlen tfs) > 0) {
            cfg = (cfg + "\"fontSize\": " + tfs)
        }
        if ((strlen tg) > 0) {
            if ((strlen cfg) > 0) { cfg = (cfg + ", ") }
            cfg = (cfg + "\"offset\": " + tg)
        }
        def parts:string ""
        if ((strlen cfg) > 0) {
            parts = ("\"title\": {" + cfg + "}")
        }
        if ((strlen fs) > 0) {
            def f:double (?? (str2double fs) 12.0)
            def ft:string (VlJson.formatNumber((f + 1.0) 1))
            def guide:string ("{\"labelFontSize\": " + fs + ", \"titleFontSize\": " + ft + "}")
            if ((strlen parts) > 0) { parts = (parts + ", ") }
            ; …and a facet's headers (its panes' names) as large: Vega's 11
            ; came out at 17 px on a 1080 screen under the panes' scaling
            parts = (parts + "\"axis\": " + guide + ", \"legend\": " + guide + ", \"header\": " + guide)
            ; value labels (a `text` layer) as large as the axis labels:
            ; Vega's 11 read small beside them (Tero's cloud run 2026-10-06)
            if roomy {
                parts = (parts + ", \"text\": {\"fontSize\": " + fs + "}")
            }
        }
        ; every chart's: the deck's numbers and colours (`chartLook`)
        if roomy {
            def look:string (this.chartLook())
            if ((strlen look) > 0) {
                if ((strlen parts) > 0) { parts = (parts + ", ") }
                parts = (parts + look)
            }
        }
        def out:string ""
        if ((strlen parts) > 0) {
            out = ("\"config\": {" + parts + "}")
        }
        if ((strlen pad) > 0) {
            if ((strlen out) > 0) { out = (out + ", ") }
            ; a slide's chart keeps a little more air over it, under the
            ; heading: at the padding all round it sat close to the title
            ; (Tero's chart test 2026-10-07)
            if (roomy && ((strlen (this.themeLength(key "chart" "padding"))) == 0)) {
                def p0:double (?? (str2double pad) 14.0)
                def side:string (VlJson.formatNumber(p0 1))
                def over:string (VlJson.formatNumber((p0 + 8.0) 1))
                out = (out + "\"padding\": {\"left\": " + side + ", \"right\": " + side + ", \"top\": " + over + ", \"bottom\": " + side + "}")
            } {
                out = (out + "\"padding\": " + pad)
            }
        }
        ; where a chart narrower than the slide sits, as a flex row would put
        ; it: `chart { justify-content: center | flex-start | flex-end }`
        ; (centred unless told otherwise)
        def jc:string (trim (this.themeRule(key "justify-content")))
        if ((strlen jc) == 0) {
            jc = (trim (this.themeRule(key "text-align")))
        }
        if (((strlen jc) == 0) && roomy) {
            jc = "center"
        }
        if ((strlen jc) > 0) {
            def al:string "start"
            if ((jc == "center") || (jc == "space-around")) { al = "center" }
            if (((jc == "flex-end") || (jc == "end")) || (jc == "right")) { al = "end" }
            if ((strlen out) > 0) { out = (out + ", ") }
            out = (out + "\"usermeta\": {\"presAlign\": \"" + al + "\"}")
        }
        if ((strlen out) == 0) {
            return ""
        }
        return ("{" + out + "}")
    }

    ; What every chart in the deck shares, as `config` members:
    ; - its numbers in the deck's language (`lang: fi` → 50 292 and 552,66,
    ;   thousands grouped in value labels too), so a chart needs no format
    ;   of its own to read right in Finnish;
    ; - its categories in the theme's colours: the chart colour first (what a
    ;   one-series chart is drawn in) and its accent, then `figure { colors }`,
    ;   then Vega's own to make up ten. Left to Vega, a chart coloured by category came
    ;   out blue and orange beside the theme's columns on the next slide.
    fn chartLook:string () {
        def out:string ""
        def loc:string (PresDeck.numberLocale(docLang))
        def tl:string (PresDeck.timeLocale(docLang))
        def parts:[string]
        if ((strlen loc) > 0) {
            push parts ("\"number\": " + loc)
        }
        if ((strlen tl) > 0) {
            push parts ("\"time\": " + tl)
        }
        if ((array_length parts) > 0) {
            out = ("\"locale\": {" + (join parts ", ") + "}, ")
        }
        if ((strlen docLang) > 0) {
            out = (out + "\"numberFormat\": \",\", ")
        }
        def cols:[string]
        push cols (this.chartColour("color"))
        push cols (this.chartColour("accent-color"))
        def fig:MdFigureStyle (this.figureStyle())
        for fig.colors fc:string fci {
            push cols fc
        }
        def vega:[string] (strsplit "#4c78a8 #f58518 #e45756 #72b7b2 #54a24b #eeca3b #b279a2 #ff9da6 #9d755d #bab0ac" " ")
        for vega vc:string vci {
            push cols vc
        }
        def picked:[string]
        def seen:string " "
        for cols c0:string ci {
            def c:string (MdHtml.lower((trim c0)))
            if ((((indexOf c "#") == 0) && ((indexOf seen (" " + c + " ")) < 0)) && ((array_length picked) < 10)) {
                if (((strlen c) == 4) || ((strlen c) == 7)) {
                    push picked ("\"" + c + "\"")
                    seen = (seen + c + " ")
                }
            }
        }
        if ((array_length picked) > 0) {
            out = (out + "\"range\": {\"category\": [" + (join picked ", ") + "]}")
        }
        if ((strlen out) > 0) {
            if ((lastIndexOf out ", ") == ((strlen out) - 2)) {
                out = (substring out 0 ((strlen out) - 2))
            }
        }
        return out
    }

    ; One key of the text's front matter (the `---` block it opens with),
    ; read from the text itself: the charts' defaults are set before the
    ; layout parses the new text.
    sfn frontMatterValue:string (text:string key:string) {
        if ((indexOf text "---") != 0) {
            return ""
        }
        def nl:int (indexOf text "\n")
        if (nl < 0) {
            return ""
        }
        def rest:string (substring text (nl + 1) (strlen text))
        def end:int (indexOf rest "\n---")
        def block:string rest
        if ((indexOf rest "---") == 0) {
            block = ""
        } {
            if (end < 0) {
                return ""
            }
            block = (substring rest 0 end)
        }
        def meta (new MdMeta())
        MdFrontMatter.parseInto(block meta)
        return (trim (meta.get(key "")))
    }

    ; The chart colour (`color`) or its accent (`accent-color`) as the
    ; charts are painted in it: the theme's, else PresChart.dress's own
    ; fallback. A theme with no chart rule (corporate) drew its charts in
    ; that fallback and its figures in MdFigureStyle's blue: two palettes.
    fn chartColour:string (prop:string) {
        def c:string (trim (this.themeColour("chart" prop)))
        if ((strlen c) > 0) {
            return c
        }
        if (prop == "color") {
            return "#B96926"
        }
        return "#59C3C4"
    }

    ; d3-format's number locale (decimal mark, thousands separator) for a
    ; language code ("fi", "sv-SE", "de"), as JSON; "" for English and for
    ; the languages it does not know.
    sfn numberLocale:string (lang:string) {
        def l:string (MdHtml.lower((trim lang)))
        def dash:int (indexOf l "-")
        if (dash < 0) {
            dash = (indexOf l "_")
        }
        if (dash > 0) {
            l = (substring l 0 dash)
        }
        ; a space between the thousands (no-break, so a number stays whole)
        def spaced:string " fi sv nb nn no fr et cs sk pl ru uk lv lt hu bg "
        def dotted:string " de da nl es it pt id tr el ro hr sl sr is "
        if ((strlen l) == 0) {
            return ""
        }
        if ((indexOf spaced (" " + l + " ")) >= 0) {
            return "{\"decimal\": \",\", \"thousands\": \"\\u00a0\"}"
        }
        if ((indexOf dotted (" " + l + " ")) >= 0) {
            return "{\"decimal\": \",\", \"thousands\": \".\"}"
        }
        return ""
    }

    ; The month and day names of the charts (`config.locale.time`, as d3's
    ; time format locales write them) for the deck's `lang:`; "" for English
    ; and for a language not here. A Finnish deck's month axis read Jan,
    ; Feb… beside numbers written the Finnish way (Tero 2026-10-07).
    sfn timeLocale:string (lang:string) {
        def l:string (MdHtml.lower((trim lang)))
        def dash:int (indexOf l "-")
        if (dash < 0) {
            dash = (indexOf l "_")
        }
        if (dash > 0) {
            l = (substring l 0 dash)
        }
        if (l == "fi") {
            return "{\"months\":[\"tammikuu\",\"helmikuu\",\"maaliskuu\",\"huhtikuu\",\"toukokuu\",\"kesäkuu\",\"heinäkuu\",\"elokuu\",\"syyskuu\",\"lokakuu\",\"marraskuu\",\"joulukuu\"],\"shortMonths\":[\"Tammi\",\"Helmi\",\"Maalis\",\"Huhti\",\"Touko\",\"Kesä\",\"Heinä\",\"Elo\",\"Syys\",\"Loka\",\"Marras\",\"Joulu\"],\"days\":[\"sunnuntai\",\"maanantai\",\"tiistai\",\"keskiviikko\",\"torstai\",\"perjantai\",\"lauantai\"],\"shortDays\":[\"Su\",\"Ma\",\"Ti\",\"Ke\",\"To\",\"Pe\",\"La\"]}"
        }
        if (l == "sv") {
            return "{\"months\":[\"Januari\",\"Februari\",\"Mars\",\"April\",\"Maj\",\"Juni\",\"Juli\",\"Augusti\",\"September\",\"Oktober\",\"November\",\"December\"],\"shortMonths\":[\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"Maj\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Okt\",\"Nov\",\"Dec\"],\"days\":[\"Söndag\",\"Måndag\",\"Tisdag\",\"Onsdag\",\"Torsdag\",\"Fredag\",\"Lördag\"],\"shortDays\":[\"Sön\",\"Mån\",\"Tis\",\"Ons\",\"Tor\",\"Fre\",\"Lör\"]}"
        }
        if (l == "nb") {
            return "{\"months\":[\"januar\",\"februar\",\"mars\",\"april\",\"mai\",\"juni\",\"juli\",\"august\",\"september\",\"oktober\",\"november\",\"desember\"],\"shortMonths\":[\"jan\",\"feb\",\"mars\",\"apr\",\"mai\",\"juni\",\"juli\",\"aug\",\"sep\",\"okt\",\"nov\",\"des\"],\"days\":[\"søndag\",\"mandag\",\"tirsdag\",\"onsdag\",\"torsdag\",\"fredag\",\"lørdag\"],\"shortDays\":[\"søn\",\"man\",\"tir\",\"ons\",\"tor\",\"fre\",\"lør\"]}"
        }
        if (l == "no") {
            return "{\"months\":[\"januar\",\"februar\",\"mars\",\"april\",\"mai\",\"juni\",\"juli\",\"august\",\"september\",\"oktober\",\"november\",\"desember\"],\"shortMonths\":[\"jan\",\"feb\",\"mars\",\"apr\",\"mai\",\"juni\",\"juli\",\"aug\",\"sep\",\"okt\",\"nov\",\"des\"],\"days\":[\"søndag\",\"mandag\",\"tirsdag\",\"onsdag\",\"torsdag\",\"fredag\",\"lørdag\"],\"shortDays\":[\"søn\",\"man\",\"tir\",\"ons\",\"tor\",\"fre\",\"lør\"]}"
        }
        if (l == "nn") {
            return "{\"months\":[\"januar\",\"februar\",\"mars\",\"april\",\"mai\",\"juni\",\"juli\",\"august\",\"september\",\"oktober\",\"november\",\"desember\"],\"shortMonths\":[\"jan\",\"feb\",\"mars\",\"apr\",\"mai\",\"juni\",\"juli\",\"aug\",\"sep\",\"okt\",\"nov\",\"des\"],\"days\":[\"søndag\",\"mandag\",\"tirsdag\",\"onsdag\",\"torsdag\",\"fredag\",\"lørdag\"],\"shortDays\":[\"søn\",\"man\",\"tir\",\"ons\",\"tor\",\"fre\",\"lør\"]}"
        }
        if (l == "da") {
            return "{\"months\":[\"januar\",\"februar\",\"marts\",\"april\",\"maj\",\"juni\",\"juli\",\"august\",\"september\",\"oktober\",\"november\",\"december\"],\"shortMonths\":[\"jan\",\"feb\",\"mar\",\"apr\",\"maj\",\"jun\",\"jul\",\"aug\",\"sep\",\"okt\",\"nov\",\"dec\"],\"days\":[\"søndag\",\"mandag\",\"tirsdag\",\"onsdag\",\"torsdag\",\"fredag\",\"lørdag\"],\"shortDays\":[\"søn\",\"man\",\"tir\",\"ons\",\"tor\",\"fre\",\"lør\"]}"
        }
        if (l == "de") {
            return "{\"months\":[\"Januar\",\"Februar\",\"März\",\"April\",\"Mai\",\"Juni\",\"Juli\",\"August\",\"September\",\"Oktober\",\"November\",\"Dezember\"],\"shortMonths\":[\"Jan\",\"Feb\",\"Mrz\",\"Apr\",\"Mai\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Okt\",\"Nov\",\"Dez\"],\"days\":[\"Sonntag\",\"Montag\",\"Dienstag\",\"Mittwoch\",\"Donnerstag\",\"Freitag\",\"Samstag\"],\"shortDays\":[\"So\",\"Mo\",\"Di\",\"Mi\",\"Do\",\"Fr\",\"Sa\"]}"
        }
        if (l == "fr") {
            return "{\"months\":[\"janvier\",\"février\",\"mars\",\"avril\",\"mai\",\"juin\",\"juillet\",\"août\",\"septembre\",\"octobre\",\"novembre\",\"décembre\"],\"shortMonths\":[\"janv.\",\"févr.\",\"mars\",\"avr.\",\"mai\",\"juin\",\"juil.\",\"août\",\"sept.\",\"oct.\",\"nov.\",\"déc.\"],\"days\":[\"dimanche\",\"lundi\",\"mardi\",\"mercredi\",\"jeudi\",\"vendredi\",\"samedi\"],\"shortDays\":[\"dim.\",\"lun.\",\"mar.\",\"mer.\",\"jeu.\",\"ven.\",\"sam.\"]}"
        }
        if (l == "es") {
            return "{\"months\":[\"enero\",\"febrero\",\"marzo\",\"abril\",\"mayo\",\"junio\",\"julio\",\"agosto\",\"septiembre\",\"octubre\",\"noviembre\",\"diciembre\"],\"shortMonths\":[\"ene\",\"feb\",\"mar\",\"abr\",\"may\",\"jun\",\"jul\",\"ago\",\"sep\",\"oct\",\"nov\",\"dic\"],\"days\":[\"domingo\",\"lunes\",\"martes\",\"miércoles\",\"jueves\",\"viernes\",\"sábado\"],\"shortDays\":[\"dom\",\"lun\",\"mar\",\"mié\",\"jue\",\"vie\",\"sáb\"]}"
        }
        if (l == "it") {
            return "{\"months\":[\"Gennaio\",\"Febbraio\",\"Marzo\",\"Aprile\",\"Maggio\",\"Giugno\",\"Luglio\",\"Agosto\",\"Settembre\",\"Ottobre\",\"Novembre\",\"Dicembre\"],\"shortMonths\":[\"Gen\",\"Feb\",\"Mar\",\"Apr\",\"Mag\",\"Giu\",\"Lug\",\"Ago\",\"Set\",\"Ott\",\"Nov\",\"Dic\"],\"days\":[\"Domenica\",\"Lunedì\",\"Martedì\",\"Mercoledì\",\"Giovedì\",\"Venerdì\",\"Sabato\"],\"shortDays\":[\"Dom\",\"Lun\",\"Mar\",\"Mer\",\"Gio\",\"Ven\",\"Sab\"]}"
        }
        if (l == "nl") {
            return "{\"months\":[\"januari\",\"februari\",\"maart\",\"april\",\"mei\",\"juni\",\"juli\",\"augustus\",\"september\",\"oktober\",\"november\",\"december\"],\"shortMonths\":[\"jan\",\"feb\",\"mrt\",\"apr\",\"mei\",\"jun\",\"jul\",\"aug\",\"sep\",\"okt\",\"nov\",\"dec\"],\"days\":[\"zondag\",\"maandag\",\"dinsdag\",\"woensdag\",\"donderdag\",\"vrijdag\",\"zaterdag\"],\"shortDays\":[\"zo\",\"ma\",\"di\",\"wo\",\"do\",\"vr\",\"za\"]}"
        }
        if (l == "pt") {
            return "{\"months\":[\"Janeiro\",\"Fevereiro\",\"Março\",\"Abril\",\"Maio\",\"Junho\",\"Julho\",\"Agosto\",\"Setembro\",\"Outubro\",\"Novembro\",\"Dezembro\"],\"shortMonths\":[\"Jan\",\"Fev\",\"Mar\",\"Abr\",\"Mai\",\"Jun\",\"Jul\",\"Ago\",\"Set\",\"Out\",\"Nov\",\"Dez\"],\"days\":[\"Domingo\",\"Segunda\",\"Terça\",\"Quarta\",\"Quinta\",\"Sexta\",\"Sábado\"],\"shortDays\":[\"Dom\",\"Seg\",\"Ter\",\"Qua\",\"Qui\",\"Sex\",\"Sáb\"]}"
        }
        if (l == "pl") {
            return "{\"months\":[\"Styczeń\",\"Luty\",\"Marzec\",\"Kwiecień\",\"Maj\",\"Czerwiec\",\"Lipiec\",\"Sierpień\",\"Wrzesień\",\"Październik\",\"Listopad\",\"Grudzień\"],\"shortMonths\":[\"Stycz.\",\"Luty\",\"Marz.\",\"Kwie.\",\"Maj\",\"Czerw.\",\"Lipc.\",\"Sierp.\",\"Wrz.\",\"Paźdz.\",\"Listop.\",\"Grudz.\"],\"days\":[\"Niedziela\",\"Poniedziałek\",\"Wtorek\",\"Środa\",\"Czwartek\",\"Piątek\",\"Sobota\"],\"shortDays\":[\"Niedz.\",\"Pon.\",\"Wt.\",\"Śr.\",\"Czw.\",\"Pt.\",\"Sob.\"]}"
        }
        if (l == "ru") {
            return "{\"months\":[\"января\",\"февраля\",\"марта\",\"апреля\",\"мая\",\"июня\",\"июля\",\"августа\",\"сентября\",\"октября\",\"ноября\",\"декабря\"],\"shortMonths\":[\"янв\",\"фев\",\"мар\",\"апр\",\"май\",\"июн\",\"июл\",\"авг\",\"сен\",\"окт\",\"ноя\",\"дек\"],\"days\":[\"воскресенье\",\"понедельник\",\"вторник\",\"среда\",\"четверг\",\"пятница\",\"суббота\"],\"shortDays\":[\"вс\",\"пн\",\"вт\",\"ср\",\"чт\",\"пт\",\"сб\"]}"
        }
        if (l == "cs") {
            return "{\"months\":[\"leden\",\"únor\",\"březen\",\"duben\",\"květen\",\"červen\",\"červenec\",\"srpen\",\"září\",\"říjen\",\"listopad\",\"prosinec\"],\"shortMonths\":[\"led\",\"úno\",\"břez\",\"dub\",\"kvě\",\"čer\",\"červ\",\"srp\",\"zář\",\"říj\",\"list\",\"pros\"],\"days\":[\"neděle\",\"pondělí\",\"úterý\",\"středa\",\"čvrtek\",\"pátek\",\"sobota\"],\"shortDays\":[\"ne.\",\"po.\",\"út.\",\"st.\",\"čt.\",\"pá.\",\"so.\"]}"
        }
        if (l == "uk") {
            return "{\"months\":[\"січня\",\"лютого\",\"березня\",\"квітня\",\"травня\",\"червня\",\"липня\",\"серпня\",\"вересня\",\"жовтня\",\"листопада\",\"грудня\"],\"shortMonths\":[\"січ.\",\"лют.\",\"бер.\",\"квіт.\",\"трав.\",\"черв.\",\"лип.\",\"серп.\",\"вер.\",\"жовт.\",\"лист.\",\"груд.\"],\"days\":[\"неділя\",\"понеділок\",\"вівторок\",\"середа\",\"четвер\",\"п'ятниця\",\"субота\"],\"shortDays\":[\"нд\",\"пн\",\"вт\",\"ср\",\"чт\",\"пт\",\"сб\"]}"
        }
        if (l == "hu") {
            return "{\"months\":[\"január\",\"február\",\"március\",\"április\",\"május\",\"június\",\"július\",\"augusztus\",\"szeptember\",\"október\",\"november\",\"december\"],\"shortMonths\":[\"jan.\",\"feb.\",\"már.\",\"ápr.\",\"máj.\",\"jún.\",\"júl.\",\"aug.\",\"szept.\",\"okt.\",\"nov.\",\"dec.\"],\"days\":[\"vasárnap\",\"hétfő\",\"kedd\",\"szerda\",\"csütörtök\",\"péntek\",\"szombat\"],\"shortDays\":[\"V\",\"H\",\"K\",\"Sze\",\"Cs\",\"P\",\"Szo\"]}"
        }
        if (l == "hr") {
            return "{\"months\":[\"Siječanj\",\"Veljača\",\"Ožujak\",\"Travanj\",\"Svibanj\",\"Lipanj\",\"Srpanj\",\"Kolovoz\",\"Rujan\",\"Listopad\",\"Studeni\",\"Prosinac\"],\"shortMonths\":[\"Sij\",\"Velj\",\"Ožu\",\"Tra\",\"Svi\",\"Lip\",\"Srp\",\"Kol\",\"Ruj\",\"Lis\",\"Stu\",\"Pro\"],\"days\":[\"Nedjelja\",\"Ponedjeljak\",\"Utorak\",\"Srijeda\",\"Četvtrak\",\"Petak\",\"Subota\"],\"shortDays\":[\"Ne\",\"Po\",\"Ut\",\"Sr\",\"Če\",\"Pe\",\"Su\"]}"
        }
        if (l == "tr") {
            return "{\"months\":[\"Ocak\",\"Şubat\",\"Mart\",\"Nisan\",\"Mayıs\",\"Haziran\",\"Temmuz\",\"Ağustos\",\"Eylül\",\"Ekim\",\"Kasım\",\"Aralık\"],\"shortMonths\":[\"Oca\",\"Şub\",\"Mar\",\"Nis\",\"May\",\"Haz\",\"Tem\",\"Ağu\",\"Eyl\",\"Eki\",\"Kas\",\"Ara\"],\"days\":[\"Pazar\",\"Pazartesi\",\"Salı\",\"Çarşamba\",\"Perşembe\",\"Cuma\",\"Cumartesi\"],\"shortDays\":[\"Paz\",\"Pzt\",\"Sal\",\"Çar\",\"Per\",\"Cum\",\"Cmt\"]}"
        }
        if (l == "ca") {
            return "{\"months\":[\"gener\",\"febrer\",\"març\",\"abril\",\"maig\",\"juny\",\"juliol\",\"agost\",\"setembre\",\"octubre\",\"novembre\",\"desembre\"],\"shortMonths\":[\"gen.\",\"febr.\",\"març\",\"abr.\",\"maig\",\"juny\",\"jul.\",\"ag.\",\"set.\",\"oct.\",\"nov.\",\"des.\"],\"days\":[\"diumenge\",\"dilluns\",\"dimarts\",\"dimecres\",\"dijous\",\"divendres\",\"dissabte\"],\"shortDays\":[\"dg.\",\"dl.\",\"dt.\",\"dc.\",\"dj.\",\"dv.\",\"ds.\"]}"
        }
        return ""
    }

    ; The anchors the theme has chart rules for ("#a", "#b").
    fn chartScopes:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length ruleKeys)) {
            def k:string (itemAt ruleKeys i)
            ; `#anchor list` rules are the lists', not the charts'
            if (((indexOf k "#") == 0) && ((indexOf k " list/") < 0)) {
                def slash:int (indexOf k "/")
                def sc:string (substring k 0 slash)
                def seen:boolean false
                def j:int 0
                while (j < (array_length out)) {
                    if ((itemAt out j) == sc) {
                        seen = true
                    }
                    j = (j + 1)
                }
                if (seen == false) {
                    push out sc
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; A colour for `what` ("chart" or "diagram"): `color` is the warm one
    ; (columns, the active line), `accent-color` the cool one (grid, axes,
    ; boxes). The rule wins over the old `/* pres: warm= accent= */` line.
    ; A property of the theme's `chart` / `diagram` rule, or "".
    ; A `background-image` value that draws nothing.
    ; The slide's ground is the flat paper colour: no effect, no picture of
    ; its own and none from the theme. Only then can a diagram fade its rim
    ; into that colour and draw its grid; over anything else both show as a
    ; dark box around the diagram.
    fn flatGround:boolean (s:PresSlide) {
        if ((strlen s.fx) > 0) {
            return false
        }
        if ((strlen s.bg) > 0) {
            return false
        }
        if ((PresDeck.noPicture((this.themeRule("page" "background-image")))) == false) {
            return false
        }
        ; `.dark page { background-image }` on this slide
        return (PresDeck.noPicture(((this.layout()).pictureOf(s.index))))
    }

    ; The paper of slide `page`: the theme's, or a slide rule's (`.dark page
    ; { background-color }`, MdLayout.paperOf); white when neither says.
    sfn paperOn:string (l:MdLayout page:int) {
        def paper:string (l.paperOf(page))
        if ((strlen paper) == 0) {
            return "#ffffff"
        }
        return paper
    }

    sfn noPicture:boolean (v:string) {
        def t:string (trim v)
        return (((strlen t) == 0) || (t == "none"))
    }

    fn themeRule:string (what:string prop:string) {
        def key:string (what + "/" + prop)
        def i:int ((array_length ruleKeys) - 1)
        while (i >= 0) {
            if ((itemAt ruleKeys i) == key) {
                return (itemAt ruleVals i)
            }
            i = (i - 1)
        }
        return ""
    }

    fn themeColour:string (what:string prop:string) {
        def key:string (what + "/" + prop)
        def i:int ((array_length ruleKeys) - 1)
        while (i >= 0) {
            if ((itemAt ruleKeys i) == key) {
                return (itemAt ruleVals i)
            }
            i = (i - 1)
        }
        if (prop == "color") {
            return (this.themeValue("warm"))
        }
        return (this.themeValue("accent"))
    }

    fn themeValue:string (key:string) {
        def i:int 0
        while (i < (array_length themeKeys)) {
            if ((itemAt themeKeys i) == key) {
                return (itemAt themeVals i)
            }
            i = (i + 1)
        }
        return ""
    }

    ; Files the charts read (`"data": {"url": …}`), fetched by the page.
    def dataUrls:[string]
    def dataTexts:[string]
    ; files the page looked for and the document does not have
    def dataMissing:[string]
    ; the ```table fences (PresTable), and the page each was left on, by
    ; "<path>#<ordinal>"
    def tables:[PresTableUse]
    def tablePages:[string:int]

    ; Another document: none of the files the last one's charts read.
    fn clearChartData:void () {
        def u:[string]
        def t:[string]
        dataUrls = u
        dataTexts = t
        def m:[string]
        dataMissing = m
    }

    ; The page found no such file: a table that reads it says so instead of
    ; waiting for it.
    fn setChartDataMissing:void (url:string) {
        if ((indexOf dataMissing url) >= 0) {
            return
        }
        push dataMissing url
        this.rebuild()
    }

    fn setChartData:void (url:string body:string) {
        ; a drawing comes in as the text file it is
        if (PresSketch.isPath(url)) {
            this.setSketch(url body)
            return
        }
        def i:int 0
        while (i < (array_length dataUrls)) {
            if ((itemAt dataUrls i) == url) {
                set_at dataTexts i body
                this.rebuild()
                return
            }
            i = (i + 1)
        }
        push dataUrls url
        push dataTexts body
        this.rebuild()
    }

    ; The files the document's charts read that the page has not handed over,
    ; one per line.
    fn chartDataWanted:string () {
        def out:string ""
        def doc:MdNode md.edit.doc
        def urls:[string]
        this.wantedIn(doc urls)
        def ti:int 0
        while (ti < (array_length tables)) {
            def tu:PresTableUse (itemAt tables ti)
            push urls (MdVegaRender.resolveUrl(tu.path))
            ti = (ti + 1)
        }
        ; a program's source and its stylesheet
        def pf:[string] (this.playFiles())
        def pfi:int 0
        while (pfi < (array_length pf)) {
            push urls (itemAt pf pfi)
            pfi = (pfi + 1)
        }
        def i:int 0
        while (i < (array_length urls)) {
            def u:string (itemAt urls i)
            def have:boolean false
            ; a table's own key is no file
            def tk:int 0
            while (tk < (array_length tables)) {
                def tu:PresTableUse (itemAt tables tk)
                if (tu.key == u) {
                    have = true
                }
                tk = (tk + 1)
            }
            def k:int 0
            while (k < (array_length dataUrls)) {
                if ((MdVegaRender.bareUrl((itemAt dataUrls k))) == (MdVegaRender.bareUrl(u))) {
                    have = true
                }
                k = (k + 1)
            }
            if (have == false) {
                out = (out + u + (strfromcode 10))
            }
            i = (i + 1)
        }
        return out
    }

    fn wantedIn:void (n:MdNode urls:[string]) {
        if (n.kind == "embed") {
            if ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(n.info)))) == "vega") {
                ; a chart kept in a file reads the files that file names
                def spec:string (MdVegaRender.fromFile(n.literal dataUrls dataTexts))
                if (spec != n.literal) {
                    def inner:[string] (MdVegaRender.urlsOf(spec))
                    def q:int 0
                    while (q < (array_length inner)) {
                        push urls (itemAt inner q)
                        q = (q + 1)
                    }
                }
                def us:[string] (MdVegaRender.urlsOf(n.literal))
                def j:int 0
                while (j < (array_length us)) {
                    push urls (itemAt us j)
                    j = (j + 1)
                }
            }
        }
        def c:int 0
        while (c < (n.childCount())) {
            this.wantedIn((n.childAt(c)) urls)
            c = (c + 1)
        }
    }

    fn setText:void (t:string) {
        text = t
        this.rebuild()
    }

    ; Held while the page opens another document (PresApp.beginOpen): what
    ; arrives for it (its pictures, its data files, its drawings) is kept
    ; without laying out the text before it. PresApp.setSource lets go and
    ; lays the deck out once.
    def held:boolean false

    fn rebuild:void () {
        if held {
            return
        }
        src.read(text)
        this.compileFx()
        ; the tables, masked into charts of their own (PresTable)
        def k0:int 0
        while (k0 < (array_length tables)) {
            def was:PresTableUse (itemAt tables k0)
            set tablePages ((was.path + "#") + (to_string was.ordinal)) was.page
            k0 = (k0 + 1)
        }
        def fresh:[PresTableUse]
        tables = fresh
        def masked:string (PresTable.mask(src.masked tables))
        def urls:[string]
        def texts:[string]
        def di:int 0
        while (di < (array_length dataUrls)) {
            push urls (itemAt dataUrls di)
            push texts (itemAt dataTexts di)
            di = (di + 1)
        }
        def tk:int 0
        while (tk < (array_length tables)) {
            def u:PresTableUse (itemAt tables tk)
            def pk:string ((u.path + "#") + (to_string u.ordinal))
            if (has tablePages pk) {
                u.page = (unwrap (get tablePages pk))
            }
            PresTable.load(u dataUrls dataTexts)
            u.missing = ((u.loaded == false) && ((indexOf dataMissing (MdVegaRender.resolveUrl(u.path))) >= 0))
            push urls u.key
            push texts (PresTable.spec(u))
            tk = (tk + 1)
        }
        def e:MarkdownEdit md.edit
        e.open(masked)
        docLang = (PresDeck.frontMatterValue(masked "lang"))
        e.slideMode = true
        ; a reference to a drawing takes no room: it is drawn over the slide
        if ((indexOf e.layout.overlayTypes (PresSketch.TYPE())) < 0) {
            push e.layout.overlayTypes (PresSketch.TYPE())
        }
        e.sheetGap = (MdToEvg.sheetGap())
        ; a slide with room is set larger (the front matter's `slide-grow`
        ; overrides; `slide-grow: off` keeps the document's sizes)
        e.layout.slideGrow = 1.6
        ; a slide with a presenter (`::: story`) keeps the strip it stands in
        ; free, so the figure and its bubble cover nothing (PresPuppet.STRIP)
        def noAside:[int]
        e.layout.asideAt = noAside
        e.layout.asideFrac = (PresPuppet.STRIP() / 960.0)
        for src.blocks sb:PresBlock sbi {
            if (sb.kind == "story") {
                push e.layout.asideAt sb.start
            }
        }
        ; the charts over the theme's defaults: every chart's, then each
        ; heading's own (`#anchor chart { … }`)
        def emb:MdEmbedCache e.layout.embeds
        emb.chartConfig = (this.chartDefaults("chart" true))
        ; the figures in the theme's colours, and only for PRO
        figStyle = (this.figureStyle())
        emb.figure = figStyle
        ; a slide's chart fills its room (a small plot asked for larger)
        emb.chartGrow = 2.5
        ; but no taller than a slide under its heading: the room the heading
        ; keeps, and the layout works the height out of the page it lays out
        ; (this style is still the last layout's, which is the other page
        ; when `orientation:` turned it)
        emb.chartRoomKept = 120.0
        def none1:[string]
        def none2:[string]
        emb.chartScopes = none1
        emb.chartScopeConfig = none2
        emb.redrawBudget = redrawBudget
        emb.focusFrom = focusFrom
        emb.focusTo = focusTo
        emb.lazy = lazy
        emb.viewFrom = viewFrom
        emb.viewTo = viewTo
        def scopes:[string] (this.chartScopes())
        def si:int 0
        while (si < (array_length scopes)) {
            def sc:string (itemAt scopes si)
            push emb.chartScopes (substring sc 1 (strlen sc))
            push emb.chartScopeConfig (this.chartDefaults(sc false))
            si = (si + 1)
        }
        ; `#anchor list { list-style: swot }`: the lists under one heading
        ; drawn as a figure (a list's own `{list-style=…}` wins)
        def none3:[string]
        def none4:[string]
        emb.listScopes = none3
        emb.listScopeStyles = none4
        def lk:int 0
        while (lk < (array_length ruleKeys)) {
            def lkey:string (itemAt ruleKeys lk)
            def lat:int (indexOf lkey " list/list-style")
            if (((indexOf lkey "#") == 0) && (lat > 0)) {
                push emb.listScopes (substring lkey 1 lat)
                push emb.listScopeStyles (trim (itemAt ruleVals lk))
            }
            lk = (lk + 1)
        }
        ; the files the charts read, as far as the page has fetched them
        emb.dataUrls = urls
        emb.dataTexts = texts
        ; `orientation:` in the front matter turns the page the deck would
        ; have without it (the theme's, or `page:`) when that page is the
        ; other way round. That page is only known from a layout, so it is
        ; kept from the last one made with the same stylesheet and `page:`;
        ; anything else (or a change) costs one layout more.
        orientation = (PresDeck.frontValue(text "orientation"))
        def baseOf:string (((((e.sheet.text()) + "\npage: ") + (PresDeck.frontValue(text "page"))) + "\nmedia: ") + e.media)
        e.pageSize = ""
        if ((baseOf == themeSizeOf) && (PresDeck.turns(orientation themeTall))) {
            e.pageSize = themeSizeTurned
        }
        e.layout.liveKeys = liveKeys
        e.layout.liveVals = liveVals
        e.stale = true
        e.ensureLayout()
        if ((strlen e.pageSize) == 0) {
            def lw:double e.layout.style.pageWidth
            def lh:double e.layout.style.pageHeight
            themeSizeOf = baseOf
            themeTall = (lh > lw)
            themeSizeTurned = (((to_string lh) + "x") + (to_string lw)) + "pt"
            if (PresDeck.turns(orientation themeTall)) {
                e.pageSize = themeSizeTurned
                e.stale = true
                e.ensureLayout()
            }
        }
        this.codeColours(e.layout)
        pageW = e.layout.style.pageWidth
        pageH = e.layout.style.pageHeight
        this.readSlides()
        revision = (revision + 1)
    }

    ; Listings in the slide's own light. The markdown module's token colours
    ; are for a white page and the stylesheet has no word for them, so on a
    ; dark slide the laid-out listing boxes get the dark set instead.
    fn codeColours:void (l:MdLayout) {
        def st:MdStyle l.style
        def bg:string st.codeBackground
        if ((strlen bg) == 0) {
            bg = st.pageBackground
        }
        if ((strlen bg) == 0) {
            return
        }
        def c:EVGColor (EVGColor.parse(bg))
        def lum:double ((((to_double (c.red())) * 0.299) + ((to_double (c.green())) * 0.587)) + ((to_double (c.blue())) * 0.114))
        if (lum >= 110.0) {
            return
        }
        ; `code { color }` is the sheet's own choice for a dark slide: kept
        def plainDefault:string (new MdStyle()).codePlain
        def ownPlain:boolean ((PresDeck.lower(st.codePlain)) != (PresDeck.lower(plainDefault)))
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.family == st.monoFamily)) {
                def col:string (PresDeck.lower(b.color))
                if ((col == (PresDeck.lower(st.codePlain))) && (ownPlain == false)) { b.color = "#e6edf3" }
                if (col == (PresDeck.lower(st.codeKeyword))) { b.color = "#ff7b72" }
                if (col == (PresDeck.lower(st.codeString))) { b.color = "#a5d6ff" }
                if (col == (PresDeck.lower(st.codeComment))) { b.color = "#8b949e" }
                if (col == (PresDeck.lower(st.codeNumber))) { b.color = "#79c0ff" }
            }
            i = (i + 1)
        }
    }

    sfn lower:string (v:string) {
        return (MdChar.lower(v))
    }

    fn layout:MdLayout () {
        return md.edit.layout
    }

    fn slideCount:int () {
        return (array_length slides)
    }

    fn slideAt:PresSlide (i:int) {
        return (itemAt slides i)
    }

    ; ------------------------------------------------------------------
    ; Which slide a source offset is on
    ; ------------------------------------------------------------------
    fn pageOfOffset:int (off:int) {
        def l:MdLayout (this.layout())
        def best:int 0
        def bestSrc:int -1
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            def s:int (PresDeck.boxSrc(b))
            if ((s <= off) && (s > bestSrc)) {
                bestSrc = s
                best = b.page
            }
            i = (i + 1)
        }
        ; hidden titles have no box but start their slide
        def h:int 0
        while (h < (array_length l.hiddenSrc)) {
            def hs:int (itemAt l.hiddenSrc h)
            if ((hs <= off) && (hs > bestSrc)) {
                bestSrc = hs
                best = (itemAt l.hiddenPage h)
            }
            h = (h + 1)
        }
        return best
    }

    ; Where a box came from: its own run when it has one, its block otherwise.
    sfn boxSrc:int (b:MdBox) {
        if (b.segSrc >= 0) {
            return b.segSrc
        }
        return b.srcStart
    }

    ; The page a block's first box landed on, or -1 when it drew nothing.
    fn pageOfNode:int (n:MdNode) {
        def l:MdLayout (this.layout())
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            def s:int (PresDeck.boxSrc(b))
            if ((s >= n.srcStart) && (s < n.srcEnd)) {
                return b.page
            }
            i = (i + 1)
        }
        ; a `{heading=hidden}` title draws nothing but still names its slide
        return (l.pageOfHidden(n.srcStart))
    }

    ; ------------------------------------------------------------------
    ; The slides and what the document says about them
    ; ------------------------------------------------------------------
    ; The diagrams of the deck before this rebuild: an edit anywhere else
    ; leaves a diagram's text as it was, and then the viewer's choices, view
    ; and menu carry over instead of starting the walk again.
    def oldUses:[PresDiaUse]

    fn keepOldUses:void () {
        clear oldUses
        def i:int 0
        while (i < (array_length slides)) {
            def s:PresSlide (itemAt slides i)
            def k:int 0
            while (k < (array_length s.diagrams)) {
                push oldUses (itemAt s.diagrams k)
                k = (k + 1)
            }
            i = (i + 1)
        }
    }

    ; The old use of a fence with this text, taken so it is used once; -1.
    fn takeOldUse:int (source:string) {
        def i:int 0
        while (i < (array_length oldUses)) {
            def u:PresDiaUse (itemAt oldUses i)
            if (u.source == source) {
                return i
            }
            i = (i + 1)
        }
        ; an edit inside a fence: the next one in order (the diagram keeps
        ; the view only when it still has the same boxes and lines)
        if ((array_length oldUses) > 0) {
            return 0
        }
        return -1
    }

    ; --- drawings made on the slides (PresSketch) -------------------------------
    ; The files (drawings/*.ink) by path ("/drawings/a.ink"), read. The
    ; layout is told of each as a picture of the drawing type, which takes no
    ; room (MdLayout.overlayTypes) and is noted with the slide it is on.
    def sketchPaths:[string]
    def sketchModels:[PresSketch]
    ; A drawing begun on a slide that does not refer to one yet: drawn on
    ; that slide from the first stroke or letter, before its reference is
    ; written (the editor writes it when the gesture or the text ends).
    def newSketchSlide:int -1
    def newSketchPath:string ""

    sfn sketchKey:string (path:string) {
        if (((strlen path) > 0) && ((substring path 0 1) == "/")) {
            return path
        }
        return ("/" + path)
    }

    sfn bytesOf:buffer (text:string) {
        def n:int (strlen text)
        def buf:buffer (buffer_alloc n)
        def i:int 0
        while (i < n) {
            buffer_set buf i (charAt text i)
            i = (i + 1)
        }
        return buf
    }

    ; A drawing file, new or written again.
    fn setSketch:void (path:string text:string) {
        def key:string (PresDeck.sketchKey(path))
        def model:PresSketch (PresSketch.parse(text))
        def at:int (indexOf sketchPaths key)
        if (at >= 0) {
            set_at sketchModels at model
        } {
            push sketchPaths key
            push sketchModels model
        }
        md.addImage(key (PresDeck.bytesOf(text)) (PresSketch.TYPE()) 0 0)
        this.rebuild()
    }

    ; The drawing kept at `path`, made empty when there is none yet (the
    ; editor draws into it before its file is written).
    fn sketchFor:PresSketch (path:string) {
        def key:string (PresDeck.sketchKey(path))
        def at:int (indexOf sketchPaths key)
        if (at >= 0) {
            return (itemAt sketchModels at)
        }
        def fresh (new PresSketch())
        fresh.w = pageW
        fresh.h = pageH
        push sketchPaths key
        push sketchModels fresh
        md.addImage(key (PresDeck.bytesOf((fresh.toJson()))) (PresSketch.TYPE()) 0 0)
        return fresh
    }

    fn hasSketch:boolean (path:string) {
        return ((indexOf sketchPaths (PresDeck.sketchKey(path))) >= 0)
    }

    ; The references the layout noted, onto their slides; each drawing
    ; fitted to the page and its text measured.
    fn readSketches:void (l:MdLayout) {
        def i:int 0
        while (i < (array_length l.overlaySrc)) {
            def pg:int (itemAt l.overlayPage i)
            def path:string (itemAt l.overlayPath i)
            def at:int (indexOf sketchPaths path)
            if (((pg >= 0) && (pg < (array_length slides))) && (at >= 0)) {
                def u (new PresSketchUse())
                u.path = path
                u.srcStart = (itemAt l.overlaySrc i)
                u.sketch = (itemAt sketchModels at)
                u.sketch.fitTo(pageW pageH)
                u.sketch.measure(l.engine l.style.bodyFamily)
                def sl:PresSlide (itemAt slides pg)
                push sl.sketches u
            }
            i = (i + 1)
        }
    }

    ; The drawing begun on slide i, not yet referred to: "" when none.
    fn newSketchOn:string (i:int) {
        if (((i != newSketchSlide) || ((strlen newSketchPath) == 0)) || (i < 0)) {
            return ""
        }
        if (i >= (array_length slides)) {
            return ""
        }
        def s:PresSlide (itemAt slides i)
        if ((array_length s.sketches) > 0) {
            return ""
        }
        if ((indexOf sketchPaths newSketchPath) < 0) {
            return ""
        }
        return newSketchPath
    }

    ; The slide's drawings at its time t (all of them when still), and the
    ; one being begun on it, whole.
    fn paintSketches:void (out:EVGDisplayList i:int s:PresSlide t:double l:MdLayout) {
        def np:string (this.newSketchOn(i))
        if ((strlen np) > 0) {
            def nm:PresSketch (itemAt sketchModels (indexOf sketchPaths np))
            nm.fitTo(pageW pageH)
            nm.measure(l.engine l.style.bodyFamily)
            nm.paint(out 1000000.0 l.style.bodyFamily -1)
        }
        def k:int 0
        while (k < (array_length s.sketches)) {
            def u:PresSketchUse (itemAt s.sketches k)
            def at:double (t - u.start)
            if still {
                at = 1000000.0
            }
            u.sketch.paint(out at l.style.bodyFamily -1)
            k = (k + 1)
        }
    }

    ; `mode: book` and its margins, from the last layout (MdBook).
    fn book:MdBook () {
        return md.edit.layout.book
    }

    fn readSlides:void () {
        this.keepOldUses()
        clear slides
        def l:MdLayout (this.layout())
        def doc:MdNode md.edit.doc
        def meta:MdMeta (MdFrontMatter.of(doc))
        def dTransition:string (meta.get("transition" "fade"))
        def dSeconds:double (PresDeck.num((meta.get("seconds" "0.6")) 0.6))
        def dFx:string (meta.get("fx" ""))
        def dArt:string (meta.get("art" ""))
        def dArtSeed:int (to_int (PresDeck.num((meta.get("art-seed" "-1")) -1.0)))
        def dStep:double (PresDeck.num((meta.get("step" "1.2")) 1.2))
        def dHold:double (PresDeck.num((meta.get("hold" "2.5")) 2.5))
        docStyle = (trim (meta.get("style" "")))
        docChartStyle = (trim (meta.get("chart-style" docStyle)))
        docDiagramStyle = (trim (meta.get("diagram-style" docStyle)))
        def p:int 0
        while (p < l.pageCount) {
            def s (new PresSlide())
            s.index = p
            s.transition = dTransition
            s.seconds = dSeconds
            s.fx = dFx
            s.art = dArt
            s.artSeed = dArtSeed
            if ((strlen dArt) == 0) {
                def tArt:string (trim (this.themeRule("deck" "art")))
                if (((strlen tArt) > 0) && (tArt != "none")) {
                    s.art = tArt
                    s.artTheme = true
                    if (dArtSeed < 0) {
                        s.artSeed = (to_int (PresDeck.num((this.themeRule("deck" "art-seed")) -1.0)))
                    }
                }
            }
            s.stepGap = dStep
            s.hold = dHold
            ; the template's effect, with its own parameters; not over a picture
            ; the theme's page rule puts behind every slide, which it would hide
            if (((strlen dFx) == 0) && (PresDeck.noPicture((this.themeRule("page" "background-image"))))) {
                s.fx = (this.themeValue("fx"))
                def ti:int 0
                while (ti < (array_length themeKeys)) {
                    def tkey:string (itemAt themeKeys ti)
                    if (((strlen tkey) > 3) && ((substring tkey 0 3) == "fx-")) {
                        PresDeck.setFx(s (substring tkey 3 (strlen tkey)) (itemAt themeVals ti))
                    }
                    ti = (ti + 1)
                }
            }
            PresDeck.fxFromMeta(s meta)
            push slides s
            p = (p + 1)
        }
        ; The source span of each slide, from its boxes.
        def bi:int 0
        while (bi < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes bi)
            if ((b.page >= 0) && (b.page < (array_length slides))) {
                def sl:PresSlide (itemAt slides b.page)
                def at:int (PresDeck.boxSrc(b))
                if (at >= 0) {
                    if ((sl.srcStart < 0) || (at < sl.srcStart)) {
                        sl.srcStart = at
                    }
                    if (at > sl.srcEnd) {
                        sl.srcEnd = at
                    }
                }
            }
            bi = (bi + 1)
        }
        ; A hidden title draws no box, yet its slide starts where it is written.
        def hi:int 0
        while (hi < (array_length l.hiddenSrc)) {
            def hp:int (itemAt l.hiddenPage hi)
            def hs:int (itemAt l.hiddenSrc hi)
            if ((hp >= 0) && (hp < (array_length slides))) {
                def hsl:PresSlide (itemAt slides hp)
                if ((hsl.srcStart < 0) || (hs < hsl.srcStart)) {
                    hsl.srcStart = hs
                }
            }
            hi = (hi + 1)
        }
        ; The blocks: a heading names its slide, a build or an anim makes groups.
        def c:int 0
        while (c < (doc.childCount())) {
            def ch:MdNode (doc.childAt(c))
            def pg:int (this.pageOfNode(ch))
            if (pg >= 0) {
                def slide:PresSlide (itemAt slides pg)
                if ((ch.kind == "heading") && ((strlen slide.title) == 0)) {
                    slide.title = (ch.plainText())
                    this.readHeading(slide ch)
                }
                this.readGroups(slide ch)
                this.readDiagram(slide ch pg)
                this.readCharts(slide ch)
                this.readSmartArt(slide ch)
                this.readPlays(slide ch pg)
            }
            c = (c + 1)
        }
        ; A slide a block runs onto (a full-page album's next picture) has no
        ; heading of its own: the name the layout gave it.
        def ni:int 0
        while (ni < (array_length slides)) {
            def ns:PresSlide (itemAt slides ni)
            if ((strlen ns.title) == 0) {
                ns.title = (l.pageName(ni))
            }
            ni = (ni + 1)
        }
        this.readBands(l doc)
        this.readSketches(l)
        this.keepPlays()
        this.readTags(doc)
        this.readBlocks(doc)
        this.keepScripts()
        ; The notes and the audio go to the slide the block sits under.
        def k:int 0
        while (k < (array_length src.blocks)) {
            def blk:PresBlock (itemAt src.blocks k)
            def pg2:int (this.pageOfOffset(blk.start))
            if ((pg2 >= 0) && (pg2 < (array_length slides))) {
                def s2:PresSlide (itemAt slides pg2)
                if (blk.kind == "notes") {
                    if ((strlen s2.notes) > 0) {
                        s2.notes = (s2.notes + "\n")
                    }
                    s2.notes = (s2.notes + blk.body)
                }
                if (blk.kind == "audio") {
                    s2.audio = (PresSource.argValue(blk.args "src"))
                }
                if (blk.kind == "story") {
                    this.readStory(s2 blk)
                }
            }
            k = (k + 1)
        }
        this.readCodeLinks()
    }

    ; A `::: story` block: each line a beat and a build step of its own, after
    ; the slide's (PresStory). The bubble's hand face is asked of the page.
    fn readStory:void (s:PresSlide blk:PresBlock) {
        def beats:[PresStoryBeat] (PresStory.parse(blk.body))
        def i:int 0
        while (i < (array_length beats)) {
            def b:PresStoryBeat (itemAt beats i)
            s.steps = (s.steps + 1)
            b.step = s.steps
            push s.story b
            this.addGroup(s s.steps blk.start blk.start "story" (PresStory.beatSeconds(b)) b.text)
            i = (i + 1)
        }
        this.wantFace((PresStory.face()))
    }

    ; asks the page for a face (wantFaces), once
    fn wantFace:void (face:string) {
        if ((indexOf ("," + wantFaces + ",") ("," + face + ",")) < 0) {
            if ((strlen wantFaces) > 0) {
                wantFaces = (wantFaces + ",")
            }
            wantFaces = (wantFaces + face)
        }
    }

    ; The presenter and its bubble over the slide at t (the last line when
    ; the slide is drawn still: a thumbnail, an export).
    fn paintStory:void (out:EVGDisplayList s:PresSlide t:double l:MdLayout) {
        def n:int (array_length s.story)
        if (n == 0) {
            return
        }
        def shown:int 0
        def since:double 1000000.0
        if (still == false) {
            def k:int 0
            while (k < n) {
                def b:PresStoryBeat (itemAt s.story k)
                def at:double (PresTimeline.stepTime(s b.step))
                if ((at + 0.001) < t) {
                    shown = (k + 1)
                    since = (t - at)
                }
                k = (k + 1)
            }
        } {
            shown = n
        }
        def st:PresPuppetState (PresStory.stateAt(s.story shown since))
        PresPuppet.paint(out st (PresPuppet.placeOn(pageW pageH)))
        if (st.bubbleBeat >= 0) {
            def family:string l.style.bodyFamily
            if (has haveFaces (PresStory.face())) {
                family = (PresStory.face())
            }
            PresPuppet.bubble(out (itemAt s.story st.bubbleBeat) st.bubble pageW pageH l.engine family)
        }
    }

    ; The 1-based line of the deck's text an offset is on.
    fn lineOfOffset:int (at:int) {
        def n:int 1
        def i:int 0
        def end:int at
        if (end > (strlen text)) {
            end = (strlen text)
        }
        while (i < end) {
            if ((charAt text i) == 10) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; The box of a diagram on slide i under slide point (px, py) at slide
    ; time t that has code links of its own: [k, node], or [] (none).
    fn codeNodeAt:[int] (i:int t:double px:double py:double) {
        def out:[int]
        if ((i < 0) || (i >= (array_length slides))) {
            return out
        }
        def s:PresSlide (itemAt slides i)
        def only:int (this.fullAt(i))
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if ((only < 0) || (only == k)) {
                def b:[double] (u.boxNow(uiNow (this.fullBoxNow())))
                def dd:PresDiagram (u.active(uiNow))
                def hn:int (dd.hitNode((u.activeTime(t uiNow)) (itemAt b 0) (itemAt b 1) (itemAt b 2) (itemAt b 3) px py))
                if (hn >= 1000) {
                    def n:int (hn - 1000)
                    if ((array_length (codeLinks.forNode(i k (dd.nodeIdAt(n)) (dd.nodeText(n))))) > 0) {
                        push out k
                        push out n
                        return out
                    }
                }
            }
            k = (k + 1)
        }
        return out
    }

    ; Where box n of diagram k on slide i is drawn at slide time t (slide
    ; units): [x, y, w, h], or the diagram's box when the box is not in view.
    fn codeNodeBox:[double] (i:int k:int n:int t:double) {
        def out:[double]
        def hit@(optional):PresDiaUse (this.diagramUse(i k))
        if (null? hit) {
            return out
        }
        def u:PresDiaUse hit
        def b:[double] (u.boxNow(uiNow (this.fullBoxNow())))
        def dd:PresDiagram (u.active(uiNow))
        def te:double (u.activeTime(t uiNow))
        def a:[double]
        def c:[double]
        def id:string (dd.nodeIdAt(n))
        if ((n >= 0) && ((strlen id) > 0)) {
            dd.anchorPoint(te (itemAt b 0) (itemAt b 1) (itemAt b 2) (itemAt b 3) id 0.0 0.0 a)
            dd.anchorPoint(te (itemAt b 0) (itemAt b 1) (itemAt b 2) (itemAt b 3) id 1.0 1.0 c)
        }
        if (((array_length a) == 2) && ((array_length c) == 2)) {
            push out (itemAt a 0)
            push out (itemAt a 1)
            push out ((itemAt c 0) - (itemAt a 0))
            push out ((itemAt c 1) - (itemAt a 1))
            return out
        }
        return b
    }

    ; A `::: code` block belongs to the nearest diagram above it on its slide
    ; (none: the slide's own links); a diagram's own `click … "code:…"`
    ; lines are its links too.
    fn readCodeLinks:void () {
        def cl (new PresCodeLinks())
        def si:int 0
        while (si < (array_length slides)) {
            def s:PresSlide (itemAt slides si)
            def d:int 0
            while (d < (array_length s.diagrams)) {
                def u:PresDiaUse (itemAt s.diagrams d)
                if ((indexOf u.source "\"code:") >= 0) {
                    cl.addMermaid(u.source si d ((this.lineOfOffset(u.srcStart)) + 1))
                }
                d = (d + 1)
            }
            si = (si + 1)
        }
        def k:int 0
        while (k < (array_length src.blocks)) {
            def blk:PresBlock (itemAt src.blocks k)
            if (blk.kind == "code") {
                def pg:int (this.pageOfOffset(blk.start))
                if ((pg >= 0) && (pg < (array_length slides))) {
                    def s2:PresSlide (itemAt slides pg)
                    def dia:int -1
                    def best:int -1
                    def j:int 0
                    while (j < (array_length s2.diagrams)) {
                        def u2:PresDiaUse (itemAt s2.diagrams j)
                        if ((u2.srcStart < blk.start) && (u2.srcStart > best)) {
                            best = u2.srcStart
                            dia = j
                        }
                        j = (j + 1)
                    }
                    cl.addBlock(blk.body pg dia blk.bodyLine)
                }
            }
            k = (k + 1)
        }
        codeLinks = cl
    }

    sfn fxFromMeta:void (s:PresSlide meta:MdMeta) {
        def i:int 0
        while (i < (array_length meta.keys)) {
            def key:string (itemAt meta.keys i)
            if (((strlen key) > 3) && ((substring key 0 3) == "fx-")) {
                PresDeck.setFx(s (substring key 3 (strlen key)) (itemAt meta.values i))
            }
            i = (i + 1)
        }
    }

    sfn setFx:void (s:PresSlide name:string value:string) {
        def i:int 0
        while (i < (array_length s.fxNames)) {
            if ((itemAt s.fxNames i) == name) {
                set s.fxValues i value
                return
            }
            i = (i + 1)
        }
        push s.fxNames name
        push s.fxValues value
    }

    fn readHeading:void (s:PresSlide h:MdNode) {
        s.id = h.nodeId
        s.meta = (MdSlideMeta.of(h))
        if (h.hasAttr("script")) {
            s.script = (trim (h.attrValue("script")))
        }
        if (h.hasAttr("allow")) {
            def words:[string] (strsplit (MdApp.replaceAll((h.attrValue("allow")) "," " ")) " ")
            def wi:int 0
            while (wi < (array_length words)) {
                def wd:string (trim (itemAt words wi))
                if ((strlen wd) > 0) {
                    push s.scriptAllow wd
                }
                wi = (wi + 1)
            }
        }
        if (h.hasAttr("export-frame")) {
            def ef:string (trim (h.attrValue("export-frame")))
            if (((strlen ef) > 1) && ((substring ef ((strlen ef) - 1) (strlen ef)) == "s")) {
                ef = (substring ef 0 ((strlen ef) - 1))
            }
            s.exportFrame = (PresDeck.num(ef -1.0))
        }
        if (h.hasAttr("transition")) {
            s.transition = (h.attrValue("transition"))
        }
        if (h.hasAttr("seconds")) {
            s.seconds = (PresDeck.num((h.attrValue("seconds")) s.seconds))
        }
        if (h.hasAttr("duration")) {
            s.wantDuration = (PresDeck.num((h.attrValue("duration")) -1.0))
        }
        if (h.hasAttr("step")) {
            s.stepGap = (PresDeck.num((h.attrValue("step")) s.stepGap))
        }
        if (h.hasAttr("fx")) {
            def named:string (h.attrValue("fx"))
            ; another effect than the deck's or the theme's: their settings
            ; (fx-hue: 280 for a starfield) were for that one, not this
            if (named != s.fx) {
                clear s.fxNames
                clear s.fxValues
            }
            s.fx = named
        }
        ; a heading below the level slides break at is a section of the page,
        ; and its picture is the section's band (`readBands`), not the page's
        def lay:MdLayout (this.layout())
        if ((h.hasAttr("bg")) && (h.level <= lay.splitLevel)) {
            s.bg = (h.attrValue("bg"))
            ; the slide's own picture is what it shows: the deck's or the
            ; theme's effect would cover it, one named on the heading stays
            if ((h.hasAttr("fx")) == false) {
                s.fx = ""
            }
        }
        if (h.hasAttr("bg-dim")) {
            s.bgDim = (PresDeck.num((h.attrValue("bg-dim")) 0.0))
        }
        if (h.hasAttr("art")) {
            s.art = (h.attrValue("art"))
            s.artTheme = false
            if (s.art == "off") {
                s.art = ""
            }
        }
        if (h.hasAttr("art-seed")) {
            s.artSeed = (to_int (PresDeck.num((h.attrValue("art-seed")) -1.0)))
        }
        def i:int 0
        while (i < (h.attrCount())) {
            def key:string (itemAt h.attrKeys i)
            if (((strlen key) > 3) && ((substring key 0 3) == "fx-")) {
                PresDeck.setFx(s (substring key 3 (strlen key)) (itemAt h.attrVals i))
            }
            i = (i + 1)
        }
    }

    fn readGroups:void (s:PresSlide n:MdNode) {
        def build:boolean (n.hasClass("build"))
        def anim:string ""
        if (n.hasAttr("anim")) {
            anim = (n.attrValue("anim"))
        }
        if ((! build) && ((strlen anim) == 0)) {
            return
        }
        if ((strlen anim) == 0) {
            anim = "rise"
        }
        def secs:double 0.5
        if (n.hasAttr("seconds")) {
            secs = (PresDeck.num((n.attrValue("seconds")) 0.5))
        }
        if (build && (n.kind == "code_block")) {
            ; ```js {lines=3-5|8 .build}: the code is there from the start,
            ; and each highlight comes at a step of its own
            def numbers:string ""
            if (n.hasClass("numbers")) {
                numbers = "1"
            }
            if (n.hasAttr("numbers")) {
                numbers = (n.attrValue("numbers"))
            }
            def cl:MdCodeLines (MdCodeLines.read(n.literal n.info numbers (n.attrValue("lines"))))
            if (cl.steps > 0) {
                def k:int 1
                while (k <= cl.steps) {
                    s.steps = (s.steps + 1)
                    this.addGroup(s s.steps n.srcStart n.srcEnd anim secs ("lines " + (to_string k)))
                    def g:PresGroup (itemAt s.groups ((array_length s.groups) - 1))
                    g.sub = k
                    k = (k + 1)
                }
                return
            }
        }
        if (build && (n.kind == "list")) {
            def i:int 0
            while (i < (n.childCount())) {
                def it:MdNode (n.childAt(i))
                s.steps = (s.steps + 1)
                this.addGroup(s s.steps it.srcStart it.srcEnd anim secs (it.plainText()))
                i = (i + 1)
            }
            return
        }
        def step:int 0
        if build {
            s.steps = (s.steps + 1)
            step = s.steps
        }
        this.addGroup(s step n.srcStart n.srcEnd anim secs (n.plainText()))
    }

    fn addGroup:void (s:PresSlide step:int a:int b:int anim:string secs:double words:string) {
        def g (new PresGroup())
        g.slide = s.index
        g.step = step
        g.start = a
        g.end = b
        g.anim = anim
        g.seconds = secs
        def w:string (trim words)
        if ((strlen w) > 24) {
            w = ((substring w 0 23) + "…")
        }
        g.label = w
        push s.groups g
    }

    ; Which group a box belongs to on its slide, or -1.
    fn groupOf:int (s:PresSlide b:MdBox) {
        def at:int (PresDeck.boxSrc(b))
        def i:int 0
        while (i < (array_length s.groups)) {
            def g:PresGroup (itemAt s.groups i)
            if (((at >= g.start) && (at < g.end)) && (g.sub == b.buildStep)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; A key of the front matter (the `---` block the text opens with), its
    ; value trimmed and in lower case; "" when it is not there.
    ; Whether `orientation: o` turns a page that is tall or not.
    sfn turns:boolean (o:string tall:boolean) {
        if (o == "portrait") {
            return (tall == false)
        }
        if (o == "landscape") {
            return tall
        }
        return false
    }

    sfn frontValue:string (t:string key:string) {
        def lines:[string] (strsplit t (strfromcode 10))
        if ((array_length lines) == 0) {
            return ""
        }
        if ((trim (itemAt lines 0)) != "---") {
            return ""
        }
        def want:string (key + ":")
        def i:int 1
        while (i < (array_length lines)) {
            def ln:string (trim (itemAt lines i))
            if ((ln == "---") || (ln == "...")) {
                return ""
            }
            if ((indexOf ln want) == 0) {
                return (MdChar.lower((trim (substring ln (strlen want) (strlen ln)))))
            }
            i = (i + 1)
        }
        return ""
    }

    ; `select-text: off` (no, false, none) in the front matter: the slides'
    ; text cannot be selected and copied in the viewer or while presenting
    ; (web/slidetext.js). By default it can, as text on a web page can.
    sfn selectTextOff:boolean (t:string) {
        def v:string (PresDeck.frontValue(t "select-text"))
        return ((((v == "off") || (v == "no")) || ((v == "false") || (v == "none"))) || (v == "0"))
    }

    sfn num:double (v:string fallback:double) {
        def t:string (trim v)
        if ((strlen t) == 0) {
            return fallback
        }
        def d@(optional):double (str2double t)
        if (null? d) {
            return fallback
        }
        return (unwrap d)
    }

    ; ------------------------------------------------------------------
    ; One slide as draw commands
    ; ------------------------------------------------------------------
    ;
    ; `groupOfCmd` gets one entry per command: the group it animates with,
    ; or -1 for what stands still. The list is in slide coordinates: (0, 0)
    ; is the slide's top-left corner.
    ;
    ; `boxOfCmd` is filled the same way with the index in the layout's boxes
    ; of the box each command was painted for, or -1 for the slide's own
    ; ground (paper, picture, effect, line art): what a reader of the list
    ; (the MCP server's layout report) needs to say which element drew what.
    def boxOfCmd:[int]

    ; Where slideList put the slide's 3-D worlds: the index of the first
    ; command over the slide's ground, -1 when no program on it may draw one
    ; (allow: 3d). The public viewer, whose lists the server lays out
    ; before any program runs, puts its worlds' pictures there.
    def worldsAt:int -1

    ; The 3-D worlds of slide i's programs (PresPlayView.paintWorlds): over
    ; the ground, under every box, each in the build step of its program's
    ; box. Sets worldsAt.
    fn paintWorlds:void (out:EVGDisplayList i:int s:PresSlide groupOfCmd:[int] mineAt:[int] groupOfBox:[int]) {
        worldsAt = -1
        def k:int 0
        while (k < (array_length s.plays)) {
            def u:PresPlayUse (itemAt s.plays k)
            k = (k + 1)
            if (u.spec.allows("3d")) {
                if (worldsAt < 0) {
                    worldsAt = (array_length out.cmds)
                }
                def bi:int (this.embedBox(i u.source))
                def v@(optional):PresPlayView (this.playView(u.key))
                if ((bi >= 0) && (!null? v)) {
                    def lay:MdLayout (this.layout())
                    def b:MdBox (itemAt lay.boxes bi)
                    def pv:PresPlayView (unwrap v)
                    pv.slideW = pageW
                    pv.slideH = pageH
                    pv.paintWorlds(out b.x b.y b.w b.h)
                    def group:int -1
                    def at:int (indexOf mineAt bi)
                    if (at >= 0) {
                        group = (itemAt groupOfBox at)
                    }
                    while ((array_length groupOfCmd) < (array_length out.cmds)) {
                        push groupOfCmd group
                    }
                }
            }
        }
    }

    fn slideList:EVGDisplayList (i:int groupOfCmd:[int] t:double) {
        def owners:[int]
        boxOfCmd = owners
        def parts0:[int]
        partOfCmd = parts0
        def sp0:[PresEnt]
        slideParts = sp0
        def l:MdLayout (this.layout())
        def s:PresSlide (itemAt slides i)
        def out:EVGDisplayList (new EVGDisplayList())
        def painter (new MdToEvg())
        def paper:string (PresDeck.paperOn(l i))
        painter.rect(out 0.0 0.0 pageW pageH paper)
        painter.paperAt(out l (l.pictureOf(i)) 0.0 0.0 pageW pageH)
        this.slideBackground(out l s paper)
        this.sectionBands(out l i paper)
        push groupOfCmd -1
        while ((array_length groupOfCmd) < (array_length out.cmds)) {
            push groupOfCmd -1
        }
        def useStill:boolean (still && (this.hasFxStill(i)))
        if useStill {
            def pic:EVGDrawCmd (new EVGDrawCmd())
            pic.kind = 2
            pic.x = 0.0
            pic.y = 0.0
            pic.w = pageW
            pic.h = pageH
            pic.src = (PresDeck.fxStillPath(i))
            pic.a = 1.0
            push out.cmds pic
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd -1
            }
        }
        if ((((strlen s.fx) > 0) && ((this.fxOnTop(s.fx)) == false)) && (useStill == false)) {
            this.addFx(out s (PresDeck.fxPaper(s paper)))
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd -1
            }
        }
        ; the line art over the effect's ground, under the text
        this.slideArt(out s i)
        while ((array_length groupOfCmd) < (array_length out.cmds)) {
            push groupOfCmd -1
        }
        ; Which group each of this slide's boxes is in. A list marker carries
        ; its LIST's offset, not its item's, so it takes the group of a box
        ; on its own line — before or after it, depending on the list kind.
        def mine:[MdBox]
        def mineAt:[int]
        def groupOfBox:[int]
        ; the effects on blocks (`{fx=…}`): their rectangle's command, their
        ; instance and their block
        def fxRect:[int]
        def fxInst:[int]
        def fxSrc:[int]
        ; this slide's boxes only, in box order (MdLayout.boxesOnPage)
        for (l.boxesOnPage(i)) bi:int oi {
            def b:MdBox (itemAt l.boxes bi)
            if (b.page == i) {
                push mine b
                push mineAt bi
                if (b.furniture > 0) {
                    ; the header and the footer arrive with the slide
                    push groupOfBox -1
                } {
                if ((b.kind == 0) && (b.segSrc < 0)) {
                    ; a marker: decided by its line, below
                    push groupOfBox -1
                } {
                    push groupOfBox (this.groupOf(s b))
                }
                }
            }
        }
        def m:int 0
        while (m < (array_length mine)) {
            def mb:MdBox (itemAt mine m)
            if (((itemAt groupOfBox m) < 0) && (((mb.kind == 0) && (mb.segSrc < 0)) && (mb.furniture == 0))) {
                def best:int -1
                def bestD:double 1000000.0
                def o:int 0
                while (o < (array_length mine)) {
                    def og:int (itemAt groupOfBox o)
                    def other:MdBox (itemAt mine o)
                    if (((o != m) && (og >= 0)) && (other.segSrc >= 0)) {
                        def ob:MdBox (itemAt mine o)
                        def d:double (fabs ((ob.y + (ob.h * 0.5)) - (mb.y + (mb.h * 0.5))))
                        if ((d < (mb.h * 0.6)) && (d < bestD)) {
                            bestD = d
                            best = og
                        }
                    }
                    o = (o + 1)
                }
                set groupOfBox m best
            }
            m = (m + 1)
        }
        this.paintWorlds(out i s groupOfCmd mineAt groupOfBox)
        def k:int 0
        while (k < (array_length mine)) {
            def kb:MdBox (itemAt mine k)
            while ((array_length boxOfCmd) < (array_length out.cmds)) {
                push boxOfCmd -1
            }
            while ((array_length partOfCmd) < (array_length out.cmds)) {
                push partOfCmd -1
            }
            def cmdFrom:int (array_length out.cmds)
            if (kb.kind == 6) {
                push fxRect cmdFrom
                push fxInst (array_length out.fxIds)
                push fxSrc kb.srcStart
            }
            def use:int -1
            if (kb.kind == 3) {
                ; the use of this very fence (`embedBoxAt`), else one
                ; with its text
                def du:int 0
                def exact:boolean false
                while (du < (array_length s.diagrams)) {
                    def cand:PresDiaUse (itemAt s.diagrams du)
                    if ((cand.source == kb.embedSource) && (exact == false)) {
                        use = du
                        if ((kb.srcStart >= 0) && (cand.srcStart == kb.srcStart)) {
                            exact = true
                        }
                    }
                    du = (du + 1)
                }
            }
            if (use >= 0) {
                def dia:PresDiaUse (itemAt s.diagrams use)
                dia.diagram.uiNow = uiNow
                dia.diagram.showControls = showControls
                dia.diagram.live = live
                ; a `bg=` can come after the fence was read
                dia.diagram.rimFade = (this.flatGround(s))
                ; The diagram gets the room below it, not just the box its
                ; picture fitted: a wide flowchart is a thin strip, and a
                ; camera zoomed into a strip shows a slot.
                def room:double (this.roomBelow(i kb))
                def span:[double] (this.diagramSpan(i kb))
                ; the magnifier: presenting, and the diagram drawn small here
                ; (laid out for the whole slide its boxes draw bigger)
                dia.diagram.canFull = false
                if ((live && showControls) && (still == false)) {
                    def big:PresDiagram (this.bigOf(s dia))
                    if big.ok {
                        def fb:[double] (this.fullBoxNow())
                        def was:double (PresDeck.drawnSize(dia.diagram (itemAt span 1) room))
                        def grown:double (PresDeck.drawnSize(big (itemAt fb 2) (itemAt fb 3)))
                        dia.diagram.canFull = (dia.diagram.full.open || (PresDiaFull.worth(was grown)))
                    }
                }
                def dBefore:int (array_length out.cmds)
                dia.diagram.partFrom = -1
                if still {
                    dia.diagram.paintStill(out (itemAt span 0) kb.y (itemAt span 1) room l.style.textColor paper l)
                } {
                    ; over the whole slide it is painted last, over everything
                    if ((dia.diagram.full.shown(uiNow)) == false) {
                        dia.diagram.paint(out (itemAt span 0) kb.y (itemAt span 1) room (t - dia.start) l.style.textColor paper l)
                    }
                }
                if (((strlen s.script) > 0) && (dia.diagram.partFrom >= dBefore)) {
                    this.diagramParts(out dia.diagram (itemAt mineAt k))
                }
            } {
                def sa@(optional):PresSmartArtUse (this.smartArtOf(s kb))
                if (!null? sa) {
                    def sau:PresSmartArtUse (unwrap sa)
                    def saSpan:[double] (this.smartArtSpan(kb.page kb sau))
                    PresSmartArt.paint(out sau md figStyle smartArtCache (itemAt saSpan 0) kb.y (itemAt saSpan 1) kb.h)
                } {
                def tu@(optional):PresTableUse (this.tableOf(kb))
                if (!null? tu) {
                    def tb:PresTableUse (unwrap tu)
                    tb.slide = i
                    PresTable.paint(out tb kb.x kb.y kb.w kb.h (? still tb.stillPage tb.page) (showControls && (still == false)) l.style.textColor (this.themeColour("chart" "accent-color")) l)
                } {
                def before:int (array_length out.cmds)
                if ((kb.kind != 3) || ((this.paintPlay(out s kb painter l)) == false)) {
                    painter.paintBox(out l kb 0.0)
                }
                if ((kb.kind == 3) && ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(kb.embedKind)))) == "vega")) {
                    ; the columns as drawn, before a dressing makes them
                    ; something else (rounded ones too, which it leaves):
                    ; what a script finds as `bar`
                    def raw:[EVGDrawCmd]
                    if ((strlen s.script) > 0) {
                        def tail:[EVGDrawCmd]
                        def ti:int before
                        while (ti < (array_length out.cmds)) {
                            push tail (itemAt out.cmds ti)
                            ti = (ti + 1)
                        }
                        def cols:[EVGDrawCmd] (PresChart.barsIn(tail (PresChart.rampStripes(tail)) kb.embedSource))
                        def ci:int 0
                        while (ci < (array_length cols)) {
                            def col:EVGDrawCmd (itemAt cols ci)
                            def r0:EVGDrawCmd (new EVGDrawCmd())
                            r0.x = col.x
                            r0.y = col.y
                            r0.w = col.w
                            r0.h = col.h
                            push raw r0
                            ci = (ci + 1)
                        }
                    }
                    this.dressChart(out before (t - (this.chartStart(s kb.embedSource))) still kb.embedSource i)
                    if still {
                        PresChart.flatten(out before paper)
                    }
                    if ((strlen s.script) > 0) {
                        this.chartParts(out before raw (itemAt mineAt k) kb.embedSource)
                    }
                }
                }
                }
            }
            ; the looks a program gave this block (`el("#id")`)
            def looks:[PresPlayLook] (this.looksOfBox(kb))
            def lk:int 0
            while (lk < (array_length looks)) {
                PresPlayStyle.dress(out cmdFrom (itemAt looks lk))
                lk = (lk + 1)
            }
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd (itemAt groupOfBox k)
            }
            ; the commands just painted are this box's
            while ((array_length boxOfCmd) < (array_length out.cmds)) {
                push boxOfCmd (itemAt mineAt k)
            }
            while ((array_length partOfCmd) < (array_length out.cmds)) {
                push partOfCmd -1
            }
            k = (k + 1)
        }
        this.fitBlockEffects(out l fxRect fxInst fxSrc)
        ; An effect that refracts what is behind it goes over the finished
        ; slide, with no background of its own: under the content it read the
        ; bare paper and the slide was then painted over it, so nothing showed.
        if ((((strlen s.fx) > 0) && (this.fxOnTop(s.fx))) && (useStill == false)) {
            this.addFx(out s "")
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd -1
            }
        }
        ; the drawings made on the slide, over its content
        this.paintSketches(out i s t l)
        this.paintStory(out s t l)
        while ((array_length groupOfCmd) < (array_length out.cmds)) {
            push groupOfCmd -1
        }
        ; a game that has the keyboard over the slide's text (stage only)
        if ((still == false) && showControls) {
            this.paintFocusOver(out i)
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd -1
            }
        }
        ; a diagram opened over the whole slide, on a veil of the slide's colour
        if (still == false) {
            this.paintFull(out i s t l paper)
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd -1
            }
        }
        ; a chart's cut words under the pointer, over everything: on the
        ; stage only (not in a thumbnail or an export)
        if (((i == tipSlide) && (still == false)) && showControls) {
            if ((strlen tipText) > 0) {
                this.paintTip(out l)
                while ((array_length groupOfCmd) < (array_length out.cmds)) {
                    push groupOfCmd -1
                }
            }
            tipDrawn = tipRev
        }
        while ((array_length boxOfCmd) < (array_length out.cmds)) {
            push boxOfCmd -1
        }
        this.clockParams(out s t)
        while ((array_length partOfCmd) < (array_length out.cmds)) {
            push partOfCmd -1
        }
        ; the slide's script: what it set laid over what was drawn
        def sfo@(optional):PresScriptFrame (this.scriptFrameFor(i))
        if (!null? sfo) {
            def sf:PresScriptFrame (unwrap sfo)
            if ((sf.count()) > 0) {
                def sc:PresScene (this.sceneOfListHeld(i out))
                PresScriptApply.apply(out sc sf groupOfCmd boxOfCmd l.engine l.style.textColor (this.themeColour("chart" "accent-color")))
                while ((array_length partOfCmd) < (array_length out.cmds)) {
                    push partOfCmd -1
                }
            }
        }
        return out
    }

    ; The slide's clock at `t` while it plays (`live`, or `fxClockAt` for a
    ; picture of one moment), else its end state, as the hidden parameters of
    ; every own effect on it that reads the clock (FxLang: step, steps,
    ; steptime, progress). Nothing changes for a list without one.
    def fxClockAt:double -1.0

    fn clockParams:void (out:EVGDisplayList s:PresSlide t:double) {
        ; every own effect gets its box's size in slide pixels (box-w,
        ; box-h: FxLang.glsl's `p` and `size`); one with the clock its clock
        def any:boolean false
        def i:int 0
        while (i < (array_length out.fxIds)) {
            def own@(optional):FxEffect (this.ownEffect((itemAt out.fxKinds i)))
            if (!null? own) {
                any = true
            }
            i = (i + 1)
        }
        if (any == false) {
            return
        }
        def clock:[double]
        if live {
            clock = (PresTimeline.fxClock(s t))
        } {
            if (fxClockAt >= 0.0) {
                clock = (PresTimeline.fxClock(s fxClockAt))
            }
        }
        def names:[string]
        def values:[double]
        def starts:[int]
        def counts:[int]
        i = 0
        while (i < (array_length out.fxIds)) {
            def start:int (array_length names)
            push starts start
            def ps:int (itemAt out.fxParamStart i)
            def pn:int (itemAt out.fxParamCount i)
            def k:int 0
            while (k < pn) {
                push names (itemAt out.fxParamNames (ps + k))
                push values (itemAt out.fxParamValues (ps + k))
                k = (k + 1)
            }
            def own2@(optional):FxEffect (this.ownEffect((itemAt out.fxKinds i)))
            if (!null? own2) {
                push names "box-w"
                push values (itemAt out.fxW i)
                push names "box-h"
                push values (itemAt out.fxH i)
                if own2.clock {
                    def c:[double] clock
                    if ((array_length c) == 0) {
                        c = (FxLang.clockEnd((to_double s.steps) own2.still))
                    }
                    def cn:[string] (FxLang.clockNames())
                    def j:int 0
                    while (j < 4) {
                        push names ("clock-" + (itemAt cn j))
                        push values (itemAt c j)
                        j = (j + 1)
                    }
                }
            }
            push counts ((array_length names) - start)
            i = (i + 1)
        }
        out.fxParamNames = names
        out.fxParamValues = values
        out.fxParamStart = starts
        out.fxParamCount = counts
    }

    ; An effect on a block covers what the block drew: a diagram or a chart
    ; is drawn in the room around its layout box (roomBelow, diagramSpan),
    ; so the box the layout gave the effect is widened to the commands the
    ; block's boxes painted, the rectangle and the instance alike.
    fn fitBlockEffects:void (out:EVGDisplayList l:MdLayout rects:[int] insts:[int] srcs:[int]) {
        def e:int 0
        while (e < (array_length rects)) {
            def src:int (itemAt srcs e)
            def any:boolean false
            def x0:double 0.0
            def y0:double 0.0
            def x1:double 0.0
            def y1:double 0.0
            def i:int 0
            while (i < (array_length out.cmds)) {
                def bi:int -1
                if (i < (array_length boxOfCmd)) {
                    bi = (itemAt boxOfCmd i)
                }
                if ((bi >= 0) && (bi < (array_length l.boxes))) {
                    def b:MdBox (itemAt l.boxes bi)
                    def c:EVGDrawCmd (itemAt out.cmds i)
                    if ((((b.srcStart == src) && (b.kind != 6)) && (c.kind != 4)) && ((c.w > 0.0) && (c.h > 0.0))) {
                        if (any == false) {
                            x0 = c.x
                            y0 = c.y
                            x1 = (c.x + c.w)
                            y1 = (c.y + c.h)
                            any = true
                        } {
                            if (c.x < x0) { x0 = c.x }
                            if (c.y < y0) { y0 = c.y }
                            if ((c.x + c.w) > x1) { x1 = (c.x + c.w) }
                            if ((c.y + c.h) > y1) { y1 = (c.y + c.h) }
                        }
                    }
                }
                i = (i + 1)
            }
            def ri:int (itemAt rects e)
            def fi:int (itemAt insts e)
            if ((any && (ri < (array_length out.cmds))) && (fi < (array_length out.fxIds))) {
                def r:EVGDrawCmd (itemAt out.cmds ri)
                r.x = x0
                r.y = y0
                r.w = (x1 - x0)
                r.h = (y1 - y0)
                set_at out.fxX fi x0
                set_at out.fxY fi y0
                set_at out.fxW fi (x1 - x0)
                set_at out.fxH fi (y1 - y0)
            }
            e = (e + 1)
        }
    }

    ; The diagram of slide i shown over the whole slide (PresDiaFull), if any:
    ; the slide fades under a veil of its own colour as the box grows.
    fn paintFull:void (out:EVGDisplayList i:int s:PresSlide t:double l:MdLayout paper:string) {
        def k:int (this.fullAt(i))
        if (k < 0) {
            return
        }
        def u:PresDiaUse (itemAt s.diagrams k)
        def a:double (u.diagram.full.amount(uiNow))
        def pc:EVGColor (EVGColor.parse(paper))
        def veil (new EVGDrawCmd())
        veil.kind = 0
        veil.x = 0.0
        veil.y = 0.0
        veil.w = pageW
        veil.h = pageH
        veil.r = (pc.red())
        veil.g = (pc.green())
        veil.b = (pc.blue())
        veil.a = a
        push out.cmds veil
        def b:[double] (u.boxNow(uiNow (this.fullBoxNow())))
        def dd:PresDiagram (u.active(uiNow))
        dd.uiNow = uiNow
        dd.showControls = showControls
        dd.live = live
        dd.rimFade = u.diagram.rimFade
        dd.paint(out (itemAt b 0) (itemAt b 1) (itemAt b 2) (itemAt b 3) (u.activeTime(t uiNow)) l.style.textColor paper l)
    }

    ; The slide's line art (`{art=waves}`), over its picture and under the
    ; content, or nothing when it has none or art is not allowed (not PRO;
    ; the theme's own art is always drawn).
    fn artScene:FlowScene (s:PresSlide i:int) {
        if (((strlen s.art) == 0) || ((artAllowed == false) && (s.artTheme == false))) {
            def none (new FlowScene)
            return none
        }
        def seed:int s.artSeed
        if (seed < 0) {
            seed = (i + 1)
        }
        return (MdFigure.art(s.art figStyle pageW pageH seed))
    }

    fn slideArt:void (out:EVGDisplayList s:PresSlide i:int) {
        def sc:FlowScene (this.artScene(s i))
        sc.emitInto(out)
    }

    ; How the figures look in this theme:
    ;
    ;   figure {
    ;     colors: #1f6feb #0f9d8a #7c4dff #f08c00;   the series, in order
    ;     color: #B96926;  accent-color: #59C3C4;   or the first two
    ;     font-size: 18pt;                          the titles in them
    ;     card-background: #ffffff;                 the cards, not tinted
    ;     box-shadow: 0 6pt 18pt rgba(0,0,0,.12);   a soft shadow under them
    ;   }
    ;
    ; With no `figure` rule the chart's colours are used. Text and paper are
    ; the document's.
    fn figureStyle:MdFigureStyle () {
        def st (new MdFigureStyle)
        def cols:[string]
        def list:string (trim (this.themeRule("figure" "colors")))
        if ((strlen list) > 0) {
            def parts:[string] (strsplit list " ")
            def pi:int 0
            while (pi < (array_length parts)) {
                def c:string (PresDeck.unComma((trim (itemAt parts pi))))
                if ((strlen c) > 0) {
                    push cols c
                }
                pi = (pi + 1)
            }
        }
        if ((array_length cols) == 0) {
            def c1:string (trim (this.themeRule("figure" "color")))
            def c2:string (trim (this.themeRule("figure" "accent-color")))
            if ((strlen c1) == 0) {
                c1 = (this.chartColour("color"))
            }
            if ((strlen c2) == 0) {
                c2 = (this.chartColour("accent-color"))
            }
            if ((strlen c1) > 0) {
                push cols c1
            }
            if ((strlen c2) > 0) {
                push cols c2
            }
        }
        if ((array_length cols) > 0) {
            st.colors = cols
        }
        def ink:string (trim (this.themeRule("document" "color")))
        if ((strlen ink) > 0) {
            st.ink = ink
            st.muted = ink
        }
        def paper:string (trim (this.themeRule("page" "background-color")))
        if ((strlen paper) > 0) {
            st.paper = paper
        }
        def font:string (trim (this.themeRule("document" "font-family")))
        if ((strlen font) > 0) {
            st.font = (PresDeck.unQuote(font))
        }
        ; white cards with a soft shadow, as a template's key figures are:
        ;   figure { card-background: #ffffff; box-shadow: 0 6pt 18pt rgba(…) }
        def cardBg:string (trim (this.themeRule("figure" "card-background")))
        if ((strlen cardBg) > 0) {
            def cbc:EVGColor (EVGColor.parse(cardBg))
            if cbc.isSet {
                st.cardFill = (MdContainer.hexOf(cbc))
            }
        }
        def shadowRule:string (trim (this.themeRule("figure" "box-shadow")))
        if ((strlen shadowRule) > 0) {
            st.cardShadow = (MdContainer.shadowColour(shadowRule))
        }
        ; in points, the layout's unit; without a size of its own a figure
        ; takes the document's, a little smaller: its titles are labels, not
        ; headings (on a slide with room it is set larger again, up to the
        ; room under the heading — MdFigure.sceneFit)
        def fs:string (this.themeLength("figure" "figure" "font-size"))
        def scale:double 1.0
        if ((strlen fs) == 0) {
            fs = (this.themeLength("document" "document" "font-size"))
            scale = 0.85
        }
        if ((strlen fs) > 0) {
            st.size = ((PresDeck.num(fs 18.0)) * scale)
        } {
            st.size = 16.0
        }
        ; the layouts drawn from lists are drawn for everyone
        st.allowed = true
        return st
    }

    sfn unComma:string (c:string) {
        def n:int (strlen c)
        if ((n > 0) && ((charAt c (n - 1)) == 44)) {
            return (substring c 0 (n - 1))
        }
        return c
    }

    ; the first face of a font-family list, without its quotes
    sfn unQuote:string (f:string) {
        def t:string (trim f)
        def comma:int (indexOf t ",")
        if (comma > 0) {
            t = (trim (substring t 0 comma))
        }
        def n:int (strlen t)
        if ((n >= 2) && (((charAt t 0) == 34) || ((charAt t 0) == 39))) {
            return (substring t 1 (n - 1))
        }
        return t
    }

    fn hasFxStill:boolean (i:int) {
        def k:int 0
        while (k < (array_length fxStills)) {
            if ((itemAt fxStills k) == i) {
                return true
            }
            k = (k + 1)
        }
        return false
    }

    sfn fxStillPath:string (i:int) {
        return ("fx-still-" + (to_string i) + ".jpg")
    }

    ; SECTION BANDS. On a page that holds several sections (the editorial
    ; theme: `##` does not break the A4 page) a `{bg=…}` heading's picture
    ; is drawn behind its section — the heading and the blocks under it, down
    ; to the next heading of its level or above — as a band across the page,
    ; dimmed as `bg-dim` asks. A section running onto the next page has a
    ; band there too. One band per section and page.
    def bandKey:[int]
    def bandPage:[int]
    def bandY0:[double]
    def bandY1:[double]
    def bandSrc:[string]
    def bandDim:[double]

    fn readBands:void (l:MdLayout doc:MdNode) {
        clear bandKey
        clear bandPage
        clear bandY0
        clear bandY1
        clear bandSrc
        clear bandDim
        def childSec:[int] (PresDeck.sectionsOf(doc l.splitLevel))
        def any:boolean false
        def c:int 0
        while (c < (array_length childSec)) {
            if ((itemAt childSec c) >= 0) {
                any = true
            }
            c = (c + 1)
        }
        if (any == false) {
            return
        }
        def ci:int 0
        def bi:int 0
        while (bi < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes bi)
            def at:int (PresDeck.boxSrc(b))
            if ((b.furniture == 0) && (at >= 0)) {
                ; the block it belongs to: boxes come in the document's order,
                ; so the search goes on from the last one
                def n:int (doc.childCount())
                if (ci >= n) {
                    ci = 0
                }
                def cur:MdNode (doc.childAt(ci))
                if (at < cur.srcStart) {
                    ci = 0
                }
                def going:boolean true
                while (going && (ci < n)) {
                    def ch:MdNode (doc.childAt(ci))
                    if (at >= ch.srcEnd) {
                        ci = (ci + 1)
                    } {
                        going = false
                    }
                }
                if (ci < n) {
                    def sec:int (itemAt childSec ci)
                    def own:MdNode (doc.childAt(ci))
                    if ((sec >= 0) && (at >= own.srcStart)) {
                        this.extendBand(sec (doc.childAt(sec)) b)
                    }
                }
            }
            bi = (bi + 1)
        }
    }

    ; For each top-level block, the index of the `{bg=…}` heading whose
    ; section it is in (the heading itself included), -1: none. Only
    ; headings below `splitLevel` open a section; one of its level or above
    ; closes it.
    sfn sectionsOf:[int] (doc:MdNode splitLevel:int) {
        def out:[int]
        def open:int -1
        def openLevel:int 99
        def c:int 0
        while (c < (doc.childCount())) {
            def ch:MdNode (doc.childAt(c))
            if (ch.kind == "heading") {
                if (ch.level <= openLevel) {
                    open = -1
                    openLevel = 99
                }
                if ((ch.level > splitLevel) && (ch.hasAttr("bg"))) {
                    open = c
                    openLevel = ch.level
                }
            }
            push out open
            c = (c + 1)
        }
        return out
    }

    fn extendBand:void (sec:int h:MdNode b:MdBox) {
        def i:int 0
        while (i < (array_length bandKey)) {
            if (((itemAt bandKey i) == sec) && ((itemAt bandPage i) == b.page)) {
                if (b.y < (itemAt bandY0 i)) {
                    set bandY0 i b.y
                }
                if ((b.y + b.h) > (itemAt bandY1 i)) {
                    set bandY1 i (b.y + b.h)
                }
                return
            }
            i = (i + 1)
        }
        push bandKey sec
        push bandPage b.page
        push bandY0 b.y
        push bandY1 (b.y + b.h)
        push bandSrc (h.attrValue("bg"))
        def dim:double 0.0
        if (h.hasAttr("bg-dim")) {
            dim = (PresDeck.num((h.attrValue("bg-dim")) 0.0))
        }
        push bandDim dim
    }

    ; Page `p`'s section bands, behind its text.
    fn sectionBands:void (out:EVGDisplayList l:MdLayout p:int paper:string) {
        def i:int 0
        while (i < (array_length bandKey)) {
            if ((itemAt bandPage i) == p) {
                def pad:double (l.style.bodySize * 0.8)
                def y0:double ((itemAt bandY0 i) - pad)
                def y1:double ((itemAt bandY1 i) + pad)
                if (y0 < 0.0) {
                    y0 = 0.0
                }
                if (y1 > pageH) {
                    y1 = pageH
                }
                this.coverPicture(out l (itemAt bandSrc i) y0 (y1 - y0) (itemAt bandDim i) paper)
            }
            i = (i + 1)
        }
    }

    ; The slide's own picture over the paper, covering the slide, and the
    ; paper again over it as far as `bg-dim` asks.
    fn slideBackground:void (out:EVGDisplayList l:MdLayout s:PresSlide paper:string) {
        if ((strlen s.bg) == 0) {
            return
        }
        this.coverPicture(out l s.bg 0.0 pageH s.bgDim paper)
    }

    ; Picture `src` across the page from `y`, `h` high, cropped to cover
    ; that band from its middle, and the paper over it `dim` strong.
    fn coverPicture:void (out:EVGDisplayList l:MdLayout src:string y:double h:double dim:double paper:string) {
        if (l.haveImages == false) {
            return
        }
        def path:string (l.images.resolve(src l.docDir))
        if ((strlen path) == 0) {
            return
        }
        def st:VfsStat (l.images.stat(path))
        if (st.found == false) {
            return
        }
        if (h <= 0.0) {
            return
        }
        def c:EVGDrawCmd (new EVGDrawCmd())
        c.kind = 2
        c.x = 0.0
        c.y = y
        c.w = pageW
        c.h = h
        c.src = path
        c.a = 1.0
        ; cover: the middle of the picture, in the band's shape
        if ((st.pixelW > 0) && (st.pixelH > 0)) {
            def pr:double ((to_double st.pixelW) / (to_double st.pixelH))
            def sr:double (pageW / h)
            c.hasCrop = true
            if (pr > sr) {
                c.cropW = (sr / pr)
                c.cropX = ((1.0 - c.cropW) * 0.5)
            } {
                c.cropH = (pr / sr)
                c.cropY = ((1.0 - c.cropH) * 0.5)
            }
        }
        push out.cmds c
        if (dim > 0.0) {
            def d:EVGDrawCmd (new EVGDrawCmd())
            d.kind = 0
            d.y = y
            d.w = pageW
            d.h = h
            def pc:EVGColor (EVGColor.parse(paper))
            d.r = (pc.red())
            d.g = (pc.green())
            d.b = (pc.blue())
            d.a = dim
            if (d.a > 1.0) {
                d.a = 1.0
            }
            push out.cmds d
        }
    }

    ; A slide's paper and its effect alone, for the host to render the
    ; effect as a picture the exports can carry. An effect that reads the
    ; page under it gets the paper to read.
    fn fxOnlyList:EVGDisplayList (i:int) {
        def l:MdLayout (this.layout())
        def s:PresSlide (itemAt slides i)
        def out:EVGDisplayList (new EVGDisplayList())
        def painter (new MdToEvg())
        def paper:string (PresDeck.paperOn(l i))
        painter.rect(out 0.0 0.0 pageW pageH paper)
        painter.paperAt(out l (l.pictureOf(i)) 0.0 0.0 pageW pageH)
        this.slideBackground(out l s paper)
        if ((strlen s.fx) > 0) {
            if (this.fxOnTop(s.fx)) {
                this.addFx(out s "")
            } {
                this.addFx(out s (PresDeck.fxPaper(s paper)))
            }
        }
        ; the clock at its end, as the slide's still list has it
        this.clockParams(out s -1.0)
        return out
    }

    ; The effects that read the page under them (a `backdrop` layer in the
    ; WebGL painter) rather than paint a picture of their own.
    fn fxOnTop:boolean (fx:string) {
        def own@(optional):FxEffect (this.ownEffect(fx))
        if (!null? own) {
            return (own.layer != "source")
        }
        return ((((fx == "liquid-glass") || (fx == "raindrop")) || (fx == "bubbles")) || (fx == "drops")) || (fx == "raindrops2")
    }

    ; The colour an effect drawn under the content lays down first: the
    ; page's, unless the slide has its own picture (`bg=`), which the effect
    ; is drawn over, so `bg=sky.svg fx=starfield` is stars over the sky
    sfn fxPaper:string (s:PresSlide paper:string) {
        if ((strlen s.bg) > 0) {
            return ""
        }
        return paper
    }

    ; The slide's surface effect: an element as big as the slide, dressed by
    ; the same `evg-surface-effect` CSS the rest of EVG reads, laid out and
    ; built into commands. Its id is the slide's so two slides on screen at
    ; once (a transition) keep two instances apart.
    fn addFx:void (out:EVGDisplayList s:PresSlide paper0:string) {
        def paper:string paper0
        ; a deck's own effect paints over its `fallback` colour, which is
        ; also all that shows where no GPU draws it
        def own@(optional):FxEffect (this.ownEffect(s.fx))
        if (!null? own) {
            if (((strlen own.fallback) > 0) && ((strlen paper0) > 0)) {
                paper = own.fallback
            }
        }
        def css:string (".pres-fx { evg-surface-effect: " + s.fx + "; evg-effect-on: always;")
        if ((strlen paper) > 0) {
            css = (".pres-fx { background-color: " + paper + "; evg-surface-effect: " + s.fx + "; evg-effect-on: always;")
        }
        def i:int 0
        while (i < (array_length s.fxNames)) {
            css = (css + " evg-fx-" + (itemAt s.fxNames i) + ": " + (itemAt s.fxValues i) + ";")
            i = (i + 1)
        }
        css = (css + " }")
        def root (new EVGElement())
        root.id = ("fx-s" + (to_string s.index))
        root.className = "pres-fx"
        root.setAttribute("width" ((to_string pageW) + "px"))
        root.setAttribute("height" ((to_string pageH) + "px"))
        def sheet (new EVGStyleSheet())
        sheet.parse(css)
        sheet.setViewport(pageW pageH false)
        sheet.applyTree(root "")
        def lay (new EVGLayout())
        lay.setPageSize(pageW pageH)
        lay.layout(root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(root)
        PresDeck.appendAll(out dl)
    }

    ; Commands AND effect instances. `appendFrom` carries the commands only,
    ; and a command whose `efx` names an instance the list does not have
    ; draws nothing.
    sfn appendAll:void (out:EVGDisplayList src:EVGDisplayList) {
        out.appendFrom(src)
        PresDeck.appendFx(out src)
    }

    ; The effect instances alone, for a list whose commands were copied by hand.
    sfn appendFx:void (out:EVGDisplayList src:EVGDisplayList) {
        def i:int 0
        while (i < (array_length src.fxIds)) {
            push out.fxIds (itemAt src.fxIds i)
            push out.fxKinds (itemAt src.fxKinds i)
            push out.fxTriggers (itemAt src.fxTriggers i)
            push out.fxX (itemAt src.fxX i)
            push out.fxY (itemAt src.fxY i)
            push out.fxW (itemAt src.fxW i)
            push out.fxH (itemAt src.fxH i)
            push out.fxRadius (itemAt src.fxRadius i)
            def start:int (array_length out.fxParamNames)
            push out.fxParamStart start
            def ps:int (itemAt src.fxParamStart i)
            def pn:int (itemAt src.fxParamCount i)
            def k:int 0
            while (k < pn) {
                push out.fxParamNames (itemAt src.fxParamNames (ps + k))
                push out.fxParamValues (itemAt src.fxParamValues (ps + k))
                k = (k + 1)
            }
            push out.fxParamCount pn
            i = (i + 1)
        }
    }
}
