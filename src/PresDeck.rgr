; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresDeck.rgr — the markdown, laid out as slides, with what moves on them.
; ============================================================================
;
;   editor text ──► PresSource (lift ::: blocks) ──► MarkdownEdit (slides)
;                                                        │
;                   PresSlide[]  ◄── attributes, notes ──┤
;                        │                               │
;                        └──► PresTimeline ──► one EVGDisplayList per frame
;
; The layout is the markdown module's, unchanged: `layoutSlides` decides the
; breaks, `MdToEvg.paintBox` draws each box. What this file adds is WHICH
; boxes belong together on the timeline. A box knows the source offset it
; came from, and a `{.build}` list's items know their source ranges, so a box
; is given to the item whose range holds it. No second layout, no guessing
; from positions — except for a list marker, which carries its list's offset
; rather than its item's, and so goes with the item on its own line.
;
; Attributes this reads (all optional):
;
;   heading     {#id transition=fade|slide|zoom|none seconds=0.6
;                duration=8 fx=starfield fx-density=1.6}
;   any block   {.build}           reveal in steps (a list: one per item)
;               {anim=fade|rise|fly|zoom seconds=0.5}
;   front matter  transition, seconds, fx, fx-*, step (seconds between
;                 build steps), hold (seconds after the last step)
; ============================================================================

Import "../markdown/web/markdown_web.rgr"
Import "PresSource.rgr"
Import "PresDiagram.rgr"
Import "PresChart.rgr"
Import "PresTable.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGStyleSheet.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class PresGroup {
    def slide:int 0
    ; 0 = arrives with the slide; 1.. = the build step that reveals it
    def step:int 0
    ; the source range whose boxes belong to it
    def start:int 0
    def end:int 0
    def anim:string "rise"
    def seconds:double 0.5
    ; seconds after the slide starts; set by PresTimeline
    def at:double 0.0
    ; a short label for the track: the first words
    def label:string ""
}

; A chart fence on a slide: its columns rise and its beam passes from when
; the group that reveals it arrives (or the slide does), and the slide is
; not held — at its end or at the next build step — before that is over.
class PresChartUse {
    def source:string ""
    def srcStart:int 0
    ; seconds after the slide starts; set by PresTimeline (-1: not yet)
    def start:double -1.0
}

; A diagram fence on a slide, drawn by PresDiagram rather than as a picture.
class PresDiaUse {
    def diagram:PresDiagram (new PresDiagram())
    ; the fence's own text, which is what its layout box names
    def source:string ""
    def srcStart:int 0
    ; seconds after the slide starts; set by PresTimeline
    def start:double 0.0
    ; where it is drawn on the slide
    def bx:double 0.0
    def by:double 0.0
    def bw:double 0.0
    def bh:double 0.0
}

class PresSlide {
    def index:int 0
    def id:string ""
    def title:string ""
    def transition:string "fade"
    def seconds:double 0.6
    def fx:string ""
    ; a picture behind this slide (`{bg=media/kansi.jpg}`), covering it, and
    ; how much of the paper is laid over it to keep the text readable
    ; (`{bg-dim=0.4}`)
    def bg:string ""
    def bgDim:double 0.0
    ; line art drawn behind the slide (`{art=waves}`, MdFigure.art) and the
    ; number that moves its curves (`{art-seed=3}`; the slide's own by
    ; default, so two slides with waves are not the same picture)
    def art:string ""
    def artSeed:int -1
    def fxNames:[string]
    def fxValues:[string]
    def notes:string ""
    def audio:string ""
    ; the first and last source offsets laid out on this slide
    def srcStart:int -1
    def srcEnd:int -1
    ; seconds; set by PresTimeline
    def duration:double 0.0
    def wantDuration:double -1.0
    def stepGap:double 1.2
    def hold:double 2.5
    def groups:[PresGroup]
    def steps:int 0
    def diagrams:[PresDiaUse]
    def charts:[PresChartUse]

    Constructor () {
        def du:[PresDiaUse]
        diagrams = du
        def cu:[PresChartUse]
        charts = cu
        def a:[string]
        fxNames = a
        def b:[string]
        fxValues = b
        def g:[PresGroup]
        groups = g
    }
}

class PresDeck {
    ; The engine: fonts, pictures, templates, the PDF and the PPTX.
    def md:MarkdownWeb (new MarkdownWeb())
    def src:PresSource (new PresSource())
    def slides:[PresSlide]
    def text:string ""
    ; moves on every rebuild, so a host can keep what it built from the last one
    def revision:int 0
    ; How many charts and figures drawn under old defaults one rebuild draws
    ; again (-1: all of them), and the source range drawn first whatever the
    ; count (the slide on the screen). A change to `chart { … }` used to draw
    ; every chart of the deck in the frame it was typed in; PresApp sets a
    ; few while editing and draws the rest in the frames after (`settle`).
    ; MdEmbedCache.redrawBudget.
    def redrawBudget:int -1
    def focusFrom:int -1
    def focusTo:int -1
    ; the host's wall clock, for the viewer's camera moves, and whether the
    ; list being built is the stage (controls drawn) or a thumbnail
    def uiNow:double 0.0
    def showControls:boolean false
    ; Painting for a page that does not move (the PDF): every diagram at
    ; rest, whole, rather than where its walk is at a moment.
    def still:boolean false
    ; The layouts drawn from lists (```process, ```swot, ```timeline) and
    ; the slides' line art are PRO: the page says whether they are drawn
    ; (`PresApp.setPro`). Not drawn, a fence's slot says so.
    def figuresAllowed:boolean false
    ; the theme's colours for them, as last read (`figureStyle`)
    def figStyle:MdFigureStyle (new MdFigureStyle)
    ; Slides whose effect the host rendered to a picture for an export
    ; (`fxStillPath`); a still list draws the picture in place of the effect.
    def fxStills:[int]
    def pageW:double 960.0
    def pageH:double 540.0
    ; The front matter's `orientation` ("portrait", "landscape" or ""), and
    ; the theme's page turned on its side ("540x960pt") for the stylesheet
    ; it was measured with.
    def orientation:string ""
    def themeSizeOf:string ""
    def themeSizeTurned:string ""
    ; What the template says about the presentation beyond what markdown
    ; reads: `deck { fx: starfield; fx-hue: 280 }`, or the older comment
    ; `/* pres: fx=starfield fx-hue=280 */` anywhere in its CSS.
    def themeKeys:[string]
    def themeVals:[string]
    ; Diagrams by (notation, width, text): a keystroke elsewhere in the
    ; document must not lay every diagram out again.
    def diaKeys:[string]
    def diaVals:[PresDiagram]

    Constructor () {
        def s:[PresSlide]
        slides = s
        def tk:[string]
        themeKeys = tk
        def tv:[string]
        themeVals = tv
        def k:[string]
        diaKeys = k
        def v:[PresDiagram]
        diaVals = v
    }

    fn diagramFor:PresDiagram (notation:string text:string width:double) {
        return (this.diagramAs(notation text width 0.0))
    }

    ; `aspect` > 0: the flow engine's column-wrapped layout for that room.
    fn diagramAs:PresDiagram (notation:string text:string width:double aspect:double) {
        def key:string (notation + "|" + (to_string width) + "|" + (to_string aspect) + "|" + text)
        def i:int 0
        while (i < (array_length diaKeys)) {
            if ((itemAt diaKeys i) == key) {
                return (itemAt diaVals i)
            }
            i = (i + 1)
        }
        def d:PresDiagram (PresDiagram.of(notation text width))
        if (aspect > 0.0) {
            d = (PresDiagram.wrapped(notation text width aspect))
        }
        push diaKeys key
        push diaVals d
        if ((array_length diaKeys) > 40) {
            remove_index diaKeys 0
            remove_index diaVals 0
        }
        return d
    }

    ; ------------------------------------------------------------------
    ; A diagram the viewer steers
    ; ------------------------------------------------------------------
    ; What a press at slide point (px, py) at slide time t means: "k:i" for
    ; option i of diagram k, "k:back", or "".
    fn diagramHit:string (i:int t:double px:double py:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return ""
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            u.diagram.uiNow = uiNow
            def r:int (u.diagram.hit((t - u.start) u.bx u.by u.bw u.bh px py))
            if (r == -2) {
                return ((to_string k) + ":back")
            }
            if (r == -3) {
                return ((to_string k) + ":zin")
            }
            if (r == -4) {
                return ((to_string k) + ":zout")
            }
            if (r == -5) {
                return ((to_string k) + ":fit")
            }
            if (r == -6) {
                return ((to_string k) + ":menu")
            }
            if (r == -7) {
                return ((to_string k) + ":restart")
            }
            if (r == -8) {
                return ((to_string k) + ":all")
            }
            if (r == -10) {
                return ((to_string k) + ":skip")
            }
            if (r == -11) {
                return ((to_string k) + ":tour")
            }
            if (r == -9) {
                return ((to_string k) + ":none")
            }
            if (r >= 3000) {
                return ((to_string k) + ":way" + (to_string (r - 3000)))
            }
            if (r >= 2000) {
                return ((to_string k) + ":way" + (to_string (r - 2000)))
            }
            if (r >= 1000) {
                return ((to_string k) + ":node" + (to_string (r - 1000)))
            }
            if (r >= 0) {
                return ((to_string k) + ":" + (to_string r))
            }
            k = (k + 1)
        }
        return ""
    }

    ; The charts (```vega-lite) laid out on slide i, as layout box indices.
    fn chartBoxes:[int] (i:int) {
        def out:[int]
        def l:MdLayout (this.layout())
        def k:int 0
        while (k < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes k)
            if (((b.page == i) && (b.kind == 3)) && ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(b.embedKind)))) == "vega")) {
                push out k
            }
            k = (k + 1)
        }
        return out
    }

    ; The table a laid-out box draws, if it is one.
    fn tableOf@(optional):PresTableUse (b:MdBox) {
        if (b.kind == 3) {
            def src0:string (trim b.embedSource)
            def i:int 0
            while (i < (array_length tables)) {
                def u:PresTableUse (itemAt tables i)
                if (u.key == src0) {
                    def hit@(optional):PresTableUse u
                    return hit
                }
                i = (i + 1)
            }
        }
        def miss@(optional):PresTableUse
        return miss
    }

    ; The live sheets (```sheet) laid out on slide i, in slide coordinates, as
    ; JSON for the page: it puts the workbook over each box while presenting.
    fn liveSheetsJson:string (i:int) {
        def l:MdLayout (this.layout())
        def out:string "["
        def first:boolean true
        def bi:int 0
        while (bi < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes bi)
            if (b.page == i) {
                def tu@(optional):PresTableUse (this.tableOf(b))
                if (!null? tu) {
                    def u:PresTableUse (unwrap tu)
                    if u.live {
                        if (first == false) {
                            out = (out + ",")
                        }
                        first = false
                        out = (out + "{\"key\":" + (EVGA11yTree.jsonString(u.key)))
                        out = (out + ",\"file\":" + (EVGA11yTree.jsonString(u.file)))
                        out = (out + ",\"sheet\":" + (EVGA11yTree.jsonString(u.sheet)))
                        out = (out + ",\"data\":" + (EVGA11yTree.jsonString(u.path)))
                        out = (out + ",\"box\":[" + (EVGDisplayList.num(b.x)) + "," + (EVGDisplayList.num(b.y)) + "," + (EVGDisplayList.num(b.w)) + "," + (EVGDisplayList.num(b.h)) + "]}")
                    }
                }
            }
            bi = (bi + 1)
        }
        return (out + "]")
    }

    ; Does slide i have a live sheet on it?
    fn hasLiveSheet:boolean (i:int) {
        return ((this.liveSheetsJson(i)) != "[]")
    }

    ; A press on slide i that turned a table's page.
    fn tablePress:boolean (i:int x:double y:double) {
        def k:int 0
        while (k < (array_length tables)) {
            def u:PresTableUse (itemAt tables k)
            if (u.slide == i) {
                def d:int (PresTable.hit(u x y))
                if (d != 0) {
                    def p:int (u.page + d)
                    if ((p >= 0) && (p < (u.pages()))) {
                        u.page = p
                    }
                    return true
                }
            }
            k = (k + 1)
        }
        return false
    }

    ; A chart as the stage shows it when it has finished, for an export.
    fn chartStill:EVGDisplayList (bi:int) {
        def l:MdLayout (this.layout())
        def b:MdBox (itemAt l.boxes bi)
        def dl (new EVGDisplayList())
        def tu@(optional):PresTableUse (this.tableOf(b))
        if (!null? tu) {
            def tb:PresTableUse (unwrap tu)
            PresTable.paint(dl tb b.x b.y b.w b.h tb.stillPage false l.style.textColor (this.themeColour("chart" "accent-color")) l)
            return dl
        }
        def painter (new MdToEvg())
        painter.paintBox(dl l b 0.0)
        PresChart.dress(dl 0 1000000.0 true (this.themeColour("chart" "accent-color")) (this.themeColour("chart" "color")) b.embedSource (this.chartStyleWords()))
        def ground:string l.style.pageBackground
        if ((strlen ground) == 0) {
            ground = "#ffffff"
        }
        PresChart.flatten(dl 0 ground)
        return dl
    }

    ; Every diagram back on its own camera.
    ; Playing or presenting: questions offer a skip.
    def live:boolean false

    ; The seconds left before the waiting questions on slide i are skipped.
    fn setSkipLeft:void (i:int left:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if u.diagram.waiting {
                u.diagram.skipLeft = left
            }
            k = (k + 1)
        }
    }

    ; Let the questions on slide i go: the clock runs on past them.
    fn skipQuestions:void (i:int) {
        if ((i < 0) || (i >= (array_length slides))) {
            return
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if u.diagram.waiting {
                u.diagram.skipped = true
                u.diagram.skipLeft = -1.0
            }
            k = (k + 1)
        }
    }

    fn resetExplore:void () {
        def i:int 0
        while (i < (array_length slides)) {
            def s:PresSlide (itemAt slides i)
            def k:int 0
            while (k < (array_length s.diagrams)) {
                def u:PresDiaUse (itemAt s.diagrams k)
                u.diagram.resetExplore()
                k = (k + 1)
            }
            i = (i + 1)
        }
    }

    ; The first diagram on slide i with slide point (px, py) in its area, or -1.
    fn diagramAt:int (i:int px:double py:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return -1
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if ((((px >= u.bx) && (py >= u.by)) && (px <= (u.bx + u.bw))) && (py <= (u.by + u.bh))) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    fn uiBusy:boolean (i:int) {
        if ((i < 0) || (i >= (array_length slides))) {
            return false
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            u.diagram.uiNow = uiNow
            if (u.diagram.uiBusy()) {
                return true
            }
            k = (k + 1)
        }
        return false
    }

    ; The diagram on slide i that is asking a question at slide time t, or -1.
    fn askingAt:int (i:int t:double) {
        if ((i < 0) || (i >= (array_length slides))) {
            return -1
        }
        def s:PresSlide (itemAt slides i)
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if (u.diagram.asking((t - u.start))) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; The slide time the clock stops at for a question on slide i, or -1.
    fn diagramHold:double (i:int) {
        if ((i < 0) || (i >= (array_length slides))) {
            return -1.0
        }
        def s:PresSlide (itemAt slides i)
        def best:double -1.0
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if (u.diagram.waiting && (! u.diagram.skipped)) {
                def at:double ((u.start + u.diagram.waitAt) + 0.8)
                if ((best < 0.0) || (at < best)) {
                    best = at
                }
            }
            k = (k + 1)
        }
        return best
    }

    fn diagramUse@(optional):PresDiaUse (i:int k:int) {
        if ((i < 0) || (i >= (array_length slides))) {
            def none@(optional):PresDiaUse
            return none
        }
        def s:PresSlide (itemAt slides i)
        if ((k < 0) || (k >= (array_length s.diagrams))) {
            def none2@(optional):PresDiaUse
            return none2
        }
        def u@(optional):PresDiaUse (itemAt s.diagrams k)
        return u
    }

    ; How tall a box may grow on its slide: down to the next box under it,
    ; or to the bottom margin.
    fn roomBelow:double (page:int box:MdBox) {
        def l:MdLayout (this.layout())
        def bottom:double (l.style.pageHeight - l.style.margin)
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.page == page) && (b.y >= ((box.y + box.h) - 0.5))) {
                if (b.y < bottom) {
                    bottom = (b.y - 12.0)
                }
            }
            i = (i + 1)
        }
        if (bottom < (box.y + box.h)) {
            return box.h
        }
        return (bottom - box.y)
    }

    ; Where a diagram paints across: the whole content width when nothing
    ; else on the slide sits beside it (a `{width=…}` that only kept the
    ; picture short enough to stay on its slide), else its own box. [x, w].
    fn diagramSpan:[double] (page:int box:MdBox) {
        def l:MdLayout (this.layout())
        def room:double (this.roomBelow(page box))
        def top:double box.y
        def bottom:double (box.y + room)
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (((b.page == page) && (b != box)) && ((b.y < (bottom - 0.5)) && ((b.y + b.h) > (top + 0.5)))) {
                def bx:double box.x
                def bw:double box.w
                return ([] _:double (bx bw))
            }
            i = (i + 1)
        }
        def x:double l.style.margin
        def w:double (l.style.pageWidth - (l.style.margin * 2.0))
        if (w < box.w) {
            x = box.x
            w = box.w
        }
        return ([] _:double (x w))
    }

    ; The layout box a fence was laid out in, or -1.
    fn embedBox:int (page:int text:string) {
        def l:MdLayout (this.layout())
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (((b.page == page) && (b.kind == 3)) && (b.embedSource == text)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; The chart fences in a block, nested ones too (a chart inside a `:::`).
    fn readCharts:void (s:PresSlide n:MdNode) {
        if ((n.kind == "embed") && ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(n.info)))) == "vega")) {
            def u (new PresChartUse())
            u.source = n.literal
            u.srcStart = n.srcStart
            push s.charts u
            return
        }
        def i:int 0
        while (i < (n.childCount())) {
            this.readCharts(s (n.childAt(i)))
            i = (i + 1)
        }
    }

    ; When a chart's motion starts on its slide (0.0 for one not read).
    fn chartStart:double (s:PresSlide source:string) {
        def i:int 0
        while (i < (array_length s.charts)) {
            def u:PresChartUse (itemAt s.charts i)
            if ((u.source == source) && (u.start >= 0.0)) {
                return u.start
            }
            i = (i + 1)
        }
        return 0.0
    }

    fn readDiagram:void (s:PresSlide n:MdNode page:int) {
        if (n.kind != "embed") {
            return
        }
        def notation:string (MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(n.info))))
        if ((((strlen notation) == 0) || (notation == "vega")) || (notation == "figure")) {
            return
        }
        if ((n.attrValue("diagram")) == "classic") {
            return
        }
        def bi:int (this.embedBox(page n.literal))
        if (bi < 0) {
            return
        }
        def lay:MdLayout (this.layout())
        def box:MdBox (itemAt lay.boxes bi)
        def base:PresDiagram (this.diagramFor(notation n.literal box.w))
        if (! base.ok) {
            return
        }
        ; The layout that draws largest in the room it has, among: the
        ; direction as written, the other direction, and the top-to-bottom
        ; one wrapped into columns (a long chain is a strip either way round).
        ; For a tour the room counts as at most half again as wide as it is
        ; tall, so a squarer shape wins over a strip that fits a wide slide.
        ; `{layout=keep}` keeps what was written.
        if ((n.attrValue("layout")) != "keep") {
            def room:double (this.roomBelow(page box))
            def span0:[double] (this.diagramSpan(page box))
            def aspect:double 1.5
            if (room > 0.0) {
                aspect = ((itemAt span0 1) / room)
            }
            ; Toured, the camera goes in close, and a squarer shape reads
            ; better; shown whole, the room's own shape decides, so the
            ; diagram is as large as the slide allows.
            def most:double 4.0
            if ((n.attrValue("tour")) == "on") {
                most = 1.5
            }
            if (aspect > most) { aspect = most }
            if (aspect < 0.6) { aspect = 0.6 }
            def cands:[PresDiagram]
            def texts:[string]
            push cands base
            push texts n.literal
            def other:string (PresDiagram.flipped(notation n.literal))
            if ((strlen other) > 0) {
                def alt:PresDiagram (this.diagramFor(notation other box.w))
                if alt.ok {
                    push cands alt
                    push texts other
                }
            }
            ; the tall one, cut into columns by the flow engine
            def ci:int 0
            def m:int (array_length cands)
            while (ci < m) {
                def cd:PresDiagram (itemAt cands ci)
                if (cd.worldH > cd.worldW) {
                    def wr:PresDiagram (this.diagramAs(notation (itemAt texts ci) box.w aspect))
                    if wr.ok {
                        push cands wr
                    }
                }
                ci = (ci + 1)
            }
            def bf:double (base.readability(aspect))
            def cj:int 0
            while (cj < (array_length cands)) {
                def c2:PresDiagram (itemAt cands cj)
                if ((c2.readability(aspect)) > (bf * 1.02)) {
                    base = c2
                    bf = (c2.readability(aspect))
                }
                cj = (cj + 1)
            }
        }
        ; the options are the fence's, the scene is shared
        def d (new PresDiagram())
        d.ok = true
        d.worldX = base.worldX
        d.worldY = base.worldY
        d.worldW = base.worldW
        d.worldH = base.worldH
        d.nodes = base.nodes
        d.edges = base.edges
        d.straight = base.straight
        d.rest = base.rest
        ; The tour is the viewer's to start (▶ beside the zoom, T when
        ; presenting); `{tour=on}` starts it with the slide. Without it the
        ; whole diagram is shown, as large as it fits.
        d.tour = ((n.attrValue("tour")) == "on")
        ; A sequence diagram is read top to bottom, message by message; its
        ; "nodes" are lifelines, and a tour from one to the next would zoom
        ; into a thin line. It is shown whole, with no choices to make.
        def seq:boolean base.straight
        d.canTour = (seq == false)
        if seq {
            d.tour = false
        }
        d.ball = ((n.attrValue("ball")) != "off")
        if (n.hasAttr("zoom")) {
            d.zoom = (PresDeck.num((n.attrValue("zoom")) 3.0))
        }
        if ((n.attrValue("style")) == "sketch") {
            d.style = "sketch"
        }
        d.choose = ((n.attrValue("choose")) != "off")
        if seq {
            d.choose = false
        }
        def paper:string lay.style.pageBackground
        if ((strlen paper) == 0) {
            paper = "#ffffff"
        }
        d.setPalette(paper (this.themeColour("diagram" "accent-color")) (this.themeColour("diagram" "color")))
        d.rimFade = (this.flatGround(s))
        def oi:int (this.takeOldUse(n.literal))
        if (oi >= 0) {
            def was:PresDiaUse (itemAt oldUses oi)
            remove_index oldUses oi
            d.takeChoices(was.diagram)
            ; a tour the viewer started goes on through an edit
            if (was.diagram.userTour && d.canTour) {
                d.tour = true
                d.userTour = true
            }
            d.plan()
            d.takeView(was.diagram)
        } {
            d.plan()
        }
        def u (new PresDiaUse())
        u.diagram = d
        u.source = n.literal
        u.srcStart = n.srcStart
        def span:[double] (this.diagramSpan(page box))
        u.bx = (itemAt span 0)
        u.by = box.y
        u.bw = (itemAt span 1)
        u.bh = (this.roomBelow(page box))
        push s.diagrams u
    }

    ; The theme, for the deck and for the Markdown editor it lays out with,
    ; and no layout of its own: the next rebuild is the one layout.
    ; `MarkdownWeb.setStyleSheet` (and `addTheme`) lays the document out at
    ; once, as a continuous page the width of ITS view rather than as slides,
    ; and that pass drew every chart again at that width; the cache keeps a
    ; chart at one width, so the slides' pass that followed drew them all
    ; once more. A theme edit cost two layouts and every chart twice.
    fn setStyleSheet:void (css:string) {
        this.setTheme(css)
        md.edit.setStyleSheet(css)
    }

    ; A named template (`theme: aurora` in the front matter), without a layout.
    fn addTemplate:void (name:string css:string) {
        md.edit.addTheme(name css)
    }

    ; Charts and figures the last rebuild left drawn under old defaults.
    fn redrawPending:int () {
        return md.edit.layout.embeds.pending
    }

    fn setTheme:void (css:string) {
        clear themeKeys
        clear themeVals
        clear ruleKeys
        clear ruleVals
        this.readRules(css)
        this.readPresComment(css)
        ; `deck { fx: starfield; fx-hue: 280 }`: the theme's effect as CSS,
        ; over the older comment
        def r:int 0
        while (r < (array_length ruleKeys)) {
            def rk:string (itemAt ruleKeys r)
            if (((indexOf rk "deck/fx") == 0) || ((rk == "deck/warm") || (rk == "deck/accent"))) {
                def rv:string (itemAt ruleVals r)
                ; `fx: none`: no effect, whatever the comment says
                if ((rk == "deck/fx") && (rv == "none")) {
                    rv = ""
                }
                this.putTheme((substring rk 5 (strlen rk)) rv)
            }
            r = (r + 1)
        }
    }

    fn putTheme:void (key:string value:string) {
        def i:int 0
        while (i < (array_length themeKeys)) {
            if ((itemAt themeKeys i) == key) {
                set themeVals i value
                return
            }
            i = (i + 1)
        }
        push themeKeys key
        push themeVals value
    }

    ; The older `/* pres: fx=starfield fx-hue=280 */` comment, which themes
    ; saved before the `deck` rule still carry.
    fn readPresComment:void (css:string) {
        def at:int (indexOf css "/* pres:")
        if (at < 0) {
            return
        }
        def rest:string (substring css (at + 8) (strlen css))
        def end:int (indexOf rest "*/")
        if (end < 0) {
            return
        }
        def body:string (substring rest 0 end)
        ; key=value pairs separated by spaces or newlines
        def n:int (strlen body)
        def i:int 0
        while (i < n) {
            while ((i < n) && (((charAt body i) == 32) || (((charAt body i) == 10) || ((charAt body i) == 13)))) {
                i = (i + 1)
            }
            def st:int i
            while ((i < n) && (((charAt body i) != 32) && (((charAt body i) != 10) && ((charAt body i) != 13)))) {
                i = (i + 1)
            }
            if (i > st) {
                def pair:string (substring body st i)
                def eq:int (indexOf pair "=")
                if (eq > 0) {
                    push themeKeys (substring pair 0 eq)
                    push themeVals (substring pair (eq + 1) (strlen pair))
                }
            }
        }
    }

    ; `chart { color; accent-color }` and `diagram { … }` in the theme: the
    ; stage's own selectors, which the markdown module does not know and
    ; leaves alone. Kept as "selector/property" = value.
    def ruleKeys:[string]
    def ruleVals:[string]

    fn readRules:void (css0:string) {
        ; comments out first: a `{` in one is not a rule
        def css:string ""
        def n0:int (strlen css0)
        def p:int 0
        while (p < n0) {
            def rest:string (substring css0 p n0)
            def c0:int (indexOf rest "/*")
            if (c0 < 0) {
                css = (css + rest)
                p = n0
            } {
                css = (css + (substring rest 0 c0))
                def after:string (substring rest (c0 + 2) (strlen rest))
                def c1:int (indexOf after "*/")
                if (c1 < 0) {
                    p = n0
                } {
                    p = ((p + c0) + (c1 + 4))
                }
            }
        }
        def n:int (strlen css)
        def at:int 0
        while (at < n) {
            def tail:string (substring css at n)
            def open:int (indexOf tail "{")
            if (open < 0) {
                return
            }
            def tail2:string (substring tail (open + 1) (strlen tail))
            def close:int (indexOf tail2 "}")
            if (close < 0) {
                return
            }
            def sels:string (trim (substring tail 0 open))
            def body:string (substring tail2 0 close)
            def selList:[string] (strsplit sels ",")
            def s:int 0
            while (s < (array_length selList)) {
                def sel0:string (trim (itemAt selList s))
                ; `#anchor chart`: the charts under one heading
                def sel:string (PresDeck.scopedSel(sel0))
                if (((((sel == "chart") || (sel == "diagram")) || ((indexOf sel "#") == 0)) || (sel == "page")) || ((sel == "figure") || ((sel == "document") || (sel == "deck")))) {
                    def decls:[string] (strsplit body ";")
                    def d:int 0
                    while (d < (array_length decls)) {
                        def decl:string (itemAt decls d)
                        def colon:int (indexOf decl ":")
                        if (colon > 0) {
                            push ruleKeys (sel + "/" + (trim (substring decl 0 colon)))
                            push ruleVals (trim (substring decl (colon + 1) (strlen decl)))
                        }
                        d = (d + 1)
                    }
                }
                s = (s + 1)
            }
            at = (((at + open) + 1) + (close + 1))
        }
    }

    ; The theme's chart-style and chart-effects, and "dark" on a dark slide
    ; (black marks are then drawn light, not left invisible).
    fn chartStyleWords:string () {
        def w:string ((this.themeRule("chart" "chart-style")) + " " + (this.themeRule("chart" "chart-effects")))
        def st:MdStyle (this.layout()).style
        def paper:string st.pageBackground
        def isDark:boolean false
        if ((strlen paper) > 0) {
            def c:EVGColor (EVGColor.parse(paper))
            def lum:double ((((to_double (c.red())) * 0.299) + ((to_double (c.green())) * 0.587)) + ((to_double (c.blue())) * 0.114))
            if (lum < 110.0) {
                w = (w + " dark")
                isDark = true
            }
        }
        ; the labels' colour: the chart rule's `label-color`, else (`contrast:
        ; auto`) the page's own text colour on a light slide
        def lc:string (trim (this.themeRule("chart" "label-color")))
        def contrast:string (trim (this.themeRule("chart" "contrast")))
        if (((strlen lc) == 0) && ((isDark == false) && (contrast != "off"))) {
            lc = st.textColor
        }
        if (((strlen lc) > 0) && ((indexOf lc " ") < 0)) {
            w = (w + " label=" + lc)
        }
        return w
    }

    ; "#mihin-raha-menee chart" as "#mihin-raha-menee", "#a list" as it is,
    ; other selectors as they are; "" for any other "#…".
    sfn scopedSel:string (sel:string) {
        if ((indexOf sel "#") != 0) {
            return sel
        }
        def parts:[string] (strsplit sel " ")
        def words:[string]
        def i:int 0
        while (i < (array_length parts)) {
            def w:string (trim (itemAt parts i))
            if ((strlen w) > 0) {
                push words w
            }
            i = (i + 1)
        }
        if (((array_length words) == 2) && ((itemAt words 1) == "chart")) {
            return (itemAt words 0)
        }
        ; "#anchor list": the lists under that heading (`list-style`)
        if (((array_length words) == 2) && ((itemAt words 1) == "list")) {
            return ((itemAt words 0) + " list")
        }
        return ""
    }

    ; A length's number: "18px", "18pt" and "18" are 18; "" when there is
    ; none. "18pxpx" or "18 apples" is not a length, and is read as nothing,
    ; the way the cascade reads it — it used to be read as 18, so a chart
    ; drew what the slides ignored.
    sfn lengthOf:string (v:string) {
        def t:string (trim v)
        def i:int 0
        def n:int (strlen t)
        while ((i < n) && ((((charAt t i) >= 48) && ((charAt t i) <= 57)) || ((charAt t i) == 46))) {
            i = (i + 1)
        }
        def u:string (MdChar.lower((trim (substring t i n))))
        if ((u != "") && ((u != "px") && (u != "pt"))) {
            return ""
        }
        return (substring t 0 i)
    }

    ; A length the theme states for `what`, as lengthOf reads it, held to
    ; its safety range against the slide (`MdCssLimits`): `chart {
    ; font-size: 2020px }` draws the chart's labels no taller than the
    ; slide. The sheet itself keeps what it says.
    fn themeLength:string (what:string sel:string prop:string) {
        def fs:string (PresDeck.lengthOf((this.themeRule(what prop))))
        if ((strlen fs) == 0) { return "" }
        def d@(optional):double (str2double fs)
        if (null? d) { return "" }
        def v:double (unwrap d)
        def c:double (MdCssLimits.clamp(prop sel v pageW pageH))
        if (c == v) { return fs }
        return (VlJson.formatNumber(c 1))
    }

    ; The chart defaults a rule states, as the JSON the markdown module lays
    ; the charts over (MdVegaRender.withDefaults): `font-size` the axis and
    ; legend labels (their titles one larger), `title-font-size` and
    ; `title-gap` the chart's title, `padding` the room round it. `key` is
    ; "chart" for every chart or "#anchor" for the charts under one heading;
    ; `roomy` adds the presentation's own defaults under the stated ones.
    fn chartDefaults:string (key:string roomy:boolean) {
        def fs:string (this.themeLength(key "chart" "font-size"))
        def tfs:string (this.themeLength(key "chart" "title-font-size"))
        def tg:string (this.themeLength(key "chart" "title-gap"))
        def pad:string (this.themeLength(key "chart" "padding"))
        if roomy {
            if ((strlen fs) == 0) { fs = "15" }
            if ((strlen tfs) == 0) { tfs = "22" }
            if ((strlen tg) == 0) { tg = "18" }
            if ((strlen pad) == 0) { pad = "14" }
        }
        def cfg:string ""
        if ((strlen tfs) > 0) {
            cfg = (cfg + "\"fontSize\": " + tfs)
        }
        if ((strlen tg) > 0) {
            if ((strlen cfg) > 0) { cfg = (cfg + ", ") }
            cfg = (cfg + "\"offset\": " + tg)
        }
        def parts:string ""
        if ((strlen cfg) > 0) {
            parts = ("\"title\": {" + cfg + "}")
        }
        if ((strlen fs) > 0) {
            def f:double (?? (str2double fs) 12.0)
            def ft:string (VlJson.formatNumber((f + 1.0) 1))
            def guide:string ("{\"labelFontSize\": " + fs + ", \"titleFontSize\": " + ft + "}")
            if ((strlen parts) > 0) { parts = (parts + ", ") }
            parts = (parts + "\"axis\": " + guide + ", \"legend\": " + guide)
        }
        def out:string ""
        if ((strlen parts) > 0) {
            out = ("\"config\": {" + parts + "}")
        }
        if ((strlen pad) > 0) {
            if ((strlen out) > 0) { out = (out + ", ") }
            out = (out + "\"padding\": " + pad)
        }
        ; where a chart narrower than the slide sits, as a flex row would put
        ; it: `chart { justify-content: center | flex-start | flex-end }`
        ; (centred unless told otherwise)
        def jc:string (trim (this.themeRule(key "justify-content")))
        if ((strlen jc) == 0) {
            jc = (trim (this.themeRule(key "text-align")))
        }
        if (((strlen jc) == 0) && roomy) {
            jc = "center"
        }
        if ((strlen jc) > 0) {
            def al:string "start"
            if ((jc == "center") || (jc == "space-around")) { al = "center" }
            if (((jc == "flex-end") || (jc == "end")) || (jc == "right")) { al = "end" }
            if ((strlen out) > 0) { out = (out + ", ") }
            out = (out + "\"usermeta\": {\"presAlign\": \"" + al + "\"}")
        }
        if ((strlen out) == 0) {
            return ""
        }
        return ("{" + out + "}")
    }

    ; The anchors the theme has chart rules for ("#a", "#b").
    fn chartScopes:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length ruleKeys)) {
            def k:string (itemAt ruleKeys i)
            ; `#anchor list` rules are the lists', not the charts'
            if (((indexOf k "#") == 0) && ((indexOf k " list/") < 0)) {
                def slash:int (indexOf k "/")
                def sc:string (substring k 0 slash)
                def seen:boolean false
                def j:int 0
                while (j < (array_length out)) {
                    if ((itemAt out j) == sc) {
                        seen = true
                    }
                    j = (j + 1)
                }
                if (seen == false) {
                    push out sc
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; A colour for `what` ("chart" or "diagram"): `color` is the warm one
    ; (columns, the active line), `accent-color` the cool one (grid, axes,
    ; boxes). The rule wins over the old `/* pres: warm= accent= */` line.
    ; A property of the theme's `chart` / `diagram` rule, or "".
    ; A `background-image` value that draws nothing.
    ; The slide's ground is the flat paper colour: no effect, no picture of
    ; its own and none from the theme. Only then can a diagram fade its rim
    ; into that colour and draw its grid; over anything else both show as a
    ; dark box around the diagram.
    fn flatGround:boolean (s:PresSlide) {
        if ((strlen s.fx) > 0) {
            return false
        }
        if ((strlen s.bg) > 0) {
            return false
        }
        return (PresDeck.noPicture((this.themeRule("page" "background-image"))))
    }

    sfn noPicture:boolean (v:string) {
        def t:string (trim v)
        return (((strlen t) == 0) || (t == "none"))
    }

    fn themeRule:string (what:string prop:string) {
        def key:string (what + "/" + prop)
        def i:int ((array_length ruleKeys) - 1)
        while (i >= 0) {
            if ((itemAt ruleKeys i) == key) {
                return (itemAt ruleVals i)
            }
            i = (i - 1)
        }
        return ""
    }

    fn themeColour:string (what:string prop:string) {
        def key:string (what + "/" + prop)
        def i:int ((array_length ruleKeys) - 1)
        while (i >= 0) {
            if ((itemAt ruleKeys i) == key) {
                return (itemAt ruleVals i)
            }
            i = (i - 1)
        }
        if (prop == "color") {
            return (this.themeValue("warm"))
        }
        return (this.themeValue("accent"))
    }

    fn themeValue:string (key:string) {
        def i:int 0
        while (i < (array_length themeKeys)) {
            if ((itemAt themeKeys i) == key) {
                return (itemAt themeVals i)
            }
            i = (i + 1)
        }
        return ""
    }

    ; Files the charts read (`"data": {"url": …}`), fetched by the page.
    def dataUrls:[string]
    def dataTexts:[string]
    ; the ```table fences (PresTable), and the page each was left on, by
    ; "<path>#<ordinal>"
    def tables:[PresTableUse]
    def tablePages:[string:int]

    ; Another document: none of the files the last one's charts read.
    fn clearChartData:void () {
        def u:[string]
        def t:[string]
        dataUrls = u
        dataTexts = t
    }

    fn setChartData:void (url:string body:string) {
        def i:int 0
        while (i < (array_length dataUrls)) {
            if ((itemAt dataUrls i) == url) {
                set_at dataTexts i body
                this.rebuild()
                return
            }
            i = (i + 1)
        }
        push dataUrls url
        push dataTexts body
        this.rebuild()
    }

    ; The files the document's charts read that the page has not handed over,
    ; one per line.
    fn chartDataWanted:string () {
        def out:string ""
        def doc:MdNode md.edit.doc
        def urls:[string]
        this.wantedIn(doc urls)
        def ti:int 0
        while (ti < (array_length tables)) {
            def tu:PresTableUse (itemAt tables ti)
            push urls (MdVegaRender.resolveUrl(tu.path))
            ti = (ti + 1)
        }
        def i:int 0
        while (i < (array_length urls)) {
            def u:string (itemAt urls i)
            def have:boolean false
            ; a table's own key is no file
            def tk:int 0
            while (tk < (array_length tables)) {
                def tu:PresTableUse (itemAt tables tk)
                if (tu.key == u) {
                    have = true
                }
                tk = (tk + 1)
            }
            def k:int 0
            while (k < (array_length dataUrls)) {
                if ((MdVegaRender.bareUrl((itemAt dataUrls k))) == (MdVegaRender.bareUrl(u))) {
                    have = true
                }
                k = (k + 1)
            }
            if (have == false) {
                out = (out + u + (strfromcode 10))
            }
            i = (i + 1)
        }
        return out
    }

    fn wantedIn:void (n:MdNode urls:[string]) {
        if (n.kind == "embed") {
            if ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(n.info)))) == "vega") {
                ; a chart kept in a file reads the files that file names
                def spec:string (MdVegaRender.fromFile(n.literal dataUrls dataTexts))
                if (spec != n.literal) {
                    def inner:[string] (MdVegaRender.urlsOf(spec))
                    def q:int 0
                    while (q < (array_length inner)) {
                        push urls (itemAt inner q)
                        q = (q + 1)
                    }
                }
                def us:[string] (MdVegaRender.urlsOf(n.literal))
                def j:int 0
                while (j < (array_length us)) {
                    push urls (itemAt us j)
                    j = (j + 1)
                }
            }
        }
        def c:int 0
        while (c < (n.childCount())) {
            this.wantedIn((n.childAt(c)) urls)
            c = (c + 1)
        }
    }

    fn setText:void (t:string) {
        text = t
        this.rebuild()
    }

    fn rebuild:void () {
        src.read(text)
        ; the tables, masked into charts of their own (PresTable)
        def k0:int 0
        while (k0 < (array_length tables)) {
            def was:PresTableUse (itemAt tables k0)
            set tablePages ((was.path + "#") + (to_string was.ordinal)) was.page
            k0 = (k0 + 1)
        }
        def fresh:[PresTableUse]
        tables = fresh
        def masked:string (PresTable.mask(src.masked tables))
        def urls:[string]
        def texts:[string]
        def di:int 0
        while (di < (array_length dataUrls)) {
            push urls (itemAt dataUrls di)
            push texts (itemAt dataTexts di)
            di = (di + 1)
        }
        def tk:int 0
        while (tk < (array_length tables)) {
            def u:PresTableUse (itemAt tables tk)
            def pk:string ((u.path + "#") + (to_string u.ordinal))
            if (has tablePages pk) {
                u.page = (unwrap (get tablePages pk))
            }
            PresTable.load(u dataUrls dataTexts)
            push urls u.key
            push texts (PresTable.spec(u))
            tk = (tk + 1)
        }
        def e:MarkdownEdit md.edit
        e.open(masked)
        e.slideMode = true
        e.sheetGap = (MdToEvg.sheetGap())
        ; a slide with room is set larger (the front matter's `slide-grow`
        ; overrides; `slide-grow: off` keeps the document's sizes)
        e.layout.slideGrow = 1.6
        ; the charts over the theme's defaults: every chart's, then each
        ; heading's own (`#anchor chart { … }`)
        def emb:MdEmbedCache e.layout.embeds
        emb.chartConfig = (this.chartDefaults("chart" true))
        ; the figures in the theme's colours, and only for PRO
        figStyle = (this.figureStyle())
        emb.figure = figStyle
        ; a slide's chart fills its room (a small plot asked for larger)
        emb.chartGrow = 2.5
        ; but no taller than a slide under its heading
        emb.chartMaxH = ((e.layout.style.pageHeight - (e.layout.style.margin * 2.0)) - 120.0)
        def none1:[string]
        def none2:[string]
        emb.chartScopes = none1
        emb.chartScopeConfig = none2
        emb.redrawBudget = redrawBudget
        emb.focusFrom = focusFrom
        emb.focusTo = focusTo
        def scopes:[string] (this.chartScopes())
        def si:int 0
        while (si < (array_length scopes)) {
            def sc:string (itemAt scopes si)
            push emb.chartScopes (substring sc 1 (strlen sc))
            push emb.chartScopeConfig (this.chartDefaults(sc false))
            si = (si + 1)
        }
        ; `#anchor list { list-style: swot }`: the lists under one heading
        ; drawn as a figure (a list's own `{list-style=…}` wins)
        def none3:[string]
        def none4:[string]
        emb.listScopes = none3
        emb.listScopeStyles = none4
        def lk:int 0
        while (lk < (array_length ruleKeys)) {
            def lkey:string (itemAt ruleKeys lk)
            def lat:int (indexOf lkey " list/list-style")
            if (((indexOf lkey "#") == 0) && (lat > 0)) {
                push emb.listScopes (substring lkey 1 lat)
                push emb.listScopeStyles (trim (itemAt ruleVals lk))
            }
            lk = (lk + 1)
        }
        ; the files the charts read, as far as the page has fetched them
        emb.dataUrls = urls
        emb.dataTexts = texts
        ; `orientation: portrait` in the front matter: the theme's page
        ; turned on its side. The theme's size is only known from a layout,
        ; so it is kept from the last one made with it; a theme not seen yet
        ; (or changed) costs one layout more.
        orientation = (PresDeck.frontValue(text "orientation"))
        def portrait:boolean (orientation == "portrait")
        def sheetNow:string (e.sheet.text())
        e.pageSize = ""
        if (portrait && (sheetNow == themeSizeOf)) {
            e.pageSize = themeSizeTurned
        }
        e.stale = true
        e.ensureLayout()
        if ((strlen e.pageSize) == 0) {
            def lw:double e.layout.style.pageWidth
            def lh:double e.layout.style.pageHeight
            themeSizeOf = (e.sheet.text())
            themeSizeTurned = (((to_string lh) + "x") + (to_string lw)) + "pt"
            if (portrait && (lw > lh)) {
                e.pageSize = themeSizeTurned
                e.stale = true
                e.ensureLayout()
            }
        }
        this.codeColours(e.layout)
        pageW = e.layout.style.pageWidth
        pageH = e.layout.style.pageHeight
        this.readSlides()
        revision = (revision + 1)
    }

    ; Listings in the slide's own light. The markdown module's token colours
    ; are for a white page and the stylesheet has no word for them, so on a
    ; dark slide the laid-out listing boxes get the dark set instead.
    fn codeColours:void (l:MdLayout) {
        def st:MdStyle l.style
        def bg:string st.codeBackground
        if ((strlen bg) == 0) {
            bg = st.pageBackground
        }
        if ((strlen bg) == 0) {
            return
        }
        def c:EVGColor (EVGColor.parse(bg))
        def lum:double ((((to_double (c.red())) * 0.299) + ((to_double (c.green())) * 0.587)) + ((to_double (c.blue())) * 0.114))
        if (lum >= 110.0) {
            return
        }
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.family == st.monoFamily)) {
                def col:string (PresDeck.lower(b.color))
                if (col == (PresDeck.lower(st.codePlain))) { b.color = "#e6edf3" }
                if (col == (PresDeck.lower(st.codeKeyword))) { b.color = "#ff7b72" }
                if (col == (PresDeck.lower(st.codeString))) { b.color = "#a5d6ff" }
                if (col == (PresDeck.lower(st.codeComment))) { b.color = "#8b949e" }
                if (col == (PresDeck.lower(st.codeNumber))) { b.color = "#79c0ff" }
            }
            i = (i + 1)
        }
    }

    sfn lower:string (v:string) {
        return (MdChar.lower(v))
    }

    ; A chart's own ground (the diagram library's page colour) would be a
    ; white card on a dark slide: it is left out, and the chart sits on the
    ; slide's own ground.
    sfn clearGround:void (out:EVGDisplayList from:int) {
        def i:int from
        while (i < (array_length out.cmds)) {
            def cmd:EVGDrawCmd (itemAt out.cmds i)
            if (cmd.kind == 0) {
                cmd.a = 0.0
                return
            }
            i = (i + 1)
        }
    }

    fn layout:MdLayout () {
        return md.edit.layout
    }

    fn slideCount:int () {
        return (array_length slides)
    }

    fn slideAt:PresSlide (i:int) {
        return (itemAt slides i)
    }

    ; ------------------------------------------------------------------
    ; Which slide a source offset is on
    ; ------------------------------------------------------------------
    fn pageOfOffset:int (off:int) {
        def l:MdLayout (this.layout())
        def best:int 0
        def bestSrc:int -1
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            def s:int (PresDeck.boxSrc(b))
            if ((s <= off) && (s > bestSrc)) {
                bestSrc = s
                best = b.page
            }
            i = (i + 1)
        }
        return best
    }

    ; Where a box came from: its own run when it has one, its block otherwise.
    sfn boxSrc:int (b:MdBox) {
        if (b.segSrc >= 0) {
            return b.segSrc
        }
        return b.srcStart
    }

    ; The page a block's first box landed on, or -1 when it drew nothing.
    fn pageOfNode:int (n:MdNode) {
        def l:MdLayout (this.layout())
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            def s:int (PresDeck.boxSrc(b))
            if ((s >= n.srcStart) && (s < n.srcEnd)) {
                return b.page
            }
            i = (i + 1)
        }
        return -1
    }

    ; ------------------------------------------------------------------
    ; The slides and what the document says about them
    ; ------------------------------------------------------------------
    ; The diagrams of the deck before this rebuild: an edit anywhere else
    ; leaves a diagram's text as it was, and then the viewer's choices, view
    ; and menu carry over instead of starting the walk again.
    def oldUses:[PresDiaUse]

    fn keepOldUses:void () {
        clear oldUses
        def i:int 0
        while (i < (array_length slides)) {
            def s:PresSlide (itemAt slides i)
            def k:int 0
            while (k < (array_length s.diagrams)) {
                push oldUses (itemAt s.diagrams k)
                k = (k + 1)
            }
            i = (i + 1)
        }
    }

    ; The old use of a fence with this text, taken so it is used once; -1.
    fn takeOldUse:int (source:string) {
        def i:int 0
        while (i < (array_length oldUses)) {
            def u:PresDiaUse (itemAt oldUses i)
            if (u.source == source) {
                return i
            }
            i = (i + 1)
        }
        ; an edit inside a fence: the next one in order (the diagram keeps
        ; the view only when it still has the same boxes and lines)
        if ((array_length oldUses) > 0) {
            return 0
        }
        return -1
    }

    fn readSlides:void () {
        this.keepOldUses()
        clear slides
        def l:MdLayout (this.layout())
        def doc:MdNode md.edit.doc
        def meta:MdMeta (MdFrontMatter.of(doc))
        def dTransition:string (meta.get("transition" "fade"))
        def dSeconds:double (PresDeck.num((meta.get("seconds" "0.6")) 0.6))
        def dFx:string (meta.get("fx" ""))
        def dArt:string (meta.get("art" ""))
        def dArtSeed:int (to_int (PresDeck.num((meta.get("art-seed" "-1")) -1.0)))
        def dStep:double (PresDeck.num((meta.get("step" "1.2")) 1.2))
        def dHold:double (PresDeck.num((meta.get("hold" "2.5")) 2.5))
        def p:int 0
        while (p < l.pageCount) {
            def s (new PresSlide())
            s.index = p
            s.transition = dTransition
            s.seconds = dSeconds
            s.fx = dFx
            s.art = dArt
            s.artSeed = dArtSeed
            s.stepGap = dStep
            s.hold = dHold
            ; the template's effect, with its own parameters; not over a picture
            ; the theme's page rule puts behind every slide, which it would hide
            if (((strlen dFx) == 0) && (PresDeck.noPicture((this.themeRule("page" "background-image"))))) {
                s.fx = (this.themeValue("fx"))
                def ti:int 0
                while (ti < (array_length themeKeys)) {
                    def tkey:string (itemAt themeKeys ti)
                    if (((strlen tkey) > 3) && ((substring tkey 0 3) == "fx-")) {
                        PresDeck.setFx(s (substring tkey 3 (strlen tkey)) (itemAt themeVals ti))
                    }
                    ti = (ti + 1)
                }
            }
            PresDeck.fxFromMeta(s meta)
            push slides s
            p = (p + 1)
        }
        ; The source span of each slide, from its boxes.
        def bi:int 0
        while (bi < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes bi)
            if ((b.page >= 0) && (b.page < (array_length slides))) {
                def sl:PresSlide (itemAt slides b.page)
                def at:int (PresDeck.boxSrc(b))
                if (at >= 0) {
                    if ((sl.srcStart < 0) || (at < sl.srcStart)) {
                        sl.srcStart = at
                    }
                    if (at > sl.srcEnd) {
                        sl.srcEnd = at
                    }
                }
            }
            bi = (bi + 1)
        }
        ; The blocks: a heading names its slide, a build or an anim makes groups.
        def c:int 0
        while (c < (doc.childCount())) {
            def ch:MdNode (doc.childAt(c))
            def pg:int (this.pageOfNode(ch))
            if (pg >= 0) {
                def slide:PresSlide (itemAt slides pg)
                if ((ch.kind == "heading") && ((strlen slide.title) == 0)) {
                    slide.title = (ch.plainText())
                    this.readHeading(slide ch)
                }
                this.readGroups(slide ch)
                this.readDiagram(slide ch pg)
                this.readCharts(slide ch)
            }
            c = (c + 1)
        }
        ; The notes and the audio go to the slide the block sits under.
        def k:int 0
        while (k < (array_length src.blocks)) {
            def blk:PresBlock (itemAt src.blocks k)
            def pg2:int (this.pageOfOffset(blk.start))
            if ((pg2 >= 0) && (pg2 < (array_length slides))) {
                def s2:PresSlide (itemAt slides pg2)
                if (blk.kind == "notes") {
                    if ((strlen s2.notes) > 0) {
                        s2.notes = (s2.notes + "\n")
                    }
                    s2.notes = (s2.notes + blk.body)
                }
                if (blk.kind == "audio") {
                    s2.audio = (PresSource.argValue(blk.args "src"))
                }
            }
            k = (k + 1)
        }
    }

    sfn fxFromMeta:void (s:PresSlide meta:MdMeta) {
        def i:int 0
        while (i < (array_length meta.keys)) {
            def key:string (itemAt meta.keys i)
            if (((strlen key) > 3) && ((substring key 0 3) == "fx-")) {
                PresDeck.setFx(s (substring key 3 (strlen key)) (itemAt meta.values i))
            }
            i = (i + 1)
        }
    }

    sfn setFx:void (s:PresSlide name:string value:string) {
        def i:int 0
        while (i < (array_length s.fxNames)) {
            if ((itemAt s.fxNames i) == name) {
                set s.fxValues i value
                return
            }
            i = (i + 1)
        }
        push s.fxNames name
        push s.fxValues value
    }

    fn readHeading:void (s:PresSlide h:MdNode) {
        s.id = h.nodeId
        if (h.hasAttr("transition")) {
            s.transition = (h.attrValue("transition"))
        }
        if (h.hasAttr("seconds")) {
            s.seconds = (PresDeck.num((h.attrValue("seconds")) s.seconds))
        }
        if (h.hasAttr("duration")) {
            s.wantDuration = (PresDeck.num((h.attrValue("duration")) -1.0))
        }
        if (h.hasAttr("step")) {
            s.stepGap = (PresDeck.num((h.attrValue("step")) s.stepGap))
        }
        if (h.hasAttr("fx")) {
            s.fx = (h.attrValue("fx"))
        }
        if (h.hasAttr("bg")) {
            s.bg = (h.attrValue("bg"))
            ; the slide's own picture is what it shows: the deck's or the
            ; theme's effect would cover it, one named on the heading stays
            if ((h.hasAttr("fx")) == false) {
                s.fx = ""
            }
        }
        if (h.hasAttr("bg-dim")) {
            s.bgDim = (PresDeck.num((h.attrValue("bg-dim")) 0.0))
        }
        if (h.hasAttr("art")) {
            s.art = (h.attrValue("art"))
            if (s.art == "off") {
                s.art = ""
            }
        }
        if (h.hasAttr("art-seed")) {
            s.artSeed = (to_int (PresDeck.num((h.attrValue("art-seed")) -1.0)))
        }
        def i:int 0
        while (i < (h.attrCount())) {
            def key:string (itemAt h.attrKeys i)
            if (((strlen key) > 3) && ((substring key 0 3) == "fx-")) {
                PresDeck.setFx(s (substring key 3 (strlen key)) (itemAt h.attrVals i))
            }
            i = (i + 1)
        }
    }

    fn readGroups:void (s:PresSlide n:MdNode) {
        def build:boolean (n.hasClass("build"))
        def anim:string ""
        if (n.hasAttr("anim")) {
            anim = (n.attrValue("anim"))
        }
        if ((! build) && ((strlen anim) == 0)) {
            return
        }
        if ((strlen anim) == 0) {
            anim = "rise"
        }
        def secs:double 0.5
        if (n.hasAttr("seconds")) {
            secs = (PresDeck.num((n.attrValue("seconds")) 0.5))
        }
        if (build && (n.kind == "list")) {
            def i:int 0
            while (i < (n.childCount())) {
                def it:MdNode (n.childAt(i))
                s.steps = (s.steps + 1)
                this.addGroup(s s.steps it.srcStart it.srcEnd anim secs (it.plainText()))
                i = (i + 1)
            }
            return
        }
        def step:int 0
        if build {
            s.steps = (s.steps + 1)
            step = s.steps
        }
        this.addGroup(s step n.srcStart n.srcEnd anim secs (n.plainText()))
    }

    fn addGroup:void (s:PresSlide step:int a:int b:int anim:string secs:double words:string) {
        def g (new PresGroup())
        g.slide = s.index
        g.step = step
        g.start = a
        g.end = b
        g.anim = anim
        g.seconds = secs
        def w:string (trim words)
        if ((strlen w) > 24) {
            w = ((substring w 0 23) + "…")
        }
        g.label = w
        push s.groups g
    }

    ; Which group a box belongs to on its slide, or -1.
    fn groupOf:int (s:PresSlide b:MdBox) {
        def at:int (PresDeck.boxSrc(b))
        def i:int 0
        while (i < (array_length s.groups)) {
            def g:PresGroup (itemAt s.groups i)
            if ((at >= g.start) && (at < g.end)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; A key of the front matter (the `---` block the text opens with), its
    ; value trimmed and in lower case; "" when it is not there.
    sfn frontValue:string (t:string key:string) {
        def lines:[string] (strsplit t (strfromcode 10))
        if ((array_length lines) == 0) {
            return ""
        }
        if ((trim (itemAt lines 0)) != "---") {
            return ""
        }
        def want:string (key + ":")
        def i:int 1
        while (i < (array_length lines)) {
            def ln:string (trim (itemAt lines i))
            if ((ln == "---") || (ln == "...")) {
                return ""
            }
            if ((indexOf ln want) == 0) {
                return (MdChar.lower((trim (substring ln (strlen want) (strlen ln)))))
            }
            i = (i + 1)
        }
        return ""
    }

    sfn num:double (v:string fallback:double) {
        def t:string (trim v)
        if ((strlen t) == 0) {
            return fallback
        }
        def d@(optional):double (str2double t)
        if (null? d) {
            return fallback
        }
        return (unwrap d)
    }

    ; ------------------------------------------------------------------
    ; One slide as draw commands
    ; ------------------------------------------------------------------
    ;
    ; `groupOfCmd` gets one entry per command: the group it animates with,
    ; or -1 for what stands still. The list is in slide coordinates: (0, 0)
    ; is the slide's top-left corner.
    fn slideList:EVGDisplayList (i:int groupOfCmd:[int] t:double) {
        def l:MdLayout (this.layout())
        def s:PresSlide (itemAt slides i)
        def out:EVGDisplayList (new EVGDisplayList())
        def painter (new MdToEvg())
        def paper:string "#ffffff"
        if ((strlen l.style.pageBackground) > 0) {
            paper = l.style.pageBackground
        }
        painter.rect(out 0.0 0.0 pageW pageH paper)
        painter.paper(out l 0.0 0.0 pageW pageH)
        this.slideBackground(out l s paper)
        push groupOfCmd -1
        while ((array_length groupOfCmd) < (array_length out.cmds)) {
            push groupOfCmd -1
        }
        def useStill:boolean (still && (this.hasFxStill(i)))
        if useStill {
            def pic:EVGDrawCmd (new EVGDrawCmd())
            pic.kind = 2
            pic.x = 0.0
            pic.y = 0.0
            pic.w = pageW
            pic.h = pageH
            pic.src = (PresDeck.fxStillPath(i))
            pic.a = 1.0
            push out.cmds pic
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd -1
            }
        }
        if ((((strlen s.fx) > 0) && ((PresDeck.fxOnTop(s.fx)) == false)) && (useStill == false)) {
            this.addFx(out s paper)
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd -1
            }
        }
        ; the line art over the effect's ground, under the text
        this.slideArt(out s i)
        while ((array_length groupOfCmd) < (array_length out.cmds)) {
            push groupOfCmd -1
        }
        ; Which group each of this slide's boxes is in. A list marker carries
        ; its LIST's offset, not its item's, so it takes the group of a box
        ; on its own line — before or after it, depending on the list kind.
        def mine:[MdBox]
        def groupOfBox:[int]
        def bi:int 0
        while (bi < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes bi)
            if (b.page == i) {
                push mine b
                if (b.furniture > 0) {
                    ; the header and the footer arrive with the slide
                    push groupOfBox -1
                } {
                if ((b.kind == 0) && (b.segSrc < 0)) {
                    ; a marker: decided by its line, below
                    push groupOfBox -1
                } {
                    push groupOfBox (this.groupOf(s b))
                }
                }
            }
            bi = (bi + 1)
        }
        def m:int 0
        while (m < (array_length mine)) {
            def mb:MdBox (itemAt mine m)
            if (((itemAt groupOfBox m) < 0) && (((mb.kind == 0) && (mb.segSrc < 0)) && (mb.furniture == 0))) {
                def best:int -1
                def bestD:double 1000000.0
                def o:int 0
                while (o < (array_length mine)) {
                    def og:int (itemAt groupOfBox o)
                    def other:MdBox (itemAt mine o)
                    if (((o != m) && (og >= 0)) && (other.segSrc >= 0)) {
                        def ob:MdBox (itemAt mine o)
                        def d:double (fabs ((ob.y + (ob.h * 0.5)) - (mb.y + (mb.h * 0.5))))
                        if ((d < (mb.h * 0.6)) && (d < bestD)) {
                            bestD = d
                            best = og
                        }
                    }
                    o = (o + 1)
                }
                set groupOfBox m best
            }
            m = (m + 1)
        }
        def k:int 0
        while (k < (array_length mine)) {
            def kb:MdBox (itemAt mine k)
            def use:int -1
            if (kb.kind == 3) {
                def du:int 0
                while (du < (array_length s.diagrams)) {
                    if ((itemAt s.diagrams du).source == kb.embedSource) {
                        use = du
                    }
                    du = (du + 1)
                }
            }
            if (use >= 0) {
                def dia:PresDiaUse (itemAt s.diagrams use)
                dia.diagram.uiNow = uiNow
                dia.diagram.showControls = showControls
                dia.diagram.live = live
                ; a `bg=` can come after the fence was read
                dia.diagram.rimFade = (this.flatGround(s))
                ; The diagram gets the room below it, not just the box its
                ; picture fitted: a wide flowchart is a thin strip, and a
                ; camera zoomed into a strip shows a slot.
                def room:double (this.roomBelow(i kb))
                def span:[double] (this.diagramSpan(i kb))
                if still {
                    dia.diagram.paintStill(out (itemAt span 0) kb.y (itemAt span 1) room l.style.textColor paper l)
                } {
                    dia.diagram.paint(out (itemAt span 0) kb.y (itemAt span 1) room (t - dia.start) l.style.textColor paper l)
                }
            } {
                def tu@(optional):PresTableUse (this.tableOf(kb))
                if (!null? tu) {
                    def tb:PresTableUse (unwrap tu)
                    tb.slide = i
                    PresTable.paint(out tb kb.x kb.y kb.w kb.h (? still tb.stillPage tb.page) (showControls && (still == false)) l.style.textColor (this.themeColour("chart" "accent-color")) l)
                } {
                def before:int (array_length out.cmds)
                painter.paintBox(out l kb 0.0)
                if ((kb.kind == 3) && ((MdEmbedKinds.notationOf((MdEmbedKinds.firstWord(kb.embedKind)))) == "vega")) {
                    PresChart.dress(out before (t - (this.chartStart(s kb.embedSource))) still (this.themeColour("chart" "accent-color")) (this.themeColour("chart" "color")) kb.embedSource (this.chartStyleWords()))
                    if still {
                        PresChart.flatten(out before paper)
                    }
                }
                }
            }
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd (itemAt groupOfBox k)
            }
            k = (k + 1)
        }
        ; An effect that refracts what is behind it goes over the finished
        ; slide, with no background of its own: under the content it read the
        ; bare paper and the slide was then painted over it, so nothing showed.
        if ((((strlen s.fx) > 0) && (PresDeck.fxOnTop(s.fx))) && (useStill == false)) {
            this.addFx(out s "")
            while ((array_length groupOfCmd) < (array_length out.cmds)) {
                push groupOfCmd -1
            }
        }
        return out
    }

    ; The slide's line art (`{art=waves}`), over its picture and under the
    ; content, or nothing when it has none or figures are not allowed.
    fn artScene:FlowScene (s:PresSlide i:int) {
        if (((strlen s.art) == 0) || (figuresAllowed == false)) {
            def none (new FlowScene)
            return none
        }
        def seed:int s.artSeed
        if (seed < 0) {
            seed = (i + 1)
        }
        return (MdFigure.art(s.art figStyle pageW pageH seed))
    }

    fn slideArt:void (out:EVGDisplayList s:PresSlide i:int) {
        def sc:FlowScene (this.artScene(s i))
        sc.emitInto(out)
    }

    ; How the figures look in this theme:
    ;
    ;   figure {
    ;     colors: #1f6feb #0f9d8a #7c4dff #f08c00;   the series, in order
    ;     color: #B96926;  accent-color: #59C3C4;   or the first two
    ;     font-size: 18pt;                          the titles in them
    ;   }
    ;
    ; With no `figure` rule the chart's colours are used. Text and paper are
    ; the document's.
    fn figureStyle:MdFigureStyle () {
        def st (new MdFigureStyle)
        def cols:[string]
        def list:string (trim (this.themeRule("figure" "colors")))
        if ((strlen list) > 0) {
            def parts:[string] (strsplit list " ")
            def pi:int 0
            while (pi < (array_length parts)) {
                def c:string (PresDeck.unComma((trim (itemAt parts pi))))
                if ((strlen c) > 0) {
                    push cols c
                }
                pi = (pi + 1)
            }
        }
        if ((array_length cols) == 0) {
            def c1:string (trim (this.themeRule("figure" "color")))
            def c2:string (trim (this.themeRule("figure" "accent-color")))
            if ((strlen c1) == 0) {
                c1 = (trim (this.themeColour("chart" "color")))
            }
            if ((strlen c2) == 0) {
                c2 = (trim (this.themeColour("chart" "accent-color")))
            }
            if ((strlen c1) > 0) {
                push cols c1
            }
            if ((strlen c2) > 0) {
                push cols c2
            }
        }
        if ((array_length cols) > 0) {
            st.colors = cols
        }
        def ink:string (trim (this.themeRule("document" "color")))
        if ((strlen ink) > 0) {
            st.ink = ink
            st.muted = ink
        }
        def paper:string (trim (this.themeRule("page" "background-color")))
        if ((strlen paper) > 0) {
            st.paper = paper
        }
        def font:string (trim (this.themeRule("document" "font-family")))
        if ((strlen font) > 0) {
            st.font = (PresDeck.unQuote(font))
        }
        ; in points, the layout's unit; without a size of its own a figure
        ; takes the document's, a little smaller: its titles are labels, not
        ; headings (on a slide with room it is set larger again, up to the
        ; room under the heading — MdFigure.sceneFit)
        def fs:string (this.themeLength("figure" "figure" "font-size"))
        def scale:double 1.0
        if ((strlen fs) == 0) {
            fs = (this.themeLength("document" "document" "font-size"))
            scale = 0.85
        }
        if ((strlen fs) > 0) {
            st.size = ((PresDeck.num(fs 18.0)) * scale)
        } {
            st.size = 16.0
        }
        st.allowed = figuresAllowed
        st.lockedNote = (PresI18n.t("PRO: sign in to draw this layout."))
        return st
    }

    sfn unComma:string (c:string) {
        def n:int (strlen c)
        if ((n > 0) && ((charAt c (n - 1)) == 44)) {
            return (substring c 0 (n - 1))
        }
        return c
    }

    ; the first face of a font-family list, without its quotes
    sfn unQuote:string (f:string) {
        def t:string (trim f)
        def comma:int (indexOf t ",")
        if (comma > 0) {
            t = (trim (substring t 0 comma))
        }
        def n:int (strlen t)
        if ((n >= 2) && (((charAt t 0) == 34) || ((charAt t 0) == 39))) {
            return (substring t 1 (n - 1))
        }
        return t
    }

    fn hasFxStill:boolean (i:int) {
        def k:int 0
        while (k < (array_length fxStills)) {
            if ((itemAt fxStills k) == i) {
                return true
            }
            k = (k + 1)
        }
        return false
    }

    sfn fxStillPath:string (i:int) {
        return ("fx-still-" + (to_string i) + ".jpg")
    }

    ; The slide's own picture over the paper, covering the slide, and the
    ; paper again over it as far as `bg-dim` asks.
    fn slideBackground:void (out:EVGDisplayList l:MdLayout s:PresSlide paper:string) {
        if ((strlen s.bg) == 0) {
            return
        }
        if (l.haveImages == false) {
            return
        }
        def path:string (l.images.resolve(s.bg l.docDir))
        if ((strlen path) == 0) {
            return
        }
        def st:VfsStat (l.images.stat(path))
        if (st.found == false) {
            return
        }
        def c:EVGDrawCmd (new EVGDrawCmd())
        c.kind = 2
        c.x = 0.0
        c.y = 0.0
        c.w = pageW
        c.h = pageH
        c.src = path
        c.a = 1.0
        ; cover: the middle of the picture, in the slide's shape
        if ((st.pixelW > 0) && (st.pixelH > 0)) {
            def pr:double ((to_double st.pixelW) / (to_double st.pixelH))
            def sr:double (pageW / pageH)
            c.hasCrop = true
            if (pr > sr) {
                c.cropW = (sr / pr)
                c.cropX = ((1.0 - c.cropW) * 0.5)
            } {
                c.cropH = (pr / sr)
                c.cropY = ((1.0 - c.cropH) * 0.5)
            }
        }
        push out.cmds c
        if (s.bgDim > 0.0) {
            def d:EVGDrawCmd (new EVGDrawCmd())
            d.kind = 0
            d.w = pageW
            d.h = pageH
            def pc:EVGColor (EVGColor.parse(paper))
            d.r = (pc.red())
            d.g = (pc.green())
            d.b = (pc.blue())
            d.a = s.bgDim
            if (d.a > 1.0) {
                d.a = 1.0
            }
            push out.cmds d
        }
    }

    ; A slide's paper and its effect alone, for the host to render the
    ; effect as a picture the exports can carry. An effect that reads the
    ; page under it gets the paper to read.
    fn fxOnlyList:EVGDisplayList (i:int) {
        def l:MdLayout (this.layout())
        def s:PresSlide (itemAt slides i)
        def out:EVGDisplayList (new EVGDisplayList())
        def painter (new MdToEvg())
        def paper:string "#ffffff"
        if ((strlen l.style.pageBackground) > 0) {
            paper = l.style.pageBackground
        }
        painter.rect(out 0.0 0.0 pageW pageH paper)
        painter.paper(out l 0.0 0.0 pageW pageH)
        this.slideBackground(out l s paper)
        if ((strlen s.fx) > 0) {
            if (PresDeck.fxOnTop(s.fx)) {
                this.addFx(out s "")
            } {
                this.addFx(out s paper)
            }
        }
        return out
    }

    ; The effects that read the page under them (a `backdrop` layer in the
    ; WebGL painter) rather than paint a picture of their own.
    sfn fxOnTop:boolean (fx:string) {
        return ((fx == "liquid-glass") || (fx == "raindrop"))
    }

    ; The slide's surface effect: an element as big as the slide, dressed by
    ; the same `evg-surface-effect` CSS the rest of EVG reads, laid out and
    ; built into commands. Its id is the slide's so two slides on screen at
    ; once (a transition) keep two instances apart.
    fn addFx:void (out:EVGDisplayList s:PresSlide paper:string) {
        def css:string (".pres-fx { evg-surface-effect: " + s.fx + "; evg-effect-on: always;")
        if ((strlen paper) > 0) {
            css = (".pres-fx { background-color: " + paper + "; evg-surface-effect: " + s.fx + "; evg-effect-on: always;")
        }
        def i:int 0
        while (i < (array_length s.fxNames)) {
            css = (css + " evg-fx-" + (itemAt s.fxNames i) + ": " + (itemAt s.fxValues i) + ";")
            i = (i + 1)
        }
        css = (css + " }")
        def root (new EVGElement())
        root.id = ("fx-s" + (to_string s.index))
        root.className = "pres-fx"
        root.setAttribute("width" ((to_string pageW) + "px"))
        root.setAttribute("height" ((to_string pageH) + "px"))
        def sheet (new EVGStyleSheet())
        sheet.parse(css)
        sheet.setViewport(pageW pageH false)
        sheet.applyTree(root "")
        def lay (new EVGLayout())
        lay.setPageSize(pageW pageH)
        lay.layout(root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(root)
        PresDeck.appendAll(out dl)
    }

    ; Commands AND effect instances. `appendFrom` carries the commands only,
    ; and a command whose `efx` names an instance the list does not have
    ; draws nothing.
    sfn appendAll:void (out:EVGDisplayList src:EVGDisplayList) {
        out.appendFrom(src)
        PresDeck.appendFx(out src)
    }

    ; The effect instances alone, for a list whose commands were copied by hand.
    sfn appendFx:void (out:EVGDisplayList src:EVGDisplayList) {
        def i:int 0
        while (i < (array_length src.fxIds)) {
            push out.fxIds (itemAt src.fxIds i)
            push out.fxKinds (itemAt src.fxKinds i)
            push out.fxTriggers (itemAt src.fxTriggers i)
            push out.fxX (itemAt src.fxX i)
            push out.fxY (itemAt src.fxY i)
            push out.fxW (itemAt src.fxW i)
            push out.fxH (itemAt src.fxH i)
            push out.fxRadius (itemAt src.fxRadius i)
            def start:int (array_length out.fxParamNames)
            push out.fxParamStart start
            def ps:int (itemAt src.fxParamStart i)
            def pn:int (itemAt src.fxParamCount i)
            def k:int 0
            while (k < pn) {
                push out.fxParamNames (itemAt src.fxParamNames (ps + k))
                push out.fxParamValues (itemAt src.fxParamValues (ps + k))
                k = (k + 1)
            }
            push out.fxParamCount pn
            i = (i + 1)
        }
    }
}
