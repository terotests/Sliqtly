; SPDX-License-Identifier: AGPL-3.0-or-later
;
; Copied unchanged but for the imports from terotests/EVGUI src/ColorPickerCtl.rgr
; (commit fa4df38); gallery/ui in Ranger does not have it yet. The two
; PopoverCtl members Ranger's copy lacks (align, initialFocus) are left out.

; =============================================================================
; ColorPickerCtl — a colour picker, after Chrome's native <input type=color>
; =============================================================================
; Chrome's colour popup is the model: a saturation / value AREA with a round
; handle, then a row with the eyedropper, a swatch of the current colour and
; the hue slider, then the value as editable fields (HEX, or R G B, or H S L)
; with a small up / down button that cycles the format. This controller adds
; the two things the native popup lacks and a page wants: an ALPHA slider and a
; row of preset (or recent) swatches.
;
; STATE IS HSVA. Hue 0..360, saturation and value 0..1, alpha 0..1, kept as
; doubles. Not RGB, because RGB forgets the hue of a grey: drag the handle to
; the white corner and back and an RGB picker has lost which hue it was on.
; A colour set from RGB or hex whose hue is undefined (a grey) or whose
; saturation is undefined (black) keeps the one it had.
;
; THE CONVERSIONS are static and exact to rounding: hex / RGB (0..255 ints)
; <-> HSV <-> HSL, so any RGB colour survives RGB -> HSV -> RGB unchanged and
; any integer HSL survives HSL -> HSV -> HSL. `parse` reads what a person
; types or pastes: #rgb, #rgba, #rrggbb, #rrggbbaa (the # optional), rgb() /
; rgba() and hsl() / hsla() with commas or spaces and an optional "/ alpha".
;
; THE FIELDS are InputCtls this controller owns, so the page's text session
; edits them like any other box. What a field shows is derived from the colour
; UNLESS it is being edited: then it holds what was typed. A valid entry
; applies as it is typed; on blur (or Enter) an out-of-range number is clamped
; and anything unreadable reverts to the current value. Up / Down step a
; number field by 1, Shift by 10.
;
; KEYS, per part:
;   area      Left / Right step saturation, Up / Down step value (brightness),
;             by 1% and by 10% with Shift. Page Up / Down step value by 10%,
;             Home / End go to saturation 0 / 100%.
;   hue       the slider keys: Right / Up +1 deg, Left / Down -1, Shift or
;             Page Up / Down 10, Home 0, End 360.
;   alpha     the same over 0..100%.
;   format    Enter / Space / Down cycle HEX -> RGB -> HSL, Up cycles back.
;   swatches  a radio group: the arrows move and apply, as radios do.
;   popover   Escape closes and puts back the colour it had when it opened;
;             Enter commits and closes. Both return the focus to the trigger.
;
; WHAT IT IS, TO A READER:
;   trigger   a button with aria-haspopup="dialog", named with its colour
;             ("Accent colour, #3b82f6").
;   area      role slider with aria-roledescription "2D slider", its value
;             the saturation and aria-valuetext "Saturation 80%, Brightness
;             60%".
;   hue/alpha role slider, 0..360 and 0..100, with a valuetext.
;   fields    textboxes named Hex, Red, Green, Blue, Hue, Saturation,
;             Lightness, Alpha.
;
; THE EYEDROPPER. `picking` is set when its button is pressed; the host does
; the sampling (it is the one with the pixels) and ends it with `pickResult`
; (a hex) or `pickCancel`. `screenPickTid` asks the host for the OS-level
; picker (window.EyeDropper) the same way. The controller draws nothing: the
; demo reads the values and the `applyX(el)` helpers write the semantics.
; =============================================================================

Import "../ui/src/UiCtl.rgr"
Import "../ui/src/UiTree.rgr"
Import "../ui/src/PopoverCtl.rgr"
Import "../ui/src/InputCtl.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class ColorPickerCtl extends UiCtl {
    def hue:double 0.0
    def sat:double 0.0
    def val:double 0.0
    def alpha:double 1.0
    def withAlpha:boolean false
    ; 0 HEX, 1 RGB, 2 HSL.
    def format:int 0
    ; Drawn open, in the page, rather than in a popover off a trigger.
    def inline:boolean false
    def pop:PopoverCtl (new PopoverCtl())
    ; The colour when the popover opened, for Escape.
    def savedH:double 0.0
    def savedS:double 0.0
    def savedV:double 0.0
    def savedA:double 1.0
    ; The eyedropper.
    def picking:boolean false
    def screenAsk:boolean false
    ; Presets, or the recent colours when `recent` is set (a commit then puts
    ; the colour at the front).
    def swatches:[string]
    def swatchTitle:string "Presets"
    def recent:boolean false
    def maxSwatches:int 8
    ; The fields, and the one whose text the person owns right now.
    def f0:InputCtl (new InputCtl())
    def f1:InputCtl (new InputCtl())
    def f2:InputCtl (new InputCtl())
    def f3:InputCtl (new InputCtl())
    def editing:string ""
    ; Pixel widths of the text run in a hex box and a number box.
    def hexBoxW:double 120.0
    def numBoxW:double 28.0

    Constructor () {
        def e:[string]
        swatches = e
    }

    ; tid, label, initial colour (anything `parse` reads) and alpha.
    fn setup:void (id:string label:string colour:string alphaToo:boolean) {
        tid = id
        name = label
        withAlpha = alphaToo
        pop.tid = id
        pop.name = label
        ; (gallery/ui's PopoverCtl has no `align` / `initialFocus` yet;
        ; the chart editor draws the picker inline and never opens it)
        f0.tid = (id + "-f0")
        f1.tid = (id + "-f1")
        f2.tid = (id + "-f2")
        f3.tid = (id + "-f3")
        this.setFromString(colour)
        this.syncFields()
    }

    ; --- ids ----------------------------------------------------------------------

    fn triggerTid:string () {
        return (pop.triggerTid())
    }
    fn contentTid:string () {
        return (pop.contentTid())
    }
    fn panelTid:string () {
        if inline {
            return (tid + "-panel")
        }
        return (pop.contentTid())
    }
    fn svTid:string () {
        return (tid + "-sv")
    }
    fn svThumbTid:string () {
        return (tid + "-sv-thumb")
    }
    fn eyeTid:string () {
        return (tid + "-eye")
    }
    fn screenTid:string () {
        return (tid + "-screen")
    }
    fn swatchTid:string () {
        return (tid + "-swatch")
    }
    fn hueTid:string () {
        return (tid + "-hue")
    }
    fn alphaTid:string () {
        return (tid + "-alpha")
    }
    fn fmtTid:string () {
        return (tid + "-fmt")
    }
    fn presetsTid:string () {
        return (tid + "-presets")
    }
    fn presetTid:string (i:int) {
        return (tid + "-preset-" + (to_string i))
    }
    fn fieldTid:string (i:int) {
        return (tid + "-f" + (to_string i))
    }

    fn owns:boolean (target:string) {
        def p:string (tid + "-")
        def n:int (strlen p)
        if ((strlen target) < n) {
            return false
        }
        return ((substring target 0 n) == p)
    }

    ; The part a hit id belongs to: "sv", "hue", "alpha", "preset-3", "f1", …
    ; A thumb or a layer inside a part is that part.
    fn partOf:string (target:string) {
        if ((this.owns(target)) == false) {
            return ""
        }
        def rest:string (substring target ((strlen tid) + 1) (strlen target))
        def dash:int (indexOf rest "-")
        if (UiTree.beginsWith(rest "preset-")) {
            def tail:string (substring rest 7 (strlen rest))
            def d2:int (indexOf tail "-")
            if (d2 >= 0) {
                return ("preset-" + (substring tail 0 d2))
            }
            return rest
        }
        if (dash >= 0) {
            def head:string (substring rest 0 dash)
            if ((head == "sv") || (head == "hue") || (head == "alpha") || (head == "trigger")) {
                return head
            }
            if ((head == "f0") || (head == "f1") || (head == "f2") || (head == "f3")) {
                return head
            }
        }
        return rest
    }

    fn isOpen:boolean () {
        if inline {
            return true
        }
        return pop.open
    }

    ; =========================================================================
    ; conversions
    ; =========================================================================

    sfn roundi:int (x:double) {
        if (x < 0.0) {
            return (0 - (to_int ((0.0 - x) + 0.5)))
        }
        return (to_int (x + 0.5))
    }

    sfn clampd:double (x:double lo:double hi:double) {
        if (x < lo) {
            return lo
        }
        if (x > hi) {
            return hi
        }
        return x
    }

    sfn clampi:int (x:int lo:int hi:int) {
        if (x < lo) {
            return lo
        }
        if (x > hi) {
            return hi
        }
        return x
    }

    sfn mind:double (a:double b:double) {
        if (a < b) {
            return a
        }
        return b
    }

    sfn maxd:double (a:double b:double) {
        if (a > b) {
            return a
        }
        return b
    }

    ; Hue into 0..360 (360 stays 360: it is the slider's end, and red).
    sfn wrapHue:double (h:double) {
        def v:double h
        while (v < 0.0) {
            v = (v + 360.0)
        }
        while (v > 360.0) {
            v = (v - 360.0)
        }
        return v
    }

    ; HSV -> RGB, 0..255 and NOT rounded.
    sfn hsvToRgb:[double] (h:double s:double v:double) {
        def hh:double (ColorPickerCtl.wrapHue(h))
        if (hh >= 360.0) {
            hh = 0.0
        }
        def h6:double (hh / 60.0)
        def i:int (to_int h6)
        if (i > 5) {
            i = 5
        }
        def f:double (h6 - (to_double i))
        def p:double (v * (1.0 - s))
        def q:double (v * (1.0 - (s * f)))
        def t:double (v * (1.0 - (s * (1.0 - f))))
        def r:double v
        def g:double t
        def b:double p
        if (i == 1) {
            r = q
            g = v
            b = p
        }
        if (i == 2) {
            r = p
            g = v
            b = t
        }
        if (i == 3) {
            r = p
            g = q
            b = v
        }
        if (i == 4) {
            r = t
            g = p
            b = v
        }
        if (i == 5) {
            r = v
            g = p
            b = q
        }
        def out:[double]
        push out (r * 255.0)
        push out (g * 255.0)
        push out (b * 255.0)
        return out
    }

    ; RGB (0..255) -> [h, s, v]. h is -1 where it is undefined (a grey), s is
    ; -1 where IT is undefined (black): the caller keeps what it had.
    sfn rgbToHsv:[double] (r0:double g0:double b0:double) {
        def r:double (r0 / 255.0)
        def g:double (g0 / 255.0)
        def b:double (b0 / 255.0)
        def mx:double (ColorPickerCtl.maxd(r (ColorPickerCtl.maxd(g b))))
        def mn:double (ColorPickerCtl.mind(r (ColorPickerCtl.mind(g b))))
        def d:double (mx - mn)
        def h:double -1.0
        if (d > 0.0) {
            if (mx == r) {
                h = (60.0 * ((g - b) / d))
                if (h < 0.0) {
                    h = (h + 360.0)
                }
            } {
                if (mx == g) {
                    h = (60.0 * (((b - r) / d) + 2.0))
                } {
                    h = (60.0 * (((r - g) / d) + 4.0))
                }
            }
        }
        def s:double -1.0
        if (mx > 0.0) {
            s = (d / mx)
        }
        def out:[double]
        push out h
        push out s
        push out mx
        return out
    }

    ; HSV (s, v 0..1) -> [h, s, l] (0..1).
    sfn hsvToHsl:[double] (h:double s:double v:double) {
        def l:double (v * (1.0 - (s / 2.0)))
        def sl:double 0.0
        def m:double (ColorPickerCtl.mind(l (1.0 - l)))
        if (m > 0.0) {
            sl = ((v - l) / m)
        }
        def out:[double]
        push out h
        push out sl
        push out l
        return out
    }

    ; HSL (s, l 0..1) -> [h, s, v].
    sfn hslToHsv:[double] (h:double s:double l:double) {
        def v:double (l + (s * (ColorPickerCtl.mind(l (1.0 - l)))))
        def sv:double 0.0
        if (v > 0.0) {
            sv = (2.0 * (1.0 - (l / v)))
        }
        def out:[double]
        push out h
        push out (ColorPickerCtl.clampd(sv 0.0 1.0))
        push out (ColorPickerCtl.clampd(v 0.0 1.0))
        return out
    }

    sfn hexDigit:int (c:int) {
        if ((c >= 48) && (c <= 57)) {
            return (c - 48)
        }
        if ((c >= 97) && (c <= 102)) {
            return (c - 87)
        }
        if ((c >= 65) && (c <= 70)) {
            return (c - 55)
        }
        return -1
    }

    sfn hex2:string (n0:int) {
        def n:int (ColorPickerCtl.clampi(n0 0 255))
        def digits:string "0123456789abcdef"
        def hi:int (idiv n 16)
        def lo:int (n - (hi * 16))
        return ((substring digits hi (hi + 1)) + (substring digits lo (lo + 1)))
    }

    sfn hexOf:string (r:int g:int b:int) {
        return ("#" + (ColorPickerCtl.hex2(r)) + (ColorPickerCtl.hex2(g)) + (ColorPickerCtl.hex2(b)))
    }

    ; Up to two decimals, no trailing zeros: 0.5, 0.25, 1.
    sfn short2:string (x:double) {
        def c:int (ColorPickerCtl.roundi((x * 100.0)))
        def neg:boolean (c < 0)
        if neg {
            c = (0 - c)
        }
        def whole:int (idiv c 100)
        def frac:int (c - (whole * 100))
        def out:string (to_string whole)
        if (frac > 0) {
            if (frac < 10) {
                out = (out + ".0" + (to_string frac))
            } {
                if ((frac % 10) == 0) {
                    out = (out + "." + (to_string (idiv frac 10)))
                } {
                    out = (out + "." + (to_string frac))
                }
            }
        }
        if neg {
            return ("-" + out)
        }
        return out
    }

    ; Is `t` a plain decimal number: digits, at most one dot, an optional
    ; leading minus, at least one digit?
    sfn isNumber:boolean (t:string) {
        def n:int (strlen t)
        if (n == 0) {
            return false
        }
        def digits:int 0
        def dots:int 0
        def i:int 0
        while (i < n) {
            def c:int (charAt t i)
            if ((c >= 48) && (c <= 57)) {
                digits = (digits + 1)
            } {
                if (c == 46) {
                    dots = (dots + 1)
                } {
                    if ((c == 45) && (i == 0)) {
                        dots = dots
                    } {
                        return false
                    }
                }
            }
            i = (i + 1)
        }
        return ((digits > 0) && (dots <= 1))
    }

    sfn num:double (t:string) {
        def v@(optional):double (to_double t)
        if (null? v) {
            return 0.0
        }
        return (unwrap v)
    }

    ; Split on commas, spaces and slashes; empty pieces dropped.
    sfn tokens:[string] (t:string) {
        def out:[string]
        def cur:string ""
        def i:int 0
        def n:int (strlen t)
        while (i < n) {
            def c:int (charAt t i)
            if ((c == 44) || (c == 32) || (c == 47) || (c == 9)) {
                if ((strlen cur) > 0) {
                    push out cur
                }
                cur = ""
            } {
                cur = (cur + (substring t i (i + 1)))
            }
            i = (i + 1)
        }
        if ((strlen cur) > 0) {
            push out cur
        }
        return out
    }

    ; A component: "128", "50%", "0.5", "210deg". `scale` is what 100%
    ; means; -1 when it is not a number. A bare number is taken as it is.
    sfn component:double (t0:string scale:double) {
        def t:string t0
        def pct:boolean false
        def n:int (strlen t)
        if ((n > 1) && ((substring t (n - 1) n) == "%")) {
            pct = true
            t = (substring t 0 (n - 1))
        }
        def m:int (strlen t)
        if ((m > 3) && ((substring t (m - 3) m) == "deg")) {
            t = (substring t 0 (m - 3))
        }
        if ((ColorPickerCtl.isNumber(t)) == false) {
            return -1.0
        }
        def v:double (ColorPickerCtl.num(t))
        if pct {
            return ((v / 100.0) * scale)
        }
        return v
    }

    ; What a person typed or pasted, as [h, s, v, a] — h -1 for "keep the
    ; hue", s -1 for "keep the saturation" — or [] when it is not a colour.
    sfn parse:[double] (text:string) {
        def bad:[double]
        def t:string (to_lowercase (trim text))
        def n:int (strlen t)
        if (n == 0) {
            return bad
        }
        if (UiTree.beginsWith(t "rgb") || UiTree.beginsWith(t "hsl")) {
            def open:int (indexOf t "(")
            def close:int (indexOf t ")")
            if ((open < 0) || (close < open) || (close != (n - 1))) {
                return bad
            }
            def head:string (trim (substring t 0 open))
            if ((head != "rgb") && (head != "rgba") && (head != "hsl") && (head != "hsla")) {
                return bad
            }
            def parts:[string] (ColorPickerCtl.tokens((substring t (open + 1) close)))
            def k:int (array_length parts)
            if ((k != 3) && (k != 4)) {
                return bad
            }
            def a:double 1.0
            if (k == 4) {
                a = (ColorPickerCtl.component((itemAt parts 3) 1.0))
                if ((a < 0.0) || (a > 1.0)) {
                    return bad
                }
            }
            if (UiTree.beginsWith(head "rgb")) {
                def r:double (ColorPickerCtl.component((itemAt parts 0) 255.0))
                def g:double (ColorPickerCtl.component((itemAt parts 1) 255.0))
                def b:double (ColorPickerCtl.component((itemAt parts 2) 255.0))
                if ((r < 0.0) || (g < 0.0) || (b < 0.0)) {
                    return bad
                }
                if ((r > 255.0) || (g > 255.0) || (b > 255.0)) {
                    return bad
                }
                def hsv:[double] (ColorPickerCtl.rgbToHsv((to_double (ColorPickerCtl.roundi(r))) (to_double (ColorPickerCtl.roundi(g))) (to_double (ColorPickerCtl.roundi(b)))))
                push hsv a
                return hsv
            }
            def h:double (ColorPickerCtl.component((itemAt parts 0) 360.0))
            def s:double (ColorPickerCtl.component((itemAt parts 1) 1.0))
            def l:double (ColorPickerCtl.component((itemAt parts 2) 1.0))
            if ((h < 0.0) || (s < 0.0) || (l < 0.0) || (s > 1.0) || (l > 1.0)) {
                return bad
            }
            ; hsl(…) takes its S and L as percentages: "50%" is 0.5 above,
            ; and a bare 50 means the same.
            if (((indexOf (itemAt parts 1) "%") < 0) && (s > 1.0)) {
                s = (s / 100.0)
            }
            def out:[double] (ColorPickerCtl.hslToHsv((ColorPickerCtl.wrapHue(h)) s l))
            push out a
            return out
        }
        ; Hex, with or without the #.
        def hx:string t
        if ((substring t 0 1) == "#") {
            hx = (substring t 1 n)
        }
        def m:int (strlen hx)
        if ((m != 3) && (m != 4) && (m != 6) && (m != 8)) {
            return bad
        }
        def vals:[int]
        def i:int 0
        while (i < m) {
            def d:int (ColorPickerCtl.hexDigit((charAt hx i)))
            if (d < 0) {
                return bad
            }
            push vals d
            i = (i + 1)
        }
        def rr:int 0
        def gg:int 0
        def bb:int 0
        def aa:int 255
        if (m <= 4) {
            rr = ((itemAt vals 0) * 17)
            gg = ((itemAt vals 1) * 17)
            bb = ((itemAt vals 2) * 17)
            if (m == 4) {
                aa = ((itemAt vals 3) * 17)
            }
        } {
            rr = (((itemAt vals 0) * 16) + (itemAt vals 1))
            gg = (((itemAt vals 2) * 16) + (itemAt vals 3))
            bb = (((itemAt vals 4) * 16) + (itemAt vals 5))
            if (m == 8) {
                aa = (((itemAt vals 6) * 16) + (itemAt vals 7))
            }
        }
        def out2:[double] (ColorPickerCtl.rgbToHsv((to_double rr) (to_double gg) (to_double bb)))
        push out2 ((to_double aa) / 255.0)
        return out2
    }

    ; =========================================================================
    ; the colour
    ; =========================================================================

    ; [h, s, v, a] as `parse` gives it; -1s keep what is there.
    fn setHsva:void (hsva:[double]) {
        def h:double (itemAt hsva 0)
        def s:double (itemAt hsva 1)
        def v:double (itemAt hsva 2)
        if (h >= 0.0) {
            hue = (ColorPickerCtl.wrapHue(h))
        }
        if (s >= 0.0) {
            sat = (ColorPickerCtl.clampd(s 0.0 1.0))
        }
        val = (ColorPickerCtl.clampd(v 0.0 1.0))
        if ((array_length hsva) > 3) {
            if withAlpha {
                alpha = (ColorPickerCtl.clampd((itemAt hsva 3) 0.0 1.0))
            } {
                alpha = 1.0
            }
        }
    }

    fn setFromString:boolean (t:string) {
        def p:[double] (ColorPickerCtl.parse(t))
        if ((array_length p) == 0) {
            return false
        }
        this.setHsva(p)
        return true
    }

    fn setRgb:void (r:int g:int b:int) {
        def p:[double] (ColorPickerCtl.rgbToHsv((to_double r) (to_double g) (to_double b)))
        this.setHsva(p)
    }

    fn rgb:[int] () {
        def c:[double] (ColorPickerCtl.hsvToRgb(hue sat val))
        def out:[int]
        push out (ColorPickerCtl.roundi((itemAt c 0)))
        push out (ColorPickerCtl.roundi((itemAt c 1)))
        push out (ColorPickerCtl.roundi((itemAt c 2)))
        return out
    }

    ; The HSL a person sees: hue 0..359, saturation and lightness in %.
    fn hslInts:[int] () {
        def c:[double] (ColorPickerCtl.hsvToHsl(hue sat val))
        def out:[int]
        def h:int (ColorPickerCtl.roundi(hue))
        if (h >= 360) {
            h = 0
        }
        push out h
        push out (ColorPickerCtl.roundi(((itemAt c 1) * 100.0)))
        push out (ColorPickerCtl.roundi(((itemAt c 2) * 100.0)))
        return out
    }

    fn alphaPct:int () {
        return (ColorPickerCtl.roundi((alpha * 100.0)))
    }

    fn opaque:boolean () {
        return ((withAlpha == false) || ((ColorPickerCtl.roundi((alpha * 255.0))) >= 255))
    }

    ; "#3b82f6", or "#3b82f680" when it is not opaque.
    fn hex:string () {
        def c:[int] (this.rgb())
        def h:string (ColorPickerCtl.hexOf((itemAt c 0) (itemAt c 1) (itemAt c 2)))
        if (this.opaque()) {
            return h
        }
        return (h + (ColorPickerCtl.hex2((ColorPickerCtl.roundi((alpha * 255.0))))))
    }

    ; The opaque hex, whatever the alpha: for painting.
    fn hex6:string () {
        def c:[int] (this.rgb())
        return (ColorPickerCtl.hexOf((itemAt c 0) (itemAt c 1) (itemAt c 2)))
    }

    ; The pure hue at full saturation and value: the area's right edge.
    fn hueHex:string () {
        def c:[double] (ColorPickerCtl.hsvToRgb(hue 1.0 1.0))
        return (ColorPickerCtl.hexOf((ColorPickerCtl.roundi((itemAt c 0))) (ColorPickerCtl.roundi((itemAt c 1))) (ColorPickerCtl.roundi((itemAt c 2)))))
    }

    fn rgbCss:string () {
        def c:[int] (this.rgb())
        def body:string ((to_string (itemAt c 0)) + ", " + (to_string (itemAt c 1)) + ", " + (to_string (itemAt c 2)))
        if (this.opaque()) {
            return ("rgb(" + body + ")")
        }
        return ("rgba(" + body + ", " + (ColorPickerCtl.short2(alpha)) + ")")
    }

    fn hslCss:string () {
        def c:[int] (this.hslInts())
        def body:string ((to_string (itemAt c 0)) + ", " + (to_string (itemAt c 1)) + "%, " + (to_string (itemAt c 2)) + "%")
        if (this.opaque()) {
            return ("hsl(" + body + ")")
        }
        return ("hsla(" + body + ", " + (ColorPickerCtl.short2(alpha)) + ")")
    }

    fn hsvCss:string () {
        def h:int (ColorPickerCtl.roundi(hue))
        if (h >= 360) {
            h = 0
        }
        return ("hsv(" + (to_string h) + ", " + (to_string (ColorPickerCtl.roundi((sat * 100.0)))) + "%, " + (to_string (ColorPickerCtl.roundi((val * 100.0)))) + "%)")
    }

    ; The value in the current format, as the trigger and a status show it.
    fn cssText:string () {
        if (format == 1) {
            return (this.rgbCss())
        }
        if (format == 2) {
            return (this.hslCss())
        }
        return (this.hex())
    }

    ; =========================================================================
    ; the parts
    ; =========================================================================

    fn setSV:void (fx:double fy:double) {
        sat = (ColorPickerCtl.clampd(fx 0.0 1.0))
        val = (ColorPickerCtl.clampd((1.0 - fy) 0.0 1.0))
        this.changed()
    }

    fn setHueFrac:void (f:double) {
        hue = ((ColorPickerCtl.clampd(f 0.0 1.0)) * 360.0)
        this.changed()
    }

    fn setAlphaFrac:void (f:double) {
        if withAlpha {
            alpha = (ColorPickerCtl.clampd(f 0.0 1.0))
        }
        this.changed()
    }

    fn hueFrac:double () {
        return (hue / 360.0)
    }

    fn svText:string () {
        return ("Saturation " + (to_string (ColorPickerCtl.roundi((sat * 100.0)))) + "%, Brightness " + (to_string (ColorPickerCtl.roundi((val * 100.0)))) + "%")
    }

    fn hueText:string () {
        return ((to_string (ColorPickerCtl.roundi(hue))) + " degrees")
    }

    fn alphaText:string () {
        return ((to_string (this.alphaPct())) + "%")
    }

    ; Step the area. dx, dy in percent; dy up is brighter.
    fn stepSV:void (dx:double dy:double) {
        def s:int (ColorPickerCtl.clampi(((ColorPickerCtl.roundi((sat * 100.0))) + (ColorPickerCtl.roundi(dx))) 0 100))
        def v:int (ColorPickerCtl.clampi(((ColorPickerCtl.roundi((val * 100.0))) + (ColorPickerCtl.roundi(dy))) 0 100))
        sat = ((to_double s) / 100.0)
        val = ((to_double v) / 100.0)
        this.changed()
    }

    ; =========================================================================
    ; the fields
    ; =========================================================================

    fn fieldCount:int () {
        if (format == 0) {
            return 1
        }
        if withAlpha {
            return 4
        }
        return 3
    }

    fn fieldAt:InputCtl (i:int) {
        if (i == 1) {
            return f1
        }
        if (i == 2) {
            return f2
        }
        if (i == 3) {
            return f3
        }
        return f0
    }

    ; The field with this tid, if it is one of the fields shown.
    fn fieldIndex:int (target:string) {
        def i:int 0
        while (i < (this.fieldCount())) {
            if (target == (this.fieldTid(i))) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn fieldLabel:string (i:int) {
        if (format == 0) {
            return "HEX"
        }
        if (i == 3) {
            return "A"
        }
        if (format == 1) {
            if (i == 0) {
                return "R"
            }
            if (i == 1) {
                return "G"
            }
            return "B"
        }
        if (i == 0) {
            return "H"
        }
        if (i == 1) {
            return "S"
        }
        return "L"
    }

    fn fieldName:string (i:int) {
        if (format == 0) {
            return "Hex"
        }
        if (i == 3) {
            return "Alpha, percent"
        }
        if (format == 1) {
            if (i == 0) {
                return "Red"
            }
            if (i == 1) {
                return "Green"
            }
            return "Blue"
        }
        if (i == 0) {
            return "Hue, degrees"
        }
        if (i == 1) {
            return "Saturation, percent"
        }
        return "Lightness, percent"
    }

    fn fieldMax:int (i:int) {
        if (format == 0) {
            return 0
        }
        if (i == 3) {
            return 100
        }
        if (format == 1) {
            return 255
        }
        if (i == 0) {
            return 360
        }
        return 100
    }

    ; What field i shows for the current colour.
    fn fieldText:string (i:int) {
        if (format == 0) {
            return (this.hex())
        }
        if (i == 3) {
            return (to_string (this.alphaPct()))
        }
        def c:[int] (this.rgb())
        if (format == 2) {
            c = (this.hslInts())
        }
        return (to_string (itemAt c i))
    }

    ; Every field that is not being edited shows the colour.
    fn syncFields:void () {
        def i:int 0
        while (i < 4) {
            def f:InputCtl (this.fieldAt(i))
            f.tid = (this.fieldTid(i))
            f.name = (this.fieldName(i))
            f.fontSize = 12.0
            if (format == 0) {
                f.kind = "text"
                f.maxLength = 9
                f.boxWidth = hexBoxW
            } {
                f.kind = "number"
                f.maxLength = 3
                f.boxWidth = numBoxW
            }
            if ((i < (this.fieldCount())) && ((this.fieldTid(i)) != editing)) {
                def t:string (this.fieldText(i))
                if (f.value != t) {
                    f.value = t
                    f.caret = (strlen t)
                    f.anchor = (strlen t)
                    f.scrollX = 0.0
                }
            }
            i = (i + 1)
        }
    }

    fn changed:void () {
        this.syncFields()
    }

    ; A number field's value applied: n is already in range.
    fn applyNumber:void (i:int n:int) {
        if (i == 3) {
            alpha = ((to_double n) / 100.0)
            return
        }
        if (format == 1) {
            def c:[int] (this.rgb())
            def r:int (itemAt c 0)
            def g:int (itemAt c 1)
            def b:int (itemAt c 2)
            if (i == 0) {
                r = n
            }
            if (i == 1) {
                g = n
            }
            if (i == 2) {
                b = n
            }
            this.setRgb(r g b)
            return
        }
        def l:[int] (this.hslInts())
        def hh:double hue
        def ss:int (itemAt l 1)
        def ll:int (itemAt l 2)
        if (i == 0) {
            hh = (to_double n)
        }
        if (i == 1) {
            ss = n
        }
        if (i == 2) {
            ll = n
        }
        def v:[double] (ColorPickerCtl.hslToHsv(hh ((to_double ss) / 100.0) ((to_double ll) / 100.0)))
        hue = (ColorPickerCtl.wrapHue(hh))
        ; A grey keeps the saturation it had in HSV terms only while it is
        ; not being set: here it IS being set, so it is taken as it comes.
        sat = (itemAt v 1)
        val = (itemAt v 2)
        if ((val == 0.0) && (i != 1)) {
            sat = sat
        }
    }

    ; The field's text, read: true when it is a usable value (and applied).
    ; `final` clamps an out-of-range number; while typing it is ignored.
    fn readField:boolean (i:int final:boolean) {
        def f:InputCtl (this.fieldAt(i))
        def t:string (trim f.value)
        if (format == 0) {
            def p:[double] (ColorPickerCtl.parse(t))
            if ((array_length p) == 0) {
                return false
            }
            ; A hex that says nothing about alpha leaves the alpha alone.
            def hx:string t
            if ((strlen hx) > 0) {
                if ((substring hx 0 1) == "#") {
                    hx = (substring hx 1 (strlen hx))
                }
            }
            ; While it is being typed only a whole #rrggbb or #rrggbbaa
            ; applies: "#ff00" on the way to "#ff0000" is #rgba with alpha 0,
            ; and the colour must not flash through it. The short forms apply
            ; when the field is left or Enter is pressed.
            if ((final == false) && ((strlen hx) != 6) && ((strlen hx) != 8)) {
                return false
            }
            if (((strlen hx) == 3) || ((strlen hx) == 6)) {
                def keep:[double]
                push keep (itemAt p 0)
                push keep (itemAt p 1)
                push keep (itemAt p 2)
                this.setHsva(keep)
                return true
            }
            this.setHsva(p)
            return true
        }
        if ((ColorPickerCtl.isNumber(t)) == false) {
            return false
        }
        def v:double (ColorPickerCtl.num(t))
        def n:int (ColorPickerCtl.roundi(v))
        def top:int (this.fieldMax(i))
        if ((n < 0) || (n > top)) {
            if (final == false) {
                return false
            }
            n = (ColorPickerCtl.clampi(n 0 top))
        }
        this.applyNumber(i n)
        return true
    }

    ; A keystroke landed in field i: apply it if it reads, and leave the text
    ; as typed.
    fn fieldEdited:void (i:int) {
        editing = (this.fieldTid(i))
        if (this.readField(i false)) {
            this.syncFields()
        }
    }

    ; Blur or Enter: clamp or revert, then show the colour again.
    fn commitField:void (target:string) {
        def i:int (this.fieldIndex(target))
        if (i < 0) {
            return
        }
        this.readField(i true)
        editing = ""
        this.syncFields()
    }

    ; Escape in a field (inline): what was typed goes, the colour stays.
    fn revertField:void (target:string) {
        editing = ""
        this.syncFields()
    }

    ; Up / Down in a number field.
    fn stepField:boolean (target:string delta:int) {
        def i:int (this.fieldIndex(target))
        if ((i < 0) || (format == 0)) {
            return false
        }
        def f:InputCtl (this.fieldAt(i))
        def t:string (trim f.value)
        def n:int 0
        if (ColorPickerCtl.isNumber(t)) {
            n = (ColorPickerCtl.roundi((ColorPickerCtl.num(t))))
        } {
            n = (ColorPickerCtl.roundi((ColorPickerCtl.num((this.fieldText(i))))))
        }
        def top:int (this.fieldMax(i))
        n = (ColorPickerCtl.clampi((n + delta) 0 top))
        ; Hue wraps, as the slider's does not: 359 + 1 is 0.
        this.applyNumber(i n)
        editing = ""
        this.syncFields()
        f.selectAll()
        return true
    }

    fn cycleFormat:void (dir:int) {
        if ((strlen editing) > 0) {
            this.commitField(editing)
        }
        format = (((format + dir) + 3) % 3)
        editing = ""
        this.syncFields()
    }

    ; =========================================================================
    ; swatches
    ; =========================================================================

    fn swatchCount:int () {
        return (array_length swatches)
    }

    fn swatchAt:string (i:int) {
        return (itemAt swatches i)
    }

    fn presetIndex:int (target:string) {
        def i:int 0
        while (i < (array_length swatches)) {
            if (target == (this.presetTid(i))) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; Is swatch i the current colour?
    fn swatchChecked:boolean (i:int) {
        def p:[double] (ColorPickerCtl.parse((itemAt swatches i)))
        if ((array_length p) == 0) {
            return false
        }
        def probe (new ColorPickerCtl())
        probe.withAlpha = withAlpha
        probe.setHsva(p)
        return ((probe.hex()) == (this.hex()))
    }

    fn checkedSwatch:int () {
        def i:int 0
        while (i < (array_length swatches)) {
            if (this.swatchChecked(i)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn applySwatch:void (i:int) {
        if ((i < 0) || (i >= (array_length swatches))) {
            return
        }
        editing = ""
        this.setFromString((itemAt swatches i))
        this.syncFields()
    }

    ; A committed colour, to the front of the recent row.
    fn remember:void () {
        if (recent == false) {
            return
        }
        def h:string (this.hex())
        def out:[string]
        push out h
        def i:int 0
        while (i < (array_length swatches)) {
            def s:string (itemAt swatches i)
            if ((s != h) && ((array_length out) < maxSwatches)) {
                push out s
            }
            i = (i + 1)
        }
        swatches = out
    }

    ; =========================================================================
    ; the popover
    ; =========================================================================

    fn save:void () {
        savedH = hue
        savedS = sat
        savedV = val
        savedA = alpha
    }

    fn restore:void () {
        hue = savedH
        sat = savedS
        val = savedV
        alpha = savedA
        editing = ""
        this.syncFields()
    }

    ; Returns the id to focus.
    fn openPopover:string () {
        if inline {
            return ""
        }
        this.save()
        editing = ""
        picking = false
        this.syncFields()
        return (pop.openAndFocus())
    }

    ; Enter, or a press / focus outside: the colour stays.
    fn commitClose:string () {
        if (editing != "") {
            this.commitField(editing)
        }
        picking = false
        this.remember()
        if inline {
            return ""
        }
        if (pop.open == false) {
            return ""
        }
        return (pop.closeAndRestore())
    }

    ; Escape: the colour it had when it opened.
    fn cancelClose:string () {
        picking = false
        if inline {
            return ""
        }
        if (pop.open == false) {
            return ""
        }
        this.restore()
        return (pop.closeAndRestore())
    }

    ; =========================================================================
    ; the eyedropper
    ; =========================================================================

    fn startPick:void () {
        if (editing != "") {
            this.commitField(editing)
        }
        picking = true
    }

    fn pickResult:boolean (hexText:string) {
        picking = false
        def p:[double] (ColorPickerCtl.parse(hexText))
        if ((array_length p) == 0) {
            return false
        }
        ; A sampled pixel says nothing about how transparent the colour
        ; should be: the alpha stays.
        def keep:[double]
        push keep (itemAt p 0)
        push keep (itemAt p 1)
        push keep (itemAt p 2)
        this.setHsva(keep)
        editing = ""
        this.syncFields()
        return true
    }

    fn pickCancel:void () {
        picking = false
    }

    ; =========================================================================
    ; the keyboard
    ; =========================================================================

    ; A key on `target`. Returns the id the focus should be on afterwards,
    ; or "" when the key is not this picker's. The host has already given
    ; Escape / Enter in a popover to `cancelClose` / `commitClose`.
    fn keyDown:string (target:string key:string) {
        return (this.keyWith(target key false))
    }

    fn keyWith:string (target:string key:string shift:boolean) {
        def part:string (this.partOf(target))
        def big:boolean shift
        def step:double 1.0
        if big {
            step = 10.0
        }
        if (target == (this.triggerTid())) {
            if (UiCtl.activatesOn(key) || (key == "ArrowDown")) {
                return (this.openPopover())
            }
            return ""
        }
        if (part == "sv") {
            if (key == "ArrowRight") {
                this.stepSV(step 0.0)
                return target
            }
            if (key == "ArrowLeft") {
                this.stepSV((0.0 - step) 0.0)
                return target
            }
            if (key == "ArrowUp") {
                this.stepSV(0.0 step)
                return target
            }
            if (key == "ArrowDown") {
                this.stepSV(0.0 (0.0 - step))
                return target
            }
            if (key == "PageUp") {
                this.stepSV(0.0 10.0)
                return target
            }
            if (key == "PageDown") {
                this.stepSV(0.0 -10.0)
                return target
            }
            if (key == "Home") {
                sat = 0.0
                this.changed()
                return target
            }
            if (key == "End") {
                sat = 1.0
                this.changed()
                return target
            }
            return ""
        }
        if ((part == "hue") || (part == "alpha")) {
            def top:double 360.0
            def now:double (to_double (ColorPickerCtl.roundi(hue)))
            if (part == "alpha") {
                top = 100.0
                now = (to_double (this.alphaPct()))
            }
            def next:double now
            def took:boolean true
            if ((key == "ArrowRight") || (key == "ArrowUp")) {
                next = (now + step)
            } {
                if ((key == "ArrowLeft") || (key == "ArrowDown")) {
                    next = (now - step)
                } {
                    if (key == "PageUp") {
                        next = (now + 10.0)
                    } {
                        if (key == "PageDown") {
                            next = (now - 10.0)
                        } {
                            if (key == "Home") {
                                next = 0.0
                            } {
                                if (key == "End") {
                                    next = top
                                } {
                                    took = false
                                }
                            }
                        }
                    }
                }
            }
            if (took == false) {
                return ""
            }
            next = (ColorPickerCtl.clampd(next 0.0 top))
            if (part == "hue") {
                hue = next
            } {
                alpha = (next / 100.0)
            }
            this.changed()
            return target
        }
        if (target == (this.fmtTid())) {
            if (UiCtl.activatesOn(key) || (key == "ArrowDown")) {
                this.cycleFormat(1)
                return target
            }
            if (key == "ArrowUp") {
                this.cycleFormat(-1)
                return target
            }
            return ""
        }
        if ((target == (this.eyeTid())) && (UiCtl.activatesOn(key))) {
            this.startPick()
            return target
        }
        if ((target == (this.screenTid())) && (UiCtl.activatesOn(key))) {
            screenAsk = true
            return target
        }
        def fi:int (this.fieldIndex(target))
        if (fi >= 0) {
            if (key == "ArrowUp") {
                if (this.stepField(target (to_int step))) {
                    return target
                }
                return ""
            }
            if (key == "ArrowDown") {
                if (this.stepField(target (0 - (to_int step)))) {
                    return target
                }
                return ""
            }
            if (key == "Enter") {
                this.commitField(target)
                return target
            }
            if (key == "Escape") {
                this.revertField(target)
                return target
            }
            return ""
        }
        def si:int (this.presetIndex(target))
        if (si >= 0) {
            def n:int (array_length swatches)
            def to:int -1
            if ((key == "ArrowRight") || (key == "ArrowDown")) {
                to = ((si + 1) % n)
            }
            if ((key == "ArrowLeft") || (key == "ArrowUp")) {
                to = (((si - 1) + n) % n)
            }
            if (key == "Home") {
                to = 0
            }
            if (key == "End") {
                to = (n - 1)
            }
            if (UiCtl.activatesOn(key)) {
                this.applySwatch(si)
                return target
            }
            if (to >= 0) {
                this.applySwatch(to)
                return (this.presetTid(to))
            }
            return ""
        }
        return ""
    }

    ; Keys a focused FIELD gives to the picker rather than to its caret.
    fn fieldTakes:boolean (target:string key:string) {
        if ((this.fieldIndex(target)) < 0) {
            return false
        }
        if (format == 0) {
            return false
        }
        return ((key == "ArrowUp") || (key == "ArrowDown"))
    }

    ; A press on a button of the picker (not a drag part). Returns the id to
    ; focus, or "".
    fn activate:string (target:string) {
        if (target == (this.triggerTid())) {
            if pop.open {
                return (this.commitClose())
            }
            return (this.openPopover())
        }
        if (target == (this.eyeTid())) {
            this.startPick()
            return target
        }
        if (target == (this.screenTid())) {
            screenAsk = true
            return target
        }
        if (target == (this.fmtTid())) {
            this.cycleFormat(1)
            return target
        }
        def si:int (this.presetIndex(target))
        if (si >= 0) {
            this.applySwatch(si)
            return target
        }
        return ""
    }

    ; =========================================================================
    ; semantics onto the drawn elements
    ; =========================================================================

    fn applyTrigger:void (el:EVGElement) {
        el.id = (this.triggerTid())
        el.role = "button"
        el.a11yLabel = (name + ", " + (this.hex()))
        el.a11yFocusable = true
        el.a11yHasPopup = "dialog"
        if pop.open {
            el.a11yExpanded = (EVGA11yTri.yes())
            el.a11yControls = (this.contentTid())
        } {
            el.a11yExpanded = (EVGA11yTri.no())
        }
    }

    fn applySV:void (el:EVGElement) {
        el.id = (this.svTid())
        el.role = "slider"
        el.a11yLabel = (name + ", saturation and brightness")
        el.a11yRoleDescription = "2D slider"
        el.a11yFocusable = true
        el.a11yHasValue = true
        el.a11yValueNow = (ColorPickerCtl.roundi((sat * 100.0)))
        el.a11yHasRange = true
        el.a11yValueMin = 0
        el.a11yValueMax = 100
        el.a11yValue = (this.svText())
    }

    fn applyHue:void (el:EVGElement) {
        el.id = (this.hueTid())
        el.role = "slider"
        el.a11yLabel = (name + ", hue")
        el.a11yFocusable = true
        el.a11yOrientation = "horizontal"
        el.a11yHasValue = true
        el.a11yValueNow = (ColorPickerCtl.roundi(hue))
        el.a11yHasRange = true
        el.a11yValueMin = 0
        el.a11yValueMax = 360
        el.a11yValue = (this.hueText())
    }

    fn applyAlpha:void (el:EVGElement) {
        el.id = (this.alphaTid())
        el.role = "slider"
        el.a11yLabel = (name + ", alpha")
        el.a11yFocusable = true
        el.a11yOrientation = "horizontal"
        el.a11yHasValue = true
        el.a11yValueNow = (this.alphaPct())
        el.a11yHasRange = true
        el.a11yValueMin = 0
        el.a11yValueMax = 100
        el.a11yValue = (this.alphaText())
    }

    fn formatName:string () {
        if (format == 1) {
            return "RGB"
        }
        if (format == 2) {
            return "HSL"
        }
        return "HEX"
    }

    ; =========================================================================
    ; for checks
    ; =========================================================================

    fn stateJson:string () {
        def out:string "{"
        out = (out + "\"tid\":" + (EVGA11yTree.jsonString(tid)))
        out = (out + ",\"hex\":" + (EVGA11yTree.jsonString((this.hex()))))
        out = (out + ",\"rgb\":" + (EVGA11yTree.jsonString((this.rgbCss()))))
        out = (out + ",\"hsl\":" + (EVGA11yTree.jsonString((this.hslCss()))))
        out = (out + ",\"hsv\":" + (EVGA11yTree.jsonString((this.hsvCss()))))
        out = (out + ",\"h\":" + (to_string hue))
        out = (out + ",\"s\":" + (to_string sat))
        out = (out + ",\"v\":" + (to_string val))
        out = (out + ",\"a\":" + (to_string alpha))
        out = (out + ",\"format\":" + (EVGA11yTree.jsonString((this.formatName()))))
        out = (out + ",\"open\":" + (to_string (this.isOpen())))
        out = (out + ",\"picking\":" + (to_string picking))
        out = (out + ",\"editing\":" + (EVGA11yTree.jsonString(editing)))
        out = (out + ",\"fields\":[")
        def i:int 0
        while (i < (this.fieldCount())) {
            if (i > 0) {
                out = (out + ",")
            }
            def f:InputCtl (this.fieldAt(i))
            out = (out + (EVGA11yTree.jsonString(f.value)))
            i = (i + 1)
        }
        out = (out + "],\"swatches\":[")
        i = 0
        while (i < (array_length swatches)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + (EVGA11yTree.jsonString((itemAt swatches i))))
            i = (i + 1)
        }
        return (out + "]}")
    }
}
