; Node checks for the deck and the timeline: `npm run check`.
Import "PresTimeline.rgr"
Import "PresChartModel.rgr"
Import "PresCascade.rgr"
Import "PresDocSettings.rgr"
Import "PresHints.rgr"
Import "PresFlowModel.rgr"
Import "PresGridModel.rgr"
Import "PresControlsFade.rgr"
Import "PresFollow.rgr"
Import "PresReview.rgr"
Import "PresReviewDot.rgr"
Import "PresPick.rgr"
Import "PresNav.rgr"
Import "PresRecord.rgr"
Import "PresDocx.rgr"
Import "PresHtml.rgr"
Import "PresTrace.rgr"
Import "PresImageDrag.rgr"
Import "PresImageModel.rgr"
Import "../docx_viewer/src/WordMlParser.rgr"

class PresCheck {
    def fails:int 0
    def passes:int 0

    fn ok:void (cond:boolean what:string) {
        if cond {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("FAIL " + what)
        }
    }

    sfn sample:string () {
        return ("---\ntransition: fade\nslide-split-level: 2\n---\n\n"
            + "## Eka {#eka transition=slide seconds=0.4 fx=starfield fx-density=1.6}\n\nJohdanto\n\n"
            + "1. yksi\n2. kaksi\n   jatkuu\n3. kolme\n{.build anim=fly}\n\n"
            + "::: notes\nPuhe ensin. [[1]] Sitten.\n:::\n\n"
            + "## Toka\n\nTeksti\n{anim=zoom}\n\n::: audio src=toka.wav\n:::\n")
    }

    fn run:void () {
        def text:string (PresCheck.sample())
        def src (new PresSource())
        src.read(text)
        this.ok(((strlen src.masked) == (strlen text)) "masking keeps the length")
        this.ok(((indexOf src.masked "notes") < 0) "masking removes the notes fence")
        this.ok(((array_length src.blocks) == 2) "two ::: blocks")
        def nb:PresBlock (itemAt src.blocks 0)
        this.ok((nb.body == "Puhe ensin. [[1]] Sitten.") ("notes body: " + nb.body))

        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 2) ("two slides, got " + (to_string (deck.slideCount()))))
        if ((deck.slideCount()) < 2) {
            return
        }
        def s0:PresSlide (deck.slideAt(0))
        def s1:PresSlide (deck.slideAt(1))
        this.ok((s0.id == "eka") "slide id")
        this.ok((s0.transition == "slide") "slide transition")
        this.ok((s0.fx == "starfield") "slide fx")
        this.ok(((array_length s0.fxNames) == 1) "fx parameter")
        this.ok((s0.steps == 3) ("three build steps, got " + (to_string s0.steps)))
        this.ok((s0.notes == "Puhe ensin. [[1]] Sitten.") ("notes on slide 1: " + s0.notes))
        this.ok((s1.audio == "toka.wav") ("audio on slide 2: " + s1.audio))
        this.ok((s1.transition == "fade") "front matter transition")
        this.ok(((array_length s1.groups) == 1) "an anim block is a group")

        ; Before step 1 the build items are not drawn; after the last they are.
        def early:EVGDisplayList (PresTimeline.frame(deck 0 0.1))
        def late:EVGDisplayList (PresTimeline.frame(deck 0 s0.duration))
        this.ok(((PresCheck.texts(early "yksi")) == 0) "item 1 hidden before its step")
        this.ok(((PresCheck.texts(early "1.")) == 0) "its number hidden with it")
        this.ok(((PresCheck.texts(early "3.")) == 0) "a later number hidden too")
        this.ok(((PresCheck.texts(late "yksi")) == 1) "item 1 shown after its step")
        def one:double ((PresTimeline.stepDone(s0 1)) + 0.05)
        def between:EVGDisplayList (PresTimeline.frame(deck 0 one))
        this.ok(((PresCheck.texts(between "1.")) == 1) "after step 1 its number is there")
        this.ok(((PresCheck.texts(between "2.")) == 0) "but not the next item's number")
        this.ok(((PresCheck.texts(between "kaksi")) == 0) "nor the next item")
        this.ok(((PresCheck.texts(late "3.")) == 1) "the numbers at the end")
        this.ok(((array_length late.fxIds) == 1) "the starfield instance is in the list")
        this.ok(((indexOf (late.toJson()) "\"efx\"") > 0) "a command paints the effect")

        ; The same time gives the same frame, whatever came before.
        def a:string ((PresTimeline.frame(deck 0 1.37)).toJson())
        def b0:string ((PresTimeline.frame(deck 0 3.0)).toJson())
        def b:string ((PresTimeline.frame(deck 0 1.37)).toJson())
        this.ok((a == b) "a frame is a function of its time")
        this.ok((a != b0) "and a different time is a different frame")

        ; Mid-transition the second slide has the first under it.
        def mid:EVGDisplayList (PresTimeline.frame(deck 1 0.2))
        this.ok(((PresCheck.texts(mid "Johdanto")) == 1) "previous slide under a fade")
        this.ok(((PresCheck.texts(mid "Toka")) == 1) "current slide over it")
        def after:EVGDisplayList (PresTimeline.frame(deck 1 2.0))
        this.ok(((PresCheck.texts(after "Johdanto")) == 0) "previous slide gone after the fade")

        this.ok(((PresTimeline.slideAtTime(deck (s0.duration + 0.01))) == 1) "deck time to slide")
        this.ok(((deck.pageOfOffset((indexOf text "Toka"))) == 1) "source offset to slide")
        this.codeSteps()
        this.chartHeaderInk()
        this.tableMissing()
        this.diagram()
        this.bigTitle()
        this.orientation()
        this.chartModel()
        this.review()
        this.reviewDiagram()
    }

    ; ```js {lines=2|3 .build}: the code is there from the start, and each
    ; highlight (a band and a bar at its left) comes at a build step
    fn codeSteps:void () {
        def deck (new PresDeck())
        deck.setText("## Koodi\n\n```js {lines=2|3 .build}\nalpha()\nbeta()\ngamma()\n```\n")
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        this.ok((s.steps == 2) ("code highlights: two steps, got " + (to_string s.steps)))
        def early:EVGDisplayList (PresTimeline.frame(deck 0 0.1))
        def one:EVGDisplayList (PresTimeline.frame(deck 0 ((PresTimeline.stepDone(s 1)) + 0.05)))
        def late:EVGDisplayList (PresTimeline.frame(deck 0 s.duration))
        this.ok(((PresCheck.textsLike(early "gamma")) == 1) "code highlights: the code is there before the steps")
        ; the highlight bar's blue on a light listing
        this.ok(((PresCheck.fills(early 9 105 218)) == 0) "code highlights: none before step 1")
        this.ok(((PresCheck.fills(one 9 105 218)) == 1) "code highlights: one after step 1")
        this.ok(((PresCheck.fills(late 9 105 218)) == 2) "code highlights: both at the end")
    }

    ; Review comments: threads on slides, closing, deleting, the file, two
    ; copies merged, slides found again by title, times.
    fn review:void () {
        ; the pin: a ball centred on its point, pulsing; hidden, it takes no press
        def dot:PresReviewDot (PresReviewDot.make("d" 100.0 200.0 "#d97706"))
        dot.build()
        dot.pose(0.0 1.0)
        def de:EVGElement (unwrap dot.rootEl)
        def s0:double de.width.pixels
        dot.pose(0.9 1.0)
        def s1:double de.width.pixels
        this.ok((((de.overlayX + (s1 / 2.0)) == 100.0) && ((de.overlayY + (s1 / 2.0)) == 200.0)) "review dot: centred on its point")
        this.ok(((s1 > s0) && (dot.pulses())) "review dot: its ring swells as it pulses")
        this.ok(((dot.has(105.0 205.0)) && ((dot.has(130.0 200.0)) == false)) "review dot: a press on the ball")
        dot.pose(0.9 0.0)
        this.ok(((dot.has(100.0 200.0)) == false) "review dot: hidden, no press")
        dot.closed = true
        dot.pose(0.9 1.0)
        this.ok(((dot.pulses()) == false) "review dot: a closed one is still")
        def r (new PresReview())
        def t0:double 1759658400000.0
        this.ok((r.start("a" 2 "Sales" 0.25 0.5 (PresReview.msg("m1" "u1" "Ada" "#ea580c" "  Bigger font  " t0)))) "review: a thread starts with its message")
        this.ok(((r.start("b" 0 "Intro" 1.4 -0.2 (PresReview.msg("m2" "u2" "Bo" "#2563eb" "Typo" (t0 + 1000.0))))) && ((r.count()) == 2)) "review: a second one")
        this.ok(((r.start("a" 1 "X" 0.1 0.1 (PresReview.msg("m3" "u1" "Ada" "" "again" t0)))) == false) "review: an id once")
        this.ok(((r.start("c" 1 "X" 0.1 0.1 (PresReview.msg("m4" "u1" "Ada" "" "   " t0)))) == false) "review: nothing said, no thread")
        def b:PresReviewThread (unwrap (r.find("b")))
        this.ok(((b.x == 1.0) && (b.y == 0.0)) "review: the point stays on the slide")
        def a:PresReviewThread (unwrap (r.find("a")))
        this.ok(((a.firstText()) == "Bigger font") "review: the text trimmed")
        this.ok((r.reply("a" (PresReview.msg("m5" "u2" "Bo" "" "Done?" (t0 + 5000.0))))) "review: a reply")
        this.ok((r.reply("a" (PresReview.msg("m6" "u1" "Ada" "" "Earlier" (t0 + 2000.0))))) "review: another")
        def a2:PresReviewThread (unwrap (r.find("a")))
        def mid:PresReviewMsg (itemAt a2.msgs 1)
        this.ok((((a2.count()) == 3) && (mid.id == "m6")) "review: messages in time order")
        this.ok(((r.reply("a" (PresReview.msg("m5" "u2" "Bo" "" "Done?" (t0 + 5000.0))))) == false) "review: a message once")
        this.ok(((array_length (r.onSlide(2))) == 1) "review: threads of a slide")
        this.ok(((r.remove("a")) == false) "review: an open thread is not deleted")
        this.ok((r.setClosed("a" true "u2" (t0 + 9000.0))) "review: closed")
        this.ok(((r.openCount()) == 1) "review: one open")
        this.ok(((r.reply("a" (PresReview.msg("m7" "u2" "Bo" "" "more" (t0 + 9500.0))))) == false) "review: a closed thread takes no reply")
        this.ok(((r.setClosed("a" true "u2" (t0 + 9600.0))) == false) "review: closed once")
        ; the file and back
        def text:string (r.toJson())
        def back:PresReview (PresReview.parse(text))
        this.ok(((back.count()) == 2) ("review: the file read back: " + text))
        def ba:PresReviewThread (unwrap (back.find("a")))
        this.ok((((ba.slide == 2) && ba.closed) && ((ba.count()) == 3)) "review: slide, state and messages kept")
        this.ok(((indexOf text "\"slide\": 3") >= 0) "review: slides counted from 1 in the file")
        this.ok((ba.state == (t0 + 9000.0)) ("review: times kept whole: " + (to_string ba.state)))
        this.ok(((back.toJson()) == text) "review: the same file again")
        this.ok((((PresReview.parse("not json")).count()) == 0) "review: not a file, nothing")
        ; two copies
        def other:PresReview (PresReview.parse(text))
        other.setClosed("a" false "u3" (t0 + 20000.0))
        other.reply("a" (PresReview.msg("m8" "u3" "Cy" "" "Not yet" (t0 + 21000.0))))
        other.start("d" 0 "Intro" 0.5 0.5 (PresReview.msg("m9" "u3" "Cy" "" "New one" (t0 + 22000.0))))
        this.ok((r.merge(other)) "review: a merge changes")
        def ma:PresReviewThread (unwrap (r.find("a")))
        this.ok((((r.count()) == 3) && ((ma.closed == false) && ((ma.count()) == 4))) "review: united, the later state wins")
        this.ok(((r.merge(other)) == false) "review: the same merge again changes nothing")
        r.setClosed("b" true "u1" (t0 + 30000.0))
        r.remove("b")
        def older:PresReview (PresReview.parse(text))
        r.merge(older)
        this.ok((((r.has("b")) == false) && (r.isGone("b"))) "review: deleted stays deleted")
        other.merge(r)
        this.ok(((other.has("b")) == false) "review: a deletion travels")
        ; slides moved
        def p (new PresReview())
        p.start("s" 1 "Two" 0.5 0.5 (PresReview.msg("x1" "u" "U" "" "hi" t0)))
        p.start("t" 3 "Four" 0.5 0.5 (PresReview.msg("x2" "u" "U" "" "hi" t0)))
        p.place(([] _:string ("One" "New" "Two" "Three" "Four")))
        def ps:PresReviewThread (unwrap (p.find("s")))
        def pt:PresReviewThread (unwrap (p.find("t")))
        this.ok(((ps.slide == 2) && (pt.slide == 4)) "review: a slide added before: found by title")
        p.place(([] _:string ("One" "New" "Two!" "Three" "Four")))
        def ps2:PresReviewThread (unwrap (p.find("s")))
        this.ok(((ps2.slide == 2) && (ps2.title == "Two!")) "review: a renamed slide keeps its comments")
        p.place(([] _:string ("One")))
        def pt2:PresReviewThread (unwrap (p.find("t")))
        this.ok((pt2.slide == 0) "review: past the end, the last slide")
        ; pinned on a diagram: kept in the file, and travels in a merge
        def q (new PresReview())
        q.start("d" 0 "Flow" 0.4 0.4 (PresReview.msg("y1" "u" "U" "" "this box" t0)))
        this.ok(((q.anchor("d" 0 "B" 0.25 0.75)) && ((q.anchor("nope" 0 "B" 0.5 0.5)) == false)) "review: a thread is pinned on a diagram's node")
        def q2:PresReview (PresReview.parse((q.toJson())))
        def qd:PresReviewThread (unwrap (q2.find("d")))
        this.ok(((((qd.dia == 0) && (qd.node == "B")) && (qd.ax == 0.25)) && (qd.ay == 0.75)) ("review: the diagram point is in the file: " + (q.toJson())))
        def q3 (new PresReview())
        q3.start("d" 0 "Flow" 0.4 0.4 (PresReview.msg("y1" "u" "U" "" "this box" t0)))
        q3.merge(q2)
        def q3d:PresReviewThread (unwrap (q3.find("d")))
        this.ok(((q3d.dia == 0) && (q3d.node == "B")) "review: a merge takes the diagram point")
        ; dragged somewhere else: off the diagram, and the latest move wins
        ; a merge (the other copy still has the old point on the diagram)
        this.ok(((q3.move("d" 0.9 1.4 (t0 + 500.0))) && ((q3.move("nope" 0.5 0.5 t0)) == false)) "review: a thread is moved")
        this.ok(((((q3d.x == 0.9) && (q3d.y == 1.0)) && (q3d.dia == -1)) && (q3d.node == "")) "review: a moved thread is off its diagram, inside the slide")
        def q4:PresReview (PresReview.parse((q3.toJson())))
        def q4d:PresReviewThread (unwrap (q4.find("d")))
        this.ok(((q4d.moved == (t0 + 500.0)) && (q4d.x == 0.9)) ("review: the move is in the file: " + (q3.toJson())))
        q2.merge(q4)
        this.ok(((((qd.x == 0.9) && (qd.dia == -1)) && (qd.moved == (t0 + 500.0))) && ((q4.merge(q2)) == false)) "review: a merge takes the newer place, not the old diagram point")
        q4.anchor("d" 1 "C" 0.5 0.5)
        q2.merge(q4)
        this.ok(((qd.dia == 1) && (qd.node == "C")) "review: dropped on another diagram's box, the merge takes it")
        q2.move("d" 0.1 0.1 (t0 + 900.0))
        q4.move("d" 0.7 0.7 (t0 + 600.0))
        q2.merge(q4)
        this.ok(((qd.x == 0.1) && (qd.y == 0.1)) "review: an older move does not win a merge")
        ; as text to copy: one thread, and the open ones with their slides
        def cp (new PresReview())
        def nl:string (strfromcode 10)
        cp.start("b" 2 "Three" 0.42 0.3 (PresReview.msg("b1" "u" "Ann" "" "Bigger font" t0)))
        cp.reply("b" (PresReview.msg("b2" "v" "Bob" "" ("Agreed" + nl + "and bold") t0)))
        cp.start("a" 0 "One" 0.5 0.5 (PresReview.msg("a1" "u" "Ann" "" "Logo here" t0)))
        cp.anchor("a" 0 "B" 0.5 0.5)
        cp.start("z" 1 "Two" 0.5 0.5 (PresReview.msg("z1" "u" "Ann" "" "done" t0)))
        cp.setClosed("z" true "u" t0)
        def tts:[string] (([] _:string ("One" "Two" "Three")))
        def one:string (cp.threadText("b" tts))
        this.ok((one == ("Slide 3 · Three, at 42 % across, 30 % down" + nl + "Ann: Bigger font" + nl + "Bob: Agreed" + nl + "  and bold" + nl)) ("review: a thread as text: " + one))
        def md:string (cp.openMarkdown("Deck" tts (([] _:string ("# One" "# Two" ("# Three" + nl + "```js" + nl + "x" + nl + "```"))))))
        this.ok(((indexOf md "2 open comments on 2 slides") > 0) ("review: open comments counted: " + md))
        this.ok((((indexOf md "## Slide 1 · One") < (indexOf md "## Slide 3 · Three")) && ((indexOf md "[1] at 50 % across, 50 % down, on the diagram's box \"B\"") > 0)) ("review: numbered in slide order: " + md))
        this.ok((((indexOf md "[2] at 42 %") > 0) && ((indexOf md "done") < 0)) "review: resolved ones are left out")
        this.ok(((indexOf md ("````markdown" + nl + "# Three" + nl + "```js")) > 0) ("review: the slide's Markdown in a fence longer than its own: " + md))
        this.ok(((indexOf md "# Two") < 0) "review: a slide without open comments is left out")
        def deckSrc:string ("Intro text" + nl + nl + "# One" + nl + nl + "a" + nl + "# Two" + nl + "# Three" + nl + "b")
        def wc:string (cp.markdownWithComments(deckSrc (([] _:int (12 21 27))) tts false))
        this.ok(((indexOf wc ("Intro text" + nl + nl + "# One [^1]" + nl + nl + "a" + nl + "# Two" + nl + "# Three [^2]" + nl + "b" + nl + nl + "[^1]: Slide 1 · One, at 50 % across, 50 % down, on the diagram's box \"B\"" + nl + "    Ann: Logo here" + nl + "[^2]: Slide 3 · Three, at 42 % across")) == 0) ("review: with comments, marks on the headings and notes at the end: " + wc))
        this.ok(((indexOf wc "done") < 0) "review: with comments, resolved ones are left out")
        def wc2:string (cp.markdownWithComments(("```js" + nl + "x" + nl + "```" + nl) (([] _:int (0 0 0))) tts false))
        this.ok(((indexOf wc2 ("[^1][^2]" + nl + nl + "```js")) == 0) ("review: with comments, no heading: the marks on a line above: " + wc2))
        def wc3:string (cp.markdownWithComments(("# Three" + nl + "b" + nl) (([] _:int (-1 -1 0))) tts true))
        this.ok((wc3 == ("# Three [^1]" + nl + "b" + nl + nl + "[^1]: Slide 3 · Three, at 42 % across, 30 % down" + nl + "    Ann: Bigger font" + nl + "    Bob: Agreed" + nl + "      and bold" + nl)) ("review: with comments, some slides: only theirs, numbered from 1: " + wc3))
        ; times
        def now:double 1759658400000.0
        this.ok(((PresReview.timeText(now now 180)) == "13:00") ("review: today, the clock: " + (PresReview.timeText(now now 180))))
        this.ok(((PresReview.timeText((now - 86400000.0) now 180)) == "4.10. 13:00") ("review: this year, the date: " + (PresReview.timeText((now - 86400000.0) now 180))))
        this.ok(((PresReview.timeText((now - (400.0 * 86400000.0)) now 0)) == "31.8.2024 10:00") ("review: before, the year: " + (PresReview.timeText((now - (400.0 * 86400000.0)) now 0))))
    }

    ; A comment on a diagram is a point of the diagram: when the camera
    ; zooms, the point moves with what it is on (it stayed put on the
    ; screen, over another box), and leaves the view with it.
    fn reviewDiagram:void () {
        def deck (new PresDeck())
        deck.md.setStyleSheet("page { width: 13.333in; height: 7.5in; padding: 0.6in } deck { split-level: 2 }")
        deck.setText("## Flow\n\n```mermaid\nflowchart LR\n  A[Start] --> B[Middle]\n  B --> C[End]\n```\n")
        def hit@(optional):PresDiaUse (deck.diagramUse(0 0))
        if (null? hit) {
            this.ok(false "review on a diagram: the slide has its diagram")
            return
        }
        def u:PresDiaUse (unwrap hit)
        def d:PresDiagram u.diagram
        def t:double 1000000.0
        def p1:[double]
        def seen1:boolean (d.anchorPoint(t u.bx u.by u.bw u.bh "B" 0.5 0.5 p1))
        this.ok((seen1 && ((array_length p1) == 2)) "review on a diagram: a node's point is in view")
        def a:[double] (d.anchorAt(t u.bx u.by u.bw u.bh (itemAt p1 0) (itemAt p1 1)))
        def on:string (d.nodeIdAt((floor (itemAt a 0))))
        this.ok((((on == "B") && ((fabs ((itemAt a 1) - 0.5)) < 0.01)) && ((fabs ((itemAt a 2) - 0.5)) < 0.01)) ("review on a diagram: the point under it is the node's, got " + on))
        ; the viewer zooms in on the first box
        def a0:[double]
        d.anchorPoint(t u.bx u.by u.bw u.bh "A" 0.5 0.5 a0)
        d.uiNow = 100.0
        d.explore(0)
        d.uiNow = 200.0
        def p2:[double]
        def seen2:boolean (d.anchorPoint(t u.bx u.by u.bw u.bh "B" 0.5 0.5 p2))
        def pA:[double]
        d.anchorPoint(t u.bx u.by u.bw u.bh "A" 0.5 0.5 pA)
        def moved:double ((fabs ((itemAt p2 0) - (itemAt p1 0))) + (fabs ((itemAt p2 1) - (itemAt p1 1))))
        this.ok((moved > 20.0) ("review on a diagram: zoomed, the point moves with its box, moved " + (to_string moved)))
        def a2:[double] (d.anchorAt(t u.bx u.by u.bw u.bh (itemAt pA 0) (itemAt pA 1)))
        this.ok(((d.nodeIdAt((floor (itemAt a2 0)))) == "A") "review on a diagram: zoomed, the point under the first box is still that box's")
        def far:[double]
        def seenFar:boolean (d.anchorPoint(t u.bx u.by u.bw u.bh "C" 0.5 0.5 far))
        this.ok((seenFar == false) "review on a diagram: a box the camera left is out of view")
        def gone:[double]
        this.ok((((d.anchorPoint(t u.bx u.by u.bw u.bh "Z" 0.5 0.5 gone)) == false) && ((array_length gone) == 0)) "review on a diagram: a box no longer there has no point")
    }

    ; A title set large enough to wrap keeps the diagram under it on its own
    ; slide: no second slide with the title said again.
    fn bigTitle:void () {
        def text:string "---\nslide-split-level: 2\n---\n\n## Keskilämpötila kuukausittain\n\n```mermaid\nflowchart LR\n  A[Kokous] --> B[Selain]\n  B --> C[Gemini]\n```\n"
        def deck (new PresDeck())
        def chart:string "---\nslide-split-level: 2\n---\n\n## Keskilämpötila kuukausittain\n\n```vega-lite\n{\"width\": 900, \"height\": 380, \"data\": {\"values\": [{\"k\": \"Tammi\", \"v\": -3.1}, {\"k\": \"Helmi\", \"v\": -3.8}, {\"k\": \"Maalis\", \"v\": -0.7}]}, \"mark\": \"line\", \"encoding\": {\"x\": {\"field\": \"k\", \"type\": \"nominal\"}, \"y\": {\"field\": \"v\", \"type\": \"quantitative\"}}}\n```\n"
        deck.md.setStyleSheet("page { width: 13.333in; height: 7.5in; padding: 0.6in } deck { split-level: 2 } h2 { font-size: 80pt }")
        deck.setText(chart)
        this.ok(((deck.slideCount()) == 1) ("a big title and its chart are one slide, got " + (to_string (deck.slideCount()))))
        deck.setText(text)
        this.ok(((deck.slideCount()) == 1) ("a big title and its diagram are one slide, got " + (to_string (deck.slideCount()))))
        deck.md.setStyleSheet("page { width: 13.333in; height: 7.5in; padding: 0.6in } deck { split-level: 2 } h2 { font-size: 160pt }")
        deck.setText(text)
        this.ok(((deck.slideCount()) == 1) ("a title taller than the slide is set smaller, got " + (to_string (deck.slideCount()))))
    }

    ; `orientation:` turns the page the deck has without it either way: a
    ; landscape theme to portrait, and a portrait one (`page:` or the theme's
    ; CSS) to landscape. Changing `page:` under it measures the page again.
    fn orientation:void () {
        def deck (new PresDeck())
        deck.md.setStyleSheet("page { width: 13.333in; height: 7.5in; padding: 0.6in } deck { split-level: 2 }")
        def body:string "\n---\n\n## Yksi\n\nTeksti\n"
        deck.setText(("---" + body))
        this.ok(((deck.pageW > deck.pageH) && (deck.themeTall == false)) "a landscape theme is landscape")
        deck.setText(("---\norientation: portrait" + body))
        this.ok((deck.pageH > deck.pageW) "orientation: portrait turns a landscape theme")
        deck.setText(("---\norientation: landscape" + body))
        this.ok((deck.pageW > deck.pageH) "orientation: landscape keeps a landscape theme")
        deck.setText(("---\npage: a4 portrait" + body))
        this.ok(((deck.pageH > deck.pageW) && deck.themeTall) "page: a4 portrait is portrait")
        deck.setText(("---\npage: a4 portrait\norientation: landscape" + body))
        this.ok((deck.pageW > deck.pageH) "orientation: landscape turns a portrait page")
        deck.setText(("---\npage: a4 portrait\norientation: portrait" + body))
        this.ok((deck.pageH > deck.pageW) "orientation: portrait keeps a portrait page")
        deck.setText(("---\npage: a4 landscape\norientation: portrait" + body))
        this.ok((deck.pageH > deck.pageW) "a changed page: is measured again under orientation")
        deck.md.setStyleSheet("page { width: 7.5in; height: 13.333in; padding: 0.6in } deck { split-level: 2 }")
        deck.setText(("---\norientation: landscape" + body))
        this.ok((deck.pageW > deck.pageH) ("orientation: landscape turns a portrait theme: " + (to_string deck.pageW)))
    }

    ; The chart editor's model: a fence read as a table and written back.
    fn chartModel:void () {
        ; wide rows: a category and two measures
        def wide:string "{\"width\": 400, \"data\": {\"values\": [{\"q\": \"Q1\", \"a\": 3, \"b\": 5}, {\"q\": \"Q2\", \"a\": 4, \"b\": 1}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"q\", \"type\": \"nominal\"}, \"y\": {\"field\": \"a\", \"type\": \"quantitative\", \"title\": \"Määrä\"}}}"
        def m:PresChartModel (PresChartModel.fromSpec(wide))
        this.ok(m.ok ("a bar chart reads as a table: " + m.note))
        this.ok(((m.cols()) == 2) ("category and one measure, got " + (to_string (m.cols()))))
        this.ok(((m.rows()) == 2) "two rows")
        this.ok(((m.cell(1 1)) == "4") ("the value of Q2: " + (m.cell(1 1))))
        this.ok((m.kind == 1) "columns")
        this.ok((m.width == 400) "its width kept")
        ; the long form a colour splits: pivoted into a column per series
        def long:string "{\"data\": {\"values\": [{\"k\": \"x\", \"s\": \"A\", \"v\": 1}, {\"k\": \"x\", \"s\": \"B\", \"v\": 2}, {\"k\": \"y\", \"s\": \"A\", \"v\": 3}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"k\", \"type\": \"nominal\"}, \"y\": {\"field\": \"v\", \"type\": \"quantitative\", \"aggregate\": \"sum\"}, \"color\": {\"field\": \"s\"}}}"
        def l:PresChartModel (PresChartModel.fromSpec(long))
        this.ok(((l.cols()) == 3) ("two series as columns, got " + (to_string (l.cols()))))
        this.ok((l.kind == 3) "stacked, as Vega-Lite stacks a coloured bar")
        this.ok(((l.cell(1 2)) == "") "a missing pair is an empty cell")
        ; a pie
        def pie:string "{\"data\": {\"values\": [{\"c\": \"a\", \"n\": 2}, {\"c\": \"b\", \"n\": 3}]}, \"mark\": {\"type\": \"arc\", \"innerRadius\": 30}, \"encoding\": {\"theta\": {\"field\": \"n\", \"type\": \"quantitative\"}, \"color\": {\"field\": \"c\"}}}"
        def pm:PresChartModel (PresChartModel.fromSpec(pie))
        this.ok((pm.ok && (pm.kind == 17)) "a donut is a donut")
        ; written back, and read again as the same table
        l.kind = 6
        l.title = "Otsikko"
        def out:string (l.toSpec())
        this.ok(((indexOf out "\"mark\": \"line\"") >= 0) ("a line spec: " + out))
        this.ok(((indexOf out "\"config\"") < 0) "no spreadsheet palette on a slide")
        def back:PresChartModel (PresChartModel.fromSpec(out))
        this.ok((back.ok && ((back.kind == 6) && ((back.cols()) == 3))) ("read back: kind " + (to_string back.kind) + " cols " + (to_string (back.cols())) + " " + back.note))
        this.ok(((back.cell(0 2)) == "2") ("the B of x survives: " + (back.cell(0 2))))
        this.ok((back.title == "Otsikko") "and its title")
        ; what cannot be a table is edited for its look alone, and says why
        def layered:PresChartModel (PresChartModel.fromSpec("{\"layer\": []}"))
        this.ok(((layered.ok && layered.lookOnly) && ((strlen layered.why) > 0)) "a layered chart opens for its look, with the reason")
        def fromFile:string "{\"data\": {\"url\": \"data/cars.json\"}, \"transform\": [{\"filter\": \"datum.x > 1\"}], \"mark\": \"point\", \"encoding\": {\"x\": {\"field\": \"a\", \"type\": \"quantitative\"}, \"color\": {\"field\": \"o\", \"type\": \"nominal\"}}, \"config\": {\"axis\": {\"grid\": false}}}"
        def fm:PresChartModel (PresChartModel.fromSpec(fromFile))
        this.ok((fm.lookOnly && (fm.dataFile == "data/cars.json")) ("a chart reading a file opens for its look: " + fm.dataFile))
        fm.title = "Autot"
        fm.width = 500
        fm.scheme = "tableau10"
        fm.textColor = "#334455"
        fm.legend = false
        fm.effect = "neon"
        def fout:string (fm.toSpec())
        def fback:PresChartModel (PresChartModel.fromSpec(fout))
        this.ok((((indexOf fout "data/cars.json") > 0) && ((indexOf fout "datum.x > 1") > 0)) "its data and transform are kept as they were")
        this.ok(((indexOf fout "\"grid\":false") > 0) "and its own config")
        this.ok(((((fback.title == "Autot") && (fback.width == 500)) && ((fback.scheme == "tableau10") && (fback.textColor == "#334455"))) && ((fback.legend == false) && (fback.effect == "neon"))) ("the look is written onto it: " + fout))
        this.ok((((l.suits(16)) == false) && (pm.suits(16))) "a pie wants exactly one series")
        ; the look, written and read back
        l.color = "#ff00aa"
        l.textColor = "#ffffff"
        l.strokeWidth = 4.0
        l.effect = "neon"
        l.glow = true
        l.gradient = true
        def styled:PresChartModel (PresChartModel.fromSpec((l.toSpec())))
        this.ok(((styled.color == "#ff00aa") && (styled.textColor == "#ffffff")) ("colours survive: " + styled.color + " " + styled.textColor))
        this.ok((((styled.strokeWidth == 4.0) && (styled.effect == "neon")) && (styled.glow && (styled.gradient && (styled.shadow == false)))) "line width, stage style and effects survive")
        ; a scheme on one series of bars colours each bar
        def one:PresChartModel (PresChartModel.fromSpec(wide))
        one.scheme = "category10"
        def byCat:string (one.toSpec())
        this.ok((((indexOf byCat "\"scheme\":\"category10\"") > 0) && ((indexOf byCat "\"color\": {\"field\":\"cat\"") > 0)) ("one series by category: " + byCat))
        def back1:PresChartModel (PresChartModel.fromSpec(byCat))
        this.ok((((back1.cols()) == 2) && (back1.scheme == "category10")) "…and reads back as one series")
    }

    ; A flowchart is drawn and toured rather than pasted in as a picture.
    fn diagram:void () {
        def text:string "---\nslide-split-level: 2\n---\n\n## Kulku\n\n```mermaid\nflowchart LR\n  A[Kokous] --> B[Selain]\n  B --> C[Gemini]\n  C --> B\n  B --> A\n```\n{choose=off tour=on}\n"
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 1) "one diagram slide")
        def s:PresSlide (deck.slideAt(0))
        this.ok(((array_length s.diagrams) == 1) "the fence is a toured diagram")
        if ((array_length s.diagrams) == 0) {
            return
        }
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        this.ok(((array_length d.nodes) == 3) ("three nodes, got " + (to_string (array_length d.nodes))))
        this.ok(((array_length d.edges) == 4) ("four edges, got " + (to_string (array_length d.edges))))
        this.ok(((array_length d.legs) >= 4) "a leg per edge")
        this.ok((s.duration > d.total) "the slide lasts until the tour is over")
        def e0:PresDEdge (itemAt d.edges 0)
        def na:PresDNode (itemAt d.nodes e0.from)
        this.ok((na.id == "A") ("the first edge leaves A, got " + na.id))
        ; nothing at the start, the nodes by the end of the reveal
        def early:EVGDisplayList (PresTimeline.frame(deck 0 0.0))
        this.ok(((PresCheck.texts(early "Gemini")) == 0) "a node is not there before it pops in")
        def shown:EVGDisplayList (PresTimeline.frame(deck 0 (d.revealEnd + 0.1)))
        this.ok(((PresCheck.texts(shown "Gemini")) == 1) "and is there after the reveal")
        ; in the middle of the tour the camera is in and the ball is out
        def l1:PresLeg (itemAt d.legs 1)
        def mid:double ((l1.t0 + (l1.dur * 0.5)) + (itemAt s.diagrams 0).start)
        d.cameraAt((l1.t0 + l1.dur) 800.0 400.0)
        def zIn:double d.camZ
        this.ok((zIn > 1.5) ("the camera is in on the node it lands on, z=" + (to_string zIn)))
        d.cameraAt((l1.t0 + (l1.dur * 0.5)) 800.0 400.0)
        this.ok((d.camZ <= zIn) "and backs off on the way, to keep both ends in view")
        ; on a keyframe the camera is centred on the node it stands on
        def l0:PresLeg (itemAt d.legs 0)
        d.cameraAt((l0.t0 + l0.dur) 800.0 400.0)
        def lands:PresDNode (itemAt d.nodes l0.toNode)
        this.ok(((fabs (d.camX - (lands.cx()))) < 0.01) "the camera is centred on the node the packet lands on")
        def a:string ((PresTimeline.frame(deck 0 mid)).toJson())
        def b:string ((PresTimeline.frame(deck 0 mid)).toJson())
        this.ok((a == b) "a toured frame is a function of its time")
        this.ok(((indexOf a "\"gd\"") > 0) "the ball and the rim fade are gradients")
        def fin:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        d.cameraAt(s.duration 800.0 400.0)
        this.ok((d.camZ == 1.0) "the camera is back out at the end")
        this.ok(((PresCheck.texts(fin "Kokous")) == 1) "the final frame shows the whole diagram")
        this.longChain()
        this.portraitChain()
        this.diagramLooks()
        this.diagramLookHint()
        this.steering()
        this.diagramColour()
        this.diagramLabels()
    }

    ; Line names on a crowded ER diagram (a box with a line to itself and
    ; five out of one side, two boxes each joined to two others): every name
    ; is drawn, on no other name, with no other line through it, and the
    ; line to itself does not pass through its own box. A flowchart with a
    ; loop among three lines out of one box: every name drawn, none on
    ; another.
    fn diagramLabels:void () {
        this.ok((PresDiagram.segInRect(0.0 5.0 10.0 5.0 2.0 2.0 4.0 4.0)) "a segment across a box meets it")
        this.ok(((PresDiagram.segInRect(0.0 9.0 10.0 9.0 2.0 2.0 4.0 4.0)) == false) "a segment below a box misses it")
        this.ok((PresDiagram.segInRect(4.0 0.0 4.0 20.0 2.0 2.0 4.0 4.0)) "an upright segment through a box meets it")
        def er:string ("erDiagram\n  CONTAINER ||--o{ CONTAINER : parent\n  CONTAINER ||--o{ DECK_LINK : sisaltaa\n"
            + "  DECK ||--o{ DECK_LINK : kuuluu\n  CONTAINER ||--o{ FILE_REF : files\n  DECK ||--o{ FILE_REF : files\n"
            + "  FILE_REF }o--|| BLOB : osoittaa\n  CONTAINER ||--o{ LINK : viittaa\n  CONTAINER ||--o| EXT_REF : master\n")
        this.labelsClear(er "er" true)
        def fl:string ("flowchart LR\n  A[Request] -->|valid| B[Process]\n  A -->|invalid| C[Reject]\n  B -->|ok| D[Store]\n"
            + "  B -->|retry| B\n  D -->|notify| E[Mail]\n  C -->|log| E\n  B -->|error| C\n")
        ; set in a column on this slide, the loop's name has no stretch
        ; clear of the line passing it: names apart is what holds there
        this.labelsClear(fl "flowchart" false)
    }

    fn labelsClear:void (src:string what:string lines:boolean) {
        def text:string ("---\nslide-split-level: 2\n---\n\n## Malli\n\n```mermaid\n" + src + "```\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        if ((array_length s.diagrams) == 0) {
            this.ok(false (what + " labels: the diagram is there"))
            return
        }
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        def fin:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        def named:int 0
        def i:int 0
        while (i < (array_length d.edges)) {
            def e:PresDEdge (itemAt d.edges i)
            if (e.lw > 0.0) {
                named = (named + 1)
                def j:int 0
                while (j < (array_length d.edges)) {
                    def o:PresDEdge (itemAt d.edges j)
                    if (j != i) {
                        if ((o.lw > 0.0) && ((((e.lx < (o.lx + o.lw)) && ((e.lx + e.lw) > o.lx)) && (e.ly < (o.ly + o.lh))) && ((e.ly + e.lh) > o.ly))) {
                            this.ok(false (what + " labels: " + e.id + " lies on " + o.id))
                        }
                        if (lines && (PresDiagram.lineInRect(o.line e.lx e.ly e.lw e.lh))) {
                            this.ok(false (what + " labels: the line " + o.id + " (" + (itemAt (PresDiagram.labelLines(o)) 0) + ") runs through the name of " + e.id + " " + (itemAt (PresDiagram.labelLines(e)) 0) + " (tier " + (to_string e.pTier) + " at " + (to_string e.lx) + "," + (to_string e.ly) + " " + (to_string e.lw) + "x" + (to_string e.lh) + ")"))
                        }
                    }
                    j = (j + 1)
                }
            }
            if (e.from == e.to) {
                def n:PresDNode (itemAt d.nodes e.from)
                ; its own box, a little in from the edges the line leaves by
                this.ok(((PresDiagram.lineInRect(e.line (n.x + 4.0) (n.y + 4.0) (n.w - 8.0) (n.h - 8.0))) == false) (what + " labels: the line from " + n.id + " to itself goes round it, not through it"))
            }
            i = (i + 1)
        }
        this.ok((named >= 7) (what + " labels: every line's name is drawn, got " + (to_string named)))
    }

    ; `diagram { color }` is the warm light: without a tour it colours the
    ; lines (with one it marks the way the walk is on).
    fn diagramColour:void () {
        def css:string "page { background-color: #0b1030 } diagram { color: #ff6b9a; accent-color: #ffd54a }"
        def still:string "---\nslide-split-level: 2\n---\n\n## Kulku\n\n```mermaid\nflowchart LR\n  A[Alku] --> B[Loppu]\n```\n"
        def deck (new PresDeck())
        deck.md.setStyleSheet(css)
        deck.setTheme(css)
        deck.setText(still)
        PresTimeline.planAll(deck)
        def warm:int (PresCheck.colourCmds((PresTimeline.finalFrame(deck 0)) 255 107 154))
        this.ok((warm >= 2) ("without a tour the line and its arrow are in diagram color, got " + (to_string warm)))
    }

    sfn colourCmds:int (l:EVGDisplayList r:int g:int b:int) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if (((c.r == r) && (c.g == g)) && (c.b == b)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; A walk the viewer steers: it stops where named edges branch, shows the
    ; ways on, takes the one picked, and goes back a step on request.
    fn steering:void () {
        def text:string ("---\nslide-split-level: 2\npage: a4 landscape\n---\n\n## Polku\n\n```mermaid\nflowchart LR\n"
            + "  A[Alku] --> B{Valitse}\n  B -->|Vasen| C[Vasen tie]\n  B -->|Oikea| D[Oikea tie]\n"
            + "  C --> E[Loppu]\n  D --> E\n  E --> F[Ohi]\n  E --> G[Myös]\n```\n{tour=on}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        if ((array_length s.diagrams) == 0) {
            this.ok(false "the steered diagram is there")
            return
        }
        def u:PresDiaUse (itemAt s.diagrams 0)
        def d:PresDiagram u.diagram
        this.ok(d.waiting "the walk stops at the named branch")
        this.ok(((array_length d.options) == 2) ("two ways on, got " + (to_string (array_length d.options))))
        def bn:PresDNode (itemAt d.nodes d.waitNode)
        this.ok((bn.id == "B") ("waiting at B, got " + bn.id))
        def hold:double (deck.diagramHold(0))
        this.ok((hold > 0.0) "the slide holds the clock there")
        this.ok((d.total < (d.waitAt + 1.5)) "and the diagram's own time ends at the question")
        def asked:EVGDisplayList (PresTimeline.frame(deck 0 (hold + 0.2)))
        this.ok(((PresCheck.texts(asked "Vasen")) >= 1) "the first way on is shown with its name")
        this.ok(((PresCheck.texts(asked "1")) >= 1) "…and its number, apart from the name")
        this.ok(((PresCheck.texts(asked "1  Vasen")) == 0) "not run into the name")
        this.ok(((PresCheck.texts(asked "Vasen tie")) == 1) "the node it leads to is shown as a ghost")
        ; a press inside the second option's box picks it
        def lt:double ((hold + 0.2) - u.start)
        d.cameraAt(lt u.bw u.bh)
        d.optionRect(1)
        def sc:double ((d.fitOf(u.bw u.bh)) * d.camZ)
        def dx:double ((u.bx + (u.bw * 0.5)) - (d.camX * sc))
        def dy:double ((u.by + (u.bh * 0.5)) - (d.camY * sc))
        def px:double (((d.rX + (d.rW * 0.5)) * sc) + dx)
        def py:double (((d.rY + (d.rH * 0.5)) * sc) + dy)
        def code:string (deck.diagramHit(0 (hold + 0.2) px py))
        this.ok((code == "0:1") ("a press on the second option hits it: " + code))
        d.moveSel(1)
        this.ok((d.optSel == 1) "the keys move the highlight")
        this.ok((d.pick(0)) "picking the first way on")
        PresTimeline.plan(s)
        this.ok(((array_length d.choices) == 1) "one choice made")
        def seenC:boolean false
        def seenD:boolean false
        def i:int 0
        while (i < (array_length d.nodes)) {
            def n:PresDNode (itemAt d.nodes i)
            if ((n.id == "C") && (n.at < d.tourEnd)) {
                seenC = true
            }
            if ((n.id == "D") && (n.at < (d.tourEnd - 0.5))) {
                seenD = true
            }
            i = (i + 1)
        }
        this.ok(seenC "the walk goes the chosen way")
        this.ok((! seenD) "and not the other")
        this.ok((! d.waiting) "unnamed branches (E) do not stop it")
        ; back from the chosen node: to B, and the choice is undone
        def atC:double (itemAt d.stepT 2)
        def to:double (d.back((atC + 0.1)))
        this.ok(((array_length d.choices) == 0) "going back undoes the choice")
        this.ok(d.waiting "and the question is asked again")
        this.ok((to < atC) "going back goes back in time")
        def bb:PresDNode (d.nodeNamed("B"))
        this.ok((to >= (bb.at + 0.6)) ("and lands where the node has finished arriving: " + (to_string to) + " vs " + (to_string bb.at)))
        this.sameTarget()
    }

    ; Two named ways to the same node are two choices in two places.
    fn sameTarget:void () {
        def text:string ("---\nslide-split-level: 2\npage: a4 landscape\n---\n\n## Sama\n\n```mermaid\nflowchart TB\n"
            + "  A[Uusi projekti] --> B{Kuka tietää?}\n  B -->|Minä ehkä| C[Avaa README]\n  B -->|Ei kukaan| C\n  C --> D[Loppu]\n```\n{tour=on}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        ; a tall diagram may go on to the next slide: find it
        def si:int 0
        def at:int -1
        while (si < (deck.slideCount())) {
            def sl:PresSlide (deck.slideAt(si))
            if ((array_length sl.diagrams) > 0) {
                at = si
            }
            si = (si + 1)
        }
        if (at < 0) {
            this.ok(false "the diagram is there")
            return
        }
        def s:PresSlide (deck.slideAt(at))
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        this.ok((d.waiting && ((array_length d.options) == 2)) "two ways to one node are asked about")
        if ((array_length d.pillX) < 2) {
            return
        }
        def ax:double (itemAt d.pillX 0)
        def ay:double (itemAt d.pillY 0)
        def bx:double (itemAt d.pillX 1)
        def by:double (itemAt d.pillY 1)
        def sepX:boolean (((ax + (itemAt d.pillW 0)) <= bx) || ((bx + (itemAt d.pillW 1)) <= ax))
        def sepY:boolean (((ay + (itemAt d.pillH 0)) <= by) || ((by + (itemAt d.pillH 1)) <= ay))
        this.ok((sepX || sepY) "their choices do not overlap")
        def c:PresDNode (d.nodeNamed("C"))
        def onNode:boolean (((ay >= c.y) && (ay <= (c.y + c.h))) && ((ax >= c.x) && (ax <= (c.x + c.w))))
        this.ok((! onNode) "and sit on the edges, not on the node they lead to")
        ; …close to the box they leave
        def bq:PresDNode (d.nodeNamed("B"))
        def k0:int 0
        while (k0 < 2) {
            def gapY:double ((itemAt d.pillY k0) - (bq.y + bq.h))
            this.ok(((gapY >= -1.0) && (gapY < 60.0)) ("choice " + (to_string (k0 + 1)) + " sits just under the question box: " + (to_string gapY)))
            k0 = (k0 + 1)
        }
        ; each way on points at its own pill: on the line, or by a leader from beside it
        def k:int 0
        while (k < 2) {
            def e:PresDEdge (itemAt d.edges (itemAt d.options k))
            def gap:double (PresDiagram.distanceTo(e.line (itemAt d.pillLx k) (itemAt d.pillLy k)))
            this.ok((gap < 3.0) ("way " + (to_string (k + 1)) + " is pointed at from its choice"))
            k = (k + 1)
        }
    }

    ; `{style=mermaid|jurassic|cartoon|romantic}`: RangerFlow's looks. The
    ; deck asks the page for their faces, a round node is drawn as the look's
    ; round part (jurassic: an ochre circle), the lines keep their right
    ; angles, words are set in capitals where the look says so, and until a
    ; face is loaded the words are in Open Sans.
    ; Over a diagram fence's language word the card offers the looks; a look
    ; changes only the block's settings line.
    fn diagramLookHint:void () {
        def j:string (PresHints.forLine("md" "```mermaid {tour=on}" 5 false))
        this.ok(((indexOf j "\"looks\":[\"holo\",\"sketch\",\"classic\",\"mermaid\",\"jurassic\",\"cartoon\",\"romantic\"]") >= 0) ("a diagram's fence offers its looks: " + j))
        this.ok(((indexOf j "\"options\":[]") >= 0) ("…and no notations to switch to: " + j))
        def code:string (PresHints.forLine("md" "```python" 5 false))
        this.ok(((indexOf code "looks") < 0) "a code fence has no looks")
        def body:string "flowchart LR\n  A --> B\n```\n"
        ; settings in the fence line: the style word set there, the rest kept
        def m1:PresFlowModel (PresFlowModel.read(("```mermaid {tour=on}\n" + body)))
        this.ok(((m1.lookLineAt()) == 0) "settings in the fence: its line")
        this.ok(((m1.lookLine("cartoon")) == "```mermaid {tour=on style=cartoon}") ("cartoon added: " + (m1.lookLine("cartoon"))))
        def m1b:PresFlowModel (PresFlowModel.read(("```mermaid {style=jurassic}\n" + body)))
        this.ok(((m1b.lookLine("holo")) == "```mermaid") ("holo drops the braces: " + (m1b.lookLine("holo"))))
        def m1c:PresFlowModel (PresFlowModel.read(("```mermaid {style=jurassic}\n" + body)))
        this.ok(((m1c.lookLine("classic")) == "```mermaid {diagram=classic}") ("classic: " + (m1c.lookLine("classic"))))
        ; no settings yet: braces on the fence line
        def m2:PresFlowModel (PresFlowModel.read(("```dot\n" + body)))
        this.ok(((m2.lookLine("romantic")) == "```dot {style=romantic}") ("braces added: " + (m2.lookLine("romantic"))))
        ; settings under the block: that line
        def m3:PresFlowModel (PresFlowModel.read(("```mermaid\n" + body + "{style=sketch tour=on}\n")))
        this.ok(((m3.lookLineAt()) == 4) ("the settings line under the block: " + (to_string (m3.lookLineAt()))))
        this.ok(((m3.lookLine("mermaid")) == "{style=mermaid tour=on}") ("set in its place: " + (m3.lookLine("mermaid"))))
        ; the braces on the fence line are the block's settings too
        def deck (new PresDeck())
        deck.setText(("## A\n\n```mermaid {style=cartoon}\n" + body))
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        if ((array_length s.diagrams) == 0) {
            this.ok(false "the fence with braces is a diagram")
            return
        }
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        this.ok((d.looked && (d.style == "cartoon")) ("a look in the fence's braces is drawn: " + d.style))
    }

    fn diagramLooks:void () {
        def text:string ("---\nslide-split-level: 2\n---\n\n## Kuva\n\n```mermaid\nflowchart LR\n"
            + "  A((Alku)) --> B[Tilaus]\n  B --> C{Varastossa?}\n  C -->|kyllä| D[Lähetä]\n  C -->|ei| E([Odota])\n```\n{style=jurassic}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        if ((array_length s.diagrams) == 0) {
            this.ok(false "a jurassic diagram is a diagram")
            return
        }
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        this.ok((d.looked && (d.style == "jurassic")) ("the look is jurassic: " + d.style))
        this.ok(((indexOf deck.wantFaces "Josefin Sans-Bold") >= 0) ("its face is asked for: " + deck.wantFaces))
        def kinds:string (join d.kinds ",")
        this.ok(((indexOf kinds "decision") >= 0) ("the question is a decision: " + kinds))
        this.ok(((indexOf kinds "start") >= 0) ("the circle nothing points at is the start: " + kinds))
        ; every line is made of runs at right angles, apart from its corners
        def bent:int 0
        def ei:int 0
        while (ei < (array_length d.edges)) {
            def e:PresDEdge (itemAt d.edges ei)
            if (((array_length e.route) >= 4) && ((array_length e.line) != (array_length (FlowLook.roundCorners(e.route d.look.corner))))) {
                bent = (bent + 1)
            }
            ei = (ei + 1)
        }
        this.ok((bent == 0) "a square look's lines are the routes, corners rounded")
        def late:EVGDisplayList (PresTimeline.frame(deck 0 (d.total + 5.0)))
        this.ok(((PresCheck.texts(late "TILAUS")) == 1) "jurassic sets a box's words in capitals")
        def face:string ""
        def i:int 0
        while (i < (array_length late.cmds)) {
            def c:EVGDrawCmd (itemAt late.cmds i)
            if ((c.kind == 3) && (c.text == "TILAUS")) {
                face = c.fontFamily
            }
            i = (i + 1)
        }
        this.ok((face == "Open Sans-Bold") ("until its face is loaded, Open Sans: " + face))
        set deck.haveFaces "Josefin Sans-Bold" true
        def again:EVGDisplayList (PresTimeline.frame(deck 0 (d.total + 5.0)))
        def face2:string ""
        def j:int 0
        while (j < (array_length again.cmds)) {
            def c2:EVGDrawCmd (itemAt again.cmds j)
            if ((c2.kind == 3) && (c2.text == "TILAUS")) {
                face2 = c2.fontFamily
            }
            j = (j + 1)
        }
        this.ok((face2 == "Josefin Sans-Bold") ("then in its own face: " + face2))
        ; the window's look picker writes the look and reads it back
        def m:PresFlowModel (PresFlowModel.read("```mermaid\nflowchart LR\n  A --> B\n```\n{tour=on}"))
        m.setLook("cartoon")
        this.ok(((m.look()) == "cartoon") "the picker reads cartoon back")
        this.ok(((indexOf (m.markdown()) "{tour=on style=cartoon}") > 0) ("and writes it: " + (m.markdown())))
        m.setLook("holo")
        this.ok(((indexOf (m.markdown()) "cartoon") < 0) ("holo takes it away: " + (m.markdown())))
    }

    ; A long left-to-right chain with loops: its loops stay whole, every node
    ; shown by the end, and each held long enough to be read.
    ; A long chain on a portrait slide is cut into two columns; the walk's
    ; camera, in on a node of the second, must not leave the slide half
    ; empty and run the rest past its bottom: it stays over the diagram,
    ; and the node it is on stays in view.
    fn portraitChain:void () {
        def text:string ("---\norientation: portrait\nslide-split-level: 2\n---\n\n## 6 · Pitkä ketju\n\n```mermaid\nflowchart TD\n"
            + "  A[Tilaus saapuu] --> B[Tarkista varasto]\n  B --> C[Varaa tuotteet]\n  C --> D[Laskuta]\n  D --> E[Maksu vahvistettu]\n"
            + "  E --> F[Keräily]\n  F --> G[Pakkaus]\n  G --> H[Lähetys]\n  H --> I[Seurantakoodi]\n  I --> J[Toimitus]\n  J --> K[Palaute]\n```\n{style=sketch tour=on}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        if ((array_length s.diagrams) == 0) {
            this.ok(false "the portrait chain is a toured diagram")
            return
        }
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        def bw:double 440.0
        def bh:double 760.0
        def fit:double (d.fitOf(bw bh))
        def past:int 0
        def lost:int 0
        def most:double 1.0
        def t:double 0.0
        while (t < (d.total + 1.0)) {
            d.cameraAt(t bw bh)
            if (d.camZ > most) {
                most = d.camZ
            }
            def vw:double (bw / (fit * d.camZ))
            def vh:double (bh / (fit * d.camZ))
            def vx0:double (d.camX - (vw * 0.5))
            def vy0:double (d.camY - (vh * 0.5))
            if (vw < (d.worldW - 0.01)) {
                if ((vx0 < (d.worldX - 0.01)) || ((vx0 + vw) > ((d.worldX + d.worldW) + 0.01))) {
                    past = (past + 1)
                }
            }
            if (vh < (d.worldH - 0.01)) {
                if ((vy0 < (d.worldY - 0.01)) || ((vy0 + vh) > ((d.worldY + d.worldH) + 0.01))) {
                    past = (past + 1)
                }
            }
            ; the node it stands on (on a keyframe) is in view
            def k:int 0
            while (k < (array_length d.kfT)) {
                if (((fabs ((itemAt d.kfT k) - t)) < 0.001) && ((itemAt d.kfN k) >= 0)) {
                    def n:PresDNode (itemAt d.nodes (itemAt d.kfN k))
                    if ((n.x < (vx0 - 0.01)) || ((n.x + n.w) > ((vx0 + vw) + 0.01)) || (n.y < (vy0 - 0.01)) || ((n.y + n.h) > ((vy0 + vh) + 0.01))) {
                        lost = (lost + 1)
                    }
                }
                k = (k + 1)
            }
            t = (t + 0.05)
        }
        ; and on every keyframe exactly
        def j:int 0
        while (j < (array_length d.kfT)) {
            d.cameraAt((itemAt d.kfT j) bw bh)
            if ((itemAt d.kfN j) >= 0) {
                def vw2:double (bw / (fit * d.camZ))
                def vh2:double (bh / (fit * d.camZ))
                def n2:PresDNode (itemAt d.nodes (itemAt d.kfN j))
                if (((fabs ((n2.cx()) - d.camX)) > (((vw2 - n2.w) * 0.5) + 0.01)) || ((fabs ((n2.cy()) - d.camY)) > (((vh2 - n2.h) * 0.5) + 0.01))) {
                    lost = (lost + 1)
                }
            }
            j = (j + 1)
        }
        this.ok((most > 1.2) ("portrait chain: the walk goes in, z=" + (to_string most)))
        this.ok((past == 0) ("portrait chain: the camera never looks past the diagram, " + (to_string past) + " frames did"))
        this.ok((lost == 0) ("portrait chain: the node the walk stands on is in view, " + (to_string lost) + " were not"))
    }

    fn longChain:void () {
        def text:string ("---\nslide-split-level: 2\npage: a4 landscape\n---\n\n## Uusi projekti\n\n```mermaid\nflowchart LR\n"
            + "  A[Uusi projekti] --> B{Kuka tietää mitä tämä tekee?}\n  B -->|Minä ehkä| C[Avaa README]\n  B -->|Ei kukaan| C\n"
            + "  C --> D{README ajan tasalla?}\n  D -->|Tietenkin ei| E[git log --oneline]\n  D -->|Yllättäen kyllä| F[Kokeillaan ajaa]\n"
            + "  E --> F\n  F --> G{Käynnistyykö?}\n  G -->|Kyllä| H[Miksi tämä toimii?]\n  G -->|Ei| I[Katso erroria hiljaa 30 sekuntia]\n"
            + "  I --> J[Google / Stack Overflow / AI]\n  J --> K[Ahaa... tietenkin.]\n  K --> F\n  H --> L[Lisätään yksi pieni muutos]\n"
            + "  L --> M{Toimiiko vielä?}\n  M -->|Kyllä| N[LGTM]\n  M -->|Ei| I\n  N --> O[Projektin ymmärrys: noin 34 %]\n```\n{choose=off tour=on}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        if ((array_length s.diagrams) == 0) {
            this.ok(false "the chain is a toured diagram")
            return
        }
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        ; its loops (K back to F, M back to I) run through most of it, and a
        ; column may not end inside a loop (FlowWrapTest), so it is not wrapped
        this.ok(((array_length d.nodes) == 15) ("fifteen nodes, got " + (to_string (array_length d.nodes))))
        def hidden:int 0
        def i:int 0
        while (i < (array_length d.nodes)) {
            def n:PresDNode (itemAt d.nodes i)
            if (n.at > d.tourEnd) {
                hidden = (hidden + 1)
            }
            i = (i + 1)
        }
        this.ok((hidden == 0) ("every node appears in the walk, missing " + (to_string hidden)))
        ; the longest label is held at least its reading time
        def nb:PresDNode (d.nodeNamed("I"))
        def held:double 0.0
        def k:int 0
        while ((k + 1) < (array_length d.kfT)) {
            if (((itemAt d.kfN k) == (itemAt d.kfN (k + 1))) && ((itemAt d.kfN k) >= 0)) {
                def who:PresDNode (itemAt d.nodes (itemAt d.kfN k))
                if (who.id == "I") {
                    def span:double ((itemAt d.kfT (k + 1)) - (itemAt d.kfT k))
                    if (span > held) {
                        held = span
                    }
                }
            }
            k = (k + 1)
        }
        def need:double (d.readTime(30))
        this.ok((held >= (need - 0.01)) ("a long node is held for reading: " + (to_string held) + " s"))
    }

    ; The header and the footer: on the slides, before the first build step,
    ; and not where the front matter or the heading leaves them off.
    fn edges:void () {
        def text:string ("---\nslide-split-level: 2\nheader-left: ACME Oy\nfooter-right: \"{page} / {pages}\"\nfooter-skip: first\n---\n\n"
            + "## Kansi\n\nAlku\n\n## Toka\n\n1. yksi\n2. kaksi\n{.build}\n\n## Kolmas {header=off}\n\nLoppu\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 3) "three slides with a header")
        if ((deck.slideCount()) < 3) {
            return
        }
        def first:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        this.ok(((PresCheck.texts(first "ACME Oy")) == 1) "the header on the first slide")
        this.ok(((PresCheck.texts(first "1 / 3")) == 0) "footer-skip: first leaves its footer off")
        def early:EVGDisplayList (PresTimeline.frame(deck 1 ((deck.slideAt(1)).seconds + 0.05)))
        this.ok(((PresCheck.texts(early "2 / 3")) == 1) "the page number arrives with the slide")
        this.ok(((PresCheck.texts(early "yksi")) == 0) "before the build step")
        def last:EVGDisplayList (PresTimeline.finalFrame(deck 2))
        this.ok(((PresCheck.texts(last "ACME Oy")) == 0) "{header=off} on a heading")
        this.ok(((PresCheck.texts(last "3 / 3")) == 1) "that slide keeps its footer")
    }

    ; --- the theme's cascade (PresCascade), against what the layout draws ---------
    sfn hexOf:string (v:string) {
        def c:EVGColor (CssValue.color(v))
        if (c.isSet == false) {
            return ""
        }
        return (MdCss.hexOf(c))
    }

    ; The colour the layout set a word in, as #RRGGBB; "" when not found.
    sfn inkOf:string (deck:PresDeck word:string) {
        def l:MdLayout (deck.layout())
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && ((indexOf b.text word) == 0)) {
                return (PresCheck.hexOf(b.color))
            }
            i = (i + 1)
        }
        return ""
    }

    ; `css`, an element, a facet: its value, its source, and the colour the
    ; layout really draws `word` in.
    fn ink:void (css:string md:string sel:string cls:string word:string wantFrom:string what:string) {
        def classes:[string]
        if ((strlen cls) > 0) {
            push classes cls
        }
        def e:PresCssElement ((PresCascade.of(css)).element(sel classes ""))
        def f:PresCssFacet (e.facet("color"))
        this.ok((f.from == wantFrom) (what + ": colour from " + wantFrom + ", got " + f.from))
        def deck (new PresDeck())
        deck.md.setStyleSheet(css)
        deck.setText(md)
        def drawn:string (PresCheck.inkOf(deck word))
        this.ok(((strlen drawn) > 0) (what + ": " + word + " is drawn"))
        this.ok(((PresCheck.hexOf(f.value)) == drawn) (what + ": model " + f.value + " = drawn " + drawn))
    }

    fn cascade:void () {
        def none:[string]
        ; a heading with no colour of its own is the document's, and says so
        def css1:string "document { color: #112233 } heading { margin-top: 10pt }"
        def h2:PresCssElement ((PresCascade.of(css1)).element("h2" none ""))
        def hc:PresCssFacet (h2.facet("color"))
        this.ok(((hc.from == "document") && (hc.value == "#112233")) ("h2 colour from document: " + (h2.dump())))
        this.ok((hc.own == "h2") "an h2's colour is edited in h2")
        this.ok((((hc.link("heading")).isSet()) == false) "heading says nothing about colour")
        this.ok(((h2.facet("margin-top")).from == "heading") "the space above is the shared heading rule")
        this.ok(((h2.facet("margin-top")).isOwn()) "and it is the heading's own")
        ; h2 beats heading beats body beats document
        def css2:string "document { color: #111111 } body { color: #222222 } heading { color: #333333 } h2 { color: #444444 }"
        def c2:PresCascade (PresCascade.of(css2))
        this.ok(((((c2.element("h2" none "")).facet("color")).from) == "h2") "h2 colour wins")
        this.ok(((((c2.element("h3" none "")).facet("color")).from) == "heading") "then the shared heading colour")
        this.ok(((((c2.element("p" none "")).facet("color")).from) == "body") "body after document")
        this.ok(((((c2.element("p" none "")).facet("color")).own) == "body") "a paragraph's colour is edited where it comes from")
        ; MdCss reads the same into the style
        def mc (new MdCss())
        mc.addStyleSheet(css2)
        def st (new MdStyle())
        mc.applyTo(st)
        this.ok(((st.headingInk(2)) == (PresCheck.hexOf((((c2.element("h2" none "")).facet("color")).value)))) "h2 ink as MdStyle has it")
        this.ok(((st.headingInk(3)) == (PresCheck.hexOf((((c2.element("h3" none "")).facet("color")).value)))) "h3 ink as MdStyle has it")
        this.ok((st.textColor == (PresCheck.hexOf((((c2.element("p" none "")).facet("color")).value)))) "text ink as MdStyle has it")
        ; a list's colour is its bullets; the item's text is the document's
        def css3:string "document { color: #101010 } list { color: #ff0000; padding-left: 30pt }"
        def li:PresCssElement ((PresCascade.of(css3)).element("li" none ""))
        this.ok((((li.facet("color")).from == "document") && ((li.facet("marker-color")).from == "list")) ("item text vs bullets: " + (li.dump())))
        def mk:PresCssFacet (li.facet("marker-color"))
        this.ok(((strlen mk.note) > 0) "the bullet colour says what it colours")
        this.ok(((li.facet("padding-left")).value == "30pt") "the list's indent")
        this.ok(((li.facet("margin-bottom")).isDefault()) "item spacing at its default")
        ; a selector list, and the later rule at equal specificity
        def css4:string "h1, h2 { font-size: 30pt } h2 { font-size: 20pt } h3 { color: red !important } h3 { color: blue }"
        def c4:PresCascade (PresCascade.of(css4))
        def f4:PresCssFacet ((c4.element("h2" none "")).facet("font-size"))
        this.ok(((f4.value == "20pt") && ((f4.link("h2")).selector == "h2")) ("the later h2 rule: " + f4.value))
        this.ok(((((c4.element("h1" none "")).facet("font-size")).value) == "30pt") "h1 of h1, h2")
        this.ok(((((c4.element("h3" none "")).facet("color")).value) == "red") "!important above a later rule")
        ; the shared heading size is h1's only
        def c5:PresCascade (PresCascade.of("heading { font-size: 40pt; font-family: Lato }"))
        this.ok(((((c5.element("h1" none "")).facet("font-size")).value) == "40pt") "heading font-size sets h1")
        this.ok(((((c5.element("h2" none "")).facet("font-size")).isDefault())) "and not h2")
        this.ok(((((c5.element("h2" none "")).facet("font-family")).value) == "Lato") "heading font-family sets all")
        ; a quote's text is its own colour, never the document's
        def q:PresCssElement ((PresCascade.of("document { color: #123456 }")).element("blockquote" none ""))
        this.ok(((q.facet("color")).isDefault()) ("quote colour ignores the document: " + (q.dump())))
        ; a class: its colour and size on its block, its tag rule too
        def css6:string "document { color: #111111 } .lead { color: #00aa00; font-size: 1.3em } #only { color: #0000ff }"
        def c6:PresCascade (PresCascade.of(css6))
        def lead:[string]
        push lead ".lead"
        def pl:PresCssElement (c6.element("p" lead ""))
        this.ok((((pl.facet("color")).from == ".lead") && ((pl.facet("color")).own == ".lead")) ("p.lead colour: " + (pl.dump())))
        this.ok(((pl.facet("font-size")).value == "1.3em") "p.lead size")
        def pid:PresCssElement (c6.element("p" lead "only"))
        def pidc:PresCssFacet (pid.facet("color"))
        this.ok((pidc.from == "#only") ("an id beats a class: " + pidc.from))
        ; a heading's own colour beats its class
        def hl:PresCssElement ((PresCascade.of("h2 { color: #aa0000 } .lead { color: #00aa00 }")).element("h2" lead ""))
        this.ok(((hl.facet("color")).from == "h2") "h2 colour above its class")
        ; what a rule says that the layout does not read is listed as unread
        def un:PresCssElement ((PresCascade.of("p { color: red; margin-bottom: 4pt }")).element("p" none ""))
        def uf:PresCssFacet (un.facet("unread:p:color"))
        this.ok((uf.unread && (uf.value == "red")) ("p color is unread: " + (un.dump())))
        this.ok(((un.facet("margin-bottom")).value == "4pt") "p margin-bottom")
        ; the universal selector reaches every rule
        this.ok((((((PresCascade.of("* { color: #010203 }")).element("p" none "")).facet("color")).value) == "#010203") "* reaches the text")
        ; and against the layout: what the slide is drawn in
        def md:string "## Otsikko\n\nTeksti tässä\n\n- kohta\n\n> lainaus\n\nIso\n{.lead}\n"
        this.ink(css1 md "h2" "" "Otsikko" "document" "a heading drawn in the document colour")
        this.ink(css2 md "h2" "" "Otsikko" "h2" "a heading drawn in its own")
        this.ink(css2 md "p" "" "Teksti" "body" "a paragraph drawn in body")
        this.ink(css3 md "li" "" "kohta" "document" "an item's text is not the list colour")
        this.ink(css1 md "blockquote" "" "lainaus" "" "a quote in its own colour")
        this.ink(css6 md "p" ".lead" "Iso" ".lead" "a .lead paragraph")
    }

    ; A chart's columns rise and a beam crosses it once. Presenting, the
    ; clock holds at the slide's end and at each build step; it held before
    ; the beam was across, and the beam stayed half way over the chart.
    fn chartMotion:void () {
        def vals:string ""
        def v:int 0
        while (v < 20) {
            if (v > 0) {
                vals = (vals + ",")
            }
            vals = (vals + "{\"m\":\"k" + (to_string v) + "\",\"e\":" + (to_string (100 + (v * 7))) + "}")
            v = (v + 1)
        }
        def fence:string ("```vega-lite\n{\"usermeta\":{\"presStyle\":\"forge\"},\"data\":{\"values\":[" + vals
            + "]},\"mark\":\"bar\",\"encoding\":{\"x\":{\"field\":\"m\",\"type\":\"nominal\"},\"y\":{\"field\":\"e\",\"type\":\"quantitative\"}}}\n```\n")
        def text:string ("---\nslide-split-level: 2\n---\n\n## Menot\n\n" + fence
            + "\n## Askeleet\n\n" + fence + "\n1. yksi\n2. kaksi\n{.build}\n"
            + "\n## Myöhemmin\n\n1. eka\n{.build}\n\n" + fence + "{.build}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        if ((deck.slideCount()) < 3) {
            this.ok(false ("three chart slides, got " + (to_string (deck.slideCount()))))
            return
        }
        def motion:double (PresChart.motionSeconds())
        ; with the slide: it lasts until the beam is across, and is clear then
        def s0:PresSlide (deck.slideAt(0))
        this.ok(((array_length s0.charts) == 1) "the chart is read")
        if ((array_length s0.charts) == 0) {
            return
        }
        def u0:PresChartUse (itemAt s0.charts 0)
        this.ok((s0.duration >= (u0.start + motion)) ("the slide lasts until the chart has finished: " + (to_string s0.duration)))
        def mid:double (u0.start + (motion - ((PresChart.scanDur()) * 0.5)))
        this.ok(((PresCheck.beams((PresTimeline.frame(deck 0 mid)))) == 1) "the beam is over the chart half way across")
        this.ok(((PresCheck.beams((PresTimeline.frame(deck 0 s0.duration)))) == 0) "and gone where the slide holds")
        ; before a build step: the step waits for the chart
        def s1:PresSlide (deck.slideAt(1))
        def u1:PresChartUse (itemAt s1.charts 0)
        def first:double (PresTimeline.stepTime(s1 1))
        this.ok((first >= (u1.start + motion)) ("step 1 waits for the chart: " + (to_string first)))
        this.ok(((PresCheck.beams((PresTimeline.frame(deck 1 first)))) == 0) "no beam where step 1 holds")
        this.ok(((fabs (((PresTimeline.stepTime(s1 2)) - first) - s1.stepGap)) < 0.000001) "later steps keep their gap")
        ; revealed by a step: it starts moving when it arrives
        def s2:PresSlide (deck.slideAt(2))
        this.ok(((array_length s2.charts) == 1) "the chart under a step is read")
        if ((array_length s2.charts) == 0) {
            return
        }
        def u2:PresChartUse (itemAt s2.charts 0)
        this.ok((u2.start == (PresTimeline.stepTime(s2 2))) ("a chart starts with its step: " + (to_string u2.start)))
        this.ok((s2.duration >= (u2.start + motion)) "and the slide waits for it")
    }

    ; A facet header's own colour is kept, and the axes under it still take
    ; the theme's: one labelColor is not every word coloured.
    fn chartHeaderInk:void () {
        def text:string "## Alueet\n\n```vega-lite\n{\"data\":{\"values\":[{\"g\":\"North\",\"k\":\"A\",\"v\":3},{\"g\":\"South\",\"k\":\"B\",\"v\":2}]},\"facet\":{\"column\":{\"field\":\"g\",\"header\":{\"labelColor\":\"#ff8800\"}}},\"spec\":{\"mark\":\"bar\",\"encoding\":{\"x\":{\"field\":\"k\",\"type\":\"nominal\"},\"y\":{\"field\":\"v\",\"type\":\"quantitative\"}}}}\n```\n"
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def l:EVGDisplayList (PresTimeline.frame(deck 0 30.0))
        def black:int 0
        def header:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if (c.kind == 3) {
                if (((c.r == 0) && (c.g == 0)) && (c.b == 0)) {
                    black = (black + 1)
                }
                if (((c.r == 255) && (c.g == 136)) && (c.b == 0)) {
                    header = (header + 1)
                }
            }
            i = (i + 1)
        }
        this.ok((header == 2) ("both facet headers keep their colour: " + (to_string header)))
        this.ok((black == 0) ("no word left in the chart's black: " + (to_string black)))
    }

    ; A table whose file the page could not find says so, not "Loading".
    fn tableMissing:void () {
        def deck (new PresDeck())
        deck.setText("## Myynti\n\n```table\ndata/myynti.csv\nrows: 5\n```\n")
        PresTimeline.planAll(deck)
        this.ok((this.frameHas(deck "Loading")) "a table waits for its file")
        deck.setChartDataMissing("data/myynti.csv")
        PresTimeline.planAll(deck)
        this.ok((this.frameHas(deck "No such file in this presentation: data/myynti.csv")) "and then says it has none")
        this.ok(((this.frameHas(deck "Loading")) == false) "instead of waiting")
    }

    fn frameHas:boolean (deck:PresDeck s:string) {
        def l:EVGDisplayList (PresTimeline.frame(deck 0 5.0))
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((c.kind == 3) && ((indexOf c.text s) >= 0)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; The scan beam's bright core in a frame.
    sfn beams:int (l:EVGDisplayList) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((((c.kind == 0) && (c.w == 2.0)) && (((c.r == 230) && (c.g == 250)) && (c.b == 255))) && (c.a > 0.0)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; ```process / ```swot / ```timeline drawn for everyone in the theme's
    ; colours; `{art=waves}` only for PRO, under the content.
    fn figures:void () {
        def text:string "---\nslide-split-level: 2\n---\n\n## Vaiheet {art=waves}\n\n```process\n- Suunnittelu: tavoitteet\n- Toteutus\n- Julkaisu\n```\n\n## SWOT\n\n```swot\nVahvuudet: brändi\nHeikkoudet: tiimi\nMahdollisuudet: markkinat\nUhat: kilpailu\n```\n"
        def css:string "page { width: 13.333in; height: 7.5in; padding: 0.6in; background-color: #0b1030 } deck { split-level: 2 } document { color: #e8ecff; font-size: 20pt } figure { colors: #ffa546 #5ce1ff }"
        def deck (new PresDeck())
        deck.md.setStyleSheet(css)
        deck.setTheme(css)
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 2) ("two figure slides, got " + (to_string (deck.slideCount()))))
        if ((deck.slideCount()) < 2) {
            return
        }
        def freeL:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        this.ok(((PresCheck.texts(freeL "Suunnittelu")) == 1) "without PRO the process is drawn")
        def noArt:FlowScene (deck.artScene((deck.slideAt(0)) 0))
        this.ok(((array_length noArt.items) == 0) "without PRO the art is not drawn")
        deck.artAllowed = true
        deck.rebuild()
        PresTimeline.planAll(deck)
        def l0:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        this.ok(((PresCheck.texts(l0 "Suunnittelu")) == 1) "with PRO the process step is still drawn")
        this.ok(((PresCheck.texts(l0 "tavoitteet")) == 1) "and its description")
        def l1:EVGDisplayList (PresTimeline.finalFrame(deck 1))
        this.ok(((PresCheck.texts(l1 "V")) == 1) "the SWOT's letters come from the titles")
        this.ok(((deck.slideAt(0)).art == "waves") "the art is read from the heading")
        def art:FlowScene (deck.artScene((deck.slideAt(0)) 0))
        this.ok(((array_length art.items) > 40) "the art is a page of lines")
        def none:FlowScene (deck.artScene((deck.slideAt(1)) 1))
        this.ok(((array_length none.items) == 0) "a slide without art has none")
        this.ok(((PresCheck.lines(l0)) > ((PresCheck.lines(l1)) + 40)) "the art's lines are in the slide's list")
        def fs:MdFigureStyle deck.figStyle
        this.ok(((itemAt fs.colors 0) == "#ffa546") "the figure rule's colours")
        this.ok((fs.paper == "#0b1030") "the page's paper")
        this.ok((fs.ink == "#e8ecff") "the document's ink")
    }

    ; A plain list with `{list-style=swot}`, or a theme's `#anchor list`
    ; rule, is the figure; `deck { fx: … }` is the theme's effect, and the
    ; art is drawn over it.
    fn listFigures:void () {
        def text:string "---\nslide-split-level: 2\n---\n\n## SWOT {art=waves}\n\n- Vahvuudet: brändi\n- Heikkoudet: tiimi\n{list-style=swot}\n\n## Vaiheet\n\n- Suunnittelu: tavoitteet\n- Toteutus\n\n## Lista\n\n- Tavallinen kohta\n"
        def css:string "/* pres: fx=smoke */ page { width: 13.333in; height: 7.5in; padding: 0.6in; background-color: #0b1030 } deck { split-level: 2; fx: starfield; fx-hue: 280 } document { color: #e8ecff; font-size: 20pt } #vaiheet list { list-style: process } #vaiheet chart { padding: 4 }"
        def deck (new PresDeck())
        deck.md.setStyleSheet(css)
        deck.setTheme(css)
        deck.artAllowed = true
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 3) ("three slides, got " + (to_string (deck.slideCount()))))
        if ((deck.slideCount()) < 3) {
            return
        }
        def l0:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        this.ok(((PresCheck.texts(l0 "Vahvuudet")) == 1) "a list with {list-style=swot} is the SWOT")
        this.ok(((PresCheck.texts(l0 "V")) == 1) "with its letter disc")
        def l1:EVGDisplayList (PresTimeline.finalFrame(deck 1))
        this.ok(((PresCheck.texts(l1 "Suunnittelu")) == 1) "#vaiheet list { list-style: process } draws the steps")
        def scopes:[string] (deck.chartScopes())
        this.ok(((array_length scopes) == 1) "a list rule is not a chart scope")
        def l2:EVGDisplayList (PresTimeline.finalFrame(deck 2))
        this.ok(((PresCheck.texts(l2 "Tavallinen kohta")) == 1) "a list without a style stays a list")
        this.ok(((deck.slideAt(0)).fx == "starfield") "deck { fx } wins over the old comment")
        def fxAt:int -1
        def artAt:int -1
        def i:int 0
        while (i < (array_length l0.cmds)) {
            def c:EVGDrawCmd (itemAt l0.cmds i)
            if ((fxAt < 0) && ((strlen c.effectId) > 0)) {
                fxAt = i
            }
            if ((artAt < 0) && (c.kind == 7)) {
                artAt = i
            }
            i = (i + 1)
        }
        this.ok((fxAt >= 0) "the slide has its effect")
        this.ok((artAt > fxAt) ("the art is over the effect: art " + (to_string artAt) + ", fx " + (to_string fxAt)))
        def d2 (new PresDeck())
        def css2:string "/* pres: fx=smoke */ deck { fx: none }"
        d2.setTheme(css2)
        d2.setText("# A\n")
        this.ok(((d2.slideAt(0)).fx == "") "fx: none turns the comment's effect off")
    }

    sfn lines:int (l:EVGDisplayList) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((strlen c.text) == 0) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn texts:int (l:EVGDisplayList word:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((c.kind == 3) && (c.text == word)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; The document settings window's model: the front matter read into the
    ; places, the logo and the skips, and written back as keys.
    fn docSettings:void () {
        def meta (new MdMeta())
        MdFrontMatter.parseInto("title: Q3\nheader: Acme\nheader-image: logo.png\nheader-align: right\nfooter-left: \"{title}\"\nfooter-right: \"{page} / {pages}\"\nfooter-skip: first 3 last\nfooter-color: \"#ffffff\"" meta)
        def d (new PresDocSettings())
        d.read(meta)
        this.ok((d.title == "Q3") "docset: title")
        this.ok(((itemAt d.logo 0) == "logo.png") "docset: legacy header-image becomes the logo")
        this.ok(((itemAt d.logoAt 0) == 2) "docset: header-align right puts it on the right")
        this.ok(((itemAt d.texts 2) == "Acme") "docset: legacy header text in its place")
        this.ok(((itemAt d.texts 5) == "{page} / {pages}") "docset: footer right")
        this.ok(((itemAt d.skipFirst 1) && (itemAt d.skipLast 1)) "docset: first and last skipped")
        this.ok(((itemAt d.skipRest 1) == "3") "docset: other skips kept")
        set d.logoAt 0 0
        set d.skipLast 1 false
        d.build()
        def got:string ""
        def i:int 0
        while (i < (array_length d.outKeys)) {
            def v:string (itemAt d.outVals i)
            if ((strlen v) > 0) {
                got = (got + (itemAt d.outKeys i) + ": " + (PresDocSettings.quote(v)) + "\n")
            }
            i = (i + 1)
        }
        this.ok(((indexOf got "header-left: \"![](logo.png)\"") >= 0) "docset: logo written in its place, quoted")
        this.ok(((indexOf got "header-right: Acme") >= 0) "docset: text stays on the right")
        this.ok(((indexOf got "header-image") < 0) "docset: legacy keys taken out")
        this.ok(((indexOf got "footer-skip: first 3\n") >= 0) "docset: skips written")
        this.ok(((indexOf got "footer-color: \"#ffffff\"") >= 0) "docset: colour quoted")
        def back (new MdMeta())
        MdFrontMatter.parseInto(got back)
        def d2 (new PresDocSettings())
        d2.read(back)
        this.ok((((itemAt d2.logo 0) == "logo.png") && ((itemAt d2.logoAt 0) == 0)) "docset: round trip keeps the logo")
        this.ok(((PresDocSettings.quote("say \"hi\": now")) == "'say \"hi\": now'") "docset: single quotes around double")
        this.ok(((PresDocSettings.quote("plain words")) == "plain words") "docset: plain value unquoted")
    }

    ; A length's slider runs over what the slide can take: the page's
    ; padding on a 960 × 540 slide stops where half of the height is left.
    fn ranges:void () {
        def box:PresRangeBox (PresRangeBox.slide(960.0 540.0))
        def pin@(optional):PresRange (PresRange.forLength("padding" "in" "page" box))
        this.ok((!null? pin) "page padding has a range")
        if (null? pin) {
            return
        }
        def pi:PresRange (unwrap pin)
        this.ok((pi.kind == "inset") ("page padding eats the slide: " + pi.kind))
        this.ok((((pi.hi * 72.0) <= 135.0) && ((pi.hi * 72.0) > 120.0)) ("page padding up to a quarter of the height: " + (pi.text())))
        this.ok(((pi.step > 0.0) && (((pi.hi - pi.lo) / pi.step) >= 60.0)) ("and fine enough to aim: " + (pi.text())))
        def ppt:PresRange (unwrap (PresRange.forLength("padding" "pt" "page" box)))
        this.ok(((ppt.hi == 135.0) && (ppt.step == 1.0)) ("in points: " + (ppt.text())))
        ; the side the property eats
        def pl:PresRange (unwrap (PresRange.forLength("padding-left" "pt" "page" box)))
        this.ok((pl.hi == 240.0) ("left padding from the width: " + (pl.text())))
        def tall:PresRangeBox (PresRangeBox.slide(540.0 960.0))
        def pt:PresRange (unwrap (PresRange.forLength("padding" "pt" "page" tall)))
        this.ok((pt.hi == 135.0) ("a portrait slide: the shorter side: " + (pt.text())))
        ; spacing between blocks, a block's own padding, a border, text
        def mt:PresRange (unwrap (PresRange.forLength("margin-top" "pt" "heading" box)))
        this.ok(((mt.kind == "space") && (mt.hi == 90.0)) ("heading space above: " + (mt.text())))
        def cell:PresRange (unwrap (PresRange.forLength("padding-top" "pt" "table" box)))
        this.ok(((cell.kind == "pad") && (cell.hi == 45.0)) ("table cell padding: " + (cell.text())))
        def ind:PresRange (unwrap (PresRange.forLength("padding-left" "pt" "list" box)))
        this.ok((ind.kind == "space") ("a list indent is space: " + ind.kind))
        def bw:PresRange (unwrap (PresRange.forLength("border-width" "pt" "blockquote" box)))
        this.ok((bw.hi == 15.0) ("a quote bar: " + (bw.text())))
        def fs:PresRange (unwrap (PresRange.forLength("font-size" "pt" "h1" box)))
        this.ok(((fs.lo == 6.0) && (fs.hi == 90.0)) ("text size: " + (fs.text())))
        ; a chart's padding is of the chart's own box when it is picked
        def cb:PresRangeBox (PresRangeBox.slide(960.0 540.0))
        cb.elemW = 400.0
        cb.elemH = 200.0
        def cp:PresRange (unwrap (PresRange.forLength("padding" "pt" "chart" cb)))
        this.ok((cp.hi == 50.0) ("chart padding from the chart: " + (cp.text())))
        def cp2:PresRange (unwrap (PresRange.forLength("padding" "pt" "#sales chart" cb)))
        this.ok((cp2.hi == 50.0) "a heading's charts too")
        ; units the layout does not read as lengths keep their own range
        this.ok((null? (PresRange.forLength("padding" "em" "page" box))) "em is left to the caller")
        this.ok((null? (PresRange.forLength("line-height" "" "p" box))) "line-height is not a length")
        ; the rule a declaration is in
        def css:string "/* page { x } */\npage {\n  padding: 2in;\n}\nh2 { color: red; margin-top: 4pt }\n"
        this.ok(((PresRange.selectorAt(css 2 4)) == "page") ("rule of a line: " + (PresRange.selectorAt(css 2 4))))
        this.ok(((PresRange.selectorAt(css 4 22)) == "h2") "rule on the same line")
        this.ok(((PresRange.selectorAt(css 0 5)) == "") "a comment is no rule")
        this.ok(((PresRange.selectorAt(css 4 1)) == "") "between rules")
        ; a number typed into the popover's field, in the field's unit
        this.ok(((PresRange.typed("2020" "px")) == "2020px") "a number takes the field's unit")
        this.ok(((PresRange.typed(" 2020px " "px")) == "2020px") ("a unit typed is not added again: " + (PresRange.typed("2020px" "px"))))
        this.ok(((PresRange.typed("1.5in" "pt")) == "1.5in") "a unit typed is the unit meant")
        this.ok(((PresRange.typed("-4" "pt")) == "-4pt") "a negative number")
        this.ok(((PresRange.typed("1.45" "")) == "1.45") "a ratio has no unit")
        this.ok(((PresRange.typed("2020pxpx" "px")) == "") "2020pxpx is not a value")
        this.ok(((PresRange.typed("px" "px")) == "") "nor is a unit alone")
        this.ok(((PresRange.typed("" "px")) == "") "nor nothing")
        ; and through the hint the popover gets
        def j:string (PresHints.forLineIn("css" "  padding: 2.25in;" 12 false "page" box))
        this.ok(((indexOf j "\"max\":1.86") > 0) ("hint carries the range: " + j))
        def j2:string (PresHints.forLine("css" "  padding: 2.25in;" 12 false))
        this.ok(((indexOf j2 "\"max\":20") < 0) ("no 20 inch padding anywhere: " + j2))
    }

    ; Values past their safety range: the chart and figure readers clamp
    ; and refuse what is not a length, as the slides do (MdCssLimits).
    fn limits:void () {
        this.ok(((PresDeck.lengthOf("18px")) == "18") "18px is 18")
        this.ok(((PresDeck.lengthOf("18")) == "18") "18 is 18")
        this.ok(((PresDeck.lengthOf("2020pxpx")) == "") "2020pxpx is not a length")
        def deck (new PresDeck())
        def css:string "page { width: 13.333in; height: 7.5in; padding: 0.6in } deck { split-level: 2 } chart { font-size: 2020px; title-font-size: 15px; padding: 9000px }"
        deck.setTheme(css)
        deck.md.setStyleSheet(css)
        deck.setText("## A\n\nTeksti\n")
        def cfg:string (deck.chartDefaults("chart" false))
        this.ok(((indexOf cfg "2020") < 0) ("a chart's 2020px labels are held to the slide: " + cfg))
        this.ok(((indexOf cfg "\"labelFontSize\": 540") > 0) ("…at the slide's height: " + cfg))
        this.ok(((indexOf cfg "\"fontSize\": 15") > 0) ("an ordinary title size is kept: " + cfg))
        this.ok(((indexOf cfg "\"padding\": 135") > 0) ("chart padding at a quarter of the slide: " + cfg))
        deck.setTheme("chart { font-size: 2020pxpx }")
        def bad:string (deck.chartDefaults("chart" false))
        this.ok(((indexOf bad "labelFontSize") < 0) ("2020pxpx says nothing: " + bad))
    }

    ; A change to `chart { … }` draws the charts again a few per rebuild,
    ; and a theme change that is not about charts draws none of them.
    fn staggered:void () {
        def md:string ""
        def i:int 1
        while (i <= 5) {
            md = (md + "## Kaavio " + (to_string i) + "\n\n```vega-lite\n{\"data\": {\"values\": [{\"m\": \"a\", \"n\": " + (to_string i) + "}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"m\", \"type\": \"nominal\"}, \"y\": {\"field\": \"n\", \"type\": \"quantitative\"}}}\n```\n\n")
            i = (i + 1)
        }
        def css:string "page { width: 13.333in; height: 7.5in; padding: 0.6in } deck { split-level: 2 } "
        def deck (new PresDeck())
        deck.setStyleSheet(css)
        deck.setText(md)
        ; the room a chart may take is known from the layout before (the
        ; first one had the default page): a second settles it
        deck.setText(md)
        this.ok(((deck.slideCount()) == 5) ("five chart slides, got " + (to_string (deck.slideCount()))))
        this.ok(((deck.redrawPending()) == 0) "a first layout draws every chart")
        deck.redrawBudget = 2
        deck.setStyleSheet((css + "h2 { color: #c00 }"))
        deck.setText(md)
        this.ok(((deck.redrawPending()) == 0) "a heading colour draws no chart again")
        deck.setStyleSheet((css + "h2 { color: #c00 } chart { font-size: 20px }"))
        deck.setText(md)
        this.ok(((deck.redrawPending()) == 3) ("new chart defaults: two drawn, three left, got " + (to_string (deck.redrawPending()))))
        def passes:int 0
        while (((deck.redrawPending()) > 0) && (passes < 10)) {
            deck.setText(md)
            passes = (passes + 1)
        }
        this.ok((passes == 2) ("the rest in two more rebuilds, got " + (to_string passes)))
        def frame:EVGDisplayList (PresTimeline.finalFrame(deck 4))
        this.ok(((indexOf (frame.toJson()) "\"size\":20") > 0) "the last chart is drawn with the new size")
    }

    ; A SmartArt file in the deck, referenced like a picture: drawn by the
    ; layout engine into the picture's box, in the theme's colours, with what
    ; the reference's {…} says. Never as a picture of the XML.
    fn smartArt:void () {
        def xml:string "<dgm:dataModel xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\"><dgm:ptLst><dgm:pt modelId=\"0\" type=\"doc\"><dgm:prSet loTypeId=\"urn:microsoft.com/office/officeart/2005/8/layout/process1\"/></dgm:pt><dgm:pt modelId=\"1\"><dgm:t><a:p><a:r><a:t>Suunnittelu</a:t></a:r></a:p></dgm:t></dgm:pt><dgm:pt modelId=\"2\"><dgm:t><a:p><a:r><a:t>Toteutus</a:t></a:r></a:p></dgm:t></dgm:pt><dgm:pt modelId=\"3\"><dgm:t><a:p><a:r><a:t>Julkaisu</a:t></a:r></a:p></dgm:t></dgm:pt></dgm:ptLst><dgm:cxnLst><dgm:cxn srcId=\"0\" destId=\"1\"/><dgm:cxn srcId=\"0\" destId=\"2\"/><dgm:cxn srcId=\"0\" destId=\"3\"/></dgm:cxnLst></dgm:dataModel>"
        def broken:string "<dgm:dataModel xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\"><dgm:ptLst/></dgm:dataModel>"
        def text:string "---\nslide-split-level: 2\n---\n\n## Prosessi\n\n![Prosessi](media/steps.xml)\n\n## Nuolet\n\n![Nuolet](media/steps.xml)\n{layout=chevron1 colors=colorful1}\n\n## Rikki\n\n![Rikki](media/broken.xml)\n"
        def css:string "page { width: 13.333in; height: 7.5in; padding: 0.6in; background-color: #ffffff } deck { split-level: 2 } document { color: #111111; font-size: 20pt } figure { colors: #1f6feb #0f9d8a #7c4dff }"
        def deck (new PresDeck())
        deck.md.setStyleSheet(css)
        deck.setTheme(css)
        this.ok((deck.addImage("/media/steps.xml" (buffer_from_string xml) "" 0 0)) "a SmartArt file is taken")
        this.ok((deck.addImage("/media/broken.xml" (buffer_from_string broken) "application/xml" 0 0)) "and a broken one too")
        this.ok((deck.isSmartArtPath("/media/steps.xml")) "it is known as a diagram")
        this.ok(((deck.isSmartArtPath("/media/other.png")) == false) "a picture is not")
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 3) ("three slides, got " + (to_string (deck.slideCount()))))
        if ((deck.slideCount()) < 3) {
            return
        }
        def l0:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        this.ok(((PresCheck.texts(l0 "Suunnittelu")) == 1) "the first step is drawn")
        this.ok(((PresCheck.texts(l0 "Julkaisu")) == 1) "and the last")
        this.ok(((PresCheck.images(l0 "/media/steps.xml")) == 0) "and not as a picture of the file")
        def s1:PresSlide (deck.slideAt(1))
        this.ok(((array_length s1.smartArts) == 1) "the reference on the second slide is read")
        if ((array_length s1.smartArts) == 1) {
            def u:PresSmartArtUse (itemAt s1.smartArts 0)
            this.ok((u.layout == "chevron1") "with its layout")
            this.ok((u.colors == "colorful1") "and its colours")
        }
        def l1:EVGDisplayList (PresTimeline.finalFrame(deck 1))
        this.ok(((PresCheck.texts(l1 "Toteutus")) == 1) "the same file in another layout is drawn too")
        ; the theme's first figure colour is the steps' fill: #1f6feb
        this.ok(((PresCheck.fills(l0 31 111 235)) >= 3) "the steps in the theme's first colour")
        ; colorful1 starts at the second accent: #0f9d8a
        this.ok(((PresCheck.fills(l1 15 157 138)) >= 1) "colorful1 starts at the second")
        def l2:EVGDisplayList (PresTimeline.finalFrame(deck 2))
        this.ok(((PresCheck.textsLike(l2 "SmartArt /media/broken.xml")) == 1) "a diagram that cannot be drawn says why")
        ; drawn twice, laid out once
        def before:int (array_length deck.smartArtCache.keys)
        PresTimeline.finalFrame(deck 0)
        this.ok(((array_length deck.smartArtCache.keys) == before) "a diagram already laid out is not laid out again")
    }

    ; From the SmartArt test deck: an .xml file that is not a diagram, stored
    ; with no type (as the deck's storage gives it back), and a model with no
    ; items each say why in their place; a row of steps with nothing beside
    ; it is laid out across the content width; eight steps wrap into rows;
    ; on a dark theme the text reads on its fill.
    fn smartArtSlides:void () {
        def head:string "<dgm:dataModel xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\"><dgm:ptLst><dgm:pt modelId=\"0\" type=\"doc\"/>"
        def pts:string ""
        def cx:string ""
        def i:int 1
        while (i <= 8) {
            pts = (pts + "<dgm:pt modelId=\"" + (to_string i) + "\"><dgm:t><a:p><a:r><a:t>Vaihe " + (to_string i) + "</a:t></a:r></a:p></dgm:t></dgm:pt>")
            cx = (cx + "<dgm:cxn srcId=\"0\" destId=\"" + (to_string i) + "\"/>")
            i = (i + 1)
        }
        def eight:string (head + pts + "</dgm:ptLst><dgm:cxnLst>" + cx + "</dgm:cxnLst></dgm:dataModel>")
        def three:string (head + "<dgm:pt modelId=\"1\"><dgm:t><a:p><a:r><a:t>Yksi</a:t></a:r></a:p></dgm:t></dgm:pt><dgm:pt modelId=\"2\"><dgm:t><a:p><a:r><a:t>Kaksi</a:t></a:r></a:p></dgm:t></dgm:pt><dgm:pt modelId=\"3\"><dgm:t><a:p><a:r><a:t>Kolme</a:t></a:r></a:p></dgm:t></dgm:pt></dgm:ptLst><dgm:cxnLst><dgm:cxn srcId=\"0\" destId=\"1\"/><dgm:cxn srcId=\"0\" destId=\"2\"/><dgm:cxn srcId=\"0\" destId=\"3\"/></dgm:cxnLst></dgm:dataModel>")
        def empty:string (head + "</dgm:ptLst><dgm:cxnLst></dgm:cxnLst></dgm:dataModel>")
        def text:string "---\nslide-split-level: 2\n---\n\n## Kolme\n\n![Kolme](media/three.xml)\n{layout=process1}\n\n## Kapea\n\n![Kapea](media/three.xml)\n{layout=process1 width=50%}\n\n## Kahdeksan\n\n![Kahdeksan](media/eight.xml)\n{layout=process1}\n\n## Ei kaavio\n\n![Ei](media/list.xml)\n\n## Tyhjä\n\n![Tyhjä](media/empty.xml)\n{layout=process1}\n"
        def css:string "page { width: 13.333in; height: 7.5in; padding: 0.6in; background-color: #0b1030 } deck { split-level: 2 } document { color: #e8ecff; font-size: 20pt } figure { colors: #e07a2f #2fb5a0 }"
        def deck (new PresDeck())
        deck.md.setStyleSheet(css)
        deck.setTheme(css)
        deck.addImage("/media/three.xml" (buffer_from_string three) "" 0 0)
        deck.addImage("/media/eight.xml" (buffer_from_string eight) "" 0 0)
        deck.addImage("/media/empty.xml" (buffer_from_string empty) "" 0 0)
        deck.addImage("/media/list.xml" (buffer_from_string "<ostoslista><tuote>maito</tuote></ostoslista>") "" 0 0)
        this.ok((deck.isSmartArtPath("/media/list.xml")) "an .xml file that is not a diagram is not taken for a picture")
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 5) ("five slides, got " + (to_string (deck.slideCount()))))
        if ((deck.slideCount()) < 5) {
            return
        }
        def l:MdLayout (deck.layout())
        def content:double (l.style.pageWidth - (l.style.margin * 2.0))
        def wide:double (PresCheck.inkWidth((PresTimeline.finalFrame(deck 0)) "Yksi" "Kolme"))
        this.ok((wide > (content * 0.65)) ("three steps alone are laid out across the content width (labels from first to last): " + (to_string wide) + " of " + (to_string content)))
        def narrow:double (PresCheck.inkWidth((PresTimeline.finalFrame(deck 1)) "Yksi" "Kolme"))
        this.ok((narrow < (content * 0.45)) ("width=50% keeps its own box: " + (to_string narrow)))
        def l2:EVGDisplayList (PresTimeline.finalFrame(deck 2))
        def y1:double (PresCheck.textY(l2 "Vaihe 1"))
        def y8:double (PresCheck.textY(l2 "Vaihe 8"))
        this.ok((y8 > (y1 + 20.0)) ("eight steps wrap into rows: " + (to_string y1) + " / " + (to_string y8)))
        this.ok(((PresCheck.textsLike((PresTimeline.finalFrame(deck 3)) "SmartArt /media/list.xml: the root element is <ostoslista>")) == 1) "a file that is not a diagram says why on its slide")
        this.ok(((PresCheck.textsLike((PresTimeline.finalFrame(deck 4)) "SmartArt /media/empty.xml: the diagram has no items")) == 1) "an empty model says why on its slide")
        def notes:string (join (deck.smartArtNotes()) "\n")
        this.ok(((indexOf notes "empty.xml") >= 0) ("and the notes say so: " + notes))
    }

    ; the leftmost x to the rightmost end of the texts from `first` to `last`
    sfn inkWidth:double (l:EVGDisplayList first:string last:string) {
        def x0:double 0.0
        def x1:double 0.0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((c.kind == 3) && (c.text == first)) {
                x0 = c.x
            }
            if ((c.kind == 3) && (c.text == last)) {
                x1 = (c.x + c.w)
            }
            i = (i + 1)
        }
        return (x1 - x0)
    }

    sfn textY:double (l:EVGDisplayList word:string) {
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((c.kind == 3) && (c.text == word)) {
                return c.y
            }
            i = (i + 1)
        }
        return -1.0
    }

    ; phase 2's layouts in a deck: a cycle, a pyramid, an organisation chart
    ; with an assistant, and a radial, each drawn with its text and nothing
    ; to warn about
    fn smartArtLayouts:void () {
        def head:string "<dgm:dataModel xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\"><dgm:ptLst><dgm:pt modelId=\"0\" type=\"doc\"/>"
        def flat:string (head + "<dgm:pt modelId=\"1\"><dgm:t><a:p><a:r><a:t>Kevät</a:t></a:r></a:p></dgm:t></dgm:pt><dgm:pt modelId=\"2\"><dgm:t><a:p><a:r><a:t>Kesä</a:t></a:r></a:p></dgm:t></dgm:pt><dgm:pt modelId=\"3\"><dgm:t><a:p><a:r><a:t>Syksy</a:t></a:r></a:p></dgm:t></dgm:pt></dgm:ptLst><dgm:cxnLst><dgm:cxn srcId=\"0\" destId=\"1\"/><dgm:cxn srcId=\"0\" destId=\"2\"/><dgm:cxn srcId=\"0\" destId=\"3\"/></dgm:cxnLst></dgm:dataModel>")
        def org:string (head + "<dgm:pt modelId=\"a\"><dgm:t><a:p><a:r><a:t>Toimitusjohtaja</a:t></a:r></a:p></dgm:t></dgm:pt><dgm:pt modelId=\"s\" type=\"asst\"><dgm:t><a:p><a:r><a:t>Assistentti</a:t></a:r></a:p></dgm:t></dgm:pt><dgm:pt modelId=\"b\"><dgm:t><a:p><a:r><a:t>Myynti</a:t></a:r></a:p></dgm:t></dgm:pt><dgm:pt modelId=\"c\"><dgm:t><a:p><a:r><a:t>Talous</a:t></a:r></a:p></dgm:t></dgm:pt></dgm:ptLst><dgm:cxnLst><dgm:cxn srcId=\"0\" destId=\"a\"/><dgm:cxn srcId=\"a\" destId=\"s\"/><dgm:cxn srcId=\"a\" destId=\"b\"/><dgm:cxn srcId=\"a\" destId=\"c\"/></dgm:cxnLst></dgm:dataModel>")
        def text:string "---\nslide-split-level: 2\n---\n\n## Kierto\n\n![Kierto](media/flat.xml)\n{layout=cycle2}\n\n## Pyramidi\n\n![Pyramidi](media/flat.xml)\n{layout=pyramid1}\n\n## Organisaatio\n\n![Organisaatio](media/org.xml)\n{layout=orgChart1}\n\n## Säteet\n\n![Säteet](media/org.xml)\n{layout=radial1}\n"
        def css:string "page { width: 13.333in; height: 7.5in; padding: 0.6in; background-color: #ffffff } deck { split-level: 2 } document { color: #111111; font-size: 20pt } figure { colors: #1f6feb #0f9d8a #7c4dff }"
        def deck (new PresDeck())
        deck.md.setStyleSheet(css)
        deck.setTheme(css)
        deck.addImage("/media/flat.xml" (buffer_from_string (EVGCodepoint.encodeUtf8(flat))) "" 0 0)
        deck.addImage("/media/org.xml" (buffer_from_string (EVGCodepoint.encodeUtf8(org))) "" 0 0)
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 4) ("four slides of phase 2 layouts, got " + (to_string (deck.slideCount()))))
        if ((deck.slideCount()) < 4) {
            return
        }
        def notes:[string] (deck.smartArtNotes())
        this.ok(((array_length notes) == 0) ("nothing to warn about: " + (join notes "; ")))
        def l0:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        this.ok((((PresCheck.texts(l0 "Kevät")) == 1) && ((PresCheck.texts(l0 "Syksy")) == 1)) "a cycle: every item drawn")
        def l1:EVGDisplayList (PresTimeline.finalFrame(deck 1))
        this.ok(((PresCheck.texts(l1 "Kesä")) == 1) "a pyramid: drawn")
        def l2:EVGDisplayList (PresTimeline.finalFrame(deck 2))
        this.ok((((PresCheck.texts(l2 "Toimitusjohtaja")) == 1) && ((PresCheck.texts(l2 "Assistentti")) == 1)) "an organisation chart with its assistant")
        this.ok(((PresCheck.texts(l2 "Talous")) == 1) "and the row under it")
        def l3:EVGDisplayList (PresTimeline.finalFrame(deck 3))
        this.ok((((PresCheck.texts(l3 "Toimitusjohtaja")) == 1) && ((PresCheck.texts(l3 "Myynti")) == 1)) "a radial: the centre and round it")
        this.ok(((PresCheck.images(l3 "/media/org.xml")) == 0) "none drawn as a picture of the file")
    }

    sfn images:int (l:EVGDisplayList src:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((c.kind == 2) && (c.src == src)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn fills:int (l:EVGDisplayList r:int g:int b:int) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if (((c.r == r) && (c.g == g)) && (c.b == b)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn textsLike:int (l:EVGDisplayList start:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((indexOf c.text start) == 0) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; The diagram window's model: what it reads, and that only what changed
    ; is written again.
    fn flowModel:void () {
        def src:string "```mermaid\nflowchart LR\n  %% a comment\n  A[Alku] --> B(Selain)\n  B -->|ääni| C{\"Gemini [live]\"}\n  classDef hot fill:#f00\n  C -- vastaus --> A\n```\n{style=holo tour=on}"
        def m:PresFlowModel (PresFlowModel.read(src))
        this.ok((m.ok && m.editable) "a flowchart reads as one that can be edited")
        this.ok(((m.markdown()) == src) ("read and written untouched it is the same text: " + (m.markdown())))
        this.ok((m.dir == "LR") "its direction")
        this.ok(((array_length (m.liveNodes())) == 3) ("three boxes, got " + (to_string (array_length (m.liveNodes())))))
        this.ok(((array_length (m.liveEdges())) == 3) "three links")
        this.ok((((m.labelOf("C")) == "Gemini [live]") && ((m.labelOf("B")) == "Selain")) ("words, quoted or not: " + (m.labelOf("C"))))
        def e1:PresFlowEdge (itemAt m.edges 1)
        def e2:PresFlowEdge (itemAt m.edges 2)
        this.ok(((e1.label == "ääni") && ((e2.label == "vastaus") && (e2.op == "-->"))) ("link words both ways: " + e1.label + " / " + e2.label))
        this.ok((((m.look()) == "holo") && (m.flag("tour"))) "its look and the tour")
        ; edits touch their own lines only
        m.setLabel("A" "Kokous")
        m.setDir("TD")
        m.setLook("sketch")
        m.setFlag("ball" false)
        def out:string (m.markdown())
        this.ok(((indexOf out "flowchart TD") > 0) "the direction written")
        this.ok(((indexOf out "  A[Kokous] --> B(Selain)\n") > 0) ("a box's words where it is defined: " + out))
        this.ok((((indexOf out "  %% a comment\n") > 0) && ((indexOf out "  classDef hot fill:#f00\n") > 0)) "the lines it does not read stay")
        this.ok(((indexOf out "  C -- vastaus --> A\n") > 0) "a line not changed keeps its way of writing")
        this.ok(((indexOf out "{style=sketch tour=on ball=off}") > 0) ("the options: " + out))
        ; a link restyled, one taken out, one added; a box added and one taken out
        m.setEdgeLine(2 "dotted")
        m.removeEdge(1)
        def nid:string (m.findOrAdd("Uusi"))
        m.addEdge("B" nid "kyllä")
        m.removeNode("C")
        def out2:string (m.markdown())
        this.ok(((indexOf out2 "C{") < 0) ("the box and its links go: " + out2))
        this.ok(((indexOf out2 "  B -->|kyllä| N1[Uusi]\n") > 0) ("a new box linked: " + out2))
        def back:PresFlowModel (PresFlowModel.read(out2))
        this.ok((((array_length (back.liveNodes())) == 3) && ((back.labelOf("N1")) == "Uusi")) ("read back: " + out2))
        ; a box left with no links stays, alone
        def m2:PresFlowModel (PresFlowModel.read("```mermaid\ngraph TD\n  A[Yksi] --> B[Kaksi]\n```"))
        m2.removeEdge(0)
        def o3:string (m2.markdown())
        this.ok(((indexOf o3 "  A[Yksi]\n  B[Kaksi]\n") > 0) ("unlinked boxes stay: " + o3))
        m2.setShape("A" "((" "))")
        this.ok(((indexOf (m2.markdown()) "A((Yksi))") > 0) "a shape")
        ; another notation: options only
        def d2:PresFlowModel (PresFlowModel.read("```d2\na -> b\n```"))
        this.ok((d2.ok && (d2.editable == false)) "D2 is edited for its look only")
        d2.setLook("classic")
        this.ok(((d2.markdown()) == "```d2\na -> b\n```\n{diagram=classic}") ("its options under it: " + (d2.markdown())))
        def seq:PresFlowModel (PresFlowModel.read("```mermaid\nsequenceDiagram\n  A->>B: hei\n```"))
        this.ok((seq.ok && (seq.editable == false)) "a sequence diagram too")
    }

    ; The table window's model: cells, alignments, rows and columns.
    fn gridModel:void () {
        def src:string "| Alue | Myynti |\n| :--- | ---: |\n| Etelä | 120 |\n| Pohjoinen \\| itä | `a|b` |"
        def m:PresGridModel (PresGridModel.read(src))
        this.ok((m.ok && (((m.cols()) == 2) && ((m.rowCount()) == 2))) "a table: two columns, two rows")
        this.ok((((itemAt m.aligns 0) == "left") && ((itemAt m.aligns 1) == "right")) "its alignments")
        this.ok((((m.cell(1 0)) == "Pohjoinen | itä") && ((m.cell(1 1)) == "`a|b`")) ("an escaped bar and one in code: " + (m.cell(1 0)) + " / " + (m.cell(1 1))))
        this.ok(((m.cell(-1 1)) == "Myynti") "the header")
        m.setCell(0 1 "130")
        m.setAlign(1 "center")
        m.addRow()
        m.setCell(2 0 "Länsi")
        m.addCol("Kasvu")
        m.moveRow(2 -1)
        def out:string (m.markdown())
        this.ok((out == "| Alue | Myynti | Kasvu |\n| :--- | :---: | --- |\n| Etelä | 130 |  |\n| Länsi |  |  |\n| Pohjoinen \\| itä | `a\\|b` |  |") ("written whole: " + out))
        this.ok((((m.moveCol(0 1)) && ((m.cell(-1 0)) == "Myynti")) && ((itemAt m.aligns 1) == "left")) "a column moved, its alignment with it")
        m.removeCol(1)
        m.removeRow(0)
        def back:PresGridModel (PresGridModel.read((m.markdown())))
        this.ok((back.ok && (((back.cols()) == 2) && ((back.rowCount()) == 2))) ("read back: " + (m.markdown())))
        this.ok(((PresGridModel.read("| a |\n| b |")).ok == false) "no delimiter row: not a table")
        ; a data file's table
        def f:PresGridModel (PresGridModel.read("```table\ndata/sales.csv\nrows: 8\nfoo: bar\n```"))
        this.ok((f.ok && ((f.kind == "file") && ((f.file == "data/sales.csv") && ((f.option("rows")) == "8")))) "a data file's table and its options")
        f.setOption("rows" "5")
        f.setOption("columns" "Region, Revenue")
        this.ok(((f.markdown()) == "```table\ndata/sales.csv\nrows: 5\nfoo: bar\ncolumns: Region, Revenue\n```") ("its options written in place: " + (f.markdown())))
    }

    ; A diagram's buttons: up while the pointer moves over it, gone when it
    ; rests or leaves, held by an open menu, brought up by a tap.
    fn controlsFade:void () {
        def f (new PresControlsFade())
        this.ok(((f.alpha(10.0)) == 0.0) "fade: hidden before the pointer comes")
        this.ok((! (f.shown(10.0))) "fade: and not pressable")
        f.move(10.0 true false)
        this.ok(((f.alpha(10.0)) == 0.0) "fade: fading in from nothing")
        this.ok((f.busy(10.05)) "fade: busy while fading in")
        this.ok(((f.alpha(10.2)) == 1.0) "fade: in after the fade")
        this.ok((! (f.busy(11.0))) "fade: nothing to draw while up and moving")
        f.move(11.0 true false)
        this.ok(((f.alpha(13.4)) == 1.0) ("fade: a move keeps them up: " + (to_string (f.alpha(13.4)))))
        this.ok(((f.alpha(13.7)) < 1.0) "fade: resting 2.5 s starts the fade")
        this.ok((f.busy(13.7)) "fade: busy while fading out")
        this.ok(((f.alpha(14.0)) == 0.0) "fade: gone after it")
        this.ok((! (f.busy(14.5))) "fade: and then nothing to draw")
        ; back from half way out: up again from there, not from nothing
        f.move(20.0 true false)
        def mid:double 22.725
        def half:double (f.alpha(mid))
        this.ok(((half > 0.4) && (half < 0.6)) ("fade: half out: " + (to_string half)))
        f.move(mid true false)
        this.ok(((fabs ((f.alpha(mid)) - half)) < 0.001) "fade: a move picks up where the fade was")
        this.ok(((f.alpha((mid + 0.1))) == 1.0) "fade: and is quickly in")
        ; leaving the diagram sends them at once
        f.move(30.0 true false)
        f.move(30.5 false false)
        this.ok(((f.alpha(30.6)) < 1.0) "fade: leaving starts the fade")
        this.ok(((f.alpha(31.0)) == 0.0) "fade: gone after leaving")
        ; resting on a button keeps them
        f.move(40.0 true true)
        this.ok(((f.alpha(60.0)) == 1.0) "fade: resting on a button keeps them")
        f.move(60.0 true false)
        this.ok(((f.alpha(63.0)) == 0.0) "fade: off the button they rest away")
        ; an open menu holds them
        f.hold = true
        this.ok(((f.alpha(70.0)) == 1.0) "fade: an open menu holds them")
        this.ok((! (f.busy(70.0))) "fade: held is still")
        f.hold = false
        ; a tap brings them up for the rest, then they go
        f.press(80.0)
        this.ok((f.shown(80.2)) "fade: a tap brings them up")
        this.ok((f.shown(82.0)) "fade: and they stay a while")
        this.ok(((f.alpha(83.5)) == 0.0) "fade: then go")
        f.move(90.0 false false)
        this.ok(((f.alpha(90.0)) == 0.0) "fade: a pointer outside does not bring them")

        ; on the stage: a press where a hidden button is goes past it
        def text:string ("---\nslide-split-level: 2\n---\n\n## Kaavio\n\n```mermaid\nflowchart LR\n  A[Alku] --> B[Loppu]\n```\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        if ((array_length s.diagrams) == 0) {
            this.ok(false "fade: the diagram is there")
            return
        }
        def u:PresDiaUse (itemAt s.diagrams 0)
        def px:double ((u.bx + u.bw) - 150.0)
        def py:double ((u.by + u.bh) - 24.0)
        def t:double (u.start + 30.0)
        deck.uiNow = 100.0
        this.ok(((deck.diagramHit(0 t px py)) != "0:zin") "fade: a hidden + is not pressed")
        deck.diagramPointer(0 0 t px py)
        deck.uiNow = 100.3
        this.ok(((deck.diagramHit(0 t px py)) == "0:zin") "fade: over the diagram the + is pressed")
        this.ok(u.diagram.ctl.onCtl "fade: the pointer is on a button")
        deck.uiNow = 101.0
        deck.diagramPointer(0 -1 t 0.0 0.0)
        deck.uiNow = 102.0
        this.ok(((deck.diagramHit(0 t px py)) != "0:zin") "fade: after leaving, not again")
        deck.diagramTouched(0 0)
        deck.uiNow = 102.3
        this.ok(((deck.diagramHit(0 t px py)) == "0:zin") "fade: a tap brings it up")
    }

    ; Someone else's edits under the slide shown (PresFollow): it stays the
    ; slide shown, at the same time into it.
    fn followEdits:void () {
        def head:string "---\nslide-split-level: 2\n---\n\n"
        def text:string (head + "## Yksi\n\na\n\n## Kaksi\n\nb\n\n## Kolme\n\nc\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 3) "follow: three slides")
        if ((deck.slideCount()) != 3) {
            return
        }
        ; showing "Kolme", 1.5 s into it; a slide is added at the top
        def f (new PresFollow())
        def clock:double ((PresTimeline.slideStart(deck 2)) + 1.5)
        f.begin(deck 2 clock)
        def add:string "## Nolla\n\nz\n\n"
        def at:int (strlen head)
        f.edit(at 0 (strlen add))
        def text2:string (((substring text 0 at) + add) + (substring text at (strlen text)))
        deck.setText(text2)
        PresTimeline.planAll(deck)
        def s:int (f.slide(deck))
        this.ok((s == 3) ("follow: a slide added before keeps Kolme shown, got " + (to_string s)))
        def back:double ((f.clockOn(deck s)) - (PresTimeline.slideStart(deck s)))
        this.ok(((back > 1.49) && (back < 1.51)) ("follow: as far into it, got " + (to_string back)))
        ; "Yksi" removed: Kolme moves back by one
        def from:int (indexOf text2 "## Yksi")
        def till:int (indexOf text2 "## Kaksi")
        f.begin(deck 3 0.0)
        f.edit(from (till - from) 0)
        def text3:string ((substring text2 0 from) + (substring text2 till (strlen text2)))
        deck.setText(text3)
        PresTimeline.planAll(deck)
        s = (f.slide(deck))
        this.ok((s == 2) ("follow: a slide removed before, got " + (to_string s)))
        ; typing on the slide shown, and after it, keeps it
        f.begin(deck 1 0.0)
        def k:int ((indexOf text3 "\nb\n") + 1)
        f.edit(k 0 3)
        def text4:string (((substring text3 0 k) + "xyz") + (substring text3 k (strlen text3)))
        deck.setText(text4)
        PresTimeline.planAll(deck)
        s = (f.slide(deck))
        this.ok((s == 1) ("follow: typing on the slide keeps it, got " + (to_string s)))
        ; the moves themselves
        this.ok(((PresFollow.moved(10 2 3 0)) == 7) "follow: removed before")
        this.ok(((PresFollow.moved(10 10 0 4)) == 14) "follow: put in where it starts goes before")
        this.ok(((PresFollow.moved(10 11 5 1)) == 10) "follow: after it")
        this.ok(((PresFollow.moved(10 8 5 2)) == 10) "follow: its start removed, from the edit's end")
        this.ok(((PresFollow.moved(-1 0 0 4)) == -1) "follow: not known stays so")
    }

    ; Slides picked in the strip (PresPick), and a view of only some of them
    ; named by their sections' keys.
    fn picks:void () {
        def p (new PresPick())
        this.ok(((p.active()) == false) "pick: empty at first")
        ; Ctrl + click on 3 with 1 selected picks both
        p.toggle(3 1)
        this.ok(((p.list()) == "2,4") ("pick: ctrl+click picks the selected one too, got " + (p.list())))
        p.toggle(0 1)
        this.ok(((p.list()) == "1,2,4") ("pick: kept in deck order, got " + (p.list())))
        p.toggle(1 1)
        this.ok(((p.list()) == "1,4") ("pick: ctrl+click again lets go, got " + (p.list())))
        ; Shift + click: the run from the last one clicked
        p.extend(4 1)
        this.ok(((p.list()) == "2,3,4,5") ("pick: shift+click from the last clicked, got " + (p.list())))
        p.extend(0 1)
        this.ok(((p.list()) == "1,2") ("pick: shift+click again from the same anchor, got " + (p.list())))
        p.limit(1)
        this.ok(((p.list()) == "1") ("pick: past the deck's end let go, got " + (p.list())))
        p.clear()
        this.ok(((p.count()) == 0) "pick: cleared")
        def q (new PresPick())
        q.extend(2 -1)
        this.ok(((q.list()) == "3") ("pick: shift+click with nothing selected, got " + (q.list())))

        this.ok(((PresPick.slug("Tulos 2025: **hyvä**!")) == "tulos-2025-hyvä") ("pick: slug, got " + (PresPick.slug("Tulos 2025: **hyvä**!"))))
        this.ok(((PresPick.headingKey("## Eka {#intro transition=slide}")) == "intro") "pick: an id is the key")
        this.ok(((PresPick.headingKey("## Eka {transition=slide} ##")) == "eka") "pick: attributes are not words")
        this.ok(((PresPick.headingKey("##")) == "slide") "pick: an empty heading")
        this.ok(((PresPick.headingLevel("#hashtag")) == 0) "pick: #word is no heading")
        this.ok(((PresPick.headingLevel("### Kolme")) == 3) "pick: heading level")

        def head:string "---\ntitle: Raportti\nslide-split-level: 2\n---\n\n"
        def text:string (head + "Kansi\n\n## Yksi\n\na\n\n### Alaotsikko\n\nb\n\n```python\n## not a heading\n```\n\n::: notes\n## Puhe\n:::\n\n## Kaksi\n\nc\n\n## Yksi\n\nd\n")
        this.ok(((PresPick.frontEnd(text)) == (strlen head) - 1) ("pick: front matter end, got " + (to_string (PresPick.frontEnd(text)))))
        def secs:[PresPickSection] (PresPick.sections(text 2))
        this.ok(((array_length secs) == 4) ("pick: four sections, got " + (to_string (array_length secs))))
        if ((array_length secs) == 4) {
            this.ok(((itemAt secs 0).key == "start") "pick: the text above the first heading")
            this.ok(((itemAt secs 1).key == "yksi") "pick: a section's key")
            this.ok(((itemAt secs 2).key == "kaksi") "pick: fences and notes hold no headings")
            this.ok(((itemAt secs 3).key == "yksi~2") "pick: the same words again")
        }
        def view:string (PresPick.viewText(text 2 "yksi~2,kaksi"))
        this.ok(((indexOf view "title: Raportti") > 0) "pick: the view keeps the front matter")
        this.ok(((indexOf view "## Kaksi\n\nc\n\n## Yksi\n\nd\n") > 0) ("pick: the view in the deck's order: " + view))
        this.ok(((indexOf view "Kansi") < 0) "pick: the rest left out")
        this.ok(((PresPick.viewText(text 2 "nothing")) == "") "pick: no section named")
        this.ok(((PresPick.viewText("## A\n\nx\n" 2 "a")) == "## A\n\nx\n") "pick: no front matter")

        ; the pages of a deck: keys by their sections, and the view a deck
        ; of those slides only
        def deck (new PresDeck())
        deck.setText(text)
        def n:int (deck.slideCount())
        this.ok((n == 4) ("pick: the deck has four slides, got " + (to_string n)))
        def pages:[int]
        push pages 3
        push pages 1
        def keys:string (PresPick.keysOfPages(deck text pages))
        this.ok((keys == "yksi,yksi~2") ("pick: the pages' keys, got " + keys))
        ; a slide added at the top: the same keys name the same slides
        def text2:string ((head + "## Uusi\n\nz\n\n") + (substring text (strlen head) (strlen text)))
        def v2:string (PresPick.viewText(text2 2 keys))
        deck.setText(v2)
        this.ok(((deck.slideCount()) == 2) ("pick: the view is two slides, got " + (to_string (deck.slideCount()))))
        this.ok(((indexOf v2 "Uusi") < 0) "pick: the added slide is not in the view")
    }

    ; PresNav: the jumps while presenting (Home, End, PageUp/PageDown, a
    ; typed number) and where each lands
    ; Drawing over a slide (PresInk) and a recorded presentation (PresRecord).
    fn recording:void () {
        def ink (new PresInk())
        ink.down("pen" "#ef4444" 6.0 10.0 10.0)
        ink.move(20.0 12.0)
        ink.move(30.0 18.0)
        ink.move(40.0 30.0)
        ink.up()
        this.ok(((ink.count()) == 1) "ink: one stroke")
        def s0:PresInkStroke (itemAt ink.strokes 0)
        def sm:[double] (PresInk.smooth(s0.pts))
        this.ok(((array_length sm) > 8) ("ink: smoothing adds points, " + (to_string (array_length sm))))
        this.ok((((itemAt sm 0) == 10.0) && ((itemAt sm ((array_length sm) - 1)) == 30.0)) "ink: smoothing keeps the ends")
        ; a line and an ellipse keep the press and the latest point only
        ink.down("line" "#fff" 4.0 0.0 0.0)
        ink.move(5.0 5.0)
        ink.move(50.0 0.0)
        ink.up()
        def ls:PresInkStroke (itemAt ink.strokes 1)
        this.ok(((array_length ls.pts) == 4) "ink: a line is two points")
        this.ok(((itemAt ls.pts 2) == 50.0) "ink: a line ends where it was let go")
        def el:[double] (PresInk.ellipse(0.0 0.0 100.0 50.0))
        this.ok((((fabs ((itemAt el 0) - 100.0)) < 0.001) && ((fabs ((itemAt el 1) - 25.0)) < 0.001)) "ink: the ellipse starts at its right edge")
        this.ok(((fabs ((itemAt el 0) - (itemAt el ((array_length el) - 2)))) < 0.001) "ink: the ellipse is closed")
        ; an arrow's head points the way the line went (to the right here)
        def hl:[double] ([] _:double (0.0 0.0 50.0 0.0 100.0 0.0))
        def hd:[double] (PresInk.head(hl 6.0))
        this.ok(((array_length hd) == 6) "ink: an arrow has a head")
        this.ok((((itemAt hd 0) == 100.0) && ((itemAt hd 2) < 100.0)) "ink: the tip is at the end, the base behind it")
        this.ok((((itemAt hd 3) > 0.0) && ((itemAt hd 5) < 0.0)) "ink: the head is as wide either side")
        def none:[double] ([] _:double (5.0 5.0 5.0 5.0))
        this.ok(((array_length (PresInk.head(none 6.0))) == 0) "ink: no head without a direction")
        ; the pointer stays, then fades
        ink.pointer(100.0 100.0 10.0)
        this.ok(((ink.pointerAlpha(11.0)) == 1.0) "ink: the pointer shows while it moves")
        def mid:double (ink.pointerAlpha(11.75))
        this.ok(((mid > 0.0) && (mid < 1.0)) ("ink: then fades, " + (to_string mid)))
        this.ok(((ink.pointerAlpha(13.0)) == 0.0) "ink: and is gone")
        this.ok((ink.busy(11.9) && ((ink.busy(13.0)) == false)) "ink: busy only while fading")
        def dl (new EVGDisplayList())
        ink.draw(dl 11.0 1.0)
        this.ok(((array_length dl.cmds) >= 4) ("ink: strokes and the pointer drawn, " + (to_string (array_length dl.cmds))))
        ink.clear()
        this.ok(((ink.count()) == 0) "ink: Backspace wipes it")

        ; the recorder writes nav only where the clock cannot be worked out
        def r (new PresRecorder())
        this.ok((r.observe(0.0 0 0 0.0 false)) "rec: the start is written")
        this.ok(((r.observe(0.5 0 0 0.5 false)) == false) "rec: running on is not")
        this.ok(((r.observe(1.0 0 0 0.6 false)) == false) "rec: held at a step is not")
        this.ok(((r.observe(4.0 0 0 0.6 false)) == false) "rec: still held")
        this.ok((r.observe(4.1 0 1 1.2 false)) "rec: a click to the next step is")
        this.ok((r.observe(4.2 2 0 10.0 false)) "rec: a jump is")
        this.ok(((r.observe(4.3 2 0 10.1 false)) == false) "rec: on from the jump is not")
        this.ok((r.observe(4.4 1 3 9.0 false)) "rec: back is")
        this.ok((r.pointer(1.0 10.0 10.0)) "rec: the pointer is written")
        this.ok(((r.pointer(1.01 30.0 30.0)) == false) "rec: not more than 30 times a second")
        this.ok(((r.pointer(1.2 10.2 10.2)) == false) "rec: not when it hardly moved")
        r.rec.down(5.0 "arrow" "#22c55e" 5.0 1.0 2.0)
        r.rec.move(5.1 3.0 4.0)
        r.rec.up(5.2)
        r.rec.clear(6.0)
        r.rec.voice = "radio"
        r.rec.audio = "recordings/take.webm"
        def text:string (r.rec.toJson())
        def back:PresRecording (PresRecording.parse(text))
        this.ok(((back.count()) == (r.rec.count())) ("rec: the file reads back, " + (to_string (back.count())) + " of " + (to_string (r.rec.count()))))
        this.ok(((back.voice == "radio") && (back.audio == "recordings/take.webm")) "rec: with its voice and its sound file")
        this.ok(((fabs (back.duration - 6.0)) < 0.001) ("rec: and its length, " + (to_string back.duration)))
        def bd:PresRecOp (itemAt back.ops ((back.count()) - 4))
        this.ok((((bd.k == "down") && (bd.tool == "arrow")) && ((bd.color == "#22c55e") && (bd.y == 2.0))) "rec: a line's start reads back")
        def broken:PresRecording (PresRecording.parse("not json"))
        this.ok(((broken.count()) == 0) "rec: a broken file is an empty recording")
        ; when each slide shows
        def sp:[double] (back.slideSpans(0))
        this.ok((((array_length sp) == 2) && ((itemAt sp 1) == 4.2)) "rec: slide 1 shows until the jump")
        def sp2:[double] (back.slideSpans(2))
        this.ok((((array_length sp2) == 2) && ((itemAt sp2 0) == 4.2)) "rec: slide 3 from the jump")
        this.ok(((back.slideStart(5)) < 0.0) "rec: a slide never shown has no start")

        ; the replay: forward applies what is new, back starts over
        def rp (new PresReplay())
        rp.load(back)
        rp.seek(0.2)
        def n0:PresRecOp (rp.navOp())
        this.ok((rp.takeNav() && (n0.slide == 0)) "replay: the start's nav")
        this.ok(((fabs ((rp.clockAt(0.9)) - 0.9)) < 0.001) "replay: the clock runs from it")
        rp.seek(4.15)
        def n1:PresRecOp (rp.navOp())
        this.ok((rp.takeNav() && (n1.step == 1)) "replay: the click's step")
        rp.seek(5.15)
        this.ok(((rp.ink.count()) == 1) "replay: the line being drawn")
        this.ok(rp.ink.drawing "replay: still held")
        rp.seek(5.5)
        this.ok(((rp.ink.drawing == false) && ((rp.ink.count()) == 1)) "replay: let go")
        rp.takeNav()
        rp.seek(4.45)
        this.ok(((rp.ink.count()) == 0) "replay: back before the line, it is gone")
        this.ok(((rp.takeNav()) == false) "replay: the same nav after a seek is no jump")
        rp.seek(7.0)
        this.ok(((rp.ink.count()) == 0) "replay: wiped by the clear")
        this.ok((rp.done()) "replay: at the end")
    }

    fn navJumps:void () {
        def text:string ("---\nslide-split-level: 2\n---\n\n## Eka\n\n1. a\n2. b\n3. c\n{.build}\n\n"
            + "## Toka {transition=slide seconds=0.8}\n\nteksti\n\n## Kolmas\n\n1. x\n2. y\n{.build}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def n:int (deck.slideCount())
        this.ok((n == 3) ("nav: three slides, got " + (to_string n)))
        if (n != 3) {
            return
        }
        def s0:PresSlide (deck.slideAt(0))
        def s1:PresSlide (deck.slideAt(1))
        def s2:PresSlide (deck.slideAt(2))
        this.ok((s0.steps == 3) "nav: the first slide has three builds")
        this.ok(((s0.settled > 0.0) && (s0.settled < s0.duration)) ("nav: settled before the end, " + (to_string s0.settled)))
        this.ok(((fabs ((s0.duration - s0.settled) - s0.hold)) < 0.001) "nav: the hold comes after it")
        this.ok((s1.settled >= (PresTimeline.transitionSeconds(s1))) "nav: settled is past the transition")
        ; Home: the first slide at its start, builds to come
        def a:PresNavAt (PresNav.first(deck))
        this.ok((((a.slide == 0) && (a.step == 0)) && (a.clock == 0.0)) "nav: first is the start")
        ; PageDown: the next slide whole, past its transition
        def b:PresNavAt (PresNav.pageNext(deck 0 false))
        this.ok(((b.slide == 1) && (b.ended == false)) "nav: PageDown is the next slide")
        this.ok(((fabs (b.clock - ((PresTimeline.slideStart(deck 1)) + s1.settled))) < 0.001) "nav: at its settled time")
        this.ok((b.clock >= ((PresTimeline.slideStart(deck 1)) + (PresTimeline.transitionSeconds(s1)))) "nav: no transition left")
        def c:PresNavAt (PresNav.pageNext(deck 1 false))
        this.ok(((c.slide == 2) && (c.step == s2.steps)) "nav: PageDown shows every build")
        this.ok(((PresTimeline.slideAtTime(deck c.clock)) == 2) "nav: the clock is in that slide")
        def d:PresNavAt (PresNav.pageNext(deck 2 false))
        this.ok(((d.slide == 2) && d.ended) "nav: PageDown on the last slide is the end")
        ; PageUp
        def e:PresNavAt (PresNav.pagePrev(deck 2 true))
        this.ok(((e.slide == 2) && (e.ended == false)) "nav: PageUp from the end is the last slide")
        def f:PresNavAt (PresNav.pagePrev(deck 2 false))
        this.ok(((f.slide == 1) && (f.step == s1.steps)) "nav: PageUp is the slide before, whole")
        def g:PresNavAt (PresNav.pagePrev(deck 1 false))
        this.ok(((g.slide == 0) && (g.step == 3)) "nav: PageUp to the first slide shows its builds")
        def h:PresNavAt (PresNav.pagePrev(deck 0 false))
        this.ok(((h.slide == 0) && (h.clock == 0.0)) "nav: PageUp on the first slide is its start")
        ; End
        def l:PresNavAt (PresNav.last(deck))
        this.ok((((l.slide == 2) && (l.step == 2)) && (l.ended == false)) "nav: End is the last slide whole")
        ; numbers
        this.ok(((PresNav.number("2" 3)) == 1) "nav: 2 is the second slide")
        this.ok(((PresNav.number(" 3 " 3)) == 2) "nav: spaces around")
        this.ok(((PresNav.number("99" 3)) == 2) "nav: past the end is the last")
        this.ok(((PresNav.number("0" 3)) == 0) "nav: 0 is the first")
        this.ok(((PresNav.number("" 3)) == -1) "nav: nothing is no number")
        this.ok(((PresNav.number("2a" 3)) == -1) "nav: letters are no number")
        this.ok(((PresNav.number("1" 0)) == -1) "nav: no slides")
        def w:PresNavAt (PresNav.whole(deck 7))
        this.ok((w.slide == 2) "nav: whole holds the index inside the deck")
        ; the label and the typed number
        this.ok(((PresNav.label(0 3 "")) == "1 / 3") "nav: label")
        this.ok(((PresNav.label(2 3 "12")) == "12 / 3") "nav: label while typing")
        def nav (new PresNav())
        this.ok((nav.digit("1")) "nav: a digit is taken")
        this.ok((! (nav.digit("x"))) "nav: a letter is not")
        nav.digit("2")
        nav.digit("3")
        nav.digit("4")
        nav.digit("5")
        this.ok((nav.typed == "1234") ("nav: four digits at most, got " + nav.typed))
        nav.clear()
        nav.digit("2")
        this.ok(((nav.take(3)) == 1) "nav: Enter takes the number")
        this.ok(((nav.typing()) == false) "nav: and it is gone")
        this.ok(((nav.take(3)) == -1) "nav: Enter with nothing typed")
        ; an empty deck lands nowhere in particular
        def empty (new PresDeck())
        def z:PresNavAt (PresNav.pageNext(empty 0 false))
        this.ok((((z.slide == 0) && (z.ended == false)) && (z.clock == 0.0)) "nav: an empty deck")
    }

    ; PresDocx + DocxWriter: the deck as a Word document, opened again with
    ; Ranger's own .docx reader (WordMlParser) and compared
    ; The deck as one web page: sections per slide, notes, the shot written in,
    ; nothing that runs, headings linkable, picked slides only.
    fn htmlPage:void () {
        def text:string ("---\ntitle: Raportti\nlang: fi\nslide-split-level: 2\n---\n\n"
            + "## Eka & toka\n\nTeksti [linkki](https://sliqtly.com) ja [paha](javascript:alert(1)).\n\n<script>alert(2)</script>\n\n"
            + "::: notes\nPuhe ensin. [[1]] Sitten.\n:::\n\n"
            + "## Taulu\n\n| Nimi | Määrä |\n| :--- | ---: |\n| omena | 3 |\n\n$$\\frac{a}{b}$$\n\n"
            + "## Kuva\n\n```mermaid\nflowchart LR\n  A --> B\n```\n")
        def deck (new PresDeck())
        deck.setText(text)
        def shots (new PresDocx())
        shots.findShots(deck)
        this.ok(((array_length shots.shots) == 1) "html: the diagram is a shot")
        if ((array_length shots.shots) == 1) {
            def s0:PresDocxShot (itemAt shots.shots 0)
            def png:buffer (buffer_alloc 3)
            buffer_set png 0 77
            buffer_set png 1 97
            buffer_set png 2 110
            shots.setShot(s0.key png 200 100)
        }
        def page (new PresHtml())
        def h:string (page.html(deck "Raportti" shots))
        this.ok(((indexOf h "<!DOCTYPE html>") == 0) "html: a whole page")
        this.ok(((indexOf h "<html lang=\"fi\">") > 0) "html: the deck's language")
        this.ok(((indexOf h "<title>Raportti</title>") > 0) "html: its title")
        this.ok(((indexOf h "<p class=\"title\">Raportti</p>") > 0) "html: the title on the page (no heading says it)")
        this.ok((page.slides == 3) ("html: three slides, got " + (to_string page.slides)))
        this.ok(((indexOf h "<section class=\"slide\" id=\"slide-3\">") > 0) "html: a section per slide")
        this.ok(((indexOf h "<h2 id=\"eka-toka\">Eka &amp; toka</h2>") > 0) "html: headings escaped and linkable")
        this.ok(((indexOf h "href=\"https://sliqtly.com\"") > 0) "html: the link")
        this.ok(((indexOf h "<a>paha</a>") > 0) "html: a script link loses its address")
        this.ok(((indexOf h "<script") < 0) "html: nothing that runs")
        this.ok(((indexOf h "<td align=\"right\">3</td>") > 0) "html: the table, aligned")
        this.ok(((indexOf h "class=\"math-display\"") > 0) "html: the formula")
        this.ok(((indexOf h "<svg") > 0) "html: …drawn as SVG")
        this.ok((page.notes == 1) "html: one slide's notes")
        this.ok(((indexOf h "<aside class=\"notes\">\n<p>Puhe ensin.  Sitten.</p>") > 0) "html: notes without cues")
        this.ok((page.shotsPlaced == 1) "html: the shot placed")
        this.ok(((indexOf h "<img src=\"data:image/png;base64,TWFu\"") > 0) "html: …written in")
        this.ok(((indexOf h "flowchart LR") < 0) "html: the diagram's source not also written")
        this.ok(((indexOf h "slide-split-level") < 0) "html: no front matter")

        def none (new PresDocx())
        def plain (new PresHtml())
        def bare:string (plain.html(deck "" none))
        this.ok(((indexOf bare "<code class=\"language-mermaid\">") > 0) "html: no shot, the diagram as its source")

        def picked (new PresHtml())
        push picked.onlyPages 1
        def one:string (picked.html(deck "Raportti" none))
        this.ok((picked.slides == 1) "html: only the picked slide")
        this.ok((((indexOf one "slide-2") > 0) && ((indexOf one "Eka") < 0)) "html: …and nothing else")
    }

    fn docx:void () {
        def text:string ("---\ntitle: Raportti\nslide-split-level: 2\n---\n\n"
            + "## Eka & toka\n\nTeksti **lihava** ja [linkki](https://sliqtly.com).\n\n- yksi\n- kaksi\n  - sisempi\n\n"
            + "::: notes\nPuhe ensin. [[1]] Sitten.\n:::\n\n"
            + "## Taulu\n\n| Nimi | Määrä |\n| :--- | ---: |\n| omena | 3 |\n\n1. a\n2. b\n\nväli\n\n1. c\n\n"
            + "## Kuva\n\n```mermaid\nflowchart LR\n  A --> B\n```\n")
        def deck (new PresDeck())
        deck.setText(text)
        this.ok(((deck.slideCount()) == 3) ("docx: three slides, got " + (to_string (deck.slideCount()))))
        def conv (new PresDocx())
        conv.findShots(deck)
        this.ok(((array_length conv.shots) == 1) ("docx: the diagram is a shot, got " + (conv.shotsJson())))
        if ((array_length conv.shots) == 1) {
            def s0:PresDocxShot (itemAt conv.shots 0)
            this.ok((s0.page == 2) ("docx: the shot is on slide 3, got " + (to_string s0.page)))
            this.ok(((s0.w > 0.0) && (s0.h > 0.0)) "docx: the shot has a size")
            ; a stand-in picture: an 8-byte PNG signature is enough for the package
            def png:buffer (buffer_alloc 8)
            def sig:[int] ([] _:int (137 80 78 71 13 10 26 10))
            def k:int 0
            while (k < 8) {
                buffer_set png k (itemAt sig k)
                k = (k + 1)
            }
            conv.setShot(s0.key png 200 100)
        }
        def rd:RichDocument (conv.build(deck "Raportti"))
        this.ok((conv.slides == 3) ("docx: three slides written, got " + (to_string conv.slides)))
        this.ok((conv.notes == 1) "docx: one slide's notes")
        this.ok((conv.shotsPlaced == 1) "docx: the shot placed")
        this.ok(((PresDocx.notesText("Puhe ensin. [[1]] Sitten.")) == "Puhe ensin.  Sitten.") "docx: cues out of the notes")

        def w (new DocxWriter())
        def bytes:buffer (w.write(rd))
        this.ok(((buffer_length bytes) > 1000) "docx: a file came out")
        this.ok((w.tables == 1) "docx: one table written")
        this.ok((w.pictures == 1) "docx: one picture written")
        this.ok((w.unwritten == 0) ("docx: nothing written as its name, got " + (to_string w.unwritten)))

        def pkg (new DocxPackage())
        this.ok((pkg.openBytes(bytes "deck.docx")) "docx: the reader opens it")
        def xml:string (pkg.documentXml())
        this.ok(((indexOf xml "Eka &amp; toka") > 0) "docx: text escaped")
        this.ok(((indexOf xml "<w:hyperlink r:id=") > 0) "docx: the link is a hyperlink")
        def rels:string (pkg.documentRelsXml())
        this.ok(((indexOf rels "https://sliqtly.com") > 0) "docx: …to its target")
        this.ok(((buffer_length (pkg.opc.readBinary("word/media/image1.png"))) == 8) "docx: the picture's bytes in the package")
        this.ok(((pkg.opc.contentTypeFor("word/media/image1.png")) == "image/png") "docx: …as a PNG")
        def parser (new WordMlParser())
        def back:RichDocument (parser.parsePackage(pkg))
        def heads:string ""
        def bullets:int 0
        def numbered:[int]
        def notesSeen:string ""
        def title:string ""
        def pics:int 0
        def i:int 0
        while (i < (array_length back.blocks)) {
            def b:DocBlock (itemAt back.blocks i)
            if (b.kind == (DocBlockKind.para())) {
                def p:Paragraph b.paragraph
                if (p.styleId == "Heading2") {
                    heads = ((heads + (p.plainText())) + "|")
                }
                if (p.styleId == "Title") {
                    title = (p.plainText())
                }
                if (p.styleId == "Notes") {
                    notesSeen = (notesSeen + (p.plainText()))
                }
                if (p.listKind == 1) {
                    bullets = (bullets + 1)
                }
                if ((p.listKind == 2) && ((indexOf numbered p.listNumId) < 0)) {
                    push numbered p.listNumId
                }
                pics = (pics + (array_length p.images))
            }
            i = (i + 1)
        }
        this.ok((title == "Raportti") ("docx: the title, got " + title))
        this.ok((heads == "Eka & toka|Taulu|Kuva|") ("docx: the slides' headings, got " + heads))
        this.ok((bullets == 3) ("docx: three bullets, got " + (to_string bullets)))
        this.ok(((array_length numbered) == 2) ("docx: two numbered lists, each its own, got " + (to_string (array_length numbered))))
        this.ok((notesSeen == "Puhe ensin.  Sitten.") ("docx: the notes, got " + notesSeen))
        this.ok((pics == 1) ("docx: the picture read back, got " + (to_string pics)))
        this.ok(((array_length back.tables) == 1) "docx: the table read back")
        if ((array_length back.tables) == 1) {
            def t:DocumentTable (itemAt back.tables 0)
            this.ok((((t.rowCount()) == 2) && ((t.columnCount()) == 2)) "docx: two rows, two columns")
            def r0:DocTableRow (itemAt t.rows 0)
            def c1:DocTableCell (itemAt r0.cells 1)
            def cp:Paragraph (itemAt c1.paragraphs 0)
            this.ok(((cp.plainText()) == "Määrä") ("docx: a cell's words survive UTF-8, got " + (cp.plainText())))
            this.ok((cp.align == 2) "docx: the column's alignment")
            this.ok(((strlen c1.fillHex) == 6) "docx: the header row shaded")
        }
        def sec:DocSection (back.sectionAt(0))
        this.ok(((sec.pageWTwips == 11906) && (sec.pageHTwips == 16838)) ("docx: A4, got " + (to_string sec.pageWTwips) + "x" + (to_string sec.pageHTwips)))

        ; formulas are Word equations, not pictures
        def mdeck (new PresDeck())
        mdeck.setText("---\nslide-split-level: 2\n---\n\n## Kaava\n\nKun $a^2 + b^2 = c^2$ niin\n\n$$\n\\frac{1}{2}\n$$\n")
        def mconv (new PresDocx())
        mconv.findShots(mdeck)
        this.ok(((array_length mconv.shots) == 0) "docx: a formula is no shot")
        def mw (new DocxWriter())
        def mbytes:buffer (mw.write((mconv.build(mdeck ""))))
        this.ok((mw.equations == 2) ("docx: two equations written, got " + (to_string mw.equations)))
        def mpkg (new DocxPackage())
        mpkg.openBytes(mbytes "kaava.docx")
        def mxml:string (mpkg.documentXml())
        this.ok(((indexOf mxml "<m:oMathPara>") > 0) "docx: the display formula is an equation paragraph")
        this.ok(((indexOf mxml "<m:num") > 0) "docx: …with its fraction")
        this.ok(((indexOf mxml "<m:sSup") > 0) "docx: the inline one has its powers")
        this.ok(((indexOf mxml "a^2") < 0) "docx: no TeX left in the text")

        ; picked slides: only those
        def only (new PresDocx())
        push only.onlyPages 1
        def rd2:RichDocument (only.build(deck ""))
        this.ok((only.slides == 1) "docx: one picked slide")
        this.ok((only.notes == 0) "docx: …without the other slide's notes")
        this.ok(((array_length rd2.tables) == 1) "docx: …with its table")
        ; with page breaks between slides
        def paged (new PresDocx())
        paged.pageBreaks = true
        def rd3:RichDocument (paged.build(deck ""))
        def breaks:int 0
        def j:int 0
        while (j < (array_length rd3.blocks)) {
            if ((itemAt rd3.blocks j).kind == (DocBlockKind.pageBreak())) {
                breaks = (breaks + 1)
            }
            j = (j + 1)
        }
        this.ok((breaks == 2) ("docx: a break before slides 2 and 3, got " + (to_string breaks)))
    }

    ; --- the vectorizer (PresTrace, PresTraceSettings) -----------------------
    fn traceChecks:void () {
        def st (new PresTraceSettings())
        this.ok(((st.get("colorCount" "")) == "8") "trace: the default preset is illustration, 8 colours")
        st.usePreset("photo")
        st.set("colorCount" "30")
        this.ok(((st.intOf("colorCount" 0)) == 30) "trace: a set option wins over the preset")
        this.ok(((st.intOf("smooth" 0)) == 2) "trace: …the rest come from the preset")
        def back:PresTraceSettings (PresTraceSettings.parse((st.text())))
        this.ok((back.preset == "photo") "trace: the text keeps the preset")
        this.ok(((back.intOf("colorCount" 0)) == 30) "trace: …and what was set")
        st.set("colorCount" "")
        this.ok(((st.intOf("colorCount" 0)) == 24) "trace: an empty value takes the option off")
        def semi:PresTraceSettings (PresTraceSettings.parse("preset=logo;turdsize=3"))
        this.ok(((semi.intOf("turdsize" 0)) == 3) "trace: ; separates options too")
        this.ok(((PresTrace.unknown((PresTraceSettings.parse("colorcount=4")))) == "colorcount") "trace: a misspelt option is named")

        ; references
        def md:string "![a](media/x.png) and ![b](/media/x.png) not media/x.png.bak nor amedia/x.png"
        def sw:string (PresTraceRefs.swapRef(md "media/x.png" "media/x.svg"))
        this.ok((sw == "![a](media/x.svg) and ![b](/media/x.svg) not media/x.png.bak nor amedia/x.png") ("trace: swapRef, got " + sw))
        def css:string "page { background-image: url(\"media/x.png\"); }"
        this.ok(((PresTraceRefs.swapRef(css "/media/x.png" "media/x.svg")) == "page { background-image: url(\"media/x.svg\"); }") "trace: swapRef in CSS")
        this.ok(((PresTraceRefs.countRefs(md "media/x.png")) == 2) "trace: countRefs")

        ; a picture: white, a red block, a black block
        def w:int 60
        def h:int 40
        def px:buffer (buffer_alloc (w * h * 4))
        def y:int 0
        while (y < h) {
            def x:int 0
            while (x < w) {
                def o:int (((y * w) + x) * 4)
                def r:int 255
                def g:int 255
                def b:int 255
                if ((((x >= 6) && (x < 26)) && (y >= 8)) && (y < 32)) {
                    g = 0
                    b = 0
                }
                if ((((x >= 34) && (x < 54)) && (y >= 8)) && (y < 32)) {
                    r = 0
                    g = 0
                    b = 0
                }
                buffer_set px o r
                buffer_set px (o + 1) g
                buffer_set px (o + 2) b
                buffer_set px (o + 3) 255
                x = (x + 1)
            }
            y = (y + 1)
        }
        def res:PresTraceResult (PresTrace.traceRgba(px w h "preset=logo\ncolorCount=3"))
        this.ok(((strlen res.err) == 0) ("trace: traced without an error: " + res.err))
        this.ok((startsWith res.svg "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"60\" height=\"40\" viewBox=\"0 0 60 40\"") ("trace: the svg is the picture's size: " + (substring res.svg 0 90)))
        this.ok((res.layers >= 2) ("trace: a layer per colour, got " + (to_string res.layers) + " " + res.colors))
        this.ok(((indexOf (to_lowercase res.colors) "#000000") >= 0) ("trace: the black block is a layer: " + res.colors))
        def scaled:PresTraceResult (PresTrace.traceRgba(px w h "preset=logo\nmaxSide=30"))
        this.ok(((scaled.tracedW == 30) && (scaled.tracedH == 20)) ("trace: maxSide scales it down, got " + (to_string scaled.tracedW) + "x" + (to_string scaled.tracedH)))
        this.ok(((indexOf scaled.svg "width=\"60\" height=\"40\" viewBox=\"0 0 30 20\"") > 0) "trace: …and draws it at the picture's size")
        def bad:PresTraceResult (PresTrace.traceBytes((buffer_alloc 10) ""))
        this.ok(((strlen bad.err) > 0) "trace: bytes that are no picture say so")
    }

    ; --- a picture resized and moved on the slide (PresImageDrag) ---------------
    fn imageDrag:void () {
        ; the handles of a 200 × 100 box at (100, 50), a grip of 6
        this.ok(((PresImageDrag.zoneAt(100.0 50.0 200.0 100.0 99.0 100.0 6.0)) == "l") "image drag: the left edge")
        this.ok(((PresImageDrag.zoneAt(100.0 50.0 200.0 100.0 303.0 148.0 6.0)) == "br") "image drag: a corner")
        this.ok(((PresImageDrag.zoneAt(100.0 50.0 200.0 100.0 200.0 47.0 6.0)) == "t") "image drag: the top")
        this.ok(((PresImageDrag.zoneAt(100.0 50.0 200.0 100.0 200.0 100.0 6.0)) == "move") "image drag: inside it moves it")
        this.ok(((PresImageDrag.zoneAt(100.0 50.0 200.0 100.0 320.0 100.0 6.0)) == "") "image drag: outside it nothing")
        this.ok(((PresImageDrag.zoneAt(100.0 50.0 8.0 100.0 103.0 100.0 6.0)) == "l") "image drag: a thin box, the nearer side")

        ; a centred picture in a column 0…800, 400 high: the right edge 50
        ; out grows it by 100 (both sides), its shape kept
        def d (new PresImageDrag())
        d.begin("r" 300.0 50.0 200.0 100.0 0.0 800.0 400.0 "" 500.0 100.0)
        d.moveTo(502.0 100.0)
        this.ok((d.moved == false) "image drag: a few units are still a click")
        d.moveTo(550.0 100.0)
        this.ok((((d.w == 300.0) && (d.h == 150.0)) && (d.x == 250.0)) ("image drag: centred, grows on both sides: " + (to_string d.x) + " " + (to_string d.w) + "x" + (to_string d.h)))
        this.ok((d.outWidth == "38%") ("image drag: width of the column, got " + d.outWidth))
        def m:PresImageModel (PresImageModel.read("![a](media/x.png)" "{height=40% .round}"))
        this.ok((d.apply(m)) "image drag: the width written")
        this.ok(((m.markdown()) == "![a](media/x.png)\n{width=38% .round}") ("image drag: height taken away, the rest kept: " + (m.markdown())))
        ; never past the column
        d.moveTo(2000.0 100.0)
        this.ok(((d.w == 800.0) && (d.outWidth == "100%")) ("image drag: clamped to the margins: " + (to_string d.w)))
        ; …nor the content height
        def tall (new PresImageDrag())
        tall.begin("b" 300.0 50.0 100.0 200.0 0.0 800.0 400.0 "left" 350.0 250.0)
        tall.moveTo(350.0 900.0)
        this.ok(((tall.h == 400.0) && (tall.w == 200.0)) ("image drag: the bottom stops at the content height: " + (to_string tall.w) + "x" + (to_string tall.h)))
        this.ok(((tall.outHeight == "100%") && ((strlen tall.outWidth) == 0)) "image drag: the bottom writes the height")
        this.ok((tall.x == 0.0) "image drag: a left picture stays at the left")
        ; a left picture's left edge pulled in narrows it
        def lft (new PresImageDrag())
        lft.begin("l" 0.0 50.0 400.0 200.0 0.0 800.0 400.0 "left" 0.0 100.0)
        lft.moveTo(100.0 100.0)
        this.ok(((lft.w == 300.0) && (lft.outWidth == "38%")) ("image drag: the left edge narrows it: " + (to_string lft.w)))

        ; moved: the third of the column its middle is let go in
        def mv (new PresImageDrag())
        mv.begin("move" 300.0 50.0 200.0 100.0 0.0 800.0 400.0 "" 400.0 100.0)
        mv.moveTo(150.0 120.0)
        this.ok(((mv.outAlign == "left") && (mv.x == 0.0)) ("image drag: to the left third: " + mv.outAlign))
        def m2:PresImageModel (PresImageModel.read("![a](media/x.png)" ""))
        this.ok((mv.apply(m2)) "image drag: align written")
        this.ok(((m2.markdown()) == "![a](media/x.png)\n{align=left}") ("image drag: " + (m2.markdown())))
        mv.moveTo(700.0 100.0)
        this.ok(((mv.outAlign == "right") && (mv.x == 600.0)) "image drag: to the right third")
        mv.moveTo(410.0 100.0)
        def m3:PresImageModel (PresImageModel.read("![a](media/x.png)" ""))
        this.ok(((mv.apply(m3)) == false) "image drag: let go where it was, nothing written")
        def click (new PresImageDrag())
        click.begin("move" 300.0 50.0 200.0 100.0 0.0 800.0 400.0 "" 400.0 100.0)
        this.ok(((click.apply(m3)) == false) "image drag: a click writes nothing")
        this.ok(((PresImageDrag.placeOf("end")) == "right") "image drag: the theme's end is right")

        ; an SVG picture in the PDF: drawn from its paths when the importer
        ; reads all of it, from its PNG when something is out of profile
        def dk (new PresDeck())
        dk.addSvgPicture("/media/a.svg" "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 10 10\"><path d=\"M0 0h10v10z\" fill=\"#c00\"/></svg>" (buffer_alloc 0) (buffer_alloc 0))
        dk.addSvgPicture("/media/b.svg" "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 10 10\"><text x=\"1\" y=\"8\">A</text></svg>" (buffer_alloc 0) (buffer_alloc 0))
        this.ok((dk.svgVector("/media/a.svg")) "svg: paths are drawn as vectors")
        this.ok(((dk.svgVector("/media/b.svg")) == false) "svg: text is not, the PNG is used")
        this.ok(((dk.svgVector("/media/c.svg")) == false) "svg: an unknown picture is not")
    }

    sfn main:void () {
        def c (new PresCheck())
        c.run()
        c.edges()
        c.cascade()
        c.chartMotion()
        c.figures()
        c.listFigures()
        c.smartArt()
        c.smartArtLayouts()
        c.smartArtSlides()
        c.docSettings()
        c.ranges()
        c.limits()
        c.staggered()
        c.flowModel()
        c.gridModel()
        c.controlsFade()
        c.followEdits()
        c.picks()
        c.navJumps()
        c.recording()
        c.docx()
        c.htmlPage()
        c.traceChecks()
        c.imageDrag()
        print ((to_string c.passes) + " passed, " + (to_string c.fails) + " failed")
        if (c.fails > 0) {
            print "CHECK FAILED"
        }
    }
}
