; SPDX-License-Identifier: AGPL-3.0-or-later
; Node checks for the deck and the timeline: `npm run check`.
Import "PresTimeline.rgr"
Import "PresChartModel.rgr"
Import "PresCascade.rgr"
Import "PresDocSettings.rgr"

class PresCheck {
    def fails:int 0
    def passes:int 0

    fn ok:void (cond:boolean what:string) {
        if cond {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("FAIL " + what)
        }
    }

    sfn sample:string () {
        return ("---\ntransition: fade\nslide-split-level: 2\n---\n\n"
            + "## Eka {#eka transition=slide seconds=0.4 fx=starfield fx-density=1.6}\n\nJohdanto\n\n"
            + "1. yksi\n2. kaksi\n   jatkuu\n3. kolme\n{.build anim=fly}\n\n"
            + "::: notes\nPuhe ensin. [[1]] Sitten.\n:::\n\n"
            + "## Toka\n\nTeksti\n{anim=zoom}\n\n::: audio src=toka.wav\n:::\n")
    }

    fn run:void () {
        def text:string (PresCheck.sample())
        def src (new PresSource())
        src.read(text)
        this.ok(((strlen src.masked) == (strlen text)) "masking keeps the length")
        this.ok(((indexOf src.masked "notes") < 0) "masking removes the notes fence")
        this.ok(((array_length src.blocks) == 2) "two ::: blocks")
        def nb:PresBlock (itemAt src.blocks 0)
        this.ok((nb.body == "Puhe ensin. [[1]] Sitten.") ("notes body: " + nb.body))

        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 2) ("two slides, got " + (to_string (deck.slideCount()))))
        if ((deck.slideCount()) < 2) {
            return
        }
        def s0:PresSlide (deck.slideAt(0))
        def s1:PresSlide (deck.slideAt(1))
        this.ok((s0.id == "eka") "slide id")
        this.ok((s0.transition == "slide") "slide transition")
        this.ok((s0.fx == "starfield") "slide fx")
        this.ok(((array_length s0.fxNames) == 1) "fx parameter")
        this.ok((s0.steps == 3) ("three build steps, got " + (to_string s0.steps)))
        this.ok((s0.notes == "Puhe ensin. [[1]] Sitten.") ("notes on slide 1: " + s0.notes))
        this.ok((s1.audio == "toka.wav") ("audio on slide 2: " + s1.audio))
        this.ok((s1.transition == "fade") "front matter transition")
        this.ok(((array_length s1.groups) == 1) "an anim block is a group")

        ; Before step 1 the build items are not drawn; after the last they are.
        def early:EVGDisplayList (PresTimeline.frame(deck 0 0.1))
        def late:EVGDisplayList (PresTimeline.frame(deck 0 s0.duration))
        this.ok(((PresCheck.texts(early "yksi")) == 0) "item 1 hidden before its step")
        this.ok(((PresCheck.texts(early "1.")) == 0) "its number hidden with it")
        this.ok(((PresCheck.texts(early "3.")) == 0) "a later number hidden too")
        this.ok(((PresCheck.texts(late "yksi")) == 1) "item 1 shown after its step")
        def one:double ((PresTimeline.stepDone(s0 1)) + 0.05)
        def between:EVGDisplayList (PresTimeline.frame(deck 0 one))
        this.ok(((PresCheck.texts(between "1.")) == 1) "after step 1 its number is there")
        this.ok(((PresCheck.texts(between "2.")) == 0) "but not the next item's number")
        this.ok(((PresCheck.texts(between "kaksi")) == 0) "nor the next item")
        this.ok(((PresCheck.texts(late "3.")) == 1) "the numbers at the end")
        this.ok(((array_length late.fxIds) == 1) "the starfield instance is in the list")
        this.ok(((indexOf (late.toJson()) "\"efx\"") > 0) "a command paints the effect")

        ; The same time gives the same frame, whatever came before.
        def a:string ((PresTimeline.frame(deck 0 1.37)).toJson())
        def b0:string ((PresTimeline.frame(deck 0 3.0)).toJson())
        def b:string ((PresTimeline.frame(deck 0 1.37)).toJson())
        this.ok((a == b) "a frame is a function of its time")
        this.ok((a != b0) "and a different time is a different frame")

        ; Mid-transition the second slide has the first under it.
        def mid:EVGDisplayList (PresTimeline.frame(deck 1 0.2))
        this.ok(((PresCheck.texts(mid "Johdanto")) == 1) "previous slide under a fade")
        this.ok(((PresCheck.texts(mid "Toka")) == 1) "current slide over it")
        def after:EVGDisplayList (PresTimeline.frame(deck 1 2.0))
        this.ok(((PresCheck.texts(after "Johdanto")) == 0) "previous slide gone after the fade")

        this.ok(((PresTimeline.slideAtTime(deck (s0.duration + 0.01))) == 1) "deck time to slide")
        this.ok(((deck.pageOfOffset((indexOf text "Toka"))) == 1) "source offset to slide")
        this.diagram()
        this.bigTitle()
        this.chartModel()
    }

    ; A title set large enough to wrap keeps the diagram under it on its own
    ; slide: no second slide with the title said again.
    fn bigTitle:void () {
        def text:string "---\nslide-split-level: 2\n---\n\n## Keskilämpötila kuukausittain\n\n```mermaid\nflowchart LR\n  A[Kokous] --> B[Selain]\n  B --> C[Gemini]\n```\n"
        def deck (new PresDeck())
        def chart:string "---\nslide-split-level: 2\n---\n\n## Keskilämpötila kuukausittain\n\n```vega-lite\n{\"width\": 900, \"height\": 380, \"data\": {\"values\": [{\"k\": \"Tammi\", \"v\": -3.1}, {\"k\": \"Helmi\", \"v\": -3.8}, {\"k\": \"Maalis\", \"v\": -0.7}]}, \"mark\": \"line\", \"encoding\": {\"x\": {\"field\": \"k\", \"type\": \"nominal\"}, \"y\": {\"field\": \"v\", \"type\": \"quantitative\"}}}\n```\n"
        deck.md.setStyleSheet("page { width: 13.333in; height: 7.5in; padding: 0.6in } deck { split-level: 2 } h2 { font-size: 80pt }")
        deck.setText(chart)
        this.ok(((deck.slideCount()) == 1) ("a big title and its chart are one slide, got " + (to_string (deck.slideCount()))))
        deck.setText(text)
        this.ok(((deck.slideCount()) == 1) ("a big title and its diagram are one slide, got " + (to_string (deck.slideCount()))))
        deck.md.setStyleSheet("page { width: 13.333in; height: 7.5in; padding: 0.6in } deck { split-level: 2 } h2 { font-size: 160pt }")
        deck.setText(text)
        this.ok(((deck.slideCount()) == 1) ("a title taller than the slide is set smaller, got " + (to_string (deck.slideCount()))))
    }

    ; The chart editor's model: a fence read as a table and written back.
    fn chartModel:void () {
        ; wide rows: a category and two measures
        def wide:string "{\"width\": 400, \"data\": {\"values\": [{\"q\": \"Q1\", \"a\": 3, \"b\": 5}, {\"q\": \"Q2\", \"a\": 4, \"b\": 1}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"q\", \"type\": \"nominal\"}, \"y\": {\"field\": \"a\", \"type\": \"quantitative\", \"title\": \"Määrä\"}}}"
        def m:PresChartModel (PresChartModel.fromSpec(wide))
        this.ok(m.ok ("a bar chart reads as a table: " + m.note))
        this.ok(((m.cols()) == 2) ("category and one measure, got " + (to_string (m.cols()))))
        this.ok(((m.rows()) == 2) "two rows")
        this.ok(((m.cell(1 1)) == "4") ("the value of Q2: " + (m.cell(1 1))))
        this.ok((m.kind == 1) "columns")
        this.ok((m.width == 400) "its width kept")
        ; the long form a colour splits: pivoted into a column per series
        def long:string "{\"data\": {\"values\": [{\"k\": \"x\", \"s\": \"A\", \"v\": 1}, {\"k\": \"x\", \"s\": \"B\", \"v\": 2}, {\"k\": \"y\", \"s\": \"A\", \"v\": 3}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"k\", \"type\": \"nominal\"}, \"y\": {\"field\": \"v\", \"type\": \"quantitative\", \"aggregate\": \"sum\"}, \"color\": {\"field\": \"s\"}}}"
        def l:PresChartModel (PresChartModel.fromSpec(long))
        this.ok(((l.cols()) == 3) ("two series as columns, got " + (to_string (l.cols()))))
        this.ok((l.kind == 3) "stacked, as Vega-Lite stacks a coloured bar")
        this.ok(((l.cell(1 2)) == "") "a missing pair is an empty cell")
        ; a pie
        def pie:string "{\"data\": {\"values\": [{\"c\": \"a\", \"n\": 2}, {\"c\": \"b\", \"n\": 3}]}, \"mark\": {\"type\": \"arc\", \"innerRadius\": 30}, \"encoding\": {\"theta\": {\"field\": \"n\", \"type\": \"quantitative\"}, \"color\": {\"field\": \"c\"}}}"
        def pm:PresChartModel (PresChartModel.fromSpec(pie))
        this.ok((pm.ok && (pm.kind == 17)) "a donut is a donut")
        ; written back, and read again as the same table
        l.kind = 6
        l.title = "Otsikko"
        def out:string (l.toSpec())
        this.ok(((indexOf out "\"mark\": \"line\"") >= 0) ("a line spec: " + out))
        this.ok(((indexOf out "\"config\"") < 0) "no spreadsheet palette on a slide")
        def back:PresChartModel (PresChartModel.fromSpec(out))
        this.ok((back.ok && ((back.kind == 6) && ((back.cols()) == 3))) ("read back: kind " + (to_string back.kind) + " cols " + (to_string (back.cols())) + " " + back.note))
        this.ok(((back.cell(0 2)) == "2") ("the B of x survives: " + (back.cell(0 2))))
        this.ok((back.title == "Otsikko") "and its title")
        ; what cannot be a table is edited for its look alone, and says why
        def layered:PresChartModel (PresChartModel.fromSpec("{\"layer\": []}"))
        this.ok(((layered.ok && layered.lookOnly) && ((strlen layered.why) > 0)) "a layered chart opens for its look, with the reason")
        def fromFile:string "{\"data\": {\"url\": \"data/cars.json\"}, \"transform\": [{\"filter\": \"datum.x > 1\"}], \"mark\": \"point\", \"encoding\": {\"x\": {\"field\": \"a\", \"type\": \"quantitative\"}, \"color\": {\"field\": \"o\", \"type\": \"nominal\"}}, \"config\": {\"axis\": {\"grid\": false}}}"
        def fm:PresChartModel (PresChartModel.fromSpec(fromFile))
        this.ok((fm.lookOnly && (fm.dataFile == "data/cars.json")) ("a chart reading a file opens for its look: " + fm.dataFile))
        fm.title = "Autot"
        fm.width = 500
        fm.scheme = "tableau10"
        fm.textColor = "#334455"
        fm.legend = false
        fm.effect = "neon"
        def fout:string (fm.toSpec())
        def fback:PresChartModel (PresChartModel.fromSpec(fout))
        this.ok((((indexOf fout "data/cars.json") > 0) && ((indexOf fout "datum.x > 1") > 0)) "its data and transform are kept as they were")
        this.ok(((indexOf fout "\"grid\":false") > 0) "and its own config")
        this.ok(((((fback.title == "Autot") && (fback.width == 500)) && ((fback.scheme == "tableau10") && (fback.textColor == "#334455"))) && ((fback.legend == false) && (fback.effect == "neon"))) ("the look is written onto it: " + fout))
        this.ok((((l.suits(16)) == false) && (pm.suits(16))) "a pie wants exactly one series")
        ; the look, written and read back
        l.color = "#ff00aa"
        l.textColor = "#ffffff"
        l.strokeWidth = 4.0
        l.effect = "neon"
        l.glow = true
        l.gradient = true
        def styled:PresChartModel (PresChartModel.fromSpec((l.toSpec())))
        this.ok(((styled.color == "#ff00aa") && (styled.textColor == "#ffffff")) ("colours survive: " + styled.color + " " + styled.textColor))
        this.ok((((styled.strokeWidth == 4.0) && (styled.effect == "neon")) && (styled.glow && (styled.gradient && (styled.shadow == false)))) "line width, stage style and effects survive")
        ; a scheme on one series of bars colours each bar
        def one:PresChartModel (PresChartModel.fromSpec(wide))
        one.scheme = "category10"
        def byCat:string (one.toSpec())
        this.ok((((indexOf byCat "\"scheme\":\"category10\"") > 0) && ((indexOf byCat "\"color\": {\"field\":\"cat\"") > 0)) ("one series by category: " + byCat))
        def back1:PresChartModel (PresChartModel.fromSpec(byCat))
        this.ok((((back1.cols()) == 2) && (back1.scheme == "category10")) "…and reads back as one series")
    }

    ; A flowchart is drawn and toured rather than pasted in as a picture.
    fn diagram:void () {
        def text:string "---\nslide-split-level: 2\n---\n\n## Kulku\n\n```mermaid\nflowchart LR\n  A[Kokous] --> B[Selain]\n  B --> C[Gemini]\n  C --> B\n  B --> A\n```\n{choose=off tour=on}\n"
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 1) "one diagram slide")
        def s:PresSlide (deck.slideAt(0))
        this.ok(((array_length s.diagrams) == 1) "the fence is a toured diagram")
        if ((array_length s.diagrams) == 0) {
            return
        }
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        this.ok(((array_length d.nodes) == 3) ("three nodes, got " + (to_string (array_length d.nodes))))
        this.ok(((array_length d.edges) == 4) ("four edges, got " + (to_string (array_length d.edges))))
        this.ok(((array_length d.legs) >= 4) "a leg per edge")
        this.ok((s.duration > d.total) "the slide lasts until the tour is over")
        def e0:PresDEdge (itemAt d.edges 0)
        def na:PresDNode (itemAt d.nodes e0.from)
        this.ok((na.id == "A") ("the first edge leaves A, got " + na.id))
        ; nothing at the start, the nodes by the end of the reveal
        def early:EVGDisplayList (PresTimeline.frame(deck 0 0.0))
        this.ok(((PresCheck.texts(early "Gemini")) == 0) "a node is not there before it pops in")
        def shown:EVGDisplayList (PresTimeline.frame(deck 0 (d.revealEnd + 0.1)))
        this.ok(((PresCheck.texts(shown "Gemini")) == 1) "and is there after the reveal")
        ; in the middle of the tour the camera is in and the ball is out
        def l1:PresLeg (itemAt d.legs 1)
        def mid:double ((l1.t0 + (l1.dur * 0.5)) + (itemAt s.diagrams 0).start)
        d.cameraAt((l1.t0 + l1.dur) 800.0 400.0)
        def zIn:double d.camZ
        this.ok((zIn > 1.5) ("the camera is in on the node it lands on, z=" + (to_string zIn)))
        d.cameraAt((l1.t0 + (l1.dur * 0.5)) 800.0 400.0)
        this.ok((d.camZ <= zIn) "and backs off on the way, to keep both ends in view")
        ; on a keyframe the camera is centred on the node it stands on
        def l0:PresLeg (itemAt d.legs 0)
        d.cameraAt((l0.t0 + l0.dur) 800.0 400.0)
        def lands:PresDNode (itemAt d.nodes l0.toNode)
        this.ok(((fabs (d.camX - (lands.cx()))) < 0.01) "the camera is centred on the node the packet lands on")
        def a:string ((PresTimeline.frame(deck 0 mid)).toJson())
        def b:string ((PresTimeline.frame(deck 0 mid)).toJson())
        this.ok((a == b) "a toured frame is a function of its time")
        this.ok(((indexOf a "\"gd\"") > 0) "the ball and the rim fade are gradients")
        def fin:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        d.cameraAt(s.duration 800.0 400.0)
        this.ok((d.camZ == 1.0) "the camera is back out at the end")
        this.ok(((PresCheck.texts(fin "Kokous")) == 1) "the final frame shows the whole diagram")
        this.longChain()
        this.steering()
    }

    ; A walk the viewer steers: it stops where named edges branch, shows the
    ; ways on, takes the one picked, and goes back a step on request.
    fn steering:void () {
        def text:string ("---\nslide-split-level: 2\npage: a4 landscape\n---\n\n## Polku\n\n```mermaid\nflowchart LR\n"
            + "  A[Alku] --> B{Valitse}\n  B -->|Vasen| C[Vasen tie]\n  B -->|Oikea| D[Oikea tie]\n"
            + "  C --> E[Loppu]\n  D --> E\n  E --> F[Ohi]\n  E --> G[Myös]\n```\n{tour=on}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        if ((array_length s.diagrams) == 0) {
            this.ok(false "the steered diagram is there")
            return
        }
        def u:PresDiaUse (itemAt s.diagrams 0)
        def d:PresDiagram u.diagram
        this.ok(d.waiting "the walk stops at the named branch")
        this.ok(((array_length d.options) == 2) ("two ways on, got " + (to_string (array_length d.options))))
        def bn:PresDNode (itemAt d.nodes d.waitNode)
        this.ok((bn.id == "B") ("waiting at B, got " + bn.id))
        def hold:double (deck.diagramHold(0))
        this.ok((hold > 0.0) "the slide holds the clock there")
        this.ok((d.total < (d.waitAt + 1.5)) "and the diagram's own time ends at the question")
        def asked:EVGDisplayList (PresTimeline.frame(deck 0 (hold + 0.2)))
        this.ok(((PresCheck.texts(asked "Vasen")) >= 1) "the first way on is shown with its name")
        this.ok(((PresCheck.texts(asked "1")) >= 1) "…and its number, apart from the name")
        this.ok(((PresCheck.texts(asked "1  Vasen")) == 0) "not run into the name")
        this.ok(((PresCheck.texts(asked "Vasen tie")) == 1) "the node it leads to is shown as a ghost")
        ; a press inside the second option's box picks it
        def lt:double ((hold + 0.2) - u.start)
        d.cameraAt(lt u.bw u.bh)
        d.optionRect(1)
        def sc:double ((d.fitOf(u.bw u.bh)) * d.camZ)
        def dx:double ((u.bx + (u.bw * 0.5)) - (d.camX * sc))
        def dy:double ((u.by + (u.bh * 0.5)) - (d.camY * sc))
        def px:double (((d.rX + (d.rW * 0.5)) * sc) + dx)
        def py:double (((d.rY + (d.rH * 0.5)) * sc) + dy)
        def code:string (deck.diagramHit(0 (hold + 0.2) px py))
        this.ok((code == "0:1") ("a press on the second option hits it: " + code))
        d.moveSel(1)
        this.ok((d.optSel == 1) "the keys move the highlight")
        this.ok((d.pick(0)) "picking the first way on")
        PresTimeline.plan(s)
        this.ok(((array_length d.choices) == 1) "one choice made")
        def seenC:boolean false
        def seenD:boolean false
        def i:int 0
        while (i < (array_length d.nodes)) {
            def n:PresDNode (itemAt d.nodes i)
            if ((n.id == "C") && (n.at < d.tourEnd)) {
                seenC = true
            }
            if ((n.id == "D") && (n.at < (d.tourEnd - 0.5))) {
                seenD = true
            }
            i = (i + 1)
        }
        this.ok(seenC "the walk goes the chosen way")
        this.ok((! seenD) "and not the other")
        this.ok((! d.waiting) "unnamed branches (E) do not stop it")
        ; back from the chosen node: to B, and the choice is undone
        def atC:double (itemAt d.stepT 2)
        def to:double (d.back((atC + 0.1)))
        this.ok(((array_length d.choices) == 0) "going back undoes the choice")
        this.ok(d.waiting "and the question is asked again")
        this.ok((to < atC) "going back goes back in time")
        def bb:PresDNode (d.nodeNamed("B"))
        this.ok((to >= (bb.at + 0.6)) ("and lands where the node has finished arriving: " + (to_string to) + " vs " + (to_string bb.at)))
        this.sameTarget()
    }

    ; Two named ways to the same node are two choices in two places.
    fn sameTarget:void () {
        def text:string ("---\nslide-split-level: 2\npage: a4 landscape\n---\n\n## Sama\n\n```mermaid\nflowchart TB\n"
            + "  A[Uusi projekti] --> B{Kuka tietää?}\n  B -->|Minä ehkä| C[Avaa README]\n  B -->|Ei kukaan| C\n  C --> D[Loppu]\n```\n{tour=on}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        ; a tall diagram may go on to the next slide: find it
        def si:int 0
        def at:int -1
        while (si < (deck.slideCount())) {
            def sl:PresSlide (deck.slideAt(si))
            if ((array_length sl.diagrams) > 0) {
                at = si
            }
            si = (si + 1)
        }
        if (at < 0) {
            this.ok(false "the diagram is there")
            return
        }
        def s:PresSlide (deck.slideAt(at))
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        this.ok((d.waiting && ((array_length d.options) == 2)) "two ways to one node are asked about")
        if ((array_length d.pillX) < 2) {
            return
        }
        def ax:double (itemAt d.pillX 0)
        def ay:double (itemAt d.pillY 0)
        def bx:double (itemAt d.pillX 1)
        def by:double (itemAt d.pillY 1)
        def sepX:boolean (((ax + (itemAt d.pillW 0)) <= bx) || ((bx + (itemAt d.pillW 1)) <= ax))
        def sepY:boolean (((ay + (itemAt d.pillH 0)) <= by) || ((by + (itemAt d.pillH 1)) <= ay))
        this.ok((sepX || sepY) "their choices do not overlap")
        def c:PresDNode (d.nodeNamed("C"))
        def onNode:boolean (((ay >= c.y) && (ay <= (c.y + c.h))) && ((ax >= c.x) && (ax <= (c.x + c.w))))
        this.ok((! onNode) "and sit on the edges, not on the node they lead to")
        ; …close to the box they leave
        def bq:PresDNode (d.nodeNamed("B"))
        def k0:int 0
        while (k0 < 2) {
            def gapY:double ((itemAt d.pillY k0) - (bq.y + bq.h))
            this.ok(((gapY >= -1.0) && (gapY < 60.0)) ("choice " + (to_string (k0 + 1)) + " sits just under the question box: " + (to_string gapY)))
            k0 = (k0 + 1)
        }
        ; each way on points at its own pill: on the line, or by a leader from beside it
        def k:int 0
        while (k < 2) {
            def e:PresDEdge (itemAt d.edges (itemAt d.options k))
            def gap:double (PresDiagram.distanceTo(e.line (itemAt d.pillLx k) (itemAt d.pillLy k)))
            this.ok((gap < 3.0) ("way " + (to_string (k + 1)) + " is pointed at from its choice"))
            k = (k + 1)
        }
    }

    ; A long left-to-right chain: laid out top to bottom instead, every node
    ; shown by the end, and each held long enough to be read.
    fn longChain:void () {
        def text:string ("---\nslide-split-level: 2\npage: a4 landscape\n---\n\n## Uusi projekti\n\n```mermaid\nflowchart LR\n"
            + "  A[Uusi projekti] --> B{Kuka tietää mitä tämä tekee?}\n  B -->|Minä ehkä| C[Avaa README]\n  B -->|Ei kukaan| C\n"
            + "  C --> D{README ajan tasalla?}\n  D -->|Tietenkin ei| E[git log --oneline]\n  D -->|Yllättäen kyllä| F[Kokeillaan ajaa]\n"
            + "  E --> F\n  F --> G{Käynnistyykö?}\n  G -->|Kyllä| H[Miksi tämä toimii?]\n  G -->|Ei| I[Katso erroria hiljaa 30 sekuntia]\n"
            + "  I --> J[Google / Stack Overflow / AI]\n  J --> K[Ahaa... tietenkin.]\n  K --> F\n  H --> L[Lisätään yksi pieni muutos]\n"
            + "  L --> M{Toimiiko vielä?}\n  M -->|Kyllä| N[LGTM]\n  M -->|Ei| I\n  N --> O[Projektin ymmärrys: noin 34 %]\n```\n{choose=off tour=on}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        def s:PresSlide (deck.slideAt(0))
        if ((array_length s.diagrams) == 0) {
            this.ok(false "the chain is a toured diagram")
            return
        }
        def d:PresDiagram (itemAt s.diagrams 0).diagram
        def ratio:double (d.worldW / d.worldH)
        this.ok(((ratio > 0.5) && (ratio < 2.2)) ("wrapped into a block, not a strip: " + (to_string d.worldW) + "x" + (to_string d.worldH)))
        this.ok(((array_length d.nodes) == 15) ("fifteen nodes, got " + (to_string (array_length d.nodes))))
        def hidden:int 0
        def i:int 0
        while (i < (array_length d.nodes)) {
            def n:PresDNode (itemAt d.nodes i)
            if (n.at > d.tourEnd) {
                hidden = (hidden + 1)
            }
            i = (i + 1)
        }
        this.ok((hidden == 0) ("every node appears in the walk, missing " + (to_string hidden)))
        ; the longest label is held at least its reading time
        def nb:PresDNode (d.nodeNamed("I"))
        def held:double 0.0
        def k:int 0
        while ((k + 1) < (array_length d.kfT)) {
            if (((itemAt d.kfN k) == (itemAt d.kfN (k + 1))) && ((itemAt d.kfN k) >= 0)) {
                def who:PresDNode (itemAt d.nodes (itemAt d.kfN k))
                if (who.id == "I") {
                    def span:double ((itemAt d.kfT (k + 1)) - (itemAt d.kfT k))
                    if (span > held) {
                        held = span
                    }
                }
            }
            k = (k + 1)
        }
        def need:double (d.readTime(30))
        this.ok((held >= (need - 0.01)) ("a long node is held for reading: " + (to_string held) + " s"))
    }

    ; The header and the footer: on the slides, before the first build step,
    ; and not where the front matter or the heading leaves them off.
    fn edges:void () {
        def text:string ("---\nslide-split-level: 2\nheader-left: ACME Oy\nfooter-right: \"{page} / {pages}\"\nfooter-skip: first\n---\n\n"
            + "## Kansi\n\nAlku\n\n## Toka\n\n1. yksi\n2. kaksi\n{.build}\n\n## Kolmas {header=off}\n\nLoppu\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 3) "three slides with a header")
        if ((deck.slideCount()) < 3) {
            return
        }
        def first:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        this.ok(((PresCheck.texts(first "ACME Oy")) == 1) "the header on the first slide")
        this.ok(((PresCheck.texts(first "1 / 3")) == 0) "footer-skip: first leaves its footer off")
        def early:EVGDisplayList (PresTimeline.frame(deck 1 ((deck.slideAt(1)).seconds + 0.05)))
        this.ok(((PresCheck.texts(early "2 / 3")) == 1) "the page number arrives with the slide")
        this.ok(((PresCheck.texts(early "yksi")) == 0) "before the build step")
        def last:EVGDisplayList (PresTimeline.finalFrame(deck 2))
        this.ok(((PresCheck.texts(last "ACME Oy")) == 0) "{header=off} on a heading")
        this.ok(((PresCheck.texts(last "3 / 3")) == 1) "that slide keeps its footer")
    }

    ; --- the theme's cascade (PresCascade), against what the layout draws ---------
    sfn hexOf:string (v:string) {
        def c:EVGColor (CssValue.color(v))
        if (c.isSet == false) {
            return ""
        }
        return (MdCss.hexOf(c))
    }

    ; The colour the layout set a word in, as #RRGGBB; "" when not found.
    sfn inkOf:string (deck:PresDeck word:string) {
        def l:MdLayout (deck.layout())
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && ((indexOf b.text word) == 0)) {
                return (PresCheck.hexOf(b.color))
            }
            i = (i + 1)
        }
        return ""
    }

    ; `css`, an element, a facet: its value, its source, and the colour the
    ; layout really draws `word` in.
    fn ink:void (css:string md:string sel:string cls:string word:string wantFrom:string what:string) {
        def classes:[string]
        if ((strlen cls) > 0) {
            push classes cls
        }
        def e:PresCssElement ((PresCascade.of(css)).element(sel classes ""))
        def f:PresCssFacet (e.facet("color"))
        this.ok((f.from == wantFrom) (what + ": colour from " + wantFrom + ", got " + f.from))
        def deck (new PresDeck())
        deck.md.setStyleSheet(css)
        deck.setText(md)
        def drawn:string (PresCheck.inkOf(deck word))
        this.ok(((strlen drawn) > 0) (what + ": " + word + " is drawn"))
        this.ok(((PresCheck.hexOf(f.value)) == drawn) (what + ": model " + f.value + " = drawn " + drawn))
    }

    fn cascade:void () {
        def none:[string]
        ; a heading with no colour of its own is the document's, and says so
        def css1:string "document { color: #112233 } heading { margin-top: 10pt }"
        def h2:PresCssElement ((PresCascade.of(css1)).element("h2" none ""))
        def hc:PresCssFacet (h2.facet("color"))
        this.ok(((hc.from == "document") && (hc.value == "#112233")) ("h2 colour from document: " + (h2.dump())))
        this.ok((hc.own == "h2") "an h2's colour is edited in h2")
        this.ok((((hc.link("heading")).isSet()) == false) "heading says nothing about colour")
        this.ok(((h2.facet("margin-top")).from == "heading") "the space above is the shared heading rule")
        this.ok(((h2.facet("margin-top")).isOwn()) "and it is the heading's own")
        ; h2 beats heading beats body beats document
        def css2:string "document { color: #111111 } body { color: #222222 } heading { color: #333333 } h2 { color: #444444 }"
        def c2:PresCascade (PresCascade.of(css2))
        this.ok(((((c2.element("h2" none "")).facet("color")).from) == "h2") "h2 colour wins")
        this.ok(((((c2.element("h3" none "")).facet("color")).from) == "heading") "then the shared heading colour")
        this.ok(((((c2.element("p" none "")).facet("color")).from) == "body") "body after document")
        this.ok(((((c2.element("p" none "")).facet("color")).own) == "body") "a paragraph's colour is edited where it comes from")
        ; MdCss reads the same into the style
        def mc (new MdCss())
        mc.addStyleSheet(css2)
        def st (new MdStyle())
        mc.applyTo(st)
        this.ok(((st.headingInk(2)) == (PresCheck.hexOf((((c2.element("h2" none "")).facet("color")).value)))) "h2 ink as MdStyle has it")
        this.ok(((st.headingInk(3)) == (PresCheck.hexOf((((c2.element("h3" none "")).facet("color")).value)))) "h3 ink as MdStyle has it")
        this.ok((st.textColor == (PresCheck.hexOf((((c2.element("p" none "")).facet("color")).value)))) "text ink as MdStyle has it")
        ; a list's colour is its bullets; the item's text is the document's
        def css3:string "document { color: #101010 } list { color: #ff0000; padding-left: 30pt }"
        def li:PresCssElement ((PresCascade.of(css3)).element("li" none ""))
        this.ok((((li.facet("color")).from == "document") && ((li.facet("marker-color")).from == "list")) ("item text vs bullets: " + (li.dump())))
        def mk:PresCssFacet (li.facet("marker-color"))
        this.ok(((strlen mk.note) > 0) "the bullet colour says what it colours")
        this.ok(((li.facet("padding-left")).value == "30pt") "the list's indent")
        this.ok(((li.facet("margin-bottom")).isDefault()) "item spacing at its default")
        ; a selector list, and the later rule at equal specificity
        def css4:string "h1, h2 { font-size: 30pt } h2 { font-size: 20pt } h3 { color: red !important } h3 { color: blue }"
        def c4:PresCascade (PresCascade.of(css4))
        def f4:PresCssFacet ((c4.element("h2" none "")).facet("font-size"))
        this.ok(((f4.value == "20pt") && ((f4.link("h2")).selector == "h2")) ("the later h2 rule: " + f4.value))
        this.ok(((((c4.element("h1" none "")).facet("font-size")).value) == "30pt") "h1 of h1, h2")
        this.ok(((((c4.element("h3" none "")).facet("color")).value) == "red") "!important above a later rule")
        ; the shared heading size is h1's only
        def c5:PresCascade (PresCascade.of("heading { font-size: 40pt; font-family: Lato }"))
        this.ok(((((c5.element("h1" none "")).facet("font-size")).value) == "40pt") "heading font-size sets h1")
        this.ok(((((c5.element("h2" none "")).facet("font-size")).isDefault())) "and not h2")
        this.ok(((((c5.element("h2" none "")).facet("font-family")).value) == "Lato") "heading font-family sets all")
        ; a quote's text is its own colour, never the document's
        def q:PresCssElement ((PresCascade.of("document { color: #123456 }")).element("blockquote" none ""))
        this.ok(((q.facet("color")).isDefault()) ("quote colour ignores the document: " + (q.dump())))
        ; a class: its colour and size on its block, its tag rule too
        def css6:string "document { color: #111111 } .lead { color: #00aa00; font-size: 1.3em } #only { color: #0000ff }"
        def c6:PresCascade (PresCascade.of(css6))
        def lead:[string]
        push lead ".lead"
        def pl:PresCssElement (c6.element("p" lead ""))
        this.ok((((pl.facet("color")).from == ".lead") && ((pl.facet("color")).own == ".lead")) ("p.lead colour: " + (pl.dump())))
        this.ok(((pl.facet("font-size")).value == "1.3em") "p.lead size")
        def pid:PresCssElement (c6.element("p" lead "only"))
        def pidc:PresCssFacet (pid.facet("color"))
        this.ok((pidc.from == "#only") ("an id beats a class: " + pidc.from))
        ; a heading's own colour beats its class
        def hl:PresCssElement ((PresCascade.of("h2 { color: #aa0000 } .lead { color: #00aa00 }")).element("h2" lead ""))
        this.ok(((hl.facet("color")).from == "h2") "h2 colour above its class")
        ; what a rule says that the layout does not read is listed as unread
        def un:PresCssElement ((PresCascade.of("p { color: red; margin-bottom: 4pt }")).element("p" none ""))
        def uf:PresCssFacet (un.facet("unread:p:color"))
        this.ok((uf.unread && (uf.value == "red")) ("p color is unread: " + (un.dump())))
        this.ok(((un.facet("margin-bottom")).value == "4pt") "p margin-bottom")
        ; the universal selector reaches every rule
        this.ok((((((PresCascade.of("* { color: #010203 }")).element("p" none "")).facet("color")).value) == "#010203") "* reaches the text")
        ; and against the layout: what the slide is drawn in
        def md:string "## Otsikko\n\nTeksti tässä\n\n- kohta\n\n> lainaus\n\nIso\n{.lead}\n"
        this.ink(css1 md "h2" "" "Otsikko" "document" "a heading drawn in the document colour")
        this.ink(css2 md "h2" "" "Otsikko" "h2" "a heading drawn in its own")
        this.ink(css2 md "p" "" "Teksti" "body" "a paragraph drawn in body")
        this.ink(css3 md "li" "" "kohta" "document" "an item's text is not the list colour")
        this.ink(css1 md "blockquote" "" "lainaus" "" "a quote in its own colour")
        this.ink(css6 md "p" ".lead" "Iso" ".lead" "a .lead paragraph")
    }

    ; A chart's columns rise and a beam crosses it once. Presenting, the
    ; clock holds at the slide's end and at each build step; it held before
    ; the beam was across, and the beam stayed half way over the chart.
    fn chartMotion:void () {
        def vals:string ""
        def v:int 0
        while (v < 20) {
            if (v > 0) {
                vals = (vals + ",")
            }
            vals = (vals + "{\"m\":\"k" + (to_string v) + "\",\"e\":" + (to_string (100 + (v * 7))) + "}")
            v = (v + 1)
        }
        def fence:string ("```vega-lite\n{\"usermeta\":{\"presStyle\":\"forge\"},\"data\":{\"values\":[" + vals
            + "]},\"mark\":\"bar\",\"encoding\":{\"x\":{\"field\":\"m\",\"type\":\"nominal\"},\"y\":{\"field\":\"e\",\"type\":\"quantitative\"}}}\n```\n")
        def text:string ("---\nslide-split-level: 2\n---\n\n## Menot\n\n" + fence
            + "\n## Askeleet\n\n" + fence + "\n1. yksi\n2. kaksi\n{.build}\n"
            + "\n## Myöhemmin\n\n1. eka\n{.build}\n\n" + fence + "{.build}\n")
        def deck (new PresDeck())
        deck.setText(text)
        PresTimeline.planAll(deck)
        if ((deck.slideCount()) < 3) {
            this.ok(false ("three chart slides, got " + (to_string (deck.slideCount()))))
            return
        }
        def motion:double (PresChart.motionSeconds())
        ; with the slide: it lasts until the beam is across, and is clear then
        def s0:PresSlide (deck.slideAt(0))
        this.ok(((array_length s0.charts) == 1) "the chart is read")
        if ((array_length s0.charts) == 0) {
            return
        }
        def u0:PresChartUse (itemAt s0.charts 0)
        this.ok((s0.duration >= (u0.start + motion)) ("the slide lasts until the chart has finished: " + (to_string s0.duration)))
        def mid:double (u0.start + (motion - ((PresChart.scanDur()) * 0.5)))
        this.ok(((PresCheck.beams((PresTimeline.frame(deck 0 mid)))) == 1) "the beam is over the chart half way across")
        this.ok(((PresCheck.beams((PresTimeline.frame(deck 0 s0.duration)))) == 0) "and gone where the slide holds")
        ; before a build step: the step waits for the chart
        def s1:PresSlide (deck.slideAt(1))
        def u1:PresChartUse (itemAt s1.charts 0)
        def first:double (PresTimeline.stepTime(s1 1))
        this.ok((first >= (u1.start + motion)) ("step 1 waits for the chart: " + (to_string first)))
        this.ok(((PresCheck.beams((PresTimeline.frame(deck 1 first)))) == 0) "no beam where step 1 holds")
        this.ok(((fabs (((PresTimeline.stepTime(s1 2)) - first) - s1.stepGap)) < 0.000001) "later steps keep their gap")
        ; revealed by a step: it starts moving when it arrives
        def s2:PresSlide (deck.slideAt(2))
        this.ok(((array_length s2.charts) == 1) "the chart under a step is read")
        if ((array_length s2.charts) == 0) {
            return
        }
        def u2:PresChartUse (itemAt s2.charts 0)
        this.ok((u2.start == (PresTimeline.stepTime(s2 2))) ("a chart starts with its step: " + (to_string u2.start)))
        this.ok((s2.duration >= (u2.start + motion)) "and the slide waits for it")
    }

    ; The scan beam's bright core in a frame.
    sfn beams:int (l:EVGDisplayList) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((((c.kind == 0) && (c.w == 2.0)) && (((c.r == 230) && (c.g == 250)) && (c.b == 255))) && (c.a > 0.0)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; ```process / ```swot / ```timeline and `{art=waves}`: drawn for PRO in
    ; the theme's colours, a note in the slot otherwise, and the art under
    ; the content.
    fn figures:void () {
        def text:string "---\nslide-split-level: 2\n---\n\n## Vaiheet {art=waves}\n\n```process\n- Suunnittelu: tavoitteet\n- Toteutus\n- Julkaisu\n```\n\n## SWOT\n\n```swot\nVahvuudet: brändi\nHeikkoudet: tiimi\nMahdollisuudet: markkinat\nUhat: kilpailu\n```\n"
        def css:string "page { width: 13.333in; height: 7.5in; padding: 0.6in; background-color: #0b1030 } deck { split-level: 2 } document { color: #e8ecff; font-size: 20pt } figure { colors: #ffa546 #5ce1ff }"
        def deck (new PresDeck())
        deck.md.setStyleSheet(css)
        deck.setTheme(css)
        deck.setText(text)
        PresTimeline.planAll(deck)
        this.ok(((deck.slideCount()) == 2) ("two figure slides, got " + (to_string (deck.slideCount()))))
        if ((deck.slideCount()) < 2) {
            return
        }
        def lockedL:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        this.ok(((PresCheck.texts(lockedL "Suunnittelu")) == 0) "without PRO the process is not drawn")
        deck.figuresAllowed = true
        deck.rebuild()
        PresTimeline.planAll(deck)
        def l0:EVGDisplayList (PresTimeline.finalFrame(deck 0))
        this.ok(((PresCheck.texts(l0 "Suunnittelu")) == 1) "with PRO the process step is drawn")
        this.ok(((PresCheck.texts(l0 "tavoitteet")) == 1) "and its description")
        def l1:EVGDisplayList (PresTimeline.finalFrame(deck 1))
        this.ok(((PresCheck.texts(l1 "V")) == 1) "the SWOT's letters come from the titles")
        this.ok(((deck.slideAt(0)).art == "waves") "the art is read from the heading")
        def art:FlowScene (deck.artScene((deck.slideAt(0)) 0))
        this.ok(((array_length art.items) > 40) "the art is a page of lines")
        def none:FlowScene (deck.artScene((deck.slideAt(1)) 1))
        this.ok(((array_length none.items) == 0) "a slide without art has none")
        this.ok(((PresCheck.lines(l0)) > ((PresCheck.lines(l1)) + 40)) "the art's lines are in the slide's list")
        def fs:MdFigureStyle deck.figStyle
        this.ok(((itemAt fs.colors 0) == "#ffa546") "the figure rule's colours")
        this.ok((fs.paper == "#0b1030") "the page's paper")
        this.ok((fs.ink == "#e8ecff") "the document's ink")
    }

    sfn lines:int (l:EVGDisplayList) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((strlen c.text) == 0) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn texts:int (l:EVGDisplayList word:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.cmds)) {
            def c:EVGDrawCmd (itemAt l.cmds i)
            if ((c.kind == 3) && (c.text == word)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; The document settings window's model: the front matter read into the
    ; places, the logo and the skips, and written back as keys.
    fn docSettings:void () {
        def meta (new MdMeta())
        MdFrontMatter.parseInto("title: Q3\nheader: Acme\nheader-image: logo.png\nheader-align: right\nfooter-left: \"{title}\"\nfooter-right: \"{page} / {pages}\"\nfooter-skip: first 3 last\nfooter-color: \"#ffffff\"" meta)
        def d (new PresDocSettings())
        d.read(meta)
        this.ok((d.title == "Q3") "docset: title")
        this.ok(((itemAt d.logo 0) == "logo.png") "docset: legacy header-image becomes the logo")
        this.ok(((itemAt d.logoAt 0) == 2) "docset: header-align right puts it on the right")
        this.ok(((itemAt d.texts 2) == "Acme") "docset: legacy header text in its place")
        this.ok(((itemAt d.texts 5) == "{page} / {pages}") "docset: footer right")
        this.ok(((itemAt d.skipFirst 1) && (itemAt d.skipLast 1)) "docset: first and last skipped")
        this.ok(((itemAt d.skipRest 1) == "3") "docset: other skips kept")
        set d.logoAt 0 0
        set d.skipLast 1 false
        d.build()
        def got:string ""
        def i:int 0
        while (i < (array_length d.outKeys)) {
            def v:string (itemAt d.outVals i)
            if ((strlen v) > 0) {
                got = (got + (itemAt d.outKeys i) + ": " + (PresDocSettings.quote(v)) + "\n")
            }
            i = (i + 1)
        }
        this.ok(((indexOf got "header-left: \"![](logo.png)\"") >= 0) "docset: logo written in its place, quoted")
        this.ok(((indexOf got "header-right: Acme") >= 0) "docset: text stays on the right")
        this.ok(((indexOf got "header-image") < 0) "docset: legacy keys taken out")
        this.ok(((indexOf got "footer-skip: first 3\n") >= 0) "docset: skips written")
        this.ok(((indexOf got "footer-color: \"#ffffff\"") >= 0) "docset: colour quoted")
        def back (new MdMeta())
        MdFrontMatter.parseInto(got back)
        def d2 (new PresDocSettings())
        d2.read(back)
        this.ok((((itemAt d2.logo 0) == "logo.png") && ((itemAt d2.logoAt 0) == 0)) "docset: round trip keeps the logo")
        this.ok(((PresDocSettings.quote("say \"hi\": now")) == "'say \"hi\": now'") "docset: single quotes around double")
        this.ok(((PresDocSettings.quote("plain words")) == "plain words") "docset: plain value unquoted")
    }

    sfn main:void () {
        def c (new PresCheck())
        c.run()
        c.edges()
        c.cascade()
        c.chartMotion()
        c.figures()
        c.docSettings()
        print ((to_string c.passes) + " passed, " + (to_string c.fails) + " failed")
        if (c.fails > 0) {
            print "CHECK FAILED"
        }
    }
}
