; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresHints.rgr — what the thing under the pointer is, and what it could be
; ============================================================================
;
; The editor shows a hint for a value it knows: an attribute in a
; `{fx=starfield fx-density=1.6}` block or in the front matter, a class, a
; fence's language, and in the theme a CSS property's value. The hint says
; what the value does, and what it can be: a list for a word with a fixed
; set, a colour, a number with its range and unit, a face. The page draws it
; as a popover and edits the text through `PresApp.replaceRange`.
;
; This file is the knowledge and the reading; it knows nothing of pixels.
; `forLine` answers for one line of text and a column, as JSON:
;
;   { "kind": "enum" | "color" | "number" | "font" | "class" | "doc",
;     "name": "fx", "doc": "…", "value": "starfield",
;     "start": 18, "end": 27,          the value's columns, to replace
;     "wholeStart": 17, "wholeEnd": 27, the whole item, to remove ("" none)
;     "options": […], "min": 0, "max": 4, "step": 0.1, "unit": "pt",
;     "adds": ["fx-density=1", …] }     items that could be added after it
;
; An empty string when there is nothing to say.
; ============================================================================

Import "PresI18n.rgr"
Import "../markdown/src/MdHtml.rgr"
Import "PresRange.rgr"

class PresHints {
    ; --- what the Markdown knows ----------------------------------------------
    sfn fxNames:string () {
        return "starfield plasma-wave smoke ambient-light liquid-glass drops raindrops2 bubbles"
    }

    ; An effect's parameters and their defaults, as the WebGL painter's effect
    ; definitions have them (lib/evg/gl/evg-webgl.js).
    sfn fxParams:string (fx:string) {
        if (fx == "starfield") { return "density=1 speed=6 angle=200 twinkle=1 glow=1 nebula=0.6 hue=225 hue2=300 seed=1" }
        if (fx == "plasma-wave") { return "ribbons=5 speed=0.35 amp=0.22 freq=1.7 width=2.2 glow=26 sheet=0.16 hue=225 hue2=285 grain=0.35 seed=1" }
        if (fx == "smoke") { return "density=1.2 rise=0.05 wind=0 swirl=2.6 scale=190 detail=5 height=0.9 softness=0.55 shade=0.6 angle=-60 hue=205 tint=0.1 seed=1" }
        if (fx == "ambient-light") { return "hue=190 hue2=268 sat=0.5 tilt=25 depth=0.5 orbs=7 size=0.55 softness=1.6 speed=0.06 glow=0.45 seed=1" }
        if (fx == "liquid-glass") { return "thickness=24 strength=32 power=2.2 disperse=0.07 shine=0.6 angle=-60 tint=0.05" }
        if (fx == "raindrops2") { return "rain=1 size=1 mist=1 speed=1 text=1 spread=1 dry=1 refract=1.1 shine=0.8 angle=-55 rim=0.55 tint=0.06 matte=1 seed=1" }
        if (fx == "drops") { return "rain=1 size=1 mist=1 speed=1 refract=1.1 shine=0.8 angle=-55 rim=0.55 tint=0.06 seed=1" }
        ; `raindrop` is the old name of `bubbles`, and still draws it
        if (fx == "raindrops2") { return (PresI18n.t("Rain on a window: fine drops that dry to a matte haze, drops have a maximum size, runners leave lines of water and seep around and through the letters.")) }
        if ((fx == "bubbles") || (fx == "raindrop")) { return "density=1 size=0.5 refract=14 shine=0.85 angle=-55 rim=0.55 speed=0 seed=1" }
        return ""
    }

    sfn fxDoc:string (fx:string) {
        if (fx == "starfield") { return (PresI18n.t("A slowly drifting starfield with nebula and twinkle.")) }
        if (fx == "plasma-wave") { return (PresI18n.t("Waving ribbons of light.")) }
        if (fx == "smoke") { return (PresI18n.t("Slowly rising smoke.")) }
        if (fx == "ambient-light") { return (PresI18n.t("Soft, drifting orbs of light.")) }
        if (fx == "liquid-glass") { return (PresI18n.t("A glassy, refracting edge.")) }
        if (fx == "drops") { return (PresI18n.t("Rain on a window: drops land, run together and run down the glass.")) }
        if ((fx == "bubbles") || (fx == "raindrop")) { return (PresI18n.t("Round drops on a pane of glass.")) }
        return ""
    }

    ; The default of one parameter of one effect, or "" when it has none.
    sfn fxDefault:string (fx:string param:string) {
        def all:[string] (strsplit (PresHints.fxParams(fx)) " ")
        def i:int 0
        while (i < (array_length all)) {
            def kv:string (itemAt all i)
            def eq:int (indexOf kv "=")
            if ((eq > 0) && ((substring kv 0 eq) == param)) {
                return (substring kv (eq + 1) (strlen kv))
            }
            i = (i + 1)
        }
        return ""
    }

    sfn attrDoc:string (key:string) {
        if (key == "transition") { return (PresI18n.t("Transition for this slide.")) }
        if (key == "seconds") { return (PresI18n.t("Transition length in seconds.")) }
        if (key == "duration") { return (PresI18n.t("How long the slide shows in playback, in seconds.")) }
        if (key == "step") { return (PresI18n.t("Time between build steps, in seconds.")) }
        if (key == "hold") { return (PresI18n.t("Time after the last step, in seconds.")) }
        if (key == "fx") { return (PresI18n.t("Background effect (EVG). Parameters: fx-<name>=<number>.")) }
        if (key == "anim") { return (PresI18n.t("How items appear.")) }
        if (key == "width") { return (PresI18n.t("Width: in points (400) or as a percentage of the column (60%). Images and charts keep their proportions.")) }
        if (key == "height") { return (PresI18n.t("Image height: in points or as a percentage of the slide's content height (50%).")) }
        if (key == "align") { return (PresI18n.t("Image position in the column: left, center or right.")) }
        if (key == "bg") { return (PresI18n.t("Slide background image, covers the whole slide: bg=media/kuva.jpg")) }
        if (key == "container") { return (PresI18n.t("The block above on a rounded plate, so its text reads over a busy picture: box (across the column) or bubble (as wide as the text, with a tail). none: no plate.")) }
        if (key == "background") { return (PresI18n.t("The plate's colour, e.g. #fff8 (the last digit is the opacity). By default the slide's colour, see-through; the text turns dark or light when it would not read on it.")) }
        if (key == "art") { return (PresI18n.t("PRO: line art drawn behind the slide in the theme's colours (waves). art=off leaves it off this slide.")) }
        if (key == "list-style") { return (PresI18n.t("The list above drawn as a layout: process (steps), swot (a 2×2 grid) or timeline. Items are Title: description.")) }
        if (key == "art-seed") { return (PresI18n.t("A number that moves the art's curves: another number, another picture.")) }
        if (key == "bg-dim") { return (PresI18n.t("How much of the slide's base color goes over the background image (0–1), so text stands out.")) }
        if (key == "header") { return (PresI18n.t("Header text on every slide. {page}, {pages} and {title} are filled in. On a heading, header=off leaves it off that slide.")) }
        if (((key == "header-left") || (key == "header-center")) || (key == "header-right")) { return (PresI18n.t("Text in that place of every slide's header; a picture as ![](media/logo.png). {page}, {pages} and {title} are filled in.")) }
        if (((key == "footer-left") || (key == "footer-center")) || (key == "footer-right")) { return (PresI18n.t("Text in that place of every slide's footer; a picture as ![](media/logo.png). {page}, {pages} and {title} are filled in.")) }
        if ((key == "header-skip") || (key == "footer-skip")) { return (PresI18n.t("Slides without it: first, last or slide numbers, e.g. first last.")) }
        if ((key == "header-color") || (key == "footer-color")) { return (PresI18n.t("Header or footer text color.")) }
        if ((key == "header-background") || (key == "footer-background")) { return (PresI18n.t("A band of color behind the header or footer, to the slide's edge.")) }
        if ((key == "header-image-height") || (key == "footer-image-height")) { return (PresI18n.t("Height of the header or footer picture, e.g. 30pt.")) }
        if ((key == "header-size") || (key == "footer-size")) { return (PresI18n.t("Header or footer text size, e.g. 12pt.")) }
        if (key == "furniture") { return (PresI18n.t("off: no header or footer on this slide.")) }
        if (key == "footer") { return (PresI18n.t("Footer text on every slide, e.g. {page} / {pages}. On a heading, footer=off leaves it off that slide.")) }
        if ((key == "header-image") || (key == "footer-image")) { return (PresI18n.t("Image next to the header or footer text, e.g. media/logo.png.")) }
        if ((key == "header-align") || (key == "footer-align")) { return (PresI18n.t("left, center or right.")) }
        if (key == "diagram") { return (PresI18n.t("classic: the diagram's original drawing, without a tour.")) }
        if (key == "layout") { return (PresI18n.t("keep: the diagram's direction as written. Under a gallery: grid (default) or full, one picture per slide edge to edge.")) }
        if (key == "heading") { return (PresI18n.t("hidden: the title names the slide (overview, contents, screen readers) but is not drawn.")) }
        if (key == "fit") { return (PresI18n.t("Gallery: cover fills the cell and crops, contain shows the whole picture.")) }
        if (key == "caption") { return (PresI18n.t("Gallery: overlay (on the picture, with a dim band), below or none.")) }
        if (key == "focus") { return (PresI18n.t("The part of a picture kept in the crop: top, bottom left, 30% 70%.")) }
        if (key == "span") { return (PresI18n.t("Gallery: how many columns the cell takes, e.g. 2.")) }
        if (key == "tour") { return (PresI18n.t("on: the tour starts on its own with the slide. By default the whole diagram is shown, and ▶ next to the zoom buttons (T while presenting) starts the tour.")) }
        if (key == "ball") { return (PresI18n.t("off: no ball of light along the arrows.")) }
        if (key == "choose") { return (PresI18n.t("off: don't ask which way to go at branches.")) }
        if (key == "zoom") { return (PresI18n.t("Largest scale a diagram box is drawn at.")) }
        if (key == "style") { return (PresI18n.t("Diagram style: holo (glass), sketch (hand-drawn), mermaid (pastel cards), jurassic (poster), cartoon (speech bubbles) or romantic (black and terracotta).")) }
        if (key == "slide-grow") { return (PresI18n.t("How much a sparse slide may grow (off: not at all).")) }
        if (key == "slide-split-level") { return (PresI18n.t("Which heading level starts a new slide.")) }
        if (key == "title") { return (PresI18n.t("Presentation title.")) }
        return ""
    }

    sfn attrEnum:string (key:string) {
        if (key == "transition") { return "fade slide zoom none" }
        if (key == "fx") { return (PresHints.fxNames()) }
        if (key == "anim") { return "fade rise fly zoom" }
        if (key == "diagram") { return "classic" }
        if (key == "layout") { return "keep" }
        if ((key == "tour") || ((key == "ball") || (key == "choose"))) { return "on off" }
        if (key == "style") { return "holo sketch mermaid jurassic cartoon romantic" }
        if (key == "furniture") { return "off" }
        if (key == "art") { return "waves off" }
        if (key == "list-style") { return "process swot timeline" }
        if (key == "container") { return "box bubble none" }
        if (((key == "align") || (key == "header-align")) || (key == "footer-align")) { return "left center right" }
        return ""
    }

    ; min max step for a numeric attribute, or "".
    sfn attrRange:string (key:string value:string) {
        if (key == "seconds") { return "0.1 3 0.1" }
        if (key == "duration") { return "1 60 0.5" }
        if (key == "step") { return "0.2 5 0.1" }
        if (key == "hold") { return "0 10 0.5" }
        if (key == "width") { return "100 1200 10" }
        if (key == "zoom") { return "1 6 0.1" }
        if (key == "slide-grow") { return "1 2 0.05" }
        if (key == "slide-split-level") { return "1 3 1" }
        return ""
    }

    sfn classDoc:string (c:string) {
        if (c == ".build") { return (PresI18n.t("Items appear one at a time.")) }
        if (c == ".lead") { return (PresI18n.t("Lead: larger text.")) }
        if (c == ".kicker") { return (PresI18n.t("A small extra line.")) }
        if (c == ".c2") { return (PresI18n.t("In two columns.")) }
        if (c == ".c3") { return (PresI18n.t("In three columns.")) }
        return (PresI18n.t("A class defined by the theme's CSS."))
    }

    ; A number range for an effect parameter, from its default and its name.
    sfn fxRange:string (param:string def0:string) {
        if ((param == "hue") || (param == "hue2")) { return "0 360 1" }
        if (param == "seed") { return "1 100 1" }
        if ((param == "angle") || ((param == "tilt") || (param == "sweep-angle"))) { return "-180 180 1" }
        def d:double (fabs (?? (str2double def0) 1.0))
        if (d >= 10.0) {
            return ("0 " + (PresHints.num((d * 4.0))) + " 1")
        }
        if (d >= 2.0) {
            return ("0 " + (PresHints.num((d * 4.0))) + " 0.1")
        }
        return "0 4 0.01"
    }

    ; --- what the theme knows -------------------------------------------------
    sfn cssDoc:string (prop:string) {
        if (prop == "color") { return (PresI18n.t("Text color (chart and diagram: warm accent color).")) }
        if (prop == "accent-color") { return (PresI18n.t("Cool accent color: grid, axes, boxes.")) }
        if (prop == "background-color") { return (PresI18n.t("Background color. #rrggbbaa sets opacity, none removes the background.")) }
        if (prop == "border-color") { return (PresI18n.t("Border color.")) }
        if (prop == "font-family") { return (PresI18n.t("Font.")) }
        if (prop == "font-size") { return (PresI18n.t("Text size.")) }
        if (prop == "line-height") { return (PresI18n.t("Line spacing as a multiple of the text size.")) }
        if (prop == "chart-style") { return (PresI18n.t("Chart style: flat, forge, neon or glass.")) }
        if (prop == "title-font-size") { return (PresI18n.t("Chart title size.")) }
        if (prop == "title-gap") { return (PresI18n.t("Space between the chart title and the chart.")) }
        if (prop == "justify-content") { return (PresI18n.t("Horizontal position of a chart or image narrower than the slide: center (default), flex-start or flex-end.")) }
        if (prop == "content") { return (PresI18n.t("Header or footer text in quotes. {page}, {pages} and {title} are filled in: \"{page} / {pages}\".")) }
        if (((prop == "content-left") || (prop == "content-center")) || (prop == "content-right")) { return (PresI18n.t("Header or footer text in that place, in quotes; a picture as ![](media/logo.png).")) }
        if (prop == "font-weight") { return (PresI18n.t("Text weight: normal or bold.")) }
        if (prop == "max-height") { return (PresI18n.t("Maximum image height.")) }
        if (prop == "label-color") { return (PresI18n.t("Color of chart text (axes, legend).")) }
        if (prop == "contrast") { return (PresI18n.t("auto: chart text uses the slide's text color on a light slide (default). off: the theme's light text color.")) }
        if (prop == "padding") { return (PresI18n.t("Empty space at the edges (for a chart: around the chart).")) }
        if (prop == "chart-effects") { return (PresI18n.t("Extra effects for all charts: glow, shadow, gradient. E.g. glow gradient.")) }
        if (prop == "split-level") { return (PresI18n.t("Which heading level starts a new slide.")) }
        if (prop == "fx") { return (PresI18n.t("Background effect behind every slide; a slide's own {fx=…} wins. none: no effect.")) }
        if (((strlen prop) > 3) && ((substring prop 0 3) == "fx-")) { return ((PresI18n.t("Effect parameter ")) + (substring prop 3 (strlen prop)) + ".") }
        if (prop == "list-style") { return (PresI18n.t("Lists drawn as a layout: process, swot or timeline. #heading list { list-style: swot } for the lists under one heading.")) }
        if (prop == "colors") { return (PresI18n.t("Layout colours in order, separated by spaces.")) }
        if (prop == "overflow") { return (PresI18n.t("What to do with an overfull slide.")) }
        if (prop == "aspect-ratio") { return (PresI18n.t("Slide aspect ratio.")) }
        if (prop == "column-count") { return (PresI18n.t("Number of columns.")) }
        if (prop == "column-gap") { return (PresI18n.t("Space between columns.")) }
        if (prop == "text-align") { return (PresI18n.t("Text alignment.")) }
        if (prop == "width") { return (PresI18n.t("Page width.")) }
        if (prop == "height") { return (PresI18n.t("Page height.")) }
        return ""
    }

    sfn cssEnum:string (prop:string) {
        if (prop == "chart-style") { return "flat forge neon glass" }
        if (prop == "list-style") { return "process swot timeline" }
        if (prop == "fx") { return ((PresHints.fxNames()) + " none") }
        if (prop == "justify-content") { return "center flex-start flex-end" }
        if (prop == "contrast") { return "auto off" }
        if (prop == "overflow") { return "split shrink" }
        if (prop == "text-align") { return "left center right" }
        if (prop == "font-weight") { return "normal bold" }
        if (prop == "font-style") { return "normal italic" }
        return ""
    }

    ; Words a property takes any of, together ("glow gradient"): toggles.
    sfn cssFlags:string (prop:string) {
        if (prop == "chart-effects") { return "glow shadow gradient" }
        return ""
    }

    sfn fonts:string () {
        return "Open Sans|Noto Sans"
    }

    sfn isColorProp:boolean (prop:string) {
        def n:int (strlen prop)
        if (prop == "color") { return true }
        if (n > 6) {
            return ((substring prop (n - 6) n) == "-color")
        }
        return false
    }

    ; A number range for a property, by name and unit; a length from what
    ; it eats of its box (PresRange), the rest by name.
    sfn cssRange:string (prop:string unit:string rule:string box:PresRangeBox) {
        def lr@(optional):PresRange (PresRange.forLength(prop unit rule box))
        if (!null? lr) {
            return (lr.text())
        }
        if (prop == "line-height") { return "1 2.2 0.05" }
        if (prop == "column-count") { return "1 4 1" }
        if (prop == "split-level") { return "1 3 1" }
        if (((strlen prop) > 3) && ((substring prop 0 3) == "fx-")) {
            def param:string (substring prop 3 (strlen prop))
            def fxs:[string] (strsplit (PresHints.fxNames()) " ")
            def k:int 0
            while (k < (array_length fxs)) {
                def d0:string (PresHints.fxDefault((itemAt fxs k) param))
                if ((strlen d0) > 0) {
                    return (PresHints.fxRange(param d0))
                }
                k = (k + 1)
            }
            return (PresHints.fxRange(param "1"))
        }
        if (unit == "in") { return "0 20 0.05" }
        if (unit == "px") { return "0 200 1" }
        if (unit == "em") { return "0 4 0.05" }
        if (prop == "font-size") { return "8 96 1" }
        return "0 80 1"
    }

    sfn selectorDoc:string (sel:string) {
        if (sel == "page") { return (PresI18n.t("Slide size, margin and background.")) }
        if (sel == "deck") { return (PresI18n.t("How the document is split into slides, and the background effect.")) }
        if (sel == "figure") { return (PresI18n.t("Layouts drawn from lists (process, SWOT, timeline).")) }
        if (sel == "document") { return (PresI18n.t("Defaults for all text.")) }
        if (sel == "heading") { return (PresI18n.t("All headings.")) }
        if (sel == "chart") { return (PresI18n.t("Vega-Lite charts on stage, in PDF and in PPTX.")) }
        if (sel == "diagram") { return (PresI18n.t("Mermaid, DOT, D2 and PlantUML diagrams on stage.")) }
        if (sel == "container") { return (PresI18n.t("The rounded plates under {container=box} and {container=bubble} blocks.")) }
        if (sel == "list") { return (PresI18n.t("Lists.")) }
        if (sel == "li") { return (PresI18n.t("List item.")) }
        if (((indexOf sel "#") == 0) && ((indexOf sel " chart") > 0)) { return (PresI18n.t("Charts under one heading: #anchor is the heading in lowercase, spaces as hyphens.")) }
        if (sel == "code") { return (PresI18n.t("Code blocks.")) }
        if (sel == "table") { return (PresI18n.t("Tables.")) }
        if (sel == "blockquote") { return (PresI18n.t("Quotes.")) }
        if ((sel == "h1") || ((sel == "h2") || ((sel == "h3") || ((sel == "h4") || ((sel == "h5") || (sel == "h6")))))) { return ((PresI18n.t("Level ")) + (substring sel 1 2) + (PresI18n.t(" heading: size and color. h1 = # (presentation title), h2 = ## (slide title), h3 = ###."))) }
        if (sel == "body") { return (PresI18n.t("Defaults for all text (same as document).")) }
        if (sel == "p") { return (PresI18n.t("Paragraphs.")) }
        if (sel == "mark") { return (PresI18n.t("Highlight: <mark>…</mark>.")) }
        if (sel == "kbd") { return (PresI18n.t("Key: <kbd>…</kbd>.")) }
        if (sel == "a") { return (PresI18n.t("Links.")) }
        if (sel == "hr") { return (PresI18n.t("Horizontal rule and the line under a heading.")) }
        if (((strlen sel) > 0) && ((charAt sel 0) == 46)) { return (PresHints.classDoc(sel)) }
        return ""
    }

    ; --- reading a line ----------------------------------------------------------
    ;
    ; `mode` is "md" or "css"; `front` says the line is in the front matter.
    sfn forLine:string (mode:string line:string col:int front:boolean) {
        return (PresHints.forLineIn(mode line col front "" (new PresRangeBox())))
    }

    ; The same, with what a length's range is measured against: the rule's
    ; selector (`page`) and the slide (and element) it is for.
    sfn forLineIn:string (mode:string line:string col:int front:boolean sel:string box:PresRangeBox) {
        if (mode == "css") {
            return (PresHints.cssAt(line col sel box))
        }
        if front {
            return (PresHints.frontAt(line col))
        }
        def f:string (PresHints.fenceAt(line col))
        if ((strlen f) > 0) {
            return f
        }
        return (PresHints.attrAt(line col))
    }

    ; The fence languages drawn as a diagram.
    sfn isDiagramLang:boolean (lang:string) {
        def l:string (to_lowercase (trim lang))
        return ((((l == "mermaid") || (l == "dot")) || ((l == "graphviz") || (l == "d2"))) || ((l == "plantuml") || (l == "puml")))
    }

    ; The looks a diagram can take (`style=`, `diagram=classic`).
    sfn diagramLooks:string () {
        return "holo sketch classic mermaid jurassic cartoon romantic"
    }

    ; ```mermaid — the languages a fence can name.
    sfn fenceAt:string (line:string col:int) {
        def t:string (trim line)
        if (((strlen t) < 4) || ((substring t 0 3) != "```")) {
            return ""
        }
        def lead:int (indexOf line "```")
        def a:int (lead + 3)
        def b:int a
        def n:int (strlen line)
        while ((b < n) && (((charAt line b) != 32) && ((charAt line b) != 123))) {
            b = (b + 1)
        }
        if ((col < a) || (col > b) || (b == a)) {
            return ""
        }
        def lang:string (substring line a b)
        def h:PresHint (PresHint.make("enum" (PresI18n.t("language")) lang a b))
        h.doc = (PresI18n.t("What the block is: a diagram, a formula or code. process, swot and timeline draw a layout from a list, one `Title: description` per line."))
        h.options = "mermaid dot plantuml d2 vega-lite process swot timeline math js python bash json"
        ; a diagram: its looks; the notation is not switched from here
        if (PresHints.isDiagramLang(lang)) {
            h.name = (PresI18n.t("Diagram"))
            h.doc = (PresI18n.t("The diagram's look."))
            h.looks = (PresHints.diagramLooks())
            h.options = ""
        }
        return (h.json())
    }

    ; `key: value` in the front matter.
    sfn frontAt:string (line:string col:int) {
        def colon:int (indexOf line ":")
        if (colon <= 0) {
            return ""
        }
        def key:string (trim (substring line 0 colon))
        def a:int (colon + 1)
        def n:int (strlen line)
        while ((a < n) && ((charAt line a) == 32)) {
            a = (a + 1)
        }
        ; a YAML comment (` # …`) is not part of the value
        def b:int n
        def k:int a
        while (k < n) {
            if (((charAt line k) == 35) && ((k == a) || (((charAt line (k - 1)) == 32) || ((charAt line (k - 1)) == 9)))) {
                b = k
                k = n
            }
            k = (k + 1)
        }
        while ((b > a) && (((charAt line (b - 1)) == 32) || ((charAt line (b - 1)) == 9))) {
            b = (b - 1)
        }
        if ((col > b) && (b < n)) {
            ; over the comment
            return ""
        }
        if (col < a) {
            ; over the key: say what it is
            def dk:string (PresHints.attrDoc(key))
            if ((strlen dk) == 0) {
                return ""
            }
            def hk:PresHint (PresHint.make("doc" key (substring line a b) a b))
            hk.doc = dk
            return (hk.json())
        }
        return (PresHints.valueHint(key (substring line a b) a b -1 -1))
    }

    ; An item of a `{…}` attribute block.
    sfn attrAt:string (line:string col:int) {
        def open:int -1
        def i:int col
        if (i >= (strlen line)) {
            i = ((strlen line) - 1)
        }
        while (i >= 0) {
            def c:int (charAt line i)
            if ((c == 125) && (i < col)) {
                return ""
            }
            if (c == 123) {
                open = i
                i = -1
            } {
                i = (i - 1)
            }
        }
        if (open < 0) {
            return ""
        }
        def n:int (strlen line)
        def close:int (open + 1)
        while ((close < n) && ((charAt line close) != 125)) {
            close = (close + 1)
        }
        if ((close >= n) || (col > close)) {
            return ""
        }
        return (PresHints.itemsAt(line (open + 1) close col))
    }

    ; The space-separated item of line[from, to) the column is in.
    sfn itemsAt:string (line:string from:int close:int col:int) {
        def a:int from
        while (a < close) {
            while ((a < close) && ((charAt line a) == 32)) {
                a = (a + 1)
            }
            def b:int a
            def inQuote:boolean false
            while ((b < close) && ((inQuote || ((charAt line b) != 32)))) {
                if ((charAt line b) == 34) {
                    inQuote = (! inQuote)
                }
                b = (b + 1)
            }
            if ((b > a) && ((col >= a) && (col <= b))) {
                return (PresHints.itemHint(line a b))
            }
            a = b
        }
        return ""
    }

    sfn itemHint:string (line:string a:int b:int) {
        def item:string (substring line a b)
        ; the whole item and the space before it, to remove
        def wa:int a
        if ((wa > 0) && ((charAt line (wa - 1)) == 32)) {
            wa = (wa - 1)
        }
        if ((charAt item 0) == 46) {
            def hc:PresHint (PresHint.make("class" item item a b))
            hc.doc = (PresHints.classDoc(item))
            hc.options = ".build .lead .kicker .c2 .c3"
            hc.wholeStart = wa
            hc.wholeEnd = b
            return (hc.json())
        }
        def eq:int (indexOf item "=")
        if (eq <= 0) {
            return ""
        }
        def key:string (substring item 0 eq)
        def va:int ((a + eq) + 1)
        def vb:int b
        if ((va < vb) && ((charAt line va) == 34)) {
            va = (va + 1)
            if ((charAt line (vb - 1)) == 34) {
                vb = (vb - 1)
            }
        }
        return (PresHints.valueHint(key (substring line va vb) va vb wa b))
    }

    ; What a key's value is and can be.
    sfn valueHint:string (key:string value:string a:int b:int wa:int wb:int) {
        def h:PresHint (PresHint.make("doc" key value a b))
        h.wholeStart = wa
        h.wholeEnd = wb
        h.doc = (PresHints.attrDoc(key))
        ; a plate's colour: `background=#fff8`, or `bg=` when it is a colour
        if ((key == "background") || ((key == "bg") && (((strlen value) > 0) && ((charAt value 0) == 35)))) {
            h.kind = "color"
            if (key == "bg") {
                h.doc = (PresHints.attrDoc("background"))
            }
            return (h.json())
        }
        def en:string (PresHints.attrEnum(key))
        if ((strlen en) > 0) {
            h.kind = "enum"
            h.options = en
            if (key == "fx") {
                h.doc = ((PresHints.attrDoc(key)) + " " + (PresHints.fxDoc(value)))
                h.adds = (PresHints.fxAdds(value))
            }
            return (h.json())
        }
        if (((strlen key) > 3) && ((substring key 0 3) == "fx-")) {
            def param:string (substring key 3 (strlen key))
            h.kind = "number"
            h.doc = ((PresI18n.t("Effect parameter ")) + param + ".")
            h.range = (PresHints.fxRange(param "1"))
            ; the effect's own default names the scale
            def fxs:[string] (strsplit (PresHints.fxNames()) " ")
            def k:int 0
            while (k < (array_length fxs)) {
                def d0:string (PresHints.fxDefault((itemAt fxs k) param))
                if ((strlen d0) > 0) {
                    h.range = (PresHints.fxRange(param d0))
                    h.doc = ((PresI18n.t("Effect parameter ")) + param + (PresI18n.t(", default ")) + d0 + ".")
                    k = (array_length fxs)
                }
                k = (k + 1)
            }
            return (h.json())
        }
        def rg:string (PresHints.attrRange(key value))
        if ((strlen rg) > 0) {
            h.kind = "number"
            h.range = rg
            return (h.json())
        }
        if ((strlen h.doc) > 0) {
            return (h.json())
        }
        return ""
    }

    ; The parameters an effect has, as items to add.
    sfn fxAdds:string (fx:string) {
        def all:[string] (strsplit (PresHints.fxParams(fx)) " ")
        def out:string ""
        def i:int 0
        while (i < (array_length all)) {
            def kv:string (itemAt all i)
            if ((strlen kv) > 0) {
                if ((strlen out) > 0) {
                    out = (out + " ")
                }
                out = (out + "fx-" + kv)
            }
            i = (i + 1)
        }
        return out
    }

    ; `prop: value` in a CSS line, or a selector.
    sfn cssAt:string (line:string col:int rule:string box:PresRangeBox) {
        def n:int (strlen line)
        ; `/* pres: fx=starfield fx-density=1.1 */`: the deck's own settings
        ; in a theme, read like an attribute block
        def pi:int (indexOf line "/* pres:")
        if ((pi >= 0) && (col >= (pi + 8))) {
            def pe:int (indexOf line "*/")
            if (pe < 0) {
                pe = n
            }
            if (col <= pe) {
                return (PresHints.itemsAt(line (pi + 8) pe col))
            }
        }
        ; inside a comment: nothing
        def cs:int (indexOf line "/*")
        if ((cs >= 0) && (col >= cs)) {
            def ce:int (indexOf line "*/")
            if ((ce < 0) || (col <= (ce + 2))) {
                return ""
            }
        }
        ; the declaration the column is in: from the `;` or `{` before it to
        ; the `;` or `}` after it
        def a:int col
        if (a > n) {
            a = n
        }
        while ((a > 0) && (((charAt line (a - 1)) != 59) && ((charAt line (a - 1)) != 123))) {
            a = (a - 1)
        }
        def b:int col
        while ((b < n) && (((charAt line b) != 59) && ((charAt line b) != 125))) {
            b = (b + 1)
        }
        def decl:string (substring line a b)
        def colon:int (indexOf decl ":")
        if (colon < 0) {
            ; a selector
            def brace:int (indexOf line "{")
            def selEnd:int n
            if (brace >= 0) {
                selEnd = brace
            }
            if (col > selEnd) {
                return ""
            }
            def sel:string (trim (substring line 0 selEnd))
            def sd:string (PresHints.selectorDoc(sel))
            if ((strlen sd) == 0) {
                return ""
            }
            def hs:PresHint (PresHint.make("doc" sel sel 0 selEnd))
            hs.doc = sd
            return (hs.json())
        }
        def prop:string (MdHtml.lower((trim (substring decl 0 colon))))
        def va:int ((a + colon) + 1)
        while ((va < b) && ((charAt line va) == 32)) {
            va = (va + 1)
        }
        def vb:int b
        while ((vb > va) && ((charAt line (vb - 1)) == 32)) {
            vb = (vb - 1)
        }
        def value:string (substring line va vb)
        ; the declaration with its `;`, to remove
        def wa:int a
        while ((wa < va) && ((charAt line wa) == 32)) {
            wa = (wa + 1)
        }
        def wb:int b
        if ((wb < n) && ((charAt line wb) == 59)) {
            wb = (wb + 1)
        }
        def h:PresHint (PresHint.make("doc" prop value va vb))
        h.wholeStart = wa
        h.wholeEnd = wb
        h.doc = (PresHints.cssDoc(prop))
        if ((PresHints.isColorProp(prop)) || (((strlen value) > 0) && ((charAt value 0) == 35))) {
            h.kind = "color"
            return (h.json())
        }
        if (prop == "font-family") {
            h.kind = "font"
            h.options = (PresHints.fonts())
            return (h.json())
        }
        def fl:string (PresHints.cssFlags(prop))
        if ((strlen fl) > 0) {
            h.kind = "flags"
            h.options = fl
            return (h.json())
        }
        def en:string (PresHints.cssEnum(prop))
        if ((strlen en) > 0) {
            h.kind = "enum"
            h.options = en
            return (h.json())
        }
        if (prop == "aspect-ratio") {
            h.kind = "enum"
            h.options = "16 / 9|4 / 3|16 / 10"
            return (h.json())
        }
        ; a number with a unit
        def num:int 0
        while ((num < (strlen value)) && (PresHints.isNumChar((charAt value num)))) {
            num = (num + 1)
        }
        if ((num > 0) && ((indexOf value " ") < 0)) {
            def unit:string (substring value num (strlen value))
            h.kind = "number"
            h.unit = unit
            h.range = (PresHints.cssRange(prop unit rule box))
            return (h.json())
        }
        if ((strlen h.doc) > 0) {
            return (h.json())
        }
        return ""
    }

    sfn isNumChar:boolean (c:int) {
        return ((((c >= 48) && (c <= 57)) || (c == 46)) || (c == 45))
    }

    ; Two decimals at most, no trailing zeros.
    sfn num:string (v:double) {
        def c:int (to_int ((fabs v) * 100.0 + 0.5))
        def whole:int (idiv c 100)
        def frac:int (c - (whole * 100))
        def s:string (to_string whole)
        if (frac > 0) {
            if ((frac % 10) == 0) {
                s = (s + "." + (to_string (idiv frac 10)))
            } {
                if (frac < 10) {
                    s = (s + ".0" + (to_string frac))
                } {
                    s = (s + "." + (to_string frac))
                }
            }
        }
        if ((v < 0.0) && (c > 0)) {
            s = ("-" + s)
        }
        return s
    }
}

; One hint, and its JSON.
class PresHint {
    def kind:string ""
    def name:string ""
    def doc:string ""
    def value:string ""
    def start:int 0
    def end:int 0
    def wholeStart:int -1
    def wholeEnd:int -1
    ; space-separated, or `|`-separated when a choice has spaces in it
    def options:string ""
    ; "min max step"
    def range:string ""
    def unit:string ""
    def adds:string ""
    ; a diagram's fence: the looks it can take (space-separated) and the one
    ; it has (set by the app, which reads the whole block)
    def looks:string ""
    def look:string ""

    Constructor () {
    }

    sfn make:PresHint (kind:string name:string value:string a:int b:int) {
        def h:PresHint (new PresHint())
        h.kind = kind
        h.name = name
        h.value = value
        h.start = a
        h.end = b
        return h
    }

    sfn q:string (s:string) {
        def out:string "\""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if ((c == 34) || (c == 92)) {
                out = (out + "\\")
            }
            if (c < 32) {
                out = (out + " ")
            } {
                out = (out + (strfromcode c))
            }
            i = (i + 1)
        }
        return (out + "\"")
    }

    sfn list:string (s:string) {
        if ((strlen s) == 0) {
            return "[]"
        }
        def sep:string " "
        if ((indexOf s "|") >= 0) {
            sep = "|"
        }
        def parts:[string] (strsplit s sep)
        def out:string "["
        def i:int 0
        def first:boolean true
        while (i < (array_length parts)) {
            def p:string (trim (itemAt parts i))
            if ((strlen p) > 0) {
                if (first == false) {
                    out = (out + ",")
                }
                out = (out + (PresHint.q(p)))
                first = false
            }
            i = (i + 1)
        }
        return (out + "]")
    }

    fn json:string () {
        def out:string ("{\"kind\":" + (PresHint.q(kind)) + ",\"name\":" + (PresHint.q(name)) + ",\"doc\":" + (PresHint.q(doc)) + ",\"value\":" + (PresHint.q(value)))
        out = (out + ",\"start\":" + (to_string start) + ",\"end\":" + (to_string end))
        out = (out + ",\"wholeStart\":" + (to_string wholeStart) + ",\"wholeEnd\":" + (to_string wholeEnd))
        out = (out + ",\"options\":" + (PresHint.list(options)) + ",\"adds\":" + (PresHint.list(adds)) + ",\"unit\":" + (PresHint.q(unit)))
        if ((strlen looks) > 0) {
            out = (out + ",\"looks\":" + (PresHint.list(looks)))
        }
        if ((strlen look) > 0) {
            out = (out + ",\"look\":" + (PresHint.q(look)))
        }
        if ((strlen range) > 0) {
            def r:[string] (strsplit range " ")
            if ((array_length r) == 3) {
                out = (out + ",\"min\":" + (itemAt r 0) + ",\"max\":" + (itemAt r 1) + ",\"step\":" + (itemAt r 2))
            }
        }
        return (out + "}")
    }
}
