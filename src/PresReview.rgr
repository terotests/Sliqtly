; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresReview.rgr — review comments pinned to slides
; ============================================================================
;
; In review mode a reader pins a comment to a point on a slide, and a
; conversation grows under it: a thread. A thread that has been dealt with is
; closed (resolved): it stays, faint, and can be opened again; only a closed
; one can be deleted for good. Nothing here draws or knows a clock; the host
; gives the ids, the names and the times (milliseconds since 1970).
;
; A thread is anchored to its slide by the slide's title and its number then
; (`slide`, `title`). Slides move, are added and renamed while a deck is
; edited, so `place(titles)` finds each thread's slide again: the same number
; while the title there is the same, else the nearest slide with that title,
; else the same number (a renamed slide), the last slide past the end.
;
; The deck keeps them as one file, review/comments.json:
;
;   {"version": 1,
;    "threads": [{"id", "slide" (1 = first), "title", "x", "y" (0..1 of the
;                 slide's width and height), "closed", "state" (when closed or
;                 opened last, ms), "by" (who did that), "created",
;                 "severity" ("low", "medium", "high"; left out when not
;                 said) and "severityAt" (when it was set, ms),
;                 "element": {"key", "x", "y"} (the slide element it is on,
;                 see below), "lost" (that element was taken out),
;                 "messages": [{"id", "who", "name", "color", "text", "at"}]}],
;    "deleted": [thread ids]}
;
; A thread on a source file kept under code/ (a "Source code comment", see
; PresCodeFiles) has no point on the slide but a line of the file:
;
;   "code": {"path", "line", "to" (lines of the NEW version of the file, the
;            version a link to the head commit shows), "text" (the first
;            line's text then, to find it again when the file comes in anew),
;            "removed": [a, b] (old-version lines, when it was made on lines
;            the change took out), "repo", "commit", "via": {"diagram",
;            "node"} (the box it was opened from)}
;
; Its `slide` and `title` are the slide the file was opened from.
;
; A thread made on something on the slide (a picture, a heading, a line of
; text) is pinned to that element, not only to the point: `element.key` is
; the first line of the element's source and `element.x`/`y` the point in
; the element's box (0..1). `follow(blocks titles)` finds the element again
; after every edit: the same source nearest the slide it was on, else the
; most alike one (an edit inside it), and the thread goes with it to
; another slide, and to the element's new place when the slide turns or
; the text above it grows. When the element is gone the thread is closed
; and marked `lost`; it opens again if the element comes back (an undo).
;
; Two copies of the file (two people, an assistant through MCP, another tab)
; merge (`merge`): threads and messages are united by id, a thread's open or
; closed state is the one set last, and a thread deleted in either stays
; deleted (its id is kept in "deleted" so a copy that still has it does not
; bring it back).
; ============================================================================

Import "../vela/src/VlJson.rgr"

class PresReviewMsg {
    def id:string ""
    ; who wrote it: the host's id for a person
    def who:string ""
    def name:string ""
    ; "#rrggbb"
    def color:string ""
    def text:string ""
    def at:double 0.0
}

class PresReviewThread {
    def id:string ""
    ; the slide it is on, 0 = first, and that slide's title
    def slide:int 0
    def title:string ""
    ; where on the slide, 0..1 of its width and height
    def x:double 0.5
    def y:double 0.5
    def closed:boolean false
    ; when it was closed or opened last, and by whom
    def state:double 0.0
    def by:string ""
    def created:double 0.0
    def msgs:[PresReviewMsg]
    ; Pinned on a diagram (its index on the slide; -1 not): the point is
    ; the diagram's, so it moves with the diagram's camera. On a node it is
    ; (`ax`, `ay`) of the node's box, else of the whole diagram's.
    def dia:int -1
    def node:string ""
    def ax:double 0.0
    def ay:double 0.0
    ; when it was dragged somewhere else last (0 never): the latest move wins
    ; a merge
    def moved:double 0.0
    ; how serious it is: "" not said, "low", "medium" or "high" (green,
    ; yellow, red), and when it was set last (the latest wins a merge)
    def severity:string ""
    def sevAt:double 0.0
    ; On a source file (see the top): its path under code/ ("" = not one),
    ; new-version lines, the first line's text, old-version lines it was
    ; made on when they were taken out (0 = not), the commit, and the box
    ; it was opened from (-1 = none).
    def codePath:string ""
    def codeLine:int 0
    def codeTo:int 0
    def codeText:string ""
    def removedFrom:int 0
    def removedTo:int 0
    def codeRepo:string ""
    def codeCommit:string ""
    def viaDia:int -1
    def viaNode:string ""
    ; On an element of the slide (see the top): its source's first line
    ; ("" = on the slide itself), the point in its box, and whether it was
    ; taken out (the thread was closed then).
    def el:string ""
    def ex:double 0.5
    def ey:double 0.5
    def lost:boolean false

    fn isCode:boolean () {
        return ((strlen codePath) > 0)
    }

    ; "api.cpp:41–44", "api.cpp:41"
    fn codeWhere:string () {
        def name:string codePath
        def slash:int (lastIndexOf codePath "/")
        if (slash >= 0) {
            name = (substring codePath (slash + 1) (strlen codePath))
        }
        def s:string (name + ":" + (to_string codeLine))
        if (codeTo > codeLine) {
            s = (s + "–" + (to_string codeTo))
        }
        return s
    }

    fn count:int () {
        return (array_length msgs)
    }

    fn hasMsg:boolean (id:string) {
        for msgs m:PresReviewMsg i {
            if (m.id == id) {
                return true
            }
        }
        return false
    }

    ; the first message, the thread's subject ("" when there is none)
    fn firstText:string () {
        if ((array_length msgs) == 0) {
            return ""
        }
        def m:PresReviewMsg (itemAt msgs 0)
        return m.text
    }

    ; when anything last happened in it
    fn lastAt:double () {
        def t:double created
        if (state > t) {
            t = state
        }
        for msgs m:PresReviewMsg i {
            if (m.at > t) {
                t = m.at
            }
        }
        return t
    }

    ; a message in time order (equal times keep their order)
    fn addMsg:void (m:PresReviewMsg) {
        def i:int (array_length msgs)
        while (i > 0) {
            def prev:PresReviewMsg (itemAt msgs (i - 1))
            if (prev.at <= m.at) {
                break
            }
            i = (i - 1)
        }
        insert msgs i m
    }
}

; An element of a slide as the host laid it out: what `follow` finds a
; thread's element by. `page` the slide (0 = first), `key` the first line
; of its source, its box in fractions of the slide, and the diagram index
; on that slide when it is a diagram (-1 not).
class PresReviewBlock {
    def page:int 0
    def key:string ""
    ; where its source starts in the deck's text (-1: not known)
    def src:int -1
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    def dia:int -1
}

class PresReview {
    def threads:[PresReviewThread]
    ; the ids of threads deleted for good
    def gone:[string]
    ; one more on every change, for a host that redraws on it
    def rev:int 0

    Constructor () {
    }

    ; --- finding ----------------------------------------------------------------

    fn indexOf:int (id:string) {
        def i:int 0
        while (i < (array_length threads)) {
            def t:PresReviewThread (itemAt threads i)
            if (t.id == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn has:boolean (id:string) {
        return ((this.indexOf(id)) >= 0)
    }

    fn find@(optional):PresReviewThread (id:string) {
        def i:int (this.indexOf(id))
        def none@(optional):PresReviewThread
        if (i < 0) {
            return none
        }
        def t@(optional):PresReviewThread (itemAt threads i)
        return t
    }

    fn isGone:boolean (id:string) {
        for gone g:string i {
            if (g == id) {
                return true
            }
        }
        return false
    }

    fn count:int () {
        return (array_length threads)
    }

    fn openCount:int () {
        def n:int 0
        for threads t:PresReviewThread i {
            if (t.closed == false) {
                n = (n + 1)
            }
        }
        return n
    }

    ; the threads on a slide, in the order they were made
    fn onSlide:[PresReviewThread] (slide:int) {
        def out:[PresReviewThread]
        for threads t:PresReviewThread i {
            if (t.slide == slide) {
                push out t
            }
        }
        return out
    }

    ; --- changing ---------------------------------------------------------------

    sfn clamp01:double (v:double) {
        if (v < 0.0) {
            return 0.0
        }
        if (v > 1.0) {
            return 1.0
        }
        return v
    }

    sfn msg:PresReviewMsg (id:string who:string name:string color:string text:string at:double) {
        def m (new PresReviewMsg())
        m.id = id
        m.who = who
        m.name = name
        m.color = color
        m.text = text
        m.at = at
        return m
    }

    ; A new thread with its first message; false when the id is taken (or was
    ; deleted) or there is nothing to say.
    fn start:boolean (id:string slide:int title:string x:double y:double m:PresReviewMsg) {
        if ((((strlen id) == 0) || (this.has(id))) || (this.isGone(id))) {
            return false
        }
        if ((strlen (trim m.text)) == 0) {
            return false
        }
        def t (new PresReviewThread())
        t.id = id
        t.slide = slide
        if (t.slide < 0) {
            t.slide = 0
        }
        t.title = title
        t.x = (PresReview.clamp01(x))
        t.y = (PresReview.clamp01(y))
        t.created = m.at
        t.state = m.at
        t.by = m.who
        m.text = (trim m.text)
        push t.msgs m
        push threads t
        rev = (rev + 1)
        return true
    }

    ; A message in a thread. A closed thread takes none: it is opened first.
    fn reply:boolean (id:string m:PresReviewMsg) {
        def i:int (this.indexOf(id))
        if (i < 0) {
            return false
        }
        def t:PresReviewThread (itemAt threads i)
        if ((t.closed || ((strlen (trim m.text)) == 0)) || (t.hasMsg(m.id))) {
            return false
        }
        m.text = (trim m.text)
        t.addMsg(m)
        rev = (rev + 1)
        return true
    }

    ; An answer in a thread from someone outside it (the editor's AI
    ; assistant, an agent): a resolved thread is opened again for it, as
    ; MCP add_comment does. False when there is no such thread or nothing
    ; to say.
    fn answer:boolean (id:string m:PresReviewMsg) {
        def i:int (this.indexOf(id))
        if ((i < 0) || ((strlen (trim m.text)) == 0)) {
            return false
        }
        def t:PresReviewThread (itemAt threads i)
        if (t.hasMsg(m.id)) {
            return false
        }
        if t.closed {
            this.setClosed(id false m.who m.at)
        }
        return (this.reply(id m))
    }

    ; closed (true) or open again (false); false when it already was
    fn setClosed:boolean (id:string closed:boolean who:string at:double) {
        def i:int (this.indexOf(id))
        if (i < 0) {
            return false
        }
        def t:PresReviewThread (itemAt threads i)
        if (t.closed == closed) {
            return false
        }
        t.closed = closed
        t.state = at
        t.by = who
        rev = (rev + 1)
        return true
    }

    ; "low", "medium", "high" or "" (not said); anything else is "". False
    ; when there is no such thread or it already was.
    fn setSeverity:boolean (id:string sev:string at:double) {
        def i:int (this.indexOf(id))
        if (i < 0) {
            return false
        }
        def t:PresReviewThread (itemAt threads i)
        def v:string (PresReview.severityOf(sev))
        if (t.severity == v) {
            return false
        }
        t.severity = v
        t.sevAt = at
        rev = (rev + 1)
        return true
    }

    ; a severity as kept: "low", "medium", "high" or ""
    sfn severityOf:string (sev:string) {
        def v:string (to_lowercase (trim sev))
        if (((v == "low") || (v == "medium")) || (v == "high")) {
            return v
        }
        return ""
    }

    ; The thread's point on a diagram (see PresReviewThread.dia); false when
    ; there is no such thread.
    fn anchor:boolean (id:string dia:int node:string ax:double ay:double) {
        def i:int (this.indexOf(id))
        if ((i < 0) || (dia < 0)) {
            return false
        }
        def t:PresReviewThread (itemAt threads i)
        t.dia = dia
        t.node = node
        t.ax = (PresReview.clamp01(ax))
        t.ay = (PresReview.clamp01(ay))
        rev = (rev + 1)
        return true
    }

    ; Dragged to (`x`, `y`) of the slide at time `at`: off any diagram until
    ; Puts a thread on lines of a source file (see the top). `line`..`to`
    ; are the new version's lines; `removedFrom`..`removedTo` the old
    ; version's when it was made on lines the change took out (0 = not).
    fn setCode:boolean (id:string path:string line:int to:int text:string removedFrom:int removedTo:int repo:string commit:string dia:int node:string) {
        def i:int (this.indexOf(id))
        if ((i < 0) || ((strlen path) == 0)) {
            return false
        }
        def t:PresReviewThread (itemAt threads i)
        t.codePath = path
        t.codeLine = line
        if (line < 1) {
            t.codeLine = 1
        }
        t.codeTo = to
        if (to < t.codeLine) {
            t.codeTo = t.codeLine
        }
        t.codeText = text
        t.removedFrom = removedFrom
        t.removedTo = removedTo
        if (removedTo < removedFrom) {
            t.removedTo = removedFrom
        }
        t.codeRepo = repo
        t.codeCommit = commit
        t.viaDia = dia
        t.viaNode = node
        rev = (rev + 1)
        return true
    }

    ; The threads on a source file, in the order they were made.
    fn onFile:[PresReviewThread] (path:string) {
        def out:[PresReviewThread]
        for threads t:PresReviewThread i {
            if (t.codePath == path) {
                push out t
            }
        }
        return out
    }

    ; How many open threads there are on these files: a box's badge colour.
    fn openOnFiles:int (paths:[string]) {
        def n:int 0
        for threads t:PresReviewThread i {
            if ((t.closed == false) && (t.isCode())) {
                def hit:boolean false
                for paths p:string j {
                    if (p == t.codePath) {
                        hit = true
                    }
                }
                if hit {
                    n = (n + 1)
                }
            }
        }
        return n
    }

    ; A file came in anew and its lines moved: each thread on it whose line
    ; no longer says what it said is moved to the nearest line that does
    ; (its range moves with it). `lineAt` holds the new kept text's lines,
    ; `numbers` their numbers in the file. A thread whose text is found
    ; nowhere stays where it was. True when one moved.
    fn placeCode:boolean (path:string lines:[string] numbers:[int]) {
        def moved:boolean false
        for threads t:PresReviewThread i {
            if ((t.codePath == path) && ((strlen (trim t.codeText)) > 0)) {
                def want:string (trim t.codeText)
                def here:int -1
                def k:int 0
                while (k < (array_length numbers)) {
                    if ((itemAt numbers k) == t.codeLine) {
                        here = k
                    }
                    k = (k + 1)
                }
                def same:boolean false
                if ((here >= 0) && (here < (array_length lines))) {
                    same = ((trim (itemAt lines here)) == want)
                }
                if (same == false) {
                    def best:int -1
                    def bestD:int 1000000000
                    def j:int 0
                    while ((j < (array_length lines)) && (j < (array_length numbers))) {
                        if ((trim (itemAt lines j)) == want) {
                            def d:int ((itemAt numbers j) - t.codeLine)
                            if (d < 0) {
                                d = (0 - d)
                            }
                            if (d < bestD) {
                                bestD = d
                                best = (itemAt numbers j)
                            }
                        }
                        j = (j + 1)
                    }
                    if (best > 0) {
                        def span:int (t.codeTo - t.codeLine)
                        t.codeLine = best
                        t.codeTo = (best + span)
                        moved = true
                    }
                }
            }
        }
        if moved {
            rev = (rev + 1)
        }
        return moved
    }

    ; `anchor` puts it on one again. False when there is no such thread.
    fn move:boolean (id:string x:double y:double at:double) {
        def i:int (this.indexOf(id))
        if (i < 0) {
            return false
        }
        def t:PresReviewThread (itemAt threads i)
        t.x = (PresReview.clamp01(x))
        t.y = (PresReview.clamp01(y))
        t.dia = -1
        t.node = ""
        t.ax = 0.0
        t.ay = 0.0
        t.el = ""
        t.lost = false
        t.moved = at
        rev = (rev + 1)
        return true
    }

    ; Deleted for good: only a closed thread.
    fn remove:boolean (id:string) {
        def i:int (this.indexOf(id))
        if (i < 0) {
            return false
        }
        def t:PresReviewThread (itemAt threads i)
        if (t.closed == false) {
            return false
        }
        remove_index threads i
        push gone id
        rev = (rev + 1)
        return true
    }

    ; --- on an element ----------------------------------------------------------

    ; The thread on the element whose source starts `key`, at (`ex`, `ey`)
    ; of its box; false when there is no such thread.
    fn pinTo:boolean (id:string key:string ex:double ey:double) {
        def i:int (this.indexOf(id))
        if ((i < 0) || ((strlen (trim key)) == 0)) {
            return false
        }
        def t:PresReviewThread (itemAt threads i)
        t.el = (trim key)
        t.ex = (PresReview.clamp01(ex))
        t.ey = (PresReview.clamp01(ey))
        t.lost = false
        rev = (rev + 1)
        return true
    }

    ; The smallest block on `page` with (`x`, `y`) in it, or -1.
    sfn blockAt:int (blocks:[PresReviewBlock] page:int x:double y:double) {
        def best:int -1
        def bestA:double 0.0
        for blocks b:PresReviewBlock i {
            if ((b.page == page) && ((((x >= b.x) && (x <= (b.x + b.w))) && (y >= b.y)) && (y <= (b.y + b.h)))) {
                def a:double (b.w * b.h)
                if ((best < 0) || (a < bestA)) {
                    best = i
                    bestA = a
                }
            }
        }
        return best
    }

    ; How alike two sources are, 0..1: what they start and end with in
    ; common against the longer one. An edit inside a line keeps the most
    ; of both ends.
    sfn alike:double (a:string b:string) {
        def na:int (strlen a)
        def nb:int (strlen b)
        def n:int na
        if (nb > n) {
            n = nb
        }
        if (n == 0) {
            return 1.0
        }
        def m:int na
        if (nb < m) {
            m = nb
        }
        def pre:int 0
        while ((pre < m) && ((charAt a pre) == (charAt b pre))) {
            pre = (pre + 1)
        }
        def suf:int 0
        while (((suf < (m - pre))) && ((charAt a ((na - 1) - suf)) == (charAt b ((nb - 1) - suf)))) {
            suf = (suf + 1)
        }
        return ((to_double (pre + suf)) / (to_double n))
    }

    ; Where the element of `t` is now: a block with its key nearest the slide
    ; (and the point) it was on, else the most alike one, or -1.
    sfn findBlock:int (t:PresReviewThread blocks:[PresReviewBlock]) {
        def best:int -1
        def bestD:double 0.0
        for blocks b:PresReviewBlock i {
            if (b.key == t.el) {
                def ds:int (b.page - t.slide)
                if (ds < 0) {
                    ds = (0 - ds)
                }
                def cx:double ((b.x + (b.w * 0.5)) - t.x)
                def cy:double ((b.y + (b.h * 0.5)) - t.y)
                def d:double (((to_double ds) * 10.0) + ((cx * cx) + (cy * cy)))
                if ((best < 0) || (d < bestD)) {
                    best = i
                    bestD = d
                }
            }
        }
        if (best >= 0) {
            return best
        }
        def bestS:double 0.0
        for blocks b2:PresReviewBlock j {
            def a:double (PresReview.alike(b2.key t.el))
            if (a >= 0.5) {
                def ds2:int (b2.page - t.slide)
                if (ds2 < 0) {
                    ds2 = (0 - ds2)
                }
                ; the most alike; between equals the nearest slide
                def sc:double (a - ((to_double ds2) * 0.001))
                if ((best < 0) || (sc > bestS)) {
                    best = j
                    bestS = sc
                }
            }
        }
        return best
    }

    ; Each thread to its element again (`blocks`, every slide's), the others
    ; to their slide by `titles` (`place`); `at` is now, for a thread closed
    ; because its element was taken out. -> true when anything moved.
    fn follow:boolean (blocks:[PresReviewBlock] titles:[string] at:double) {
        def n:int (array_length titles)
        def moved:boolean false
        ; nothing laid out (a deck still opening): no element is gone
        def laid:boolean ((array_length blocks) > 0)
        for threads t:PresReviewThread i {
            if ((((strlen t.el) > 0) && ((t.isCode()) == false)) && laid) {
                def k:int (PresReview.findBlock(t blocks))
                if (k >= 0) {
                    def b:PresReviewBlock (itemAt blocks k)
                    def nx:double (PresReview.clamp01((b.x + (t.ex * b.w))))
                    def ny:double (PresReview.clamp01((b.y + (t.ey * b.h))))
                    if ((((b.page != t.slide) || (b.key != t.el)) || ((PresReview.near(nx t.x)) == false)) || ((PresReview.near(ny t.y)) == false)) {
                        moved = true
                    }
                    if ((t.dia >= 0) && (b.dia >= 0)) {
                        if (t.dia != b.dia) {
                            moved = true
                        }
                        t.dia = b.dia
                    }
                    t.slide = b.page
                    t.el = b.key
                    t.x = nx
                    t.y = ny
                    if ((t.slide >= 0) && (t.slide < n)) {
                        t.title = (itemAt titles t.slide)
                    }
                    if t.lost {
                        ; back (an undo): open again as it was
                        t.lost = false
                        t.closed = false
                        t.state = at
                        moved = true
                    }
                } {
                    if (t.lost == false) {
                        t.lost = true
                        if (t.closed == false) {
                            t.closed = true
                            t.state = at
                        }
                        moved = true
                    }
                }
            } {
                def s:int (PresReview.slideFor(t.slide t.title titles))
                if (s != t.slide) {
                    t.slide = s
                    moved = true
                }
                if ((s >= 0) && (s < n)) {
                    t.title = (itemAt titles s)
                }
            }
        }
        if moved {
            rev = (rev + 1)
        }
        return moved
    }

    sfn near:boolean (a:double b:double) {
        def d:double (a - b)
        return ((d < 0.0005) && (d > -0.0005))
    }

    ; --- the slides moved --------------------------------------------------------

    ; Each thread to its slide again, by `titles` (the deck's slide titles in
    ; order). -> true when a thread moved.
    fn place:boolean (titles:[string]) {
        def n:int (array_length titles)
        def moved:boolean false
        for threads t:PresReviewThread i {
            def at:int (PresReview.slideFor(t.slide t.title titles))
            if (at != t.slide) {
                t.slide = at
                moved = true
            }
            if ((at >= 0) && (at < n)) {
                t.title = (itemAt titles at)
            }
        }
        if moved {
            rev = (rev + 1)
        }
        return moved
    }

    sfn slideFor:int (slide:int title:string titles:[string]) {
        def n:int (array_length titles)
        if (n == 0) {
            return slide
        }
        if (((slide >= 0) && (slide < n)) && ((itemAt titles slide) == title)) {
            return slide
        }
        if ((strlen title) > 0) {
            def best:int -1
            def bestD:int 1000000
            def j:int 0
            while (j < n) {
                if ((itemAt titles j) == title) {
                    def d:int (j - slide)
                    if (d < 0) {
                        d = (0 - d)
                    }
                    if (d < bestD) {
                        best = j
                        bestD = d
                    }
                }
                j = (j + 1)
            }
            if (best >= 0) {
                return best
            }
        }
        if (slide >= n) {
            return (n - 1)
        }
        if (slide < 0) {
            return 0
        }
        return slide
    }

    ; --- two copies --------------------------------------------------------------

    ; What `other` has that this does not, and then the same comment twice
    ; made one (`dedupe`); -> true when anything changed.
    fn merge:boolean (other:PresReview) {
        def before:string (this.toJson())
        this.unite(other)
        this.dedupe()
        if ((this.toJson()) != before) {
            rev = (rev + 1)
            return true
        }
        return false
    }

    ; What `other` has that this does not; -> true when anything changed.
    fn unite:boolean (other:PresReview) {
        def changed:boolean false
        for other.gone g:string gi {
            if ((this.isGone(g)) == false) {
                push gone g
                def k:int (this.indexOf(g))
                if (k >= 0) {
                    remove_index threads k
                }
                changed = true
            }
        }
        for other.threads ot:PresReviewThread i {
            if ((this.isGone(ot.id)) == false) {
                def k2:int (this.indexOf(ot.id))
                if (k2 < 0) {
                    push threads (PresReview.copyThread(ot))
                    changed = true
                } {
                    def mine:PresReviewThread (itemAt threads k2)
                    for ot.msgs om:PresReviewMsg j {
                        if ((mine.hasMsg(om.id)) == false) {
                            mine.addMsg((PresReview.msg(om.id om.who om.name om.color om.text om.at)))
                            changed = true
                        }
                    }
                    if (ot.moved > mine.moved) {
                        mine.x = ot.x
                        mine.y = ot.y
                        mine.dia = ot.dia
                        mine.node = ot.node
                        mine.ax = ot.ax
                        mine.ay = ot.ay
                        mine.el = ot.el
                        mine.ex = ot.ex
                        mine.ey = ot.ey
                        mine.lost = ot.lost
                        mine.moved = ot.moved
                        if (ot.isCode()) {
                            PresReview.takeCode(mine ot)
                        }
                        changed = true
                    }
                    if (((mine.isCode()) == false) && (ot.isCode())) {
                        PresReview.takeCode(mine ot)
                        changed = true
                    }
                    if (((mine.dia < 0) && (ot.dia >= 0)) && (ot.moved == mine.moved)) {
                        mine.dia = ot.dia
                        mine.node = ot.node
                        mine.ax = ot.ax
                        mine.ay = ot.ay
                        changed = true
                    }
                    if ((((strlen mine.el) == 0) && ((strlen ot.el) > 0)) && (ot.moved == mine.moved)) {
                        mine.el = ot.el
                        mine.ex = ot.ex
                        mine.ey = ot.ey
                        mine.lost = ot.lost
                        changed = true
                    }
                    if ((ot.sevAt > mine.sevAt) && (ot.severity != mine.severity)) {
                        mine.severity = ot.severity
                        mine.sevAt = ot.sevAt
                        changed = true
                    }
                    if ((ot.state > mine.state) && ((ot.closed != mine.closed) || (ot.by != mine.by))) {
                        mine.closed = ot.closed
                        mine.state = ot.state
                        mine.by = ot.by
                        mine.lost = ot.lost
                        changed = true
                    }
                }
            }
        }
        if changed {
            rev = (rev + 1)
        }
        return changed
    }

    ; --- the same comment twice --------------------------------------------------

    ; whether id a comes before id b (character codes, then length): the one
    ; of two copies every copy of the file keeps
    sfn idBefore:boolean (a:string b:string) {
        def na:int (strlen a)
        def nb:int (strlen b)
        def i:int 0
        while ((i < na) && (i < nb)) {
            def ca:int (charAt a i)
            def cb:int (charAt b i)
            if (ca != cb) {
                return (ca < cb)
            }
            i = (i + 1)
        }
        return (na < nb)
    }

    ; the same message: who wrote it, its text and its time
    sfn sameMsg:boolean (a:PresReviewMsg b:PresReviewMsg) {
        return (((a.who == b.who) && (a.text == b.text)) && (a.at == b.at))
    }

    ; the same thread: its first message the same, on the same slide
    sfn sameThread:boolean (a:PresReviewThread b:PresReviewThread) {
        if (((array_length a.msgs) == 0) || ((array_length b.msgs) == 0)) {
            return false
        }
        if ((a.slide != b.slide) && (a.title != b.title)) {
            return false
        }
        return (PresReview.sameMsg((itemAt a.msgs 0) (itemAt b.msgs 0)))
    }

    ; a message a thread has twice under two ids: one, the smaller id
    sfn dropSameMsgs:void (t:PresReviewThread) {
        def i:int 1
        while (i < (array_length t.msgs)) {
            def m:PresReviewMsg (itemAt t.msgs i)
            def dup:boolean false
            def k:int 0
            while (k < i) {
                def p:PresReviewMsg (itemAt t.msgs k)
                if ((dup == false) && (PresReview.sameMsg(p m))) {
                    dup = true
                    if (PresReview.idBefore(m.id p.id)) {
                        p.id = m.id
                    }
                }
                k = (k + 1)
            }
            if dup {
                remove_index t.msgs i
            } {
                i = (i + 1)
            }
        }
    }

    ; The same comment twice: a copy of the file whose ids were made again
    ; (a deck copied, an old copy brought back) united with this one. A
    ; thread that is another's (`sameThread`) goes into the one with the
    ; smaller id, its messages and its later state with it, and its id is
    ; kept in "gone" so no copy brings it back; a message twice in a thread
    ; is kept once. Every copy so keeps the same ones.
    fn dedupe:void () {
        for threads t:PresReviewThread ti {
            PresReview.dropSameMsgs(t)
        }
        def again:boolean true
        while again {
            again = false
            def i:int 0
            while ((again == false) && (i < (array_length threads))) {
                def a:PresReviewThread (itemAt threads i)
                def j:int (i + 1)
                while ((again == false) && (j < (array_length threads))) {
                    def b:PresReviewThread (itemAt threads j)
                    if (PresReview.sameThread(a b)) {
                        def keep:PresReviewThread a
                        def drop:PresReviewThread b
                        if (PresReview.idBefore(b.id a.id)) {
                            keep = b
                            drop = a
                        }
                        def into:PresReview (new PresReview())
                        def moved:PresReviewThread (PresReview.copyThread(drop))
                        moved.id = keep.id
                        push into.threads moved
                        remove_index threads (this.indexOf(drop.id))
                        if ((this.isGone(drop.id)) == false) {
                            push gone drop.id
                        }
                        this.unite(into)
                        PresReview.dropSameMsgs(keep)
                        again = true
                    }
                    j = (j + 1)
                }
                i = (i + 1)
            }
        }
    }

    sfn takeCode:void (mine:PresReviewThread ot:PresReviewThread) {
        mine.codePath = ot.codePath
        mine.codeLine = ot.codeLine
        mine.codeTo = ot.codeTo
        mine.codeText = ot.codeText
        mine.removedFrom = ot.removedFrom
        mine.removedTo = ot.removedTo
        mine.codeRepo = ot.codeRepo
        mine.codeCommit = ot.codeCommit
        mine.viaDia = ot.viaDia
        mine.viaNode = ot.viaNode
    }

    sfn copyThread:PresReviewThread (t:PresReviewThread) {
        def c (new PresReviewThread())
        c.id = t.id
        c.slide = t.slide
        c.title = t.title
        c.x = t.x
        c.y = t.y
        c.closed = t.closed
        c.state = t.state
        c.by = t.by
        c.created = t.created
        c.dia = t.dia
        c.node = t.node
        c.ax = t.ax
        c.ay = t.ay
        c.moved = t.moved
        c.severity = t.severity
        c.sevAt = t.sevAt
        c.codePath = t.codePath
        c.codeLine = t.codeLine
        c.codeTo = t.codeTo
        c.codeText = t.codeText
        c.removedFrom = t.removedFrom
        c.removedTo = t.removedTo
        c.codeRepo = t.codeRepo
        c.codeCommit = t.codeCommit
        c.viaDia = t.viaDia
        c.viaNode = t.viaNode
        c.el = t.el
        c.ex = t.ex
        c.ey = t.ey
        c.lost = t.lost
        for t.msgs m:PresReviewMsg i {
            push c.msgs (PresReview.msg(m.id m.who m.name m.color m.text m.at))
        }
        return c
    }

    ; --- as text, to copy --------------------------------------------------------------

    ; The open threads by slide, then as they were made.
    fn openOrder:[PresReviewThread] () {
        def out:[PresReviewThread]
        def maxS:int 0
        for threads t0:PresReviewThread i0 {
            if (t0.slide > maxS) {
                maxS = t0.slide
            }
        }
        def s:int 0
        while (s <= maxS) {
            for threads t:PresReviewThread i {
                if ((t.slide == s) && (t.closed == false)) {
                    push out t
                }
            }
            s = (s + 1)
        }
        return out
    }

    ; "Slide 3 · Title" (one-based)
    sfn slideLabel:string (slide:int titles:[string]) {
        def s:string ("Slide " + (to_string (slide + 1)))
        if ((slide >= 0) && (slide < (array_length titles))) {
            def tt:string (itemAt titles slide)
            if ((strlen tt) > 0) {
                s = (s + " · " + tt)
            }
        }
        return s
    }

    ; where on the slide, in words: "at 42 % across, 30 % down", and the
    ; diagram's box when it is on one
    sfn whereText:string (t:PresReviewThread) {
        if (t.isCode()) {
            def cs:string ("source code comment on code/" + t.codePath + " line " + (to_string t.codeLine))
            if (t.codeTo > t.codeLine) {
                cs = ("source code comment on code/" + t.codePath + " lines " + (to_string t.codeLine) + "–" + (to_string t.codeTo))
            }
            if (t.removedFrom > 0) {
                cs = (cs + ", on lines " + (to_string t.removedFrom) + "–" + (to_string t.removedTo) + " the change removed")
            }
            if ((strlen t.codeCommit) > 0) {
                def c:string t.codeCommit
                if ((strlen c) > 7) {
                    c = (substring c 0 7)
                }
                cs = (cs + " at " + c)
            }
            return cs
        }
        def s:string ("at " + (to_string (to_int ((t.x * 100.0) + 0.5))) + " % across, " + (to_string (to_int ((t.y * 100.0) + 0.5))) + " % down")
        if (t.dia >= 0) {
            if ((strlen t.node) > 0) {
                s = (s + ", on the diagram's box \"" + t.node + "\"")
            } {
                s = (s + ", on the diagram")
            }
        }
        return s
    }

    ; the messages, one per line: "Name: text" (a line break in a message
    ; is kept, indented)
    sfn messagesText:string (t:PresReviewThread indent:string) {
        def nl:string (strfromcode 10)
        def out:string ""
        for t.msgs m:PresReviewMsg i {
            def nm:string m.name
            if ((strlen nm) == 0) {
                nm = "Someone"
            }
            def body:string (PresReview.joinLines((strsplit m.text nl) (nl + indent + "  ")))
            out = (out + indent + nm + ": " + body + nl)
        }
        return out
    }

    sfn joinLines:string (parts:[string] sep:string) {
        def out:string ""
        for parts p:string i {
            if (i > 0) {
                out = (out + sep)
            }
            out = (out + p)
        }
        return out
    }

    ; The comments for the editor's AI assistant: every thread on `slide`
    ; (from 0; resolved ones said so), then the open ones on the other
    ; slides. Each with its id (to answer it by), where it is pinned, the
    ; block of the slide it is on and its messages. "" when there are none.
    fn aiText:string (slide:int titles:[string]) {
        def out:string ""
        for (this.onSlide(slide)) t:PresReviewThread i {
            out = (out + (PresReview.aiThread(t titles)))
        }
        for (this.openOrder()) o:PresReviewThread k {
            if (o.slide != slide) {
                out = (out + (PresReview.aiThread(o titles)))
            }
        }
        return (trim out)
    }

    sfn aiThread:string (t:PresReviewThread titles:[string]) {
        def nl:string (strfromcode 10)
        def state:string "open"
        if t.closed {
            state = "resolved"
        }
        if ((strlen t.severity) > 0) {
            state = (state + ", severity " + t.severity)
        }
        def head:string ("Thread " + t.id + " (" + state + ") on " + (PresReview.slideLabel(t.slide titles)) + ", " + (PresReview.whereText(t)))
        def on:string (trim t.el)
        if (((strlen on) > 0) && ((t.isCode()) == false)) {
            def first:string (itemAt (strsplit on nl) 0)
            if ((strlen first) > 120) {
                first = ((substring first 0 120) + "…")
            }
            head = (head + ", on the block \"" + first + "\"")
        }
        return (head + ":" + nl + (PresReview.messagesText(t "  ")) + nl)
    }

    ; One thread to copy: where it is, then its messages.
    fn threadText:string (id:string titles:[string]) {
        def f@(optional):PresReviewThread (this.find(id))
        if (null? f) {
            return ""
        }
        def t:PresReviewThread (unwrap f)
        def nl:string (strfromcode 10)
        def head:string ((PresReview.slideLabel(t.slide titles)) + ", " + (PresReview.whereText(t)))
        if ((strlen t.severity) > 0) {
            head = (head + ", severity " + t.severity)
        }
        if t.closed {
            head = (head + " (resolved)")
        }
        return (head + nl + (PresReview.messagesText(t "")))
    }

    ; A fence longer than any run of backticks in `text` (at least three).
    sfn fenceFor:string (text:string) {
        def best:int 0
        def run:int 0
        def i:int 0
        def n:int (strlen text)
        while (i < n) {
            if ((substring text i (i + 1)) == "`") {
                run = (run + 1)
                if (run > best) {
                    best = run
                }
            } {
                run = 0
            }
            i = (i + 1)
        }
        def f:string "```"
        def k:int 3
        while (k <= best) {
            f = (f + "`")
            k = (k + 1)
        }
        return f
    }

    ; The open comments as instructions for someone (an agent) to act on:
    ; numbered [1], [2]… in slide order, and under each slide that has some
    ; its Markdown (`sources`, one per slide; "" leaves it out).
    fn openMarkdown:string (deck:string titles:[string] sources:[string]) {
        def nl:string (strfromcode 10)
        def order:[PresReviewThread] (this.openOrder())
        def out:string ("# Open comments")
        if ((strlen deck) > 0) {
            out = (out + ": " + deck)
        }
        out = (out + nl + nl)
        if ((array_length order) == 0) {
            return (out + "No open comments." + nl)
        }
        def slides:int 0
        def last:int -1
        for order t0:PresReviewThread i0 {
            if (t0.slide != last) {
                slides = (slides + 1)
                last = t0.slide
            }
        }
        out = (out + (to_string (array_length order)) + " open comment" + (? ((array_length order) == 1) "" "s") + " on " + (to_string slides) + " slide" + (? (slides == 1) "" "s") + ". Each is numbered [n] and placed on its slide (from the top left). Change the slides so each comment is taken care of." + nl)
        def k:int 0
        last = -1
        while (k < (array_length order)) {
            def t:PresReviewThread (itemAt order k)
            if (t.slide != last) {
                last = t.slide
                out = (out + nl + "## " + (PresReview.slideLabel(t.slide titles)) + nl + nl)
                def j:int k
                while (j < (array_length order)) {
                    def tj:PresReviewThread (itemAt order j)
                    if (tj.slide == t.slide) {
                        def sevNote:string ""
                        if ((strlen tj.severity) > 0) {
                            sevNote = (" (severity " + tj.severity + ")")
                        }
                        out = (out + "[" + (to_string (j + 1)) + "] " + (PresReview.whereText(tj)) + sevNote + nl + (PresReview.messagesText(tj "    ")))
                    }
                    j = (j + 1)
                }
                if ((t.slide < (array_length sources)) && ((strlen (trim (itemAt sources t.slide))) > 0)) {
                    def src:string (itemAt sources t.slide)
                    def fence:string (PresReview.fenceFor(src))
                    def body:string src
                    if ((substring body ((strlen body) - 1) (strlen body)) != nl) {
                        body = (body + nl)
                    }
                    out = (out + nl + "The slide's Markdown:" + nl + nl + fence + "markdown" + nl + body + fence + nl)
                }
            }
            k = (k + 1)
        }
        return out
    }

    ; the offset of the line break at or after `at`, -1 when none
    sfn lineEnd:int (text:string at:int) {
        def len:int (strlen text)
        def k:int at
        while (k < len) {
            if ((charAt text k) == 10) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; Where a slide's footnote marks go in `src`, its section starting at
    ; `at`: [offset, 0] to add " [^n]" at the end of its heading line, or
    ; [offset, 1] to put them on a line of their own above what it starts
    ; with (no heading: a fence, a table, text).
    sfn markPlace:[int] (src:string at:int) {
        def len:int (strlen src)
        def k:int at
        while (k < len) {
            def nl:int (PresReview.lineEnd(src k))
            def stop:int nl
            if (nl < 0) {
                stop = len
            }
            def line:string (trim (substring src k stop))
            if ((strlen line) > 0) {
                if ((indexOf line "#") == 0) {
                    def e:int stop
                    while ((e > k) && ((charAt src (e - 1)) == 13)) {
                        e = (e - 1)
                    }
                    return ([] _:int (e 0))
                }
                return ([] _:int (k 1))
            }
            if (nl < 0) {
                k = len
            } {
                k = (nl + 1)
            }
        }
        return ([] _:int (len 1))
    }

    ; The deck's Markdown with the open comments in it as footnotes: [^n] on
    ; each commented slide's heading (`starts`: where each slide's section
    ; begins in `src`, -1 when unknown), numbered as `openMarkdown` numbers
    ; them, and the notes themselves at the end. `placedOnly`: only the
    ; comments on slides that are in `src` (a start other than -1), as when
    ; `src` is some of the deck's slides.
    fn markdownWithComments:string (src:string starts:[int] titles:[string] placedOnly:boolean) {
        def nl:string (strfromcode 10)
        def all:[PresReviewThread] (this.openOrder())
        def order:[PresReviewThread]
        for all t0:PresReviewThread i0 {
            def placed:boolean false
            if ((t0.slide >= 0) && (t0.slide < (array_length starts))) {
                placed = ((itemAt starts t0.slide) >= 0)
            }
            if ((placedOnly == false) || placed) {
                push order t0
            }
        }
        if ((array_length order) == 0) {
            return src
        }
        ; the marks, gathered by where they go
        def places:[int]
        def modes:[int]
        def marks:[string]
        for order t:PresReviewThread k {
            def at:int -1
            if ((t.slide >= 0) && (t.slide < (array_length starts))) {
                at = (itemAt starts t.slide)
            }
            if (at >= 0) {
                def pm:[int] (PresReview.markPlace(src at))
                def pos:int (itemAt pm 0)
                def mark:string ("[^" + (to_string (k + 1)) + "]")
                def found:int (indexOf places pos)
                if (found < 0) {
                    push places pos
                    push modes (itemAt pm 1)
                    push marks mark
                } {
                    set marks found ((itemAt marks found) + mark)
                }
            }
        }
        ; put in from the last place back, so the earlier offsets hold
        def out:string src
        def done:[int]
        def left:int (array_length places)
        while (left > 0) {
            def best:int -1
            for places p:int i {
                if ((indexOf done i) < 0) {
                    if ((best < 0) || (p > (itemAt places best))) {
                        best = i
                    }
                }
            }
            push done best
            def pos:int (itemAt places best)
            def ins:string (" " + (itemAt marks best))
            if ((itemAt modes best) == 1) {
                ins = ((itemAt marks best) + nl + nl)
            }
            out = ((substring out 0 pos) + ins + (substring out pos (strlen out)))
            left = (left - 1)
        }
        if (((strlen out) > 0) && ((substring out ((strlen out) - 1) (strlen out)) != nl)) {
            out = (out + nl)
        }
        out = (out + nl)
        for order t2:PresReviewThread k2 {
            out = (out + "[^" + (to_string (k2 + 1)) + "]: " + (PresReview.slideLabel(t2.slide titles)) + ", " + (PresReview.whereText(t2)) + nl + (PresReview.messagesText(t2 "    ")))
        }
        return out
    }

    ; --- the file ------------------------------------------------------------------

    sfn PATH:string () {
        return "review/comments.json"
    }

    sfn num:VlJson (v:double) {
        return (VlJson.numberValue(v))
    }

    fn toJson:string () {
        def root:VlJson (VlJson.objectValue())
        root.setMember("version" (VlJson.intValue(1)))
        def arr:VlJson (VlJson.arrayValue())
        for threads t:PresReviewThread i {
            def o:VlJson (VlJson.objectValue())
            o.setMember("id" (VlJson.stringValue(t.id)))
            ; one-based in the file, as people count slides
            o.setMember("slide" (VlJson.intValue((t.slide + 1))))
            o.setMember("title" (VlJson.stringValue(t.title)))
            o.setMember("x" (PresReview.num((PresReview.round4(t.x)))))
            o.setMember("y" (PresReview.num((PresReview.round4(t.y)))))
            o.setMember("closed" (VlJson.boolValue(t.closed)))
            o.setMember("state" (PresReview.num(t.state)))
            o.setMember("by" (VlJson.stringValue(t.by)))
            o.setMember("created" (PresReview.num(t.created)))
            if (t.moved > 0.0) {
                o.setMember("moved" (PresReview.num(t.moved)))
            }
            if ((strlen t.severity) > 0) {
                o.setMember("severity" (VlJson.stringValue(t.severity)))
            }
            if (t.sevAt > 0.0) {
                o.setMember("severityAt" (PresReview.num(t.sevAt)))
            }
            if (t.dia >= 0) {
                def on:VlJson (VlJson.objectValue())
                on.setMember("diagram" (VlJson.intValue(t.dia)))
                if ((strlen t.node) > 0) {
                    on.setMember("node" (VlJson.stringValue(t.node)))
                }
                on.setMember("x" (PresReview.num((PresReview.round4(t.ax)))))
                on.setMember("y" (PresReview.num((PresReview.round4(t.ay)))))
                o.setMember("on" on)
            }
            if ((strlen t.el) > 0) {
                def eo:VlJson (VlJson.objectValue())
                eo.setMember("key" (VlJson.stringValue(t.el)))
                eo.setMember("x" (PresReview.num((PresReview.round4(t.ex)))))
                eo.setMember("y" (PresReview.num((PresReview.round4(t.ey)))))
                o.setMember("element" eo)
                if t.lost {
                    o.setMember("lost" (VlJson.boolValue(true)))
                }
            }
            if (t.isCode()) {
                def co:VlJson (VlJson.objectValue())
                co.setMember("path" (VlJson.stringValue(t.codePath)))
                co.setMember("line" (VlJson.intValue(t.codeLine)))
                if (t.codeTo > t.codeLine) {
                    co.setMember("to" (VlJson.intValue(t.codeTo)))
                }
                if ((strlen t.codeText) > 0) {
                    co.setMember("text" (VlJson.stringValue(t.codeText)))
                }
                if (t.removedFrom > 0) {
                    def rm:VlJson (VlJson.arrayValue())
                    push rm.arr (VlJson.intValue(t.removedFrom))
                    push rm.arr (VlJson.intValue(t.removedTo))
                    co.setMember("removed" rm)
                }
                if ((strlen t.codeRepo) > 0) {
                    co.setMember("repo" (VlJson.stringValue(t.codeRepo)))
                }
                if ((strlen t.codeCommit) > 0) {
                    co.setMember("commit" (VlJson.stringValue(t.codeCommit)))
                }
                if (t.viaDia >= 0) {
                    def via:VlJson (VlJson.objectValue())
                    via.setMember("diagram" (VlJson.intValue(t.viaDia)))
                    if ((strlen t.viaNode) > 0) {
                        via.setMember("node" (VlJson.stringValue(t.viaNode)))
                    }
                    co.setMember("via" via)
                }
                o.setMember("code" co)
            }
            def ms:VlJson (VlJson.arrayValue())
            for t.msgs m:PresReviewMsg j {
                def mo:VlJson (VlJson.objectValue())
                mo.setMember("id" (VlJson.stringValue(m.id)))
                mo.setMember("who" (VlJson.stringValue(m.who)))
                mo.setMember("name" (VlJson.stringValue(m.name)))
                mo.setMember("color" (VlJson.stringValue(m.color)))
                mo.setMember("text" (VlJson.stringValue(m.text)))
                mo.setMember("at" (PresReview.num(m.at)))
                push ms.arr mo
            }
            o.setMember("messages" ms)
            push arr.arr o
        }
        root.setMember("threads" arr)
        def del:VlJson (VlJson.arrayValue())
        for gone g:string k {
            push del.arr (VlJson.stringValue(g))
        }
        root.setMember("deleted" del)
        def w (new VlJsonWriter())
        w.decimals = 4
        return (w.writePretty(root))
    }

    sfn round4:double (v:double) {
        return ((to_double (to_int ((v * 10000.0) + 0.5))) / 10000.0)
    }

    ; A file read back; an empty review when the text is not one. Threads
    ; without an id or a message are left out.
    sfn parse:PresReview (text:string) {
        def r (new PresReview())
        if ((strlen (trim text)) == 0) {
            return r
        }
        def p (new VlJsonParser())
        def root:VlJson (p.parse(text))
        if ((p.ok == false) || ((root.isObject()) == false)) {
            return r
        }
        def del:VlJson (root.get("deleted"))
        def d:int 0
        while (d < (del.count())) {
            def g:VlJson (del.at(d))
            if ((g.isString()) && (((strlen (g.asString())) > 0) && ((r.isGone((g.asString()))) == false))) {
                push r.gone (g.asString())
            }
            d = (d + 1)
        }
        def arr:VlJson (root.get("threads"))
        def i:int 0
        while (i < (arr.count())) {
            def o:VlJson (arr.at(i))
            def id:string (o.stringOr("id" ""))
            if ((o.isObject()) && ((((strlen id) > 0) && ((r.has(id)) == false)) && ((r.isGone(id)) == false))) {
                def t (new PresReviewThread())
                t.id = id
                t.slide = ((o.intOr("slide" 1)) - 1)
                if (t.slide < 0) {
                    t.slide = 0
                }
                t.title = (o.stringOr("title" ""))
                t.x = (PresReview.clamp01((o.doubleOr("x" 0.5))))
                t.y = (PresReview.clamp01((o.doubleOr("y" 0.5))))
                t.closed = (o.boolOr("closed" false))
                t.state = (o.doubleOr("state" 0.0))
                t.by = (o.stringOr("by" ""))
                t.created = (o.doubleOr("created" 0.0))
                t.moved = (o.doubleOr("moved" 0.0))
                t.severity = (PresReview.severityOf((o.stringOr("severity" ""))))
                t.sevAt = (o.doubleOr("severityAt" 0.0))
                def on:VlJson (o.get("on"))
                if ((on.isObject()) && ((on.intOr("diagram" -1)) >= 0)) {
                    t.dia = (on.intOr("diagram" -1))
                    t.node = (on.stringOr("node" ""))
                    t.ax = (PresReview.clamp01((on.doubleOr("x" 0.5))))
                    t.ay = (PresReview.clamp01((on.doubleOr("y" 0.5))))
                }
                def eo:VlJson (o.get("element"))
                if ((eo.isObject()) && ((strlen (trim (eo.stringOr("key" "")))) > 0)) {
                    t.el = (trim (eo.stringOr("key" "")))
                    t.ex = (PresReview.clamp01((eo.doubleOr("x" 0.5))))
                    t.ey = (PresReview.clamp01((eo.doubleOr("y" 0.5))))
                    t.lost = (o.boolOr("lost" false))
                }
                def co:VlJson (o.get("code"))
                if ((co.isObject()) && ((strlen (co.stringOr("path" ""))) > 0)) {
                    t.codePath = (co.stringOr("path" ""))
                    t.codeLine = (co.intOr("line" 1))
                    if (t.codeLine < 1) {
                        t.codeLine = 1
                    }
                    t.codeTo = (co.intOr("to" t.codeLine))
                    if (t.codeTo < t.codeLine) {
                        t.codeTo = t.codeLine
                    }
                    t.codeText = (co.stringOr("text" ""))
                    def rm:VlJson (co.get("removed"))
                    if ((rm.count()) >= 2) {
                        t.removedFrom = ((rm.at(0)).asInt())
                        t.removedTo = ((rm.at(1)).asInt())
                    }
                    t.codeRepo = (co.stringOr("repo" ""))
                    t.codeCommit = (co.stringOr("commit" ""))
                    def via:VlJson (co.get("via"))
                    if (via.isObject()) {
                        t.viaDia = (via.intOr("diagram" -1))
                        t.viaNode = (via.stringOr("node" ""))
                    }
                }
                def ms:VlJson (o.get("messages"))
                def j:int 0
                while (j < (ms.count())) {
                    def mo:VlJson (ms.at(j))
                    def mid:string (mo.stringOr("id" ""))
                    def mt:string (mo.stringOr("text" ""))
                    if ((mo.isObject()) && ((((strlen mid) > 0) && ((strlen mt) > 0)) && ((t.hasMsg(mid)) == false))) {
                        t.addMsg((PresReview.msg(mid (mo.stringOr("who" "")) (mo.stringOr("name" "")) (mo.stringOr("color" "")) mt (mo.doubleOr("at" 0.0)))))
                    }
                    j = (j + 1)
                }
                if ((array_length t.msgs) > 0) {
                    push r.threads t
                }
            }
            i = (i + 1)
        }
        return r
    }

    ; --- times as people read them -------------------------------------------------

    ; "14:05" today, "3.10. 14:05" this year, "3.10.2025 14:05" before;
    ; `offsetMin` is the reader's time zone (minutes east of UTC).
    sfn timeText:string (at:double now:double offsetMin:int) {
        def day:double 86400000.0
        def a:double (at + ((to_double offsetMin) * 60000.0))
        def n:double (now + ((to_double offsetMin) * 60000.0))
        def ad:int (floor (a / day))
        def nd:int (floor (n / day))
        def mins:int (floor ((a - ((to_double ad) * day)) / 60000.0))
        def hh:int (idiv mins 60)
        def mm:int (mins - (hh * 60))
        def clock:string ((to_string hh) + ":" + (? (mm < 10) "0" "") + (to_string mm))
        if (ad == nd) {
            return clock
        }
        def ymd:[int] (PresReview.civil(ad))
        def nymd:[int] (PresReview.civil(nd))
        def date:string ((to_string (itemAt ymd 2)) + "." + (to_string (itemAt ymd 1)) + ".")
        if ((itemAt ymd 0) != (itemAt nymd 0)) {
            date = (date + (to_string (itemAt ymd 0)))
        }
        return (date + " " + clock)
    }

    ; days since 1970-01-01 → [year, month, day] (Howard Hinnant's algorithm)
    sfn civil:[int] (days:int) {
        def z:int (days + 719468)
        def era:int (idiv z 146097)
        if (z < 0) {
            era = (idiv (z - 146096) 146097)
        }
        def doe:int (z - (era * 146097))
        def yoe:int (idiv (((doe - (idiv doe 1460)) + (idiv doe 36524)) - (idiv doe 146096)) 365)
        def y:int (yoe + (era * 400))
        def doy:int (doe - (((365 * yoe) + (idiv yoe 4)) - (idiv yoe 100)))
        def mp:int (idiv ((5 * doy) + 2) 153)
        def d:int ((doy - (idiv ((153 * mp) + 2) 5)) + 1)
        def m:int (? (mp < 10) (mp + 3) (mp - 9))
        if (m <= 2) {
            y = (y + 1)
        }
        def out:[int]
        push out y
        push out m
        push out d
        return out
    }
}
