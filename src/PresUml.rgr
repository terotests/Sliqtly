                if (((c == 61) && (e < 0)) && (p < 0)) {
                    def nx:int 0
                    if ((i + 1) < n) {
                        nx = (charAt t (i + 1))
                    }
                    def pv:int 0
                    if (i > 0) {
                        pv = (charAt t (i - 1))
                    }
                    if ((((nx != 61) && (nx != 62)) && (pv != 33)) && ((pv != 60) && (pv != 62))) {
                        e = i
                    }
                }
