                } {
                    m.params = (PresUml.paramNames((trim (substring init2 0 ar))))
                }
            } {
                def nameEnd:int p
                def ne:int p
                while ((ne > 0) && (PresUml.isSpace((charAt t (ne - 1))))) {
                    ne = (ne - 1)
                }
                ; generic parameters right before (: foo<T>(…)
                if ((ne > 0) && ((charAt t (ne - 1)) == 62)) {
                    def dep:int 0
                    def q:int (ne - 1)
                    while (q >= 0) {
                        if ((charAt t q) == 62) {
                            dep = (dep + 1)
                        }
                        if ((charAt t q) == 60) {
                            dep = (dep - 1)
                            if (dep == 0) {
