                }
            }
        }
        for (PresUml.commaParts(im)) m:string mk {
            def nm4:string (PresUml.lastName((trim m)))
            if ((strlen nm4) > 0) {
                push cls.ifaces nm4
            }
        }
    }

    ; "pkg.Base(x) {" → Base
    sfn lastName:string (t:string) {
        def s:string t
        def p:int (indexOf s "(")
        if (p >= 0) {
            s = (substring s 0 p)
        }
        def sp:int (indexOf (trim s) " ")
        if (sp >= 0) {
            s = (substring (trim s) 0 sp)
        }
        s = (trim s)
        def dot:int (lastIndexOf s ".")
        if (dot >= 0) {
            s = (substring s (dot + 1) (strlen s))
        }
        return (PresUml.identAt(s 0))
    }

    ; impl Trait for Type { fn … } / impl Type { fn … }
    fn readImpl:void (file:string s:string ext:string first:string head:string stop:int) {
        def h:string (PresUml.noGenerics(head))
        def target:string first
        def trait:string ""
        def fi:int (indexOf h " for ")
        if (fi >= 0) {
            trait = first
            target = (PresUml.lastName((trim (substring h (fi + 5) (strlen h)))))
        }
        def wi:int (indexOf target " ")
        if (wi >= 0) {
            target = (substring target 0 wi)
