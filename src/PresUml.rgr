        def arrowField:boolean false
        if (((e >= 0) && ((p < 0) || (e < p))) && ((indexOf t "=>") > e)) {
            def init:string (trim (substring t (e + 1) (strlen t)))
            if (((startsWith init "(") || (startsWith init "async")) || ((PresUml.isIdStart((charAt init 0))) && ((indexOf init "=>") < 24))) {
                arrowField = true
