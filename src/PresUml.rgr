            m.name = (PresUml.identBefore(lhs (strlen lhs)))
            m.type = (PresUml.typeText((PresUml.upTo((substring f (colon + 1) (strlen f))))))
        } {
            def lhs2:string f
            while ((strlen lhs2) > 0) {
