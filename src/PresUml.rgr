; =============================================================================
; PresUml — a UML class diagram read from source code
; =============================================================================
; Source files in, a Mermaid `classDiagram` out, which a slide draws as any
; other diagram. It reads declarations, not programs: classes, interfaces,
; structs, enums and traits with what they extend and implement, their fields
; and methods (visibility, static, a type when the source writes one), and a
; field whose type names another class read as an association.
;
;   TypeScript/JavaScript, Java, C#, Kotlin, Swift, Dart, PHP, Rust: braces
;   Go: type … struct / interface, func (r *T) M()
;   Python: class X(Base): with def and self.x = …
;   Ranger: class X { Extends(…) def … fn … sfn … }
;
; Comments and strings are blanked first, so a brace or a keyword in either
; does not count. Fetch-free and UI-free (mcp-go/uml_test.go).
; =============================================================================

class PresUmlMember {
    def name:string ""
    ; as the source writes it, compacted; "" when it writes none
    def type:string ""
    ; a method's parameter names, ", " between
    def params:string ""
    def method:boolean false
    ; + public, - private, # protected, ~ package/internal
    def vis:string "+"
    def isStatic:boolean false
    def isAbstract:boolean false
}

class PresUmlClass {
    def name:string ""
    ; class, abstract, interface, enum, struct, trait
    def kind:string "class"
    def file:string ""
    def bases:[string]
    def ifaces:[string]
    def fields:[PresUmlMember]
    def methods:[PresUmlMember]
    ; seen only as a Go method receiver or a Rust impl: no declaration read
    def implied:boolean false

    fn memberCount:int () {
        return ((array_length fields) + (array_length methods))
    }
}

class PresUmlEdge {
    def from:string ""
    def to:string ""
    ; "<|--" extends (to is the base), "<|.." implements, "-->" association
    def arrow:string ""
    def label:string ""
    def many:boolean false
}

class PresUml {
    def classes:[PresUmlClass]
    ; files read, and files left out (a language this does not read)
    def files:[string]
    def skipped:[string]

    ; the language a file is read as: c (braces), go, py, rs, rgr, or ""
    sfn langOf:string (name:string) {
        def dot:int (lastIndexOf name ".")
        if (dot < 0) {
            return ""
        }
        def ext:string (to_lowercase (substring name (dot + 1) (strlen name)))
        for ([] _:string ("ts" "tsx" "mts" "cts" "js" "jsx" "mjs" "cjs" "java" "cs" "kt" "kts" "swift" "dart" "php" "scala")) e:string i {
            if (e == ext) {
                return "c"
            }
        }
        if (ext == "go") {
            return "go"
        }
        if ((ext == "py") || (ext == "pyi")) {
            return "py"
        }
        if (ext == "rs") {
            return "rs"
        }
        if (ext == "rgr") {
            return "rgr"
        }
        return ""
    }

    ; the file's classes added (merged into a class of the same name); how
    ; many it declares
    fn add:int (name:string text:string) {
        def lang:string (PresUml.langOf(name))
        if ((strlen lang) == 0) {
            push skipped name
            return 0
        }
        push files name
        def before:int (array_length classes)
        def ext:string (to_lowercase (substring name ((lastIndexOf name ".") + 1) (strlen name)))
        def s:string (PresUml.clean(text lang))
        if (lang == "c") {
            this.readBraces(name s ext)
        }
        if (lang == "rs") {
            this.readBraces(name s "rs")
        }
        if (lang == "go") {
            this.readGo(name s)
        }
        if (lang == "py") {
            this.readPython(name s)
        }
        if (lang == "rgr") {
            this.readRanger(name s)
        }
        def declared:int 0
        for classes c:PresUmlClass ci {
            if ((c.file == name) && (c.implied == false)) {
                declared = (declared + 1)
            }
        }
        if (declared == 0) {
            return ((array_length classes) - before)
        }
        return declared
    }

    ; the index of the class of that name, -1 when there is none
    fn indexOfClass:int (name:string) {
        for classes c:PresUmlClass i {
            if (c.name == name) {
                return i
            }
        }
        return -1
    }

    ; the class of that name, a new one when there is none yet
    fn classOf:PresUmlClass (name:string file:string kind:string implied:boolean) {
        def at:int (this.indexOfClass(name))
        if (at >= 0) {
            def c:PresUmlClass (itemAt classes at)
            if (c.implied && (implied == false)) {
                c.implied = false
                c.kind = kind
                c.file = file
            }
            return c
        }
        def n (new PresUmlClass())
        n.name = name
        n.kind = kind
        n.file = file
        n.implied = implied
        push classes n
        return n
    }

    ; --- characters

    sfn isIdStart:boolean (c:int) {
        return (((((c >= 97) && (c <= 122)) || ((c >= 65) && (c <= 90))) || ((c == 95) || (c == 36))) || (c >= 128))
    }

    sfn isIdChar:boolean (c:int) {
        return ((PresUml.isIdStart(c)) || ((c >= 48) && (c <= 57)))
    }

    sfn isSpace:boolean (c:int) {
        return ((((c == 32) || (c == 9)) || (c == 10)) || (c == 13))
    }

    sfn isUpper:boolean (c:int) {
        return ((c >= 65) && (c <= 90))
    }

    ; the source with comments blanked (a line comment keeps its newline)
    ; and strings emptied ("" stays), so neither brace nor keyword in them
    ; counts
    sfn clean:string (text:string lang:string) {
        def out:[string]
        def n:int (strlen text)
        def i:int 0
        def run:int 0
        def lineCmt:string "//"
        if (lang == "py") {
            lineCmt = "#"
        }
        if (lang == "rgr") {
            lineCmt = ";"
        }
        while (i < n) {
            def c:int (charAt text i)
            def lc:boolean false
            if (lang == "py") {
                lc = (c == 35)
            }
            if (lang == "rgr") {
                lc = (c == 59)
            }
            if ((lang != "py") && (lang != "rgr")) {
                lc = ((c == 47) && (((i + 1) < n) && ((charAt text (i + 1)) == 47)))
            }
            if (lang == "c") {
                ; PHP and Python-ish shells: # comments in PHP only matter
                ; rarely; left alone
            }
            if lc {
                push out (substring text run i)
                while ((i < n) && ((charAt text i) != 10)) {
                    i = (i + 1)
                }
                run = i
                continue
            }
            def block:boolean (((lang != "py") && (lang != "rgr")) && ((c == 47) && (((i + 1) < n) && ((charAt text (i + 1)) == 42))))
            if block {
                push out (substring text run i)
                push out " "
                i = (i + 2)
                while ((i < n) && (((charAt text i) != 42) || (((i + 1) >= n) || ((charAt text (i + 1)) != 47)))) {
                    i = (i + 1)
                }
                i = (i + 2)
                if (i > n) {
                    i = n
                }
                run = i
                continue
            }
            def quote:boolean ((c == 34) || ((c == 96) && ((lang != "py") && (lang != "rgr"))))
            if (c == 39) {
                if (lang == "rs") {
                    ; 'a' and '\n' are characters; 'a alone is a lifetime
                    quote = ((((i + 2) < n) && ((charAt text (i + 2)) == 39)) || (((i + 1) < n) && ((charAt text (i + 1)) == 92)))
                } {
                    quote = ((lang != "rgr") && (lang != "go"))
                    if (lang == "go") {
                        quote = true
                    }
                }
            }
            if quote {
                push out (substring text run i)
                push out "\"\""
                ; a Python (or Kotlin, Swift) triple quote runs to its own end
                def triple:boolean ((((i + 2) < n) && ((charAt text (i + 1)) == c)) && ((charAt text (i + 2)) == c))
                if triple {
                    i = (i + 3)
                    while ((i < n) && ((((charAt text i) != c) || (((i + 2) >= n) || ((charAt text (i + 1)) != c))) || ((charAt text (i + 2)) != c))) {
                        i = (i + 1)
                    }
                    i = (i + 3)
                } {
                    i = (i + 1)
                    while ((i < n) && ((charAt text i) != c)) {
                        if ((charAt text i) == 92) {
                            i = (i + 1)
                        }
                        ; a plain string ends at its line (an unclosed one
                        ; must not swallow the file); a template does not
                        if (((charAt text i) == 10) && (c != 96)) {
                            break
                        }
                        i = (i + 1)
                    }
                    i = (i + 1)
                }
                if (i > n) {
                    i = n
                }
                run = i
                continue
            }
            i = (i + 1)
        }
        push out (substring text run n)
        return (join out "")
    }

    ; the index of the bracket closing the one at `at`, or the end
    sfn closing:int (s:string at:int) {
        def open:int (charAt s at)
        def close:int 41
        if (open == 123) {
            close = 125
        }
        if (open == 91) {
            close = 93
        }
        if (open == 60) {
            close = 62
        }
        def depth:int 0
        def i:int at
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            if (c == open) {
                depth = (depth + 1)
            }
            if (c == close) {
                depth = (depth - 1)
                if (depth == 0) {
                    return i
                }
            }
            i = (i + 1)
        }
        return n
    }

    sfn skipSpace:int (s:string at:int) {
        def i:int at
        while ((i < (strlen s)) && (PresUml.isSpace((charAt s i)))) {
            i = (i + 1)
        }
        return i
    }

    ; the identifier at `at` (dots and :: joined: pkg.Type), "" when none
    sfn identAt:string (s:string at:int) {
        def n:int (strlen s)
        if ((at >= n) || ((PresUml.isIdStart((charAt s at))) == false)) {
            return ""
        }
        def j:int at
        while ((j < n) && (PresUml.isIdChar((charAt s j)))) {
            j = (j + 1)
        }
        return (substring s at j)
    }

    ; the identifier ending just before `end` (spaces skipped), "" for none
    sfn identBefore:string (s:string end:int) {
        def e:int end
        while ((e > 0) && (PresUml.isSpace((charAt s (e - 1))))) {
            e = (e - 1)
        }
        def b:int e
        while ((b > 0) && (PresUml.isIdChar((charAt s (b - 1))))) {
            b = (b - 1)
        }
        if ((b == e) || ((PresUml.isIdStart((charAt s b))) == false)) {
            return ""
        }
        return (substring s b e)
    }

    ; the text with <…> (generics) left out
    sfn noGenerics:string (s:string) {
        def out:[string]
        def depth:int 0
        def run:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            if (c == 60) {
                if (depth == 0) {
                    push out (substring s run i)
                }
                depth = (depth + 1)
            }
            if ((c == 62) && (depth > 0)) {
                depth = (depth - 1)
                if (depth == 0) {
                    run = (i + 1)
                }
            }
            i = (i + 1)
        }
        if (depth == 0) {
            push out (substring s run n)
        }
        return (join out "")
    }

    ; s split at the commas outside brackets
    sfn commaParts:[string] (s:string) {
        def out:[string]
        def depth:int 0
        def run:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            if ((((c == 40) || (c == 91)) || (c == 123)) || (c == 60)) {
                depth = (depth + 1)
            }
            if ((((c == 41) || (c == 93)) || (c == 125)) || ((c == 62) && (depth > 0))) {
                if (((c == 62) && (i > 0)) && (((charAt s (i - 1)) == 45) || ((charAt s (i - 1)) == 61))) {
                    depth = (depth + 1)
                }
                depth = (depth - 1)
            }
            if ((c == 44) && (depth <= 0)) {
                push out (substring s run i)
                run = (i + 1)
            }
            i = (i + 1)
        }
        push out (substring s run n)
        return out
    }

    ; a type as a diagram writes it: no spaces, no pointer or reference
    ; marks, <> as Mermaid's ~ ~
    sfn typeText:string (t:string) {
        def out:[string]
        def i:int 0
        def n:int (strlen t)
        while (i < n) {
            def c:int (charAt t i)
            def ch:string (substring t i (i + 1))
            if ((((PresUml.isSpace(c)) || (c == 42)) || (c == 38)) || (c == 36)) {
                ch = ""
            }
            if ((c == 60) || (c == 62)) {
                ch = "~"
            }
            if (c == 44) {
                ch = ","
            }
            push out ch
            i = (i + 1)
        }
        def r:string (trim (join out ""))
        if (startsWith r "func(") {
            return "func"
        }
        ; Go's []T and map[K]V
        if ((startsWith r "[]") && ((strlen r) > 2)) {
            r = ((substring r 2 (strlen r)) + "[]")
        }
        if (startsWith r "map[") {
            def mk:int (indexOf r "]")
            if (mk > 4) {
                r = ("Map~" + (substring r 4 mk) + "," + (substring r (mk + 1) (strlen r)) + "~")
            }
        }
        ; Ranger's [T] and [K:V]
        if (((startsWith r "[") && (endsWith r "]")) && ((strlen r) > 2)) {
            def inner:string (substring r 1 ((strlen r) - 1))
            def kv:int (indexOf inner ":")
            if (kv > 0) {
                r = ("Map~" + (substring inner 0 kv) + "," + (substring inner (kv + 1) (strlen inner)) + "~")
            } {
                r = (inner + "[]")
            }
        }
        if ((r == "void") || ((r == "Unit") || (r == "()"))) {
            return ""
        }
        if ((strlen r) > 28) {
            r = ((substring r 0 27) + "…")
        }
        return r
    }

    ; the words a member starts with that say how, not what
    sfn modifier:boolean (w:string) {
        for ([] _:string ("public" "private" "protected" "internal" "fileprivate" "open" "static" "readonly" "abstract" "async" "override" "final" "virtual" "sealed" "const" "let" "var" "val" "fun" "func" "fn" "def" "mut" "pub" "unsafe" "extern" "export" "declare" "default" "synchronized" "transient" "volatile" "native" "partial" "new" "required" "lazy" "weak" "dynamic" "mutating" "inline" "suspend" "operator" "infix" "lateinit" "class" "late" "factory" "external" "covariant" "crate")) m:string i {
            if (m == w) {
                return true
            }
        }
        return false
    }

    sfn keyword:boolean (w:string) {
        for ([] _:string ("if" "for" "while" "switch" "catch" "return" "super" "this" "throw" "else" "do" "try" "import" "package" "using" "namespace" "use" "type" "typealias" "init" "constructor" "deinit" "case" "where" "match" "loop" "self" "print" "require")) m:string i {
            if (m == w) {
                return true
            }
        }
        return false
    }

    ; --- brace languages

    fn readBraces:void (file:string s:string ext:string) {
        def n:int (strlen s)
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            if (PresUml.isIdStart(c)) {
                def prev:int 32
                if (i > 0) {
                    prev = (charAt s (i - 1))
                }
                def w:string (PresUml.identAt(s i))
                def j:int (i + (strlen w))
                if (((PresUml.isIdChar(prev)) == false) && (prev != 46)) {
                    def kinds:[string] ([] _:string ("class" "interface" "struct" "enum" "record" "protocol" "object"))
                    if (ext == "rs") {
                        kinds = ([] _:string ("struct" "enum" "trait" "impl"))
                    }
                    for kinds k:string ki {
                        if (k == w) {
                            j = (this.readDecl(file s ext w i j))
                            break
                        }
                    }
                }
                i = j
                continue
            }
            i = (i + 1)
        }
    }

    ; the words on the declaration's line before `at`
    sfn lineBefore:string (s:string at:int) {
        def b:int at
        while ((b > 0) && (((charAt s (b - 1)) != 10) && (((charAt s (b - 1)) != 59) && ((charAt s (b - 1)) != 125)))) {
            b = (b - 1)
        }
        return (substring s b at)
    }

    ; one declaration whose keyword is at `at`, its name after `after`;
    ; where the scan goes on (the body is scanned too, for nested classes)
    fn readDecl:int (file:string s:string ext:string kw:string at:int after:int) {
        def n:int (strlen s)
        def i:int (PresUml.skipSpace(s after))
        if ((kw == "impl") && ((i < n) && ((charAt s i) == 60))) {
            i = (PresUml.skipSpace(s ((PresUml.closing(s i)) + 1)))
        }
        def name:string (PresUml.identAt(s i))
        ; Kotlin's enum class, PHP's/Kotlin's other prefixes
        if ((name == "class") || (name == "interface")) {
            i = (PresUml.skipSpace(s (i + (strlen name))))
            name = (PresUml.identAt(s i))
        }
        if (((strlen name) == 0) || (PresUml.keyword(name))) {
            return after
        }
        ; a TypeScript `object` or Kotlin companion is not this
        if ((kw == "object") && ((ext != "kt") && (ext != "kts") && (ext != "scala"))) {
            return after
        }
        i = (i + (strlen name))
        ; the header: up to { or ; or a line break that ends it
        def h0:int i
        def paren:int 0
        def stop:int -1
        def k:int i
        while ((k < n) && (stop < 0)) {
            def c:int (charAt s k)
            if ((c == 40) || (c == 60) || (c == 91)) {
                paren = (paren + 1)
            }
            if ((c == 41) || ((c == 62) && (paren > 0)) || (c == 93)) {
                if (((c == 62) && (k > 0)) && ((charAt s (k - 1)) == 45)) {
                    paren = (paren + 1)
                }
                paren = (paren - 1)
            }
            if ((paren <= 0) && ((c == 123) || (c == 59) || (c == 61))) {
                stop = k
            }
            if (((paren <= 0) && (c == 10)) && (stop < 0)) {
                def soFar:string (trim (substring s h0 k))
                def nx:int (PresUml.skipSpace(s k))
                def nextWord:string (PresUml.identAt(s nx))
                def goesOn:boolean (((endsWith soFar ",") || (endsWith soFar ":")) || ((nextWord == "extends") || ((nextWord == "implements") || ((nextWord == "where") || (nextWord == "with")))))
                if ((nx < n) && (((charAt s nx) == 58) || ((charAt s nx) == 123) || ((charAt s nx) == 44))) {
                    goesOn = true
                }
                if (goesOn == false) {
                    stop = k
                }
            }
            k = (k + 1)
        }
        if (stop < 0) {
            stop = n
        }
        ; `type X = …`-like and `enum X = …`: not a declaration with members
        if ((stop < n) && ((charAt s stop) == 61)) {
            return stop
        }
        def head:string (substring s h0 stop)
        def lineHead:string (PresUml.lineBefore(s at))
        if (kw == "impl") {
            this.readImpl(file s ext name head stop)
            return (stop + 1)
        }
        def kind:string "class"
        if ((kw == "interface") || ((kw == "protocol") || (kw == "trait"))) {
            kind = "interface"
            if (kw == "trait") {
                kind = "trait"
            }
        }
        if (kw == "enum") {
            kind = "enum"
        }
        if (kw == "struct") {
            kind = "struct"
        }
        if ((indexOf lineHead "abstract") >= 0) {
            kind = "abstract"
        }
        def cls:PresUmlClass (this.classOf(name file kind false))
        this.readHead(cls head ext kw)
        if ((stop < n) && ((charAt s stop) == 123)) {
            def close:int (PresUml.closing(s stop))
            def body:string (substring s (stop + 1) close)
            if (kind == "enum") {
                this.readEnum(cls body)
            } {
                this.readBody(cls body ext ((ext == "rs") && (kw == "struct")))
            }
        }
        return (stop + 1)
    }

    ; what a header after the name says: generics, a primary constructor
    ; (Kotlin, Java record, Scala), extends/implements, or : A, B
    fn readHead:void (cls:PresUmlClass head:string ext:string kw:string) {
        def h:string (trim head)
        if (startsWith h "<") {
            h = (trim (substring h ((PresUml.closing(h 0)) + 1) (strlen h)))
        }
        if (startsWith h "(") {
            def close:int (PresUml.closing(h 0))
            def params:string (substring h 1 close)
            for (PresUml.commaParts(params)) p:string pi {
                def t:string (trim p)
                def isProp:boolean ((((startsWith t "val ") || (startsWith t "var ")) || (kw == "record")) || ((ext == "scala") || (indexOf t "val ") >= 0))
                if ((isProp && ((strlen t) > 0)) && (ext != "rs")) {
                    this.member(cls t ext false)
                }
            }
            h = (trim (substring h (close + 1) (strlen h)))
        }
        h = (PresUml.noGenerics(h))
        def ex:string ""
        def im:string ""
        def ei:int (indexOf h "extends ")
        def ii:int (indexOf h "implements ")
        if (ei >= 0) {
            def end:int (strlen h)
            if (ii > ei) {
                end = ii
            }
            ex = (substring h (ei + 8) end)
        }
        if (ii >= 0) {
            def end2:int (strlen h)
            if ((ei > ii) && (ei >= 0)) {
                end2 = ei
            }
            im = (substring h (ii + 11) end2)
        }
        if ((((ei < 0) && (ii < 0)) && (startsWith h ":")) && (ext != "rs")) {
            ; Kotlin, Swift, C#, Dart-free: a base with () is a class, an
            ; interface has none; Swift/C# can't tell, so the first is the
            ; base for a class and an I-name (C#) is an interface
            def parts:[string] (PresUml.commaParts((substring h 1 (strlen h))))
            for parts p:string pi {
                def t:string (trim p)
                def wi:int (indexOf t " where ")
                if (wi >= 0) {
                    t = (trim (substring t 0 wi))
                }
                def nm:string (PresUml.identAt(t 0))
                if ((strlen nm) == 0) {
                    continue
                }
                def isBase:boolean false
                if ((ext == "kt") || (ext == "kts")) {
                    isBase = ((indexOf t "(") > 0)
                } {
                    isBase = ((pi == 0) && ((cls.kind == "class") || (cls.kind == "abstract")))
                    if (((ext == "cs") && ((strlen nm) > 1)) && (((charAt nm 0) == 73) && (PresUml.isUpper((charAt nm 1))))) {
                        isBase = false
                    }
                }
                if ((cls.kind == "interface") || (cls.kind == "trait")) {
                    isBase = true
                }
                if isBase {
                    push cls.bases nm
                } {
                    push cls.ifaces nm
                }
            }
        }
        if (ext == "rs") {
            ; trait A: B + C
            if (startsWith h ":") {
                for (strsplit (substring h 1 (strlen h)) "+") p2:string pj {
                    def nm2:string (PresUml.identAt((trim p2) 0))
                    if ((strlen nm2) > 0) {
                        push cls.bases nm2
                    }
                }
            }
        }
        for (PresUml.commaParts(ex)) e:string ek {
            def nm3:string (PresUml.lastName((trim e)))
            if ((strlen nm3) > 0) {
                if ((cls.kind == "class") || (cls.kind == "abstract") || (cls.kind == "interface")) {
