    }

    ; a type written after : or ->, up to where the member goes on
    sfn upTo:string (s:string) {
        def depth:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            if ((c == 60) || (c == 40) || (c == 91)) {
                depth = (depth + 1)
            }
            if (((c == 62) || (c == 41) || (c == 93)) && (depth > 0)) {
                depth = (depth - 1)
            }
            if ((depth == 0) && (((c == 123) || (c == 61)) || (c == 59))) {
                return (trim (substring s 0 i))
            }
            if ((depth == 0) && ((startsWith (substring s i n) " where ") || (startsWith (substring s i n) " throws"))) {
                return (trim (substring s 0 i))
            }
            i = (i + 1)
        }
        return (trim s)
    }

    ; "a: number, b = 2, String c, _ x: Int, &self" → "a, b, c, x"
    sfn paramNames:string (s:string) {
        def out:[string]
        for (PresUml.commaParts(s)) p:string i {
            def t:string (trim p)
            def eq:int (indexOf t "=")
            if (eq >= 0) {
                t = (trim (substring t 0 eq))
            }
            def nm:string ""
            def colon:int (indexOf t ":")
            if (colon >= 0) {
                nm = (PresUml.identBefore(t colon))
            } {
                nm = (PresUml.identBefore(t (strlen t)))
            }
            if ((((strlen nm) == 0) || (nm == "self")) || ((nm == "this") || (nm == "cls"))) {
                continue
            }
            push out nm
        }
        if ((array_length out) > 4) {
            def cut:[string]
            def k:int 0
            while (k < 3) {
                push cut (itemAt out k)
                k = (k + 1)
            }
            push cut "…"
            return (join cut ", ")
        }
        return (join out ", ")
    }

    ; Go's parameters: "a, b int, c *T" → "a, b, c"; types alone
    ; (an interface's "string, int") stay as they are
    sfn goParams:string (s:string) {
        def out:[string]
        for (PresUml.commaParts(s)) p:string i {
            def t:string (trim p)
            def w:string (PresUml.identAt(t 0))
            if ((strlen w) > 0) {
                push out w
            }
        }
        if ((array_length out) > 4) {
            return ((itemAt out 0) + ", " + (itemAt out 1) + ", " + (itemAt out 2) + ", …")
        }
        return (join out ", ")
    }

    ; --- Go

    fn readGo:void (file:string s:string) {
        def lines:[string] (strsplit s "\n")
        def li:int 0
        def nl:int (array_length lines)
        while (li < nl) {
            def t:string (trim (itemAt lines li))
            ; type X struct { / type X interface {
            if (startsWith t "type ") {
                def rest:string (trim (substring t 5 (strlen t)))
                def name:string (PresUml.identAt(rest 0))
                def after:string (trim (substring rest (strlen name) (strlen rest)))
                if (startsWith after "[") {
                    after = (trim (substring after ((PresUml.closing(after 0)) + 1) (strlen after)))
                }
                def isStruct:boolean (startsWith after "struct")
                def isIface:boolean (startsWith after "interface")
                if (((strlen name) > 0) && (isStruct || isIface)) {
                    def kind:string "struct"
                    if isIface {
                        kind = "interface"
                    }
                    def cls:PresUmlClass (this.classOf(name file kind false))
                    if ((indexOf after "{") >= 0) {
                        def oneLine:boolean ((indexOf after "}") >= 0)
                        if oneLine {
                            def inner:string (substring after ((indexOf after "{") + 1) (indexOf after "}"))
                            for (strsplit inner ";") part:string pi {
                                this.goMember(cls (trim part) isIface)
                            }
                        } {
                            li = (li + 1)
                            def depth:int 1
                            while ((li < nl) && (depth > 0)) {
                                def l2:string (trim (itemAt lines li))
                                if (l2 == "}") {
                                    depth = 0
                                    continue
                                }
                                if (depth == 1) {
                                    this.goMember(cls l2 isIface)
                                }
                                def o:int (PresUml.count(l2 "{"))
                                def c:int (PresUml.count(l2 "}"))
                                depth = ((depth + o) - c)
                                li = (li + 1)
                            }
                        }
                    }
                }
            }
            ; func (r *X) Name(params) ret {
            if (startsWith t "func (") {
                def close:int (PresUml.closing(t 5))
                def recv:string (trim (substring t 6 close))
                def words:[string] (strsplit recv " ")
                def rt:string (itemAt words ((array_length words) - 1))
                rt = (PresUml.noGenerics((join (strsplit rt "*") "")))
                def recvName:string (PresUml.identAt(rt 0))
                def sig:string (trim (substring t (close + 1) (strlen t)))
                if ((strlen recvName) > 0) {
                    def cls2:PresUmlClass (this.classOf(recvName file "struct" true))
                    this.goMethod(cls2 sig)
                }
            }
            li = (li + 1)
        }
    }

    sfn count:int (s:string ch:string) {
        return ((array_length (strsplit s ch)) - 1)
    }

    fn goMember:void (cls:PresUmlClass line:string iface:boolean) {
        def t:string (trim line)
        if (((strlen t) == 0) || ((t == "}") || (t == "{"))) {
            return
        }
        if iface {
            if ((indexOf t "(") > 0) {
                this.goMethod(cls t)
            } {
                def nm:string (PresUml.lastName((join (strsplit t "*") "")))
                if (((strlen nm) > 0) && ((PresUml.isIdStart((charAt t 0))))) {
                    push cls.bases nm
                }
            }
            return
        }
        ; a struct tag `json:"x"` was emptied to ""
        def words:[string] (PresUml.goWords(t))
        if ((array_length words) == 0) {
            return
        }
        if ((array_length words) == 1) {
            ; embedded: *pkg.Base or Base
            def nm2:string (PresUml.lastName((join (strsplit (itemAt words 0) "*") "")))
            if ((strlen nm2) > 0) {
                push cls.bases nm2
            }
            return
        }
        def typ:string (itemAt words ((array_length words) - 1))
        def ni:int 0
        while (ni < ((array_length words) - 1)) {
            def nm3:string (trim (join (strsplit (itemAt words ni) ",") ""))
            if ((strlen nm3) > 0) {
                def m (new PresUmlMember())
                m.name = nm3
                m.type = (PresUml.typeText(typ))
                if ((PresUml.isUpper((charAt nm3 0))) == false) {
                    m.vis = "-"
                }
                push cls.fields m
            }
            ni = (ni + 1)
        }
    }

    ; a Go struct line's words: names, then the type (which may hold
    ; spaces: map[string]int, func(a int) error, chan T); a tag dropped
    sfn goWords:[string] (t:string) {
        def out:[string]
        def s:string t
        def tag:int (indexOf s "\"\"")
        if (tag > 0) {
            s = (trim (substring s 0 tag))
        }
        ; names are a comma list at the start
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def w:string (PresUml.identAt(s i))
            if ((strlen w) == 0) {
                break
            }
            def j:int (i + (strlen w))
            def k:int j
            while ((k < n) && ((charAt s k) == 32)) {
                k = (k + 1)
            }
            if ((k < n) && ((charAt s k) == 44)) {
                push out w
                i = (PresUml.skipSpace(s (k + 1)))
                continue
            }
            if ((k >= n) || (k == j && (k < n) && ((charAt s k) == 46))) {
                ; one word (or pkg.Type): embedded
                push out (trim (substring s i n))
                return out
            }
            push out w
            push out (trim (substring s k n))
            return out
        }
        if ((strlen (trim s)) > 0) {
            push out (trim s)
        }
        return out
    }

    fn goMethod:void (cls:PresUmlClass sig:string) {
        def t:string sig
        def p:int (indexOf t "(")
        if (p <= 0) {
            return
        }
        def m (new PresUmlMember())
        m.method = true
        m.name = (trim (substring t 0 p))
        if ((indexOf m.name "[") > 0) {
            m.name = (substring m.name 0 (indexOf m.name "["))
        }
        if (((strlen m.name) == 0) || ((PresUml.isIdStart((charAt m.name 0))) == false)) {
            return
        }
        def close:int (PresUml.closing(t p))
        m.params = (PresUml.goParams((substring t (p + 1) close)))
        def ret:string ""
        if (close < (strlen t)) {
            ret = (trim (substring t (close + 1) (strlen t)))
        }
        m.type = (PresUml.typeText((PresUml.upTo(ret))))
        if ((PresUml.isUpper((charAt m.name 0))) == false) {
            m.vis = "-"
        }
        push cls.methods m
    }

    ; --- Python

    sfn indentOf:int (line:string) {
        def i:int 0
        def w:int 0
        while (i < (strlen line)) {
            def c:int (charAt line i)
            if (c == 32) {
                w = (w + 1)
            } {
                if (c == 9) {
                    w = (w + 4)
                } {
                    return w
                }
            }
            i = (i + 1)
        }
        return -1
    }

    fn readPython:void (file:string s:string) {
        def lines:[string] (strsplit s "\n")
        def nl:int (array_length lines)
        def li:int 0
        while (li < nl) {
            def line:string (itemAt lines li)
            def t:string (trim line)
            if (startsWith t "class ") {
                def ind:int (PresUml.indentOf(line))
                def rest:string (trim (substring t 6 (strlen t)))
                def name:string (PresUml.identAt(rest 0))
                if ((strlen name) == 0) {
                    li = (li + 1)
                    continue
                }
                def cls:PresUmlClass (this.classOf(name file "class" false))
                def after:string (trim (substring rest (strlen name) (strlen rest)))
                if (startsWith after "(") {
                    def bases:string (substring after 1 (PresUml.closing(after 0)))
                    for (PresUml.commaParts(bases)) b:string bi {
                        def bt:string (trim b)
                        if ((indexOf bt "=") >= 0) {
                            continue
                        }
                        def bn:string (PresUml.lastName(bt))
                        if ((((bn == "object") || (bn == "ABC")) || ((bn == "Generic") || (bn == "Protocol"))) || ((strlen bn) == 0)) {
                            if (bn == "Protocol") {
                                cls.kind = "interface"
                            }
                            if (bn == "ABC") {
                                cls.kind = "abstract"
                            }
                            continue
                        }
                        if (bn == "Enum") {
                            cls.kind = "enum"
                            continue
                        }
                        push cls.bases bn
                    }
                }
                ; the body: lines indented deeper
                li = (li + 1)
                def bodyInd:int -1
                def deco:string ""
                def inInit:boolean false
                def initInd:int -1
                while (li < nl) {
                    def l2:string (itemAt lines li)
                    def i2:int (PresUml.indentOf(l2))
                    if (i2 < 0) {
                        li = (li + 1)
                        continue
                    }
                    if (i2 <= ind) {
                        break
                    }
                    if (bodyInd < 0) {
                        bodyInd = i2
                    }
                    def t2:string (trim l2)
                    if (i2 == bodyInd) {
                        inInit = false
                        if (startsWith t2 "@") {
                            deco = t2
                        }
                        if ((startsWith t2 "def ") || (startsWith t2 "async def ")) {
                            ; a signature over several lines
                            def sig:string t2
                            while (((PresUml.count(sig "(")) > (PresUml.count(sig ")"))) && ((li + 1) < nl)) {
                                li = (li + 1)
                                sig = (sig + " " + (trim (itemAt lines li)))
                            }
                            def dp:int (indexOf sig "def ")
                            def m (new PresUmlMember())
                            m.method = true
                            def ds:string (substring sig (dp + 4) (strlen sig))
                            m.name = (PresUml.identAt(ds 0))
                            def pp:int (indexOf ds "(")
                            if (pp > 0) {
                                def pc:int (PresUml.closing(ds pp))
                                m.params = (PresUml.paramNames((substring ds (pp + 1) pc)))
                                def ra:string (trim (substring ds (pc + 1) (strlen ds)))
                                if (startsWith ra "->") {
                                    def rt:string (trim (substring ra 2 (strlen ra)))
                                    if (endsWith rt ":") {
                                        rt = (substring rt 0 ((strlen rt) - 1))
                                    }
                                    m.type = (PresUml.typeText(rt))
                                }
                            }
                            if ((startsWith deco "@staticmethod") || (startsWith deco "@classmethod")) {
                                m.isStatic = true
                            }
                            if (startsWith deco "@abstractmethod") {
                                m.isAbstract = true
                            }
                            if (startsWith deco "@property") {
                                m.method = false
                            }
                            deco = ""
                            if (m.name == "__init__") {
                                inInit = true
                                initInd = -1
                            } {
                                if (((startsWith m.name "__") && (endsWith m.name "__")) == false) {
                                    if (startsWith m.name "_") {
                                        m.vis = "-"
                                    }
                                    if m.method {
                                        push cls.methods m
                                    } {
                                        m.params = ""
                                        push cls.fields m
                                    }
                                }
                            }
                        } {
                            ; x: int = 1 / x = 1 at the class level
                            def nm:string (PresUml.identAt(t2 0))
                            def rest2:string (trim (substring t2 (strlen nm) (strlen t2)))
                            if ((strlen nm) > 0) {
                                if (((startsWith rest2 ":") || ((startsWith rest2 "=") && ((startsWith rest2 "==") == false))) && ((PresUml.keyword(nm)) == false)) {
                                    def f (new PresUmlMember())
                                    f.name = nm
                                    if (startsWith rest2 ":") {
                                        f.type = (PresUml.typeText((PresUml.upTo((substring rest2 1 (strlen rest2))))))
                                    }
                                    if (startsWith nm "_") {
                                        f.vis = "-"
                                    }
                                    if (cls.kind == "enum") {
                                        f.type = ""
                                    }
                                    this.addField(cls f)
                                }
                            }
                        }
                    } {
                        ; self.x = … in __init__
                        if (inInit && (startsWith t2 "self.")) {
                            def an:string (PresUml.identAt(t2 5))
                            def ar:string (trim (substring t2 (5 + (strlen an)) (strlen t2)))
                            if (((strlen an) > 0) && ((startsWith ar "=") || (startsWith ar ":"))) {
                                if ((startsWith ar "==") == false) {
                                    def f2 (new PresUmlMember())
                                    f2.name = an
                                    if (startsWith ar ":") {
                                        f2.type = (PresUml.typeText((PresUml.upTo((substring ar 1 (strlen ar))))))
                                    }
                                    if (startsWith an "_") {
                                        f2.vis = "-"
                                    }
                                    this.addField(cls f2)
                                }
                            }
                        }
                    }
                    li = (li + 1)
                }
                continue
            }
            li = (li + 1)
        }
    }

    fn addField:void (cls:PresUmlClass f:PresUmlMember) {
        for cls.fields g:PresUmlMember i {
            if (g.name == f.name) {
                if (((strlen g.type) == 0) && ((strlen f.type) > 0)) {
                    g.type = f.type
                }
                return
            }
        }
        push cls.fields f
    }

    ; --- Ranger

    fn readRanger:void (file:string s:string) {
        def n:int (strlen s)
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            if ((c == 99) && ((i == 0) || (PresUml.isSpace((charAt s (i - 1)))))) {
                if (startsWith (substring s i (PresUml.min((i + 6) n))) "class ") {
                    def ns:int (PresUml.skipSpace(s (i + 6)))
                    def name:string (PresUml.identAt(s ns))
                    def k:int (ns + (strlen name))
                    while ((k < n) && (((charAt s k) != 123) && ((charAt s k) != 10))) {
                        k = (k + 1)
                    }
                    if (((strlen name) > 0) && ((k < n) && ((charAt s k) == 123))) {
                        def close:int (PresUml.closing(s k))
                        def cls:PresUmlClass (this.classOf(name file "class" false))
                        this.rangerBody(cls (substring s (k + 1) close))
                        i = (close + 1)
                        continue
                    }
                }
            }
            i = (i + 1)
        }
    }

    sfn min:int (a:int b:int) {
        if (a < b) {
            return a
        }
        return b
    }

    fn rangerBody:void (cls:PresUmlClass body:string) {
        def n:int (strlen body)
        def i:int 0
        def depth:int 0
        def lineStart:int 0
        while (i <= n) {
            def c:int 10
            if (i < n) {
                c = (charAt body i)
            }
            if (c == 10) {
                if (depth == 0) {
                    this.rangerLine(cls (trim (substring body lineStart i)))
                }
                lineStart = (i + 1)
            }
            if (c == 123) {
                if (depth == 0) {
                    this.rangerLine(cls (trim (substring body lineStart i)))
                    lineStart = n
                }
                depth = (depth + 1)
            }
            if (c == 125) {
                depth = (depth - 1)
                lineStart = (i + 1)
            }
            i = (i + 1)
        }
    }

    fn rangerLine:void (cls:PresUmlClass t:string) {
        if ((strlen t) == 0) {
            return
        }
        if (startsWith t "Extends") {
            def p:int (indexOf t "(")
            if (p > 0) {
                for (strsplit (substring t (p + 1) (PresUml.closing(t p))) " ") b:string bi {
                    def bn:string (PresUml.identAt((trim b) 0))
                    if ((strlen bn) > 0) {
                        push cls.bases bn
                    }
                }
            }
            return
        }
        def isDef:boolean (startsWith t "def ")
        def isFn:boolean ((startsWith t "fn ") || (startsWith t "sfn "))
        if ((isDef == false) && (isFn == false)) {
            return
        }
        def m (new PresUmlMember())
        def rest:string ""
        if isDef {
            rest = (trim (substring t 4 (strlen t)))
        } {
            m.method = true
            m.isStatic = (startsWith t "sfn ")
            rest = (trim (substring t ((indexOf t " ") + 1) (strlen t)))
        }
        ; strip @(…) annotations
        def at:int (indexOf rest "@(")
        while (at >= 0) {
            def ac:int (PresUml.closing(rest (at + 1)))
            rest = ((substring rest 0 at) + (substring rest (ac + 1) (strlen rest)))
            at = (indexOf rest "@(")
        }
        m.name = (PresUml.identAt(rest 0))
        if ((strlen m.name) == 0) {
            return
        }
        def after:string (substring rest (strlen m.name) (strlen rest))
        if (startsWith after ":") {
            def te:int 1
            def dep:int 0
            while (te < (strlen after)) {
                def ch:int (charAt after te)
                if (ch == 91) {
                    dep = (dep + 1)
                }
                if (ch == 93) {
                    dep = (dep - 1)
                }
                if ((dep <= 0) && ((ch == 32) || (ch == 40))) {
                    if (ch != 93) {
                        break
                    }
                }
                te = (te + 1)
            }
            m.type = (PresUml.typeText((substring after 1 te)))
            after = (substring after te (strlen after))
        } {
            ; def x (new T): the type is the new
            def nw:int (indexOf after "(new ")
            if (nw >= 0) {
                m.type = (PresUml.typeText((PresUml.identAt(after (nw + 5)))))
            }
        }
        if m.method {
            def pp:int (indexOf after "(")
            if (pp >= 0) {
                def ps:[string]
                for (strsplit (substring after (pp + 1) (PresUml.closing(after pp))) " ") w:string wi {
                    def pn:string (PresUml.identAt((trim w) 0))
                    if ((strlen pn) > 0) {
                        push ps pn
                    }
                }
                m.params = (PresUml.paramNames((join ps ", ")))
            }
            push cls.methods m
        } {
            this.addField(cls m)
        }
    }

    ; --- the diagram

    ; the classes a diagram of at most max shows: the most connected (then
    ; the fullest) first, in the files' order
    fn chosen:[PresUmlClass] (max:int) {
        def out:[PresUmlClass]
        def score:[int]
        for classes c:PresUmlClass ci {
            def s:int (c.memberCount())
            if c.implied {
                s = (s - 100)
            }
            for (this.edgesOf(classes)) e:PresUmlEdge ei {
                if ((e.from == c.name) || (e.to == c.name)) {
                    s = (s + 10)
                }
            }
            push score s
        }
        def taken:[boolean]
        for classes c2:PresUmlClass k {
            push taken false
        }
        def want:int (PresUml.min(max (array_length classes)))
        def got:int 0
        while (got < want) {
            def best:int -1
            def bi:int 0
            while (bi < (array_length classes)) {
                if ((itemAt taken bi) == false) {
                    if ((best < 0) || ((itemAt score bi) > (itemAt score best))) {
                        best = bi
                    }
                }
                bi = (bi + 1)
            }
            set taken best true
            got = (got + 1)
        }
        def oi:int 0
        while (oi < (array_length classes)) {
            if (itemAt taken oi) {
                push out (itemAt classes oi)
            }
            oi = (oi + 1)
        }
        return out
    }

    sfn named:boolean (list:[PresUmlClass] name:string) {
        for list c:PresUmlClass i {
            if (c.name == name) {
                return true
            }
        }
        return false
    }

    ; the relations between the classes in list (an inheritance or
    ; realization also to a base outside it, drawn as a bare box)
    fn edgesOf:[PresUmlEdge] (list:[PresUmlClass]) {
        def out:[PresUmlEdge]
        for list c:PresUmlClass ci {
            for c.bases b:string bi {
                if (b != c.name) {
                    def e (new PresUmlEdge())
                    e.from = c.name
                    e.to = b
                    e.arrow = "<|--"
                    push out e
                }
            }
            for c.ifaces f:string fi {
                if (f != c.name) {
                    def e2 (new PresUmlEdge())
                    e2.from = c.name
                    e2.to = f
                    e2.arrow = "<|.."
                    push out e2
                }
            }
            for c.fields m:PresUmlMember mi {
                for (PresUml.typeNames(m.type)) tn:string ti {
                    if (((tn != c.name) && (PresUml.named(list tn))) && ((PresUml.edgeTo(out c.name tn)) == false)) {
                        def e3 (new PresUmlEdge())
                        e3.from = c.name
                        e3.to = tn
                        e3.arrow = "-->"
                        e3.label = m.name
                        def lt:string (to_lowercase m.type)
                        e3.many = ((((indexOf lt "[") >= 0) || ((indexOf lt "list") >= 0)) || (((indexOf lt "array") >= 0) || (((indexOf lt "vec~") >= 0) || ((indexOf lt "set~") >= 0))))
                        push out e3
                    }
                }
            }
        }
        return out
    }

    sfn edgeTo:boolean (list:[PresUmlEdge] from:string to:string) {
        for list e:PresUmlEdge i {
            if ((e.from == from) && (e.to == to)) {
                return true
            }
        }
        return false
    }

    ; the names in a type: Map~string,Node~ → Map, string, Node
    sfn typeNames:[string] (t:string) {
        def out:[string]
        def i:int 0
        def n:int (strlen t)
        while (i < n) {
            if (PresUml.isIdStart((charAt t i))) {
                def w:string (PresUml.identAt(t i))
                push out w
                i = (i + (strlen w))
                continue
            }
            i = (i + 1)
        }
        return out
    }

    ; a member as Mermaid writes it
    sfn memberLine:string (m:PresUmlMember) {
        def s:string m.vis
        if m.method {
            s = (s + m.name + "(" + m.params + ")")
            if m.isAbstract {
                s = (s + "*")
            }
            if m.isStatic {
                s = (s + "$")
            }
            if ((strlen m.type) > 0) {
                s = (s + " " + m.type)
            }
            return s
        }
        if ((strlen m.type) > 0) {
            s = (s + m.type + " ")
        }
        s = (s + m.name)
        if m.isStatic {
            s = (s + "$")
        }
        return s
    }

    ; public first, in the source's order
    sfn ordered:[PresUmlMember] (list:[PresUmlMember] max:int) {
        def out:[PresUmlMember]
        for list m:PresUmlMember i {
            if (((array_length out) < max) && (m.vis == "+")) {
                push out m
            }
        }
        for list m2:PresUmlMember j {
            if (((array_length out) < max) && (m2.vis != "+")) {
                push out m2
            }
        }
        return out
    }

    ; the Mermaid classDiagram of at most maxClasses classes, each with at
    ; most maxMembers fields and as many methods ("" when no class was read)
    fn mermaid:string (maxClasses:int maxMembers:int) {
        def list:[PresUmlClass] (this.chosen(maxClasses))
        if ((array_length list) == 0) {
            return ""
        }
        def per:int maxMembers
        if (per <= 0) {
            per = 5
            if ((array_length list) > 4) {
                per = 4
            }
            if ((array_length list) > 7) {
                per = 3
            }
        }
        def out:[string]
        push out "classDiagram"
        ; a slide is wide: a chain of classes deeper than the diagram is
        ; wide runs left to right
        def edges:[PresUmlEdge] (this.edgesOf(list))
        def deep:int (PresUml.longest(list edges))
        def across:int (idiv ((array_length list) + deep - 1) deep)
        if ((deep >= 3) && (deep >= across)) {
            push out "    direction LR"
        }
        for list c:PresUmlClass ci {
            def fs:[PresUmlMember] (PresUml.ordered(c.fields per))
            def ms:[PresUmlMember] (PresUml.ordered(c.methods per))
            def stereo:string ""
            if ((c.kind == "interface") || (c.kind == "trait")) {
                stereo = "<<interface>>"
            }
            if (c.kind == "abstract") {
                stereo = "<<abstract>>"
            }
            if (c.kind == "enum") {
                stereo = "<<enumeration>>"
            }
            if ((((array_length fs) + (array_length ms)) == 0) && ((strlen stereo) == 0)) {
                push out ("    class " + c.name)
                continue
            }
            push out ("    class " + c.name + " {")
            if ((strlen stereo) > 0) {
                push out ("        " + stereo)
            }
            for fs f:PresUmlMember fi {
                if (c.kind == "enum") {
                    push out ("        " + f.name)
                } {
                    push out ("        " + (PresUml.memberLine(f)))
                }
            }
            for ms m:PresUmlMember mi {
                push out ("        " + (PresUml.memberLine(m)))
            }
            push out "    }"
        }
        ; outside bases: a few, as bare boxes
        def outside:[string]
        for edges e:PresUmlEdge ei {
            def inside:boolean (PresUml.named(list e.to))
            if (inside == false) {
                if (e.arrow == "-->") {
                    continue
                }
                if ((PresUml.has(outside e.to)) == false) {
                    if ((array_length outside) >= 4) {
                        continue
                    }
                    push outside e.to
                }
            }
            if (e.arrow == "-->") {
                def card:string ""
                if e.many {
                    card = " \"*\""
                }
                push out ("    " + e.from + " -->" + card + " " + e.to + " : " + e.label)
            } {
                push out ("    " + e.to + " " + e.arrow + " " + e.from)
            }
        }
        return (join out "\n")
    }

    ; the most classes on one path of relations between the classes in
    ; list (1 with none)
    sfn longest:int (list:[PresUmlClass] edges:[PresUmlEdge]) {
        def n:int (array_length list)
        ; depth by relaxing n times: a cycle stops growing at n
        def depth:[int]
        for list c:PresUmlClass i {
            push depth 1
        }
        def round:int 0
        def changed:boolean true
        while (changed && (round < n)) {
            changed = false
            for edges e:PresUmlEdge ei {
                def a:int (PresUml.indexIn(list e.from))
                def b:int (PresUml.indexIn(list e.to))
                if ((a >= 0) && (b >= 0)) {
                    if ((itemAt depth b) < ((itemAt depth a) + 1)) {
                        set depth b ((itemAt depth a) + 1)
                        changed = true
                    }
                }
            }
            round = (round + 1)
        }
        def best:int 1
        for depth d:int di {
            if (d > best) {
                best = d
            }
        }
        if (best > n) {
            return n
        }
        return best
    }

    sfn indexIn:int (list:[PresUmlClass] name:string) {
        for list c:PresUmlClass i {
            if (c.name == name) {
                return i
            }
        }
        return -1
    }

    ; how many classes mermaid(max …) leaves out
    fn leftOut:int (max:int) {
        def n:int (array_length classes)
        if (n > max) {
            return (n - max)
        }
        return 0
    }
}
