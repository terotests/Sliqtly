                }
                if (((strlen m.type) == 0) && ((isFunc == false) && ((ext == "java") || ((ext == "cs") || ((ext == "dart") || (ext == "c")))))) {
                    ; Java, C#, Dart: the type is written before the name
                    def bstart:int (lastIndexOf (substring t 0 nameEnd) m.name)
                    if (bstart > 0) {
