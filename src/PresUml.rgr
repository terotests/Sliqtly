        if ((PresUml.keyword(first)) && (first != "init")) {
            return
        }
        if (((first == "interface") || (first == "enum")) || ((first == "struct") || (first == "record"))) {
            return
        }
        ; where ( and = are at the top level
        def p:int -1
        def e:int -1
        def colon:int -1
        def depth:int 0
        def i:int 0
        def n:int (strlen t)
        while (i < n) {
            def c:int (charAt t i)
            if ((c == 60) || (c == 91) || (c == 123)) {
                depth = (depth + 1)
            }
            if (((c == 62) || (c == 93) || (c == 125)) && (depth > 0)) {
                if (((c == 62) && (i > 0)) && (((charAt t (i - 1)) == 45) || ((charAt t (i - 1)) == 61))) {
                    depth = (depth + 1)
                }
                depth = (depth - 1)
            }
            if (depth == 0) {
                if ((c == 40) && (p < 0)) {
