                if ((lc == 63) || (lc == 33)) {
                    lhs2 = (trim (substring lhs2 0 ((strlen lhs2) - 1)))
                } {
                    break
                }
            }
            m.name = (PresUml.identBefore(lhs2 (strlen lhs2)))
            def ts:int ((strlen lhs2) - (strlen m.name))
            if (ts > 0) {
