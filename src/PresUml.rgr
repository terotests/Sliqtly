        if ((strlen target) == 0) {
            return
        }
        def cls:PresUmlClass (this.classOf(target file "struct" true))
        if (((strlen trait) > 0) && ((PresUml.has(cls.ifaces trait)) == false)) {
            push cls.ifaces trait
        }
        if ((stop < (strlen s)) && ((charAt s stop) == 123)) {
            def close:int (PresUml.closing(s stop))
            def body:string (substring s (stop + 1) close)
            ; a trait's methods belong to the trait's picture
            if ((strlen trait) == 0) {
                this.readBody(cls body ext false)
            }
        }
    }

    sfn has:boolean (list:[string] v:string) {
        for list x:string i {
            if (x == v) {
                return true
            }
        }
        return false
    }

    ; the members of an enum: its constants (up to the first ; in Java),
    ; then whatever follows
    fn readEnum:void (cls:PresUmlClass body:string) {
        def depth:int 0
        def semi:int -1
        def i:int 0
        while ((i < (strlen body)) && (semi < 0)) {
            def c:int (charAt body i)
            if (((c == 40) || (c == 123)) || (c == 91)) {
                depth = (depth + 1)
            }
            if (((c == 41) || (c == 125)) || (c == 93)) {
                depth = (depth - 1)
            }
            if ((c == 59) && (depth == 0)) {
                semi = i
            }
            i = (i + 1)
        }
        def consts:string body
        if (semi >= 0) {
            consts = (substring body 0 semi)
        }
        for (strsplit consts "\n") line:string li {
            def t:string (trim line)
            if (startsWith t "case ") {
                t = (substring t 5 (strlen t))
            }
            for (PresUml.commaParts(t)) p:string pi {
                def nm:string (PresUml.identAt((trim p) 0))
                if (((strlen nm) > 0) && ((PresUml.modifier(nm)) == false) && ((PresUml.keyword(nm)) == false)) {
                    def m (new PresUmlMember())
                    m.name = nm
                    push cls.fields m
                }
            }
        }
        if (semi >= 0) {
            this.readBody(cls (substring body (semi + 1) (strlen body)) "c" false)
        }
    }

    ; a class body's members, one per statement at its top level; a block
    ; ({…}: a method's body, a property's accessors) ends a statement
    fn readBody:void (cls:PresUmlClass body:string ext:string commas:boolean) {
        def parts:[string]
        def paren:int 0
        def angle:int 0
        def run:int 0
        def i:int 0
        def n:int (strlen body)
        while (i < n) {
            def c:int (charAt body i)
            if ((c == 40) || (c == 91)) {
                paren = (paren + 1)
            }
            if (((c == 41) || (c == 93)) && (paren > 0)) {
                paren = (paren - 1)
            }
            if ((c == 60) && ((i > 0) && (PresUml.isIdChar((charAt body (i - 1)))))) {
                angle = (angle + 1)
            }
            if ((c == 62) && ((angle > 0) && ((i > 0) && (((charAt body (i - 1)) != 45) && ((charAt body (i - 1)) != 61))))) {
                angle = (angle - 1)
            }
            if ((c == 123) && (paren == 0)) {
                push parts ((substring body run i) + " {")
                i = ((PresUml.closing(body i)) + 1)
                run = i
                angle = 0
                continue
            }
            if ((paren == 0) && (((c == 59) || (c == 10)) || ((commas && (c == 44)) && (angle == 0)))) {
                push parts (substring body run i)
                run = (i + 1)
            }
            i = (i + 1)
