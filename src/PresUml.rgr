        }
        if ((strlen t) == 0) {
            return
        }
        def m (new PresUmlMember())
        def isFunc:boolean false
        ; JavaScript's #private
        if ((charAt t 0) == 35) {
            m.vis = "-"
            t = (substring t 1 (strlen t))
        }
        ; the leading modifiers
        def before:[string]
        def going:boolean true
        while going {
            def w:string (PresUml.identAt(t 0))
            if ((strlen w) == 0) {
                going = false
