    }

    ; one member statement read into the class, when it is one
    fn member:void (cls:PresUmlClass text:string ext:string inBody:boolean) {
        def t:string (trim text)
        if (endsWith t " {") {
            t = (trim (substring t 0 ((strlen t) - 2)))
        }
        ; annotations and attributes: @Foo(…), [Attr]
        def guard:int 0
        while ((((strlen t) > 0) && (((charAt t 0) == 64) || ((charAt t 0) == 91) || ((charAt t 0) == 35 && (startsWith t "#[")))) && (guard < 8)) {
            guard = (guard + 1)
            if ((charAt t 0) == 64) {
                def k:int 1
                while ((k < (strlen t)) && ((PresUml.isIdChar((charAt t k))) || ((charAt t k) == 46))) {
                    k = (k + 1)
                }
                if ((k < (strlen t)) && ((charAt t k) == 40)) {
                    k = ((PresUml.closing(t k)) + 1)
                }
                t = (trim (substring t k (strlen t)))
            } {
                def at:int 0
                if ((charAt t 0) == 35) {
                    at = 1
                }
