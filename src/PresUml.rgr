                } {
                    going = false
                    continue
                }
            }
            def accessor:boolean (((w == "get") || (w == "set")) && ((strlen (PresUml.identAt(rest 0))) > 0))
            if (((PresUml.modifier(w)) || accessor) && ((strlen rest) > 0) && (((charAt rest 0) != 58) && ((charAt rest 0) != 61) && ((charAt rest 0) != 63))) {
