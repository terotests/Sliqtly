; ============================================================================
; PresGridModel.rgr — a table on a slide, as the values the table window edits
; ============================================================================
;
; A Markdown table:
;
;   | Alue | Myynti |
;   | :--- | -----: |
;   | Etelä | 120 |
;
;   the cells      the header row and the rows under it, a cell at a time
;   the columns    added and taken out, each aligned left, centre or right
;                  (the delimiter row's colons), or as the theme has it
;   the rows       added, taken out, moved up and down
;
; A table of a data file (```table / ```sheet, see PresTable):
;
;   the file       the first line (shown, not edited here)
;   the options    `rows:` per page, `columns:` to show, the `page:` an
;                  export shows, the workbook's `sheet:`; the other lines
;                  (`data:`, ones this does not know) stay as they are
;
; The table is written whole: `| a | b |`, a `|` in a cell as `\|`.
; ============================================================================

class PresGridRow {
    def cells:[string]
}

class PresGridModel {
    ; "md" a Markdown table, "file" a ```table / ```sheet fence
    def kind:string "md"
    def ok:boolean false
    def header:[string]
    ; per column: "" (the theme's), "left", "center", "right"
    def aligns:[string]
    def rows:[PresGridRow]
    def indent:string ""
    ; the fence: its opening line, its file and its option lines in order
    def fenceHead:string ""
    def file:string ""
    def optLines:[string]
    ; where the block is in the Markdown, set by the app
    def first:int -1
    def last:int -1

    Constructor () {
    }

    ; --- reading ------------------------------------------------------------------
    ; The cells of `| a | b \| c |`: trimmed, `\|` read as `|`.
    sfn cellsOf:[string] (line:string) {
        def out:[string]
        def t:string (trim line)
        if ((indexOf t "|") == 0) {
            t = (substring t 1 (strlen t))
        }
        def n:int (strlen t)
        if ((n > 0) && ((charAt t (n - 1)) == 124)) {
            if ((n < 2) || ((charAt t (n - 2)) != 92)) {
                t = (substring t 0 (n - 1))
            }
        }
        def cur:string ""
        def code:boolean false
        def i:int 0
        while (i < (strlen t)) {
            def c:int (charAt t i)
            if ((c == 92) && (((i + 1) < (strlen t)) && ((charAt t (i + 1)) == 124))) {
                cur = (cur + "|")
                i = (i + 2)
            } {
                if (c == 96) {
                    code = (code == false)
                }
                if ((c == 124) && (code == false)) {
                    push out (trim cur)
                    cur = ""
                } {
                    cur = (cur + (substring t i (i + 1)))
                }
                i = (i + 1)
            }
        }
        push out (trim cur)
        return out
    }

    ; `:---`, `:---:`, `---:`, `---`: the alignment, or "?" when the cell is
    ; not one of them.
    sfn alignOf:string (cell:string) {
        def t:string (trim cell)
        def n:int (strlen t)
        if (n == 0) {
            return "?"
        }
        def left:boolean ((charAt t 0) == 58)
        def right:boolean ((charAt t (n - 1)) == 58)
        def a:int 0
        def b:int n
        if left {
            a = 1
        }
        if (right && (b > a)) {
            b = (b - 1)
        }
        if (b <= a) {
            return "?"
        }
        def i:int a
        while (i < b) {
            if ((charAt t i) != 45) {
                return "?"
            }
            i = (i + 1)
        }
        if (left && right) {
            return "center"
        }
        if left {
            return "left"
        }
        if right {
            return "right"
        }
        return ""
    }

    sfn read:PresGridModel (block:string) {
        def m (new PresGridModel())
        def all:[string] (strsplit block "\n")
        def n:int (array_length all)
        if ((n > 0) && ((strlen (itemAt all (n - 1))) == 0)) {
            n = (n - 1)
        }
        if (n == 0) {
            return m
        }
        def t0:string (trim (itemAt all 0))
        if (((indexOf t0 "```table") == 0) || ((indexOf t0 "```sheet") == 0)) {
            return (PresGridModel.readFence(all n))
        }
        if ((n < 2) || ((indexOf t0 "|") != 0)) {
            return m
        }
        m.indent = (substring (itemAt all 0) 0 (indexOf (itemAt all 0) "|"))
        m.header = (PresGridModel.cellsOf((itemAt all 0)))
        def delim:[string] (PresGridModel.cellsOf((itemAt all 1)))
        def c:int 0
        while (c < (array_length delim)) {
            def a:string (PresGridModel.alignOf((itemAt delim c)))
            if (a == "?") {
                return m
            }
            push m.aligns a
            c = (c + 1)
        }
        def r:int 2
        while (r < n) {
            def t:string (trim (itemAt all r))
            if ((indexOf t "|") == 0) {
                def row (new PresGridRow())
                row.cells = (PresGridModel.cellsOf(t))
                push m.rows row
            }
            r = (r + 1)
        }
        m.ok = true
        m.even()
        return m
    }

    sfn readFence:PresGridModel (all:[string] n:int) {
        def m (new PresGridModel())
        m.kind = "file"
        m.fenceHead = (itemAt all 0)
        def close:int -1
        def k:int 1
        while ((k < n) && (close < 0)) {
            if ((trim (itemAt all k)) == "```") {
                close = k
            }
            k = (k + 1)
        }
        if (close < 0) {
            return m
        }
        def i:int 1
        while (i < close) {
            def t:string (trim (itemAt all i))
            if ((strlen t) > 0) {
                if (((strlen m.file) == 0) && ((strlen (PresGridModel.optionKey(t))) == 0)) {
                    m.file = t
                } {
                    push m.optLines t
                }
            }
            i = (i + 1)
        }
        m.ok = true
        return m
    }

    ; Every row as wide as the widest, header and alignments too.
    fn even:void () {
        def w:int (array_length header)
        if ((array_length aligns) > w) {
            w = (array_length aligns)
        }
        def r:int 0
        while (r < (array_length rows)) {
            def row:PresGridRow (itemAt rows r)
            if ((array_length row.cells) > w) {
                w = (array_length row.cells)
            }
            r = (r + 1)
        }
        while ((array_length header) < w) {
            push header ""
        }
        while ((array_length aligns) < w) {
            push aligns ""
        }
        def k:int 0
        while (k < (array_length rows)) {
            def row2:PresGridRow (itemAt rows k)
            while ((array_length row2.cells) < w) {
                push row2.cells ""
            }
            k = (k + 1)
        }
    }

    ; --- a Markdown table ---------------------------------------------------------
    fn cols:int () {
        return (array_length header)
    }

    fn rowCount:int () {
        return (array_length rows)
    }

    ; a cell; row -1 is the header
    fn cell:string (r:int c:int) {
        if ((c < 0) || (c >= (this.cols()))) {
            return ""
        }
        if (r < 0) {
            return (itemAt header c)
        }
        if (r >= (array_length rows)) {
            return ""
        }
        def row:PresGridRow (itemAt rows r)
        return (itemAt row.cells c)
    }

    fn setCell:void (r:int c:int v:string) {
        if ((c < 0) || (c >= (this.cols()))) {
            return
        }
        if (r < 0) {
            set header c v
            return
        }
        if (r >= (array_length rows)) {
            return
        }
        def row:PresGridRow (itemAt rows r)
        set row.cells c v
    }

    fn addRow:void () {
        def row (new PresGridRow())
        def c:int 0
        while (c < (this.cols())) {
            push row.cells ""
            c = (c + 1)
        }
        push rows row
    }

    fn removeRow:void (r:int) {
        if ((r < 0) || (r >= (array_length rows))) {
            return
        }
        remove_index rows r
    }

    ; a row moved one place up (-1) or down (1)
    fn moveRow:void (r:int by:int) {
        def to:int (r + by)
        if ((((r < 0) || (r >= (array_length rows))) || (to < 0)) || (to >= (array_length rows))) {
            return
        }
        def a:PresGridRow (itemAt rows r)
        def b:PresGridRow (itemAt rows to)
        set rows r b
        set rows to a
    }

    fn addCol:void (name:string) {
        push header name
        push aligns ""
        def r:int 0
        while (r < (array_length rows)) {
            def row:PresGridRow (itemAt rows r)
            push row.cells ""
            r = (r + 1)
        }
    }

    fn removeCol:void (c:int) {
        if (((c < 0) || (c >= (this.cols()))) || ((this.cols()) <= 1)) {
            return
        }
        remove_index header c
        remove_index aligns c
        def r:int 0
        while (r < (array_length rows)) {
            def row:PresGridRow (itemAt rows r)
            remove_index row.cells c
            r = (r + 1)
        }
    }

    ; a column moved to `to`: true when it moved
    fn moveCol:boolean (c:int to:int) {
        def n:int (this.cols())
        if ((((c < 0) || (c >= n)) || (to < 0)) || ((to >= n) || (to == c))) {
            return false
        }
        PresGridModel.swap(header c to)
        PresGridModel.swap(aligns c to)
        def r:int 0
        while (r < (array_length rows)) {
            def row:PresGridRow (itemAt rows r)
            PresGridModel.swap(row.cells c to)
            r = (r + 1)
        }
        return true
    }

    sfn swap:void (list:[string] a:int b:int) {
        def x:string (itemAt list a)
        set list a (itemAt list b)
        set list b x
    }

    fn setAlign:void (c:int a:string) {
        if ((c >= 0) && (c < (array_length aligns))) {
            set aligns c a
        }
    }

    sfn escaped:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            if (ch == "|") {
                out = (out + "\\|")
            } {
                out = (out + ch)
            }
            i = (i + 1)
        }
        return out
    }

    fn rowText:string (cells:[string]) {
        def s:string (indent + "|")
        def c:int 0
        while (c < (array_length cells)) {
            s = (s + " " + (PresGridModel.escaped((itemAt cells c))) + " |")
            c = (c + 1)
        }
        return s
    }

    sfn delimOf:string (a:string) {
        if (a == "left") {
            return ":---"
        }
        if (a == "center") {
            return ":---:"
        }
        if (a == "right") {
            return "---:"
        }
        return "---"
    }

    ; --- a data file's table ---------------------------------------------------------
    sfn optionKey:string (line:string) {
        def t:string (trim line)
        def c:int (indexOf t ":")
        if (c <= 0) {
            return ""
        }
        def k:string (trim (substring t 0 c))
        if ((indexOf k " ") >= 0) {
            return ""
        }
        if ((indexOf k "/") >= 0) {
            return ""
        }
        return k
    }

    fn option:string (key:string) {
        def i:int 0
        while (i < (array_length optLines)) {
            def t:string (itemAt optLines i)
            if ((PresGridModel.optionKey(t)) == key) {
                return (trim (substring t ((indexOf t ":") + 1) (strlen t)))
            }
            i = (i + 1)
        }
        return ""
    }

    ; `key: value` in its place (added at the end), or taken out with "".
    fn setOption:void (key:string value:string) {
        def out:[string]
        def done:boolean false
        def i:int 0
        while (i < (array_length optLines)) {
            def t:string (itemAt optLines i)
            if ((PresGridModel.optionKey(t)) == key) {
                if (((strlen value) > 0) && (done == false)) {
                    push out (key + ": " + value)
                    done = true
                }
            } {
                push out t
            }
            i = (i + 1)
        }
        if (((strlen value) > 0) && (done == false)) {
            push out (key + ": " + value)
        }
        optLines = out
    }

    fn live:boolean () {
        return ((indexOf (trim fenceHead) "```sheet") == 0)
    }

    ; --- writing ------------------------------------------------------------------
    fn markdown:string () {
        if (kind == "file") {
            def f:string (fenceHead + "\n")
            if ((strlen file) > 0) {
                f = (f + file + "\n")
            }
            def i:int 0
            while (i < (array_length optLines)) {
                f = (f + (itemAt optLines i) + "\n")
                i = (i + 1)
            }
            return (f + "```")
        }
        def out:string ((this.rowText(header)) + "\n")
        def d:[string]
        def c:int 0
        while (c < (array_length aligns)) {
            push d (PresGridModel.delimOf((itemAt aligns c)))
            c = (c + 1)
        }
        def s:string (indent + "|")
        def k:int 0
        while (k < (array_length d)) {
            s = (s + " " + (itemAt d k) + " |")
            k = (k + 1)
        }
        out = (out + s)
        def r:int 0
        while (r < (array_length rows)) {
            def row:PresGridRow (itemAt rows r)
            out = (out + "\n" + (this.rowText(row.cells)))
            r = (r + 1)
        }
        return out
    }
}
