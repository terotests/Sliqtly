; SPDX-License-Identifier: AGPL-3.0-or-later

; Which lines of the Markdown a slide is written on, from where each slide
; of the laid-out deck starts in the source (PresSlide.srcStart, -1 for a
; slide that drew nothing) and its title. A slide the overflow went on to
; (untitled, or titled as the slide before it) belongs to its heading's
; section: its lines are the whole section's.
; The editor moves, deletes and copies slides by these lines; the MCP
; server replaces a slide by them.

class PresSlideSpans {
    ; the line (0 = first) the character at offset is on
    sfn lineOf:int (text:string offset:int) {
        def n:int (strlen text)
        def stop:int offset
        if (stop > n) {
            stop = n
        }
        def line:int 0
        def i:int 0
        while (i < stop) {
            if ((charAt text i) == 10) {
                line = (line + 1)
            }
            i = (i + 1)
        }
        return line
    }

    ; the text of line `line` (0 = first), "" past the end
    sfn lineText:string (text:string line:int) {
        def n:int (strlen text)
        def at:int 0
        def l:int 0
        while ((l < line) && (at < n)) {
            if ((charAt text at) == 10) {
                l = (l + 1)
            }
            at = (at + 1)
        }
        if (l < line) {
            return ""
        }
        def end:int at
        while ((end < n) && ((charAt text end) != 10)) {
            end = (end + 1)
        }
        return (substring text at end)
    }

    sfn lineCount:int (text:string) {
        return ((PresSlideSpans.lineOf(text (strlen text))) + 1)
    }

    sfn isHeading:boolean (line:string) {
        return (((strlen line) > 0) && ((charAt line 0) == 35))
    }

    ; slide i may be one the overflow of slide i - 1 went on to: the layout
    ; leaves such a slide untitled (or gives it the same title)
    sfn goesOn:boolean (titles:[string] i:int) {
        def t:string (itemAt titles i)
        return (((strlen t) == 0) || (t == (itemAt titles (i - 1))))
    }

    ; the level of a heading line (`## Title` is 2), 0 for any other line
    sfn headingLevel:int (line:string) {
        def n:int (strlen line)
        def k:int 0
        while ((k < n) && ((charAt line k) == 35)) {
            k = (k + 1)
        }
        if ((k == 0) || (k > 6)) {
            return 0
        }
        if ((k < n) && (((charAt line k) != 32) && ((charAt line k) != 9))) {
            return 0
        }
        return k
    }

    ; a heading that starts a slide of its own (at or above the split
    ; level), and one under it that only opens a section of a slide
    sfn opensSlide:boolean (line:string splitLevel:int) {
        def lv:int (PresSlideSpans.headingLevel(line))
        return ((lv > 0) && (lv <= splitLevel))
    }

    sfn isSubHeading:boolean (line:string splitLevel:int) {
        return ((PresSlideSpans.headingLevel(line)) > splitLevel)
    }

    ; [from, to): the lines of slide i's section; from is -1 when the slide
    ; has no place in the source (or i is not a slide), to is then the
    ; line count. Every heading ends a section here: `linesIn` with the
    ; deck's split level is the one to use.
    sfn lines:[int] (text:string starts:[int] titles:[string] i:int) {
        return (PresSlideSpans.linesIn(text starts titles i 6))
    }

    ; [from, to) with the deck's split level (`deck { split-level }`): a
    ; slide the overflow went on to belongs to its heading's section. That
    ; is a slide the layout left untitled or titled as the one before it,
    ; and also one that starts at a sub-heading (`###` under `##`), where
    ; the layout prefers to break and which then names the slide: the
    ; section goes on to the next heading at the split level or above.
    sfn linesIn:[int] (text:string starts:[int] titles:[string] i:int splitLevel:int) {
        def out:[int]
        def n:int (array_length starts)
        def from:int -1
        def upto:int (PresSlideSpans.lineCount(text))
        if ((n > 0) && ((i >= 0) && (i < n))) {
            ; a slide the overflow went on to starts on its heading's slide
            def k:int i
            while (k > 0) {
                def sk:int (itemAt starts k)
                if (sk < 0) {
                    break
                }
                def lk:string (PresSlideSpans.lineText(text (PresSlideSpans.lineOf(text sk))))
                if (PresSlideSpans.opensSlide(lk splitLevel)) {
                    break
                }
                if (((PresSlideSpans.goesOn(titles k)) == false) && ((PresSlideSpans.isSubHeading(lk splitLevel)) == false)) {
                    break
                }
                k = (k - 1)
            }
            def s0:int (itemAt starts k)
            if (s0 >= 0) {
                from = (PresSlideSpans.lineOf(text s0))
                def j:int (i + 1)
                while (j < n) {
                    def sj:int (itemAt starts j)
                    if (sj >= 0) {
                        def lj:int (PresSlideSpans.lineOf(text sj))
                        if (lj > from) {
                            def tj:string (PresSlideSpans.lineText(text lj))
                            if (PresSlideSpans.opensSlide(tj splitLevel)) {
                                upto = lj
                                break
                            }
                            if (((PresSlideSpans.goesOn(titles j)) == false) && ((PresSlideSpans.isSubHeading(tj splitLevel)) == false)) {
                                upto = lj
                                break
                            }
                        }
                    }
                    j = (j + 1)
                }
            }
        }
        push out from
        push out upto
        return out
    }
}
