; ============================================================================
; PresStoryNames.rgr — a story's types and phases, and their names
; ============================================================================
; The same lists as web/stories.js (STORY_TYPES, STORY_PHASES) and
; mcp-go/store/story.go: a story menu (PresToolbar) and Document settings
; (PresChartEditor) offer them by these names, in the reader's language.
; Also who works on a presentation (mcp-go/store/agents.go).
; ============================================================================

Import "PresI18n.rgr"

class PresStoryNames {
    ; i18n: "Review" "Problem" "Task" "Pitch" "Report" "Lesson" "Demo" "Decision" "Survey" "Story"
    ; i18n: "Draft" "Active" "In review" "Done" "Archived"
    ; the story types and phases (web/stories.js STORY_TYPES, STORY_PHASES)
    ; and their names
    sfn types:[string] () {
        return (strsplit "review,problem,task,pitch,report,lesson,demo,decision,survey,story" ",")
    }

    sfn phases:[string] () {
        return (strsplit "draft,active,review,done,archived" ",")
    }

    sfn typeName:string (ty:string) {
        def names:[string] (strsplit "Review,Problem,Task,Pitch,Report,Lesson,Demo,Decision,Survey,Story" ",")
        def all:[string] (PresStoryNames.types())
        def i:int 0
        while (i < (array_length all)) {
            if ((itemAt all i) == ty) {
                return (PresI18n.t((itemAt names i)))
            }
            i = (i + 1)
        }
        return ty
    }

    sfn phaseName:string (phase:string) {
        def names:[string] (strsplit "Draft,Active,In review,Done,Archived" ",")
        def all:[string] (PresStoryNames.phases())
        def i:int 0
        while (i < (array_length all)) {
            if ((itemAt all i) == phase) {
                return (PresI18n.t((itemAt names i)))
            }
            i = (i + 1)
        }
        return phase
    }

    ; who works on a presentation (mcp-go/store/agents.go AgentModes)
    sfn agentModes:[string] () {
        return (strsplit "mixed,read,hidden,only" ",")
    }

    sfn agentName:string (access:string) {
        if (access == "read") {
            return (PresI18n.t("Humans only: assistants read"))
        }
        if (access == "hidden") {
            return (PresI18n.t("Humans only: hidden from assistants"))
        }
        if (access == "only") {
            return (PresI18n.t("Assistants only: people view"))
        }
        return (PresI18n.t("Mixed: people and assistants"))
    }

    ; what the mode means, under its menu
    sfn agentAbout:string (access:string) {
        if (access == "read") {
            return (PresI18n.t("Assistants (MCP) read it and change nothing: no edits, comments or session entries."))
        }
        if (access == "hidden") {
            return (PresI18n.t("Assistants (MCP) do not see it at all: it is in none of their lists, and to them it is not there."))
        }
        if (access == "only") {
            return (PresI18n.t("Assistants (MCP) change it; people view it and comment. Its settings stay yours to change."))
        }
        return (PresI18n.t("People and assistants (MCP) read and change it."))
    }

}
