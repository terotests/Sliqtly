; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresScript.rgr — a program that drives a slide's own display list
; ============================================================================
;
;   ## Sales grow {script=apps/fx.tsx allow="slide.nav"}
;
; The program draws nothing of its own. It is handed the entities Sliqtly
; already drew on the slide (the headings, their words and letters, a chart's
; bars, a diagram's nodes and lines, the pictures) and sets their properties
; frame by frame. The Markdown stays the content; the script is only how it
; is shown.
;
;   slide list + who drew      PresScene     the entities as a tree, with the
;   each command (PresDeck)  ─────────────►  commands each one owns
;                                              │   toJson ─► the program
;                                              ▼   (web/script-runtime.js)
;   the program's frame        PresScriptFrame  properties by entity id and
;   ({props, adds})          ─────────────►    the elements it added
;                                              │
;                              PresScriptApply  the properties laid over the
;                                               commands: moved, scaled,
;                                               turned, recoloured, clipped,
;                                               reordered, split into words
;
; PresSel is the selector language `find()` takes. The program's runtime has
; the same matcher in JavaScript (find() is synchronous inside the sandbox);
; web/test/script-runtime.test.mjs runs both on the same slides.
;
; Nothing here knows a Worker or the painter: text in, commands out, under
; the unit test (PresCheck.scripts) as in the editor.
; ============================================================================

Import "JsonValue.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGTextEngine.rgr"
Import "pkg:evg/EVGColor.rgr"

; One thing on the slide a program can find and change.
class PresEnt {
    ; unique on the slide: the block's own `{#id}` when it has one, else a
    ; path of kinds and places ("li-2", "chart-1/bar-3", "h2-1/word-2")
    def id:string ""
    ; slide, h1..h6, p, li, quote, code, table, image, chart, diagram, app,
    ; math, word, char, bar, line, label, node, edge, marker (an item's
    ; bullet or number), shape, text
    def kind:string ""
    ; the name `#x` matches: a block's `{#id}`, a diagram node's id
    def name:string ""
    def classes:[string]
    def text:string ""
    ; JSON: a bar's {label, value}, a node's {label}; "" for none
    def data:string ""
    ; where Sliqtly drew it, slide px
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    def hasBox:boolean false
    ; among its parent's children of the same kind, 0-based (`li:2` is index 1)
    def index:int 0
    def parent:int -1
    ; a painter's part (a bar, a node): the layout box it was drawn for
    def ofBox:int -1
    ; a block's first offset in the Markdown, -1 for none (a part, a word)
    def src:int -1
    def srcEnd:int -1
    ; an edge's ends, by node name
    def from:string ""
    def to:string ""
    ; a word or a letter: the text command it is part of, and its characters
    def cmd:int -1
    def at:int 0
    def len:int 0

    Constructor () {
        def c:[string]
        classes = c
    }

    sfn of:PresEnt (kind:string) {
        def e:PresEnt (new PresEnt())
        e.kind = kind
        return e
    }

    fn grow:void (bx:double by:double bw:double bh:double) {
        if (hasBox == false) {
            x = bx
            y = by
            w = bw
            h = bh
            hasBox = true
            return
        }
        def r:double (x + w)
        def b:double (y + h)
        if (bx < x) {
            x = bx
        }
        if (by < y) {
            y = by
        }
        if ((bx + bw) > r) {
            r = (bx + bw)
        }
        if ((by + bh) > b) {
            b = (by + bh)
        }
        w = (r - x)
        h = (b - y)
    }

    fn isTextual:boolean () {
        if (((strlen kind) == 2) && ((charAt kind 0) == 104)) {
            return true
        }
        return ((((kind == "p") || (kind == "li")) || ((kind == "quote") || (kind == "code"))) || ((kind == "table") || (kind == "label")))
    }
}

; The entities of one slide.
class PresScene {
    def ents:[PresEnt]
    ; for every command of the list: the deepest entity that owns it (not a
    ; word or a letter: those are cut out of their command only when a
    ; program changes one), 0 (the slide) for the ground
    def ownerOfCmd:[int]
    def pageW:double 960.0
    def pageH:double 540.0

    Constructor () {
        def e:[PresEnt]
        ents = e
        def o:[int]
        ownerOfCmd = o
    }

    fn count:int () {
        return (array_length ents)
    }

    fn at:PresEnt (i:int) {
        return (itemAt ents i)
    }

    fn add:int (e:PresEnt) {
        push ents e
        return ((array_length ents) - 1)
    }

    ; The entity with this id, -1 for none.
    fn indexOf:int (id:string) {
        def i:int 0
        while (i < (array_length ents)) {
            if ((itemAt ents i).id == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; Whether entity `i` is `anc` or inside it.
    fn within:boolean (i0:int anc:int) {
        def i:int i0
        while (i >= 0) {
            if (i == anc) {
                return true
            }
            def ie:PresEnt (itemAt ents i)
            i = ie.parent
        }
        return false
    }

    ; ------------------------------------------------------------------
    ; Building
    ; ------------------------------------------------------------------
    ;
    ; `blockOfCmd[i]` names the block (an index in `blocks`) command i was
    ; painted for, -1 for the ground; `partOfCmd[i]` a part of it (an index
    ; in `parts`, whose `parent` is its block's index in `blocks`), -1 for
    ; none. The blocks and parts come with kind, name, classes and data;
    ; their boxes, texts, words, letters and ids are made here.
    sfn build:PresScene (list:EVGDisplayList blockOfCmd:[int] blocks:[PresEnt] partOfCmd:[int] parts:[PresEnt] engine:EVGTextEngine w:double h:double) {
        def sc:PresScene (new PresScene())
        sc.pageW = w
        sc.pageH = h
        def root:PresEnt (PresEnt.of("slide"))
        root.id = "slide"
        root.x = 0.0
        root.y = 0.0
        root.w = w
        root.h = h
        root.hasBox = true
        sc.add(root)
        def blockEnt:[int]
        def bi:int 0
        while (bi < (array_length blocks)) {
            push blockEnt -1
            bi = (bi + 1)
        }
        def partEnt:[int]
        def pi:int 0
        while (pi < (array_length parts)) {
            push partEnt -1
            pi = (pi + 1)
        }
        def n:int (array_length list.cmds)
        def i:int 0
        while (i < n) {
            def owner:int 0
            def b:int -1
            if (i < (array_length blockOfCmd)) {
                b = (itemAt blockOfCmd i)
            }
            def p:int -1
            if (i < (array_length partOfCmd)) {
                p = (itemAt partOfCmd i)
            }
            if ((p >= 0) && (p < (array_length parts))) {
                def pe:PresEnt (itemAt parts p)
                if ((pe.parent >= 0) && (pe.parent < (array_length blocks))) {
                    b = pe.parent
                }
            }
            if ((b >= 0) && (b < (array_length blocks))) {
                if ((itemAt blockEnt b) < 0) {
                    def be:PresEnt (itemAt blocks b)
                    be.parent = 0
                    set_at blockEnt b (sc.add(be))
                }
                owner = (itemAt blockEnt b)
                if ((p >= 0) && (p < (array_length parts))) {
                    if ((itemAt partEnt p) < 0) {
                        def pe2:PresEnt (itemAt parts p)
                        pe2.parent = owner
                        set_at partEnt p (sc.add(pe2))
                    }
                    owner = (itemAt partEnt p)
                }
            }
            push sc.ownerOfCmd owner
            i = (i + 1)
        }
        ; boxes and texts from the commands each one owns (a text it came
        ; with, a node's label, stays)
        def said:[string]
        def si:int 0
        while (si < (array_length sc.ents)) {
            push said ""
            si = (si + 1)
        }
        def k:int 0
        while (k < n) {
            def c:EVGDrawCmd (itemAt list.cmds k)
            def o:int (itemAt sc.ownerOfCmd k)
            if ((o > 0) && ((c.kind != 4) && (c.kind != 5))) {
                def bb:[double] (PresScene.boundsOf(c))
                def up:int o
                while (up > 0) {
                    def ue:PresEnt (itemAt sc.ents up)
                    ue.grow((itemAt bb 0) (itemAt bb 1) (itemAt bb 2) (itemAt bb 3))
                    up = ue.parent
                }
                if (c.kind == 3) {
                    def was:string (itemAt said o)
                    if ((strlen was) == 0) {
                        set_at said o (trim c.text)
                    } {
                        set_at said o (was + " " + (trim c.text))
                    }
                }
            }
            k = (k + 1)
        }
        def ti:int 1
        while (ti < (array_length sc.ents)) {
            def tx:PresEnt (itemAt sc.ents ti)
            if ((strlen tx.text) == 0) {
                tx.text = (itemAt said ti)
            }
            ti = (ti + 1)
        }
        ; the words and letters of what reads as text
        def tops:int (array_length sc.ents)
        def m:int 0
        while (m < n) {
            def c2:EVGDrawCmd (itemAt list.cmds m)
            def o2:int (itemAt sc.ownerOfCmd m)
            if (((c2.kind == 3) && (o2 > 0)) && ((c2.rotate == 0.0) && ((itemAt sc.ents o2).isTextual()))) {
                sc.words(m c2 o2 engine)
            }
            m = (m + 1)
        }
        sc.number()
        return sc
    }

    ; A command's box: its own, or its points' for a path.
    sfn boundsOf:[double] (c:EVGDrawCmd) {
        if (((c.kind == 6) || (c.kind == 7)) && ((array_length c.pts) >= 2)) {
            def x0:double (itemAt c.pts 0)
            def y0:double (itemAt c.pts 1)
            def x1:double x0
            def y1:double y0
            def i:int 2
            while ((i + 1) < (array_length c.pts)) {
                def px:double (itemAt c.pts i)
                def py:double (itemAt c.pts (i + 1))
                if (px < x0) {
                    x0 = px
                }
                if (px > x1) {
                    x1 = px
                }
                if (py < y0) {
                    y0 = py
                }
                if (py > y1) {
                    y1 = py
                }
                i = (i + 2)
            }
            def half:double (c.thickness * 0.5)
            return ([] _:double ((x0 - half) (y0 - half) ((x1 - x0) + c.thickness) ((y1 - y0) + c.thickness)))
        }
        return ([] _:double (c.x c.y c.w c.h))
    }

    sfn isSpace:boolean (ch:int) {
        return ((((ch == 32) || (ch == 9)) || (ch == 10)) || (ch == 160))
    }

    ; The width of the first `upTo` characters of a text command, as the
    ; layout measured it.
    sfn widthOf:double (c:EVGDrawCmd upTo:int engine:EVGTextEngine) {
        if (upTo <= 0) {
            return 0.0
        }
        def m:EVGTextMetrics (engine.measureRunSpaced((substring c.text 0 upTo) c.fontFamily c.fontSize c.letterSpacing))
        return m.width
    }

    ; Text command `ci` of entity `owner` as words, each with its letters.
    fn words:void (ci:int c:EVGDrawCmd owner:int engine:EVGTextEngine) {
        def t:string c.text
        def n:int (strlen t)
        def i:int 0
        while (i < n) {
            while ((i < n) && (PresScene.isSpace((charAt t i)))) {
                i = (i + 1)
            }
            if (i >= n) {
                break
            }
            def start:int i
            while ((i < n) && ((PresScene.isSpace((charAt t i))) == false)) {
                i = (i + 1)
            }
            def wd:PresEnt (PresEnt.of("word"))
            wd.parent = owner
            wd.cmd = ci
            wd.at = start
            wd.len = (i - start)
            wd.text = (substring t start i)
            def x0:double (PresScene.widthOf(c start engine))
            def x1:double (PresScene.widthOf(c i engine))
            wd.grow((c.x + x0) c.y (x1 - x0) c.h)
            def we:int (this.add(wd))
            ; its letters, a surrogate pair kept whole
            def j:int start
            while (j < i) {
                def ch:int (charAt t j)
                def step:int 1
                if (((ch >= 55296) && (ch <= 56319)) && ((j + 1) < i)) {
                    step = 2
                }
                def le:PresEnt (PresEnt.of("char"))
                le.parent = we
                le.cmd = ci
                le.at = j
                le.len = step
                le.text = (substring t j (j + step))
                def cx0:double (PresScene.widthOf(c j engine))
                def cx1:double (PresScene.widthOf(c (j + step) engine))
                le.grow((c.x + cx0) c.y (cx1 - cx0) c.h)
                this.add(le)
                j = (j + step)
            }
        }
    }

    ; Each entity's place among its siblings of the same kind, and its id.
    fn number:void () {
        def taken:[string:boolean]
        def seen:[string:int]
        def i:int 1
        while (i < (array_length ents)) {
            def e:PresEnt (itemAt ents i)
            def sk:string ((to_string e.parent) + ":" + e.kind)
            def had@(optional):int (get seen sk)
            def same:int (?? had 0)
            set seen sk (same + 1)
            e.index = same
            def own:string ""
            if ((((strlen e.name) > 0) && (e.kind != "node")) && ((has taken e.name) == false)) {
                own = e.name
            }
            if ((strlen own) == 0) {
                def tail:string (e.kind + "-" + (to_string (same + 1)))
                if (e.kind == "node") {
                    tail = ("node-" + e.name)
                }
                if (e.kind == "edge") {
                    tail = ("edge-" + e.from + "-" + e.to)
                }
                own = tail
                if (e.parent > 0) {
                    def pe:PresEnt (itemAt ents e.parent)
                    own = (pe.id + "/" + tail)
                }
                ; two of the same name: the later one numbered
                if (has taken own) {
                    own = (own + "~" + (to_string i))
                }
            }
            e.id = own
            set taken own true
            i = (i + 1)
        }
    }

    ; ------------------------------------------------------------------
    ; The program's view: [{id, k, t, b:[x,y,w,h], i, p, u?, c?, d?, f?, to?}]
    ; ------------------------------------------------------------------
    sfn r1:double (v:double) {
        return ((to_double (floor ((v * 10.0) + 0.5))) / 10.0)
    }

    fn toJson:string () {
        def out:JVal (JVal.mkArr())
        def i:int 0
        while (i < (array_length ents)) {
            def e:PresEnt (itemAt ents i)
            def o:JVal (JVal.mkObj())
            o.setStr("id" e.id)
            o.setStr("k" e.kind)
            if ((strlen e.text) > 0) {
                o.setStr("t" e.text)
            }
            def b:JVal (JVal.mkArr())
            b.add((JVal.mkNum((PresScene.r1(e.x)))))
            b.add((JVal.mkNum((PresScene.r1(e.y)))))
            b.add((JVal.mkNum((PresScene.r1(e.w)))))
            b.add((JVal.mkNum((PresScene.r1(e.h)))))
            o.set("b" b)
            o.setInt("i" e.index)
            o.setInt("p" e.parent)
            if ((strlen e.name) > 0) {
                o.setStr("u" e.name)
            }
            if ((array_length e.classes) > 0) {
                o.setStr("c" (join e.classes " "))
            }
            if ((strlen e.data) > 0) {
                def d:JVal (JVal.parse(e.data))
                if ((d.isNull()) == false) {
                    o.set("d" d)
                }
            }
            if (e.kind == "edge") {
                o.setStr("f" e.from)
                o.setStr("to" e.to)
            }
            out.add(o)
            i = (i + 1)
        }
        return (out.toJson())
    }

    ; The entity under slide point (px, py): the smallest one, not a letter
    ; (a word before its line); "" for none.
    fn entityAt:string (px:double py:double) {
        def best:string ""
        def bestA:double 1000000000.0
        def k:int 1
        while (k < (array_length ents)) {
            def e:PresEnt (itemAt ents k)
            if ((e.kind != "char") && ((((px >= e.x) && (px <= (e.x + e.w))) && (py >= e.y)) && (py <= (e.y + e.h)))) {
                def a:double (e.w * e.h)
                if (a < bestA) {
                    bestA = a
                    best = e.id
                }
            }
            k = (k + 1)
        }
        return best
    }

    ; The scene whole, for a page that lays a program's frames over the list
    ; itself (the public viewer, PresScriptWeb): every field, unrounded, and
    ; the owner of each command. fromWire reads it back.
    fn wireJson:string () {
        def o:JVal (JVal.mkObj())
        o.setNum("w" pageW)
        o.setNum("h" pageH)
        def es:JVal (JVal.mkArr())
        def i:int 0
        while (i < (array_length ents)) {
            def e:PresEnt (itemAt ents i)
            def a:JVal (JVal.mkArr())
            a.add((JVal.mkStr(e.id)))
            a.add((JVal.mkStr(e.kind)))
            a.add((JVal.mkStr(e.name)))
            a.add((JVal.mkStr((join e.classes " "))))
            a.add((JVal.mkStr(e.text)))
            a.add((JVal.mkStr(e.data)))
            a.add((JVal.mkNum(e.x)))
            a.add((JVal.mkNum(e.y)))
            a.add((JVal.mkNum(e.w)))
            a.add((JVal.mkNum(e.h)))
            a.add((JVal.mkBool(e.hasBox)))
            a.add((JVal.mkInt(e.index)))
            a.add((JVal.mkInt(e.parent)))
            a.add((JVal.mkInt(e.ofBox)))
            a.add((JVal.mkInt(e.src)))
            a.add((JVal.mkInt(e.srcEnd)))
            a.add((JVal.mkStr(e.from)))
            a.add((JVal.mkStr(e.to)))
            a.add((JVal.mkInt(e.cmd)))
            a.add((JVal.mkInt(e.at)))
            a.add((JVal.mkInt(e.len)))
            es.add(a)
            i = (i + 1)
        }
        o.set("e" es)
        def ow:JVal (JVal.mkArr())
        for ownerOfCmd v:int vi {
            ow.add((JVal.mkInt(v)))
        }
        o.set("o" ow)
        return (o.toJson())
    }

    sfn fromWire:PresScene (json:string) {
        def sc:PresScene (new PresScene())
        def o:JVal (JVal.parse(json))
        if ((o.isObj()) == false) {
            return sc
        }
        sc.pageW = (o.numOr("w" 960.0))
        sc.pageH = (o.numOr("h" 540.0))
        def es:JVal (o.get("e"))
        def i:int 0
        while (i < (es.len())) {
            def a:JVal (es.at(i))
            def e:PresEnt (new PresEnt())
            e.id = ((a.at(0)).asStr(""))
            e.kind = ((a.at(1)).asStr(""))
            e.name = ((a.at(2)).asStr(""))
            def cls:string ((a.at(3)).asStr(""))
            if ((strlen cls) > 0) {
                e.classes = (strsplit cls " ")
            }
            e.text = ((a.at(4)).asStr(""))
            e.data = ((a.at(5)).asStr(""))
            e.x = ((a.at(6)).asNum(0.0))
            e.y = ((a.at(7)).asNum(0.0))
            e.w = ((a.at(8)).asNum(0.0))
            e.h = ((a.at(9)).asNum(0.0))
            e.hasBox = ((a.at(10)).asBool(false))
            e.index = (to_int ((a.at(11)).asNum(0.0)))
            e.parent = (to_int ((a.at(12)).asNum(-1.0)))
            e.ofBox = (to_int ((a.at(13)).asNum(-1.0)))
            e.src = (to_int ((a.at(14)).asNum(-1.0)))
            e.srcEnd = (to_int ((a.at(15)).asNum(-1.0)))
            e.from = ((a.at(16)).asStr(""))
            e.to = ((a.at(17)).asStr(""))
            e.cmd = (to_int ((a.at(18)).asNum(-1.0)))
            e.at = (to_int ((a.at(19)).asNum(0.0)))
            e.len = (to_int ((a.at(20)).asNum(0.0)))
            push sc.ents e
            i = (i + 1)
        }
        def ow:JVal (o.get("o"))
        def k:int 0
        while (k < (ow.len())) {
            push sc.ownerOfCmd (to_int ((ow.at(k)).asNum(0.0)))
            k = (k + 1)
        }
        return sc
    }

    ; One line per entity, indented by depth, for a person or an assistant
    ; reading the tree: `h2-1 h2 "Sales grow" @ 60,40 840x52`.
    fn outline:[string] (withLetters:boolean) {
        def out:[string]
        this.outlineUnder(0 0 withLetters out)
        return out
    }

    ; the lines of `at`'s children, in tree order, `depth` deep; words and
    ; letters only `withLetters`
    fn outlineUnder:void (at:int depth:int withLetters:boolean out:[string]) {
        def i:int 1
        while (i < (array_length ents)) {
            def e:PresEnt (itemAt ents i)
            if ((e.parent == at) && (((e.kind != "char") && (e.kind != "word")) || withLetters)) {
                def pad:string ""
                def d:int 0
                while (d < depth) {
                    pad = (pad + "  ")
                    d = (d + 1)
                }
                def what:string ""
                if ((strlen e.text) > 0) {
                    def t:string e.text
                    if ((strlen t) > 40) {
                        t = ((substring t 0 39) + "…")
                    }
                    what = (" \"" + t + "\"")
                }
                push out (pad + e.id + " " + e.kind + what + " @ " + (to_string (to_int e.x)) + "," + (to_string (to_int e.y)) + " " + (to_string (to_int e.w)) + "x" + (to_string (to_int e.h)))
                this.outlineUnder(i (depth + 1) withLetters out)
            }
            i = (i + 1)
        }
    }
}

; ============================================================================
; Selectors: `li`, `#total`, `.key`, `chart:1 bar`, `diagram node#B`,
; `edge B->D`, `h2 word:2`, `*`
; ============================================================================
class PresSelStep {
    ; "" or "*": any kind
    def kind:string ""
    def name:string ""
    def classes:[string]
    ; 1-based among its parent's children of the kind, 0: any
    def nth:int 0
    def from:string ""
    def to:string ""

    Constructor () {
        def c:[string]
        classes = c
    }

    fn matches:boolean (e:PresEnt) {
        if ((((strlen kind) > 0) && (kind != "*")) && (e.kind != kind)) {
            return false
        }
        if (((strlen name) > 0) && ((e.name != name) && (e.id != name))) {
            return false
        }
        def i:int 0
        while (i < (array_length classes)) {
            if ((indexOf e.classes (itemAt classes i)) < 0) {
                return false
            }
            i = (i + 1)
        }
        if ((nth > 0) && ((e.index + 1) != nth)) {
            return false
        }
        if (((strlen from) > 0) && ((e.from != from) || (e.to != to))) {
            return false
        }
        return true
    }
}

class PresSel {
    def steps:[PresSelStep]
    ; why the text is no selector, "" when it is one
    def error:string ""

    Constructor () {
        def s:[PresSelStep]
        steps = s
    }

    sfn nameChar:boolean (c:int) {
        return (((((c >= 97) && (c <= 122)) || ((c >= 65) && (c <= 90))) || ((c >= 48) && (c <= 57))) || ((((c == 45) || (c == 95)) || (c == 47)) || (c > 127)))
    }

    sfn parse:PresSel (text:string) {
        def out:PresSel (new PresSel())
        def toks:[string] (strsplit (trim text) " ")
        def ti:int 0
        while (ti < (array_length toks)) {
            def tok:string (trim (itemAt toks ti))
            ti = (ti + 1)
            if ((strlen tok) == 0) {
                continue
            }
            def arrow:int (indexOf tok "->")
            if (arrow >= 0) {
                def last:int ((array_length out.steps) - 1)
                if ((last < 0) || ((itemAt out.steps last).kind != "edge")) {
                    out.error = ("\"" + tok + "\" names an edge's ends: write it after edge (edge B->D)")
                    return out
                }
                def es:PresSelStep (itemAt out.steps last)
                es.from = (substring tok 0 arrow)
                es.to = (substring tok (arrow + 2) (strlen tok))
                continue
            }
            def st:PresSelStep (new PresSelStep())
            def n:int (strlen tok)
            def i:int 0
            if ((charAt tok 0) == 42) {
                st.kind = "*"
                i = 1
            }
            while ((i < n) && (PresSel.nameChar((charAt tok i)))) {
                i = (i + 1)
            }
            if ((strlen st.kind) == 0) {
                st.kind = (substring tok 0 i)
            }
            while (i < n) {
                def c:int (charAt tok i)
                def start:int (i + 1)
                def j:int start
                while ((j < n) && (PresSel.nameChar((charAt tok j)))) {
                    j = (j + 1)
                }
                def word:string (substring tok start j)
                if ((strlen word) == 0) {
                    out.error = ("\"" + tok + "\" is not a selector")
                    return out
                }
                if (c == 35) {
                    st.name = word
                } {
                    if (c == 46) {
                        push st.classes word
                    } {
                        if (c == 58) {
                            def nv@(optional):int (str2int word)
                            if (null? nv) {
                                out.error = ("\":" + word + "\" is no number: write kind:2 for the second")
                                return out
                            }
                            st.nth = (unwrap nv)
                        } {
                            out.error = ("\"" + tok + "\" is not a selector")
                            return out
                        }
                    }
                }
                i = j
            }
            push out.steps st
        }
        if (((array_length out.steps) == 0) && ((strlen out.error) == 0)) {
            out.error = "an empty selector"
        }
        return out
    }

    ; The entities it names, in slide order; within `scope` only when
    ; scope > 0 (an entity's own find()).
    fn find:[int] (sc:PresScene scope:int) {
        def out:[int]
        def n:int (array_length steps)
        if ((n == 0) || ((strlen error) > 0)) {
            return out
        }
        def last:PresSelStep (itemAt steps (n - 1))
        def i:int 1
        while (i < (sc.count())) {
            def e:PresEnt (sc.at(i))
            if (((scope <= 0) || ((i != scope) && (sc.within(i scope)))) && (last.matches(e))) {
                ; the steps before, each on an ancestor further up
                def k:int (n - 2)
                def up:int e.parent
                while ((k >= 0) && (up >= 0)) {
                    if ((scope > 0) && (up == scope)) {
                        if ((itemAt steps k).matches((sc.at(up)))) {
                            k = (k - 1)
                        }
                        break
                    }
                    if ((itemAt steps k).matches((sc.at(up)))) {
                        k = (k - 1)
                    }
                    def ua:PresEnt (sc.at(up))
                    up = ua.parent
                }
                if (k < 0) {
                    push out i
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn findIn:[int] (sc:PresScene sel:string) {
        def s:PresSel (PresSel.parse(sel))
        return (s.find(sc 0))
    }
}

; ============================================================================
; What a frame sets
; ============================================================================
class PresEntProps {
    def hasX:boolean false
    def x:double 0.0
    def hasY:boolean false
    def y:double 0.0
    def scale:double 1.0
    ; along one side only (a bar growing from its axis): times scale
    def scaleX:double 1.0
    def scaleY:double 1.0
    def rotate:double 0.0
    def skew:double 0.0
    def opacity:double 1.0
    def color:string ""
    def fill:string ""
    def stroke:string ""
    def visible:boolean true
    def hasZ:boolean false
    def z:double 0.0
    ; the turn's and the scale's point, as parts of the entity's box
    def ox:double 0.5
    def oy:double 0.5
    ; clip: a rectangle in slide px, `r` its corner radius
    def hasClip:boolean false
    def cx:double 0.0
    def cy:double 0.0
    def cw:double 0.0
    def ch:double 0.0
    def cr:double 0.0

    Constructor () {
    }

    sfn read:PresEntProps (v:JVal) {
        def p:PresEntProps (new PresEntProps())
        if (v.has("x")) {
            p.hasX = true
            p.x = (v.numOr("x" 0.0))
        }
        if (v.has("y")) {
            p.hasY = true
            p.y = (v.numOr("y" 0.0))
        }
        p.scale = (v.numOr("scale" 1.0))
        p.scaleX = (v.numOr("scaleX" 1.0))
        p.scaleY = (v.numOr("scaleY" 1.0))
        p.rotate = (v.numOr("rotate" 0.0))
        p.skew = (v.numOr("skew" 0.0))
        p.opacity = (v.numOr("opacity" 1.0))
        if (p.opacity < 0.0) {
            p.opacity = 0.0
        }
        if (p.opacity > 1.0) {
            p.opacity = 1.0
        }
        p.color = (v.strOr("color" ""))
        p.fill = (v.strOr("fill" ""))
        p.stroke = (v.strOr("stroke" ""))
        p.visible = (v.boolOr("visible" true))
        if (v.has("z")) {
            p.hasZ = true
            p.z = (v.numOr("z" 0.0))
        }
        def o:JVal (v.get("origin"))
        if (o.isArr()) {
            p.ox = ((o.at(0)).asNum(0.5))
            p.oy = ((o.at(1)).asNum(0.5))
        }
        if (o.kind == 3) {
            def words:string o.str
            if ((indexOf words "left") >= 0) {
                p.ox = 0.0
            }
            if ((indexOf words "right") >= 0) {
                p.ox = 1.0
            }
            if ((indexOf words "top") >= 0) {
                p.oy = 0.0
            }
            if ((indexOf words "bottom") >= 0) {
                p.oy = 1.0
            }
        }
        def cl:JVal (v.get("clip"))
        if (cl.isObj()) {
            p.hasClip = true
            if (cl.has("circle")) {
                def c:JVal (cl.get("circle"))
                def cxx:double ((c.at(0)).asNum(0.0))
                def cyy:double ((c.at(1)).asNum(0.0))
                def rr:double ((c.at(2)).asNum(0.0))
                p.cx = (cxx - rr)
                p.cy = (cyy - rr)
                p.cw = (rr * 2.0)
                p.ch = (rr * 2.0)
                p.cr = rr
            } {
                p.cx = (cl.numOr("x" 0.0))
                p.cy = (cl.numOr("y" 0.0))
                p.cw = (cl.numOr("w" 0.0))
                p.ch = (cl.numOr("h" 0.0))
                p.cr = (cl.numOr("r" 0.0))
            }
        }
        return p
    }

    ; Whether it moves, turns or scales what it is set on.
    fn moves:boolean (e:PresEnt) {
        return ((((((hasX && (x != e.x)) || (hasY && (y != e.y))) || (scale != 1.0)) || ((scaleX != 1.0) || (scaleY != 1.0))) || (rotate != 0.0)) || (skew != 0.0))
    }

    ; Whether it changes anything at all.
    fn changes:boolean (e:PresEnt) {
        return (((((this.moves(e)) || (opacity < 1.0)) || (((strlen color) > 0) || ((strlen fill) > 0))) || ((strlen stroke) > 0)) || (((visible == false) || hasZ) || hasClip))
    }
}

; An element the program added (`add("shape", {...})`, `e.clone()`).
class PresScriptAdd {
    def id:string ""
    ; rect, circle, text, image; clone: a copy of entity `of`
    def kind:string "rect"
    def of:string ""
    def x:double 0.0
    def y:double 0.0
    def w:double 100.0
    def h:double 100.0
    def radius:double 0.0
    def text:string ""
    def size:double 32.0
    def bold:boolean false
    def src:string ""
    def props:PresEntProps (new PresEntProps())

    Constructor () {
    }
}

; One frame of a program: the properties it set, by entity id, and what it
; added.
class PresScriptFrame {
    def ids:[string]
    def props:[PresEntProps]
    def adds:[PresScriptAdd]
    ; the frame was no frame (bad JSON), said once by the host
    def error:string ""
    ; what the program has: build(n), onClick
    def ownsBuild:boolean false
    def ownsClick:boolean false

    Constructor () {
        def i:[string]
        ids = i
        def p:[PresEntProps]
        props = p
        def a:[PresScriptAdd]
        adds = a
    }

    fn count:int () {
        return ((array_length ids) + (array_length adds))
    }

    fn propsOf@(optional):PresEntProps (id:string) {
        def i:int (indexOf ids id)
        if (i < 0) {
            def none@(optional):PresEntProps
            return none
        }
        def hit@(optional):PresEntProps (itemAt props i)
        return hit
    }

    ; {p: {id: {x, y, …}}, a: [{id, k, of?, x, y, w, h, r?, t?, size?, src?, …props}]}
    sfn read:PresScriptFrame (json:string) {
        def f:PresScriptFrame (new PresScriptFrame())
        def v:JVal (JVal.parse(json))
        if ((v.isObj()) == false) {
            f.error = "a frame of the script was not an object"
            return f
        }
        f.ownsBuild = (v.boolOr("build" false))
        f.ownsClick = (v.boolOr("click" false))
        def p:JVal (v.get("p"))
        if (p.isObj()) {
            def i:int 0
            while (i < (array_length p.keys)) {
                push f.ids (itemAt p.keys i)
                push f.props (PresEntProps.read((itemAt p.vals i)))
                i = (i + 1)
            }
        }
        def a:JVal (v.get("a"))
        if (a.isArr()) {
            def k:int 0
            while (k < (a.len())) {
                def o:JVal (a.at(k))
                def ad:PresScriptAdd (new PresScriptAdd())
                ad.id = (o.strOr("id" ""))
                ad.kind = (o.strOr("k" "rect"))
                ad.of = (o.strOr("of" ""))
                ad.x = (o.numOr("x" 0.0))
                ad.y = (o.numOr("y" 0.0))
                ad.w = (o.numOr("w" 100.0))
                ad.h = (o.numOr("h" 100.0))
                ad.radius = (o.numOr("radius" 0.0))
                ad.text = (o.strOr("text" ""))
                ad.size = (o.numOr("size" 32.0))
                ad.bold = (o.boolOr("bold" false))
                ad.src = (o.strOr("src" ""))
                ad.props = (PresEntProps.read(o))
                push f.adds ad
                k = (k + 1)
            }
        }
        return f
    }
}

; ============================================================================
; The properties laid over the commands
; ============================================================================

; A 2-D affine map: (x, y) → (a·x + c·y + e, b·x + d·y + f).
class PresAff {
    def a:double 1.0
    def b:double 0.0
    def c:double 0.0
    def d:double 1.0
    def e:double 0.0
    def f:double 0.0

    Constructor () {
    }

    fn px:double (x:double y:double) {
        return (((a * x) + (c * y)) + e)
    }

    fn py:double (x:double y:double) {
        return (((b * x) + (d * y)) + f)
    }

    ; this ∘ m: m first, then this
    fn times:PresAff (m:PresAff) {
        def r:PresAff (new PresAff())
        r.a = ((a * m.a) + (c * m.b))
        r.b = ((b * m.a) + (d * m.b))
        r.c = ((a * m.c) + (c * m.d))
        r.d = ((b * m.c) + (d * m.d))
        r.e = (((a * m.e) + (c * m.f)) + e)
        r.f = (((b * m.e) + (d * m.f)) + f)
        return r
    }

    fn identity:boolean () {
        return ((((a == 1.0) && (b == 0.0)) && ((c == 0.0) && (d == 1.0))) && ((e == 0.0) && (f == 0.0)))
    }

    ; the scale a rectangle, a text or a picture is drawn at (they stay
    ; rectangles: a skew is the paths' alone)
    fn scaleOf:double () {
        return (sqrt ((a * a) + (b * b)))
    }

    ; the scale down its side (the second column), for a scale along one
    ; side only
    fn scaleYOf:double () {
        return (sqrt ((c * c) + (d * d)))
    }

    fn degrees:double () {
        return (((atan2 b a) * 180.0) / 3.141592653589793)
    }

    ; An entity's own move: about (ox, oy), scaled (sx across, sy down),
    ; skewed, turned, then moved by (dx, dy).
    sfn local:PresAff (ox:double oy:double sx:double sy:double skewDeg:double rotDeg:double dx:double dy:double) {
        def rad:double ((rotDeg * 3.141592653589793) / 180.0)
        def co:double (cos rad)
        def si:double (sin rad)
        def k:double (PresAff.tanOf(skewDeg))
        ; R · K · S, K = [[1, k], [0, 1]], S = [[sx, 0], [0, sy]]
        def m:PresAff (new PresAff())
        m.a = (co * sx)
        m.b = (si * sx)
        m.c = (((co * k) - si) * sy)
        m.d = (((si * k) + co) * sy)
        m.e = (((ox + dx) - (m.a * ox)) - (m.c * oy))
        m.f = (((oy + dy) - (m.b * ox)) - (m.d * oy))
        return m
    }

    sfn tanOf:double (deg:double) {
        if (deg == 0.0) {
            return 0.0
        }
        def rad:double ((deg * 3.141592653589793) / 180.0)
        return ((sin rad) / (cos rad))
    }
}

; What one entity's own properties and its ancestors' come to.
class PresEntLook {
    def m:PresAff (new PresAff())
    def alpha:double 1.0
    def visible:boolean true
    def color:string ""
    def fill:string ""
    def stroke:string ""
    def z:double 0.0
    def hasZ:boolean false
    ; the entity whose clip holds it, -1 none
    def clipBy:int -1
    def changed:boolean false

    Constructor () {
    }
}

class PresScriptApply {

    ; The frame laid over slide list `list` of scene `sc`. `groupOfCmd` and
    ; `boxOfCmd` run beside the list and are kept beside it: the list only
    ; grows (a hidden command is made clear, not taken out), so the caller's
    ; arrays are rewritten in place and pushed onto. `ink` and `accent` are
    ; the theme's text and accent colours for what the program added.
    sfn apply:void (list:EVGDisplayList sc:PresScene fr:PresScriptFrame groupOfCmd:[int] boxOfCmd:[int] engine:EVGTextEngine ink:string accent:string) {
        if ((fr.count()) == 0) {
            return
        }
        def looks:[PresEntLook] (PresScriptApply.looksOf(sc fr))
        def n:int (array_length list.cmds)
        ; how far each text command is cut: 0 whole, 1 words, 2 letters, as
        ; far as the deepest part a frame changes itself
        def cut:[int]
        def ci:int 0
        while (ci < n) {
            push cut 0
            ci = (ci + 1)
        }
        def ei:int 1
        while (ei < (sc.count())) {
            def e:PresEnt (sc.at(ei))
            def own@(optional):PresEntProps (fr.propsOf(e.id))
            def mine:boolean false
            if (!null? own) {
                def op:PresEntProps (unwrap own)
                mine = (op.changes(e))
            }
            if ((e.cmd >= 0) && mine) {
                def want:int 1
                if (e.kind == "char") {
                    want = 2
                }
                if ((itemAt cut e.cmd) < want) {
                    set_at cut e.cmd want
                }
            }
            ei = (ei + 1)
        }
        ; the words and letters of each command, in their order: headOf[cmd]
        ; is the first, nextOf[entity] the one after it (-1 ends), so a cut
        ; command looks at its own parts only
        def headOf:[int]
        def hi:int 0
        while (hi < n) {
            push headOf -1
            hi = (hi + 1)
        }
        def nextOf:[int]
        def ni:int 0
        while (ni < (sc.count())) {
            push nextOf -1
            ni = (ni + 1)
        }
        def bi:int ((sc.count()) - 1)
        while (bi > 0) {
            def be:PresEnt (sc.at(bi))
            if (((be.cmd >= 0) && (be.cmd < n)) && ((be.kind == "word") || (be.kind == "char"))) {
                set_at nextOf bi (itemAt headOf be.cmd)
                set_at headOf be.cmd bi
            }
            bi = (bi - 1)
        }
        ; every piece: a command (cut or whole), its owner, what ran beside it
        def pieces:[EVGDrawCmd]
        def owners:[int]
        def groups:[int]
        def boxes:[int]
        def keys:[double]
        def firstOwned:int -1
        def lastOwned:int -1
        def fi:int 0
        while (fi < n) {
            if ((itemAt sc.ownerOfCmd fi) > 0) {
                if (firstOwned < 0) {
                    firstOwned = fi
                }
                lastOwned = fi
            }
            fi = (fi + 1)
        }
        def i:int 0
        while (i < n) {
            def c:EVGDrawCmd (itemAt list.cmds i)
            def g:int -1
            if (i < (array_length groupOfCmd)) {
                g = (itemAt groupOfCmd i)
            }
            def bx:int -1
            if (i < (array_length boxOfCmd)) {
                bx = (itemAt boxOfCmd i)
            }
            def owner:int (itemAt sc.ownerOfCmd i)
            ; the ground keeps its place under (and the overlays over) what
            ; the program reorders
            def key:double 0.0
            if (owner == 0) {
                if ((firstOwned < 0) || (i < firstOwned)) {
                    key = -1000000000.0
                }
                if ((lastOwned >= 0) && (i > lastOwned)) {
                    key = 1000000000.0
                }
            }
            def level:int (itemAt cut i)
            if (level == 0) {
                push pieces c
                push owners owner
                push groups g
                push boxes bx
                push keys key
            } {
                def kind:string "word"
                if (level == 2) {
                    kind = "char"
                }
                def k:int (itemAt headOf i)
                while (k >= 0) {
                    def e:PresEnt (sc.at(k))
                    if (e.kind == kind) {
                        def part:EVGDrawCmd (PresScriptApply.copyCmd(c))
                        part.text = e.text
                        part.x = e.x
                        part.w = e.w
                        push pieces part
                        push owners k
                        push groups g
                        push boxes bx
                        push keys key
                    }
                    k = (itemAt nextOf k)
                }
            }
            i = (i + 1)
        }
        ; dressed as their owners say
        def pi:int 0
        while (pi < (array_length pieces)) {
            def o:int (itemAt owners pi)
            def lk:PresEntLook (itemAt looks o)
            if lk.changed {
                PresScriptApply.dress((itemAt pieces pi) lk)
            }
            if lk.hasZ {
                set_at keys pi lk.z
            }
            pi = (pi + 1)
        }
        ; what the program added, over the content
        def ai:int 0
        while (ai < (array_length fr.adds)) {
            def ad:PresScriptAdd (itemAt fr.adds ai)
            def made:[EVGDrawCmd] (PresScriptApply.made(ad sc list engine ink accent))
            def mi:int 0
            while (mi < (array_length made)) {
                push pieces (itemAt made mi)
                push owners -1
                push groups -1
                push boxes -1
                def z:double 0.0
                if ad.props.hasZ {
                    z = ad.props.z
                }
                push keys z
                mi = (mi + 1)
            }
            ai = (ai + 1)
        }
        ; in their z order, the slide's own order within one z
        def order:[int] (PresScriptApply.stableOrder(keys))
        ; each run of one clip held inside it
        def outCmds:[EVGDrawCmd]
        def outGroups:[int]
        def outBoxes:[int]
        def open:int -1
        def oi:int 0
        while (oi < (array_length order)) {
            def at:int (itemAt order oi)
            def ow:int (itemAt owners at)
            def by:int -1
            if (ow >= 0) {
                def olk:PresEntLook (itemAt looks ow)
                by = olk.clipBy
            }
            if (by != open) {
                if (open >= 0) {
                    def pop:EVGDrawCmd (new EVGDrawCmd())
                    pop.kind = 5
                    push outCmds pop
                    push outGroups -1
                    push outBoxes -1
                }
                if (by >= 0) {
                    def clipEnt:PresEnt (sc.at(by))
                    def cpo@(optional):PresEntProps (fr.propsOf(clipEnt.id))
                    def cp:PresEntProps (unwrap cpo)
                    def push0:EVGDrawCmd (new EVGDrawCmd())
                    push0.kind = 4
                    push0.x = cp.cx
                    push0.y = cp.cy
                    push0.w = cp.cw
                    push0.h = cp.ch
                    push0.radius = cp.cr
                    push outCmds push0
                    push outGroups (itemAt groups at)
                    push outBoxes -1
                }
                open = by
            }
            push outCmds (itemAt pieces at)
            push outGroups (itemAt groups at)
            push outBoxes (itemAt boxes at)
            oi = (oi + 1)
        }
        if (open >= 0) {
            def pop2:EVGDrawCmd (new EVGDrawCmd())
            pop2.kind = 5
            push outCmds pop2
            push outGroups -1
            push outBoxes -1
        }
        list.cmds = outCmds
        def wi:int 0
        while (wi < (array_length outGroups)) {
            if (wi < (array_length groupOfCmd)) {
                set_at groupOfCmd wi (itemAt outGroups wi)
            } {
                push groupOfCmd (itemAt outGroups wi)
            }
            if (wi < (array_length boxOfCmd)) {
                set_at boxOfCmd wi (itemAt outBoxes wi)
            } {
                push boxOfCmd (itemAt outBoxes wi)
            }
            wi = (wi + 1)
        }
    }

    ; Each entity's look: its own properties over its ancestors'.
    sfn looksOf:[PresEntLook] (sc:PresScene fr:PresScriptFrame) {
        def out:[PresEntLook]
        def i:int 0
        while (i < (sc.count())) {
            def e:PresEnt (sc.at(i))
            def lk:PresEntLook (new PresEntLook())
            if (e.parent >= 0) {
                def up:PresEntLook (itemAt out e.parent)
                lk.m = up.m
                lk.alpha = up.alpha
                lk.visible = up.visible
                lk.color = up.color
                lk.fill = up.fill
                lk.stroke = up.stroke
                lk.z = up.z
                lk.hasZ = up.hasZ
                lk.clipBy = up.clipBy
                lk.changed = up.changed
            }
            def pr@(optional):PresEntProps (fr.propsOf(e.id))
            if (!null? pr) {
                def p:PresEntProps (unwrap pr)
                if (p.changes(e)) {
                    lk.changed = true
                }
                if (p.moves(e)) {
                    def dx:double 0.0
                    def dy:double 0.0
                    if p.hasX {
                        dx = (p.x - e.x)
                    }
                    if p.hasY {
                        dy = (p.y - e.y)
                    }
                    def ox:double (e.x + (e.w * p.ox))
                    def oy:double (e.y + (e.h * p.oy))
                    lk.m = (lk.m.times((PresAff.local(ox oy (p.scale * p.scaleX) (p.scale * p.scaleY) p.skew p.rotate dx dy))))
                }
                lk.alpha = (lk.alpha * p.opacity)
                if (p.visible == false) {
                    lk.visible = false
                }
                if ((strlen p.color) > 0) {
                    lk.color = p.color
                }
                if ((strlen p.fill) > 0) {
                    lk.fill = p.fill
                }
                if ((strlen p.stroke) > 0) {
                    lk.stroke = p.stroke
                }
                if p.hasZ {
                    lk.hasZ = true
                    lk.z = p.z
                }
                if p.hasClip {
                    lk.clipBy = i
                }
            }
            push out lk
            i = (i + 1)
        }
        return out
    }

    ; Indices 0..n-1 sorted by key, equal keys in their own order.
    sfn stableOrder:[int] (keys:[double]) {
        def order:[int]
        def n:int (array_length keys)
        def i:int 0
        while (i < n) {
            push order i
            i = (i + 1)
        }
        ; insertion sort: nearly always in order already
        def k:int 1
        while (k < n) {
            def v:int (itemAt order k)
            def kv:double (itemAt keys v)
            def j:int (k - 1)
            while ((j >= 0) && ((itemAt keys (itemAt order j)) > kv)) {
                set_at order (j + 1) (itemAt order j)
                j = (j - 1)
            }
            set_at order (j + 1) v
            k = (k + 1)
        }
        return order
    }

    sfn tint:void (c:EVGDrawCmd hex:string) {
        def col:EVGColor (EVGColor.parse(hex))
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
    }

    ; One command in its owner's look.
    sfn dress:void (c:EVGDrawCmd lk:PresEntLook) {
        if ((c.kind == 4) || (c.kind == 5)) {
            if ((lk.m.identity()) == false) {
                ; a clip moves with what it holds, as a rectangle
                def s0:double (lk.m.scaleOf())
                def s0y:double (lk.m.scaleYOf())
                def nx:double (lk.m.px(c.x c.y))
                def ny:double (lk.m.py(c.x c.y))
                c.x = nx
                c.y = ny
                c.w = (c.w * s0)
                c.h = (c.h * s0y)
                c.radius = (c.radius * (PresScriptApply.least(s0 s0y)))
            }
            return
        }
        if (lk.visible == false) {
            c.a = 0.0
            c.a2 = 0.0
            c.shadowA = 0.0
            return
        }
        if (lk.alpha < 1.0) {
            c.a = (c.a * lk.alpha)
            c.a2 = (c.a2 * lk.alpha)
            c.shadowA = (c.shadowA * lk.alpha)
        }
        if ((c.kind == 3) && ((strlen lk.color) > 0)) {
            PresScriptApply.tint(c lk.color)
        }
        if (((c.kind == 0) || (c.kind == 6)) && ((strlen lk.fill) > 0)) {
            PresScriptApply.tint(c lk.fill)
            c.hasGrad = false
        }
        if (((c.kind == 1) || (c.kind == 7)) && ((strlen lk.stroke) > 0)) {
            PresScriptApply.tint(c lk.stroke)
        }
        if (lk.m.identity()) {
            return
        }
        def m:PresAff lk.m
        def sx:double (m.scaleOf())
        def sy:double (m.scaleYOf())
        ; what is not stretched (a line's width, a corner) follows the
        ; smaller of the two
        def s:double (PresScriptApply.least(sx sy))
        if ((c.kind == 6) || (c.kind == 7)) {
            def i:int 0
            while ((i + 1) < (array_length c.pts)) {
                def px:double (itemAt c.pts i)
                def py:double (itemAt c.pts (i + 1))
                set_at c.pts i (m.px(px py))
                set_at c.pts (i + 1) (m.py(px py))
                i = (i + 2)
            }
            def bb:[double] (PresScene.boundsOf(c))
            c.thickness = (c.thickness * s)
            c.x = (itemAt bb 0)
            c.y = (itemAt bb 1)
            c.w = (itemAt bb 2)
            c.h = (itemAt bb 3)
            return
        }
        ; a rectangle, a text or a picture stays one: placed about the
        ; point it turns on, at the new scale, turned as far again
        def ox:double (c.x + (c.w * 0.5))
        def oy:double (c.y + (c.h * 0.5))
        if c.hasRotOrigin {
            ox = c.rotOriginX
            oy = c.rotOriginY
        }
        def nox:double (m.px(ox oy))
        def noy:double (m.py(ox oy))
        c.x = (nox + ((c.x - ox) * sx))
        c.y = (noy + ((c.y - oy) * sy))
        c.w = (c.w * sx)
        c.h = (c.h * sy)
        c.radius = (c.radius * s)
        c.radiusTR = (c.radiusTR * s)
        c.radiusBR = (c.radiusBR * s)
        c.radiusBL = (c.radiusBL * s)
        c.thickness = (c.thickness * s)
        ; a text is as tall as it is scaled down its side
        c.fontSize = (c.fontSize * sy)
        c.letterSpacing = (c.letterSpacing * sx)
        c.maxWidth = (c.maxWidth * sx)
        c.shadowX = (c.shadowX * sx)
        c.shadowY = (c.shadowY * sy)
        c.shadowBlur = (c.shadowBlur * s)
        def turn:double (m.degrees())
        if ((turn > 0.01) || (turn < -0.01)) {
            c.rotate = (c.rotate + turn)
            c.hasRotOrigin = true
            c.rotOriginX = nox
            c.rotOriginY = noy
        } {
            if c.hasRotOrigin {
                c.rotOriginX = nox
                c.rotOriginY = noy
            }
        }
    }

    sfn least:double (a:double b:double) {
        if (a < b) {
            return a
        }
        return b
    }

    ; The commands for one added element, in its own look.
    sfn made:[EVGDrawCmd] (ad:PresScriptAdd sc:PresScene list:EVGDisplayList engine:EVGTextEngine ink:string accent:string) {
        def out:[EVGDrawCmd]
        def ent:PresEnt (PresEnt.of(ad.kind))
        ent.x = ad.x
        ent.y = ad.y
        ent.w = ad.w
        ent.h = ad.h
        if (ad.kind == "clone") {
            def of:int (sc.indexOf(ad.of))
            if (of < 0) {
                return out
            }
            def src:PresEnt (sc.at(of))
            ent.x = src.x
            ent.y = src.y
            ent.w = src.w
            ent.h = src.h
            def i:int 0
            while (i < (array_length list.cmds)) {
                def o:int (itemAt sc.ownerOfCmd i)
                if ((o > 0) && (sc.within(o of))) {
                    push out (PresScriptApply.copyCmd((itemAt list.cmds i)))
                }
                i = (i + 1)
            }
        }
        if ((ad.kind == "rect") || ((ad.kind == "circle") || (ad.kind == "shape"))) {
            def r:EVGDrawCmd (new EVGDrawCmd())
            r.kind = 0
            r.x = ad.x
            r.y = ad.y
            r.w = ad.w
            r.h = ad.h
            r.radius = ad.radius
            if (ad.kind == "circle") {
                def least:double ad.w
                if (ad.h < least) {
                    least = ad.h
                }
                r.radius = (least * 0.5)
            }
            PresScriptApply.tint(r accent)
            r.a = 1.0
            push out r
        }
        if (ad.kind == "text") {
            def t:EVGDrawCmd (new EVGDrawCmd())
            t.kind = 3
            t.text = ad.text
            t.x = ad.x
            t.y = ad.y
            t.fontSize = ad.size
            t.h = ad.size
            t.fontFamily = "Open Sans"
            if ad.bold {
                t.fontFamily = "Open Sans Bold"
            }
            def m:EVGTextMetrics (engine.measureRun(ad.text t.fontFamily ad.size))
            t.w = m.width
            ent.w = m.width
            ent.h = ad.size
            PresScriptApply.tint(t ink)
            t.a = 1.0
            push out t
        }
        if (ad.kind == "image") {
            def p:EVGDrawCmd (new EVGDrawCmd())
            p.kind = 2
            p.x = ad.x
            p.y = ad.y
            p.w = ad.w
            p.h = ad.h
            p.src = ad.src
            p.radius = ad.radius
            p.a = 1.0
            push out p
        }
        ; its own properties, as on any entity: x and y name where it is
        ; already (it was made there), so only the rest moves it
        def lk:PresEntLook (new PresEntLook())
        def p0:PresEntProps ad.props
        lk.changed = true
        lk.alpha = p0.opacity
        lk.visible = p0.visible
        lk.color = p0.color
        lk.fill = p0.fill
        lk.stroke = p0.stroke
        if (ad.kind == "clone") {
            def dx:double 0.0
            def dy:double 0.0
            if p0.hasX {
                dx = (p0.x - ent.x)
            }
            if p0.hasY {
                dy = (p0.y - ent.y)
            }
            lk.m = (PresAff.local((ent.x + (ent.w * p0.ox)) (ent.y + (ent.h * p0.oy)) (p0.scale * p0.scaleX) (p0.scale * p0.scaleY) p0.skew p0.rotate dx dy))
        } {
            lk.m = (PresAff.local((ent.x + (ent.w * p0.ox)) (ent.y + (ent.h * p0.oy)) (p0.scale * p0.scaleX) (p0.scale * p0.scaleY) p0.skew p0.rotate 0.0 0.0))
        }
        def k:int 0
        while (k < (array_length out)) {
            PresScriptApply.dress((itemAt out k) lk)
            k = (k + 1)
        }
        return out
    }

    sfn copyCmd:EVGDrawCmd (s:EVGDrawCmd) {
        def c:EVGDrawCmd (new EVGDrawCmd())
        c.kind = s.kind
        c.x = s.x
        c.y = s.y
        c.w = s.w
        c.h = s.h
        c.radius = s.radius
        c.perCorner = s.perCorner
        c.radiusTR = s.radiusTR
        c.radiusBR = s.radiusBR
        c.radiusBL = s.radiusBL
        c.thickness = s.thickness
        c.r = s.r
        c.g = s.g
        c.b = s.b
        c.a = s.a
        c.text = s.text
        c.fontFamily = s.fontFamily
        c.fontSize = s.fontSize
        c.textAlign = s.textAlign
        c.fontWeight = s.fontWeight
        c.letterSpacing = s.letterSpacing
        c.strokeCap = s.strokeCap
        c.strokeJoin = s.strokeJoin
        c.strokeDash = s.strokeDash
        c.strokeDashOffset = s.strokeDashOffset
        c.maxWidth = s.maxWidth
        c.hasGrad = s.hasGrad
        c.gradDir = s.gradDir
        c.r2 = s.r2
        c.g2 = s.g2
        c.b2 = s.b2
        c.a2 = s.a2
        c.backdropBlur = s.backdropBlur
        c.effectId = s.effectId
        c.hasShadow = s.hasShadow
        c.shadowX = s.shadowX
        c.shadowY = s.shadowY
        c.shadowBlur = s.shadowBlur
        c.shadowR = s.shadowR
        c.shadowG = s.shadowG
        c.shadowB = s.shadowB
        c.shadowA = s.shadowA
        c.src = s.src
        c.flipH = s.flipH
        c.flipV = s.flipV
        c.hasCrop = s.hasCrop
        c.cropX = s.cropX
        c.cropY = s.cropY
        c.cropW = s.cropW
        c.cropH = s.cropH
        def pts:[double]
        def i:int 0
        while (i < (array_length s.pts)) {
            push pts (itemAt s.pts i)
            i = (i + 1)
        }
        c.pts = pts
        def ends:[int]
        def j:int 0
        while (j < (array_length s.ringEnds)) {
            push ends (itemAt s.ringEnds j)
            j = (j + 1)
        }
        c.ringEnds = ends
        c.evenOdd = s.evenOdd
        c.rotate = s.rotate
        c.node = s.node
        c.rotOriginX = s.rotOriginX
        c.rotOriginY = s.rotOriginY
        c.hasRotOrigin = s.hasRotOrigin
        c.layer = s.layer
        return c
    }
}

; ============================================================================
; What can be said of a script without running it
; ============================================================================
class PresScriptCheck {
    ; The selectors written out in its find("…") calls (a template with
    ; ${…} in it is left out: it is made while the script runs).
    sfn selectorsIn:[string] (src:string) {
        def out:[string]
        def n:int (strlen src)
        def from:int 0
        while (from < n) {
            def rest:string (substring src from n)
            def at:int (indexOf rest "find(")
            if (at < 0) {
                break
            }
            def i:int ((from + at) + 5)
            from = i
            ; find( is a word of its own: not refind( or myfind(
            def before:int ((from - 6))
            if (before >= 0) {
                def bc:int (charAt src before)
                if (PresSel.nameChar(bc)) {
                    if (bc != 46) {
                        continue
                    }
                }
            }
            while ((i < n) && (PresScene.isSpace((charAt src i)))) {
                i = (i + 1)
            }
            if (i >= n) {
                break
            }
            def q:int (charAt src i)
            if (((q != 34) && (q != 39)) && (q != 96)) {
                continue
            }
            def j:int (i + 1)
            while ((j < n) && ((charAt src j) != q)) {
                j = (j + 1)
            }
            if (j >= n) {
                break
            }
            def sel:string (substring src (i + 1) j)
            ; only a whole argument: find("li:" + n) is made as it runs
            def k:int (j + 1)
            while ((k < n) && (PresScene.isSpace((charAt src k)))) {
                k = (k + 1)
            }
            def whole:boolean ((k < n) && ((charAt src k) == 41))
            if ((whole && ((indexOf sel "${") < 0)) && ((indexOf out sel) < 0)) {
                push out sel
            }
            from = (j + 1)
        }
        return out
    }

    ; One line per selector of `src` that names nothing on the slide, or
    ; that is no selector: `find("chart:2 bar") → 0 entities`.
    sfn misses:[string] (src:string sc:PresScene) {
        def out:[string]
        def sels:[string] (PresScriptCheck.selectorsIn(src))
        def i:int 0
        while (i < (array_length sels)) {
            def s:string (itemAt sels i)
            def ps:PresSel (PresSel.parse(s))
            if ((strlen ps.error) > 0) {
                push out ("find(\"" + s + "\"): " + ps.error)
            } {
                if ((array_length (ps.find(sc 0))) == 0) {
                    push out ("find(\"" + s + "\") → 0 entities")
                }
            }
            i = (i + 1)
        }
        return out
    }
}

; ============================================================================
; One slide's script, as the deck keeps it across edits
; ============================================================================
class PresScriptRun {
    ; "script:apps/fx.tsx#1": its file and which use of the file it is
    def key:string ""
    def src:string ""
    def page:int 0
    ; the last frame while it runs on the stage
    def live:PresScriptFrame (new PresScriptFrame())
    def hasLive:boolean false
    ; where it ends (`final()`, or its ticks run to the end): thumbnails,
    ; the PDF, the stage before its first frame
    def final:PresScriptFrame (new PresScriptFrame())
    def hasFinal:boolean false
    ; …as the script gave it ({p, a, …})
    def finalJson:string ""
    ; one moment of it, run elsewhere (the server's render_slide(time)):
    ; drawn over the others while set
    def at:PresScriptFrame (new PresScriptFrame())
    def hasAt:boolean false
    ; what onLeave set as the slide was left: how it looks on the stage
    ; while the next slide arrives, until it runs again
    def leave:PresScriptFrame (new PresScriptFrame())
    def hasLeave:boolean false
    ; it has `build(n)` (the slide's steps are its own) and `onClick`
    def ownsBuild:boolean false
    def ownsClick:boolean false
    ; why the page stopped it, "" while it runs
    def stopped:string ""

    Constructor () {
    }
}
