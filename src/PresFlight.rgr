; ============================================================================
; PresFlight.rgr — the presentation as a 3-D world to fly through.
; ============================================================================
;
; Every slide is a station on a curving path through dark space; the camera
; flies from one to the next (src/PresFlightCam.rgr). A station is the
; slide drawn again as a hologram, in the flight's own look and not the
; slide's: words glow in light, plates are glass frames with corner
; brackets, a chart's bars stand up as boxes of tinted glass, a pie is a set
; of glowing pink rings, a diagram's lines are bright tubes with sparks
; running along them, pictures are see-through screens, effects are sparks
; in the air.
;
; Only the places come from the slide: each thing stands where the slide at
; rest (PresDeck.restOfSlide) draws it, as seen from the station's camera.
; Each block floats at a depth of its own in front of the slide's ground and
; is moved along the line from the camera and grown with the distance, so
; from there it covers its place on the slide; flown past, the slide comes
; apart in depth. An item names the commands of the slide's list it stands
; for (`cmds`), which is what the benchmark (src/PresFlightBench.rgr) reads.
;
; This is plain data, made from the deck and checked under Node
; (PresCheck.flight). The page hands its JSON to PresFlight3D (in
; pres_3d.js), which builds the Three scene from it, so the 3-D bundle never
; needs the deck. All positions are world units: x right, y up, z towards
; the viewer; a slide is 16 units wide on a 16:9 screen.
; ============================================================================

Import "PresDeck.rgr"
Import "JsonValue.rgr"

; A run of a line of words: its text and how it is set, `dx` from the
; line's left and `w` wide, `size` its font's size (world units).
class FlightRun {
    def text:string ""
    def cmd:int 0
    def dx:double 0.0
    def w:double 0.0
    def size:double 0.4
    def bold:boolean false
    def italic:boolean false
    def mono:boolean false
    ; set in its box: "" from its left, "center", "right"
    def align:string ""
    def r:double 1.0
    def g:double 1.0
    def b:double 1.0
    ; on the slide, px: its left, width and font size
    def sx:double 0.0
    def sw:double 0.0
    def fpx:double 0.0

    fn toJson:JVal () {
        def o:JVal (JVal.mkObj())
        o.setStr("t" text)
        o.setNum("dx" (FlightItem.round3(dx)))
        o.setNum("w" (FlightItem.round3(w)))
        o.setNum("fs" (FlightItem.round3(size)))
        if bold {
            o.setBool("b" true)
        }
        if italic {
            o.setBool("i" true)
        }
        if mono {
            o.setBool("m" true)
        }
        if ((strlen align) > 0) {
            o.setStr("al" align)
        }
        o.set("c" (FlightItem.rgbJson(r g b)))
        return o
    }
}

; One thing in the world. `kind`:
;   text     a line of words (`runs`), a picture the page draws, w x h
;   panel    a plate: a glass pane w x h with glowing edges (`fill` its
;            pane's opacity, 0 for edges only; `brackets` corner brackets)
;   picture  a picture of the slide (`src`) as a see-through screen
;   ground   the slide's own paper: the edges of the screen it stands in
;   bar      a chart's bar: a box w x h x d centred at x,y,z that grows from
;            `base` (y, or x when it lies `across`)
;   ring     a pie's slice: a ring around x,y,z from angle a0 to a1, radii
;            r0..r1 (`spin`: turns, radians a second)
;   dot      a chart's point: a ball of radius w
;   shape    a drawn outline: `pts` x,y,z triples, `ends` where each ring
;            of points ends (in points), `fill` its inside's opacity
;   line     lines: tubes along `pts` (`ends` where each ends), radius `rad`;
;            `pulse` a spark runs it
;   fx       an effect running over w x h: sparks in the air (`text` its
;            name)
class FlightItem {
    def kind:string ""
    def station:int 0
    def x:double 0.0
    def y:double 0.0
    def z:double 0.0
    def w:double 0.0
    def h:double 0.0
    def d:double 0.0
    ; colour, 0..1
    def r:double 0.36
    def g:double 0.88
    def b:double 1.0
    ; how bright it is all there, 0..1
    def op:double 1.0
    def text:string ""
    def runs:[FlightRun]
    ; turned, degrees clockwise (a text on its side)
    def rot:double 0.0
    ; its place in the station's reveal (0 first)
    def order:int 0
    def pts:[double]
    def ends:[int]
    def fill:double 0.0
    def brackets:boolean false
    def pulse:boolean false
    def src:string ""
    def a0:double 0.0
    def a1:double 0.0
    def r0:double 0.0
    def r1:double 0.0
    def spin:double 0.0
    ; a line's radius, and its look (lines of one look go together)
    def rad:double 0.0
    def key:string ""
    ; the most opaque command drawn into it so far (its box and colour win)
    def peak:double 0.0
    def base:double 0.0
    def across:boolean false
    ; the slide's block it stands for (its PresEnt id), "" for none
    def ent:string ""
    ; the commands of the slide's list at rest it stands for
    def cmds:[int]
    ; on the slide, px: the rectangle it covers (sw < 0: none yet)
    def sx:double 0.0
    def sy:double 0.0
    def sw:double -1.0
    def sh:double 0.0
    ; how far in front of the slide's ground it floats
    def dz:double 0.0

    fn toJson:JVal () {
        def o:JVal (JVal.mkObj())
        o.setStr("k" kind)
        o.setInt("s" station)
        o.setNum("x" (FlightItem.round3(x)))
        o.setNum("y" (FlightItem.round3(y)))
        o.setNum("z" (FlightItem.round3(z)))
        if ((w != 0.0) || (h != 0.0)) {
            o.setNum("w" (FlightItem.round3(w)))
            o.setNum("h" (FlightItem.round3(h)))
            o.setNum("d" (FlightItem.round3(d)))
        }
        o.set("c" (FlightItem.rgbJson(r g b)))
        if (op != 1.0) {
            o.setNum("op" (FlightItem.round3(op)))
        }
        o.setInt("o" order)
        if ((strlen text) > 0) {
            o.setStr("t" text)
        }
        if ((array_length runs) > 0) {
            def rs:JVal (JVal.mkArr())
            def k:int 0
            while (k < (array_length runs)) {
                def ru:FlightRun (itemAt runs k)
                rs.add((ru.toJson()))
                k = (k + 1)
            }
            o.set("runs" rs)
        }
        if (rot != 0.0) {
            o.setNum("rot" (FlightItem.round3(rot)))
        }
        if ((array_length pts) > 0) {
            def p:JVal (JVal.mkArr())
            def i:int 0
            while (i < (array_length pts)) {
                p.add((JVal.mkNum((FlightItem.round3((itemAt pts i))))))
                i = (i + 1)
            }
            o.set("p" p)
        }
        if ((array_length ends) > 1) {
            def e:JVal (JVal.mkArr())
            def j:int 0
            while (j < (array_length ends)) {
                e.add((JVal.mkNum((to_double (itemAt ends j)))))
                j = (j + 1)
            }
            o.set("ends" e)
        }
        if (fill > 0.0) {
            o.setNum("fill" (FlightItem.round3(fill)))
        }
        if brackets {
            o.setBool("br" true)
        }
        if pulse {
            o.setBool("pulse" true)
        }
        if (rad > 0.0) {
            o.setNum("rad" (FlightItem.round3(rad)))
        }
        if ((strlen src) > 0) {
            o.setStr("src" src)
        }
        if (kind == "ring") {
            o.setNum("a0" (FlightItem.round3(a0)))
            o.setNum("a1" (FlightItem.round3(a1)))
            o.setNum("r0" (FlightItem.round3(r0)))
            o.setNum("r1" (FlightItem.round3(r1)))
            if (spin != 0.0) {
                o.setNum("spin" (FlightItem.round3(spin)))
            }
        }
        if (kind == "bar") {
            o.setNum("base" (FlightItem.round3(base)))
            o.setBool("across" across)
        }
        return o
    }

    sfn rgbJson:JVal (r:double g:double b:double) {
        def c:JVal (JVal.mkArr())
        c.add((JVal.mkNum((FlightItem.round3(r)))))
        c.add((JVal.mkNum((FlightItem.round3(g)))))
        c.add((JVal.mkNum((FlightItem.round3(b)))))
        return c
    }

    sfn round3:double (v:double) {
        def k:double (v * 1000.0)
        if (k < 0.0) {
            return ((to_double (0 - (floor ((0.0 - k) + 0.5)))) / 1000.0)
        }
        return ((to_double (floor (k + 0.5))) / 1000.0)
    }

    ; The slide rectangle it covers grown by [x y w h].
    fn grow:void (bx:[double]) {
        def x0:double (itemAt bx 0)
        def y0:double (itemAt bx 1)
        def ww:double (itemAt bx 2)
        def hh:double (itemAt bx 3)
        if ((ww < 0.0) || (hh < 0.0)) {
            return
        }
        if (sw < 0.0) {
            sx = x0
            sy = y0
            sw = ww
            sh = hh
            return
        }
        def x1:double (sx + sw)
        def y1:double (sy + sh)
        if (x0 < sx) {
            sx = x0
        }
        if (y0 < sy) {
            sy = y0
        }
        if ((x0 + ww) > x1) {
            x1 = (x0 + ww)
        }
        if ((y0 + hh) > y1) {
            y1 = (y0 + hh)
        }
        sw = (x1 - sx)
        sh = (y1 - sy)
    }
}

; A slide's place in the world: its centre and how far back the camera
; stands to see it whole.
class FlightStation {
    def index:int 0
    def title:string ""
    ; "diagram", "chart" or "slide"
    def kind:string "slide"
    def x:double 0.0
    def y:double 0.0
    def z:double 0.0
    def dist:double 13.0
    ; where the camera looks (the middle of what the station shows) and how
    ; high above it the camera stands
    def fx:double 0.0
    def fy:double 0.0
    def lift:double 1.0

    fn toJson:JVal () {
        def o:JVal (JVal.mkObj())
        o.setInt("i" index)
        o.setStr("t" title)
        o.setStr("k" kind)
        o.setNum("x" (FlightItem.round3(x)))
        o.setNum("y" (FlightItem.round3(y)))
        o.setNum("z" (FlightItem.round3(z)))
        o.setNum("dist" (FlightItem.round3(dist)))
        o.setNum("fx" (FlightItem.round3(fx)))
        o.setNum("fy" (FlightItem.round3(fy)))
        o.setNum("lift" (FlightItem.round3(lift)))
        return o
    }
}

; A pie a chart draws: its middle and radius (slide px).
class FlightPie {
    def is:boolean false
    def cx:double 0.0
    def cy:double 0.0
    def rad:double 0.0
    ; slices made so far (each its own shade of pink)
    def slices:int 0
}

class PresFlightScene {
    def stations:[FlightStation]
    def items:[FlightItem]
    ; a slide's size in the world: as wide as a 16 x 9 screen holds it
    def frameW:double 16.0
    def frameH:double 9.0
    ; the hologram's own light: cyan, and the warm yellow of a diagram's lines
    def acR:double 0.36
    def acG:double 0.88
    def acB:double 1.0
    ; the slide being made: its size (px), the block and the place in the
    ; reveal of the command being drawn (the items made take them), and its
    ; first item
    def curPW:double 960.0
    def curPH:double 540.0
    def curEnt:string ""
    def curOrder:int 0
    def firstItem:int 0

    ; how far apart the stations are along the path
    sfn spacing:double () {
        return 36.0
    }

    ; Where station i stands: a gentle S curve that goes away from the viewer.
    sfn stationX:double (i:int) {
        return ((sin(((to_double i) * 0.55))) * 14.0)
    }
    sfn stationY:double (i:int) {
        return (((cos(((to_double i) * 0.35))) * 3.0) - 3.0)
    }
    sfn stationZ:double (i:int) {
        return (0.0 - ((to_double i) * (PresFlightScene.spacing())))
    }

    ; The deck as a world: one station per slide.
    sfn of:PresFlightScene (deck:PresDeck) {
        def sc:PresFlightScene (new PresFlightScene())
        sc.frameFor(deck.pageW deck.pageH)
        def n:int (deck.slideCount())
        def i:int 0
        while (i < n) {
            sc.addSlide(deck (deck.slideAt(i)) i)
            i = (i + 1)
        }
        return sc
    }

    ; A slide w x h px in the world: as wide as a 16 x 9 screen holds it.
    fn frameFor:void (w:double h:double) {
        if ((w <= 0.0) || (h <= 0.0)) {
            return
        }
        if ((w / h) >= (16.0 / 9.0)) {
            frameW = 16.0
            frameH = ((16.0 * h) / w)
        } {
            frameH = 9.0
            frameW = ((9.0 * w) / h)
        }
    }

    ; ---- places ----------------------------------------------------------------

    ; How far in front of the slide's ground a block floats.
    sfn depth:double (kind:string) {
        if (((indexOf kind "h") == 0) && ((strlen kind) == 2)) {
            return 1.6
        }
        if ((kind == "p") || ((kind == "li") || ((kind == "quote") || (kind == "marker")))) {
            return 1.1
        }
        if ((kind == "diagram") || ((kind == "chart") || ((kind == "figure") || (kind == "app")))) {
            return 0.9
        }
        if ((kind == "code") || ((kind == "table") || ((kind == "html") || (kind == "math")))) {
            return 0.8
        }
        if (kind == "image") {
            return 0.5
        }
        if ((kind == "header") || ((kind == "footer") || (kind == "note"))) {
            return 0.3
        }
        return 0.7
    }

    ; Where the station's camera stands (its eye).
    sfn eyeX:double (st:FlightStation) {
        return st.fx
    }
    sfn eyeY:double (st:FlightStation) {
        return (st.fy + st.lift)
    }
    sfn eyeZ:double (st:FlightStation) {
        return (st.z + st.dist)
    }

    ; How much nearer the eye a thing `dz` in front of the slide stands, as a
    ; part of its way there along the line of sight (1: on the slide).
    sfn towards:double (st:FlightStation dz:double) {
        def ez:double (PresFlightScene.eyeZ(st))
        def far:double (ez - st.z)
        if (far <= 0.001) {
            return 1.0
        }
        return ((far - dz) / far)
    }

    ; The slide's rectangle x y w h (slide px, the slide pw x ph) at `dz` in
    ; front of station st, seen from its eye where the slide has it: the
    ; centre [x, y, z] and size [w, h] in the world.
    fn placeRect:[double] (st:FlightStation x:double y:double w:double h:double pw:double ph:double dz:double) {
        def wx:double (st.x + ((((x + (w * 0.5)) / pw) - 0.5) * frameW))
        def wy:double (st.y + ((0.5 - ((y + (h * 0.5)) / ph)) * frameH))
        def t:double (PresFlightScene.towards(st dz))
        def ex:double (PresFlightScene.eyeX(st))
        def ey:double (PresFlightScene.eyeY(st))
        return ([] _:double ((ex + ((wx - ex) * t)) (ey + ((wy - ey) * t)) (st.z + dz) (((w / pw) * frameW) * t) (((h / ph) * frameH) * t)))
    }

    ; World units a slide px is at `dz` in front of station st.
    fn unitAt:double (st:FlightStation pw:double dz:double) {
        return ((frameW / pw) * (PresFlightScene.towards(st dz)))
    }

    ; The station's camera framed on the whole slide: looking at its middle,
    ; back as far as its width or height needs (60 degrees up and down, a
    ; screen 1.6 times as wide), `rise` of that distance above it.
    fn frameSlide:void (st:FlightStation rise:double) {
        st.fx = st.x
        st.fy = st.y
        ; tan(30 degrees)
        def tn:double 0.57735
        def d:double ((frameH * 0.5) / tn)
        if (((frameW * 0.5) / (tn * 1.6)) > d) {
            d = ((frameW * 0.5) / (tn * 1.6))
        }
        st.dist = ((d * 1.08) + 0.6)
        st.lift = (st.dist * rise)
    }

    ; ---- the hologram's colours ----------------------------------------------

    sfn saturation:double (r:double g:double b:double) {
        def mx:double (PresFlightScene.max3(r g b))
        def mn:double r
        if (g < mn) {
            mn = g
        }
        if (b < mn) {
            mn = b
        }
        if (mx <= 0.0) {
            return 0.0
        }
        return ((mx - mn) / mx)
    }

    sfn max3:double (r:double g:double b:double) {
        def mx:double r
        if (g > mx) {
            mx = g
        }
        if (b > mx) {
            mx = b
        }
        return mx
    }

    ; Whether a colour (0..255) has a hue of its own.
    sfn hued:boolean (c:EVGDrawCmd) {
        def r:double ((to_double c.r) / 255.0)
        def g:double ((to_double c.g) / 255.0)
        def b:double ((to_double c.b) / 255.0)
        return (((PresFlightScene.saturation(r g b)) > 0.3) && ((PresFlightScene.max3(r g b)) > 0.15))
    }

    ; A colour as light in the dark: its hue kept, lifted towards full
    ; brightness and a little towards white (colours that differ stay apart).
    sfn neon:[double] (c:EVGDrawCmd) {
        def r:double ((to_double c.r) / 255.0)
        def g:double ((to_double c.g) / 255.0)
        def b:double ((to_double c.b) / 255.0)
        def mx:double (PresFlightScene.max3(r g b))
        if (mx <= 0.001) {
            return ([] _:double (0.36 0.88 1.0))
        }
        def nr:double ((r * 0.4) + ((r / mx) * 0.6))
        def ng:double ((g * 0.4) + ((g / mx) * 0.6))
        def nb:double ((b * 0.4) + ((b / mx) * 0.6))
        return ([] _:double ((0.12 + (nr * 0.88)) (0.12 + (ng * 0.88)) (0.12 + (nb * 0.88))))
    }

    ; The colour a thing of the slide glows in: its own hue, else the
    ; hologram's (`deflt`).
    sfn glow:[double] (c:EVGDrawCmd deflt:[double]) {
        if (PresFlightScene.hued(c)) {
            return (PresFlightScene.neon(c))
        }
        return deflt
    }

    ; A pie's slice n in a shade of pink of its own.
    sfn pink:[double] (n:int) {
        def pal:[double] ([] _:double (1.0 0.36 0.66 1.0 0.62 0.82 0.92 0.3 0.9 1.0 0.48 0.55 0.8 0.5 1.0 1.0 0.78 0.9 0.98 0.22 0.5 0.86 0.66 1.0))
        def m:int (idiv (array_length pal) 3)
        def k:int (n - ((idiv n m) * m))
        def round:int (idiv n m)
        def lift:double ((to_double round) * 0.07)
        if (lift > 0.3) {
            lift = 0.3
        }
        def r:double (itemAt pal (k * 3))
        def g:double ((itemAt pal ((k * 3) + 1)) + lift)
        def b:double (itemAt pal ((k * 3) + 2))
        if (g > 1.0) {
            g = 1.0
        }
        return ([] _:double (r g b))
    }

    sfn white:[double] () {
        return ([] _:double (0.86 0.97 1.0))
    }
    sfn cyan:[double] () {
        return ([] _:double (0.36 0.88 1.0))
    }
    sfn words:[double] () {
        return ([] _:double (0.62 0.93 1.0))
    }
    sfn yellow:[double] () {
        return ([] _:double (1.0 0.8 0.26))
    }

    ; ---- a station -------------------------------------------------------------

    fn station:FlightStation (i:int title:string) {
        def st:FlightStation (new FlightStation())
        st.index = i
        st.title = title
        st.x = (PresFlightScene.stationX(i))
        st.y = (PresFlightScene.stationY(i))
        st.z = (PresFlightScene.stationZ(i))
        st.fx = st.x
        st.fy = st.y
        push stations st
        return st
    }

    fn item:FlightItem (kind:string station:int) {
        def it:FlightItem (new FlightItem())
        it.kind = kind
        it.station = station
        it.r = acR
        it.g = acG
        it.b = acB
        it.ent = curEnt
        it.order = curOrder
        push items it
        return it
    }

    ; The item of this slide's block and step already drawn that a command
    ; of kind `kind` and slide box bx belongs to (-1: none): a fill, edge
    ; or glow round the same box; what a chart draws on its bar (a cap,
    ; stripes); a corner's bracket of a plate; one more pass of the same
    ; line.
    fn hostOf:int (kind:int bx:[double]) {
        def x0:double (itemAt bx 0)
        def y0:double (itemAt bx 1)
        def x1:double (x0 + (itemAt bx 2))
        def y1:double (y0 + (itemAt bx 3))
        def small:boolean (((itemAt bx 2) <= 32.0) && ((itemAt bx 3) <= 32.0))
        def i:int ((array_length items) - 1)
        while (i >= firstItem) {
            def it:FlightItem (itemAt items i)
            if (((it.ent == curEnt) && (it.order == curOrder)) && (it.sw >= 0.0)) {
                def hx0:double it.sx
                def hy0:double it.sy
                def hx1:double (it.sx + it.sw)
                def hy1:double (it.sy + it.sh)
                ; a glow round a box reaches out a little way past it
                def tol:double (0.15 * (? (it.sw < it.sh) it.sw it.sh))
                if (tol < 12.0) {
                    tol = 12.0
                }
                def same:boolean (((fabs (x0 - hx0)) <= tol) && (((fabs (y0 - hy0)) <= tol) && (((fabs (x1 - hx1)) <= tol) && ((fabs (y1 - hy1)) <= tol))))
                def inside:boolean ((x0 >= (hx0 - 4.0)) && ((y0 >= (hy0 - 4.0)) && ((x1 <= (hx1 + 4.0)) && (y1 <= (hy1 + 4.0)))))
                if (((kind == 0) || (kind == 1)) && ((it.kind == "panel") || (it.kind == "bar"))) {
                    if (same || ((it.kind == "bar") && inside)) {
                        return i
                    }
                }
                if ((kind == 7) && (it.kind == "panel")) {
                    ; near one of its corners
                    def cx:double ((x0 + x1) * 0.5)
                    def cy:double ((y0 + y1) * 0.5)
                    def nearX:boolean (((fabs (cx - hx0)) <= 18.0) || ((fabs (cx - hx1)) <= 18.0))
                    def nearY:boolean (((fabs (cy - hy0)) <= 18.0) || ((fabs (cy - hy1)) <= 18.0))
                    if (small && (nearX && nearY)) {
                        return i
                    }
                }
                if (((kind == 7) || (kind == 6)) && ((it.kind == "line") || (it.kind == "shape"))) {
                    if (((fabs (x0 - hx0)) <= 2.0) && (((fabs (y0 - hy0)) <= 2.0) && (((fabs (x1 - hx1)) <= 2.0) && ((fabs (y1 - hy1)) <= 2.0)))) {
                        return i
                    }
                }
            }
            i = (i - 1)
        }
        return -1
    }

    ; Command k drawn as part of item i (see hostOf).
    fn attach:FlightItem (i:int k:int c:EVGDrawCmd) {
        def it:FlightItem (itemAt items i)
        push it.cmds k
        if ((it.kind == "panel") && (((c.kind == 0) || (c.kind == 1)) && (c.a > (it.peak + 0.2)))) {
            ; the plate itself, not its glow: its box and its light
            def bx:[double] (PresScene.boundsOf(c))
            it.sx = (itemAt bx 0)
            it.sy = (itemAt bx 1)
            it.sw = (itemAt bx 2)
            it.sh = (itemAt bx 3)
            it.peak = c.a
            PresFlightScene.colour(it (PresFlightScene.glow(c (PresFlightScene.cyan()))))
            it.op = ((? (PresFlightScene.hued(c)) 0.95 0.7) * (PresFlightScene.alphaOf(c)))
        }
        if (it.kind == "panel") {
            if (c.kind == 0) {
                def f:double (0.04 + (0.1 * c.a))
                if (f > it.fill) {
                    it.fill = f
                }
            }
            if (c.kind == 7) {
                it.brackets = true
            }
        }
        return it
    }

    sfn colour:void (it:FlightItem rgb:[double]) {
        if ((array_length rgb) == 3) {
            it.r = (itemAt rgb 0)
            it.g = (itemAt rgb 1)
            it.b = (itemAt rgb 2)
        }
    }

    ; the entity under the slide that entity `o` is part of (0: the slide)
    sfn topOf:int (sc:PresScene o:int) {
        def at:int o
        def guard:int 0
        while ((at > 0) && (guard < 1000)) {
            def en:PresEnt (itemAt sc.ents at)
            if (en.parent <= 0) {
                return at
            }
            at = en.parent
            guard = (guard + 1)
        }
        return 0
    }

    ; The build step command k comes in with (0: with the slide).
    sfn stepOf:int (s:PresSlide groupOfCmd:[int] k:int) {
        if (k >= (array_length groupOfCmd)) {
            return 0
        }
        def g:int (itemAt groupOfCmd k)
        if ((g < 0) || (g >= (array_length s.groups))) {
            return 0
        }
        def gr:PresGroup (itemAt s.groups g)
        return gr.step
    }

    ; Whether a command puts anything on the slide.
    sfn shows:boolean (c:EVGDrawCmd) {
        if ((c.kind == 4) || (c.kind == 5)) {
            return false
        }
        if (c.a <= 0.01) {
            return false
        }
        if (c.kind == 3) {
            return ((strlen (trim c.text)) > 0)
        }
        if (c.kind == 2) {
            return ((strlen c.src) > 0)
        }
        if ((c.kind == 6) || (c.kind == 7)) {
            return ((array_length c.pts) >= 4)
        }
        return ((c.w > 0.0) && (c.h > 0.0))
    }

    fn addSlide:void (deck:PresDeck s:PresSlide i:int) {
        def st:FlightStation (this.station(i s.title))
        def rest:PresRest (deck.restOfSlide(i))
        def sc:PresScene rest.scene
        def cmds:[EVGDrawCmd] rest.list.cmds
        def pw:double sc.pageW
        def ph:double sc.pageH
        if ((pw <= 0.0) || (ph <= 0.0)) {
            pw = deck.pageW
            ph = deck.pageH
        }
        curPW = pw
        curPH = ph
        def nEnt:int (array_length sc.ents)
        def nCmd:int (array_length cmds)
        ; each command's block, and what kind of block it is
        def topOf:[int]
        def k:int 0
        while (k < nCmd) {
            def o:int 0
            if (k < (array_length sc.ownerOfCmd)) {
                o = (itemAt sc.ownerOfCmd k)
            }
            push topOf (PresFlightScene.topOf(sc o))
            k = (k + 1)
        }
        st.kind = "slide"
        def e:int 1
        while (e < nEnt) {
            def en:PresEnt (itemAt sc.ents e)
            if ((en.parent == 0) && ((en.kind == "chart") && (st.kind == "slide"))) {
                st.kind = "chart"
            }
            if ((en.parent == 0) && (en.kind == "diagram")) {
                st.kind = "diagram"
            }
            e = (e + 1)
        }
        ; charts are seen a little from above, so the bars' tops show
        if (st.kind == "chart") {
            this.frameSlide(st 0.18)
        } {
            this.frameSlide(st 0.06)
        }
        ; the pies the charts draw, per block
        def pies:[FlightPie]
        e = 0
        while (e < nEnt) {
            push pies (PresFlightScene.pieOf(cmds topOf e))
            e = (e + 1)
        }
        ; each block and step comes in in turn: per (block, step) its place
        ; in the reveal
        def keys:[int]
        def orders:[int]
        def within:[int]
        def q:int 0
        while (q <= (s.steps + 1)) {
            push within 0
            q = (q + 1)
        }
        ; per block, the line of words the next text may go on (-1: none)
        def lineOf:[int]
        e = 0
        while (e < nEnt) {
            push lineOf -1
            e = (e + 1)
        }
        def made:int (array_length items)
        firstItem = made
        k = 0
        while (k < nCmd) {
            def c:EVGDrawCmd (itemAt cmds k)
            def effect:boolean ((c.kind == 0) && (((strlen c.effectId) > 0) && ((c.w > 0.0) && (c.h > 0.0))))
            if ((PresFlightScene.shows(c)) || effect) {
                def top:int (itemAt topOf k)
                def te:PresEnt (itemAt sc.ents top)
                def block:string (? (top > 0) te.kind "ground")
                def step:int (PresFlightScene.stepOf(s rest.groupOfCmd k))
                if (step > s.steps) {
                    step = s.steps
                }
                if (step < 0) {
                    step = 0
                }
                def order:int 0
                if (top > 0) {
                    def key:int ((step * 100000) + top)
                    def at:int (indexOf keys key)
                    if (at < 0) {
                        push keys key
                        def wi:int (itemAt within step)
                        set within step (wi + 1)
                        if (wi > 3) {
                            wi = 3
                        }
                        push orders (1 + ((step * 4) + wi))
                        at = ((array_length keys) - 1)
                    }
                    order = (itemAt orders at)
                }
                def dz:double 0.0
                if (top > 0) {
                    dz = (PresFlightScene.depth(block))
                }
                def ent:string (? (top > 0) te.id "slide")
                curEnt = ent
                curOrder = order
                if (c.kind == 3) {
                    this.addText(st c k top block lineOf order dz ent)
                }
                if (((c.kind == 0) || (c.kind == 1)) && (PresFlightScene.shows(c))) {
                    def ri:FlightItem (this.addRect(st c k top block dz pw ph))
                    ri.order = order
                    ri.ent = ent
                }
                if (c.kind == 2) {
                    def pi:FlightItem (this.addPicture(st c k top dz))
                    pi.order = order
                    pi.ent = ent
                }
                if (c.kind == 6) {
                    def si:FlightItem (this.addPath(st c k block (itemAt pies top) dz))
                    si.order = order
                    si.ent = ent
                }
                if (c.kind == 7) {
                    def li:FlightItem (this.addStroke(st c k block dz))
                    li.order = order
                    li.ent = ent
                }
                if effect {
                    ; the block's own effect
                    def fx:FlightItem (this.item("fx" i))
                    fx.text = c.effectId
                    fx.grow((PresScene.boundsOf(c)))
                    fx.dz = (dz + 0.3)
                    push fx.cmds k
                    fx.order = order
                    fx.ent = ent
                }
            }
            k = (k + 1)
        }
        ; the slide's own effect, over all of it
        if ((strlen (trim s.fx)) > 0) {
            def sfx:FlightItem (this.item("fx" i))
            sfx.text = (trim s.fx)
            sfx.sx = 0.0
            sfx.sy = 0.0
            sfx.sw = pw
            sfx.sh = ph
            sfx.dz = 1.8
            sfx.ent = "slide"
        }
        ; the pies' rings of light around them, turning
        e = 0
        while (e < nEnt) {
            def pie:FlightPie (itemAt pies e)
            if (pie.is && (pie.slices > 0)) {
                this.addHalo(st pie (PresFlightScene.depth("chart")) pw)
            }
            e = (e + 1)
        }
        ; everything in its place in the world
        def m:int made
        while (m < (array_length items)) {
            this.place(st (itemAt items m) pw ph)
            m = (m + 1)
        }
    }

    ; An item made of the slide's rectangle (sx sy sw sh at dz) put where
    ; the station's camera sees it there.
    fn place:void (st:FlightStation it:FlightItem pw:double ph:double) {
        if ((array_length it.pts) >= 3) {
            ; its points were placed when it was made: its box around them
            def x0:double (itemAt it.pts 0)
            def x1:double x0
            def y0:double (itemAt it.pts 1)
            def y1:double y0
            def zs:double 0.0
            def n:int (idiv (array_length it.pts) 3)
            def j:int 0
            while (j < n) {
                def px:double (itemAt it.pts (j * 3))
                def py:double (itemAt it.pts ((j * 3) + 1))
                zs = (zs + (itemAt it.pts ((j * 3) + 2)))
                if (px < x0) {
                    x0 = px
                }
                if (px > x1) {
                    x1 = px
                }
                if (py < y0) {
                    y0 = py
                }
                if (py > y1) {
                    y1 = py
                }
                j = (j + 1)
            }
            it.x = ((x0 + x1) * 0.5)
            it.y = ((y0 + y1) * 0.5)
            it.z = (zs / (to_double n))
            it.w = (x1 - x0)
            it.h = (y1 - y0)
            return
        }
        if (it.sw < 0.0) {
            return
        }
        def at:[double] (this.placeRect(st it.sx it.sy it.sw it.sh pw ph it.dz))
        if (it.kind == "ring") {
            ; a ring is placed by its middle; its radii already are world units
            def mid:[double] (this.placeRect(st it.sx it.sy 0.0 0.0 pw ph it.dz))
            it.x = (itemAt mid 0)
            it.y = (itemAt mid 1)
            it.z = (itemAt mid 2)
            it.w = (it.r1 * 2.0)
            it.h = (it.r1 * 2.0)
            return
        }
        it.x = (itemAt at 0)
        it.y = (itemAt at 1)
        it.z = (itemAt at 2)
        it.w = (itemAt at 3)
        it.h = (itemAt at 4)
        if (it.kind == "bar") {
            if it.across {
                it.base = (it.x - (it.w * 0.5))
            } {
                it.base = (it.y - (it.h * 0.5))
            }
        }
        if (it.kind == "text") {
            def u:double (this.unitAt(st pw it.dz))
            def r:int 0
            while (r < (array_length it.runs)) {
                def ru:FlightRun (itemAt it.runs r)
                ru.dx = ((ru.sx - it.sx) * u)
                ru.w = (ru.sw * u)
                ru.size = (ru.fpx * u)
                r = (r + 1)
            }
        }
    }

    ; A point of the slide `dz` in front of the station, where its camera
    ; sees it there: [x, y, z].
    fn placePoint:[double] (st:FlightStation x:double y:double pw:double ph:double dz:double) {
        def at:[double] (this.placeRect(st x y 0.0 0.0 pw ph dz))
        return ([] _:double ((itemAt at 0) (itemAt at 1) (itemAt at 2)))
    }

    ; ---- words -------------------------------------------------------------------

    ; Whether a text is set in a typewriter face.
    sfn isMono:boolean (c:EVGDrawCmd) {
        def f:string (to_lowercase c.fontFamily)
        return ((((indexOf f "mono") >= 0) || ((indexOf f "courier") >= 0)) || (((indexOf f "code") >= 0) || ((indexOf f "consol") >= 0)))
    }
    ; bold as a weight, or as the face (MdToEvg names it: "Open Sans-Bold")
    sfn isBold:boolean (c:EVGDrawCmd) {
        def w:string (to_lowercase c.fontWeight)
        if ((indexOf (to_lowercase c.fontFamily) "bold") >= 0) {
            return true
        }
        return (((w == "bold") || (w == "bolder")) || (((w == "600") || (w == "700")) || ((w == "800") || (w == "900"))))
    }
    sfn isItalic:boolean (c:EVGDrawCmd) {
        return ((c.textAlign == "italic") || ((indexOf (to_lowercase c.fontFamily) "italic") >= 0))
    }

    ; Text k on a line of its block's words: the line before it when it
    ; goes on from there (the same step, beside its last run), else a new
    ; one.
    fn addText:void (st:FlightStation c:EVGDrawCmd k:int top:int block:string lineOf:[int] order:int dz:double ent:string) {
        def fs:double c.fontSize
        if (fs <= 0.0) {
            fs = c.h
        }
        def bx:[double] (PresScene.boundsOf(c))
        def h:double (itemAt bx 3)
        if (h <= 0.0) {
            h = (fs * 1.2)
            set bx 3 h
        }
        if ((itemAt bx 2) <= 0.0) {
            ; no width measured: about what its letters take
            set bx 2 ((fs * 0.55) * (to_double (strlen c.text)))
        }
        def cy:double ((itemAt bx 1) + (h * 0.5))
        def at:int (itemAt lineOf top)
        def joined:boolean false
        def it:FlightItem (new FlightItem())
        if ((at >= 0) && (c.rotate == 0.0)) {
            def ln:FlightItem (itemAt items at)
            def last:FlightRun (itemAt ln.runs ((array_length ln.runs) - 1))
            def lcy:double (ln.sy + (ln.sh * 0.5))
            def gap:double ((itemAt bx 0) - (last.sx + last.sw))
            if (((ln.order == order) && (ln.rot == 0.0)) && ((((fabs (lcy - cy)) < (fs * 0.45)) && (gap > (0.0 - (fs * 0.6)))) && (gap < (fs * 1.6)))) {
                it = ln
                joined = true
            }
        }
        if (joined == false) {
            it = (this.item("text" st.index))
            it.dz = (dz + 0.12)
            it.rot = c.rotate
            it.order = order
            it.ent = ent
            set lineOf top ((array_length items) - 1)
        }
        def ru:FlightRun (new FlightRun())
        ru.text = c.text
        ru.cmd = k
        ru.sx = (itemAt bx 0)
        ru.sw = (itemAt bx 2)
        ru.fpx = fs
        ru.bold = (PresFlightScene.isBold(c))
        ru.italic = (PresFlightScene.isItalic(c))
        ru.mono = (PresFlightScene.isMono(c))
        if ((c.textAlign == "center") || (c.textAlign == "right")) {
            ru.align = c.textAlign
        }
        def deflt:[double] (PresFlightScene.words())
        if (((indexOf block "h") == 0) && ((strlen block) == 2)) {
            deflt = (PresFlightScene.white())
        }
        def rgb:[double] (PresFlightScene.glow(c deflt))
        ru.r = (itemAt rgb 0)
        ru.g = (itemAt rgb 1)
        ru.b = (itemAt rgb 2)
        push it.runs ru
        push it.cmds k
        it.grow(bx)
        if ((strlen it.text) > 0) {
            it.text = (it.text + " ")
        }
        it.text = (it.text + (trim c.text))
    }

    ; ---- plates, bars, pictures ----------------------------------------------

    ; A rectangle (a fill, or a border: kind 1) of the slide.
    fn addRect:FlightItem (st:FlightStation c:EVGDrawCmd k:int top:int block:string dz:double pw:double ph:double) {
        def bx:[double] (PresScene.boundsOf(c))
        def w:double (itemAt bx 2)
        def h:double (itemAt bx 3)
        ; the slide's own paper: the screen it stands in
        if (((top == 0) && (c.kind == 0)) && (((w * h) >= ((pw * ph) * 0.9)))) {
            def gr:FlightItem (this.item("ground" st.index))
            PresFlightScene.colour(gr (PresFlightScene.glow(c (PresFlightScene.cyan()))))
            gr.grow(([] _:double (0.0 0.0 pw ph)))
            gr.dz = 0.0
            push gr.cmds k
            return gr
        }
        def host:int (this.hostOf(c.kind bx))
        if (host >= 0) {
            return (this.attach(host k c))
        }
        ; a rule: a thin line of light along it
        if ((c.kind == 0) && ((w <= 2.5) || (h <= 2.5))) {
            def rg:int (this.groupOf(c))
            def ln:FlightItem (? (rg >= 0) (itemAt items rg) (this.item("line" st.index)))
            PresFlightScene.colour(ln (PresFlightScene.glow(c (PresFlightScene.cyan()))))
            def x0:double (itemAt bx 0)
            def y0:double (itemAt bx 1)
            if (w >= h) {
                PresFlightScene.pushAll(ln.pts (this.placePoint(st x0 (y0 + (h * 0.5)) pw ph dz)))
                PresFlightScene.pushAll(ln.pts (this.placePoint(st (x0 + w) (y0 + (h * 0.5)) pw ph dz)))
            } {
                PresFlightScene.pushAll(ln.pts (this.placePoint(st (x0 + (w * 0.5)) y0 pw ph dz)))
                PresFlightScene.pushAll(ln.pts (this.placePoint(st (x0 + (w * 0.5)) (y0 + h) pw ph dz)))
            }
            ln.rad = 0.012
            ln.op = ((? (PresFlightScene.hued(c)) 0.9 0.5) * (PresFlightScene.alphaOf(c)))
            ln.key = (PresFlightScene.lineKey(c))
            push ln.ends (idiv (array_length ln.pts) 3)
            ln.grow(bx)
            push ln.cmds k
            return ln
        }
        ; a chart's coloured box: a bar standing out of the chart
        if ((block == "chart") && ((c.kind == 0) && (PresFlightScene.hued(c)))) {
            def bar:FlightItem (this.item("bar" st.index))
            PresFlightScene.colour(bar (PresFlightScene.neon(c)))
            bar.grow(bx)
            bar.across = ((w > (h * 1.6)) && (h < 60.0))
            def u:double (this.unitAt(st pw dz))
            def thin:double (? (w < h) w h)
            bar.d = ((thin * u) * 0.6)
            if (bar.d > 0.6) {
                bar.d = 0.6
            }
            bar.dz = (dz + (bar.d * 0.5))
            push bar.cmds k
            return bar
        }
        def pn:FlightItem (this.item("panel" st.index))
        PresFlightScene.colour(pn (PresFlightScene.glow(c (PresFlightScene.cyan()))))
        pn.grow(bx)
        pn.dz = dz
        if (top == 0) {
            pn.dz = 0.05
        }
        if (c.kind == 0) {
            pn.fill = (0.04 + (0.1 * c.a))
        }
        pn.op = ((? (PresFlightScene.hued(c)) 0.95 0.7) * (PresFlightScene.alphaOf(c)))
        pn.peak = c.a
        ; a card, a node, a plate: brackets at its corners (not a table's cells)
        pn.brackets = (((w >= 60.0) && (h >= 30.0)) && ((block != "table") && ((block != "chart") && (block != "html"))))
        push pn.cmds k
        return pn
    }

    fn addPicture:FlightItem (st:FlightStation c:EVGDrawCmd k:int top:int dz:double) {
        def pc:FlightItem (this.item("picture" st.index))
        pc.src = c.src
        pc.grow((PresScene.boundsOf(c)))
        pc.dz = dz
        pc.op = 0.9
        if (top == 0) {
            ; a picture behind the slide, dimmer, at its back
            pc.dz = 0.02
            pc.op = 0.5
        }
        push pc.cmds k
        return pc
    }

    sfn pushAll:void (to:[double] from:[double]) {
        def i:int 0
        while (i < (array_length from)) {
            push to (itemAt from i)
            i = (i + 1)
        }
    }

    ; ---- paths and lines -------------------------------------------------------

    ; The pie block e's paths draw (`is` false when they draw none): all its
    ; paths are slices of one circle, their points no further out than its
    ; rim and each of them reaching it.
    sfn pieOf:FlightPie (cmds:[EVGDrawCmd] topOf:[int] e:int) {
        def pie:FlightPie (new FlightPie())
        if (e <= 0) {
            return pie
        }
        def got:boolean false
        def x0:double 0.0
        def x1:double 0.0
        def y0:double 0.0
        def y1:double 0.0
        def n:int 0
        def k:int 0
        while (k < (array_length cmds)) {
            def c:EVGDrawCmd (itemAt cmds k)
            if (((itemAt topOf k) == e) && ((c.kind == 6) && (PresFlightScene.shows(c)))) {
                def bx:[double] (PresScene.boundsOf(c))
                if (((itemAt bx 2) > 40.0) || ((itemAt bx 3) > 40.0)) {
                    n = (n + 1)
                    if (got == false) {
                        x0 = (itemAt bx 0)
                        y0 = (itemAt bx 1)
                        x1 = (x0 + (itemAt bx 2))
                        y1 = (y0 + (itemAt bx 3))
                        got = true
                    } {
                        if ((itemAt bx 0) < x0) {
                            x0 = (itemAt bx 0)
                        }
                        if ((itemAt bx 1) < y0) {
                            y0 = (itemAt bx 1)
                        }
                        if (((itemAt bx 0) + (itemAt bx 2)) > x1) {
                            x1 = ((itemAt bx 0) + (itemAt bx 2))
                        }
                        if (((itemAt bx 1) + (itemAt bx 3)) > y1) {
                            y1 = ((itemAt bx 1) + (itemAt bx 3))
                        }
                    }
                }
            }
            k = (k + 1)
        }
        if (n == 0) {
            return pie
        }
        def w:double (x1 - x0)
        def h:double (y1 - y0)
        def big:double (? (w > h) w h)
        if ((fabs (w - h)) > (big * 0.08)) {
            return pie
        }
        pie.cx = ((x0 + x1) * 0.5)
        pie.cy = ((y0 + y1) * 0.5)
        pie.rad = (big * 0.5)
        k = 0
        while (k < (array_length cmds)) {
            def c2:EVGDrawCmd (itemAt cmds k)
            if (((itemAt topOf k) == e) && ((c2.kind == 6) && (PresFlightScene.shows(c2)))) {
                def b2:[double] (PresScene.boundsOf(c2))
                if (((itemAt b2 2) > 40.0) || ((itemAt b2 3) > 40.0)) {
                    def far:double 0.0
                    def j:int 0
                    while ((j + 1) < (array_length c2.pts)) {
                        def dx:double ((itemAt c2.pts j) - pie.cx)
                        def dy:double ((itemAt c2.pts (j + 1)) - pie.cy)
                        def d:double (sqrt(((dx * dx) + (dy * dy))))
                        if (d > (pie.rad * 1.06)) {
                            return pie
                        }
                        if (d > far) {
                            far = d
                        }
                        j = (j + 2)
                    }
                    if (far < (pie.rad * 0.85)) {
                        return pie
                    }
                }
            }
            k = (k + 1)
        }
        pie.is = true
        return pie
    }

    ; A path of the slide: a pie's slice (a ring of light), a chart's point
    ; (a ball), else an outline of light.
    fn addPath:FlightItem (st:FlightStation c:EVGDrawCmd k:int block:string pie:FlightPie dz:double) {
        def bx:[double] (PresScene.boundsOf(c))
        def w:double (itemAt bx 2)
        def h:double (itemAt bx 3)
        if (pie.is && ((w > 40.0) || (h > 40.0))) {
            return (this.addSlice(st c k pie dz))
        }
        def big:double (? (w > h) w h)
        if (((block == "chart") && (big <= 24.0)) && ((fabs (w - h)) <= ((big * 0.25) + 0.5))) {
            def dot:FlightItem (this.item("dot" st.index))
            PresFlightScene.colour(dot (PresFlightScene.glow(c (PresFlightScene.cyan()))))
            dot.grow(bx)
            dot.dz = (dz + 0.15)
            push dot.cmds k
            return dot
        }
        def sh:FlightItem (this.item("shape" st.index))
        def deflt:[double] (PresFlightScene.cyan())
        if (block == "diagram") {
            deflt = (PresFlightScene.yellow())
        }
        PresFlightScene.colour(sh (PresFlightScene.glow(c deflt)))
        def lift:double dz
        if (block == "ground") {
            lift = 0.08
        }
        this.placePts(st sh c.pts lift)
        def j:int 0
        while (j < (array_length c.ringEnds)) {
            push sh.ends (idiv (itemAt c.ringEnds j) 2)
            j = (j + 1)
        }
        sh.fill = (? (PresFlightScene.hued(c)) 0.22 0.1)
        ; a small solid mark (an arrow's head, a bullet) glows whole
        if (big <= 22.0) {
            sh.fill = 0.85
        }
        sh.op = 0.95
        push sh.cmds k
        return sh
    }

    ; The slide's points (x,y pairs) where the station's camera sees them
    ; `dz` in front of the slide, onto it.pts.
    fn placePts:void (st:FlightStation it:FlightItem pts:[double] dz:double) {
        def j:int 0
        while ((j + 1) < (array_length pts)) {
            PresFlightScene.pushAll(it.pts (this.placePoint(st (itemAt pts j) (itemAt pts (j + 1)) curPW curPH dz)))
            j = (j + 2)
        }
    }

    ; A slice of a pie: a band of a ring around the pie's middle, as far
    ; round as the slice goes, in a pink of its own.
    fn addSlice:FlightItem (st:FlightStation c:EVGDrawCmd k:int pie:FlightPie dz:double) {
        def angles:[double]
        def near:double -1.0
        def far:double 0.0
        def j:int 0
        while ((j + 1) < (array_length c.pts)) {
            def dx:double ((itemAt c.pts j) - pie.cx)
            def dy:double (pie.cy - (itemAt c.pts (j + 1)))
            def d:double (sqrt(((dx * dx) + (dy * dy))))
            if (d > far) {
                far = d
            }
            if ((near < 0.0) || (d < near)) {
                near = d
            }
            if (d > (pie.rad * 0.4)) {
                push angles (atan2 dy dx)
            }
            j = (j + 2)
        }
        def span:[double] (PresFlightScene.arcOf(angles))
        def rg:FlightItem (this.item("ring" st.index))
        PresFlightScene.colour(rg (PresFlightScene.pink(pie.slices)))
        pie.slices = (pie.slices + 1)
        def u:double (this.unitAt(st curPW dz))
        rg.a0 = (itemAt span 0)
        rg.a1 = (itemAt span 1)
        rg.r1 = (far * u)
        ; a whole pie is drawn as a ring too: the hologram's look
        def inner:double (near * u)
        if (inner < (rg.r1 * 0.58)) {
            inner = (rg.r1 * 0.58)
        }
        rg.r0 = inner
        rg.d = 0.18
        rg.sx = pie.cx
        rg.sy = pie.cy
        rg.sw = 0.0
        rg.sh = 0.0
        rg.dz = dz
        push rg.cmds k
        return rg
    }

    ; The arc a set of angles (radians, -pi..pi) covers, [from, to] with
    ; from < to: all of the turn but its widest gap.
    sfn arcOf:[double] (angles0:[double]) {
        def n:int (array_length angles0)
        if (n == 0) {
            return ([] _:double (0.0 0.0))
        }
        def angles:[double]
        def i:int 0
        while (i < n) {
            push angles (itemAt angles0 i)
            i = (i + 1)
        }
        ; sorted, least first
        i = 1
        while (i < n) {
            def v:double (itemAt angles i)
            def j:int (i - 1)
            while ((j >= 0) && ((itemAt angles j) > v)) {
                set angles (j + 1) (itemAt angles j)
                j = (j - 1)
            }
            set angles (j + 1) v
            i = (i + 1)
        }
        def twoPi:double 6.283185307179586
        ; the gap from the last round to the first
        def best:double (((itemAt angles 0) + twoPi) - (itemAt angles (n - 1)))
        def from:double (itemAt angles 0)
        def to:double (itemAt angles (n - 1))
        i = 1
        while (i < n) {
            def gap:double ((itemAt angles i) - (itemAt angles (i - 1)))
            if (gap > best) {
                best = gap
                from = (itemAt angles i)
                to = ((itemAt angles (i - 1)) + twoPi)
            }
            i = (i + 1)
        }
        ; a whole turn: no gap worth the name
        if (best < 0.2) {
            return ([] _:double (0.0 twoPi))
        }
        return ([] _:double (from to))
    }

    ; Two thin whole rings round a pie that turn slowly, one each way.
    fn addHalo:void (st:FlightStation pie:FlightPie dz:double pw:double) {
        def u:double (this.unitAt(st pw dz))
        def k:int 0
        while (k < 2) {
            def hl:FlightItem (this.item("ring" st.index))
            PresFlightScene.colour(hl (PresFlightScene.pink(0)))
            def rr:double ((pie.rad * u) * (? (k == 0) 1.1 0.5))
            hl.r1 = rr
            hl.r0 = (rr - 0.04)
            hl.a0 = 0.0
            hl.a1 = (? (k == 0) 5.2 4.4)
            hl.d = 0.02
            hl.op = 0.6
            hl.spin = (? (k == 0) 0.25 (0.0 - 0.4))
            hl.sx = pie.cx
            hl.sy = pie.cy
            hl.sw = 0.0
            hl.dz = dz
            hl.order = 2
            hl.ent = ""
            k = (k + 1)
        }
    }

    ; A stroke of the slide: a tube of light along it. A chart's coloured
    ; line and every line of a diagram carry a running spark.
    fn addStroke:FlightItem (st:FlightStation c:EVGDrawCmd k:int block:string dz:double) {
        def host:int (this.hostOf(7 (PresScene.boundsOf(c))))
        if (host >= 0) {
            return (this.attach(host k c))
        }
        def len:double (PresFlightScene.strokeLength(c))
        def hued:boolean (PresFlightScene.hued(c))
        ; a diagram's lines and a chart's own lines (not its grid) carry sparks
        def strong:boolean (? (block == "diagram") (c.a >= 0.5) (((c.a >= 0.6) && (c.thickness >= 1.5)) && hued))
        def spark:boolean ((((block == "diagram") || (block == "chart")) && strong) && (len > 60.0))
        ; short plain lines of a kind (a grid, ticks) go together in one
        if (spark == false) {
            def g:int (this.groupOf(c))
            if (g >= 0) {
                def gl:FlightItem (itemAt items g)
                this.placePts(st gl c.pts (this.strokeLift(block dz)))
                push gl.ends (idiv (array_length gl.pts) 3)
                push gl.cmds k
                gl.grow((PresScene.boundsOf(c)))
                return gl
            }
        }
        def ln:FlightItem (this.item("line" st.index))
        def deflt:[double] (PresFlightScene.cyan())
        if (block == "diagram") {
            deflt = (PresFlightScene.yellow())
        }
        PresFlightScene.colour(ln (PresFlightScene.glow(c deflt)))
        def lift:double (this.strokeLift(block dz))
        this.placePts(st ln c.pts lift)
        ln.grow((PresScene.boundsOf(c)))
        push ln.ends (idiv (array_length ln.pts) 3)
        ln.key = (PresFlightScene.lineKey(c))
        def u:double (this.unitAt(st curPW lift))
        ln.rad = ((c.thickness * 0.5) * u)
        if (ln.rad < 0.012) {
            ln.rad = 0.012
        }
        ln.op = ((? (hued || (block == "diagram")) 0.95 0.5) * (PresFlightScene.alphaOf(c)))
        if ((block == "diagram") || ((block == "chart") && hued)) {
            ln.pulse = spark
            if (ln.rad < 0.03) {
                ln.rad = 0.03
            }
        }
        if spark {
            ln.key = ""
        }
        push ln.cmds k
        return ln
    }

    ; How far in front of the slide a block's lines float (a diagram's
    ; under its nodes).
    fn strokeLift:double (block:string dz:double) {
        if (block == "diagram") {
            return (dz - 0.1)
        }
        if (block == "ground") {
            return 0.08
        }
        return dz
    }

    ; A line's look, for lines that go together: colour, opacity, width.
    sfn lineKey:string (c:EVGDrawCmd) {
        return ((to_string c.r) + "," + (to_string c.g) + "," + (to_string c.b) + "," + (to_string (to_int (c.a * 20.0))) + "," + (to_string (to_int (c.thickness * 2.0))))
    }

    ; The line of this block and step that a stroke like c goes with (-1).
    fn groupOf:int (c:EVGDrawCmd) {
        def key:string (PresFlightScene.lineKey(c))
        def i:int ((array_length items) - 1)
        while (i >= firstItem) {
            def it:FlightItem (itemAt items i)
            if ((it.kind == "line") && (((it.ent == curEnt) && (it.order == curOrder)) && (it.key == key))) {
                return i
            }
            i = (i - 1)
        }
        return -1
    }

    ; how much of a command shows, 0.15..1 (a faint glow stays faint)
    sfn alphaOf:double (c:EVGDrawCmd) {
        def a:double (c.a * 1.3)
        if (a > 1.0) {
            return 1.0
        }
        if (a < 0.15) {
            return 0.15
        }
        return a
    }

    ; how long a stroke is, slide px
    sfn strokeLength:double (c:EVGDrawCmd) {
        def total:double 0.0
        def q:int 1
        while (((q * 2) + 1) < (array_length c.pts)) {
            def dx:double ((itemAt c.pts (q * 2)) - (itemAt c.pts ((q - 1) * 2)))
            def dy:double ((itemAt c.pts ((q * 2) + 1)) - (itemAt c.pts (((q - 1) * 2) + 1)))
            total = (total + (sqrt(((dx * dx) + (dy * dy)))))
            q = (q + 1)
        }
        return total
    }

    ; ---- out -----------------------------------------------------------------

    fn toJson:string () {
        def o:JVal (JVal.mkObj())
        def st:JVal (JVal.mkArr())
        def i:int 0
        while (i < (array_length stations)) {
            def s:FlightStation (itemAt stations i)
            st.add((s.toJson()))
            i = (i + 1)
        }
        o.set("stations" st)
        def it:JVal (JVal.mkArr())
        i = 0
        while (i < (array_length items)) {
            def f:FlightItem (itemAt items i)
            it.add((f.toJson()))
            i = (i + 1)
        }
        o.set("items" it)
        return (o.toJson())
    }

    ; how many items of a kind (for the checks)
    fn count:int (kind:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length items)) {
            def f:FlightItem (itemAt items i)
            if (f.kind == kind) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }
}
