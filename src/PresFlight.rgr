; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresFlight.rgr — the presentation as a 3-D world to fly through.
; ============================================================================
;
; Every slide is a station on a curving path through dark space; the camera
; flies from one to the next (src/PresFlightCam.rgr). A station shows
; its slide as the slide draws it, its blocks as plates painted by the
; slide's own painter, floating in front of the slide's ground (see "the
; slide's own drawing"). A slide's diagrams become glass panels floating at
; staggered depths in their block's place, their lines tubes that arc
; between them; a chart's bars stand up as boxes on the chart's plate.
;
; This is plain data, made from the deck and checked under Node
; (PresCheck.flight). The page hands its JSON to PresFlight3D (in
; pres_3d.js), which builds the Three scene from it, so the 3-D bundle never
; needs the deck. All positions are world units: x right, y up, z towards
; the viewer; a station's content fits a 16 x 9 box around its centre.
; ============================================================================

Import "PresDeck.rgr"
Import "JsonValue.rgr"
Import "pkg:evg/EVGColor.rgr"

; One thing in the world. `kind`:
;   glass  a diagram's node: a glass slab w x h x d with its text
;   group  a diagram's frame (a subgraph): a dim slab behind its nodes
;   title  a chart's own title
;   label  a line's or a value's name; axis  a category or series name
;   link   a tube along pts (x,y,z triples), `head` when it has an arrow
;   bar    a chart's bar: a box w x h x d centred at x,y,z
;   wedge  a pie's slice around x,y,z from angle a0 to a1, radii r0..r1, d deep
;   dot    a ball of radius w
;   plate  a part of the slide as the slide draws it: the page paints its
;          commands (`cmds`, slide rectangle sx sy sw sh) into a picture
;          w x h centred at x,y,z; `block` the kind of block, "ground" the
;          slide's own paper, picture and art
class FlightItem {
    def kind:string ""
    def station:int 0
    def x:double 0.0
    def y:double 0.0
    def z:double 0.0
    def w:double 0.0
    def h:double 0.0
    def d:double 0.0
    ; colour, 0..1
    def r:double 0.36
    def g:double 0.88
    def b:double 1.0
    def text:string ""
    ; the text's line height in world units
    def size:double 0.4
    ; its place in the station's reveal (0 first)
    def order:int 0
    def pts:[double]
    def head:boolean false
    def a0:double 0.0
    def a1:double 0.0
    def r0:double 0.0
    def r1:double 0.0
    ; a bar grows from here (y, or x when it lies across)
    def base:double 0.0
    def across:boolean false
    ; a bar's cap, the edge at its far end, in a colour of its own (0..1;
    ; capR < 0: the bar's)
    def capR:double -1.0
    def capG:double 0.0
    def capB:double 0.0
    ; a plate with an effect on it: the page paints it again as it runs
    def live:boolean false
    ; the slide's block it stands for (its PresEnt id), "" for none
    def ent:string ""
    ; a plate: the commands of the slide's list at rest it paints
    ; (PresDeck.restOfSlide), and that rectangle of the slide, slide px
    def cmds:[int]
    def sx:double 0.0
    def sy:double 0.0
    def sw:double 0.0
    def sh:double 0.0
    ; a plate: its index among the scene's plates (PresFlightScene.plateJson),
    ; and the kind of block it paints ("ground": the slide's own)
    def pl:int -1
    def block:string ""

    fn toJson:JVal () {
        def o:JVal (JVal.mkObj())
        o.setStr("k" kind)
        o.setInt("s" station)
        o.setNum("x" (FlightItem.round3(x)))
        o.setNum("y" (FlightItem.round3(y)))
        o.setNum("z" (FlightItem.round3(z)))
        if ((w != 0.0) || (h != 0.0)) {
            o.setNum("w" (FlightItem.round3(w)))
            o.setNum("h" (FlightItem.round3(h)))
            o.setNum("d" (FlightItem.round3(d)))
        }
        def c:JVal (JVal.mkArr())
        c.add((JVal.mkNum((FlightItem.round3(r)))))
        c.add((JVal.mkNum((FlightItem.round3(g)))))
        c.add((JVal.mkNum((FlightItem.round3(b)))))
        o.set("c" c)
        if ((strlen text) > 0) {
            o.setStr("t" text)
            o.setNum("fs" (FlightItem.round3(size)))
        }
        o.setInt("o" order)
        if ((array_length pts) > 0) {
            def p:JVal (JVal.mkArr())
            def i:int 0
            while (i < (array_length pts)) {
                p.add((JVal.mkNum((FlightItem.round3((itemAt pts i))))))
                i = (i + 1)
            }
            o.set("p" p)
            o.setBool("head" head)
        }
        if (kind == "wedge") {
            o.setNum("a0" (FlightItem.round3(a0)))
            o.setNum("a1" (FlightItem.round3(a1)))
            o.setNum("r0" (FlightItem.round3(r0)))
            o.setNum("r1" (FlightItem.round3(r1)))
        }
        if (kind == "bar") {
            o.setNum("base" (FlightItem.round3(base)))
            o.setBool("across" across)
            if (capR >= 0.0) {
                def cc:JVal (JVal.mkArr())
                cc.add((JVal.mkNum((FlightItem.round3(capR)))))
                cc.add((JVal.mkNum((FlightItem.round3(capG)))))
                cc.add((JVal.mkNum((FlightItem.round3(capB)))))
                o.set("cap" cc)
            }
        }
        if (kind == "plate") {
            o.setInt("pl" pl)
            o.setStr("blk" block)
            o.setNum("pw" (FlightItem.round3(sw)))
            o.setNum("ph" (FlightItem.round3(sh)))
            if live {
                o.setBool("fx" true)
            }
        }
        if ((strlen ent) > 0) {
            o.setStr("ent" ent)
        }
        return o
    }

    sfn round3:double (v:double) {
        def k:double (v * 1000.0)
        if (k < 0.0) {
            return ((to_double (0 - (floor ((0.0 - k) + 0.5)))) / 1000.0)
        }
        return ((to_double (floor (k + 0.5))) / 1000.0)
    }
}

; A slide's place in the world: its centre and how far back the camera
; stands to see it whole.
class FlightStation {
    def index:int 0
    def title:string ""
    ; "diagram", "chart" or "slide" (nothing to show but the title)
    def kind:string "slide"
    def x:double 0.0
    def y:double 0.0
    def z:double 0.0
    def dist:double 13.0
    ; where the camera looks (the middle of what the station shows) and how
    ; high above it the camera stands
    def fx:double 0.0
    def fy:double 0.0
    def lift:double 1.0

    fn toJson:JVal () {
        def o:JVal (JVal.mkObj())
        o.setInt("i" index)
        o.setStr("t" title)
        o.setStr("k" kind)
        o.setNum("x" (FlightItem.round3(x)))
        o.setNum("y" (FlightItem.round3(y)))
        o.setNum("z" (FlightItem.round3(z)))
        o.setNum("dist" (FlightItem.round3(dist)))
        o.setNum("fx" (FlightItem.round3(fx)))
        o.setNum("fy" (FlightItem.round3(fy)))
        o.setNum("lift" (FlightItem.round3(lift)))
        return o
    }
}

; A chart's bars as it draws them (PresFlightScene.barsOf): per bar the
; command of its body and of its cap (-1 for none), whether they stand up
; as boxes, and per command of the list whether a box stands for it.
class FlightBars {
    def body:[int]
    def cap:[int]
    def across:boolean false
    ; the base line, slide units (x for bars across, else y)
    def base:double 0.0
    def stand:boolean false
    def stood:[boolean]
}

class PresFlightScene {
    def stations:[FlightStation]
    def items:[FlightItem]
    ; a slide's size in the world: its long side 16 units on a 16:9 screen
    def frameW:double 16.0
    def frameH:double 9.0
    ; an item's colour until it is given its own: the hologram's cyan
    def acR:double 0.36
    def acG:double 0.88
    def acB:double 1.0

    ; how far apart the stations are along the path
    sfn spacing:double () {
        return 36.0
    }

    ; Where station i stands: a gentle S curve that goes away from the viewer.
    sfn stationX:double (i:int) {
        return ((sin(((to_double i) * 0.55))) * 14.0)
    }
    sfn stationY:double (i:int) {
        return (((cos(((to_double i) * 0.35))) * 3.0) - 3.0)
    }
    sfn stationZ:double (i:int) {
        return (0.0 - ((to_double i) * (PresFlightScene.spacing())))
    }


    ; The deck as a world: one station per slide.
    sfn of:PresFlightScene (deck:PresDeck) {
        def sc:PresFlightScene (new PresFlightScene())
        sc.frameFor(deck.pageW deck.pageH)
        def n:int (deck.slideCount())
        def i:int 0
        while (i < n) {
            sc.addSlide(deck (deck.slideAt(i)) i)
            i = (i + 1)
        }
        return sc
    }

    ; A slide w x h px in the world: as wide as a 16 x 9 screen holds it.
    fn frameFor:void (w:double h:double) {
        if ((w <= 0.0) || (h <= 0.0)) {
            return
        }
        if ((w / h) >= (16.0 / 9.0)) {
            frameW = 16.0
            frameH = ((16.0 * h) / w)
        } {
            frameH = 9.0
            frameW = ((9.0 * w) / h)
        }
    }

    ; ---- the slide's own drawing ---------------------------------------------
    ;
    ; A station shows its slide as the slide draws it. Each block of the
    ; slide (a heading, a paragraph, a list item, a table, a picture …), one
    ; plate for each of its build steps, is painted by the page with the
    ; slide's own painter from the slide's list at rest
    ; (PresDeck.restOfSlide): its commands, their fonts, colours and
    ; pictures as they are (`plateJson`). The slide's ground (its paper,
    ; picture, art) is the plate at the back; the blocks float in front of
    ; it, each at a depth of its own, and each moved along the line from the
    ; station's camera and grown with the distance, so that from the camera
    ; every plate covers its place on the slide exactly. Flown past, the
    ; slide comes apart in depth.
    ;
    ; The diagrams this world can stand up in 3-D are not plates: they stand
    ; in their block's place as holograms. A chart is a plate whose bars
    ; stand up as boxes on it (standBars).

    ; per station, the list its plates are painted from
    def rests:[EVGDisplayList]
    ; the plates, in the order the JSON names them (an item's `pl`)
    def plates:[FlightItem]

    ; How far in front of the slide's ground a block's plate floats.
    sfn depthOf:double (kind:string) {
        if (((indexOf kind "h") == 0) && ((strlen kind) == 2)) {
            return 1.4
        }
        if ((kind == "p") || ((kind == "li") || ((kind == "quote") || (kind == "marker")))) {
            return 0.9
        }
        if ((kind == "figure") || (kind == "app")) {
            return 0.8
        }
        if ((kind == "code") || ((kind == "table") || ((kind == "html") || (kind == "math")))) {
            return 0.7
        }
        if (kind == "image") {
            return 0.5
        }
        if ((kind == "header") || ((kind == "footer") || (kind == "note"))) {
            return 0.3
        }
        return 0.6
    }

    ; Where the station's camera stands (its eye).
    sfn eyeX:double (st:FlightStation) {
        return st.fx
    }
    sfn eyeY:double (st:FlightStation) {
        return (st.fy + st.lift)
    }
    sfn eyeZ:double (st:FlightStation) {
        return (st.z + st.dist)
    }

    ; How much nearer the eye a thing `dz` in front of the slide stands, as a
    ; part of its way there along the line of sight (1: on the slide).
    sfn towards:double (st:FlightStation dz:double) {
        def ez:double (PresFlightScene.eyeZ(st))
        def far:double (ez - st.z)
        if (far <= 0.001) {
            return 1.0
        }
        return ((far - dz) / far)
    }

    ; The slide's rectangle x y w h (slide px, the slide pw x ph) at `dz` in
    ; front of station st, seen from its eye where the slide has it: the
    ; centre [x, y, z] and size [w, h] in the world.
    fn placeRect:[double] (st:FlightStation x:double y:double w:double h:double pw:double ph:double dz:double) {
        def wx:double (st.x + ((((x + (w * 0.5)) / pw) - 0.5) * frameW))
        def wy:double (st.y + ((0.5 - ((y + (h * 0.5)) / ph)) * frameH))
        def t:double (PresFlightScene.towards(st dz))
        def ex:double (PresFlightScene.eyeX(st))
        def ey:double (PresFlightScene.eyeY(st))
        return ([] _:double ((ex + ((wx - ex) * t)) (ey + ((wy - ey) * t)) (st.z + dz) (((w / pw) * frameW) * t) (((h / ph) * frameH) * t)))
    }

    fn addSlide:void (deck:PresDeck s:PresSlide i:int) {
        def st:FlightStation (this.station(i s.title))
        def rest:PresRest (deck.restOfSlide(i))
        push rests rest.list
        def sc:PresScene rest.scene
        def pw:double sc.pageW
        def ph:double sc.pageH
        def nEnt:int (array_length sc.ents)
        ; a diagram's nodes are plates of their own, floating at a depth by
        ; their rank; its lines are tubes between them. Per entity its node's
        ; depth (-1 for none), and whether it is a line
        def nodeDz:[double]
        def isEdge:[boolean]
        def anyDia:boolean false
        def e:int 0
        while (e < nEnt) {
            push nodeDz -1.0
            push isEdge false
            e = (e + 1)
        }
        e = 0
        while (e < nEnt) {
            def en:PresEnt (itemAt sc.ents e)
            if ((en.parent == 0) && (en.kind == "diagram")) {
                anyDia = true
            }
            if ((en.kind == "node") || (en.kind == "edge")) {
                def dtop:int (PresFlightScene.topOf(sc e))
                def dte:PresEnt (itemAt sc.ents dtop)
                if ((dtop > 0) && (dte.kind == "diagram")) {
                    if (en.kind == "node") {
                        set nodeDz e (PresFlightScene.nodeDepth(s dte en.name))
                    } {
                        set isEdge e true
                    }
                }
            }
            e = (e + 1)
        }
        ; each command's block (the entity under the slide; 0 the slide),
        ; and per block its chart's bar parts
        def topOf:[int]
        def partsOf:[[int]]
        e = 0
        while (e < nEnt) {
            def none:[int]
            push partsOf none
            e = (e + 1)
        }
        e = 0
        while (e < nEnt) {
            def eb:PresEnt (itemAt sc.ents e)
            if (eb.kind == "bar") {
                def top0:int (PresFlightScene.topOf(sc e))
                def te0:PresEnt (itemAt sc.ents top0)
                if ((top0 > 0) && (te0.kind == "chart")) {
                    def bs:[int] (itemAt partsOf top0)
                    push bs e
                }
            }
            e = (e + 1)
        }
        ; the bars that stand up as boxes, per block
        def barsOf:[FlightBars]
        def anyChart:boolean false
        e = 0
        while (e < nEnt) {
            def fb:FlightBars (new FlightBars())
            if (((array_length (itemAt partsOf e)) > 0) && (PresFlightScene.barMarks(s (itemAt sc.ents e)))) {
                fb = (PresFlightScene.barsOf(rest.list sc.ownerOfCmd (itemAt partsOf e)))
                if fb.stand {
                    anyChart = true
                }
            }
            push barsOf fb
            e = (e + 1)
        }
        st.kind = "slide"
        if anyChart {
            st.kind = "chart"
        }
        if anyDia {
            st.kind = "diagram"
        }
        ; charts are seen a little from above, so the rows behind show
        if anyChart {
            this.frameSlide(st 0.25)
        } {
            this.frameSlide(st 0.08)
        }
        def k3:int 0
        while (k3 < (array_length rest.list.cmds)) {
            def o:int 0
            if (k3 < (array_length sc.ownerOfCmd)) {
                o = (itemAt sc.ownerOfCmd k3)
            }
            push topOf (PresFlightScene.topOf(sc o))
            k3 = (k3 + 1)
        }
        ; the plates: one for each block and build step, the ground first (a
        ; chart's bars are boxes, its words and the rest on its plate)
        def keys:[int]
        def mine:[FlightItem]
        def topsOf:[int]
        ; a plate's depth (-1: its block's)
        def dzOf:[double]
        def k4:int 0
        while (k4 < (array_length rest.list.cmds)) {
            def c:EVGDrawCmd (itemAt rest.list.cmds k4)
            def top:int (itemAt topOf k4)
            def tb:FlightBars (itemAt barsOf top)
            ; the diagram's node or line it is drawn for (0: none)
            def own:int 0
            if (k4 < (array_length sc.ownerOfCmd)) {
                own = (itemAt sc.ownerOfCmd k4)
            }
            def part:int (PresFlightScene.partUp(sc own nodeDz isEdge))
            ; a line's strokes are its tube (a filled head stays on the plate)
            def tube:boolean ((part > 0) && ((itemAt isEdge part) && ((c.kind == 7) && ((array_length c.pts) >= 4))))
            def stood:boolean ((top > 0) && ((tb.stand && (itemAt tb.stood k4)) || tube))
            if (((c.kind != 4) && (c.kind != 5)) && (stood == false)) {
                def step:int (PresFlightScene.stepOf(s rest.groupOfCmd k4))
                def node:boolean ((part > 0) && ((itemAt isEdge part) == false))
                def key:int (((? node part top) * 1000) + step)
                def at:int (indexOf keys key)
                if (at < 0) {
                    push keys key
                    def pt:FlightItem (new FlightItem())
                    pt.kind = "plate"
                    pt.station = i
                    pt.r = 1.0
                    pt.g = 1.0
                    pt.b = 1.0
                    pt.order = step
                    pt.sw = -1.0
                    if (top > 0) {
                        def te:PresEnt (itemAt sc.ents top)
                        pt.ent = te.id
                        pt.block = te.kind
                        if node {
                            def ne:PresEnt (itemAt sc.ents part)
                            pt.ent = ne.id
                            pt.block = "node"
                        }
                    } {
                        pt.ent = "slide"
                        pt.block = "ground"
                    }
                    push mine pt
                    push topsOf top
                    push dzOf (? node (itemAt nodeDz part) -1.0)
                    at = ((array_length mine) - 1)
                }
                def plate:FlightItem (itemAt mine at)
                push plate.cmds k4
                if ((strlen c.effectId) > 0) {
                    plate.live = true
                }
                if (PresFlightScene.shows(c)) {
                    PresFlightScene.growRect(plate (PresScene.boundsOf(c)))
                }
            }
            k4 = (k4 + 1)
        }
        ; in the order they come in: the ground, then by step, then down the
        ; slide
        def rank:int 0
        def p:int 0
        while (p < (array_length mine)) {
            def pl:FlightItem (itemAt mine p)
            if (pl.sw > 0.0) {
                PresFlightScene.padRect(pl pw ph)
                def dz:double 0.0
                if (pl.block != "ground") {
                    dz = (PresFlightScene.depthOf(pl.block))
                }
                if ((itemAt dzOf p) >= 0.0) {
                    dz = (itemAt dzOf p)
                }
                def at2:[double] (this.placeRect(st pl.sx pl.sy pl.sw pl.sh pw ph dz))
                pl.x = (itemAt at2 0)
                pl.y = (itemAt at2 1)
                pl.z = (itemAt at2 2)
                pl.w = (itemAt at2 3)
                pl.h = (itemAt at2 4)
                if (pl.block == "ground") {
                    pl.order = 0
                } {
                    ; a step's plates come in after the step before it
                    def within:int rank
                    if (within > 3) {
                        within = 3
                    }
                    pl.order = (1 + ((pl.order * 4) + within))
                    rank = (rank + 1)
                }
                pl.pl = (array_length plates)
                push items pl
                push plates pl
                def ptop:int (itemAt topsOf p)
                def pbars:FlightBars (itemAt barsOf ptop)
                if pbars.stand {
                    ; once, on the chart's first plate, just in front of it
                    this.standBars(st rest.list pbars (itemAt sc.ents ptop) (dz + 0.05) (pl.order + 1) pw ph)
                    set barsOf ptop (new FlightBars())
                }
            }
            p = (p + 1)
        }
        ; the diagrams' lines, from node to node
        e = 0
        while (e < nEnt) {
            if (itemAt isEdge e) {
                this.addTube(st sc rest.list e nodeDz isEdge pw ph rank)
            }
            e = (e + 1)
        }
    }

    ; The depth a diagram's node floats at, by its rank along the lines (a
    ; frame round nodes just in front of the diagram's own plate).
    sfn nodeDepth:double (s:PresSlide dia:PresEnt name:string) {
        def base:double (PresFlightScene.depthOf("diagram"))
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def du:PresDiaUse (itemAt s.diagrams k)
            if (du.srcStart == dia.src) {
                def d:PresDiagram du.diagram
                def rank:[int] (PresFlightScene.ranks(d))
                def i:int 0
                while (i < (array_length d.nodes)) {
                    def n:PresDNode (itemAt d.nodes i)
                    if (n.id == name) {
                        if n.group {
                            return (base + 0.3)
                        }
                        return ((base + 1.2) + ((PresFlightScene.layerZ((itemAt rank i))) * 0.8))
                    }
                    i = (i + 1)
                }
            }
            k = (k + 1)
        }
        return (base + 1.2)
    }

    ; how long a stroke is, slide px
    sfn strokeLength:double (c:EVGDrawCmd) {
        def total:double 0.0
        def q:int 1
        while (((q * 2) + 1) < (array_length c.pts)) {
            def dx:double ((itemAt c.pts (q * 2)) - (itemAt c.pts ((q - 1) * 2)))
            def dy:double ((itemAt c.pts ((q * 2) + 1)) - (itemAt c.pts (((q - 1) * 2) + 1)))
            total = (total + (sqrt(((dx * dx) + (dy * dy)))))
            q = (q + 1)
        }
        return total
    }

    ; The diagram's node or line entity `o` is part of (0: none).
    sfn partUp:int (sc:PresScene o:int nodeDz:[double] isEdge:[boolean]) {
        def at:int o
        def guard:int 0
        while ((at > 0) && (guard < 1000)) {
            if (((itemAt nodeDz at) >= 0.0) || (itemAt isEdge at)) {
                return at
            }
            def pe:PresEnt (itemAt sc.ents at)
            at = pe.parent
            guard = (guard + 1)
        }
        return 0
    }

    ; Line `e` of a diagram as a tube: its longest stroke as the slide draws
    ; it, each point at a depth between the nodes it joins, moved along the
    ; line from the station's eye so that from there it covers the stroke.
    fn addTube:void (st:FlightStation sc:PresScene list:EVGDisplayList e:int nodeDz:[double] isEdge:[boolean] pw:double ph:double order:int) {
        def best:int -1
        def most:double 0.0
        def strokes:int 0
        def head:boolean false
        def k:int 0
        while (k < (array_length list.cmds)) {
            def o:int 0
            if (k < (array_length sc.ownerOfCmd)) {
                o = (itemAt sc.ownerOfCmd k)
            }
            if ((PresFlightScene.partUp(sc o nodeDz isEdge)) == e) {
                def c:EVGDrawCmd (itemAt list.cmds k)
                if ((c.kind == 7) && ((array_length c.pts) >= 4)) {
                    strokes = (strokes + 1)
                    def len:double (PresFlightScene.strokeLength(c))
                    if (len > most) {
                        most = len
                        best = k
                    }
                }
            }
            k = (k + 1)
        }
        if (best < 0) {
            return
        }
        ; an arrow's head drawn as a stroke besides the line
        if (strokes > 1) {
            head = true
        }
        def ln:PresEnt (itemAt sc.ents e)
        def z0:double (PresFlightScene.depthOf("diagram"))
        def z1:double z0
        def m:int 0
        while (m < (array_length sc.ents)) {
            def ne:PresEnt (itemAt sc.ents m)
            if (((itemAt nodeDz m) >= 0.0) && ((ne.parent == ln.parent) && ((strlen ne.name) > 0))) {
                if (ne.name == ln.from) {
                    z0 = (itemAt nodeDz m)
                }
                if (ne.name == ln.to) {
                    z1 = (itemAt nodeDz m)
                }
            }
            m = (m + 1)
        }
        def c2:EVGDrawCmd (itemAt list.cmds best)
        def np:int (idiv (array_length c2.pts) 2)
        ; how far along the stroke each point is
        def run:[double]
        def total:double 0.0
        push run 0.0
        def q:int 1
        while (q < np) {
            def dx:double ((itemAt c2.pts (q * 2)) - (itemAt c2.pts ((q - 1) * 2)))
            def dy:double ((itemAt c2.pts ((q * 2) + 1)) - (itemAt c2.pts (((q - 1) * 2) + 1)))
            total = (total + (sqrt(((dx * dx) + (dy * dy)))))
            push run total
            q = (q + 1)
        }
        def top:int (PresFlightScene.topOf(sc e))
        def dia:PresEnt (itemAt sc.ents top)
        def lk:FlightItem (this.item("link" st.index 0.0 0.0 0.0))
        q = 0
        while (q < np) {
            def u:double (? (total > 0.0) ((itemAt run q) / total) 0.0)
            def at:[double] (this.placeRect(st (itemAt c2.pts (q * 2)) (itemAt c2.pts ((q * 2) + 1)) 0.0 0.0 pw ph (z0 + ((z1 - z0) * u))))
            push lk.pts (itemAt at 0)
            push lk.pts (itemAt at 1)
            push lk.pts (itemAt at 2)
            q = (q + 1)
        }
        ; as thick as drawn
        def unit:[double] (this.placeRect(st 0.0 0.0 pw ph pw ph z0))
        lk.w = (((itemAt unit 3) / pw) * c2.thickness) * 0.5
        if (lk.w < 0.015) {
            lk.w = 0.015
        }
        lk.head = head
        lk.r = ((to_double c2.r) / 255.0)
        lk.g = ((to_double c2.g) / 255.0)
        lk.b = ((to_double c2.b) / 255.0)
        lk.ent = dia.id
        lk.order = order
    }

    ; the entity under the slide that entity `o` is part of (0: the slide)
    sfn topOf:int (sc:PresScene o:int) {
        def at:int o
        def guard:int 0
        while ((at > 0) && (guard < 1000)) {
            def en:PresEnt (itemAt sc.ents at)
            if (en.parent <= 0) {
                return at
            }
            at = en.parent
            guard = (guard + 1)
        }
        return 0
    }

    ; The build step command k comes in with (0: with the slide).
    sfn stepOf:int (s:PresSlide groupOfCmd:[int] k:int) {
        if (k >= (array_length groupOfCmd)) {
            return 0
        }
        def g:int (itemAt groupOfCmd k)
        if ((g < 0) || (g >= (array_length s.groups))) {
            return 0
        }
        def gr:PresGroup (itemAt s.groups g)
        return gr.step
    }

    ; Whether a command puts anything on the slide.
    sfn shows:boolean (c:EVGDrawCmd) {
        if ((c.kind == 4) || (c.kind == 5)) {
            return false
        }
        if (c.a <= 0.01) {
            return false
        }
        if (c.kind == 3) {
            return ((strlen (trim c.text)) > 0)
        }
        if ((c.kind == 6) || (c.kind == 7)) {
            return ((array_length c.pts) >= 4)
        }
        return ((c.w > 0.0) && (c.h > 0.0))
    }

    ; A plate's rectangle (sx sy sw sh, sw < 0 none yet) grown by [x y w h].
    sfn growRect:void (it:FlightItem b:[double]) {
        def x:double (itemAt b 0)
        def y:double (itemAt b 1)
        def w:double (itemAt b 2)
        def h:double (itemAt b 3)
        if ((w < 0.0) || (h < 0.0)) {
            return
        }
        if (it.sw < 0.0) {
            it.sx = x
            it.sy = y
            it.sw = w
            it.sh = h
            return
        }
        def x1:double (it.sx + it.sw)
        def y1:double (it.sy + it.sh)
        if (x < it.sx) {
            it.sx = x
        }
        if (y < it.sy) {
            it.sy = y
        }
        if ((x + w) > x1) {
            x1 = (x + w)
        }
        if ((y + h) > y1) {
            y1 = (y + h)
        }
        it.sw = (x1 - it.sx)
        it.sh = (y1 - it.sy)
    }

    ; Room round a plate's ink for what draws past its box (a glyph's
    ; descender, a shadow, a glow), in whole pixels and on the slide.
    sfn padRect:void (it:FlightItem pw:double ph:double) {
        def pad:double 8.0
        def x0:double (to_double (floor (it.sx - pad)))
        def y0:double (to_double (floor (it.sy - pad)))
        def x1:double (to_double (ceil ((it.sx + it.sw) + pad)))
        def y1:double (to_double (ceil ((it.sy + it.sh) + pad)))
        if (it.block == "ground") {
            x0 = 0.0
            y0 = 0.0
            x1 = pw
            y1 = ph
        }
        if (x0 < 0.0) {
            x0 = 0.0
        }
        if (y0 < 0.0) {
            y0 = 0.0
        }
        if (x1 > pw) {
            x1 = pw
        }
        if (y1 > ph) {
            y1 = ph
        }
        it.sx = x0
        it.sy = y0
        it.sw = (x1 - x0)
        it.sh = (y1 - y0)
    }




    ; The station's camera framed on the whole slide: looking at its middle,
    ; back as far as its width or height needs (60 degrees up and down, a
    ; screen 1.6 times as wide), `rise` of that distance above it.
    fn frameSlide:void (st:FlightStation rise:double) {
        st.fx = st.x
        st.fy = st.y
        ; tan(30 degrees)
        def tn:double 0.57735
        def d:double ((frameH * 0.5) / tn)
        if (((frameW * 0.5) / (tn * 1.6)) > d) {
            d = ((frameW * 0.5) / (tn * 1.6))
        }
        st.dist = ((d * 1.08) + 0.6)
        st.lift = (st.dist * rise)
    }

    ; Plate pl as the page paints it: {"width", "height", "list"}, the list
    ; its commands (and every clip, which keeps them in order) and the
    ; slide's effects, moved so that its rectangle's corner is 0,0. "" for
    ; no such plate.
    fn plateJson:string (pl:int) {
        if ((pl < 0) || (pl >= (array_length plates))) {
            return ""
        }
        def it:FlightItem (itemAt plates pl)
        if ((it.station < 0) || (it.station >= (array_length rests))) {
            return ""
        }
        def src:EVGDisplayList (itemAt rests it.station)
        def out:EVGDisplayList (new EVGDisplayList())
        def j:int 0
        def k:int 0
        while (k < (array_length src.cmds)) {
            def c:EVGDrawCmd (itemAt src.cmds k)
            def own:boolean false
            if ((j < (array_length it.cmds)) && ((itemAt it.cmds j) == k)) {
                own = true
                j = (j + 1)
            }
            if ((own || (c.kind == 4)) || (c.kind == 5)) {
                push out.cmds c
            }
            k = (k + 1)
        }
        ; the effects its commands run
        PresDeck.appendFx(out src)
        out.setView((0.0 - it.sx) (0.0 - it.sy) 1.0)
        return ("{\"width\":" + (EVGDisplayList.num(it.sw)) + ",\"height\":" + (EVGDisplayList.num(it.sh)) + ",\"list\":" + (out.toJson()) + "}")
    }

    fn station:FlightStation (i:int title:string) {
        def st:FlightStation (new FlightStation())
        st.index = i
        st.title = title
        st.x = (PresFlightScene.stationX(i))
        st.y = (PresFlightScene.stationY(i))
        st.z = (PresFlightScene.stationZ(i))
        st.fx = st.x
        st.fy = st.y
        push stations st
        return st
    }

    fn item:FlightItem (kind:string station:int x:double y:double z:double) {
        def it:FlightItem (new FlightItem())
        it.kind = kind
        it.station = station
        it.x = x
        it.y = y
        it.z = z
        it.r = acR
        it.g = acG
        it.b = acB
        push items it
        return it
    }




    ; ---- diagrams ------------------------------------------------------------

    ; Each node's step from the diagram's start (its rank along the lines):
    ; nodes one line apart stand at different depths.
    sfn ranks:[int] (d:PresDiagram) {
        def nn:int (array_length d.nodes)
        def rank:[int]
        def i:int 0
        while (i < nn) {
            push rank 0
            i = (i + 1)
        }
        ; relax along the lines; a loop stops growing after nn rounds
        def round:int 0
        def moved:boolean true
        while (moved && (round < nn)) {
            moved = false
            def e:int 0
            while (e < (array_length d.edges)) {
                def ed:PresDEdge (itemAt d.edges e)
                if ((ed.from >= 0) && ((ed.to >= 0) && ((ed.from < nn) && (ed.to < nn)))) {
                    def want:int ((itemAt rank ed.from) + 1)
                    if ((want > (itemAt rank ed.to)) && (want < nn)) {
                        set rank ed.to want
                        moved = true
                    }
                }
                e = (e + 1)
            }
            round = (round + 1)
        }
        return rank
    }

    ; The depth a rank floats at: three layers, front to back and back again.
    sfn layerZ:double (rank:int) {
        def m:int (rank - ((idiv rank 3) * 3))
        return ((to_double (m - 1)) * 1.0)
    }







    ; ---- charts --------------------------------------------------------------

    ; A chart is its own drawing, a plate like any block (its axes, ticks,
    ; names, legend in its own colours), with its bars stood up as boxes on
    ; the bars it draws: each box's face covers its bar from the station's
    ; eye, in the bar's colour, and grows from the chart's base line. Only
    ; bars that rest on the base line or on each other stand (a box plot's
    ; boxes float: they stay on the plate).
    ; The bars of a chart, `bars` its bar parts (entities): each one's
    ; body (its largest fill), cap (the largest solid fill besides, -1 for
    ; none) and the commands the box stands for (the body, the cap and what
    ; is drawn on the body).
    sfn barsOf:FlightBars (list:EVGDisplayList ownerOf:[int] bars:[int]) {
        def fb:FlightBars (new FlightBars())
        def n:int (array_length bars)
        def nc:int (array_length list.cmds)
        def j:int 0
        while (j < n) {
            def best:double -1.0
            def bodyAt:int -1
            def k:int 0
            while (k < nc) {
                if ((k < (array_length ownerOf)) && ((itemAt ownerOf k) == (itemAt bars j))) {
                    def c:EVGDrawCmd (itemAt list.cmds k)
                    if ((c.kind == 0) && ((c.w * c.h) > best)) {
                        best = (c.w * c.h)
                        bodyAt = k
                    }
                }
                k = (k + 1)
            }
            push fb.body bodyAt
            def capBest:double -1.0
            def capAt:int -1
            k = 0
            while (k < nc) {
                if (((k < (array_length ownerOf)) && ((itemAt ownerOf k) == (itemAt bars j))) && (k != bodyAt)) {
                    def c2:EVGDrawCmd (itemAt list.cmds k)
                    if (((c2.kind == 0) && (c2.a >= 0.5)) && ((c2.w * c2.h) > capBest)) {
                        capBest = (c2.w * c2.h)
                        capAt = k
                    }
                }
                k = (k + 1)
            }
            push fb.cap capAt
            j = (j + 1)
        }
        ; every bar has a body: bars across share their left (or right)
        ; end, columns their base
        def ok:boolean (n > 0)
        fb.across = (n > 1)
        j = 0
        while (j < n) {
            if ((itemAt fb.body j) < 0) {
                ok = false
            } {
                def bj:EVGDrawCmd (itemAt list.cmds (itemAt fb.body j))
                def b0:EVGDrawCmd (itemAt list.cmds (itemAt fb.body 0))
                if (((fabs (bj.x - b0.x)) > 1.0) && ((fabs ((bj.x + bj.w) - (b0.x + b0.w))) > 1.0)) {
                    fb.across = false
                }
            }
            j = (j + 1)
        }
        if (ok == false) {
            return fb
        }
        def rx:[double]
        def ry:[double]
        def rw:[double]
        def rh:[double]
        j = 0
        while (j < n) {
            def bb:EVGDrawCmd (itemAt list.cmds (itemAt fb.body j))
            push rx bb.x
            push ry bb.y
            push rw bb.w
            push rh bb.h
            j = (j + 1)
        }
        fb.base = (PresFlightScene.sharedEdge(rx ry rw rh fb.across))
        ; each bar rests on the base line, or end to end on another one
        j = 0
        while (j < n) {
            def lo:double (? fb.across (itemAt rx j) (itemAt ry j))
            def hi:double (? fb.across ((itemAt rx j) + (itemAt rw j)) ((itemAt ry j) + (itemAt rh j)))
            def rests:boolean (((fabs (lo - fb.base)) <= 1.0) || ((fabs (hi - fb.base)) <= 1.0))
            def i2:int 0
            while ((i2 < n) && (rests == false)) {
                if (i2 != j) {
                    def lo2:double (? fb.across (itemAt rx i2) (itemAt ry i2))
                    def hi2:double (? fb.across ((itemAt rx i2) + (itemAt rw i2)) ((itemAt ry i2) + (itemAt rh i2)))
                    if (((fabs (lo - hi2)) <= 1.0) || ((fabs (hi - lo2)) <= 1.0)) {
                        rests = true
                    }
                }
                i2 = (i2 + 1)
            }
            if (rests == false) {
                ok = false
            }
            j = (j + 1)
        }
        fb.stand = ok
        if (ok == false) {
            return fb
        }
        ; the commands the boxes stand for
        def k3:int 0
        while (k3 < nc) {
            push fb.stood false
            k3 = (k3 + 1)
        }
        j = 0
        while (j < n) {
            set fb.stood (itemAt fb.body j) true
            if ((itemAt fb.cap j) >= 0) {
                set fb.stood (itemAt fb.cap j) true
            }
            def k4:int 0
            while (k4 < nc) {
                if ((k4 < (array_length ownerOf)) && ((itemAt ownerOf k4) == (itemAt bars j))) {
                    def c4:EVGDrawCmd (itemAt list.cmds k4)
                    def bx:[double] (PresScene.boundsOf(c4))
                    if (((c4.kind != 3) && ((itemAt bx 0) >= ((itemAt rx j) - 1.5))) && (((((itemAt bx 0) + (itemAt bx 2)) <= (((itemAt rx j) + (itemAt rw j)) + 1.5)) && ((itemAt bx 1) >= ((itemAt ry j) - 1.5))) && (((itemAt bx 1) + (itemAt bx 3)) <= (((itemAt ry j) + (itemAt rh j)) + 1.5)))) {
                        set fb.stood k4 true
                    }
                }
                k4 = (k4 + 1)
            }
            j = (j + 1)
        }
        return fb
    }

    fn standBars:void (st:FlightStation list:EVGDisplayList fb:FlightBars chart:PresEnt dz:double order0:int pw:double ph:double) {
        def j:int 0
        while (j < (array_length fb.body)) {
            def bc:EVGDrawCmd (itemAt list.cmds (itemAt fb.body j))
            if (bc.w > 0.0) {
                ; the box stands out of the chart's plate towards the eye, its
                ; face where the bar is drawn
                def on:[double] (this.placeRect(st bc.x bc.y bc.w bc.h pw ph dz))
                def deep:double ((? fb.across (itemAt on 4) (itemAt on 3)) * 0.6)
                if (deep > 1.2) {
                    deep = 1.2
                }
                def at:[double] (this.placeRect(st bc.x bc.y bc.w bc.h pw ph (dz + deep)))
                def bar:FlightItem (this.item("bar" st.index (itemAt at 0) (itemAt at 1) 0.0))
                bar.w = (itemAt at 3)
                bar.h = (itemAt at 4)
                bar.d = deep
                bar.z = ((itemAt at 2) - (bar.d * 0.5))
                bar.r = ((to_double bc.r) / 255.0)
                bar.g = ((to_double bc.g) / 255.0)
                bar.b = ((to_double bc.b) / 255.0)
                bar.ent = chart.id
                if ((itemAt fb.cap j) >= 0) {
                    def cp:EVGDrawCmd (itemAt list.cmds (itemAt fb.cap j))
                    bar.capR = ((to_double cp.r) / 255.0)
                    bar.capG = ((to_double cp.g) / 255.0)
                    bar.capB = ((to_double cp.b) / 255.0)
                }
                bar.order = (order0 + j)
                bar.across = fb.across
                if fb.across {
                    ; from the end on the base line
                    def left:boolean ((fabs (bc.x - fb.base)) <= ((fabs ((bc.x + bc.w) - fb.base)) + 0.5))
                    bar.base = (? left (bar.x - (bar.w * 0.5)) (bar.x + (bar.w * 0.5)))
                } {
                    def down:boolean ((fabs ((bc.y + bc.h) - fb.base)) <= ((fabs (bc.y - fb.base)) + 0.5))
                    bar.base = (? down (bar.y - (bar.h * 0.5)) (bar.y + (bar.h * 0.5)))
                }
            }
            j = (j + 1)
        }
    }

    ; Whether the chart at entity `en` draws bars (a box plot's boxes are
    ; rectangles too, but no bars).
    sfn barMarks:boolean (s:PresSlide en:PresEnt) {
        def k:int 0
        while (k < (array_length s.charts)) {
            def cu:PresChartUse (itemAt s.charts k)
            if (cu.srcStart == en.src) {
                return (((indexOf cu.source "\"bar\"") >= 0) && ((indexOf cu.source "\"boxplot\"") < 0))
            }
            k = (k + 1)
        }
        return false
    }

    ; The edge (slide units) most of the bars share: their base line, the
    ; left end for bars across, the bottom for columns (a negative one
    ; hangs from it by its top).
    sfn sharedEdge:double (rx:[double] ry:[double] rw:[double] rh:[double] across:boolean) {
        def edges:[double]
        def j:int 0
        while (j < (array_length rx)) {
            if across {
                push edges (itemAt rx j)
                push edges ((itemAt rx j) + (itemAt rw j))
            } {
                push edges ((itemAt ry j) + (itemAt rh j))
                push edges (itemAt ry j)
            }
            j = (j + 1)
        }
        def best:double (itemAt edges 0)
        def most:int 0
        def a:int 0
        while (a < (array_length edges)) {
            def cnt:int 0
            def b:int 0
            while (b < (array_length edges)) {
                if ((fabs ((itemAt edges a) - (itemAt edges b))) <= 1.0) {
                    cnt = (cnt + 1)
                }
                b = (b + 1)
            }
            if (cnt > most) {
                most = cnt
                best = (itemAt edges a)
            }
            a = (a + 1)
        }
        return best
    }

    ; ---- out -----------------------------------------------------------------

    fn toJson:string () {
        def o:JVal (JVal.mkObj())
        def st:JVal (JVal.mkArr())
        def i:int 0
        while (i < (array_length stations)) {
            def s:FlightStation (itemAt stations i)
            st.add((s.toJson()))
            i = (i + 1)
        }
        o.set("stations" st)
        def it:JVal (JVal.mkArr())
        i = 0
        while (i < (array_length items)) {
            def f:FlightItem (itemAt items i)
            it.add((f.toJson()))
            i = (i + 1)
        }
        o.set("items" it)
        return (o.toJson())
    }

    ; how many items of a kind (for the checks)
    fn count:int (kind:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length items)) {
            def f:FlightItem (itemAt items i)
            if (f.kind == kind) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }
}
