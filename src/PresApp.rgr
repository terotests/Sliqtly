            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "menu") {
            dd.menuOpen = (! dd.menuOpen)
            dd.zoomOpen = false
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "none") {
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "all") {
            dd.uiNow = deck.uiNow
            dd.showEverything()
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "tour") {
            this.toggleTour(k)
            return true
        }
        if (what == "restart") {
            dd.restart()
            PresTimeline.plan((deck.slideAt(selected)))
            localT = du.start
            if (localT < 0.0) {
                localT = 0.0
            }
            this.play()
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "zin") {
            dd.zoomBy(1.4)
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "zout") {
            dd.zoomBy((1.0 / 1.4))
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "fit") {
            dd.zoomOpen = (! dd.zoomOpen)
            dd.menuOpen = false
            chromeRev = (chromeRev + 1)
            return true
        }
        if (((strlen what) > 4) && ((substring what 0 4) == "zoom")) {
            def zp@(optional):int (str2int (substring what 4 (strlen what)))
            dd.zoomTo(((to_double (?? zp 100)) / 100.0))
            chromeRev = (chromeRev + 1)
            return true
        }
        if (((strlen what) > 3) && ((substring what 0 3) == "way")) {
            def wi@(optional):int (str2int (substring what 3 (strlen what)))
            dd.exGo((?? wi -1) (du.activeTime((this.stageTime()) deck.uiNow)))
            chromeRev = (chromeRev + 1)
            return true
        }
        if (((strlen what) > 4) && ((substring what 0 4) == "node")) {
            def ni@(optional):int (str2int (substring what 4 (strlen what)))
            dd.explore((?? ni -1))
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "back") {
