    ; --- accessibility: the canvas as a tree the page mirrors into DOM ------------
    fn setA11yFocus:void (id:string) {
        a11yFocus = id
    }

    fn a11yJson:string () {
        def t (new EVGA11yTree())
        a11yGen = (a11yGen + 1)
        t.generation = a11yGen
        def root:EVGA11yNode (t.group("app" "" appName))
        t.place(root 0 0 (to_int W) (to_int H))
        def n:int (deck.slideCount())
        def shown:int (this.slideShown())
        def title:string ""
        if ((shown >= 0) && (shown < n)) {
            def cur:PresSlide (deck.slideAt(shown))
            title = cur.title
        }
        def where:string ((PresI18n.t("Slide ")) + (to_string (shown + 1)) + " / " + (to_string n) + ": " + title)
        if (mode != "present") {
            if (barH > 0.0) {
                def bar:EVGA11yNode (t.node("bar" "app" (EVGA11yRole.toolbar())))
                bar.name = (PresI18n.t("Toolbar"))
                t.place(bar 0 0 (to_int W) (to_int barH))
                PresA11y.addHost(t toolbar.host "bar")
            }
            if ((edRect.w > 0.0) && (!null? chromeRoot)) {
                def page:EVGElement (unwrap chromeRoot)
                def tl:EVGA11yNode (t.node("edtabs" "app" (EVGA11yRole.tabList())))
                tl.name = (PresI18n.t("Editor"))
                t.place(tl (to_int tabRect.x) (to_int tabRect.y) (to_int tabRect.w) (to_int tabRect.h))
                this.a11yTab(t page "md" "Markdown")
                this.a11yTab(t page "css" (PresI18n.t("Theme (CSS)")))
                this.a11yTab(t page "files" (PresI18n.t("Files")))
            }
            if (!null? chromeRoot) {
                def page2:EVGElement (unwrap chromeRoot)
                def list:EVGA11yNode (t.node("slides" "app" (EVGA11yRole.list())))
                list.name = (PresI18n.t("Slides"))
                t.place(list (to_int stripRect.x) (to_int stripRect.y) (to_int stripRect.w) (to_int stripRect.h))
                def i:int 0
                while (i < n) {
                    def s:PresSlide (deck.slideAt(i))
                    def el@(optional):EVGElement (PresA11y.find(page2 ("thumb" + (to_string i))))
                    if (!null? el) {
                        def e:EVGElement (unwrap el)
                        def b:EVGA11yNode (t.button(("thumb-" + (to_string i)) "slides" ((PresI18n.t("Slide ")) + (to_string (i + 1)) + ": " + s.title)))
                        b.selected = (i == selected)
                        PresA11y.placeAt(b e)
                    }
                    i = (i + 1)
                }
            }
        }
        def stage:EVGA11yNode (t.node("stage" "app" (EVGA11yRole.region())))
        stage.name = where
        t.place(stage (to_int slideRect.x) (to_int slideRect.y) (to_int slideRect.w) (to_int slideRect.h))
        def lines:[string] (this.slideWords(shown))
        def k:int 0
        while (k < (array_length lines)) {
            def ln:EVGA11yNode (t.label(("stage-" + (to_string k)) "stage" (itemAt lines k)))
            t.place(ln (to_int slideRect.x) (to_int slideRect.y) (to_int slideRect.w) 1)
            k = (k + 1)
        }
        if (mode != "present") {
            if (panels.any()) {
                PresA11y.addHost(t panels.host "app")
                if (panels.helpOpen && (!null? panels.host.lastPage)) {
                    def pp:EVGElement (unwrap panels.host.lastPage)
                    def h:int 0
                    while (h < (array_length panels.helpKeys)) {
                        def parts:[string] (strsplit (itemAt panels.helpKeys h) (strfromcode 9))
                        PresA11y.buttonAt(t pp ("pn-prop-" + (to_string h)) "app" ((itemAt parts 0) + " { " + (itemAt parts 1) + " }"))
                        h = (h + 1)
                    }
                }
            }
            if hint.isOpen {
                def hn:EVGA11yNode (t.node("hint" "app" (EVGA11yRole.dialog())))
                hn.name = (hint.name + ": " + hint.value)
                hn.description = hint.doc
                t.place(hn 0 0 (to_int W) (to_int H))
                PresA11y.addHost(t hint.host "hint")
                if ((hint.kind == "selector") && (!null? hint.host.lastPage)) {
                    def hp:EVGElement (unwrap hint.host.lastPage)
                    def props:VlJson (hint.rule.get("props"))
                    def q:int 0
                    while (q < (props.count())) {
                        def pj:VlJson (props.at(q))
                        PresA11y.buttonAt(t hp ("hp-prop-" + (to_string q)) "hint" ((pj.stringOr("name" "")) + " " + (pj.stringOr("value" (PresI18n.t("add"))))))
                        q = (q + 1)
                    }
                }
            }
            if chart.isOpen {
                def cn:EVGA11yNode (t.node("chart" "app" (EVGA11yRole.dialog())))
                cn.name = (PresI18n.t("Chart settings"))
                t.place(cn 0 0 (to_int W) (to_int H))
                PresA11y.addHost(t chart.host "chart")
            }
        }
        def st:EVGA11yNode (t.statusRegion("announce" "app" where))
        t.place(st 0 0 1 1)
        if (t.has(a11yFocus)) {
            t.setFocus(a11yFocus)
        }
        return (t.toJson())
    }

    fn a11yTab:void (t:EVGA11yTree page:EVGElement v:string name:string) {
        def id:string (tabs.tabTid(v))
        def el@(optional):EVGElement (PresA11y.find(page id))
        if (null? el) {
            return
        }
        def n:EVGA11yNode (t.node(id "edtabs" (EVGA11yRole.tab())))
        n.name = name
        n.focusable = true
        n.actActivate = true
        n.selected = (v == edTab)
        PresA11y.placeAt(n (unwrap el))
    }

    ; The slide's words for a reader: its source without the notes, the
    ; attribute blocks and the insides of fenced blocks.
    fn slideWords:[string] (i:int) {
        def out:[string]
        if ((i < 0) || (i >= (deck.slideCount()))) {
            return out
        }
        def s:PresSlide (deck.slideAt(i))
        def src:string deck.text
        if (((s.srcStart < 0) || (s.srcEnd <= s.srcStart)) || (s.srcEnd > (strlen src))) {
            push out s.title
            return out
        }
        def lines:[string] (strsplit (substring src s.srcStart s.srcEnd) (strfromcode 10))
        def inNotes:boolean false
        def inFence:boolean false
        def k:int 0
        while (k < (array_length lines)) {
            def l:string (trim (itemAt lines k))
            if ((indexOf l "```") == 0) {
                if (inFence == false) {
                    push out (PresI18n.t("[chart or code]"))
                }
                inFence = (inFence == false)
            } {
                if ((indexOf l ":::") == 0) {
                    inNotes = ((indexOf l "notes") > 0)
                } {
                    if (((inNotes == false) && (inFence == false)) && ((strlen l) > 0)) {
                        def w:string l
                        while ((indexOf w "#") == 0) {
                            w = (trim (substring w 1 (strlen w)))
                        }
                        def brace:int (indexOf w "{")
                        if (brace >= 0) {
                            w = (trim (substring w 0 brace))
                        }
                        if ((strlen w) > 0) {
                            push out w
                        }
                    }
                }
            }
            k = (k + 1)
        }
        return out
    }

    ; A slider moved from the keyboard: `delta` steps.
    fn a11ySlide:boolean (id0:string delta:int) {
        ; the focusable node is the slider's thumb
        def id:string id0
        if ((strlen id) > 6) {
            if ((substring id ((strlen id) - 6) (strlen id)) == "-thumb") {
                id = (substring id 0 ((strlen id) - 6))
            }
        }
        if (hint.isOpen && (id == hint.slider.tid)) {
            def v:int (hint.slider.value + delta)
            if (v < hint.slider.minValue) { v = hint.slider.minValue }
            if (v > hint.slider.maxValue) { v = hint.slider.maxValue }
            hint.slider.value = v
            hint.takeSlider()
            hint.rebuild()
            this.afterHint()
            return true
        }
        if chart.isOpen {
            def i:int 0
            while (i < (array_length chart.sliders)) {
                def c:SliderCtl (itemAt chart.sliders i)
                if (c.tid == id) {
                    def v2:int (c.value + (delta * c.step))
                    if (v2 < c.minValue) { v2 = c.minValue }
                    if (v2 > c.maxValue) { v2 = c.maxValue }
                    c.value = v2
                    chart.takeSliders()
                    chart.rebuild()
                    this.writeChart()
                    chromeRev = (chromeRev + 1)
                    return true
                }
                i = (i + 1)
            }
        }
        return false
    }

    ; --- files the charts read --------------------------------------------------
    ; The page fetches what `chartDataWanted` lists (one url per line) and
    ; hands each over; the charts on it are drawn again.
    fn chartDataWanted:string () {
        return (deck.chartDataWanted())
    }

    fn clearChartData:void () {
        deck.clearChartData()
    }

    fn setChartData:void (url:string body:string) {
        deck.setChartData(url body)
        ; the slides are new objects: timed again, or every one lasts 0 s
        ; and its charts stay at the start of their animation
        PresTimeline.planAll(deck)
        chromeRev = (chromeRev + 1)
    }

    ; --- the chart settings editor ----------------------------------------------
    fn setChartCss:void (css:string) {
        chart.css = css
    }

    sfn isChartFence:boolean (t:string) {
        def s:string (trim t)
        if (((strlen s) < 3) || ((substring s 0 3) != "```")) {
            return false
        }
        def lang:string (trim (substring s 3 (strlen s)))
        return (((indexOf lang "vega-lite") == 0) || ((indexOf lang "vegalite") == 0))
    }

    ; Open the editor on the ```vega-lite fence at or around `line`. False
    ; when there is none there.
    fn openChartEditor:boolean (line:int) {
        if (mode == "present") {
            return false
        }
        this.showTab("md")
        def n:int (mdEditor.buf.lineCount())
        def start:int -1
        def i:int line
        if (i >= n) {
            i = (n - 1)
        }
        while ((i >= 0) && (start < 0)) {
            def t:string (mdEditor.buf.lineAt(i))
            if (PresApp.isChartFence(t)) {
                start = i
            } {
                if ((i < line) && ((indexOf (trim t) "```") == 0)) {
                    ; a fence closes above the line: it is not in a chart
                    i = -1
                }
            }
            i = (i - 1)
        }
        if (start < 0) {
            return false
        }
        def end:int -1
        def k:int (start + 1)
        while ((k < n) && (end < 0)) {
            if ((indexOf (trim (mdEditor.buf.lineAt(k))) "```") == 0) {
                end = k
            }
            k = (k + 1)
        }
        if (end < 0) {
            return false
        }
        chartStart = start
        chartEnd = end
        def body:string ""
        def b:int (start + 1)
        while (b < end) {
            body = (body + (mdEditor.buf.lineAt(b)) + "\n")
            b = (b + 1)
        }
        ; a fence naming a chart file: the file's spec is what is edited, and
        ; what is written back
        chartFile = (MdVegaRender.specFile(body))
        if ((strlen chartFile) > 0) {
            body = (MdVegaRender.fromFile(body deck.dataUrls deck.dataTexts))
        }
        def m:PresChartModel (PresChartModel.fromSpec(body))
        this.place()
        ; where the window was left, or over the Markdown beside the slide
        if (chartWinX < 0.0) {
            chartWinX = (edRect.x + 12.0)
            chartWinY = (edRect.y + 8.0)
        }
        if (chartWinX > (W - 120.0)) {
            chartWinX = (W - 120.0)
        }
        if (chartWinY > (H - 60.0)) {
            chartWinY = (H - 60.0)
        }
        chart.measurer = measurer
        chart.open(m chartWinX chartWinY W H)
        ; the slide the chart is on, beside it
        this.selectSlide((deck.pageOfOffset((this.offsetOf(start 0)))))
        mdEditor.sel.setCaret(start 0)
        mdEditor.sel.collapseToCaret()
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; --- a picture's settings (the same window, in its image mode) ------------------
    ; The picture on Markdown line `line` (`![alt](path)` alone on it).
    fn openImageEditor:boolean (line:int) {
        def n:int (mdEditor.buf.lineCount())
        if ((line < 0) || (line >= n)) {
            return false
        }
        def t:string (mdEditor.buf.lineAt(line))
        def attr:string ""
        def attrLine:int -1
        if ((line + 1) < n) {
            def next:string (mdEditor.buf.lineAt((line + 1)))
            if (PresImageModel.isAttrLine(next)) {
                attr = next
                attrLine = (line + 1)
            }
        }
        def m:PresImageModel (PresImageModel.read(t attr))
        if ((m.ok()) == false) {
            return false
        }
        m.line = line
        m.attrLine = attrLine
        this.place()
        if (chartWinX < 0.0) {
            chartWinX = (edRect.x + 12.0)
            chartWinY = (edRect.y + 8.0)
        }
        if (chartWinX > (W - 120.0)) {
            chartWinX = (W - 120.0)
        }
        if (chartWinY > (H - 60.0)) {
            chartWinY = (H - 60.0)
        }
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
        chart.openImage(m chartWinX chartWinY W H)
        this.selectSlide((deck.pageOfOffset((this.offsetOf(line 0)))))
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The picture on the caret's line, when the Markdown tab shows.
    fn openImageAtCaret:boolean () {
        if (edTab != "md") {
            return false
        }
        return (this.openImageEditor(mdEditor.sel.caret.line))
    }

    ; The picture under a point of the stage.
    fn openImageAt:boolean (x:double y:double) {
        this.slidePoint(x y)
        def l:MdLayout (deck.layout())
        def k:int 0
        while (k < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes k)
            if (((b.page == selected) && (b.kind == 4)) && (b.srcStart >= 0)) {
                if (((spX >= b.x) && (spX <= (b.x + b.w))) && ((spY >= b.y) && (spY <= (b.y + b.h)))) {
                    this.posOf((mdEditor.text()) b.srcStart)
                    if (this.openImageEditor(posLine)) {
                        return true
                    }
                }
            }
            k = (k + 1)
        }
        return false
    }

    ; Lines `from`..`to` of the Markdown replaced with `text` ("" takes them
    ; out), as one edit.
    fn replaceLines:void (from:int to:int text:string) {
        def keep:ScriptEditor editor
        editor = mdEditor
        def n:int (mdEditor.buf.lineCount())
        mdEditor.moveCaret(from 0 false)
        if ((to + 1) < n) {
            mdEditor.moveCaret((to + 1) 0 true)
            if ((strlen text) > 0) {
                mdEditor.insert((text + "\n"))
            } {
                mdEditor.insert("")
            }
        } {
            mdEditor.moveCaret(to (strlen (mdEditor.buf.lineAt(to))) true)
            mdEditor.insert(text)
        }
        mdEditor.sel.collapseToCaret()
        editor = keep
        bufSynced = mdEditor.buf.version
        this.rebuildDeck()
    }

    ; The picture's lines rewritten from the window's model.
    fn writeImage:void () {
        def m:PresImageModel chart.img
        if (m.line < 0) {
            return
        }
        def last:int m.line
        if (m.attrLine >= 0) {
            last = m.attrLine
        }
        def text:string (m.markdown())
        this.replaceLines(m.line last text)
        if ((indexOf text "\n") > 0) {
            m.attrLine = (m.line + 1)
        } {
            m.attrLine = -1
        }
    }

    ; What the window asked of the picture once it closed: to be taken out, or
    ; to become the slide's or every slide's background.
    fn imageAfterClose:void () {
        def m:PresImageModel chart.img
        def bg:string chart.wantsBg
        def rm:boolean chart.wantsRemove
        chart.wantsBg = ""
        chart.wantsRemove = false
        if ((((strlen bg) == 0) && (rm == false)) || (m.line < 0)) {
            return
        }
        def last:int m.line
        if (m.attrLine >= 0) {
            last = m.attrLine
        }
        def head:int -1
        if (bg == "slide") {
            ; the slide's heading: the nearest one above the picture
            def k:int m.line
            while ((k >= 0) && (head < 0)) {
                if ((indexOf (mdEditor.buf.lineAt(k)) "#") == 0) {
                    head = k
                }
                k = (k - 1)
            }
        }
        this.replaceLines(m.line last "")
        if (bg == "slide") {
            if (head >= 0) {
                this.replaceLines(head head (PresApp.withAttr((mdEditor.buf.lineAt(head)) "bg" m.path)))
            }
        }
        if (bg == "all") {
            this.cssSet("page" "background-image" ("url(" + m.path + ")"))
        }
        m.line = -1
    }

    ; A heading line with `key=value` in its `{…}` (replacing the key's old
    ; value), or a new `{key=value}` after it.
    sfn withAttr:string (line:string key:string value:string) {
        def t:string line
        def n:int (strlen t)
        def open:int (PresApp.lastIndexOf(t " {"))
        if (((open > 0) && (n > 0)) && ((charAt t (n - 1)) == 125)) {
            def inner:string (substring t (open + 2) (n - 1))
            def words:[string] (strsplit inner " ")
            def out:string (key + "=" + value)
            def i:int 0
            while (i < (array_length words)) {
                def w:string (trim (itemAt words i))
                if (((strlen w) > 0) && ((indexOf w (key + "=")) != 0)) {
                    out = (out + " " + w)
                }
                i = (i + 1)
            }
            return ((substring t 0 open) + " {" + out + "}")
        }
        return (t + " {" + key + "=" + value + "}")
    }

    sfn lastIndexOf:int (t:string what:string) {
        def at:int -1
        def from:int (indexOf t what)
        while (from >= 0) {
            at = from
            from = (indexOfFrom t what (from + 1))
        }
        return at
    }

    ; One property of one theme rule set to `value`, the rule made when there
    ; is none; the slides follow.
    fn cssSet:void (sel:string prop:string value:string) {
        def was:string edTab
        this.helpEdit(sel prop value)
        def ed:ScriptEditor cssEditor
        def ln:int ed.sel.caret.line
        def col:int ed.sel.caret.col
        def lt:string (ed.buf.lineAt(ln))
        def end:int (indexOfFrom lt ";" col)
        if (end < 0) {
            end = (strlen lt)
        }
        if ((substring lt col end) != value) {
            ed.moveCaret(ln col false)
            ed.moveCaret(ln end true)
            ed.insert(value)
            this.syncEditor()
        }
        this.showTab(was)
    }

    ; The chart under a point of the stage, opened in the editor.
    fn openChartAt:boolean (x:double y:double) {
        this.slidePoint(x y)
        def l:MdLayout (deck.layout())
        def boxes:[int] (deck.chartBoxes(selected))
        def k:int 0
        while (k < (array_length boxes)) {
            def b:MdBox (itemAt l.boxes (itemAt boxes k))
            if ((((spX >= b.x) && (spX <= (b.x + b.w))) && ((spY >= b.y) && (spY <= (b.y + b.h)))) && (b.srcStart >= 0)) {
                this.posOf((mdEditor.text()) b.srcStart)
                return (this.openChartEditor(posLine))
            }
            k = (k + 1)
        }
        return false
    }

    fn closeChart:void () {
        this.writeChart()
        chartWinX = chart.x
        chartWinY = chart.y
        chart.close()
        focus = "editor"
        chromeRev = (chromeRev + 1)
    }

    fn chartIsOpen:boolean () {
        return chart.isOpen
    }

    ; What a routed input asked for, and the fence rewritten when the model
    ; changed.
    fn afterChart:void () {
        if chart.wantsFresh {
            chart.wantsFresh = false
            def fresh:PresChartModel (PresChartModel.sample())
            chart.model = fresh
            chart.changed = true
            chart.rebuild()
        }
        ; a drag in the picker writes the fence when it ends, not at every move
        if ((chart.dragging()) == false) {
            this.writeChart()
        }
        if chart.wantsClose {
            chart.wantsClose = false
            this.closeChart()
            if (chart.mode == "image") {
                this.imageAfterClose()
            }
        }
        ; the chart's data file, in the files tab's editor
        if ((strlen chart.wantsFile) > 0) {
            def f:string (MdVegaRender.bareUrl(chart.wantsFile))
            chart.wantsFile = ""
            push requests ("files:open:" + f)
        }
        chromeRev = (chromeRev + 1)
    }

    ; The writes of one drag as one undo step. Each replaced the whole fence
    ; body from the same place, so the first write's removed text and the
    ; last one's inserted text are the whole change.
    fn mergeChartUndo:void () {
        if (chartUndoBase < 0) {
            return
        }
        def st:[EditorUndoOp] mdEditor.buf.undoStack
        def n:int (array_length st)
        if (n <= (chartUndoBase + 1)) {
            return
        }
        def first:EditorUndoOp (itemAt st chartUndoBase)
        def last:EditorUndoOp (itemAt st (n - 1))
        first.inserted = last.inserted
        first.endLine = last.endLine
        first.endCol = last.endCol
        while ((array_length st) > (chartUndoBase + 1)) {
            removeLast st
        }
    }

    ; The fence's body replaced with the model's specification, as one edit.
    fn writeChart:void () {
        if (chart.changed == false) {
            return
        }
        chart.changed = false
        if (chart.mode == "image") {
            this.writeImage()
            return
        }
        def spec:string (chart.model.toSpec())
        if (((strlen spec) == 0) || (chartStart < 0)) {
            return
        }
        if ((strlen chartFile) > 0) {
            ; the chart's own file changes, the fence that names it does not
            chartFileText = spec
            this.setChartData(chartFile spec)
            push requests ("chart-file:" + chartFile)
            return
        }
        def was:string edTab
        def keep:ScriptEditor editor
        editor = mdEditor
        mdEditor.moveCaret((chartStart + 1) 0 false)
        mdEditor.moveCaret(chartEnd 0 true)
        mdEditor.insert((spec + "\n"))
        chartEnd = ((chartStart + 1) + (array_length (strsplit spec "\n")))
        mdEditor.moveCaret(chartStart 0 false)
        mdEditor.sel.collapseToCaret()
        editor = keep
        edTab = was
        bufSynced = mdEditor.buf.version
        this.rebuildDeck()
    }

    ; The editor as a display list, placed on the page: "" while it is closed.
    fn chartJson:string () {
        if (chart.isOpen == false) {
            return ""
        }
        if ((chart.w != W) || (chart.h != H)) {
            chart.w = W
            chart.h = H
            chart.rebuild()
        }
        def dl:EVGDisplayList (chart.displayList())
        return ("{\"x\":0,\"y\":0,\"width\":" + (EVGDisplayList.num(chart.w)) + ",\"height\":" + (EVGDisplayList.num(chart.h)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    ; What the browser draws a character the editor's face lacks (an emoji)
    ; at, in ems — so the caret after one is where the text ends.
    fn setMissingGlyphEm:void (em:double) {
        tr.setMissingGlyphEm(em)
        mdEditor.contentWPx = 0
        cssEditor.contentWPx = 0
        chromeRev = (chromeRev + 1)
    }

    ; Columns a..b of a line become `text`, as one edit. The caret stays
    ; where the writer left it — a popover's edit is not a place to type
    ; from — moved only by the change in length when it sits after the edit
    ; on the same line.
    fn replaceRange:void (line:int a:int b:int text:string) {
        if ((line < 0) || (line >= (editor.buf.lineCount()))) {
            return
        }
        def cl:int editor.sel.caret.line
        def cc:int editor.sel.caret.col
        editor.moveCaret(line a false)
        editor.moveCaret(line b true)
        editor.insert(text)
        if (cl == line) {
            if (cc >= b) {
                cc = ((cc + (strlen text)) - (b - a))
            } {
                if (cc > (a + (strlen text))) {
                    cc = (a + (strlen text))
                }
            }
        }
        editor.moveCaret(cl cc false)
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn undo:void () {
        editor.undo()
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn redo:void () {
        editor.redo()
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn copySelection:string () {
        return (editor.selectionText())
    }

    fn cutSelection:string () {
        def out:string (editor.cutSelection())
        this.syncEditor()
        chromeRev = (chromeRev + 1)
        return out
    }

    ; A picture the host stored, as markdown on its own line at the caret.
    fn insertPicture:void (path:string alt:string) {
        def line:string (editor.buf.lineAt(editor.sel.caret.line))
        def pre:string ""
        if ((strlen (trim line)) > 0) {
            editor.handleKey((UIKey.end()) false false)
            pre = "\n\n"
        } {
            ; an empty line right under a paragraph would still continue it
            def ln:int editor.sel.caret.line
            if (ln > 0) {
                def above:string (editor.buf.lineAt((ln - 1)))
                if ((strlen (trim above)) > 0) {
                    pre = "\n"
                }
            }
        }
        editor.handleText((pre + "![" + alt + "](" + path + ")\n"))
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn currentLine:string () {
        return (editor.buf.lineAt(editor.sel.caret.line))
    }

    fn caretCol:int () {
        return editor.sel.caret.col
    }

    fn caretLine:int () {
        return editor.sel.caret.line
    }

    fn anchorLine:int () {
        return editor.sel.anchor.line
    }

    fn anchorCol:int () {
        return editor.sel.anchor.col
    }

    fn hasSelection:boolean () {
        return (! (editor.sel.isCollapsed()))
    }

    fn setFocus:void (where:string) {
        ; the keys stay with the chart editor while it is open
        if (chart.isOpen && (where == "editor")) {
            focus = "chart"
            return
        }
        if (where == focus) {
            return
        }
        focus = where
        chromeRev = (chromeRev + 1)
    }

    fn focusTarget:string () {
        return focus
    }

    fn setBlink:void (phase:int) {
        blink = phase
    }

    ; =========================================================================
    ; Exports
    ; =========================================================================
    ; The slides as PDF pages, through the markdown module's own print road
    ; (`MdToEvg.buildPrint`), with one addition: the pictures. The renderer
    ; reads a picture from disk unless it is handed the pixels, and a browser
    ; has no disk — so every picture the slides use is decoded from the byte
    ; store and registered under the name the page element carries.
    ; The deck as the stage draws it, one page per slide: the slide's own
    ; colours and type, and each diagram at rest in the holo style, in the
    ; direction the stage chose. It used to be the markdown module's print
    ; layout — white paper, which lost a dark theme's light text, and the
    ; plain diagram laid out as written, a strip on a long chain. A surface
    ; effect cannot be printed and leaves the slide's own colour.
    ; What the deck calls itself, for an exported file's name: the front
    ; matter's `title`, or the first heading when there is none, or "".
    fn docTitle:string () {
        def doc:MdNode deck.md.edit.doc
        def meta:MdMeta (MdFrontMatter.of(doc))
        def t:string (trim (meta.get("title" "")))
        if ((strlen t) > 0) {
            return t
        }
        def i:int 0
        while (i < (doc.childCount())) {
            def ch:MdNode (doc.childAt(i))
            if (ch.kind == "heading") {
                return (trim (ch.plainText()))
            }
            i = (i + 1)
        }
        return ""
    }

    ; The slides with an effect, "[1,3]", for the host to render before an
    ; export.
    fn fxSlidesJson:string () {
        def out:string "["
        def i:int 0
        def first:boolean true
        while (i < (deck.slideCount())) {
            def s:PresSlide (deck.slideAt(i))
            if ((strlen s.fx) > 0) {
                if (first == false) {
                    out = (out + ",")
                }
                first = false
                out = (out + (to_string i))
            }
            i = (i + 1)
        }
        return (out + "]")
    }

    fn fxJson:string (i:int) {
        return (this.listJson((deck.fxOnlyList(i))))
    }

    fn clearFxStills:void () {
        def a:[int]
        stillIdx = a
        def b:[buffer]
        stillRgba = b
        def c:[int]
        stillW = c
        def d:[int]
        stillH = d
        def e:[buffer]
        stillJpeg = e
        def f:[int]
        deck.fxStills = f
    }

    fn setFxStill:void (i:int rgba:buffer w:int h:int jpeg:buffer) {
        push stillIdx i
        push stillRgba rgba
        push stillW w
        push stillH h
        push stillJpeg jpeg
        push deck.fxStills i
    }

    fn pdf:buffer () {
        def mw:MarkdownWeb deck.md
        def e:MarkdownEdit mw.edit
        def l:MdLayout (deck.layout())
        def paper:string "#ffffff"
        if ((strlen l.style.pageBackground) > 0) {
            paper = l.style.pageBackground
        }
        def bg:EVGColor (EVGColor.parse(paper))
        def pw:double deck.pageW
        def ph:double deck.pageH
        def root:EVGElement (EVGListToElements.printRoot(pw ph))
        def section:EVGElement (EVGListToElements.sectionOf(root))
        deck.still = true
        def i:int 0
        while (i < (deck.slideCount())) {
            def groups:[int]
            def dl:EVGDisplayList (deck.slideList(i groups 0.0))
            section.addChild((EVGListToElements.pageFrom(dl pw ph bg true)))
            i = (i + 1)
        }
        deck.still = false
        def renderer (new EVGPDFRenderer())
        renderer.init(renderer)
        renderer.setPageSize(pw ph)
        ; the effects the host rendered: sharp enough for a full page
        def si:int 0
        while (si < (array_length stillIdx)) {
            def ib (new ImageBuffer())
            ib.width = (itemAt stillW si)
            ib.height = (itemAt stillH si)
            ib.pixels = (itemAt stillRgba si)
            renderer.registerImage((PresDeck.fxStillPath((itemAt stillIdx si))) ib)
            renderer.maxImageWidth = 1600
            renderer.maxImageHeight = 1600
            si = (si + 1)
        }
        if (mw.faceCount > 0) {
            renderer.setFontManager(mw.fontManager)
            if (!null? mw.measurer) {
                renderer.setMeasurer((unwrap mw.measurer))
            }
        }
        if e.haveImages {
            def k:int 0
            while (k < (array_length l.boxes)) {
                def b:MdBox (itemAt l.boxes k)
                if ((b.kind == 4) && ((strlen b.imagePath) > 0)) {
                    def bytes:buffer (e.imageStore.read(b.imagePath))
                    if ((buffer_length bytes) > 0) {
                        def pix@(optional):ImageBuffer (EVGImageDecode.decode(bytes))
                        if (!null? pix) {
                            renderer.registerImage(b.imagePath (unwrap pix))
                        }
                    }
                }
                k = (k + 1)
            }
        }
        return (renderer.render(root))
    }

    ; The deck through the markdown module's own PPTX road, then what the
    ; presentation adds on each slide: the speaker's notes, the transition,
    ; and a build step per `{.build}` item.
    fn pptx:buffer () {
        def d:PptxDeck (deck.md.buildDeck())
        def n:int (array_length d.pres.slides)
        ; slide points per stage unit
        def unit:double (d.pres.slideWidth / deck.pageW)
        def i:int 0
        while (i < n) {
            if (i < (deck.slideCount())) {
                def ps:PptxSlide (itemAt d.pres.slides i)
                def s:PresSlide (deck.slideAt(i))
                this.stillDiagrams(ps s unit)
                this.stillCharts(ps i unit)
                PresApp.dressSlide(ps s)
                ; the slide's effect, rendered by the host, as its background
                def si:int 0
                while (si < (array_length stillIdx)) {
                    if ((itemAt stillIdx si) == i) {
                        ps.bgImage = (itemAt stillJpeg si)
                        ps.bgImageName = ("media/" + (PresDeck.fxStillPath(i)))
                    }
                    si = (si + 1)
                }
            }
            PresApp.fontsIn(((itemAt d.pres.slides i).shapes))
            i = (i + 1)
        }
        d.pres.theme.majorFont = "Arial"
        d.pres.theme.minorFont = "Arial"
        return (d.save())
    }

    ; The faces the stage draws with are shipped with the page, not with
    ; Keynote or PowerPoint: a file that names them opens with "missing font".
    ; Arial is on every Mac and every Windows machine, and it is narrower than
    ; Open Sans, so every line still fits the box it was measured for.
    sfn exportFont:string (f:string) {
        if ((strlen f) == 0) {
            return f
        }
        ; …and the generic "sans-serif" a chart's labels ask for, which comes
        ; out as Calibri or as a made-up face name
        def low:string (MdChar.lower(f))
        if (((indexOf low "sans") >= 0) || ((indexOf low "calibri") >= 0)) {
            return "Arial"
        }
        return f
    }

    sfn fontsInBody:void (body:PptxTextBody) {
        def p:int 0
        while (p < (array_length body.paragraphs)) {
            def para:PptxParagraph (itemAt body.paragraphs p)
            para.bulletFont = (PresApp.exportFont(para.bulletFont))
            def r:int 0
            while (r < (array_length para.runs)) {
                def run:PptxTextRun (itemAt para.runs r)
                run.fontFamily = (PresApp.exportFont(run.fontFamily))
                r = (r + 1)
            }
            p = (p + 1)
        }
    }

    sfn fontsIn:void (shapes:[PptxShape]) {
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            PresApp.fontsInBody(sh.text)
            def c:int 0
            while (c < (array_length sh.tableCells)) {
                def cell:PptxTableCell (itemAt sh.tableCells c)
                PresApp.fontsInBody(cell.body)
                c = (c + 1)
            }
            PresApp.fontsIn(sh.children)
            i = (i + 1)
        }
    }

    ; The diagrams as the stage draws them, at rest, in place of the markdown
    ; module's plain drawing: the glass nodes, the lines of light and the
    ; label pills, in the direction the stage chose and filling the room the
    ; stage gives them. The plain drawing is laid out at the fence's written
    ; direction and the column's width, so a long left-to-right chain came out
    ; as a strip with labels too small to keep. The group keeps the plain
    ; one's name, alt text and embedded source, so it still reads back.
    fn stillDiagrams:void (ps:PptxSlide s:PresSlide unit:double) {
        def l:MdLayout (deck.layout())
        def paper:string "#ffffff"
        if ((strlen l.style.pageBackground) > 0) {
            paper = l.style.pageBackground
        }
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            def at:int -1
            def j:int 0
            while (j < (array_length ps.shapes)) {
                def sh:PptxShape (itemAt ps.shapes j)
                if ((at < 0) && (sh.embedSource == u.source)) {
                    at = j
                }
                j = (j + 1)
            }
            if (at >= 0) {
                def dl (new EVGDisplayList())
                u.diagram.paintStill(dl u.bx u.by u.bw u.bh l.style.textColor paper l)
                def conv (new PptxFromEvg())
                conv.unit = unit
                ; The stage reads small labels by zooming in; a still cannot,
                ; so a small label is kept rather than left an empty pill.
                conv.minFontPt = 1.0
                def group:PptxShape (conv.build(dl 0.0 0.0))
                if ((array_length group.children) > 0) {
                    PresApp.tighten(group)
                    def old:PptxShape (itemAt ps.shapes at)
                    group.name = old.name
                    group.altText = old.altText
                    group.embedNotation = old.embedNotation
                    group.embedSource = old.embedSource
                    group.mdSrcStart = old.mdSrcStart
                    group.mdSrcEnd = old.mdSrcEnd
                    set ps.shapes at group
                }
            }
            k = (k + 1)
        }
    }

    ; The charts as the stage draws them when they have finished (PresChart:
    ; the warm columns, the accent grid), in place of the markdown module's
    ; flat drawing, keeping its name, alt text and embedded source.
    fn stillCharts:void (ps:PptxSlide i:int unit:double) {
        def l:MdLayout (deck.layout())
        def boxes:[int] (deck.chartBoxes(i))
        def k:int 0
        while (k < (array_length boxes)) {
            def bi:int (itemAt boxes k)
            def b:MdBox (itemAt l.boxes bi)
            def at:int -1
            def j:int 0
            while (j < (array_length ps.shapes)) {
                def sh:PptxShape (itemAt ps.shapes j)
                if ((at < 0) && (sh.embedSource == b.embedSource)) {
                    at = j
                }
                j = (j + 1)
            }
            if (at >= 0) {
                def dl:EVGDisplayList (deck.chartStill(bi))
                def conv (new PptxFromEvg())
                conv.unit = unit
                conv.minFontPt = 1.0
                def group:PptxShape (conv.build(dl 0.0 0.0))
                if ((array_length group.children) > 0) {
                    PresApp.tighten(group)
                    def old:PptxShape (itemAt ps.shapes at)
                    group.name = old.name
                    group.altText = old.altText
                    group.embedNotation = old.embedNotation
                    group.embedSource = old.embedSource
                    group.mdSrcStart = old.mdSrcStart
                    group.mdSrcEnd = old.mdSrcEnd
                    set ps.shapes at group
                }
            }
            k = (k + 1)
        }
    }

    ; A group's box around what is in it, not from the slide's corner.
    sfn tighten:void (group:PptxShape) {
        def x0:double 1000000.0
        def y0:double 1000000.0
        def x1:double -1000000.0
        def y1:double -1000000.0
        def i:int 0
        while (i < (array_length group.children)) {
            def c:PptxShape (itemAt group.children i)
            if (c.x < x0) { x0 = c.x }
            if (c.y < y0) { y0 = c.y }
            if ((c.x + c.width) > x1) { x1 = (c.x + c.width) }
            if ((c.y + c.height) > y1) { y1 = (c.y + c.height) }
            i = (i + 1)
        }
        group.x = x0
        group.y = y0
        group.width = (x1 - x0)
        group.height = (y1 - y0)
        group.chX = x0
        group.chY = y0
        group.chW = group.width
        group.chH = group.height
    }

    sfn dressSlide:void (ps:PptxSlide s:PresSlide) {
        if ((strlen s.notes) > 0) {
            ps.notes.hasText = true
            PptxEditor.setBodyText(ps.notes.text (PresApp.speakable(s.notes)))
        }
        if ((s.transition != "none") && (s.index > 0)) {
            def tr:PptxTransition ps.transition
            tr.isSet = true
            tr.kind = "fade"
            if (s.transition == "slide") {
                tr.kind = "push"
                tr.dir = "l"
            }
            if (s.transition == "zoom") {
                tr.kind = "zoom"
            }
            tr.seconds = s.seconds
        }
        ; One build step per revealed group. The shape is the one the markdown
        ; module made from the group's source: by the source range when the
        ; shape carries one, otherwise by the paragraph whose words the group
        ; begins with (a list shape carries no range, and its items are its
        ; paragraphs). The writer finds a step's shape by `editId`, so each
        ; target gets one.
        def g:int 0
        while (g < (array_length s.groups)) {
            def gr:PresGroup (itemAt s.groups g)
            if (gr.step > 0) {
                PresApp.addBuild(ps gr (9000 + g))
            }
            g = (g + 1)
        }
    }

    sfn paraText:string (para:PptxParagraph) {
        def out:string ""
        def j:int 0
        while (j < (array_length para.runs)) {
            def run:PptxTextRun (itemAt para.runs j)
            out = (out + run.text)
            j = (j + 1)
        }
        return (trim out)
    }

    sfn addBuild:void (ps:PptxSlide gr:PresGroup editId:int) {
        def want:string (trim gr.label)
        if ((strlen want) > 12) {
            want = (substring want 0 12)
        }
        def k:int 0
        while (k < (array_length ps.shapes)) {
            def sh:PptxShape (itemAt ps.shapes k)
            def para:int -2
            if ((sh.mdSrcStart >= 0) && ((gr.start >= sh.mdSrcStart) && (gr.start < sh.mdSrcEnd))) {
                para = -1
            }
            if ((para == -2) && sh.hasText) {
                def p:int 0
                while (p < (array_length sh.text.paragraphs)) {
                    def words:string (PresApp.paraText((itemAt sh.text.paragraphs p)))
                    if (((strlen want) > 0) && ((indexOf words want) == 0)) {
                        para = p
                        break
                    }
                    p = (p + 1)
                }
            }
            if (para > -2) {
                if (sh.editId <= 0) {
                    sh.editId = editId
                }
                def b (new PptxBuildStep())
                b.editId = sh.editId
                b.kind = "fade"
                if (gr.anim == "fly") {
                    b.kind = "fly"
                    b.dir = "l"
                }
                b.seconds = gr.seconds
                b.paragraph = para
                push ps.build b
                return
            }
            k = (k + 1)
        }
    }

    ; Notes as a person reads them: the cue marks out.
    sfn speakable:string (notes:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen notes)
        while (i < n) {
            if (((i + 1) < n) && (((charAt notes i) == 91) && ((charAt notes (i + 1)) == 91))) {
                def rest:string (substring notes i n)
                def close:int (indexOf rest "]]")
                if (close > 0) {
                    i = ((i + close) + 2)
                    continue
                }
            }
            out = (out + (substring notes i (i + 1)))
            i = (i + 1)
        }
        return out
    }

    fn statusText:string () {
        def n:int (deck.slideCount())
        return ((to_string n) + (PresI18n.t(" slides · ")) + (PresApp.secs((PresTimeline.total(deck)))))
    }
}
