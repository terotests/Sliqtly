    ; --- the document's settings --------------------------------------------------
    ; The front matter as a window: title, transition, header and footer.
    ; `pics` is the deck's pictures, one path a line, for the logo. Each change
    ; rewrites the front matter at once; closing the window makes all of them
    ; one undo step.
    ; The rooms for the open Document settings window (PresChartEditor
    ; setDocRooms); nothing when it is not open.
    fn setDocRooms:void (rows:string current:string note:string) {
        chart.setDocRooms(rows current note)
        chromeRev = (chromeRev + 1)
    }

    fn openDocSettings:boolean (pics:string) {
        if (mode == "present") {
            return false
        }
        this.closeHint()
        if chart.isOpen {
            this.closeChart()
        }
        this.place()
        ; over the editor, so the slides it changes stay in sight
        def px:double 12.0
        if (W < 1100.0) {
            px = ((W - 560.0) * 0.5)
        }
        if (px < 8.0) {
            px = 8.0
        }
        def py:double (barH + 24.0)
        def d:PresDocSettings (new PresDocSettings())
        d.read((MdFrontMatter.of(deck.md.edit.doc)))
        def list:[string]
        def parts:[string] (strsplit pics "\n")
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (trim (itemAt parts i))
            if ((strlen p) > 0) {
                push list p
            }
            i = (i + 1)
        }
        ; a logo the front matter names stays pickable, whether or not the
        ; file is in the deck's files
        def e:int 0
        while (e < 2) {
            def lg:string (itemAt d.logo e)
            def known:boolean ((strlen lg) == 0)
            def q:int 0
            while (q < (array_length list)) {
                if ((itemAt list q) == lg) {
                    known = true
                }
                q = (q + 1)
            }
            if (known == false) {
                push list lg
            }
            e = (e + 1)
        }
        ; the theme's background picture, pickable whether or not it is
        ; among the deck's files
        def bg:string (PresApp.urlPath((this.cssValue("page" "background-image"))))
        if ((strlen bg) > 0) {
            def bgKnown:boolean false
            for list lp:string li {
                if (lp == bg) {
                    bgKnown = true
                }
            }
            if (bgKnown == false) {
                push list bg
            }
        }
        chart.dsBg = bg
        chart.dsBgAct = ""
        ; the pick's buttons would cover the header it changes
        pick.clear()
        chartStart = -1
        chartFile = ""
        docUndoBase = (array_length mdEditor.buf.undoStack)
        chart.measurer = measurer
        chart.openDocSet(d list px py W H)
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The Background tab's choice: the theme's page rule written, or the
    ; picture handed to the image editor or the vectorizer.
    fn writeDocBackground:void () {
        def act:string chart.dsBgAct
        chart.dsBgAct = ""
        if ((strlen act) == 0) {
            return
        }
        if (startsWith act "set:") {
            this.cssSet("page" "background-image" ("url(" + (substring act 4 (strlen act)) + ")"))
            focus = "chart"
            return
        }
        if (act == "none") {
            if ((strlen (this.cssValue("page" "background-image"))) > 0) {
                this.cssSet("page" "background-image" "none")
                focus = "chart"
            }
            return
        }
        if ((strlen chart.dsBg) == 0) {
            return
        }
        if (act == "edit") {
            push requests ("image-edit:" + chart.dsBg)
        }
        if (act == "trace") {
            push requests ("image-trace:" + chart.dsBg)
        }
    }

    ; A declaration's value in the theme's CSS: the last `prop` in a rule
    ; whose selector names `sel` ("" none).
    fn cssValue:string (sel:string prop:string) {
        def ed:ScriptEditor cssEditor
        def n:int (ed.buf.lineCount())
        def out:string ""
        def inRule:boolean false
        def i:int 0
        while (i < n) {
            def t:string (ed.buf.lineAt(i))
            def from:int 0
            if (inRule == false) {
                def open:int (indexOf t "{")
                if ((open > 0) && (PresHelp.names((substring t 0 open) sel))) {
                    inRule = true
                    from = (open + 1)
                }
            }
            if inRule {
                def close:int (indexOfFrom t "}" from)
                def body:string (substring t from (strlen t))
                if (close >= 0) {
                    body = (substring t from close)
                }
                def at:int (indexOf body (prop + ":"))
                if (at >= 0) {
                    def end:int (indexOfFrom body ";" at)
                    if (end < 0) {
                        end = (strlen body)
                    }
                    out = (trim (substring body (at + (strlen prop) + 1) end))
                }
                if (close >= 0) {
                    inRule = false
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; the picture of `url(media/x.png)` (quoted or not), "" for none
    sfn urlPath:string (v:string) {
        def at:int (indexOf v "url(")
        if (at < 0) {
            return ""
        }
        def end:int (indexOfFrom v ")" at)
        if (end < 0) {
            return ""
        }
        def p:string (trim (substring v (at + 4) end))
        if ((strlen p) >= 2) {
            def q:int (charAt p 0)
            if ((q == 34) || (q == 39)) {
                p = (substring p 1 ((strlen p) - 1))
            }
        }
        while (startsWith p "/") {
            p = (substring p 1 (strlen p))
        }
        return p
    }

    ; The front matter with the window's keys: a key's line is rewritten in
    ; place, a key with no value is taken out, a new one goes last. Other
    ; lines stay as they are. The block is replaced as one edit; a deck with
    ; no front matter gets one.
    fn writeDocSettings:void () {
        def ds:PresDocSettings chart.ds
        ds.build()
        def n:int (mdEditor.buf.lineCount())
        def close:int -1
        if ((n > 0) && ((trim (mdEditor.buf.lineAt(0))) == "---")) {
            def k:int 1
            while ((k < n) && (close < 0)) {
                def ln:string (trim (mdEditor.buf.lineAt(k)))
                if ((ln == "---") || (ln == "...")) {
                    close = k
                }
                k = (k + 1)
            }
        }
        def lines:[string]
        def done:[boolean]
        def q:int 0
        while (q < (array_length ds.outKeys)) {
            push done false
            q = (q + 1)
        }
        if (close > 0) {
            def i:int 1
            while (i < close) {
                def raw:string (mdEditor.buf.lineAt(i))
                def cut:int (MdFrontMatter.colonAt(raw))
                def at:int -1
                if (cut > 0) {
                    def key:string (MdChar.lower((trim (substring raw 0 cut))))
                    def j:int 0
                    while ((j < (array_length ds.outKeys)) && (at < 0)) {
                        if ((itemAt ds.outKeys j) == key) {
                            at = j
                        }
                        j = (j + 1)
                    }
                }
                if (at < 0) {
                    push lines raw
                } {
                    def v:string (itemAt ds.outVals at)
                    if (((strlen v) > 0) && ((itemAt done at) == false)) {
                        push lines ((itemAt ds.outKeys at) + ": " + (PresDocSettings.quote(v)))
                    }
                    set done at true
                }
                i = (i + 1)
            }
        }
        def j2:int 0
        while (j2 < (array_length ds.outKeys)) {
            def v2:string (itemAt ds.outVals j2)
            if (((itemAt done j2) == false) && ((strlen v2) > 0)) {
                push lines ((itemAt ds.outKeys j2) + ": " + (PresDocSettings.quote(v2)))
            }
            j2 = (j2 + 1)
        }
        def body:string (join lines "\n")
        if ((strlen body) > 0) {
            body = (body + "\n")
        }
        def text:string ("---\n" + body + "---")
        if (close < 0) {
            if ((strlen body) == 0) {
                return
            }
        }
        def cl:int mdEditor.sel.caret.line
        def cc:int mdEditor.sel.caret.col
        def was:string edTab
        def keep:ScriptEditor editor
        editor = mdEditor
        def oldLines:int 0
        mdEditor.moveCaret(0 0 false)
        ; the block always ends with its line break, so the writes of one
        ; window all replace the same stretch and merge into one undo step
        if (close < 0) {
            mdEditor.insert((text + "\n"))
        } {
            if ((close + 1) < n) {
                mdEditor.moveCaret((close + 1) 0 true)
                mdEditor.insert((text + "\n"))
            } {
                mdEditor.moveCaret(close (strlen (mdEditor.buf.lineAt(close))) true)
                mdEditor.insert(text)
            }
            oldLines = (close + 1)
        }
        def newLines:int ((array_length lines) + 2)
        if (cl >= oldLines) {
            cl = (cl + (newLines - oldLines))
        } {
            cl = 0
            cc = 0
        }
        mdEditor.moveCaret(cl cc false)
        mdEditor.sel.collapseToCaret()
        editor = keep
        edTab = was
        bufSynced = mdEditor.buf.version
        this.rebuildDeck()
    }

    ; --- a question before deleting ------------------------------------------------
    ; The same window asking before something that cannot be undone: `title`,
    ; `words`, Cancel and a red `ok`. The red button is "confirm:<key>" to
    ; the page; Cancel and Esc leave everything as it is.
    fn openConfirm:boolean (key:string title:string words:string ok:string) {
        if (mode == "present") {
            return false
        }
        this.closeHint()
        if chart.isOpen {
            this.closeChart()
        }
        this.place()
        def px:double ((W - 560.0) * 0.5)
        if (px < 8.0) {
            px = 8.0
        }
        def py:double (barH + 24.0)
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
        chart.openConfirm(key title words ok px py W H)
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The same window with two answers: `ok` ("confirm:<key>") and `alt`
    ; ("confirm:<key>:alt"), and Cancel.
    fn openChoice:boolean (key:string title:string words:string ok:string alt:string) {
        if ((this.openConfirm(key title words ok)) == false) {
            return false
        }
        chart.cfAlt = alt
        chart.rebuild()
        return true
    }

    ; Help → About: the same window with the app's name and version, `words`
    ; one line each, and only an OK button
    fn openAbout:boolean (title:string words:string) {
        return (this.openConfirm("" title words ""))
    }

    ; {"name": text, "theme": key, "data": "none"|"sample"|"file", "dup": a
    ;  copy of the open deck (File → Duplicate), "ask": "" | "dup" | "name"
    ;  (one's own name for editing together: nothing is made)}
    fn newDeckPlan:string () {
        def dup:string "false"
        if (chart.ndDup && (chart.ndAsk == "dup")) {
            dup = "true"
        }
        return ("{\"name\":" + (PresApp.jsonStr(chart.ndName)) + ",\"theme\":" + (PresApp.jsonStr(chart.ndTheme)) + ",\"data\":" + (PresApp.jsonStr(chart.ndData)) + ",\"dup\":" + dup + ",\"ask\":" + (PresApp.jsonStr(chart.ndAsk)) + ",\"room\":" + (PresApp.jsonStr(chart.rmId)) + ",\"desc\":" + (PresApp.jsonStr(chart.ndDesc)) + ",\"act\":" + (PresApp.jsonStr(chart.rmAct)) + ",\"editors\":" + (PresApp.jsonStr((chart.inv.text()))) + ",\"invroom\":" + (PresApp.jsonStr(chart.invRoom)) + "}")
    }

    ; {"to": "slide"|"bg-slide"|"bg-all", "crop": "x,y,w,h" in pixels,
    ;  "whole": true when nothing was cut away, "alt": the description}
    fn pastePlan:string () {
        def trace:string "false"
        if chart.pasteTrace {
            trace = "true"
        }
        def whole:string "false"
        if (chart.crop.isWhole()) {
            whole = "true"
        }
        return ("{\"to\":\"" + chart.pasteTo + "\",\"crop\":\"" + (chart.crop.cropPixels()) + "\",\"whole\":" + whole + ",\"alt\":" + (PresApp.jsonStr(chart.pasteAlt)) + ",\"trace\":" + trace + "}")
    }

    ; v as a JSON string, every character kept (a description's line breaks
    ; included)
    sfn jsonStr:string (v:string) {
        def w (new VlJsonWriter())
        return (w.write((VlJson.stringValue(v))))
    }

    ; The kept picture into the deck: on the slide at the caret, as the
    ; background of the caret's slide, or of every slide.
    fn placePicture:void (path:string alt:string to:string) {
        if (to == "bg-all") {
            this.cssSet("page" "background-image" ("url(" + path + ")"))
            chromeRev = (chromeRev + 1)
            return
        }
        if (to == "bg-slide") {
            def head:int (this.slideHeadAt(mdEditor.sel.caret.line))
            if (head >= 0) {
                ; the picture is what the slide shows: an effect would cover it
                this.replaceLines(head head (PresApp.withAttr((PresApp.withoutFx((mdEditor.buf.lineAt(head)))) "bg" path)))
                chromeRev = (chromeRev + 1)
                return
            }
        }
        this.showTab("md")
        this.insertPicture(path alt)
    }

    ; The heading of the slide Markdown line `line` is on: the nearest one at
    ; or above it, or the first one below when it is above them all. -1 when
    ; the deck has none.
    fn slideHeadAt:int (line:int) {
        def k:int line
        def n:int (mdEditor.buf.lineCount())
        if (k >= n) {
            k = (n - 1)
        }
        while (k >= 0) {
            if ((indexOf (mdEditor.buf.lineAt(k)) "#") == 0) {
                return k
            }
            k = (k - 1)
        }
        k = (line + 1)
        while (k < n) {
            if ((indexOf (mdEditor.buf.lineAt(k)) "#") == 0) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; The picture on the caret's line, when the Markdown tab shows.
    fn openImageAtCaret:boolean () {
        if (edTab != "md") {
            return false
        }
        return (this.openImageEditor(mdEditor.sel.caret.line))
    }

    ; The picture under a point of the stage.
    fn openImageAt:boolean (x:double y:double) {
        this.slidePoint(x y)
        def l:MdLayout (deck.layout())
        def k:int 0
        while (k < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes k)
            if (((b.page == selected) && (b.kind == 4)) && (b.srcStart >= 0)) {
                if (((spX >= b.x) && (spX <= (b.x + b.w))) && ((spY >= b.y) && (spY <= (b.y + b.h)))) {
                    this.posOf((mdEditor.text()) b.srcStart)
                    if (this.openImageEditor(posLine)) {
                        return true
                    }
                }
            }
            k = (k + 1)
        }
        return false
    }

    ; Lines `from`..`to` of the Markdown replaced with `text` ("" takes them
    ; out), as one edit.
    fn replaceLines:void (from:int to:int text:string) {
        def keep:ScriptEditor editor
        editor = mdEditor
        def n:int (mdEditor.buf.lineCount())
        mdEditor.moveCaret(from 0 false)
        if ((to + 1) < n) {
            mdEditor.moveCaret((to + 1) 0 true)
            if ((strlen text) > 0) {
                mdEditor.insert((text + "\n"))
            } {
                mdEditor.insert("")
            }
        } {
            mdEditor.moveCaret(to (strlen (mdEditor.buf.lineAt(to))) true)
            mdEditor.insert(text)
        }
        mdEditor.sel.collapseToCaret()
        editor = keep
        bufSynced = mdEditor.buf.version
        this.rebuildDeck()
    }

    ; A block's lines (`from`…`to`) replaced with `text`: the block's last
    ; line now.
    fn writeBlock:int (from:int to:int text:string) {
        if ((from < 0) || (to < from)) {
            return to
        }
        this.replaceLines(from to text)
        return ((from + (array_length (strsplit text "\n"))) - 1)
    }

    ; Lines `from`…`to` selected in the Markdown editor, shown.
    fn selectLines:void (from:int to:int) {
        if ((from < 0) || (to < from)) {
            return
        }
        this.showTab("md")
        mdEditor.moveCaret(from 0 false)
        mdEditor.moveCaret(to (strlen (mdEditor.buf.lineAt(to))) true)
        mdEditor.layout.ensureCaretVisible(mdEditor.buf mdEditor.sel)
        focus = "editor"
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    ; Where the window opens: where it was left, or over the Markdown.
    fn placeChartWindow:void () {
        this.place()
        if (chartWinX < 0.0) {
            chartWinX = (edRect.x + 12.0)
            chartWinY = (edRect.y + 8.0)
        }
        if (chartWinX > (W - 120.0)) {
            chartWinX = (W - 120.0)
        }
        if (chartWinY > (H - 60.0)) {
            chartWinY = (H - 60.0)
        }
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
    }

    ; The diagram fence opening on `line`: its window. False when the line
    ; does not open one.
    fn openDiagramEditor:boolean (line:int) {
        if (mode == "present") {
            return false
        }
        def m:PresFlowModel (this.diagramAt(line))
        if (m.ok == false) {
            return false
        }
        this.placeChartWindow()
        chart.openDiagram(m chartWinX chartWinY W H)
        this.selectSlide((deck.pageOfOffset((this.offsetOf(line 0)))))
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The fenced block opening on `line`, read as a diagram's model (`ok`
    ; false when the line opens none).
    fn diagramAt:PresFlowModel (line:int) {
        def none (new PresFlowModel())
        def n:int (mdEditor.buf.lineCount())
        if ((line < 0) || (line >= n)) {
            return none
        }
        def head:string (trim (mdEditor.buf.lineAt(line)))
        if (((indexOf head "```") != 0) && ((indexOf head "~~~") != 0)) {
            return none
        }
        def fence:string (substring head 0 3)
        def close:int -1
        def k:int (line + 1)
        while ((k < n) && (close < 0)) {
            if ((trim (mdEditor.buf.lineAt(k))) == fence) {
                close = k
            }
            k = (k + 1)
        }
        if (close < 0) {
            return none
        }
        def last:int close
        if (((close + 1) < n) && ((indexOf head "{") < 0)) {
            if (PresFlowModel.isAttrLine((mdEditor.buf.lineAt((close + 1))))) {
                last = (close + 1)
            }
        }
        def m:PresFlowModel (PresFlowModel.read((this.blockText(line last))))
        m.first = line
        m.last = last
        return m
    }

    ; A look picked on the diagram's card: the block's settings line
    ; rewritten, as one edit (Ctrl+Z undoes it).
    fn setDiagramLook:void (line:int v:string) {
        def m:PresFlowModel (this.diagramAt(line))
        if (m.ok == false) {
            return
        }
        def at:int (line + (m.lookLineAt()))
        def t:string (m.lookLine(v))
        this.replaceRange(at 0 (strlen (mdEditor.buf.lineAt(at))) t)
        if (at == line) {
            hint.text = t
        }
        hint.look = v
        hint.rebuild()
    }

    ; The table on `line` (a Markdown table's first line, or a ```table /
    ; ```sheet fence's): its window. False when there is none there.
    fn openTableEditor:boolean (line:int) {
        if (mode == "present") {
            return false
        }
        def n:int (mdEditor.buf.lineCount())
        if ((line < 0) || (line >= n)) {
            return false
        }
        def head:string (trim (mdEditor.buf.lineAt(line)))
        def last:int -1
        if (((indexOf head "```table") == 0) || ((indexOf head "```sheet") == 0)) {
            def k:int (line + 1)
            while ((k < n) && (last < 0)) {
                if ((trim (mdEditor.buf.lineAt(k))) == "```") {
                    last = k
                }
                k = (k + 1)
            }
        } {
            if ((indexOf head "|") != 0) {
                return false
            }
            last = line
            while (((last + 1) < n) && ((indexOf (trim (mdEditor.buf.lineAt((last + 1)))) "|") == 0)) {
                last = (last + 1)
            }
        }
        if (last < 0) {
            return false
        }
        def m:PresGridModel (PresGridModel.read((this.blockText(line last))))
        if (m.ok == false) {
            return false
        }
        m.first = line
        m.last = last
        this.placeChartWindow()
        chart.openGrid(m chartWinX chartWinY W H)
        this.selectSlide((deck.pageOfOffset((this.offsetOf(line 0)))))
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    fn blockText:string (from:int to:int) {
        def out:string ""
        def i:int from
        while (i <= to) {
            out = (out + (mdEditor.buf.lineAt(i)) + "\n")
            i = (i + 1)
        }
        return out
    }

    ; The picture's lines rewritten from the window's model.
    fn writeImage:void () {
        def m:PresImageModel chart.img
        if (m.line < 0) {
            return
        }
        def last:int m.line
        if (m.attrLine >= 0) {
            last = m.attrLine
        }
        def text:string (m.markdown())
        this.replaceLines(m.line last text)
        if ((indexOf text "\n") > 0) {
            m.attrLine = (m.line + 1)
        } {
            m.attrLine = -1
        }
    }

    ; What the window asked of the picture once it closed: to be taken out, or
    ; to become the slide's or every slide's background.
    fn imageAfterClose:void () {
        def m:PresImageModel chart.img
        def bg:string chart.wantsBg
        def rm:boolean chart.wantsRemove
        chart.wantsBg = ""
        chart.wantsRemove = false
        if ((((strlen bg) == 0) && (rm == false)) || (m.line < 0)) {
            return
        }
        def last:int m.line
        if (m.attrLine >= 0) {
            last = m.attrLine
        }
        def head:int -1
        if (bg == "slide") {
            ; the slide's heading: the nearest one above the picture
            def k:int m.line
            while ((k >= 0) && (head < 0)) {
                if ((indexOf (mdEditor.buf.lineAt(k)) "#") == 0) {
                    head = k
                }
                k = (k - 1)
            }
        }
        this.replaceLines(m.line last "")
        if (bg == "slide") {
            if (head >= 0) {
                this.replaceLines(head head (PresApp.withAttr((mdEditor.buf.lineAt(head)) "bg" m.path)))
            }
        }
        if (bg == "all") {
            this.cssSet("page" "background-image" ("url(" + m.path + ")"))
        }
        m.line = -1
    }

    ; A heading line without `fx=` and `fx-…=` in its `{…}`.
    sfn withoutFx:string (line:string) {
        def t:string line
        def n:int (strlen t)
        def open:int (PresApp.lastIndexOf(t " {"))
        if ((open <= 0) || ((charAt t (n - 1)) != 125)) {
            return t
        }
        def words:[string] (strsplit (substring t (open + 2) (n - 1)) " ")
        def out:string ""
        def i:int 0
        while (i < (array_length words)) {
            def w:string (trim (itemAt words i))
            if (((strlen w) > 0) && (((indexOf w "fx=") != 0) && ((indexOf w "fx-") != 0))) {
                if ((strlen out) > 0) {
                    out = (out + " ")
                }
                out = (out + w)
            }
            i = (i + 1)
        }
        if ((strlen out) == 0) {
            return (substring t 0 open)
        }
        return ((substring t 0 open) + " {" + out + "}")
    }

    ; A heading line with `key=value` in its `{…}` (replacing the key's old
    ; value), or a new `{key=value}` after it.
    sfn withAttr:string (line:string key:string value:string) {
        def t:string line
        def n:int (strlen t)
        def open:int (PresApp.lastIndexOf(t " {"))
        if (((open > 0) && (n > 0)) && ((charAt t (n - 1)) == 125)) {
            def inner:string (substring t (open + 2) (n - 1))
            def words:[string] (strsplit inner " ")
            def out:string (key + "=" + value)
            def i:int 0
            while (i < (array_length words)) {
                def w:string (trim (itemAt words i))
                if (((strlen w) > 0) && ((indexOf w (key + "=")) != 0)) {
                    out = (out + " " + w)
                }
                i = (i + 1)
            }
            return ((substring t 0 open) + " {" + out + "}")
        }
        return (t + " {" + key + "=" + value + "}")
    }

    sfn lastIndexOf:int (t:string what:string) {
        def at:int -1
        def from:int (indexOf t what)
        while (from >= 0) {
            at = from
            from = (indexOfFrom t what (from + 1))
        }
        return at
    }

    ; One property of one theme rule set to `value`, the rule made when there
    ; is none; the slides follow.
    fn cssSet:void (sel:string prop:string value:string) {
        def was:string edTab
        this.helpEdit(sel prop value)
        def ed:ScriptEditor cssEditor
        def ln:int ed.sel.caret.line
        def col:int ed.sel.caret.col
        def lt:string (ed.buf.lineAt(ln))
        def end:int (indexOfFrom lt ";" col)
        if (end < 0) {
            end = (strlen lt)
        }
        if ((substring lt col end) != value) {
            ed.moveCaret(ln col false)
            ed.moveCaret(ln end true)
            ed.insert(value)
            this.syncEditor()
        }
        this.showTab(was)
    }

    ; The chart under a point of the stage, opened in the editor.
    fn openChartAt:boolean (x:double y:double) {
        this.slidePoint(x y)
        def l:MdLayout (deck.layout())
        def boxes:[int] (deck.chartBoxes(selected))
        def k:int 0
        while (k < (array_length boxes)) {
            def b:MdBox (itemAt l.boxes (itemAt boxes k))
            if ((((spX >= b.x) && (spX <= (b.x + b.w))) && ((spY >= b.y) && (spY <= (b.y + b.h)))) && (b.srcStart >= 0)) {
                this.posOf((mdEditor.text()) b.srcStart)
                return (this.openChartEditor(posLine))
            }
            k = (k + 1)
        }
        return false
    }

    fn closeChart:void () {
        this.writeChart()
        ; the image editor, however it was closed: saved only by Save (or
        ; Enter); a press outside it or Esc leaves the file as it was
        if (chart.isOpen && (chart.mode == "adjust")) {
            if chart.wantsSave {
                chart.wantsSave = false
                push requests "image-save"
            } {
                push requests "image-cancel"
            }
            if chart.wantsTrace {
                chart.wantsTrace = false
                push requests ("image-trace:" + chart.adjFile)
            }
        }
        if (chart.isOpen && (chart.mode == "trace")) {
            if chart.wantsTraceSave {
                chart.wantsTraceSave = false
                push requests "trace-save"
            } {
                push requests "trace-cancel"
            }
        }
        if (chart.isOpen && (chart.mode == "docset")) {
            def keepBase:int chartUndoBase
            chartUndoBase = docUndoBase
            this.mergeChartUndo()
            chartUndoBase = keepBase
            docUndoBase = -1
        }
        chartWinX = chart.x
        chartWinY = chart.y
        chart.close()
        focus = "editor"
        chromeRev = (chromeRev + 1)
    }

    ; The Rooms search through a deck kept only in this browser (web/main.js
    ; deckSearch; the server searches the others the same way): the words a
    ; reader sees in its Markdown, one block to a line (RangerMarkdown
    ; MdSearchText), and the text around the query's first word in them,
    ; "+" first, or "" when the name and the words do not hold every word.
    fn searchText:string (md:string) {
        return (MdSearchText.of(md))
    }

    fn searchSnippet:string (name:string text:string query:string) {
        if ((MdSearchText.find((name + "\n" + text) query)) < 0) {
            return ""
        }
        return ("+" + (MdSearchText.snippet(text query 90)))
    }

    fn chartIsOpen:boolean () {
        return chart.isOpen
    }

    ; The keys are the window's while it is open; Document settings' only
    ; while it was pressed last (a press on the editor or a slide gives
    ; them back, the window staying open).
    fn chartHasKeys:boolean () {
        if (chart.isOpen == false) {
            return false
        }
        return ((chart.mode != "docset") || (focus == "chart"))
    }

    ; A press outside Document settings: its changes so far one undo step,
    ; the keys back to the editor; the window stays open.
    fn docSetLeave:void () {
        this.writeChart()
        if (docUndoBase >= 0) {
            def keepBase:int chartUndoBase
            chartUndoBase = docUndoBase
            this.mergeChartUndo()
            chartUndoBase = keepBase
            docUndoBase = -1
        }
        docSetSeen = mdEditor.buf.version
        chart.blur()
        focus = "editor"
        chromeRev = (chromeRev + 1)
    }

    ; A press back on Document settings: its next changes a new undo step.
    fn docSetEnter:void () {
        if (focus == "chart") {
            return
        }
        this.docSetFollow()
        focus = "chart"
        if (docUndoBase < 0) {
            docUndoBase = (array_length mdEditor.buf.undoStack)
        }
    }

    ; Document settings open while the text changes under it (typed by hand,
    ; undone): the window reads the front matter again.
    fn docSetFollow:void () {
        if (((chart.isOpen == false) || (chart.mode != "docset")) || (focus == "chart")) {
            return
        }
        if (mdEditor.buf.version == docSetSeen) {
            return
        }
        docSetSeen = mdEditor.buf.version
        chart.ds.read((MdFrontMatter.of(deck.md.edit.doc)))
        chart.rebuild()
    }

    ; What a routed input asked for, and the fence rewritten when the model
    ; changed.
    fn afterChart:void () {
        if chart.wantsFresh {
            chart.wantsFresh = false
            def fresh:PresChartModel (PresChartModel.sample())
            chart.model = fresh
            chart.changed = true
            chart.rebuild()
        }
        ; a drag in the picker writes the fence when it ends, not at every move
        if ((chart.dragging()) == false) {
            this.writeChart()
        }
        ; Document settings' room: the page moves the presentation
        if ((strlen chart.dsRoomAct) > 0) {
            push requests ("docroom:" + chart.dsRoomAct)
            chart.dsRoomAct = ""
        }
        if chart.wantsClose {
            chart.wantsClose = false
            this.closeChart()
            if (chart.mode == "image") {
                this.imageAfterClose()
            }
            if (chart.wantsText) {
                chart.wantsText = false
                if (chart.mode == "diagram") {
                    this.selectLines(chart.flow.first chart.flow.last)
                }
                if (chart.mode == "grid") {
                    this.selectLines(chart.grid.first chart.grid.last)
                }
            }
            if ((chart.mode == "newdeck") && chart.wantsCreate) {
                chart.wantsCreate = false
                push requests "newdeck-create"
            }
            if ((chart.mode == "themes") && chart.wantsCss) {
                chart.wantsCss = false
                push requests "showtab:css"
            }
            if ((chart.mode == "confirm") && chart.wantsConfirm) {
                chart.wantsConfirm = false
                push requests ("confirm:" + chart.cfKey)
            }
            if ((chart.mode == "confirm") && chart.wantsAlt) {
                chart.wantsAlt = false
                push requests ("confirm:" + chart.cfKey + ":alt")
            }
            if (chart.mode == "paste") {
                if chart.wantsPlace {
                    chart.wantsPlace = false
                    push requests "picture-place"
                } {
                    push requests "picture-cancel"
                }
            }
        }
        ; a theme's tile: the page's select changes, and with it the slides
        if chart.themePicked {
            chart.themePicked = false
            push requests ("select:theme:" + chart.wantsTheme)
            chart.wantsTheme = ""
        }
        ; the chart's data file, in the files tab's editor
        if ((strlen chart.wantsFile) > 0) {
            def f:string (MdVegaRender.bareUrl(chart.wantsFile))
            chart.wantsFile = ""
            push requests ("files:open:" + f)
        }
        chromeRev = (chromeRev + 1)
    }

    ; The writes of one drag as one undo step. Each replaced the whole fence
    ; body from the same place, so the first write's removed text and the
    ; last one's inserted text are the whole change.
    fn mergeChartUndo:void () {
        if (chartUndoBase < 0) {
            return
        }
        def st:[EditorUndoOp] mdEditor.buf.undoStack
        def n:int (array_length st)
        if (n <= (chartUndoBase + 1)) {
            return
        }
        def first:EditorUndoOp (itemAt st chartUndoBase)
        def last:EditorUndoOp (itemAt st (n - 1))
        first.inserted = last.inserted
        first.endLine = last.endLine
        first.endCol = last.endCol
        while ((array_length st) > (chartUndoBase + 1)) {
            removeLast st
        }
    }

    ; The fence's body replaced with the model's specification, as one edit.
    fn writeChart:void () {
        if (chart.changed == false) {
            return
        }
        chart.changed = false
        if (((chart.mode == "paste") || (chart.mode == "newdeck")) || (chart.mode == "confirm")) {
            return
        }
        if (chart.mode == "docset") {
            this.writeDocSettings()
            this.writeDocBackground()
            return
        }
        if (chart.mode == "adjust") {
            if chart.adjDirty {
                chart.adjDirty = false
                push requests "image-adjust"
            }
            return
        }
        if (chart.mode == "trace") {
            if chart.trDirty {
                if (chart.dragging()) {
                    chart.changed = true
                    return
                }
                chart.trDirty = false
                chart.trBusy = true
                chart.rebuild()
                push requests "trace-run"
            }
            return
        }
        if (chart.mode == "image") {
            this.writeImage()
            return
        }
        if (chart.mode == "diagram") {
            chart.flow.last = (this.writeBlock(chart.flow.first chart.flow.last (chart.flow.markdown())))
            return
        }
        if (chart.mode == "grid") {
            chart.grid.last = (this.writeBlock(chart.grid.first chart.grid.last (chart.grid.markdown())))
            return
        }
        def spec:string (chart.model.toSpec())
        if (((strlen spec) == 0) || (chartStart < 0)) {
            return
        }
        if ((strlen chartFile) > 0) {
            ; the chart's own file changes, the fence that names it does not
            chartFileText = spec
            this.setChartData(chartFile spec)
            push requests ("chart-file:" + chartFile)
            return
        }
        def was:string edTab
        def keep:ScriptEditor editor
        editor = mdEditor
        mdEditor.moveCaret((chartStart + 1) 0 false)
        mdEditor.moveCaret(chartEnd 0 true)
        mdEditor.insert((spec + "\n"))
        chartEnd = ((chartStart + 1) + (array_length (strsplit spec "\n")))
        mdEditor.moveCaret(chartStart 0 false)
        mdEditor.sel.collapseToCaret()
        editor = keep
        edTab = was
        bufSynced = mdEditor.buf.version
        this.rebuildDeck()
    }

    ; The editor as a display list, placed on the page: "" while it is closed.
    fn chartJson:string () {
        if (chart.isOpen == false) {
            return ""
        }
        if ((chart.w != W) || (chart.h != H)) {
            chart.w = W
            chart.h = H
            chart.rebuild()
        }
        def dl:EVGDisplayList (chart.displayList())
        return ("{\"x\":0,\"y\":0,\"width\":" + (EVGDisplayList.num(chart.w)) + ",\"height\":" + (EVGDisplayList.num(chart.h)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    ; The browser's own measure, for the clusters it draws from faces neither
    ; font manager has: every emoji (♨️, 👨‍👩‍👧, 🇫🇮) and any character no
    ; loaded face covers. The editor and the slides both ask it, per cluster,
    ; so the caret after an emoji is where the text ends and the space after
    ; one on a slide is as wide as it is drawn.
    fn setPlatformMeasure:void (f:(fn:double (text:string family:string size:double))) {
        tr.setPlatformMeasure(f)
        deck.md.fontManager.setPlatformMeasure(f)
        mdEditor.contentWPx = 0
        cssEditor.contentWPx = 0
        chromeRev = (chromeRev + 1)
    }

    ; The deck's name changed in the bar: line `line` of the Markdown becomes
    ; `text`, one edit of the Markdown editor (it undoes there), whichever
    ; tab is shown.
    fn renameLine:void (line:int text:string) {
        def was:ScriptEditor editor
        editor = mdEditor
        if ((line >= 0) && (line < (editor.buf.lineCount()))) {
            this.replaceRange(line 0 (strlen (editor.buf.lineAt(line))) text)
        }
        editor = was
        chromeRev = (chromeRev + 1)
    }

    ; Columns a..b of a line become `text`, as one edit. The caret stays
    ; where the writer left it — a popover's edit is not a place to type
    ; from — moved only by the change in length when it sits after the edit
    ; on the same line.
    fn replaceRange:void (line:int a:int b:int text:string) {
        if ((line < 0) || (line >= (editor.buf.lineCount()))) {
            return
        }
        def cl:int editor.sel.caret.line
        def cc:int editor.sel.caret.col
        editor.moveCaret(line a false)
        editor.moveCaret(line b true)
        editor.insert(text)
        if (cl == line) {
            if (cc >= b) {
                cc = ((cc + (strlen text)) - (b - a))
            } {
                if (cc > (a + (strlen text))) {
                    cc = (a + (strlen text))
                }
            }
        }
        editor.moveCaret(cl cc false)
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    ; --- the Slide menu ------------------------------------------------------------
    ; "new", "duplicate", "delete", "portrait" and "landscape", from the menu
    ; or from their keys. Each is one edit of the Markdown, so it undoes as
    ; one. False when nothing was done (presenting, the chart editor open).
    fn slideCommand:boolean (what:string) {
        if (mode == "present") {
            return false
        }
        if chart.isOpen {
            return false
        }
        ; from the strip (its keys, its menu) the keyboard stays there, but
        ; a new slide's heading is selected in the editor to be typed over
        def was:string focus
        this.showTab("md")
        if ((was == "strip") && (what != "new")) {
            focus = "strip"
            a11yFocus = ""
        }
        if (what == "new") {
            this.addSlide(false)
            return true
        }
        if (what == "duplicate") {
            this.addSlide(true)
            return true
        }
        if (what == "delete") {
            return (this.deleteSlide(selected))
        }
        if (what == "left") {
            return (this.moveSlideBy(selected -1))
        }
        if (what == "right") {
            return (this.moveSlideBy(selected 1))
        }
        if ((what == "portrait") || (what == "landscape")) {
            this.setOrientation(what)
            return true
        }
        if (what == "draw") {
            this.setSketching(true)
            return true
        }
        return false
    }

    ; The slide's Markdown (its whole section, as slideLines finds it) taken
    ; out. The last slide of a deck stays: a deck has at least one.
    fn deleteSlide:boolean (i:int) {
        this.dropPicks()
        def n:int (deck.slideCount())
        if ((n < 2) || ((i < 0) || (i >= n))) {
            return false
        }
        this.slideLines(i)
        if (linesFrom < 0) {
            return false
        }
        def lc:int (mdEditor.buf.lineCount())
        if (linesAt < lc) {
            mdEditor.moveCaret(linesFrom 0 false)
            mdEditor.moveCaret(linesAt 0 true)
        } {
            ; the last: from the end of what is above it, so no blank lines
            ; are left trailing
            def top:int (linesFrom - 1)
            while ((top > 0) && ((strlen (trim (mdEditor.buf.lineAt(top)))) == 0)) {
                top = (top - 1)
            }
            if (top >= 0) {
                mdEditor.moveCaret(top (strlen (mdEditor.buf.lineAt(top))) false)
            } {
                mdEditor.moveCaret(0 0 false)
            }
            mdEditor.moveCaret((lc - 1) (strlen (mdEditor.buf.lineAt((lc - 1)))) true)
        }
        mdEditor.deleteSelection()
        this.syncEditor()
        def to:int i
        if (to >= (deck.slideCount())) {
            to = ((deck.slideCount()) - 1)
        }
        this.selectSlide(to)
        chromeRev = (chromeRev + 1)
        return true
    }

    ; Slide i one place to the left (-1) or right (1): past the whole section
    ; next to it (a slide the overflow went on to belongs to its heading's).
    fn moveSlideBy:boolean (i:int d:int) {
        def n:int (deck.slideCount())
        if ((i < 0) || (i >= n)) {
            return false
        }
        this.slideLines(i)
        def f:int linesFrom
        def t:int linesAt
        if (f < 0) {
            return false
        }
        if (d < 0) {
            ; before the first slide of the section above
            def k:int (i - 1)
            while ((k >= 0) && ((this.slideStartsBefore(k f)) == false)) {
                k = (k - 1)
            }
            if (k < 0) {
                return false
            }
            this.slideLines(k)
            def above:int linesFrom
            while ((k > 0) && (this.sectionStartsAt((k - 1) above))) {
                k = (k - 1)
            }
            return (this.moveSlideTo(i k))
        }
        ; after the section below: before the first slide past it
        def j:int (i + 1)
        while ((j < n) && (this.slideStartsBefore(j t))) {
            j = (j + 1)
        }
        if (j >= n) {
            return false
        }
        this.slideLines(j)
        def nextEnd:int linesAt
        def m:int (j + 1)
        while ((m < n) && (this.slideStartsBefore(m nextEnd))) {
            m = (m + 1)
        }
        return (this.moveSlideTo(i m))
    }

    fn sectionStartsAt:boolean (j:int line:int) {
        this.slideLines(j)
        return (linesFrom == line)
    }

    ; Slide j's section starts above `line`.
    fn slideStartsBefore:boolean (j:int line:int) {
        this.slideLines(j)
        return ((linesFrom >= 0) && (linesFrom < line))
    }

    ; Lines a..b-1 of the Markdown, the blank ones at the end left out.
    fn linesText:string (a:int b:int) {
        def last:int (b - 1)
        while ((last >= a) && ((strlen (trim (mdEditor.buf.lineAt(last)))) == 0)) {
            last = (last - 1)
        }
        def out:string ""
        def k:int a
        while (k <= last) {
            if (k > a) {
                out = (out + "\n")
            }
            out = (out + (mdEditor.buf.lineAt(k)))
            k = (k + 1)
        }
        return out
    }

    sfn newlines:int (s:string) {
        def c:int 0
        def k:int 0
        def len:int (strlen s)
        while (k < len) {
            if ((charAt s k) == 10) {
                c = (c + 1)
            }
            k = (k + 1)
        }
        return c
    }

    ; Slide i's Markdown (its whole section) moved to the gap `slot`: before
    ; slide `slot`, or after the last one when it is the slide count. The
    ; lines between are rewritten as one edit, so Ctrl+Z undoes it as one,
    ; with a blank line between the sections. The moved slide is selected.
    fn moveSlideTo:boolean (i:int slot:int) {
        if ((mode == "present") || chart.isOpen) {
            return false
        }
        def n:int (deck.slideCount())
        if (((n < 2) || ((i < 0) || (i >= n))) || ((slot < 0) || (slot > n))) {
            return false
        }
        if (edTab != "md") {
            def was:string focus
            this.showTab("md")
            focus = was
        }
        this.slideLines(i)
        def f:int linesFrom
        def t:int linesAt
        if (f < 0) {
            return false
        }
        def lc:int (mdEditor.buf.lineCount())
        def to:int lc
        if (slot < n) {
            this.slideLines(slot)
            if (linesFrom < 0) {
                return false
            }
            to = linesFrom
        }
        ; into its own place, or into the middle of its own section
        if ((to >= f) && (to <= t)) {
            return false
        }
        this.dropPicks()
        def block:string (this.linesText(f t))
        def from:int f
        def upto:int t
        def text:string ""
        def start:int f
        if (to > t) {
            def below:string (this.linesText(t to))
            upto = to
            text = (below + "\n\n" + block)
            start = ((f + (PresApp.newlines(below))) + 2)
        } {
            from = to
            text = (block + "\n\n" + (this.linesText(to f)))
            start = to
        }
        def endLine:int upto
        def endCol:int 0
        if (upto < lc) {
            text = (text + "\n\n")
        } {
            ; to the end of the document, keeping its last line break
            endLine = (lc - 1)
            def lastText:string (mdEditor.buf.lineAt(endLine))
            endCol = (strlen lastText)
            if ((strlen (trim lastText)) == 0) {
                text = (text + "\n")
            }
        }
        mdEditor.buf.replaceRange(from 0 endLine endCol text true)
        mdEditor.moveCaret(start 0 false)
        mdEditor.dirty = true
        this.syncEditor()
        this.selectSlide((deck.pageOfOffset((this.offsetOf(start 0)))))
        chromeRev = (chromeRev + 1)
        return true
    }

    ; --- copy and paste of slides and elements (PresClip) -----------------------------
    ; Ctrl/⌘+C on the filmstrip copies the picked slides (else the selected
    ; one), on the slide the picked element (else the slide), as PresClip's
    ; text with the styles and the files they use; the page adds the files
    ; (clipBegin, clipAddFile, clipText). A paste is read by PresClip.plan,
    ; asked about first (clipAsk) and made as one edit of the Markdown and
    ; one of the theme, which Undo takes back together (clipLink).

    ; What Ctrl/⌘+C copies now: "slides", "element", or "" (the ordinary
    ; copy of the selected text).
    fn clipCopyKind:string () {
        if (((mode == "present") || chart.isOpen) || ((deck.slideCount()) == 0)) {
            return ""
        }
        if ((strlen (this.readSelection())) > 0) {
            return ""
        }
        if (focus == "strip") {
            return "slides"
        }
        if (focus == "stage") {
            if (pick.on && (pick.srcA >= 0)) {
                return "element"
            }
            return "slides"
        }
        return ""
    }

    ; A copy of `kind` ("slides", "element") begun: the Markdown and the
    ; styles it uses. `paths`: the deck's files, a line each. Gives the ones
    ; the copy names, a line each, for the page to add (clipAddFile) before
    ; it takes clipText.
    fn clipBegin:string (kind:string paths:string) {
        def d (new PresClipDoc())
        def text:string (mdEditor.text())
        def lay:MdLayout (deck.layout())
        d.from = toolbar.docTitle
        d.splitLevel = lay.splitLevel
        if (kind == "element") {
            if (((pick.on == false) || (pick.srcA < 0)) || (pick.srcB > (strlen text))) {
                clipDoc = d
                return ""
            }
            d.kind = "element"
            d.what = (PresClip.elementWord(pick.sel))
            def b:int (PresClip.elementEnd(text pick.srcA pick.srcB))
            push d.parts (PresClip.trimBlankLines((substring text pick.srcA b)))
        } {
            d.kind = "slides"
            def pages:[int]
            if (picks.active()) {
                pages = picks.pages
            } {
                push pages selected
            }
            ; a slide the overflow went on to is its section's: once
            def seen:[int]
            def k:int 0
            while (k < (array_length pages)) {
                this.slideLines((itemAt pages k))
                if ((linesFrom >= 0) && ((indexOf seen linesFrom) < 0)) {
                    push seen linesFrom
                    def ls:[string]
                    def li:int linesFrom
                    while (li < linesAt) {
                        push ls (mdEditor.buf.lineAt(li))
                        li = (li + 1)
                    }
                    def part:string (PresClip.trimBlankLines((join ls "\n")))
                    if ((strlen part) > 0) {
                        push d.parts part
                    }
                }
                k = (k + 1)
            }
        }
        def md:string (d.markdown())
        d.css = (PresClip.cssFor((cssEditor.text()) md))
        clipDoc = d
        def all:[string] (strsplit paths "\n")
        return (join (PresClip.filesUsed((md + "\n" + d.css) all)) "\n")
    }

    ; How many slides (or the one element) the copy has.
    fn clipCount:int () {
        return (array_length clipDoc.parts)
    }

    fn clipAddFile:void (name:string mime:string data:string) {
        clipDoc.addFile(name mime data)
    }

    fn clipText:string () {
        return (PresClip.write(clipDoc))
    }

    ; The picture that goes on the clipboard beside the text, for apps that
    ; do not read Sliqtly's format: {"pages": [i…], "box": [x, y, w, h]}.
    ; Slides: the picked ones (else the selected one), whole; an element: its
    ; slide, cut to the element's box (slide units). {} when there is none.
    fn clipPictureJson:string (kind:string) {
        def n:int (deck.slideCount())
        if (n == 0) {
            return "{}"
        }
        if (kind == "element") {
            if (((pick.on == false) || (pick.srcA < 0)) || (((pick.page < 0) || (pick.page >= n)) || ((pick.w <= 0.0) || (pick.h <= 0.0)))) {
                return "{}"
            }
            return ("{\"pages\":[" + (to_string pick.page) + "],\"box\":[" + (to_string pick.x) + "," + (to_string pick.y) + "," + (to_string pick.w) + "," + (to_string pick.h) + "]}")
        }
        def pages:[int]
        if (picks.active()) {
            pages = picks.pages
        } {
            push pages selected
        }
        def out:[string]
        for pages p:int i {
            if ((p >= 0) && (p < n)) {
                push out (to_string p)
            }
        }
        if ((array_length out) == 0) {
            return "{}"
        }
        return ("{\"pages\":[" + (join out ",") + "]}")
    }

    ; What a pasted text is (PresClip.classify): "sliqtly", "mermaid", …
    fn clipKindOf:string (text:string) {
        return (PresClip.classify(text))
    }

    ; Where a paste goes now: "md", "css", "deck", or "" (a field, a window,
    ; presenting: the ordinary paste).
    fn clipWhere:string () {
        if (((mode == "present") || chart.isOpen) || (((barH > 0.0) && toolbar.titleEditing) || (this.roomHasKeys()))) {
            return ""
        }
        if (review.hasKeys()) {
            return ""
        }
        if ((focus == "strip") || (focus == "stage")) {
            if ((deck.slideCount()) == 0) {
                return ""
            }
            return "deck"
        }
        if ((focus == "editor") && ((this.filesListShowing()) == false)) {
            if ((edTab == "md") || (edTab == "css")) {
                return edTab
            }
        }
        return ""
    }

    ; A paste read (PresClip.plan); `plain` is Paste without formatting.
    ; {"target": "md"|"css"|"deck"|"", "files": n}. With no target the page
    ; pastes the text as before; with one it asks about the files
    ; (clipFileSteps, clipAskPicture) and then the question (clipAsk).
    fn clipPaste:string (text:string plain:boolean) {
        def where:string (this.clipWhere())
        def inFence:boolean false
        if (where == "md") {
            inFence = (PresClip.insideFence((mdEditor.text()) (this.offsetOf(mdEditor.sel.caret.line mdEditor.sel.caret.col))))
        }
        def lay:MdLayout (deck.layout())
        clipPlan = (PresClip.plan(text where inFence plain lay.splitLevel (cssEditor.text()) (mdEditor.text())))
        clipRaw = text
        clipFocus = focus
        def files:int 0
        if ((clipPlan.target == "md") || (clipPlan.target == "deck")) {
            files = (array_length clipPlan.doc.files)
        }
        return ("{\"target\":" + (PresApp.jsonStr(clipPlan.target)) + ",\"files\":" + (to_string files) + "}")
    }

    fn clipFileName:string (i:int) {
        def f:PresClipFile (itemAt clipPlan.doc.files i)
        return f.name
    }

    fn clipFileMime:string (i:int) {
        def f:PresClipFile (itemAt clipPlan.doc.files i)
        return f.mime
    }

    fn clipFileData:string (i:int) {
        def f:PresClipFile (itemAt clipPlan.doc.files i)
        return f.data
    }

    ; The page's word for each pasted file, a line each: "new", "same" or
    ; "differs" (a file of that name here with other bytes). Answers
    ; "add", "skip" or "ask", a line each.
    fn clipFileSteps:string (states:string) {
        def parts:[string] (strsplit states "\n")
        def steps:[string] (PresClip.fileSteps(clipPlan.doc parts))
        return (join steps "\n")
    }

    ; A picture of the same name: replace it ("confirm:clipimg") or keep
    ; both (":alt"); Cancel leaves the paste.
    fn clipAskPicture:boolean (name:string) {
        def words:string (PresClip.fill((PresI18n.t("{file} is already in this presentation. Replace it with the pasted picture, or keep both?")) "file" name))
        return (this.openChoice("clipimg" (PresI18n.t("Replace the picture?")) words (PresI18n.t("Replace")) (PresI18n.t("Keep both"))))
    }

    ; A pasted picture kept beside this deck's of the same name: its new
    ; name (`taken`: the deck's files, a line each), the pasted text
    ; pointed there.
    fn clipKeepBoth:string (name:string taken:string) {
        def to:string (PresClip.copyName(name (strsplit taken "\n")))
        this.clipRename(name to)
        return to
    }

    ; A pasted file kept under another name: the pasted text points there.
    fn clipRename:void (from:string to:string) {
        clipPlan.md = (PresClip.swapRefs(clipPlan.md from to))
        clipPlan.css = (PresClip.swapRefs(clipPlan.css from to))
    }

    ; The question before the paste: "confirm:clip" pastes, "confirm:clip:alt"
    ; is the second answer (without formatting, or the diagram as text).
    fn clipAsk:boolean () {
        def at:int 0
        if (clipPlan.target == "deck") {
            at = (selected + 1)
            if (clipPlan.place == "after") {
                this.slideLines(selected)
                at = ((deck.slideCount()) + 1)
                if ((linesFrom >= 0) && (linesAt < (mdEditor.buf.lineCount()))) {
                    at = ((deck.pageOfOffset((this.offsetOf(linesAt 0)))) + 1)
                }
            }
        }
        def words:string (PresClip.question(clipPlan at))
        def alt:string (PresClip.altAnswer(clipPlan))
        def title:string (PresI18n.t("Paste"))
        if ((strlen alt) > 0) {
            return (this.openChoice("clip" title words (PresI18n.t("Paste")) alt))
        }
        if ((this.openConfirm("clip" title words (PresI18n.t("Paste")))) == false) {
            return false
        }
        ; a paste is no deletion: its button is not the red one
        chart.cfSafe = true
        chart.rebuild()
        return true
    }

    ; The paste made (`alt`: the question's second answer). The paste's
    ; number, which the page keeps its files' undo under ("clip:undo:<n>",
    ; "clip:redo:<n>"); 0 when nothing was pasted.
    fn clipApply:int (alt:boolean) {
        def p:PresClipPlan clipPlan
        if alt {
            if (p.target == "deck") {
                p.css = ""
                p.cssAdded = 0
            }
            if (p.target == "md") {
                p.md = clipRaw
            }
        }
        def mdDone:boolean false
        def cssDone:boolean false
        if ((p.target == "css") && ((strlen p.css) > 0)) {
            this.showTab("css")
            focus = "editor"
            PresApp.putAtCaret(cssEditor p.css "\n")
            cssDone = true
        }
        if ((p.target == "md") && ((strlen p.md) > 0)) {
            this.showTab("md")
            focus = "editor"
            PresApp.putAtCaret(mdEditor p.md "\n\n")
            mdDone = true
        }
        def firstLine:int -1
        if ((p.target == "deck") && ((strlen p.md) > 0)) {
            ; the keys back where the paste came (the question had them)
            this.showTab("md")
            focus = clipFocus
            firstLine = (this.clipIntoDeck(p))
            mdDone = true
            if ((strlen p.css) > 0) {
                this.clipAppendCss(p.css p.doc.from)
                cssDone = true
            }
        }
        if ((mdDone == false) && (cssDone == false)) {
            return 0
        }
        def id:int (clipUndo.remember(mdEditor.buf mdDone cssEditor.buf cssDone))
        this.syncBuffers()
        if (firstLine >= 0) {
            this.selectSlide((deck.pageOfOffset((this.offsetOf(firstLine 0)))))
            if (focus == "strip") {
                a11yFocus = ("thumb-" + (to_string selected))
            }
        }
        clipPlan = (new PresClipPlan())
        chromeRev = (chromeRev + 1)
        return id
    }

    ; A block of text over the editor's selection (or at its caret) as one
    ; edit, `gap` (a line break, or a blank line) between it and text left
    ; on the same line before or after it.
    sfn putAtCaret:void (ed:ScriptEditor block:string gap:string) {
        def a:EditorPos ed.sel.anchor
        def c:EditorPos ed.sel.caret
        def sl:int a.line
        def sc:int a.col
        def el:int c.line
        def ec:int c.col
        if ((ed.buf.cmpPos(a.line a.col c.line c.col)) > 0) {
            sl = c.line
            sc = c.col
            el = a.line
            ec = a.col
        }
        def text:string block
        if ((strlen (trim (substring (ed.buf.lineAt(sl)) 0 sc))) > 0) {
            text = (gap + text)
        }
        def endLine:string (ed.buf.lineAt(el))
        if ((strlen (trim (substring endLine ec (strlen endLine)))) > 0) {
            text = (text + gap)
        }
        def after:EditorPos (ed.buf.replaceRange(sl sc el ec text true))
        ed.moveCaret(after.line after.col false)
        ed.sel.collapseToCaret()
        ed.dirty = true
    }

    ; The pasted Markdown into the deck: new slides after the selected one
    ; ("after"), or onto it ("into": after the picked element, else after
    ; its last line). The line the first new slide starts on (-1: onto
    ; the slide).
    fn clipIntoDeck:int (p:PresClipPlan) {
        def lc:int (mdEditor.buf.lineCount())
        this.slideLines(selected)
        if (p.place == "after") {
            if ((linesFrom >= 0) && (linesAt < lc)) {
                ; before the next slide, a blank line between
                mdEditor.buf.replaceRange(linesAt 0 linesAt 0 (p.md + "\n\n") true)
                mdEditor.moveCaret(linesAt 0 false)
                mdEditor.dirty = true
                return linesAt
            }
            def end:int (lc - 1)
            def endText:string (mdEditor.buf.lineAt(end))
            def first:int (end + 2)
            def put:string ("\n\n" + p.md + "\n")
            if ((strlen (trim (mdEditor.text()))) == 0) {
                first = end
                put = (p.md + "\n")
            } {
                if ((strlen (trim endText)) == 0) {
                    first = (end + 1)
                    put = ("\n" + p.md + "\n")
                }
            }
            mdEditor.buf.replaceRange(end (strlen endText) end (strlen endText) put true)
            mdEditor.moveCaret(first 0 false)
            mdEditor.dirty = true
            return first
        }
        def text:string (mdEditor.text())
        def line:int (lc - 1)
        if ((pick.on && (pick.page == selected)) && ((pick.srcA >= 0) && (pick.srcB <= (strlen text)))) {
            def b:int (PresClip.elementEnd(text pick.srcA pick.srcB))
            def lcol:[int] (PresApp.lineColOf(text b))
            line = (itemAt lcol 0)
        } {
            if (linesFrom >= 0) {
                def ls:[string]
                def li:int 0
                while (li < linesAt) {
                    push ls (mdEditor.buf.lineAt(li))
                    li = (li + 1)
                }
                def at:int (PresClip.intoLine(ls linesFrom linesAt))
                if (at >= 0) {
                    line = at
                }
            }
        }
        def col:int (strlen (mdEditor.buf.lineAt(line)))
        def put:string ("\n\n" + p.md)
        if (((line + 1) < lc) && ((strlen (trim (mdEditor.buf.lineAt((line + 1))))) > 0)) {
            put = (put + "\n")
        }
        mdEditor.buf.replaceRange(line col line col put true)
        mdEditor.moveCaret((line + 2) 0 false)
        mdEditor.dirty = true
        return -1
    }

    ; The pasted rules at the end of the theme, under a note of where they
    ; came from.
    fn clipAppendCss:void (css:string from:string) {
        def lc:int (cssEditor.buf.lineCount())
        def end:int (lc - 1)
        def endText:string (cssEditor.buf.lineAt(end))
        def name:string (PresClip.swapRefs((PresClip.oneLine(from)) "*/" "* /"))
        def note:string (PresI18n.t("Pasted"))
        if ((strlen name) > 0) {
            note = (PresClip.fill((PresI18n.t("Pasted from {deck}")) "deck" name))
        }
        def put:string ("/* " + note + " */\n" + css + "\n")
        if ((strlen (trim (cssEditor.text()))) > 0) {
            if ((strlen (trim endText)) == 0) {
                put = ("\n" + put)
            } {
                put = ("\n\n" + put)
            }
        }
        cssEditor.buf.replaceRange(end (strlen endText) end (strlen endText) put true)
        cssEditor.dirty = true
    }

    ; Both texts after an edit made to them from outside their own keys:
    ; the slides and the theme follow.
    fn syncBuffers:void () {
        if (cssEditor.buf.version != cssSynced) {
            cssSynced = cssEditor.buf.version
            cssEditor.dirty = true
            themeText = (cssEditor.text())
            this.applyTheme(themeText)
            push requests "theme-edited"
        }
        if (mdEditor.buf.version != bufSynced) {
            bufSynced = mdEditor.buf.version
            mdEditor.dirty = true
            this.rebuildDeck()
        }
    }

    ; Undo (`back`) or Redo about to happen in the Markdown ("md") or the
    ; theme ("css"): a paste's other half goes with it, and the page is told
    ; so its files follow.
    fn clipLink:void (which:string back:boolean) {
        def id:int (clipUndo.linked(which back mdEditor.buf cssEditor.buf))
        if (id <= 0) {
            return
        }
        if clipUndo.other {
            def ed:ScriptEditor cssEditor
            if (which == "css") {
                ed = mdEditor
            }
            if back {
                ed.undo()
            } {
                ed.redo()
            }
            this.syncBuffers()
        }
        if back {
            push requests ("clip:undo:" + (to_string id))
        } {
            push requests ("clip:redo:" + (to_string id))
        }
    }

    ; Which text an Undo now works on: "md", "css", or "".
    fn undoTarget:string () {
        if ((focus == "strip") || (focus == "stage")) {
            return "md"
        }
        if ((focus == "editor") && ((edTab == "md") || (edTab == "css"))) {
            return edTab
        }
        return ""
    }

    ; --- the room chat's message menu ---------------------------------------------
    ; A right click on the open room's chat: the menu of the message under
    ; it. True when x, y is on the chat (no other menu there).
    fn roomMenuAt:boolean (x:double y:double) {
        this.place()
        if (((room.open == false) || (mode == "present")) || ((this.layerAt(x y)) != "room")) {
            return false
        }
        room.menuAt(x y)
        this.afterRoom()
        return true
    }

    ; --- the strip's context menu -------------------------------------------------
    ; A right click on a thumbnail selects it and opens New / Duplicate /
    ; Move left / Move right / Delete / Copy there; on the slide being
    ; edited, the same menu for it. False when x, y is on neither.
    fn slideMenuAt:boolean (x:double y:double) {
        this.place()
        if ((mode == "present") || ((deck.slideCount()) == 0)) {
            return false
        }
        if (slideRect.has(x y)) {
            this.openSlideMenu(selected x y)
            return true
        }
        if ((barH <= 0.0) || ((stripRect.has(x y)) == false)) {
            return false
        }
        def i:int 0
        while (i < (deck.slideCount())) {
            def tx:double (this.thumbX(i))
            if (((x >= tx) && (x <= (tx + thumbW))) && (this.thumbFits(tx))) {
                this.openSlideMenu(i x y)
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; A presentation of the Rooms panel or a deck tab under x, y: its menu,
    ; the File menu's rows for that deck (PresToolbar.openDeckContext).
    fn deckMenuAt:boolean (x:double y:double) {
        if ((mode == "present") || (barH <= 0.0)) {
            return false
        }
        def from:string "room"
        def id:string (toolbar.roomDeckAt(x y))
        def name:string ""
        def current:boolean false
        if ((strlen id) > 0) {
            name = (toolbar.roomDeckName(id))
            current = (toolbar.roomDeckCurrent(id))
        } {
            def key:string (this.deckTabKeyAt(x y))
            if ((strlen key) == 0) {
                return false
            }
            from = "tab"
            id = key
            name = (deckTabs.labelOf(key))
            current = (key == deckTabs.tabs.active)
        }
        if chart.isOpen {
            this.closeChart()
        }
        if hint.isOpen {
            this.closeHint()
        }
        toolbar.openDeckContext(x y from id name current)
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The deck tab under x, y ("" none, or its ×): its key.
    fn deckTabKeyAt:string (x:double y:double) {
        if ((deckRect.has(x y)) == false) {
            return ""
        }
        def hit:string (deckTabs.hitAt(x y))
        if ((indexOf hit "tab:") == 0) {
            return (substring hit 4 (strlen hit))
        }
        return ""
    }

    ; The menu from the keyboard (Shift+F10, the menu key): at the selected
    ; slide's thumbnail.
    fn slideMenuAtSelected:boolean () {
        this.place()
        if (((mode == "present") || (barH <= 0.0)) || ((deck.slideCount()) == 0)) {
            return false
        }
        this.revealThumb(selected)
        def tx:double (this.thumbX(selected))
        this.openSlideMenu(selected (tx + 12.0) ((this.thumbY()) + 12.0))
        return true
    }

    fn openSlideMenu:void (i:int x:double y:double) {
        if chart.isOpen {
            this.closeChart()
        }
        if hint.isOpen {
            this.closeHint()
        }
        if playing {
            this.stop()
        }
        this.selectSlide(i)
        focus = "strip"
        def n:int (deck.slideCount())
        toolbar.ctxElement = ""
        if ((pick.on && (pick.page == i)) && (pick.srcA >= 0)) {
            toolbar.ctxElement = (PresClip.elementWord(pick.sel))
        }
        toolbar.openContext(x y (i > 0) (i < (n - 1)) (n > 1))
        chromeRev = (chromeRev + 1)
    }

    ; The deck's orientation, as `orientation:` in the front matter: written
    ; when it turns the page the deck has without it (the theme's, or
    ; `page:`), taken out when it does not. A deck with no front matter gets
    ; one.
    fn setOrientation:void (o:string) {
        def write:boolean ((o == "portrait") != deck.themeTall)
        def line:string ("orientation: " + o)
        def n:int (mdEditor.buf.lineCount())
        def cl:int mdEditor.sel.caret.line
        def cc:int mdEditor.sel.caret.col
        def close:int -1
        def at:int -1
        if ((n > 0) && ((trim (mdEditor.buf.lineAt(0))) == "---")) {
            def k:int 1
            while ((k < n) && (close < 0)) {
                def ln:string (trim (mdEditor.buf.lineAt(k)))
                if ((ln == "---") || (ln == "...")) {
                    close = k
                } {
                    if ((indexOf ln "orientation:") == 0) {
                        at = k
                    }
                }
                k = (k + 1)
            }
        }
        def moved:int 0
        if (at >= 0) {
            mdEditor.moveCaret(at 0 false)
            if write {
                mdEditor.moveCaret(at (strlen (mdEditor.buf.lineAt(at))) true)
                mdEditor.insert(line)
            } {
                mdEditor.moveCaret((at + 1) 0 true)
                mdEditor.deleteSelection()
                moved = -1
            }
        } {
            if (write == false) {
                return
            }
            if (close > 0) {
                mdEditor.moveCaret(close 0 false)
                mdEditor.insert((line + "\n"))
                moved = 1
            } {
                mdEditor.moveCaret(0 0 false)
                mdEditor.insert((("---\n" + line) + "\n---\n\n"))
                moved = 4
            }
        }
        if (cl > at) {
            cl = (cl + moved)
        }
        mdEditor.moveCaret(cl cc false)
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    ; What the deck's orientation is now: "portrait" or "landscape".
    fn orientation:string () {
        if (deck.pageH > deck.pageW) {
            return "portrait"
        }
        return "landscape"
    }

    ; A request from the page's keys, as a menu row would make it: "slide:…"
    ; is done here, the rest goes to the page with the others.
    fn request:void (r:string) {
        ; File → Rename… (a presentation's menu, once it is open): the name at
        ; the start of the bar as a field
        if (r == "rename") {
            toolbar.titleBegin()
            chromeRev = (chromeRev + 1)
            return
        }
        if ((indexOf r "slide:") == 0) {
            this.slideCommand((substring r 6 (strlen r)))
            return
        }
        if (r == "rec:start") {
            ; with the voice or without: asked first (the page counts down,
            ; then calls record)
            this.openChoice("recstart" (PresI18n.t("Record presentation")) (PresI18n.t("Record your voice as you present, or only the pointer, the drawings and the slides? You can draw with the mouse and write by typing while it records.")) (PresI18n.t("With voice")) (PresI18n.t("Without voice")))
            return
        }
        if (r == "rec:edit") {
            this.recEditOpen(true)
            return
        }
        if (r == "rec:play") {
            this.replayFromSlide()
            return
        }
        ; the rail's places: the editor's tabs here, the rest the page's own
        ; requests (a window, a button); review is turned on or off by the page
        if ((indexOf r "rail:") == 0) {
            def p:string (substring r 5 (strlen r))
            if (p == "history") {
                push requests "click:history"
            }
            if (p == "settings") {
                push requests "settings"
            }
            ; the editor's dark or light look: the bar's switch (#modeBtn)
            if (p == "dark") {
                push requests "click:modeBtn"
            }
            if (p == "review") {
                this.toggleReviewList()
            }
            ; the slides' places close a room's chat over them
            if (((p == "review") || (p == "history")) && room.open) {
                push requests "roomchat:close"
            }
            chromeRev = (chromeRev + 1)
            return
        }
        push requests r
    }

    ; The menus' key caps: ⌘ on a Mac, Ctrl elsewhere.
    fn setMac:void (on:boolean) {
        if (toolbar.mac != on) {
            toolbar.mac = on
            toolbar.rebuild()
        }
    }

    ; The toast stays up while its text is selected, so it can be copied.
    fn toastHeld:boolean () {
        return (panels.toastHeld())
    }

    fn undo:void () {
        this.clipLink((this.undoTarget()) true)
        editor.undo()
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn redo:void () {
        this.clipLink((this.undoTarget()) false)
        editor.redo()
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    ; Ctrl+C: what is selected on the top surface that has a selection — the
    ; open window's text or field, the panels' (the toast, a note, a link,
    ; the chat field) — else the editor's.
    fn readSelection:string () {
        if ((barH > 0.0) && toolbar.titleEditing) {
            return (toolbar.titleIn.selectedText())
        }
        if (this.roomHasKeys()) {
            def mt:string (room.copyText())
            if ((strlen mt) > 0) {
                return mt
            }
        }
        if (review.hasKeys()) {
            def rt:string (review.copyText())
            if ((strlen rt) > 0) {
                return rt
            }
        }
        if chart.isOpen {
            def ct:string (chart.copyText())
            if ((strlen ct) > 0) {
                return ct
            }
        }
        return (panels.copyText((focus == "chat")))
    }

    fn copySelection:string () {
        def other:string (this.readSelection())
        if ((strlen other) > 0) {
            return other
        }
        return (editor.selectionText())
    }

    ; Ctrl+X cuts from the editor only; text selected elsewhere is not the
    ; editor's to cut (and is read, not edited), so nothing is cut then.
    fn cutSelection:string () {
        ; the bar's name field is not the editor's: nothing of the editor goes
        if (((strlen (this.readSelection())) > 0) || ((barH > 0.0) && toolbar.titleEditing)) {
            return ""
        }
        def out:string (editor.cutSelection())
        this.syncEditor()
        chromeRev = (chromeRev + 1)
        return out
    }

    ; A picture the host stored, as markdown on its own line at the caret.
    fn insertPicture:void (path:string alt:string) {
        def line:string (editor.buf.lineAt(editor.sel.caret.line))
        def pre:string ""
        if ((strlen (trim line)) > 0) {
            editor.handleKey((UIKey.end()) false false)
            pre = "\n\n"
        } {
            ; an empty line right under a paragraph would still continue it
            def ln:int editor.sel.caret.line
            if (ln > 0) {
                def above:string (editor.buf.lineAt((ln - 1)))
                if ((strlen (trim above)) > 0) {
                    pre = "\n"
                }
            }
        }
        editor.handleText((pre + "![" + alt + "](" + path + ")\n"))
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn currentLine:string () {
        return (editor.buf.lineAt(editor.sel.caret.line))
    }

    fn caretCol:int () {
        return editor.sel.caret.col
    }

    fn caretLine:int () {
        return editor.sel.caret.line
    }

    fn anchorLine:int () {
        return editor.sel.anchor.line
    }

    fn anchorCol:int () {
        return editor.sel.anchor.col
    }

    fn hasSelection:boolean () {
        return (! (editor.sel.isCollapsed()))
    }

    fn setFocus:void (where:string) {
        ; the keys stay with the chart editor while it is open (Document
        ; settings lets them go: a press outside it gave them back)
        if ((chart.isOpen && (chart.mode != "docset")) && (where == "editor")) {
            focus = "chart"
            return
        }
        if (where == focus) {
            return
        }
        focus = where
        chromeRev = (chromeRev + 1)
    }

    fn focusTarget:string () {
        return focus
    }

    ; The code editor's text size: Ctrl/Cmd + plus, minus and 0 (or Ctrl +
    ; wheel) over the editor. `steps` is +1 / -1 per step, 0 the default size.
    ; The Markdown, Theme (CSS) and file texts share one size.
    fn zoomEditor:boolean (steps:int) {
        if ((editor.zoomBy(steps)) == false) {
            return false
        }
        this.setEditorFontSize(editor.layout.fontSize)
        return true
    }

    fn editorFontSize:double () {
        return editor.layout.fontSize
    }

    ; The size the page kept from an earlier visit.
    fn setEditorFontSize:void (size:double) {
        mdEditor.setFontSize(size)
        cssEditor.setFontSize(size)
        fileEditor.setFontSize(size)
        chromeRev = (chromeRev + 1)
    }

    ; Whether a wheel at (x, y) is over the editor's text, not a window above it.
    fn editorAt:boolean (x:double y:double) {
        if (mode == "present") {
            return false
        }
        this.place()
        if ((strlen (this.layerAt(x y))) > 0) {
            return false
        }
        return (edRect.has(x y))
    }

    fn setBlink:void (phase:int) {
        blink = phase
    }

    ; =========================================================================
    ; Exports
    ; =========================================================================
    ; The slides as PDF pages, through the markdown module's own print road
    ; (`MdToEvg.buildPrint`), with one addition: the pictures. The renderer
    ; reads a picture from disk unless it is handed the pixels, and a browser
    ; has no disk — so every picture the slides use is decoded from the byte
    ; store and registered under the name the page element carries.
    ; The deck as the stage draws it, one page per slide: the slide's own
    ; colours and type, and each diagram at rest in the holo style, in the
    ; direction the stage chose. It used to be the markdown module's print
    ; layout — white paper, which lost a dark theme's light text, and the
    ; plain diagram laid out as written, a strip on a long chain. A surface
    ; effect cannot be printed and leaves the slide's own colour.
    ; What the deck calls itself, for an exported file's name: the front
    ; matter's `title`, or the first heading when there is none, or "".
    fn docTitle:string () {
        return (PresDocx.titleOf(deck.md.edit.doc))
    }

    ; The deck's music, the front matter's `music: media/song.mp3` (a file
    ; of the deck or an https address), "" when it has none (web/music.js).
    fn musicSrc:string () {
        return (trim (PresDeck.frontValue((this.source()) "music")))
    }

    ; The slides with an effect, "[1,3]", for the host to render before an
    ; export.
    fn fxSlidesJson:string () {
        def out:string "["
        def i:int 0
        def first:boolean true
        while (i < (deck.slideCount())) {
            def s:PresSlide (deck.slideAt(i))
            if ((strlen s.fx) > 0) {
                if (first == false) {
                    out = (out + ",")
                }
                first = false
                out = (out + (to_string i))
            }
            i = (i + 1)
        }
        return (out + "]")
    }

    ; The slides with a picture of their own (`bg=`) and no effect, "[2]":
    ; the host renders each as a still too, which the PPTX takes as the
    ; slide's background — the picture cut to the slide the way the stage
    ; cuts it, and dimmed as far as `bg-dim` says. The PDF draws them itself.
    fn bgSlidesJson:string () {
        def out:string "["
        def i:int 0
        def first:boolean true
        while (i < (deck.slideCount())) {
            def s:PresSlide (deck.slideAt(i))
            if (((strlen s.bg) > 0) && ((strlen s.fx) == 0)) {
                if (first == false) {
                    out = (out + ",")
                }
                first = false
                out = (out + (to_string i))
            }
            i = (i + 1)
        }
        return (out + "]")
    }

    fn fxJson:string (i:int) {
        return (this.listJson((deck.fxOnlyList(i))))
    }

    ; Effects rendered to pictures by the host for an export: slide index,
    ; pixels (RGBA, top row first) for the PDF, a JPEG for the PPTX.
    fn clearFxStills:void () {
        def a:[int]
        exporter.stillIdx = a
        def b:[buffer]
        exporter.stillRgba = b
        def c:[int]
        exporter.stillW = c
        def d:[int]
        exporter.stillH = d
        def e:[buffer]
        exporter.stillJpeg = e
        def f:[int]
        deck.fxStills = f
    }

    fn setFxStill:void (i:int rgba:buffer w:int h:int jpeg:buffer) {
        push exporter.stillIdx i
        push exporter.stillRgba rgba
        push exporter.stillW w
        push exporter.stillH h
        push exporter.stillJpeg jpeg
        ; only an effect's still stands in for it in the PDF
        def s:PresSlide (deck.slideAt(i))
        if ((strlen s.fx) > 0) {
            push deck.fxStills i
        }
    }

    ; The runs the host's contrast guard repaired on each slide, for the
    ; PPTX: the slide, the run's text, "colour" or "outline", and the colour
    ; it was given ("#rrggbb", for "colour").
    fn clearExportContrast:void () {
        def a:[int]
        exporter.fixSlide = a
        def b:[string]
        exporter.fixText = b
        def c:[string]
        exporter.fixKind = c
        def d:[string]
        exporter.fixColor = d
    }

    ; One slide's `lowContrast` list from the guard, as the stage keeps it.
    fn addExportContrast:void (i:int json:string) {
        exporter.addExportContrast(i json)
    }

    ; the slides an export writes: the picked ones, or all (picked false)
    fn exportOf:PresExport (picked:boolean) {
        this.settleAll()
        exporter.deck = deck
        def only:[int]
        if (picked && (picks.active())) {
            def i:int 0
            while (i < (deck.slideCount())) {
                if (picks.has(i)) {
                    push only i
                }
                i = (i + 1)
            }
        }
        exporter.only = only
        return exporter
    }

    fn pdf:buffer () {
        return ((this.exportOf(false)).pdf())
    }

    fn pptx:buffer () {
        return ((this.exportOf(false)).pptx())
    }

    ; --- picked slides (PresPick) ------------------------------------------------
    ; The PDF and the PPTX of only the picked slides; all of them when none
    ; is picked. The pages keep the numbers they have in the deck.
    fn pdfPicked:buffer () {
        return ((this.exportOf(true)).pdf())
    }

    fn pptxPicked:buffer () {
        return ((this.exportOf(true)).pptx())
    }

    ; --- Word (PresExport.docx) ----------------------------------------------------
    ; Two steps, because the stage draws some blocks (a diagram, a chart, a
    ; SmartArt) that only the host can turn into pictures: `docxBegin` names
    ; them, the host draws each one (`docxShotJson`) and hands the PNG to
    ; `setDocxShot`, and `docxEnd` writes the file. `picked`: only the picked
    ; slides, all of them when none is picked.
    fn docxBegin:string (picked:boolean) {
        return ((this.exportOf(picked)).docxShots())
    }

    fn docxShotJson:string (key:int) {
        return (this.listJson((exporter.word.shotList(deck key))))
    }

    fn setDocxShot:void (key:int png:buffer pxW:int pxH:int) {
        exporter.word.setShot(key png pxW pxH)
    }

    fn docxEnd:buffer () {
        return (exporter.docx())
    }

    ; The same shots, then the deck as one web page (PresExport.html).
    fn htmlEnd:string () {
        return (exporter.html())
    }

    fn pickCount:int () {
        return (picks.count())
    }

    ; "2,4,5": the picked slides' numbers
    fn pickList:string () {
        return (picks.list())
    }

    fn dropPicks:void () {
        if (picks.active()) {
            picks.clear()
            this.pickChanged()
        }
    }

    ; The bar's Export rows and the strip's menu offer the picked slides.
    fn pickChanged:void () {
        if (toolbar.picked != (picks.count())) {
            toolbar.picked = (picks.count())
            if ((strlen toolbar.css) > 0) {
                toolbar.rebuild()
            }
        }
        chromeRev = (chromeRev + 1)
    }

    ; The keys of the picked slides' sections, for a shared view's link
    ; (`?slides=`).
    fn pickKeys:string () {
        return (PresPick.keysOfPages(deck (this.source()) picks.pages))
    }

    ; `text` (the deck's Markdown, or the one a share has now) with only the
    ; sections `keys` names; "" when none of them is there. Sections are cut
    ; at the level this deck's slides break at.
    fn viewOf:string (text:string keys:string) {
        def l:MdLayout (deck.layout())
        return (PresPick.viewText(text l.splitLevel keys))
    }

    ; the picked slides' Markdown, for a link that carries its text
    fn pickViewText:string () {
        return (this.viewOf((this.source()) (this.pickKeys())))
    }













    fn statusText:string () {
        def n:int (deck.slideCount())
        return ((to_string n) + (PresI18n.t(" slides · ")) + (PresApp.secs((PresTimeline.total(deck)))))
    }
}

; a picture named in a line: its path and the columns it takes
class PresPicRef {
    def path:string ""
    def start:int 0
    def end:int 0
}
