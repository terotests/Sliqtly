        filePath = path
        ; JSON in a script's colours, CSS in the theme's, the rest plain
        def lower:string (to_lowercase path)
        if ((indexOf lower ".json") > 0) {
            fileEditor.setLanguage(jsonLang)
        } {
            if ((indexOf lower ".css") > 0) {
                fileEditor.setLanguage(cssLang)
            } {
                fileEditor.setLanguage(plainLang)
