            def endText:string (mdEditor.buf.lineAt(end))
            mdEditor.moveCaret(end (strlen endText) false)
            if ((strlen (trim text)) == 0) {
                mdEditor.insert((body + "\n"))
                line = end
            } {
                if ((strlen (trim endText)) == 0) {
                    mdEditor.insert(("\n" + body + "\n"))
                    line = (end + 1)
                } {
                    mdEditor.insert(("\n\n" + body + "\n"))
                    line = (end + 2)
                }
            }
        }
        editor = keep
        bufSynced = mdEditor.buf.version
        this.rebuildDeck()
        this.selectSlide((deck.pageOfOffset((this.offsetOf(line 0)))))
        if ((dup == false) || (from < 0)) {
            ; the heading's words selected, ready to be typed over
            mdEditor.moveCaret(line ((strlen level) + 1) false)
            mdEditor.moveCaret(line (strlen body) true)
        }
        chromeRev = (chromeRev + 1)
    }

    sfn isHeading:boolean (line:string) {
        return (((strlen line) > 0) && ((charAt line 0) == 35))
    }

    ; The slide's heading about 15% from the editor's top, so the lines above
    ; it show that the document goes on upwards. Left where it is when it is
    ; already comfortably in view; the first lines stay at the top.
    fn headingInView:void (line:int) {
        def lay:EditorLayout mdEditor.layout
        def vis:int (lay.visibleLineCount())
        def lead:int (to_int ((to_double vis) * 0.15))
        if ((line >= (lay.scrollLine + lead)) && (line <= ((lay.scrollLine + vis) - 4))) {
            return
        }
        def top:int (line - lead)
        if (top < 0) {
            top = 0
        }
        lay.jumpToLine(mdEditor.buf top)
    }

    fn revealThumb:void (i:int) {
        if (mode != "edit") {
            return
        }
        this.place()
        def x:double ((to_double i) * (thumbW + thumbGap))
        def view:double (stripRect.w - 24.0)
        if (x < stripScroll) {
            stripScroll = x
        }
        if ((x + thumbW) > (stripScroll + view)) {
            stripScroll = ((x + thumbW) - view)
        }
        if (stripScroll < 0.0) {
            stripScroll = 0.0
        }
    }

    ; =========================================================================
    ; Time
    ; =========================================================================
    fn slideShown:int () {
        return selected
    }

    ; The local time the stage draws the shown slide at.
    fn stageTime:double () {
        if ((selected < 0) || (selected >= (deck.slideCount()))) {
            return 0.0
        }
        def s:PresSlide (deck.slideAt(selected))
        if (playing || (mode == "present")) {
            def t:double (clock - (PresTimeline.slideStart(deck selected)))
            if (t < 0.0) {
                t = 0.0
            }
            return t
        }
        if (localT < 0.0) {
            return s.duration
        }
        return localT
    }

    fn isPlaying:boolean () {
        return (playing || (mode == "present"))
    }

    fn currentTime:double () {
        if (this.isPlaying()) {
            return clock
        }
        return ((PresTimeline.slideStart(deck selected)) + (this.stageTime()))
    }

    ; The host's clock. Returns the time the app accepted, which is less
    ; when a presentation is holding for a click.
    ;
    ; What was asked and not accepted, while playing on the same slide, is
    ; time the slide spent held, and its effect counts it (`effectTime`). The
    ; host asks one frame past the accepted time while held, so a jump of a
    ; second or more is a seek and not a hold.
    fn setTime:double (t:double) {
        def got:double (this.setClock(t))
        if (mode == "present") {
            this.inkFollow()
        }
        if (selected != fxSlide) {
            fxSlide = selected
            fxHeld = 0.0
        } {
            if (((this.isPlaying()) && (t > got)) && ((t - got) < 1.0)) {
                fxHeld = (fxHeld + (t - got))
            }
        }
        return got
    }

    ; The time the shown slide's surface effect is drawn at: from the moment
    ; the slide came on, and on through the holds, so a starfield or rain
    ; never stops on a slide waiting for a click. Below zero when nothing is
    ; playing: the editor's host runs its own clock for effects then.
    fn effectTime:double () {
        if (this.isPlaying()) {
            return ((this.stageTime()) + fxHeld)
        }
        return -1.0
    }

    fn setClock:double (t:double) {
        if ((deck.slideCount()) == 0) {
            return 0.0
        }
        def want:double t
        if (want < 0.0) {
            want = 0.0
        }
        if ((backWait > 0.0) && (this.isPlaying())) {
            if (want > clock) {
                backWait = (backWait - (want - clock))
            }
            chromeRev = (chromeRev + 1)
            return clock
        }
        ; a diagram asking which way to go stops the clock, in any mode
        if (this.isPlaying()) {
            def on:int selected
            if playing {
                on = (PresTimeline.slideAtTime(deck clock))
            }
            def dh:double (deck.diagramHold(on))
            def held:boolean false
            if (dh >= 0.0) {
                def stopAt:double ((PresTimeline.slideStart(deck on)) + dh)
                if ((clock <= (stopAt + 0.001)) && (want > stopAt)) {
                    want = stopAt
                    held = true
                }
            }
            ; A question no one answers (or a loop no one leaves) does not
            ; keep the room waiting: after `skipAfter` seconds it is skipped.
            if held {
                if (holdSince < 0.0) {
                    holdSince = deck.uiNow
                }
                def left:double (skipAfter - (deck.uiNow - holdSince))
                if (left <= 0.0) {
                    return (this.skipQuestion(on))
                }
                deck.setSkipLeft(on left)
            } {
                holdSince = -1.0
            }
        }
        if (mode == "present") {
            def start:double (PresTimeline.slideStart(deck selected))
            def s:PresSlide (deck.slideAt(selected))
            if auto {
                if (want >= (start + s.duration)) {
                    if (selected < ((deck.slideCount()) - 1)) {
                        selected = (selected + 1)
                        pStep = 0
                    } {
                        want = (start + s.duration)
                        ended = true
                    }
                }
                def sNow:PresSlide (deck.slideAt(selected))
                def local:double (want - (PresTimeline.slideStart(deck selected)))
                pStep = 0
                def k:int 1
                while (k <= sNow.steps) {
                    if ((PresTimeline.stepTime(sNow k)) <= local) {
                        pStep = k
                    }
                    k = (k + 1)
                }
            } {
                def hold:double (start + s.duration)
                if (pStep < s.steps) {
                    hold = (start + (PresTimeline.stepTime(s (pStep + 1))))
                }
                if (want > hold) {
                    want = hold
                }
            }
            clock = want
            chromeRev = (chromeRev + 1)
            return clock
        }
        if playing {
            def total:double (PresTimeline.total(deck))
            if (want >= total) {
                want = total
                playing = false
                localT = -1.0
            }
            clock = want
            def was:int selected
            selected = (PresTimeline.slideAtTime(deck want))
            if (selected != was) {
                this.revealThumb(selected)
            }
            if (! playing) {
                localT = -1.0
            }
            chromeRev = (chromeRev + 1)
            return clock
        }
        return (this.currentTime())
    }

    ; Play from the selected slide's start (or from the playhead, when the
    ; tracks have been scrubbed).
    fn play:void () {
        if ((deck.slideCount()) == 0) {
            return
        }
        def start:double (PresTimeline.slideStart(deck selected))
        if (localT >= 0.0) {
            start = (start + localT)
        }
        clock = start
        playing = true
        deck.resetExplore()
        ; playing is not editing: the pick and its popover go
        this.dropPick()
        chromeRev = (chromeRev + 1)
    }

    fn dropPick:void () {
        if hintFromStage {
            this.closeHint()
        }
        pick.clear()
    }

    fn stop:void () {
        playing = false
        localT = (this.clampLocal((clock - (PresTimeline.slideStart(deck selected)))))
        chromeRev = (chromeRev + 1)
    }

    fn clampLocal:double (t:double) {
        if ((selected < 0) || (selected >= (deck.slideCount()))) {
            return -1.0
        }
        def s:PresSlide (deck.slideAt(selected))
        if (t < 0.0) {
            return 0.0
        }
        if (t >= s.duration) {
            return -1.0
        }
        return t
    }

    ; =========================================================================
    ; Steering a diagram
    ; =========================================================================
    fn slidePoint:void (x:double y:double) {
        def sc:double (this.slideScale())
        spX = ((x - slideRect.x) / sc)
        spY = ((y - slideRect.y) / sc)
    }

    def spX:double 0.0
    def spY:double 0.0

    ; The pointer over the stage (`top` is the surface over it, "" for the
    ; stage itself): a diagram under it shows its buttons, the others let
    ; theirs fade.
    fn diagramPointer:void (x:double y:double top:string) {
        def k:int -1
        if (((strlen top) == 0) && (slideRect.has(x y))) {
            this.slidePoint(x y)
            k = (deck.diagramAt(selected spX spY))
        }
        deck.diagramPointer(selected k (this.stageTime()) spX spY)
        ; a chart's words cut to fit: shown whole under the pointer
        if (k < 0) {
            if (((strlen top) == 0) && (slideRect.has(x y))) {
                deck.chartPointer(selected spX spY)
            } {
                deck.chartPointer(-1 0.0 0.0)
            }
        }
    }

    ; The pointer left the page.
    fn pointerLeft:void () {
        if (barH > 0.0) {
            toolbar.hoverAt(-1000000.0 -1000000.0)
        }
        this.chromeHoverAt(-1000000.0 -1000000.0 "")
        sketch.hoverAt(-1000000.0 -1000000.0)
        chart.hoverAt(-1000000.0 -1000000.0 false)
        review.hoverAt(-1000000.0 -1000000.0 false)
        chromeRev = (chromeRev + 1)
        deck.diagramPointer(selected -1 0.0 0.0 0.0)
        deck.chartPointer(-1 0.0 0.0)
