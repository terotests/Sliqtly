            id = (UiTree.hoverIdAt((unwrap chromeRoot) x y hoverCls))
        }
        if (id != chromeHover) {
            chromeHover = id
            chromeRev = (chromeRev + 1)
        }
    }

    ; A press on the stage that meant something to a diagram.
    fn stagePress:boolean (x:double y:double) {
        if (! (slideRect.has(x y))) {
            return false
        }
        this.slidePoint(x y)
        if (deck.tablePress(selected spX spY)) {
            chromeRev = (chromeRev + 1)
            return true
        }
        def code:string (deck.diagramHit(selected (this.stageTime()) spX spY))
        ; a finger has no hover: the press brings the buttons up (after the
        ; hit, so a tap where a hidden button is does not press it)
        if touch {
