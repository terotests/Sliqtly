    }

    ; ▶ / ■ on a diagram (or T when presenting): the tour started from the
    ; top, or stopped with the whole diagram shown.
    fn toggleTour:boolean (k:int) {
        def hit@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hit) {
            return false
        }
        def du:PresDiaUse (unwrap hit)
        if (du.diagram.canTour == false) {
            return false
        }
        def on:boolean (du.diagram.tour == false)
        du.diagram.setTour(on)
        PresTimeline.plan((deck.slideAt(selected)))
        if on {
            localT = du.start
            if (localT < 0.0) {
                localT = 0.0
            }
            this.play()
        } {
            ; stopped: the diagram as it stands at the end of its reveal
            localT = (du.start + du.diagram.total)
        }
        chromeRev = (chromeRev + 1)
        return true
    }

    fn diagramPick:void (k:int i:int) {
        def hit@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hit) {
            return
        }
        def u:PresDiaUse (unwrap hit)
        def local:double (this.stageTime())
        ; a choice made: the walk's camera takes over again
        u.diagram.exploreHome()
        if (u.diagram.pick(i)) {
            PresTimeline.plan((deck.slideAt(selected)))
            if (! (this.isPlaying())) {
                localT = local
                this.play()
            }
        }
        chromeRev = (chromeRev + 1)
    }

    fn diagramBack:void (k:int) {
        def hit@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hit) {
            return
        }
        def u:PresDiaUse (unwrap hit)
        u.diagram.exploreHome()
        def local:double ((u.start) + (u.diagram.back(((this.stageTime()) - u.start))))
        PresTimeline.plan((deck.slideAt(selected)))
        if (this.isPlaying()) {
            clock = ((PresTimeline.slideStart(deck selected)) + local)
            backWait = 1.2
        } {
            localT = local
        }
        chromeRev = (chromeRev + 1)
    }

    ; Keys for a diagram that is asking, or for going back in one. True when
    ; the key was taken.
    fn diagramKey:boolean (name:string) {
        ; Esc puts a diagram opened over the slide back first
        if ((name == "escape") && (deck.closeFull(selected))) {
            chromeRev = (chromeRev + 1)
            return true
        }
        def t:double (this.stageTime())
        def k:int (deck.askingAt(selected t))
        def sl0:PresSlide (deck.slideAt(selected))
        if ((array_length sl0.diagrams) > 0) {
            def ue:PresDiaUse (itemAt sl0.diagrams 0)
            def ued:PresDiagram (ue.active(deck.uiNow))
            if ((name == "+") || (name == "=")) {
                ued.zoomBy(1.4)
                chromeRev = (chromeRev + 1)
                return true
            }
            if (name == "-") {
                ued.zoomBy((1.0 / 1.4))
                chromeRev = (chromeRev + 1)
                return true
            }
            if (name == "0") {
                ued.exploreOverview()
                chromeRev = (chromeRev + 1)
                return true
            }
            ; exploring: arrows choose the way on, Enter takes it
            def te:double (ue.activeTime(t deck.uiNow))
            if ((name == "left") || (name == "up")) {
                if (ued.exMoveSel(-1 te)) {
                    chromeRev = (chromeRev + 1)
                    return true
                }
            }
            if ((name == "right") || (name == "down")) {
                if (ued.exMoveSel(1 te)) {
                    chromeRev = (chromeRev + 1)
                    return true
                }
            }
            if ((name == "enter") || (name == "space")) {
                if (ued.exGo(-1 te)) {
                    chromeRev = (chromeRev + 1)
                    return true
                }
            }
            if ((name == "backspace") && ued.exploring) {
                ued.exploreBack()
                chromeRev = (chromeRev + 1)
                return true
            }
        }
        if (name == "backspace") {
            def s:PresSlide (deck.slideAt(selected))
            if ((array_length s.diagrams) > 0) {
                def u0:PresDiaUse (itemAt s.diagrams 0)
                if (u0.diagram.canGoBack((t - u0.start))) {
                    this.diagramBack(0)
                    return true
                }
            }
            return false
        }
        if (k < 0) {
            return false
        }
        def hit@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hit) {
            return false
        }
        def u:PresDiaUse (unwrap hit)
        if ((name == "left") || (name == "up")) {
            u.diagram.moveSel(-1)
            chromeRev = (chromeRev + 1)
            return true
        }
        if ((name == "right") || (name == "down")) {
            u.diagram.moveSel(1)
            chromeRev = (chromeRev + 1)
            return true
        }
        if ((name == "enter") || (name == "space")) {
            this.diagramPick(k u.diagram.optSel)
            return true
        }
        if (((strlen name) == 1) && (((charAt name 0) >= 49) && ((charAt name 0) <= 57))) {
            this.diagramPick(k ((charAt name 0) - 49))
            return true
        }
        return false
    }

    ; =========================================================================
    ; Presenting
    ; =========================================================================
    fn present:void (fromStart:boolean) {
        this.dropPick()
        ; the comments' panel opens only when asked for
        review.closePanel()
        mode = "present"
        this.viewReset()
        activeDia = -1
        playing = false
        ink.clear()
        ink.hidePointer()
        inkSlide = -1
        if fromStart {
            selected = 0
        }
        ended = false
        pStep = 0
        nav.clear()
        clock = (PresTimeline.slideStart(deck selected))
        elapsed = 0.0
        deck.resetExplore()
        push requests "fullscreen"
        chromeRev = (chromeRev + 1)
    }

    fn endPresent:void () {
        if (mode != "present") {
            return
        }
        if recording {
            this.recordStop()
        }
        if replaying {
            replaying = false
            push requests "replay:stop"
        }
        ink.clear()
        ink.hidePointer()
        inkPress = false
        inkLine = false
        mode = "edit"
        ended = false
        this.viewReset()
        activeDia = -1
        localT = -1.0
        push requests "exit-fullscreen"
        this.selectSlide(selected)
        chromeRev = (chromeRev + 1)
    }

    fn setElapsed:void (s:double) {
        elapsed = s
    }

    ; A click, a space, an arrow: the next build step, or the next slide.
    fn next:void () {
        if ((deck.slideCount()) == 0) {
            return
        }
        if (this.bookShow()) {
            def to:int (PresBook.nextPage((deck.book()) selected (deck.slideCount())))
            if (to < 0) {
                ended = true
            } {
                selected = to
                this.viewReset()
                activeDia = -1
                def ts:PresSlide (deck.slideAt(to))
                pStep = ts.steps
                clock = (PresTimeline.slideStart(deck selected))
            }
            this.inkFollow()
            chromeRev = (chromeRev + 1)
            return
        }
        def s:PresSlide (deck.slideAt(selected))
        if (pStep < s.steps) {
            pStep = (pStep + 1)
            ; A click during the step's own run shows it at once rather than
            ; waiting for the clock to reach it.
            def at:double ((PresTimeline.slideStart(deck selected)) + (PresTimeline.stepTime(s pStep)))
            if (clock < at) {
                clock = at
            }
        } {
            if (selected < ((deck.slideCount()) - 1)) {
                selected = (selected + 1)
                this.viewReset()
                activeDia = -1
                pStep = 0
                clock = (PresTimeline.slideStart(deck selected))
            } {
                ended = true
            }
        }
        this.inkFollow()
        chromeRev = (chromeRev + 1)
    }

    ; Presenting and gone past the end: the page offers a way on.
    fn atEnd:boolean () {
        return ((mode == "present") && ended)
    }

    ; The end panel's Restart: the first slide, the clock at its start.
    fn restart:void () {
        if (mode != "present") {
            return
        }
        ended = false
        selected = 0
        pStep = 0
        this.viewReset()
        activeDia = -1
        clock = (PresTimeline.slideStart(deck selected))
        deck.resetExplore()
        chromeRev = (chromeRev + 1)
    }

    fn prev:void () {
        if ended {
            ; back from the end panel to the last slide as it was left
            ended = false
            chromeRev = (chromeRev + 1)
            return
        }
        if (this.bookShow()) {
            def back:int (PresBook.prevPage((deck.book()) selected (deck.slideCount())))
            if (back >= 0) {
                this.jump((PresNav.whole(deck back)))
            }
            return
        }
        if (selected <= 0) {
            clock = 0.0
            pStep = 0
            chromeRev = (chromeRev + 1)
            return
        }
        selected = (selected - 1)
        this.viewReset()
        activeDia = -1
        def s:PresSlide (deck.slideAt(selected))
        pStep = s.steps
        clock = ((PresTimeline.slideStart(deck selected)) + s.duration)
        this.inkFollow()
        chromeRev = (chromeRev + 1)
    }

    ; A jump (PresNav): straight to where it lands, no transition on the way.
    fn jump:void (at:PresNavAt) {
        if ((mode != "present") || ((deck.slideCount()) == 0)) {
            return
        }
        nav.clear()
        selected = at.slide
        pStep = at.step
        clock = at.clock
        ended = at.ended
        this.viewReset()
        activeDia = -1
        this.inkFollow()
        chromeRev = (chromeRev + 1)
    }

    ; Home, ⏮: the first slide from its start.
    fn firstSlide:void () {
        this.jump((PresNav.first(deck)))
        deck.resetExplore()
    }

    ; End: the last slide, whole.
    fn lastSlide:void () {
        this.jump((PresNav.last(deck)))
    }

    ; PageDown / PageUp: the next / previous slide, whole.
    fn pageNext:void () {
        if (this.bookShow()) {
            def to:int (PresBook.nextPage((deck.book()) selected (deck.slideCount())))
            if (to < 0) {
                def at:PresNavAt (PresNav.whole(deck selected))
                at.ended = true
                this.jump(at)
            } {
                this.jump((PresNav.whole(deck to)))
            }
            return
        }
        this.jump((PresNav.pageNext(deck selected ended)))
    }

    fn pagePrev:void () {
        if (this.bookShow()) {
            this.prev()
            return
        }
        this.jump((PresNav.pagePrev(deck selected ended)))
    }

    ; Presenting a book: a spread at a time.
    fn bookShow:boolean () {
        return ((mode == "present") && ((deck.book()).isBook()))
    }

    ; Presenting a `render: realistic` book: the page draws the spread as
    ; paper and turns its pages (layoutJson's "book"), not the stage.
    fn bookTurns:boolean () {
        return ((this.bookShow()) && ((deck.book()).isRealistic()) && ((deck.slideCount()) > 0))
    }

    ; Slide `text` (a number from 1, as the counter shows it), whole. False
    ; when it is no number.
    fn goToSlide:boolean (text:string) {
        def k:int (PresNav.number(text (deck.slideCount())))
        if ((k < 0) || (mode != "present")) {
            return false
        }
        this.jump((PresNav.whole(deck k)))
        return true
    }

    ; The counter: "3 / 12", or the number being typed.
    fn slideLabel:string () {
        if (this.bookShow()) {
            return (PresBook.label((deck.book()) selected (deck.slideCount()) nav.typed))
        }
        return (PresNav.label(selected (deck.slideCount()) nav.typed))
    }

    fn navTyping:boolean () {
        return (nav.typing())
    }

    fn navClear:void () {
        if (nav.typing()) {
            nav.clear()
            chromeRev = (chromeRev + 1)
        }
    }

    ; =========================================================================
    ; Drawing on the slide and recording the presentation (PresInk, PresRecord)
    ; =========================================================================
    ;
    ; Presenting with the pen on, a press on the slide that moves draws (a
    ; press that does not still goes on), the pointer over the slide is drawn
    ; as an arrow, Backspace wipes the drawing and a new slide starts clean.
    ; Record is presenting from the start with the pen on and everything
    ; written down (PresRecorder); the host records the voice beside it and
    ; keeps both in the deck's recordings/. A replay drives the presentation
    ; from the recording: the host gives the time (`replayAt`), the app goes
    ; where the recording went and draws what was drawn then.
    def ink:PresInk (new PresInk())
    def inkOn:boolean false
    def inkTool:string "pen"
    def inkColor:string "#ef4444"
    ; on a slide 1280 wide; a narrower slide draws thinner
    def inkWidth:double 6.0
    def inkSlide:int -1
    def inkPress:boolean false
    def inkLine:boolean false
    ; the press ended a text being written (and does nothing else)
    def inkEnded:boolean false
    def inkSX:double 0.0
    def inkSY:double 0.0
    ; writing has been (or may be) shown: the page loads its face
    def inkFace:boolean false
    def recording:boolean false
    def recorder:PresRecorder (new PresRecorder())
    def recT:double 0.0
    ; the deck's recording (recordings/take.json), empty when it has none
    def take:PresRecording (new PresRecording())
    def replaying:boolean false
    def replay:PresReplay (new PresReplay())
    def replayT:double 0.0

    fn inkActive:boolean () {
        return ((((mode == "present") && (recording || inkOn)) && (replaying == false)) && (ended == false))
    }

    ; The clock the pointer's fading goes by: the recording's while one is
    ; made or played, so a replay fades it as it faded.
    fn inkNow:double () {
        if recording {
            return recT
        }
        if replaying {
            return replayT
        }
        if ((mode == "edit") && recEditing) {
            return recHead
        }
        return deck.uiNow
    }

    fn inkUnit:double () {
        if (deck.pageW <= 0.0) {
            return 1.0
        }
        return (deck.pageW / 1280.0)
    }

    fn shownInk:PresInk () {
        if replaying {
            return replay.ink
        }
        if ((mode == "edit") && recEditing) {
            return recPrev.ink
        }
        return ink
    }

    fn setInk:void (on:boolean) {
        inkOn = on
        if (on == false) {
            this.inkEndText()
            this.inkHide()
        }
        chromeRev = (chromeRev + 1)
    }

    fn setInkTool:void (t:string) {
        if (PresInk.knownTool(t)) {
            inkTool = t
            inkOn = true
            if (t == "text") {
                inkFace = true
            } {
                this.inkEndText()
            }
            chromeRev = (chromeRev + 1)
        }
    }

    fn setInkColor:void (c:string) {
        if ((strlen c) > 0) {
            inkColor = c
            chromeRev = (chromeRev + 1)
        }
    }

    ; For the presenting bar: {"on","tool","color","recording","replaying",
    ; "t","duration","take","voice","strokes"}.
    fn inkState:string () {
        def o:VlJson (VlJson.objectValue())
        o.setMember("on" (VlJson.boolValue((recording || inkOn))))
        o.setMember("tool" (VlJson.stringValue(inkTool)))
        o.setMember("color" (VlJson.stringValue(inkColor)))
        o.setMember("recording" (VlJson.boolValue(recording)))
        o.setMember("replaying" (VlJson.boolValue(replaying)))
        o.setMember("t" (VlJson.numberValue((? replaying replayT recT))))
        o.setMember("duration" (VlJson.numberValue(take.duration)))
        o.setMember("take" (VlJson.boolValue((this.hasRecording()))))
        o.setMember("voice" (VlJson.stringValue(take.voice)))
        o.setMember("audio" (VlJson.stringValue(take.audio)))
        o.setMember("strokes" (VlJson.intValue(((this.shownInk()).count()))))
        o.setMember("typing" (VlJson.boolValue(ink.typing)))
        def w (new VlJsonWriter())
        return (w.write(o))
    }

    ; What is drawn on the shown slide and the pointer, as a list in the
    ; slide's units (the host draws it with the stage's camera), "" when
    ; there is nothing.
    ; How wide the last line being written is, in the hand-written face as
    ; the slides measure it; -1 until the face is here.
    fn inkCaretW:double (k:PresInk) {
        if (((k.typing == false) || ((array_length k.strokes) == 0)) || ((deck.md.fontManager.hasFont((PresInk.FACE()))) == false)) {
            return -1.0
        }
        def s:PresInkStroke (itemAt k.strokes ((array_length k.strokes) - 1))
        def lines:[string] (strsplit s.text "\n")
        def last:string ""
        if ((array_length lines) > 0) {
            last = (itemAt lines ((array_length lines) - 1))
        }
        return (deck.md.fontManager.measureText(last (PresInk.FACE()) (PresInk.textSize(s))))
    }

    fn inkJson:string () {
        if ((((mode != "present") && (recEditing == false)) || ((deck.slideCount()) == 0))) {
            return ""
        }
        def k:PresInk (this.shownInk())
        def now:double (this.inkNow())
        if (((k.count()) == 0) && ((k.pointerAlpha(now)) <= 0.0)) {
            return ""
        }
        def dl (new EVGDisplayList())
        k.caretW = (this.inkCaretW(k))
        k.draw(dl now (this.inkUnit()))
        return (this.listJson(dl))
    }

    ; The pointer is fading: the host paints again.
    fn inkBusy:boolean () {
        if (mode != "present") {
            return false
        }
        return ((this.shownInk()).busy((this.inkNow())))
    }

    fn inkDown:void (x:double y:double) {
        def w:double (inkWidth * (this.inkUnit()))
        ink.down(inkTool inkColor w x y)
        if recording {
            recorder.rec.down(recT inkTool inkColor w x y)
        }
        chromeRev = (chromeRev + 1)
    }

    fn inkMove:void (x:double y:double) {
        ink.move(x y)
        if recording {
            recorder.rec.move(recT x y)
        }
        chromeRev = (chromeRev + 1)
    }

    fn inkUp:void () {
        ink.up()
        if recording {
            recorder.rec.up(recT)
        }
        chromeRev = (chromeRev + 1)
    }

    fn inkClear:void () {
        if (((ink.count()) == 0) && (ink.drawing == false)) {
            return
        }
        ink.clear()
        if recording {
            recorder.rec.clear(recT)
        }
        chromeRev = (chromeRev + 1)
    }

    fn inkHide:void () {
        if (ink.ptrAt >= 0.0) {
            ink.hidePointer()
            if recording {
                recorder.rec.hide(recT)
            }
            chromeRev = (chromeRev + 1)
        }
    }

    ; --- writing on the slide ---------------------------------------------------

    fn inkTextAt:void (x:double y:double) {
        def w:double (inkWidth * (this.inkUnit()))
        ink.startText(inkColor w x y)
        if recording {
            recorder.rec.textStart(recT inkColor w x y)
        }
        inkFace = true
        chromeRev = (chromeRev + 1)
    }

    ; `s` typed with the pen on: written on the slide, from where the pointer
    ; is (or near the top left when it is off the slide), on what is being
    ; written when something is.
    fn inkType:void (s:string) {
        if (ink.typing == false) {
            def x:double (deck.pageW * 0.06)
            def y:double (deck.pageH * 0.08)
            if (ink.ptrAt >= 0.0) {
                x = ink.ptrX
                y = (ink.ptrY - ((inkWidth * (this.inkUnit())) * 4.5))
                if (y < 0.0) {
                    y = 0.0
                }
            }
            this.inkTextAt(x y)
        }
        this.inkSetText(((ink.typed()) + s))
    }

    ; Letters write on the slide only with the text tool (Aa) or while a
    ; text is being written; otherwise they are the presentation's own keys
    ; (S the speaker view, R the data).
    fn inkWrites:boolean () {
        return ((this.inkActive()) && (ink.typing || (inkTool == "text")))
    }

    fn inkSetText:void (t:string) {
        ink.setText(t)
        if recording {
            recorder.rec.type(recT t)
        }
        chromeRev = (chromeRev + 1)
    }

    ; Backspace while writing: the last letter goes.
    fn inkBack:void () {
        def t:string (ink.typed())
        if ((strlen t) > 0) {
            this.inkSetText((substring t 0 ((strlen t) - 1)))
        }
    }

    fn inkEndText:void () {
        if (ink.typing == false) {
            return
        }
        ink.endText()
        if recording {
            recorder.rec.textEnd(recT)
        }
        chromeRev = (chromeRev + 1)
    }

    ; The keys while a text is written: only the arrows and Page Up / Page
    ; Down change slides (Space and Enter do not); otherwise Backspace wipes
    ; the drawing and the rest are the presentation's. True when the key was
    ; the pen's.
    fn inkKey:boolean (name:string shift:boolean) {
        def nav:boolean (((((name == "right") || (name == "left")) || (name == "up")) || (name == "down")) || ((name == "pageUp") || (name == "pageDown")))
        if ink.typing {
            if (name == "backspace") {
                this.inkBack()
                return true
            }
            if (name == "enter") {
                if shift {
                    this.inkSetText(((ink.typed()) + "\n"))
                } {
                    this.inkEndText()
                }
                return true
            }
            if (name == "escape") {
                this.inkEndText()
                return true
            }
            this.inkEndText()
            return (nav == false)
        }
        if (name == "backspace") {
            this.inkClear()
            return true
        }
        return false
    }

    ; The page fetches the hand-written face once writing is about.
    fn inkFaceWanted:boolean () {
        return inkFace
    }

    ; The pointer over the stage while presenting with the pen.
    fn inkHover:void (x:double y:double) {
        if ((this.inkActive()) == false) {
            return
        }
        if (slideRect.has(x y)) {
            this.slidePoint(x y)
            ink.pointer(spX spY (this.inkNow()))
            if recording {
                recorder.pointer(recT spX spY)
            }
            chromeRev = (chromeRev + 1)
        } {
            this.inkHide()
        }
    }

    ; A new slide starts clean (and so does the end panel).
    fn inkFollow:void () {
        if (mode != "present") {
            return
        }
        def at:int selected
        if ended {
            at = -2
        }
        if (at != inkSlide) {
            if (inkSlide != -1) {
                this.inkClear()
            }
            inkSlide = at
        }
    }

    ; --- recording ------------------------------------------------------------

    ; Record: present from the first slide with everything written down. The
    ; host starts the microphone ("record:start") and gives the time
    ; (`recordTime`) each frame.
    fn record:void () {
        if ((deck.slideCount()) == 0) {
            return
        }
        replaying = false
        this.present(true)
        recording = true
        recorder = (new PresRecorder())
        recorder.rec.voice = take.voice
        recT = 0.0
        ink.clear()
        inkSlide = selected
        recorder.observe(0.0 selected pStep clock ended)
        push requests "record:start"
        chromeRev = (chromeRev + 1)
    }

    fn isRecording:boolean () {
        return recording
    }

    fn recordTime:void (t:double) {
        if (recording == false) {
            return
        }
        recT = t
        if (mode == "present") {
            this.inkFollow()
            recorder.observe(t selected pStep clock ended)
        }
    }

    ; The end of the recording (■, Esc, the presentation left): it becomes
    ; the deck's take; the host keeps the sound and the file
    ; ("record:stop", then `recordingJson`).
    fn recordStop:void () {
        if (recording == false) {
            return
        }
        recording = false
        if (recT > recorder.rec.duration) {
            recorder.rec.duration = recT
        }
        take = recorder.rec
        ink.clear()
        push requests "record:stop"
        chromeRev = (chromeRev + 1)
    }

    fn hasRecording:boolean () {
        return ((take.count()) > 0)
    }

    fn recordingJson:string () {
        return (take.toJson())
    }

    fn recordingDuration:double () {
        return take.duration
    }

    fn recordingVoice:string () {
        return take.voice
    }

    fn recordingAudio:string () {
        return take.audio
    }

    ; The recording as played, its cuts skipped: how long, the time
    ; played at source time t, the source time at played time p, and t
    ; moved past a cut it falls in.
    fn recordingPlayLength:double () {
        return (take.playLength())
    }

    fn recordingPlayTime:double (t:double) {
        return (take.toPlay(t))
    }

    fn recordingSourceTime:double (p:double) {
        return (take.toSource(p))
    }

    fn recordingSkip:double (t:double) {
        return (take.skip(t))
    }

    fn setRecordingAudio:void (path:string) {
        take.audio = path
    }

    fn setRecordingVoice:void (v:string) {
        if ((strlen v) > 0) {
            take.voice = v
            toolbar.recVoice = v
            toolbar.rebuild()
            chromeRev = (chromeRev + 1)
        }
    }

    ; The deck's recordings/take.json, read when the deck opens ("" none).
    fn loadRecording:void (text:string) {
        def was:string take.audio
        take = (PresRecording.parse(text))
        if (take.audio != was) {
            def none:[double]
            recPeaks = none
        }
        if recEditing {
            if ((take.count()) == 0) {
                recEditing = false
            } {
                recPrev.load(take)
            }
        }
        if (take.hasText()) {
            inkFace = true
        }
        toolbar.hasRec = ((take.count()) > 0)
        toolbar.recVoice = take.voice
        toolbar.rebuild()
        chromeRev = (chromeRev + 1)
    }

    fn dropRecording:void () {
        take = (new PresRecording())
        recEditing = false
        def none:[double]
        recPeaks = none
        toolbar.hasRec = false
        toolbar.rebuild()
        chromeRev = (chromeRev + 1)
    }

    ; --- playing it back --------------------------------------------------------

    ; From `t` seconds into the recording: presenting, driven by it. The
    ; host plays the sound ("replay:start") and gives the time each frame.
    fn replayStart:void (t:double) {
        if ((this.hasRecording()) == false) {
            return
        }
        if recording {
            this.recordStop()
        }
        this.present(true)
        replaying = true
        replay.load(take)
        replayT = 0.0
        this.replayAt(t)
        push requests "replay:start"
        chromeRev = (chromeRev + 1)
    }

    fn isReplaying:boolean () {
        return replaying
    }

    fn replayTime:double () {
        return replayT
    }

    ; The recording at time t: the presentation where it was, the drawing
    ; as it was. Returns the deck clock.
    fn replayAt:double (t:double) {
        if ((replaying == false) || (mode != "present")) {
            return clock
        }
        replayT = t
        replay.seek(t)
        if (replay.takeNav()) {
            def o:PresRecOp (replay.navOp())
            def at (new PresNavAt())
            at.slide = o.slide
            if (at.slide >= (deck.slideCount())) {
                at.slide = ((deck.slideCount()) - 1)
            }
            at.step = o.step
            at.clock = o.clock
            at.ended = o.ended
            this.jump(at)
        }
        def got:double (this.setTime((replay.clockAt(t))))
        chromeRev = (chromeRev + 1)
        return got
    }

    ; Play recording: from where the recording first shows the selected
    ; slide, else from its start.
    fn replayFromSlide:void () {
        def at:double (take.slideStart(selected))
        if (at < 0.0) {
            at = 0.0
        }
        this.replayStart(at)
    }

    fn replayStop:void () {
        if (replaying == false) {
            return
        }
        replaying = false
        this.endPresent()
    }

    ; --- the recording's timeline: seeing it whole and cutting parts away -------
    ;
    ; Record ▸ Edit recording (or Edit on the recording's row in Files) turns
    ; the tracks under the slide into the whole recording: the slides it
    ; showed, its voice and where something was drawn, with the parts cut
    ; away shaded. A drag marks a part, Cut cuts it away (PresRecording cuts:
    ; nothing is removed, playing skips it), a click puts the playhead there
    ; and shows the slide and the drawing as they were then; on a cut, Put
    ; back returns it. Each change is kept ("rec:save").
    def recEditing:boolean false
    def recSelA:double -1.0
    def recSelB:double -1.0
    def recHead:double 0.0
    def recPress:boolean false
    def recPressX:double 0.0
    ; the playhead itself pressed: a drag moves it
    def recScrub:boolean false
    ; the voice's loudness, one value (0…1) for each RECPEAK seconds
    def recPeaks:[double]
    def recPrev:PresReplay (new PresReplay())

    sfn RECPEAK:double () {
        return 0.1
    }

    fn recEditOpen:void (on:boolean) {
        if (on && ((this.hasRecording()) == false)) {
            return
        }
        recEditing = on
        recSelA = -1.0
        recSelB = -1.0
        recPress = false
        if on {
            recPrev.load(take)
            this.recShowAt(recHead)
            if (((array_length recPeaks) == 0) && ((strlen take.audio) > 0)) {
                push requests "rec:peaks"
            }
        }
        chromeRev = (chromeRev + 1)
    }

    fn isRecEditing:boolean () {
        return recEditing
    }

    ; The page's measure of the voice: "0.1,0.52,…", one for each RECPEAK s.
    fn setRecordingPeaks:void (text:string) {
        def out:[double]
        def parts:[string] (strsplit text ",")
        def i:int 0
        while (i < (array_length parts)) {
            def v:double (?? (str2double (trim (itemAt parts i))) 0.0)
            if (v < 0.0) { v = 0.0 }
            if (v > 1.0) { v = 1.0 }
            push out v
            i = (i + 1)
        }
        recPeaks = out
        chromeRev = (chromeRev + 1)
    }

    fn recX:double (t:double) {
        if (take.duration <= 0.0) {
            return laneX
        }
        return (laneX + ((t / take.duration) * laneW))
    }

    fn recTimeAt:double (x:double) {
        if (laneW <= 0.0) {
            return 0.0
        }
        def t:double (((x - laneX) / laneW) * take.duration)
        if (t < 0.0) { t = 0.0 }
        if (t > take.duration) { t = take.duration }
        return t
    }

    ; The selection, in order; -1 none (too short to be one).
    fn recSelFrom:double () {
        if ((fabs (recSelB - recSelA)) < 0.05) {
            return -1.0
        }
        if (recSelA < recSelB) {
            return recSelA
        }
        return recSelB
    }

    fn recSelTo:double () {
        if ((fabs (recSelB - recSelA)) < 0.05) {
            return -1.0
        }
        if (recSelA < recSelB) {
            return recSelB
        }
        return recSelA
    }

    ; The slide and the drawing as the recording had them at t.
    fn recShowAt:void (t:double) {
        recHead = t
        recPrev.seek(t)
        def o:PresRecOp (recPrev.navOp())
        if ((deck.slideCount()) > 0) {
            def k:int o.slide
            if (k >= (deck.slideCount())) {
                k = ((deck.slideCount()) - 1)
            }
            if (k != selected) {
                this.selectSlide(k)
            }
            def s:PresSlide (deck.slideAt(k))
            def lt:double (recPrev.clockAt(t))
            if (o.ended || (lt >= s.duration)) {
                localT = -1.0
            } {
                localT = lt
            }
        }
        chromeRev = (chromeRev + 1)
    }

    ; The buttons over the timeline: id, label, and where (x, width), right
    ; to left.
    fn recButtons:[string] () {
        def out:[string]
        push out "close"
        push out "✕"
        if ((take.cutAt(recHead)) >= 0) {
            push out "restore"
            push out (PresI18n.t("↺ Put back"))
        }
        if ((this.recSelFrom()) >= 0.0) {
            push out "cut"
            push out (PresI18n.t("✂ Cut"))
        }
        push out "play"
        push out (PresI18n.t("▶ Play"))
        return out
    }

    sfn recButtonW:double (label:string) {
        return (((to_double (strlen label)) * 7.0) + 22.0)
    }

    ; The button at x, y ("" none).
    fn recButtonAt:string (x:double y:double) {
        def r:PresRect trackRect
        if ((y < (r.y + 3.0)) || (y > (r.y + 25.0))) {
            return ""
        }
        def bs:[string] (this.recButtons())
        def right:double ((r.x + r.w) - 10.0)
        def i:int 0
        while ((i + 1) < (array_length bs)) {
            def w:double (PresApp.recButtonW((itemAt bs (i + 1))))
            if ((x >= (right - w)) && (x <= right)) {
                return (itemAt bs i)
            }
            right = ((right - w) - 6.0)
            i = (i + 2)
        }
        return ""
    }

    fn recTimelineDown:void (x:double y:double) {
        def b:string (this.recButtonAt(x y))
        if ((strlen b) > 0) {
            this.recButton(b)
            return
        }
        ; on the playhead: dragged, it goes through the recording
        if ((fabs (x - (this.recX(recHead)))) <= 8.0) {
            recScrub = true
            this.recShowAt((this.recTimeAt(x)))
            return
        }
        if ((x >= laneX) && (x <= (laneX + laneW))) {
            recPress = true
            recPressX = x
            recSelA = (this.recTimeAt(x))
            recSelB = recSelA
            chromeRev = (chromeRev + 1)
        }
    }

    ; The pointer moving with the timeline pressed: the playhead dragged,
    ; or a part marked; the slide shows the moment the pointer is at.
    fn recTimelineMove:void (x:double) {
        def t:double (this.recTimeAt(x))
        if recPress {
            recSelB = t
        }
        this.recShowAt(t)
    }

    ; The wheel over the timeline moves the playhead, a second a notch.
    fn recTimelineWheel:void (dy:double) {
        def t:double (recHead + (dy * 0.01))
        if (t < 0.0) { t = 0.0 }
        if (t > take.duration) { t = take.duration }
        this.recShowAt(t)
    }

    fn recTimelineUp:void () {
        recScrub = false
        recPress = false
        if (((this.recSelFrom()) < 0.0) && (recSelA >= 0.0)) {
            ; a click: the playhead goes there
            def t:double recSelA
            recSelA = -1.0
            recSelB = -1.0
            this.recShowAt(t)
        }
        chromeRev = (chromeRev + 1)
    }

    fn recButton:void (b:string) {
        if (b == "close") {
            this.recEditOpen(false)
            return
        }
        if (b == "play") {
            def from:double (this.recSelFrom())
            if (from < 0.0) {
                from = recHead
            }
            if (from >= (take.duration - 0.05)) {
                from = 0.0
            }
            this.replayStart((take.skip(from)))
            return
        }
        if (b == "cut") {
            if (take.addCut((this.recSelFrom()) (this.recSelTo()))) {
                recSelA = -1.0
                recSelB = -1.0
                recPrev.load(take)
                this.recShowAt(recHead)
                push requests "rec:save"
            }
            chromeRev = (chromeRev + 1)
            return
        }
        if (b == "restore") {
            take.removeCut((take.cutAt(recHead)))
            recPrev.load(take)
            this.recShowAt(recHead)
            push requests "rec:save"
            chromeRev = (chromeRev + 1)
        }
    }

    fn recTimeline:void (root:EVGElement) {
        def r:PresRect trackRect
        root.addChild((PresApp.div("tracks" "tracks" r.x r.y r.w r.h)))
        def dur:double take.duration
        def head:string ((PresI18n.t("Recording")) + "  " + (PresApp.clockText((take.playLength()))))
        if ((take.cutCount()) > 0) {
            head = (head + " · " + (PresI18n.t("cut")) + " " + (PresApp.clockText((dur - (take.playLength())))))
        }
        def from:double (this.recSelFrom())
        if (from >= 0.0) {
            head = (head + " · " + (PresI18n.t("marked")) + " " + (PresApp.clockText(from)) + "–" + (PresApp.clockText((this.recSelTo()))))
        } {
            head = (head + " · " + (PresI18n.t("drag the orange handle to move, elsewhere to mark a part")))
        }
        root.addChild((PresApp.label("tr-head" "track-head" head (r.x + 12.0) (r.y + 6.0))))
        ; the buttons, right to left
        def bs:[string] (this.recButtons())
        def right:double ((r.x + r.w) - 10.0)
        def bi:int 0
        while ((bi + 1) < (array_length bs)) {
            def lbl:string (itemAt bs (bi + 1))
            def w:double (PresApp.recButtonW(lbl))
            def cls:string "rec-btn"
            def lcls:string "rec-btn-label"
            if ((itemAt bs bi) == "cut") {
                cls = "rec-btn rec-btn-cut"
                lcls = "rec-btn-label rec-btn-label-on"
            }
            root.addChild((PresApp.div(("recb-" + (itemAt bs bi)) cls (right - w) (r.y + 3.0) w 22.0)))
            root.addChild((PresApp.label(("recbl-" + (itemAt bs bi)) lcls lbl ((right - w) + 11.0) (r.y + 6.0))))
            right = ((right - w) - 6.0)
            bi = (bi + 2)
        }
        def rowY:double (r.y + 28.0)
        def rowH:double 26.0
        def names:[string]
        push names (PresI18n.t("Slides"))
        push names (PresI18n.t("Voice"))
        push names (PresI18n.t("Drawing"))
        def k:int 0
        while (k < 3) {
            def y:double (rowY + ((to_double k) * (rowH + 2.0)))
            root.addChild((PresApp.label(("tr-name" + (to_string k)) "track-name" (itemAt names k) (r.x + 12.0) (y + 5.0))))
            root.addChild((PresApp.div(("lane" + (to_string k)) "lane" laneX y laneW rowH)))
            k = (k + 1)
        }
        ; the slides shown, one piece each time the slide changed
        def segFrom:double -1.0
        def segSlide:int -1
        def segEnd:boolean false
        def nseg:int 0
        def i:int 0
        while (i <= (array_length take.ops)) {
            def at:double dur
            def sl:int -2
            def en:boolean false
            def isNav:boolean (i == (array_length take.ops))
            if (i < (array_length take.ops)) {
                def o:PresRecOp (itemAt take.ops i)
                if (o.k == "nav") {
                    isNav = true
                    at = o.t
                    sl = o.slide
                    en = o.ended
                }
            }
            if (isNav && (((sl != segSlide) || (en != segEnd)) || (i == (array_length take.ops)))) {
                if (segFrom >= 0.0) {
                    def x0:double (this.recX(segFrom))
                    def x1:double (this.recX(at))
                    if ((x1 - x0) >= 1.0) {
                        def lab:string (to_string (segSlide + 1))
                        if segEnd {
                            lab = (PresI18n.t("end"))
                        }
                        root.addChild((PresApp.div(("rs" + (to_string nseg)) "clip clip-text rec-seg" x0 (rowY + 3.0) ((x1 - x0) - 1.0) (rowH - 6.0))))
                        if ((x1 - x0) > 18.0) {
                            root.addChild((PresApp.label(("rsl" + (to_string nseg)) "clip-label" lab (x0 + 4.0) (rowY + 7.0))))
                        }
                        nseg = (nseg + 1)
                    }
                }
                segFrom = at
                segSlide = sl
                segEnd = en
            }
            i = (i + 1)
        }
        ; the voice: its loudness as bars, a few pixels each
        def vy:double (rowY + (rowH + 2.0))
        def np:int (array_length recPeaks)
        if (np > 0) {
            def bars:int (to_int (laneW / 4.0))
            if (bars > 400) { bars = 400 }
            def b:int 0
            while (b < bars) {
                def t0:double (((to_double b) / (to_double bars)) * dur)
                def t1:double (((to_double (b + 1)) / (to_double bars)) * dur)
                def p0:int (to_int (t0 / (PresApp.RECPEAK())))
                def p1:int (to_int (t1 / (PresApp.RECPEAK())))
                def peak:double 0.0
                def q:int p0
                while ((q <= p1) && (q < np)) {
                    if ((itemAt recPeaks q) > peak) {
                        peak = (itemAt recPeaks q)
                    }
                    q = (q + 1)
                }
                def bh:double (2.0 + (peak * (rowH - 8.0)))
                def bx:double (laneX + (((to_double b) / (to_double bars)) * laneW))
                root.addChild((PresApp.div(("rw" + (to_string b)) "rec-wave" bx ((vy + (rowH / 2.0)) - (bh / 2.0)) 2.0 bh)))
                b = (b + 1)
            }
        } {
            def vh:string (PresI18n.t("no sound"))
            if ((strlen take.audio) > 0) {
                vh = (PresI18n.t("reading the sound…"))
            }
            root.addChild((PresApp.label("rvh" "lane-hint" vh (laneX + 8.0) (vy + 7.0))))
        }
        ; where something was drawn or written
        def dy:double (rowY + ((rowH + 2.0) * 2.0))
        def nd:int 0
        def j:int 0
        while (j < (array_length take.ops)) {
            def d:PresRecOp (itemAt take.ops j)
            if ((d.k == "down") || (d.k == "text")) {
                def dx:double (this.recX(d.t))
                def dcls:string "rec-mark"
                if (d.k == "text") {
                    dcls = "rec-mark rec-mark-text"
                }
                root.addChild((PresApp.div(("rd" + (to_string nd)) dcls (dx - 1.0) (dy + 4.0) 3.0 (rowH - 8.0))))
                nd = (nd + 1)
            }
            j = (j + 1)
        }
        ; the parts cut away, over all three
        def full:double ((rowH + 2.0) * 3.0)
        def c:int 0
        while (c < (take.cutCount())) {
            def cx0:double (this.recX((take.cutStart(c))))
            def cx1:double (this.recX((take.cutEnd(c))))
            root.addChild((PresApp.div(("rc" + (to_string c)) "rec-cut" cx0 (rowY - 2.0) (cx1 - cx0) full)))
            c = (c + 1)
        }
        if (from >= 0.0) {
            def sx0:double (this.recX(from))
            def sx1:double (this.recX((this.recSelTo())))
            root.addChild((PresApp.div("rsel" "rec-sel" sx0 (rowY - 2.0) (sx1 - sx0) full)))
        }
        ; the playhead: the recording's own time, or the replay's
        def ph:double recHead
        root.addChild((PresApp.div("playhead" "playhead" ((this.recX(ph)) - 1.0) (rowY - 4.0) 2.0 full)))
        ; its handle: dragged, the playhead goes through the recording
        root.addChild((PresApp.div("rec-knob" "rec-knob" ((this.recX(ph)) - 6.0) (rowY - 10.0) 12.0 10.0)))
    }

    ; =========================================================================
    ; Layout
    ; =========================================================================
    fn place:void () {
        if (mode == "present") {
            deckRect.set(0.0 0.0 0.0 0.0)
            this.placePresent()
            return
        }
        ; the rail (and Rooms beside it) take the left edge under the bar
        def L:double (this.leftW())
        if (deckOn && (barH > 0.0)) {
            deckRect.set(L toolbar.barH (W - L) deckH)
        } {
            deckRect.set(0.0 0.0 0.0 0.0)
        }
        ; the help panel, the chat or a comment's thread, when open, takes
        ; the right edge
        def AW:double (W - L)
        if (((this.dockW()) > 0.0) && (barH > 0.0)) {
            AW = ((W - L) - (this.dockW()))
        }
        if ((AW < 320.0) && (AW < (W - L))) {
            AW = (W - L)
        }
        def stripH:double (thumbH + 34.0)
        def trackH:double 118.0
        def rx:double L
        if (this.isCompact()) {
            ; narrow (a phone, a small window): the slides only, no editor
            ; and no timeline; widening brings them back
            tabRect.set(L barH 0.0 0.0)
            edRect.set(L barH 0.0 0.0)
            sepRect.set(L barH 0.0 0.0)
            trackH = 0.0
            if (focus == "editor") {
                focus = "stage"
            }
        } {
            def edW:double (AW * split)
            if (edW < 280.0) { edW = 280.0 }
            if (edW > (AW - 360.0)) { edW = (AW - 360.0) }
            tabRect.set(L barH edW tabH)
            edRect.set(L (barH + tabH) edW ((H - tabH) - barH))
            sepRect.set((L + edW) barH 6.0 (H - barH))
            rx = ((L + edW) + 6.0)
        }
        def rw:double ((L + AW) - rx)
        stripRect.set(rx (H - stripH) rw stripH)
        trackRect.set(rx ((H - stripH) - trackH) rw trackH)
        laneX = (rx + 92.0)
        laneW = (rw - 108.0)
        stageArea.set(rx barH rw (((H - stripH) - trackH) - barH))
        this.fitSlide(stageArea 20.0)
    }

    ; What is docked on the right takes: a comment's thread, else the help
    ; panel or the chat.
    fn dockW:double () {
        if ((review.dockW()) > 0.0) {
            return (review.dockW())
        }
        return (panels.dockW())
    }

    ; What the bar's left rail and Rooms take, 0 without the bar.
    fn leftW:double () {
        if ((barH <= 0.0) || (mode == "present")) {
            return 0.0
        }
        toolbar.w = W
        return (toolbar.leftW())
    }

    ; Narrower than an editor and a slide side by side need.
    fn isCompact:boolean () {
        def L:double (this.leftW())
        def AW:double (W - L)
        if (((this.dockW()) > 0.0) && (barH > 0.0)) {
            AW = ((W - L) - (this.dockW()))
            if (AW < 320.0) {
                AW = (W - L)
            }
        }
        return (AW < 700.0)
    }

    fn setCoarse:void (on:boolean) {
        coarse = on
        toolbar.coarse = on
        chromeRev = (chromeRev + 1)
    }

    fn placePresent:void () {
        edRect.set(0.0 0.0 0.0 0.0)
        tabRect.set(0.0 0.0 0.0 0.0)
        sepRect.set(0.0 0.0 0.0 0.0)
        trackRect.set(0.0 0.0 0.0 0.0)
        stripRect.set(0.0 0.0 0.0 0.0)
        if speaker {
            stageArea.set(0.0 0.0 (W * 0.64) H)
            this.fitSlide(stageArea 24.0)
            def nx:double ((W * 0.64) + 12.0)
            def nw:double ((W - nx) - 24.0)
            nextRect.set(nx 64.0 nw (nw * (deck.pageH / deck.pageW)))
        } {
            stageArea.set(0.0 0.0 W H)
            this.fitSlide(stageArea 0.0)
            nextRect.set(0.0 0.0 0.0 0.0)
        }
    }

    fn fitSlide:void (area:PresRect pad:double) {
        def aw:double (area.w - (pad * 2.0))
        def ah:double (area.h - (pad * 2.0))
        if (aw < 10.0) { aw = 10.0 }
        if (ah < 10.0) { ah = 10.0 }
        ; a book is shown a spread at a time: two pages fit, and the page
        ; itself is the half it is on (PresBook)
        def book:MdBook (deck.book())
        def across:double (? (book.isBook()) 2.0 1.0)
        def sc:double (aw / (deck.pageW * across))
        if ((deck.pageH * sc) > ah) {
            sc = (ah / deck.pageH)
        }
        def w:double (deck.pageW * sc)
        def h:double (deck.pageH * sc)
        def sx:double (area.x + ((area.w - (w * across)) * 0.5))
        if ((book.isBook()) && (book.isRecto(selected))) {
            sx = (sx + w)
        }
        slideRect.set(sx (area.y + ((area.h - h) * 0.5)) w h)
        viewBase.set(slideRect.x slideRect.y w h)
        if (viewZoom > 1.0) {
            def zw:double (w * viewZoom)
            def zh:double (h * viewZoom)
            def cx:double (slideRect.x + (w * 0.5))
            def cy:double (slideRect.y + (h * 0.5))
            ; Held against the stage, not the fitted slide: a slide wider than
            ; the stage keeps both stage edges covered (no strip of the
            ; stage's own colour at an edge), a narrower one stays centred.
            ; 2 px past each edge: the slide's anti-aliased edge stays
            ; outside the stage's clip instead of showing as a light hairline
            def zx:double (PresApp.keepIn((cx - (viewU * zw)) zw (area.x - 2.0) (area.w + 4.0)))
            def zy:double (PresApp.keepIn((cy - (viewV * zh)) zh (area.y - 2.0) (area.h + 4.0)))
            viewU = ((cx - zx) / zw)
            viewV = ((cy - zy) / zh)
            slideRect.set(zx zy zw zh)
        }
    }

    ; Where a span `size` long starting at `at` goes so it covers the room
    ; from `lo` (`len` long), or sits in its middle when it is shorter.
    sfn keepIn:double (at:double size:double lo:double len:double) {
        if (size <= len) {
            return (lo + ((len - size) * 0.5))
        }
        if (at > lo) {
            return lo
        }
        if ((at + size) < (lo + len)) {
            return ((lo + len) - size)
        }
        return at
    }

    ; =========================================================================
    ; Seeing the slide closer: a pinch, a double tap, Ctrl + wheel
    ; =========================================================================
    ; Zoom by `f` about (px, py) and move by (dx, dy): the point of the slide
    ; that was under (px - dx, py - dy) ends up under (px, py).
    fn viewPinch:void (px:double py:double f:double dx:double dy:double) {
        this.place()
        if ((slideRect.w <= 0.0) || (slideRect.h <= 0.0)) {
            return
        }
        def u:double ((((px - dx) - slideRect.x)) / slideRect.w)
        def v:double ((((py - dy) - slideRect.y)) / slideRect.h)
        def z:double (viewZoom * f)
        if (z > 6.0) { z = 6.0 }
        ; out to the fitted size and no further; settled there when the
        ; fingers are lifted (viewSettle), so the slide does not jump back
        ; and forth around it during a pinch
        if (z < 1.0001) { z = 1.0001 }
        def zw:double (viewBase.w * z)
        def zh:double (viewBase.h * z)
        def x1:double (px - (u * zw))
        def y1:double (py - (v * zh))
        viewZoom = z
        viewU = (((viewBase.x + (viewBase.w * 0.5)) - x1) / zw)
        viewV = (((viewBase.y + (viewBase.h * 0.5)) - y1) / zh)
        chromeRev = (chromeRev + 1)
    }

    ; The pinch is over: barely zoomed is the slide as it fits.
    fn viewSettle:void () {
        if (viewZoom < 1.08) {
            this.viewReset()
        }
    }

    fn viewReset:void () {
        if (viewZoom != 1.0) {
            chromeRev = (chromeRev + 1)
        }
        viewZoom = 1.0
        viewU = 0.5
        viewV = 0.5
    }

    ; A double tap: in to 2.5 times at the tap, or back out when already in.
    fn viewToggle:void (px:double py:double) {
        ; the first tap may have picked a diagram: a drag now moves the view
        activeDia = -1
        if (viewZoom > 1.0) {
            this.viewReset()
            return
        }
        this.viewPinch(px py 2.5 0.0 0.0)
    }

    ; Where a pinch or a double tap reaches the stage: not over a window or
    ; a panel drawn on top of it.
    fn canZoomAt:boolean (x:double y:double) {
        this.place()
        if ((strlen (this.layerAt(x y))) > 0) {
            return false
        }
        return (stageArea.has(x y))
    }

    ; A second finger came down: the first one's press is forgotten, so the
    ; pinch neither clicks nor drags anything.
    fn cancelPress:void () {
        stagePressed = false
        stagePanning = false
        stripPressed = false
        stripDragging = false
        if stripReorder {
            stripMove.finish(false deck.uiNow)
        }
        stripReorder = false
        stripDrop = -1
        stripAdd = ""
        scrubDrag = false
        editorDrag = false
        splitDrag = false
    }

    fn setTouch:void (on:boolean) {
        touch = on
    }

    ; Ctrl or ⌘ held at the next press (a thumbnail clicked so is picked)
    fn setCtrl:void (on:boolean) {
        pressCtrl = on
    }

    ; True once after a tap made a diagram the one a finger pans.
    fn takeActivated:boolean () {
        def was:boolean activatedNow
        activatedNow = false
        return was
    }

    fn slideScale:double () {
        return (slideRect.w / deck.pageW)
    }

    fn thumbX:double (i:int) {
        return (((stripRect.x + 12.0) + ((to_double i) * (thumbW + thumbGap))) - stripScroll)
    }

    ; A thumbnail with any part inside the strip is drawn; one cut by an
    ; edge is clipped there (the chrome by the strip's own box, the slide by
    ; the host, see `thumbWhole`).
    ; Where thumbnail i is drawn: its own place, or on its way to one while
    ; a slide is carried along the strip or glides into its gap.
    fn thumbDrawX:double (i:int) {
        return ((this.thumbX(0)) + ((stripMove.place(i deck.uiNow)) * (thumbW + thumbGap)))
    }

    ; The carried box's place (in thumbnail steps) with the pointer at x.
    fn stripCarryAt:double (x:double) {
        return (((x - stripGrabDx) - (this.thumbX(0))) / (thumbW + thumbGap))
    }

    fn thumbFits:boolean (x:double) {
        return (((x + thumbW) > (stripRect.x + 4.0)) && (x < ((stripRect.x + stripRect.w) - 4.0)))
    }

    fn thumbWhole:boolean (x:double) {
        return ((x >= (stripRect.x + 4.0)) && ((x + thumbW) <= ((stripRect.x + stripRect.w) - 4.0)))
    }

    ; What a press at x, y asks of the "+" after the thumbnails: "open"
    ; (the "+" itself), "empty" or "dup" (its two choices), or "".
    fn addAt:string (x:double y:double) {
        if ((mode != "edit") || (stripRect.has(x y) == false)) {
            return ""
        }
        def ax:double (this.thumbX((deck.slideCount())))
        def ty:double (this.thumbY())
        if ((((x < ax) || (x > (ax + thumbW))) || (y < ty)) || (y > (ty + thumbH))) {
            return ""
        }
        if ((x < (stripRect.x + 4.0)) || (x > ((stripRect.x + stripRect.w) - 4.0))) {
            return ""
        }
        if (addOpen == false) {
            return "open"
        }
        if (y < (ty + (thumbH / 2.0))) {
            return "empty"
        }
        return "dup"
    }

    fn thumbY:double () {
        return (stripRect.y + 22.0)
    }

    ; Where the host draws what: the stage and every thumbnail on screen.
    ; The deck's own effects (```fx, the theme's @effect) for the page to
    ; register with the painter: [{name, layer, params, still, fallback, frag}]
    fn deckEffectsJson:string () {
        return (deck.effectsJson())
    }

    fn layoutJson:string () {
        this.place()
        def sc:double (this.slideScale())
        def out:string ("{\"mode\":\"" + mode + "\"")
        out = (out + ",\"rev\":" + (to_string deck.revision))
        out = (out + ",\"slide\":" + (to_string selected))
        out = (out + ",\"slides\":" + (to_string (deck.slideCount())))
        out = (out + ",\"time\":" + (EVGDisplayList.num((this.currentTime()))))
        out = (out + ",\"fxTime\":" + (EVGDisplayList.num((this.effectTime()))))
        out = (out + ",\"playing\":" + (? (this.isPlaying()) "true" "false"))
        out = (out + ",\"stage\":[" + (PresApp.placeAt(slideRect.x slideRect.y sc)) + "]")
        out = (out + ",\"clip\":[" + (PresApp.nums4(stageArea.x stageArea.y stageArea.w stageArea.h)) + "]")
        if (this.bookTurns()) {
            out = (out + ",\"book\":" + (PresBook.turnJson((deck.book()) selected (deck.slideCount()) deck.pageW deck.pageH)))
        } {
            out = (out + ",\"book\":null")
        }
        out = (out + ",\"strip\":[" + (PresApp.nums4((stripRect.x + 4.0) stripRect.y (stripRect.w - 8.0) stripRect.h)) + "]")
        out = (out + ",\"thumbs\":[")
        def first:boolean true
        if (mode == "edit") {
            ; a portrait deck's thumbnails fit the strip's height, centred
            def ts:double (thumbW / deck.pageW)
            if ((deck.pageH * ts) > thumbH) {
                ts = (thumbH / deck.pageH)
            }
            def inset:double ((thumbW - (deck.pageW * ts)) / 2.0)
            ; the one carried along the strip last, drawn over the others
            def carried:int (? stripReorder stripIdx -1)
            def i:int 0
            while (i <= (deck.slideCount())) {
                def k:int i
                if (i == (deck.slideCount())) {
                    k = carried
                }
                if ((k >= 0) && ((k != carried) || (i == (deck.slideCount())))) {
                    def x:double (this.thumbDrawX(k))
                    if ((k < (deck.slideCount())) && (this.thumbFits(x))) {
                        if (! first) {
                            out = (out + ",")
                        }
                        first = false
                        out = (out + "[" + (to_string k) + "," + (PresApp.placeAt((x + inset) (this.thumbY()) ts)) + "," + (? (this.thumbWhole(x)) "0" "1") + "]")
                    }
                }
                i = (i + 1)
            }
        }
        if ((mode == "present") && speaker) {
            if (selected < ((deck.slideCount()) - 1)) {
                def ns:double (nextRect.w / deck.pageW)
                out = (out + "[" + (to_string (selected + 1)) + "," + (PresApp.placeAt(nextRect.x nextRect.y ns)) + "]")
            }
        }
        out = (out + "]")
        out = (out + ",\"strip\":[" + (PresApp.nums4(stripRect.x stripRect.y stripRect.w stripRect.h)) + "]")
        out = (out + ",\"focus\":\"" + focus + "\"")
        ; The live sheets on the shown slide, while presenting, and whether
        ; the slide has come to rest (the page shows them only then: a
        ; transition moves the picture, not the workbook over it).
        if ((mode == "present") && (selected >= 0) && (selected < (deck.slideCount()))) {
            def sl:PresSlide (deck.slideAt(selected))
            def rest:boolean ((this.stageTime()) >= (PresTimeline.transitionSeconds(sl)))
            out = (out + ",\"sheets\":" + (deck.liveSheetsJson(selected)))
            out = (out + ",\"settled\":" + (? rest "true" "false"))
        } {
            out = (out + ",\"sheets\":[],\"settled\":false")
        }
        out = (out + "}")
        return out
    }

    ; Where a page is drawn: x, y and its scale, and a 0 kept for the hosts
    ; that read four numbers. Six decimals, not `num`'s two: the scale is
    ; multiplied by the page's width, so 1.1124 written as 1.11 drew a
    ; zoomed slide 2 px short of the clip worked out from the exact value,
    ; a stripe at the stage's edge that came and went as the zoom changed.
    sfn placeAt:string (x:double y:double s:double) {
        return ((EVGDisplayList.fine(x)) + "," + (EVGDisplayList.fine(y)) + "," + (EVGDisplayList.fine(s)) + ",0")
    }

    sfn nums4:string (a:double b:double c:double d:double) {
        return ((EVGDisplayList.num(a)) + "," + (EVGDisplayList.num(b)) + "," + (EVGDisplayList.num(c)) + "," + (EVGDisplayList.num(d)))
    }

    ; =========================================================================
    ; The slides, as display lists in slide coordinates
    ; =========================================================================
    fn listJson:string (l:EVGDisplayList) {
        return ("{\"width\":" + (EVGDisplayList.num(deck.pageW)) + ",\"height\":" + (EVGDisplayList.num(deck.pageH)) + ",\"list\":" + (l.toJson()) + "}")
    }

    def holdSince:double -1.0
    def skipAfter:double 8.0

    ; Past the question on slide `on`, to the next slide. Returns the clock.
    fn skipQuestion:double (on:int) {
        deck.skipQuestions(on)
        holdSince = -1.0
        def last:int ((deck.slideCount()) - 1)
        if (on < last) {
            if (mode == "present") {
                selected = (on + 1)
                pStep = 0
            }
            clock = (PresTimeline.slideStart(deck (on + 1)))
            if playing {
                selected = (on + 1)
                this.revealThumb(selected)
            }
        }
        chromeRev = (chromeRev + 1)
        return clock
    }

    ; Where the page's presenting bar starts, in canvas pixels from the top
    ; (-1: no bar): a diagram over the whole slide ends above it.
    def barTop:double -1.0
    fn setBarTop:void (y:double) {
        barTop = y
    }

    fn stageJson:string () {
        deck.fullBottom = -1.0
        if ((barTop > 0.0) && (mode == "present")) {
            deck.fullBottom = ((barTop - slideRect.y) / (this.slideScale()))
        }
        deck.live = (this.isPlaying())
        deck.showControls = true
        def l:EVGDisplayList (this.stageFrame())
        if (viewZoom > 1.0) {
            this.clipToStage(l)
        }
        def out:string (this.listJson(l))
        deck.showControls = false
        deck.live = false
        return out
    }

    ; The stage's frame: the slide, or a book's spread (PresBook).
    ; the slide the stage drew last, and the one before it (playState)
    def stageAt:int -1
    def cameFrom:int 0

    fn stageFrame:EVGDisplayList () {
        if (selected != stageAt) {
            cameFrom = (stageAt + 1)
            stageAt = selected
        }
        def book:MdBook (deck.book())
        if (book.isBook()) {
            if (mode == "present") {
                return (PresBook.showFrame(deck selected (this.stageTime())))
            }
            return (PresBook.editFrame(deck selected (this.stageTime())))
        }
        return (PresTimeline.frame(deck selected (this.stageTime())))
    }

    ; Where page `p` of the shown spread is on screen, when it faces the
    ; selected page (a press there turns to it while editing).
    fn partnerAt:int (x:double y:double) {
        def book:MdBook (deck.book())
        def p:int (PresBook.partner(book selected (deck.slideCount())))
        if (p < 0) {
            return -1
        }
        def px:double (slideRect.x + ((PresBook.pageX(book p selected deck.pageW)) * (this.slideScale())))
        if ((((x >= px) && (x < (px + slideRect.w))) && (y >= slideRect.y)) && (y < (slideRect.y + slideRect.h))) {
            return p
        }
        return -1
    }

    ; Zoomed in, the slide is larger than the stage: the list is clipped to
    ; the stage (in page units) so it does not cover the strip or the bar.
    fn clipToStage:void (l:EVGDisplayList) {
        def sc:double (this.slideScale())
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 4
        c.x = ((stageArea.x - slideRect.x) / sc)
        c.y = ((stageArea.y - slideRect.y) / sc)
        c.w = (stageArea.w / sc)
        c.h = (stageArea.h / sc)
        def all:[EVGDrawCmd]
        push all c
        def i:int 0
        while (i < (array_length l.cmds)) {
            push all (itemAt l.cmds i)
            i = (i + 1)
        }
        def e:EVGDrawCmd (new EVGDrawCmd)
        e.kind = 5
        push all e
        l.cmds = all
    }

    ; The host's wall clock, for the viewer's own camera moves in a diagram.
    fn setUiTime:void (s:double) {
        if ((deck.uiNow > 0.0) && (s > deck.uiNow)) {
            toolbar.tick(((s - deck.uiNow) * 1000.0))
        }
        deck.uiNow = s
    }

    fn uiBusy:boolean () {
        deck.showingSlide(selected)
        return (((deck.uiBusy(selected)) || reviewBusy) || (stripMove.busy(deck.uiNow)))
    }

    ; Called by the page each frame: one more rebuild while charts are still
    ; drawn under old defaults (a few a frame while editing). True when it
    ; laid out again.
    ; The source ranges a rebuild draws: the focus is the shown slide with
    ; the one before and the one after (the next one is ready when a click
    ; gets to it, and the speaker view shows it), the view the thumbnails on
    ; screen. From the last layout's slides; a rebuild that moves them is
    ; followed by another `settle` if that brings more into view.
    fn aimDeck:void () {
        deck.focusFrom = -1
        deck.focusTo = -1
        deck.viewFrom = -1
        deck.viewTo = -1
        def n:int (deck.slideCount())
        if ((n == 0) || sourceNew) {
            ; a new text: laid out with nothing drawn, and the shown slide's
            ; charts drawn by the `settle` after
            sourceNew = false
            deck.focusFrom = 0
            deck.focusTo = 0
            return
        }
        def cur:int selected
        if (cur >= n) {
            cur = (n - 1)
        }
        if (cur < 0) {
            cur = 0
        }
        def lo:int (? (cur > 0) (cur - 1) cur)
        def hi:int (? (cur < (n - 1)) (cur + 1) cur)
        deck.focusFrom = (this.spanFrom(lo))
        deck.focusTo = (this.spanTo(hi))
        if (mode != "edit") {
            return
        }
        def first:int -1
        def last:int -1
        def i:int 0
        while (i < n) {
            if (this.thumbFits((this.thumbX(i)))) {
                if (first < 0) {
                    first = i
                }
                last = i
            }
            i = (i + 1)
        }
        if (first >= 0) {
            deck.viewFrom = (this.spanFrom(first))
            deck.viewTo = (this.spanTo(last))
        }
    }

    ; The source a slide is made from: from its first box's offset up to the
    ; next slide's (a slide's `srcEnd` is its last text box, and a chart
    ; under the text has none). A slide that continues the one before starts
    ; where that one does.
    fn spanFrom:int (i:int) {
        def k:int i
        while (k >= 0) {
            def s:PresSlide (deck.slideAt(k))
            if (s.srcStart >= 0) {
                return s.srcStart
            }
            k = (k - 1)
        }
        return 0
    }

    fn spanTo:int (i:int) {
        def from:int (this.spanFrom(i))
        def k:int (i + 1)
        while (k < (deck.slideCount())) {
            def s:PresSlide (deck.slideAt(k))
            if (s.srcStart > from) {
                return s.srcStart
            }
            k = (k + 1)
        }
        return 1000000000
    }

    ; Charts or figures in a source range left undrawn by the last rebuild
    ; (out of view, or drawn under old defaults).
    fn undrawnIn:boolean (from:int to:int) {
        if (from < 0) {
            return false
        }
        return ((deck.undrawnIn(from to)) > 0)
    }

    ; Called by the page each frame. True when it laid out again, which it
    ; does for one of these:
    ; - the shown slide has a chart not drawn yet: at once, also mid-show
    ; - while nothing moves (in a show, once the slide's transition is
    ;   over): a chart on a neighbour of the shown slide or on a visible
    ;   thumbnail not drawn yet, or charts still drawn under old defaults
    ;   (a few a frame while editing)
    fn settle:boolean () {
        if deck.held {
            return false
        }
        if picturesArrived {
            picturesArrived = false
            this.rebuildDeck()
            return true
        }
        def n:int (deck.slideCount())
        if ((selected >= 0) && (selected < n)) {
            if (this.undrawnIn((this.spanFrom(selected)) (this.spanTo(selected)))) {
                this.rebuildDeck()
                return true
            }
        }
        if (this.isPlaying()) {
            ; a show draws ahead once the slide's transition is over, not
            ; while it moves
            if (mode != "present") {
                return false
            }
            if ((selected < 0) || (selected >= n)) {
                return false
            }
            def sl:PresSlide (deck.slideAt(selected))
            if ((this.stageTime()) < (PresTimeline.transitionSeconds(sl))) {
                return false
            }
        }
        this.aimDeck()
        def near:boolean ((this.undrawnIn(deck.focusFrom deck.focusTo)) || (this.undrawnIn(deck.viewFrom deck.viewTo)))
        if ((deck.redrawPending()) > 0) {
            near = true
        }
        if (! near) {
            return false
        }
        this.rebuildDeck()
        return true
    }

    ; Every chart drawn, under the defaults it has now: before the deck is
    ; written to a file or captured.
    fn settleAll:void () {
        if (((deck.redrawPending()) > 0) || ((deck.undrawn()) > 0)) {
            this.rebuildWith(-1 false)
        }
    }

    fn slideJson:string (i:int) {
        return (this.listJson((PresTimeline.finalFrame(deck i))))
    }

    ; The frame at a deck time, for a capture that walks the timeline.
    fn frameAtJson:string (t:double) {
        this.settleAll()
        def i:int (PresTimeline.slideAtTime(deck t))
        def local:double (t - (PresTimeline.slideStart(deck i)))
        return (this.listJson((PresTimeline.frame(deck i local))))
    }

    ; =========================================================================
    ; The chrome
    ; =========================================================================
    sfn div:EVGElement (id:string cls:string x:double y:double w:double h:double) {
        def el (EVGElement.createDiv())
        el.id = id
        el.className = cls
        el.setAttribute("position" "absolute")
        el.setAttribute("left" ((EVGDisplayList.num(x)) + "px"))
        el.setAttribute("top" ((EVGDisplayList.num(y)) + "px"))
        el.setAttribute("width" ((EVGDisplayList.num(w)) + "px"))
        el.setAttribute("height" ((EVGDisplayList.num(h)) + "px"))
        return el
    }

    sfn label:EVGElement (id:string cls:string words:string x:double y:double) {
        def el (EVGElement.createDiv())
        el.id = id
        el.className = cls
        el.textContent = words
        el.setAttribute("position" "absolute")
        el.setAttribute("left" ((EVGDisplayList.num(x)) + "px"))
        el.setAttribute("top" ((EVGDisplayList.num(y)) + "px"))
        return el
    }

    fn timeX:double (t:double dur:double) {
        if (dur <= 0.0) {
            return laneX
        }
        return (laneX + ((t / dur) * laneW))
    }

    fn chromeTree:EVGElement () {
        this.place()
        def root (EVGElement.createDiv())
        root.id = "root"
        if (mode == "present") {
            root.className = "present"
        } {
            root.className = "app"
        }
        root.setAttribute("width" ((EVGDisplayList.num(W)) + "px"))
        root.setAttribute("height" ((EVGDisplayList.num(H)) + "px"))
        if (mode == "present") {
            this.presentChrome(root)
            return root
        }
        ; the open presentations, under the top bar
        if (deckRect.h > 0.0) {
            def row:EVGElement (PresApp.div("deck-row" "deck-row" deckRect.x deckRect.y deckRect.w deckRect.h))
            this.makeDeckTabs()
            row.addChild((unwrap deckTabs.rootEl))
            root.addChild(row)
        }
        ; the tabs over the editor pane: Ranger UI's TabsCtl, styled in pres.css
        if (edRect.w > 0.0) {
            def tabBar:EVGElement (PresApp.div("ed-tabs" "ed-tabs" tabRect.x tabRect.y tabRect.w tabRect.h))
            this.makeTabs()
            laidTabs = tabs
            tabBar.addChild((unwrap tabs.rootEl))
            root.addChild(tabBar)
            root.addChild((PresApp.div("sep" "sep" sepRect.x sepRect.y sepRect.w sepRect.h)))
        }
        root.addChild((PresApp.div("stage-area" "stage-area" stageArea.x stageArea.y stageArea.w stageArea.h)))
        ; zoomed in, the slide runs under the stage's edges: its grey rim and
        ; shadow would show there as a light line, so they are left out
        if (viewZoom <= 1.0) {
            root.addChild((PresApp.div("slide-shadow" "slide-shadow" (slideRect.x - 1.0) (slideRect.y - 1.0) (slideRect.w + 2.0) (slideRect.h + 2.0))))
        }
        if ((deck.slideCount()) == 0) {
            root.addChild((PresApp.label("empty" "empty" (PresI18n.t("Type on the left: ## Title starts a slide")) (stageArea.x + 24.0) (stageArea.y + 24.0))))
        }
        if (trackRect.h > 0.0) {
            if (recEditing && (this.hasRecording())) {
                this.recTimeline(root)
            } {
                this.tracks(root)
            }
        }
        this.filmstrip(root)
        return root
    }

    fn tracks:void (root:EVGElement) {
        def r:PresRect trackRect
        def box:EVGElement (PresApp.div("tracks" "tracks" r.x r.y r.w r.h))
        root.addChild(box)
        if ((deck.slideCount()) == 0) {
            return
        }
        def s:PresSlide (deck.slideAt(selected))
        def dur:double s.duration
        def head:string ((PresI18n.t("Slide ")) + (to_string (selected + 1)) + " / " + (to_string (deck.slideCount())))
        if ((strlen s.title) > 0) {
            head = (head + " — " + s.title)
        }
        root.addChild((PresApp.label("tr-head" "track-head" head (r.x + 12.0) (r.y + 6.0))))
        root.addChild((PresApp.label("tr-time" "track-time" ((PresApp.secs((this.stageTime()))) + " / " + (PresApp.secs(dur))) ((r.x + r.w) - 110.0) (r.y + 6.0))))
        def rowY:double (r.y + 28.0)
        def rowH:double 26.0
        ; i18n: "Text" "Speech" "Animation" (translated where drawn)
        def names:[string] ([] _:string ("Text" "Speech" "Animation"))
        def k:int 0
        while (k < 3) {
            def y:double (rowY + ((to_double k) * (rowH + 2.0)))
            root.addChild((PresApp.label(("tr-name" + (to_string k)) "track-name" (PresI18n.t((itemAt names k))) (r.x + 12.0) (y + 5.0))))
            root.addChild((PresApp.div(("lane" + (to_string k)) "lane" laneX y laneW rowH)))
            k = (k + 1)
        }
        ; text: the groups, where they arrive
        def g:int 0
        while (g < (array_length s.groups)) {
            def gr:PresGroup (itemAt s.groups g)
            def x0:double (this.timeX(gr.at dur))
            def x1:double (this.timeX((gr.at + gr.seconds) dur))
            def w:double (x1 - x0)
            if (w < 44.0) { w = 44.0 }
            def cls:string "clip clip-text"
            def piece:EVGElement (PresApp.div(("grp" + (to_string g)) cls x0 (rowY + 3.0) w (rowH - 6.0)))
            root.addChild(piece)
            def name:string gr.label
            if (gr.step > 0) {
                name = ((to_string gr.step) + ". " + name)
            }
            root.addChild((PresApp.label(("grl" + (to_string g)) "clip-label" name (x0 + 5.0) (rowY + 7.0))))
            g = (g + 1)
        }
        ; speech
        def sy:double (rowY + (rowH + 2.0))
        def recSp:[double] (take.slideSpans(selected))
        if ((array_length recSp) >= 2) {
            ; the recording's time on this slide (pressed: played from there)
            def said:double 0.0
            def q:int 0
            while ((q + 1) < (array_length recSp)) {
                said = (said + ((itemAt recSp (q + 1)) - (itemAt recSp q)))
                q = (q + 2)
            }
            root.addChild((PresApp.div("aud" "clip clip-audio" laneX (sy + 3.0) laneW (rowH - 6.0))))
            def rl:string ((PresI18n.t("▶ Recording")) + "  " + (PresApp.clockText((itemAt recSp 0))) + " · " + (PresApp.secs(said)))
            root.addChild((PresApp.label("audl" "clip-label" rl (laneX + 6.0) (sy + 7.0))))
        } {
          if ((strlen s.audio) > 0) {
            root.addChild((PresApp.div("aud" "clip clip-audio" laneX (sy + 3.0) laneW (rowH - 6.0))))
            root.addChild((PresApp.label("audl" "clip-label" s.audio (laneX + 6.0) (sy + 7.0))))
          } {
            def hint:string (PresI18n.t("no audio · Record ▸ Record presentation"))
            if ((this.hasRecording())) {
                hint = (PresI18n.t("not in the recording"))
            }
            root.addChild((PresApp.label("audl" "lane-hint" hint (laneX + 8.0) (sy + 7.0))))
          }
        }
        ; animation: the transition in, the surface effect across
        def ay:double (rowY + ((rowH + 2.0) * 2.0))
        def ts:double (PresTimeline.transitionSeconds(s))
        if (ts > 0.0) {
            def tx1:double (this.timeX(ts dur))
            def tw:double (tx1 - laneX)
            if (tw < 44.0) { tw = 44.0 }
            root.addChild((PresApp.div("trn" "clip clip-anim" laneX (ay + 3.0) tw (rowH - 6.0))))
            root.addChild((PresApp.label("trnl" "clip-label" s.transition (laneX + 5.0) (ay + 7.0))))
        }
        def dg:int 0
        while (dg < (array_length s.diagrams)) {
            def du:PresDiaUse (itemAt s.diagrams dg)
            def dx0:double (this.timeX(du.start dur))
            def dx1:double (this.timeX((du.start + du.diagram.total) dur))
            root.addChild((PresApp.div(("dia" + (to_string dg)) "clip clip-dia" dx0 (ay + 3.0) (dx1 - dx0) (rowH - 6.0))))
            def dl:string (PresI18n.t("diagram: draw"))
            if du.diagram.tour {
                dl = (PresI18n.t("diagram: draw + tour"))
            }
            root.addChild((PresApp.label(("dial" + (to_string dg)) "clip-label" dl (dx0 + 6.0) (ay + 7.0))))
            dg = (dg + 1)
        }
        if ((strlen s.fx) > 0) {
            def fx0:double (laneX + 90.0)
            root.addChild((PresApp.div("fxc" "clip clip-fx" fx0 (ay + 3.0) ((laneX + laneW) - fx0) (rowH - 6.0))))
            root.addChild((PresApp.label("fxl" "clip-label" ("fx: " + s.fx) (fx0 + 6.0) (ay + 7.0))))
        }
        ; the playhead
        def px:double (this.timeX((this.stageTime()) dur))
        root.addChild((PresApp.div("playhead" "playhead" (px - 1.0) (rowY - 4.0) 2.0 ((rowH + 2.0) * 3.0))))
    }

    sfn secs:string (t:double) {
        def tenths:int (to_int ((t * 10.0) + 0.5))
        def whole:int (idiv tenths 10)
        def frac:int (tenths - (whole * 10))
        return ((to_string whole) + "." + (to_string frac) + " s")
    }

    fn filmstrip:void (root:EVGElement) {
        def r:PresRect stripRect
        root.addChild((PresApp.div("strip" "strip" r.x r.y r.w r.h)))
        ; the thumbnails' frames and numbers, cut at the strip's inner edges
        def ox:double (r.x + 4.0)
        def box:EVGElement (PresApp.div("strip-in" "" ox r.y (r.w - 8.0) r.h))
        box.setAttribute("overflow" "hidden")
        root.addChild(box)
        ; where a carried slide would land: the gap the others leave open
        if stripReorder {
            def gx:double (this.thumbX((stripMove.target())))
            box.addChild((PresApp.div("thumb-drop" "thumb-drop" ((gx - 3.0) - ox) (((this.thumbY()) - 3.0) - r.y) (thumbW + 6.0) (thumbH + 6.0))))
        }
        def i:int 0
        while (i < (deck.slideCount())) {
            if ((stripReorder && (i == stripIdx)) == false) {
                this.thumbFrame(box i)
            }
            i = (i + 1)
        }
        ; the carried one over the others
        if (stripReorder && ((stripIdx >= 0) && (stripIdx < (deck.slideCount())))) {
            this.thumbFrame(box stripIdx)
        }
        ; the "+" after the last one, or its two choices once pressed
        def ax:double (this.thumbX((deck.slideCount())))
        if (this.thumbFits(ax)) {
            def ay:double ((this.thumbY()) - r.y)
            if addOpen {
                def hh:double ((thumbH - 4.0) / 2.0)
                box.addChild((PresApp.box("slide-add-empty" "thumb-add-btn" (PresI18n.t("Empty slide")) (ax - ox) ay thumbW hh)))
                box.addChild((PresApp.box("slide-add-dup" "thumb-add-btn" (PresI18n.t("Duplicate slide")) (ax - ox) ((ay + hh) + 4.0) thumbW hh)))
            } {
                box.addChild((PresApp.box("slide-add" "thumb-add" "+" (ax - ox) ay thumbW thumbH)))
            }
        }
    }

    ; Thumbnail i's frame and number, where it is drawn (thumbDrawX).
    fn thumbFrame:void (box:EVGElement i:int) {
        def r:PresRect stripRect
        def ox:double (r.x + 4.0)
        def x:double (this.thumbDrawX(i))
        if ((this.thumbFits(x)) == false) {
            return
        }
        def cls:string "thumb"
        if (i == selected) {
            cls = "thumb thumb-on"
        }
        if (picks.has(i)) {
            cls = (cls + " thumb-picked")
        }
        if (stripReorder && (i == stripIdx)) {
            cls = (cls + " thumb-carried")
        }
        box.addChild((PresApp.div(("thumb" + (to_string i)) cls ((x - 3.0) - ox) (((this.thumbY()) - 3.0) - r.y) (thumbW + 6.0) (thumbH + 6.0))))
        ; the keys are on the strip: a ring round the selected slide
        if (((focus == "strip") && (i == selected)) && (stripReorder == false)) {
            box.addChild((PresApp.div("thumb-ring" "thumb-ring" ((x - 6.0) - ox) (((this.thumbY()) - 6.0) - r.y) (thumbW + 12.0) (thumbH + 12.0))))
        }
        def num:string (to_string (i + 1))
        if (picks.has(i)) {
            num = ("✓ " + num)
        }
        box.addChild((PresApp.label(("tn" + (to_string i)) "thumb-num" num (x - ox) 4.0)))
    }

    ; A box with its words in the middle (`line-height` is its height).
    sfn box:EVGElement (id:string cls:string words:string x:double y:double w:double h:double) {
        def el:EVGElement (PresApp.div(id cls x y w h))
        el.textContent = words
        el.setAttribute("line-height" ((EVGDisplayList.num(h)) + "px"))
        return el
    }

    fn presentChrome:void (root:EVGElement) {
        if (! speaker) {
            return
        }
        if ((deck.slideCount()) == 0) {
            return
        }
        def s:PresSlide (deck.slideAt(selected))
        def nx:double nextRect.x
        root.addChild((PresApp.label("sp-clock" "sp-clock" (PresApp.clockText(elapsed)) nx 18.0)))
        def where:string ((PresI18n.t("Slide ")) + (to_string (selected + 1)) + " / " + (to_string (deck.slideCount())))
        if (s.steps > 0) {
            where = (where + (PresI18n.t("  ·  step ")) + (to_string pStep) + " / " + (to_string s.steps))
        }
        ; the slide's own data (`## Title {jira=ACME-412}`): the presenter's
        ; screen is where it is useful — the ticket the slide is about
        def own:string (s.meta.asText())
        if ((strlen own) > 0) {
            where = (where + "  ·  " + own)
        }
        root.addChild((PresApp.label("sp-where" "sp-where" where (nx + 110.0) 24.0)))
        def ny:double ((nextRect.y + nextRect.h) + 18.0)
        if ((selected + 1) >= (deck.slideCount())) {
            ny = nextRect.y
            root.addChild((PresApp.label("sp-end" "sp-where" (PresI18n.t("Last slide")) nx ny)))
            ny = (ny + 28.0)
        }
        def notes:string s.notes
        if ((strlen notes) == 0) {
            notes = (PresI18n.t("(no notes)"))
        }
        def box:EVGElement (PresApp.div("sp-notes" "sp-notes" nx ny nextRect.w ((H - ny) - 24.0)))
        box.textContent = notes
        root.addChild(box)
    }

    sfn clockText:string (s:double) {
        def total:int (to_int s)
        def m:int (idiv total 60)
        def sec:int (total - (m * 60))
        def ss:string (to_string sec)
        if (sec < 10) {
            ss = ("0" + ss)
        }
        return ((to_string m) + ":" + ss)
    }

    fn layoutChrome:EVGLayout () {
        def root:EVGElement (this.chromeTree())
        UiTree.markHover(root chromeHover)
        sheet.setViewport(W H coarse)
        sheet.applyTree(root skin)
        def lay (new EVGLayout())
        lay.setPageSize(W H)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        lay.layout(root)
        chromeRoot = root
        return lay
    }

    fn chromeJson:string () {
        def lay:EVGLayout (this.layoutChrome())
        def root:EVGElement (unwrap chromeRoot)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(root)
        if (((mode == "edit") && (edRect.w > 0.0)) && ((this.filesListShowing()) == false)) {
            def top:double 0.0
            if (edTab == "files") {
                ; under the bar of the file that is open
                top = (PresPanels.filesBarH())
            }
            editor.focused = (focus == "editor")
            editor.layout.showLineNumbers = (edRect.w >= 360.0)
            editor.setBounds((to_int edRect.x) (to_int (edRect.y + top)) (to_int edRect.w) (to_int (edRect.h - top)))
            editor.paint(dl tr blink)
        }
        return ("{\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    fn revision:string () {
        def out:string (to_string chromeRev)
        out = (out + ":" + (to_string editor.buf.version))
        out = (out + ":" + (to_string editor.sel.caret.line) + "," + (to_string editor.sel.caret.col))
        out = (out + ":" + (to_string editor.sel.anchor.line) + "," + (to_string editor.sel.anchor.col))
        out = (out + ":" + (to_string editor.layout.scrollLine) + ":" + (to_string blink))
        out = (out + ":" + focus + ":" + mode + ":" + (EVGDisplayList.num(W)) + "x" + (EVGDisplayList.num(H)))
        out = (out + ":c" + (to_string chart.rev) + ":t" + (to_string toolbar.rev) + ":h" + (to_string hint.rev) + ":p" + (to_string panels.rev))
        out = (out + ":r" + (to_string review.rev) + ":m" + (to_string room.rev))
        return out
    }

    fn takeRequest:string () {
        if ((array_length requests) == 0) {
            return ""
        }
        def first:string (itemAt requests 0)
        remove_index requests 0
        return first
    }

    ; =========================================================================
    ; The pointer
    ; =========================================================================
    ; Where a press landed: "editor", "sep", "scrub", "thumb", "stage" or "".
    fn pointerDown:string (x:double y:double shift:boolean clicks:int) {
        this.place()
        ; review mode: a pin, its bar, a thread, or where a new comment goes
        if review.on {
            if (((this.layerAt(x y)) == "review") && (review.press(x y clicks shift))) {
                this.afterReview()
                return "review"
            }
            if review.typing {
                review.typing = false
                review.changed()
                if (focus == "review") {
                    focus = (? (mode == "present") "stage" "editor")
                }
            }
        }
        if (mode == "present") {
            ; a replay is watched, not driven (the bar and the keys are the
            ; host's)
            if replaying {
                return "stage"
            }
            this.stageDown(x y)
            return "stage"
        }
        stripAdd = (this.addAt(x y))
        if (addOpen && ((strlen stripAdd) == 0)) {
            addOpen = false
            chromeRev = (chromeRev + 1)
        }
        ; the surfaces over the chrome, the top one first (`layerAt`): an
        ; open menu or list of the bar takes every press (a row, or anywhere
        ; else to close it); a window pressed comes to the front; a press
        ; outside a window closes it, unless it lands in a dialog over it;
        ; Document settings stays open (docSetLeave), so the slides it
        ; changes can be picked and looked at
        def top:string (this.layerAt(x y))
        if (top == "bar") {
            toolbar.pressWith(x y clicks shift)
            this.takeToolbar()
            return "bar"
        }
        if (top == "sketch") {
            focus = "sketch"
            this.sketchPress(x y clicks)
            return "sketch"
        }
        if chart.isOpen {
            if (top == "chart") {
                if (chart.mode == "docset") {
                    this.docSetEnter()
                }
                layers.raise("chart")
                chart.touch = touch
                chart.press(x y clicks shift)
                this.afterChart()
                return "chart"
            }
            if (top != "dialog") {
                if (chart.mode == "docset") {
                    this.docSetLeave()
                } {
                    this.closeChart()
                }
            }
        }
        if hint.isOpen {
            if (top == "hint") {
                layers.raise("hint")
                hint.press(x y clicks shift)
                this.afterHint()
                return "hint"
            }
            if (top != "dialog") {
                this.closeHint()
            }
        }
        if (top == "room") {
            room.press(x y clicks shift)
            this.afterRoom()
            return "room"
        }
        if (focus == "room") {
            focus = "editor"
            room.ch.keys = ""
            room.closeMenu()
            room.changed()
        }
        if (PresApp.panelLayer(top)) {
            if (panels.chatHas(x y)) {
                focus = "chat"
            }
            panels.touch = touch
            panels.press(x y clicks shift)
            this.takePanels()
            return "panel"
        }
        ; a press anywhere else lets go of what was selected in the panels
        panels.dropSelection()
        ; a press off the slide (and off the pick's buttons) lets the pick go
        if (pick.on && ((slideRect.has(x y)) == false)) {
            if (((stageArea.has(x y)) == false) || ((strlen (pick.partAt(x y))) == 0)) {
                pick.clear()
                chromeRev = (chromeRev + 1)
            }
        }
        if ((barH > 0.0) && (toolbar.has(x y))) {
            toolbar.pressWith(x y clicks shift)
            this.takeToolbar()
            return "bar"
        }
        if (deckRect.has(x y)) {
            ; a presentation's tab: back to the slides
            if room.open {
                push requests "roomchat:close"
            }
            this.deckPress(x y)
            chromeRev = (chromeRev + 1)
            return "decktabs"
        }
        if (sepRect.has(x y)) {
            splitDrag = true
            return "sep"
        }
        if (tabRect.has(x y)) {
            def hitTab:string (this.tabAt(x))
            if ((hitTab == "files") && ((strlen filePath) > 0)) {
                ; the list again
                this.closeFile()
                this.showTab("files")
                return "editor"
            }
            if ((strlen hitTab) > 0) {
                this.showTab(hitTab)
            }
            return "editor"
        }
        if (edRect.has(x y)) {
            def px:int (to_int x)
            def py:int (to_int y)
            if (clicks >= 3) {
                editor.selectLineAt(tr px py)
            } {
                if (clicks == 2) {
                    editor.selectWordAt(tr px py)
                } {
                    editor.pointerDown(tr px py shift)
                    editorDrag = true
                }
            }
            focus = "editor"
            this.syncEditor()
            chromeRev = (chromeRev + 1)
            return "editor"
        }
        if ((trackRect.has(x y)) && recEditing) {
            this.recTimelineDown(x y)
            return ""
        }
        if (trackRect.has(x y)) {
            ; the Speech lane with the recording on it: played from this slide
            def speechY:double ((trackRect.y + 28.0) + 28.0)
            if ((((x >= laneX) && (x <= (laneX + laneW))) && ((y >= speechY) && (y <= (speechY + 26.0)))) && ((array_length (take.slideSpans(selected))) >= 2)) {
                this.replayFromSlide()
                return ""
            }
            if ((x >= laneX) && (x <= (laneX + laneW))) {
                if playing {
                    this.stop()
                }
                scrubDrag = true
                this.scrubTo(x)
                return "scrub"
            }
            return ""
        }
        if (stripRect.has(x y)) {
            stripIdx = -1
            def i:int 0
            while (i < (deck.slideCount())) {
                def tx:double (this.thumbX(i))
                if ((x >= tx) && (x <= (tx + thumbW))) {
                    stripIdx = i
                }
                i = (i + 1)
            }
            ; selected when let go without having moved (pointerUp); a drag
            ; moves the slide pressed on (a mouse) or scrolls the strip
            stripPressed = true
            pressShift = shift
            stripDragging = false
            stripReorder = false
            stripDrop = -1
            stripDownX = x
            stripLastX = x
            ; the keys go to the strip now, not to the editor (the "+" leaves
            ; them: a new slide's heading is typed in the editor)
            if ((strlen stripAdd) == 0) {
                focus = "strip"
                chromeRev = (chromeRev + 1)
            }
            return "thumb"
        }
        ; the pick's buttons and spacing bands, over the slide and around it
        if (stageArea.has(x y)) {
            def part:string (pick.partAt(x y))
            ; a picked picture's edges resize it, the picture itself moves it
            if (((part != "content") && (part != "style")) && (this.imageGrab(x y clicks))) {
                focus = "stage"
                chromeRev = (chromeRev + 1)
                return "select"
            }
            if ((strlen part) > 0) {
                focus = "stage"
                this.pickPress(part)
                return "select"
            }
        }
        if ((mode == "edit") && ((this.partnerAt(x y)) >= 0)) {
            ; a book's facing page: the press turns to it
            this.selectSlide((this.partnerAt(x y)))
            focus = "stage"
            return "stage"
        }
        if (slideRect.has(x y)) {
            ; a double click on a chart picks it and opens its settings
            if ((clicks == 2) && (this.openChartAt(x y))) {
                this.pickAt(x y)
                return "chart"
            }
            ; …and on a picture, the picture's
            if ((clicks == 2) && (this.openImageAt(x y))) {
                this.pickAt(x y)
                return "chart"
            }
            focus = "stage"
            downClicks = clicks
            this.stageDown(x y)
            chromeRev = (chromeRev + 1)
            return "stage"
        }
        return ""
    }

    ; A press on the stage is a click (on release, when the pointer has not
    ; moved) or a drag that pans a diagram's view.
    def stagePressed:boolean false
    def stagePanning:boolean false
    def stageDia:int -1
    def downX:double 0.0
    def downY:double 0.0
    def lastX:double 0.0
    def lastY:double 0.0

    fn stageDown:void (x:double y:double) {
        stagePressed = true
        stagePanning = false
        downX = x
        downY = y
        lastX = x
        lastY = y
        stageDia = -1
        tapDia = -1
        if (slideRect.has(x y)) {
            this.slidePoint(x y)
            stageDia = (deck.diagramAt(selected spX spY))
            tapDia = stageDia
            ; a finger pans a diagram only once it has been tapped
            if (touch && (stageDia != activeDia)) {
                stageDia = -1
            }
            ; with the pen a press that moves draws; the text tool's press
            ; is where writing begins
            if (this.inkActive()) {
                inkPress = true
                inkLine = false
                inkSX = spX
                inkSY = spY
                inkEnded = ink.typing
                if (inkTool == "text") {
                    this.inkTextAt(spX spY)
                    inkLine = true
                } {
                    this.inkEndText()
                }
            }
        }
    }
    def tapDia:int -1
    ; how many clicks the stage's press was (2 a double click)
    def downClicks:int 1

    def dragSlop:double 6.0
    ; how far a finger moves sideways for a swipe to change the slide
    def swipeMin:double 40.0

    fn setDragSlop:void (px:double) {
        dragSlop = px
    }

    fn stageMove:void (x:double y:double) {
        if (inkPress && (inkTool == "text")) {
            return
        }
        if inkPress {
            if (inkLine == false) {
                def ix:double (x - downX)
                def iy:double (y - downY)
                if (((ix * ix) + (iy * iy)) < (dragSlop * dragSlop)) {
                    return
                }
                inkLine = true
                this.inkDown(inkSX inkSY)
            }
            this.slidePoint(x y)
            this.inkMove(spX spY)
            ink.pointer(spX spY (this.inkNow()))
            if recording {
                recorder.pointer(recT spX spY)
            }
            return
        }
        if ((stageDia < 0) && (viewZoom > 1.0)) {
            ; zoomed in: a drag off a diagram moves the view
            if (! stagePanning) {
                def vx:double (x - downX)
                def vy:double (y - downY)
                if (((vx * vx) + (vy * vy)) < (dragSlop * dragSlop)) {
                    return
                }
                stagePanning = true
            }
            this.viewPinch(x y 1.0 (x - lastX) (y - lastY))
            lastX = x
            lastY = y
            return
        }
        if (stageDia < 0) {
            ; where the press went: a swipe changes the slide on release
            lastX = x
            lastY = y
            return
        }
        def hit@(optional):PresDiaUse (deck.diagramUse(selected stageDia))
        if (null? hit) {
            return
        }
        def u:PresDiaUse (unwrap hit)
        if (! stagePanning) {
            def mx:double (x - downX)
            def my:double (y - downY)
            if (((mx * mx) + (my * my)) < (dragSlop * dragSlop)) {
                return
            }
            stagePanning = true
            u.diagram.uiNow = deck.uiNow
            u.diagram.panStart()
        }
        def sc:double (this.slideScale())
        u.diagram.uiNow = deck.uiNow
        u.diagram.panBy(((x - lastX) / sc) ((y - lastY) / sc))
        lastX = x
        lastY = y
        chromeRev = (chromeRev + 1)
    }

    fn stageUp:void () {
        if (! stagePressed) {
            return
        }
        stagePressed = false
        if inkPress {
            inkPress = false
            if inkLine {
                inkLine = false
                if (inkTool != "text") {
                    this.inkUp()
                }
                return
            }
            ; a click that ended the writing does only that
            if inkEnded {
                inkEnded = false
                return
            }
        }
        if stagePanning {
            stagePanning = false
            return
        }
        if (touch && (tapDia != activeDia)) {
            activeDia = tapDia
            activatedNow = ((tapDia >= 0) && (mode == "edit"))
        }
        ; a swipe sideways: left for the next slide, right for the one before
        def dx:double (lastX - downX)
        def dy:double (lastY - downY)
        def adx:double (fabs dx)
        def ady:double (fabs dy)
        def swiped:boolean ((adx >= swipeMin) && (adx > (ady * 1.2)))
        if (mode == "present") {
            ; (from the end panel straight to it); a press that went
            ; elsewhere does nothing
            if swiped {
                if (dx < 0.0) {
                    this.next()
                } {
                    ended = false
                    this.prev()
                }
                chromeRev = (chromeRev + 1)
                return
            }
            if (((adx * adx) + (ady * ady)) >= (swipeMin * swipeMin)) {
                return
            }
            if (! (this.stagePress(downX downY))) {
                ; a link on the slide goes where it points; elsewhere on
                ; it, the next step
                def plink:string (this.linkUnder(downX downY))
                if ((strlen plink) > 0) {
                    push requests ("link:" + plink)
                } {
                    this.next()
                }
            }
        } {
            if swiped {
                this.selectSlide((? (dx < 0.0) (selected + 1) (selected - 1)))
                chromeRev = (chromeRev + 1)
                return
            }
            ; a diagram's or a table's own controls take the press first; the
            ; click is the slide's all the same (PresStageClick)
            this.stagePress(downX downY)
            this.stageClick(downX downY)
        }
        chromeRev = (chromeRev + 1)
    }

    fn scrubTo:void (x:double) {
        if ((deck.slideCount()) == 0) {
            return
        }
        def s:PresSlide (deck.slideAt(selected))
        def t:double (((x - laneX) / laneW) * s.duration)
        if (t < 0.0) { t = 0.0 }
        if (t >= s.duration) {
            localT = -1.0
        } {
            localT = t
        }
        chromeRev = (chromeRev + 1)
    }

    fn pointerMove:void (x:double y:double) {
        if (sketch.busy()) {
            sketch.move(x y (this.sketchModel()))
            chromeRev = (chromeRev + 1)
            return
        }
        if (imgDrag.active()) {
            this.imageDragTo(x y)
            return
        }
        if deckDown {
            this.deckMove(x y)
            return
        }
        ; a drag selecting in the deck's name (or the rooms' search) in the bar
        if toolbar.titleSelecting {
            toolbar.titleDragTo(x)
            chromeRev = (chromeRev + 1)
            return
        }
        ; a presentation of a Rooms list dragged towards another room
        if (toolbar.roomDragging()) {
            toolbar.roomDragTo(x y)
            chromeRev = (chromeRev + 1)
            return
        }
        ; a drag selecting in the channel's text fields, or its thread's width
        if (room.dragging()) {
            room.dragTo(x y)
            chromeRev = (chromeRev + 1)
            return
        }
        ; a drag selecting in a comment's text field
        if review.selecting {
            review.dragTo(x y)
            chromeRev = (chromeRev + 1)
            return
        }
        ; the comment's callout held by its head (presenting)
        if review.co.dragging {
            this.place()
            review.calloutDrag(x y)
            chromeRev = (chromeRev + 1)
            return
        }
        ; a comment's pin held: dragged to another place
        if ((strlen review.pinDown) > 0) {
            this.place()
            review.dragPin(x y)
            chromeRev = (chromeRev + 1)
            return
        }
        ; a drag selecting in the chat's text field
        if panels.chatSelecting {
            panels.chatDragTo(x y)
            chromeRev = (chromeRev + 1)
            return
        }
        ; a finger scrolling a dialog
        if (panels.dialogPanning()) {
            panels.dialogPanTo(y)
            chromeRev = (chromeRev + 1)
            return
        }
        ; ...or in a text of the panels (the toast, a note, a link)
        if panels.textSelecting {
            panels.textDragTo(x y)
            chromeRev = (chromeRev + 1)
            return
        }
        if ((barH > 0.0) && (mode != "present")) {
            toolbar.hoverAt(x y)
        }
        ; hover is the top surface's: one under a window shows none
        def top:string (this.layerAt(x y))
        this.chromeHoverAt(x y top)
        def sketchBefore:int sketch.rev
        if (top == "sketch") {
            sketch.hoverAt(x y)
        } {
            sketch.hoverAt(-1000000.0 -1000000.0)
        }
        if (sketch.rev != sketchBefore) {
            chromeRev = (chromeRev + 1)
        }
        def winBefore:int (chart.rev + review.rev)
        if chart.isOpen {
            chart.hoverAt(x y (top == "chart"))
        }
        if review.on {
            review.hoverAt(x y (top == "review"))
        }
        if ((chart.rev + review.rev) != winBefore) {
            chromeRev = (chromeRev + 1)
        }
        this.diagramPointer(x y top)
        if ((mode == "present") && (inkPress == false)) {
            this.inkHover(x y)
        }
        if (panels.any()) {
            if (PresApp.panelLayer(top)) {
                panels.hoverAt(x y)
            } {
                panels.hoverAt(-1000000.0 -1000000.0)
            }
        }
        if hint.isOpen {
            if (hint.dragging()) {
                hint.dragTo(x y)
                this.afterHint()
                return
            }
            def tipBefore:int hint.rev
            if (top == "hint") {
                hint.hoverAt(x y)
            } {
                hint.hoverAt(-1000000.0 -1000000.0)
            }
            if (hint.rev != tipBefore) {
                chromeRev = (chromeRev + 1)
            }
        }
        if (chart.isOpen && (chart.dragging())) {
            chart.dragTo(x y)
            ; a slider or the picker shows on the slide as it moves, not only
            ; when it is let go (at most every 50 ms: each write lays the
            ; deck out again)
            if (((chart.win.dragging == false) && ((chart.win.panning()) == false)) && ((deck.uiNow - chartLiveAt) >= 0.05)) {
                chartLiveAt = deck.uiNow
                if (chartUndoBase < 0) {
                    chartUndoBase = (array_length mdEditor.buf.undoStack)
                }
                this.writeChart()
                this.mergeChartUndo()
            }
            chromeRev = (chromeRev + 1)
            return
        }
        if splitDrag {
            def f:double ((x - (this.leftW())) / (W - (this.leftW())))
            if (f < 0.2) { f = 0.2 }
            if (f > 0.7) { f = 0.7 }
            split = f
            chromeRev = (chromeRev + 1)
            return
        }
        if editorDrag {
            editor.pointerDrag(tr (to_int x) (to_int y))
            chromeRev = (chromeRev + 1)
            return
        }
        if scrubDrag {
            this.scrubTo(x)
        }
        if (recPress || recScrub) {
            this.recTimelineMove(x)
        }
        if stripPressed {
            if (! stripDragging) {
                if ((fabs (x - stripDownX)) < dragSlop) {
                    return
                }
                stripDragging = true
                stripReorder = (((stripIdx >= 0) && (touch == false)) && ((deck.slideCount()) > 1))
                if stripReorder {
                    ; picked up where it is drawn, held where it was grabbed
                    def sx:double (this.thumbDrawX(stripIdx))
                    stripGrabDx = (stripDownX - sx)
                    stripMove.start((deck.slideCount()) stripIdx (this.stripCarryAt(stripDownX)) deck.uiNow)
                }
            }
            if stripReorder {
                ; near an edge the strip scrolls under the slide being carried
                if (x < (stripRect.x + 40.0)) {
                    this.scrollStrip(-12.0)
                }
                if (x > ((stripRect.x + stripRect.w) - 40.0)) {
                    this.scrollStrip(12.0)
                }
                stripMove.carry((this.stripCarryAt(x)) deck.uiNow)
                stripDrop = (stripMove.slot())
                stripLastX = x
                chromeRev = (chromeRev + 1)
                return
            }
            this.scrollStrip((stripLastX - x))
            stripLastX = x
            return
        }
        if stagePressed {
            this.stageMove(x y)
            return
        }
        this.pickHover(x y)
    }

    fn pointerUp:void () {
        if (sketch.busy()) {
            sketch.release((this.sketchModel()))
            this.afterSketch()
        }
        if (imgDrag.active()) {
            this.imageDrop()
        }
        if deckDown {
            this.deckRelease()
        }
        if (toolbar.roomDragging()) {
            toolbar.roomDragEnd()
            this.takeToolbar()
        }
        toolbar.titleRelease()
        if (review.release()) {
            this.reviewSpots()
            this.afterReview()
            chromeRev = (chromeRev + 1)
        }
        if (room.release()) {
            this.afterRoom()
        }
        panels.chatRelease()
        panels.textRelease()
        ; a finger on a dialog that did not scroll is a tap, pressed now
        if (panels.dialogPanning()) {
            if (panels.dialogPanEnd()) {
                this.takePanels()
            }
            chromeRev = (chromeRev + 1)
        }
        if (hint.isOpen && (hint.dragging())) {
            hint.release()
            this.afterHint()
        }
        if chart.isOpen {
            ; a finger's tap on the window is pressed as it lifts
            def tapped:boolean (chart.release())
            this.writeChart()
            this.mergeChartUndo()
            if tapped {
                this.afterChart()
            }
        }
        chartUndoBase = -1
        if editorDrag {
            this.followCaret()
        }
        editorDrag = false
        splitDrag = false
        scrubDrag = false
        if (recPress || recScrub) {
            this.recTimelineUp()
        }
        if stripPressed {
            stripPressed = false
            if ((! stripDragging) && (stripIdx >= 0)) {
                if playing {
                    playing = false
                }
                if pressCtrl {
                    picks.toggle(stripIdx selected)
                } {
                    if pressShift {
                        picks.extend(stripIdx selected)
                    } {
                        picks.clear()
                    }
                }
                this.pickChanged()
                this.selectSlide(stripIdx)
            }
            if ((! stripDragging) && ((strlen stripAdd) > 0)) {
                if playing {
                    playing = false
                }
                if ((stripAdd == "open") && ((deck.slideCount()) > 0)) {
                    addOpen = true
                    this.revealThumb((deck.slideCount()))
                    chromeRev = (chromeRev + 1)
                } {
                    this.addSlide((stripAdd == "dup"))
                }
            }
            if stripReorder {
                ; let go: the slide glides from the pointer into its gap
                def moved:boolean false
                if (stripDrop >= 0) {
                    moved = (this.moveSlideTo(stripIdx stripDrop))
                }
                stripMove.finish(moved deck.uiNow)
            }
            stripAdd = ""
            stripDragging = false
            stripReorder = false
            stripDrop = -1
            chromeRev = (chromeRev + 1)
        }
        this.stageUp()
    }

    ; A presentation's row of the Rooms panel, or a deck tab, at x, y (its
    ; menu opens there).
    fn inDeckRow:boolean (x:double y:double) {
        this.place()
        if ((mode == "present") || (barH <= 0.0)) {
            return false
        }
        return (((strlen (toolbar.roomDeckAt(x y))) > 0) || ((strlen (this.deckTabKeyAt(x y))) > 0))
    }

    fn inStrip:boolean (x:double y:double) {
        this.place()
        return ((mode != "present") && (stripRect.has(x y)))
    }

    ; The slide whose thumbnail is at x, y on the strip, or -1.
    fn thumbIndexAt:int (x:double y:double) {
        def ty:double (this.thumbY())
        if ((y < ty) || (y > (ty + thumbH))) {
            return -1
        }
        def i:int 0
        while (i < (deck.slideCount())) {
            def tx:double (this.thumbX(i))
            if ((x >= tx) && (x <= (tx + thumbW))) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn scrollStrip:void (d:double) {
        stripScroll = (stripScroll + d)
        ; the thumbnails and the "+" after them
        def most:double (((to_double ((deck.slideCount()) + 1)) * (thumbW + thumbGap)) - (stripRect.w - 24.0))
        if (stripScroll > most) { stripScroll = most }
        if (stripScroll < 0.0) { stripScroll = 0.0 }
        chromeRev = (chromeRev + 1)
    }

    ; A wheel or a trackpad: mostly sideways over the editor scrolls it
    ; sideways, everything else goes where a vertical wheel goes.
    fn wheelXY:boolean (x:double y:double dx:double dy:double) {
        if ((this.layerAt(x y)) == "chart") {
            if (chart.wheel(dy)) {
                chromeRev = (chromeRev + 1)
            }
            return true
        }
        if ((deckRect.has(x y)) && ((this.layerAt(x y)) == "")) {
            if ((fabs dx) > (fabs dy)) {
                this.deckWheelBy(dx)
            }
            return true
        }
        if (((mode != "present") && (edRect.has(x y))) && ((fabs dx) > (fabs dy))) {
            editor.scrollByX((to_int dx))
            chromeRev = (chromeRev + 1)
            return true
        }
        def d:double dy
        if ((fabs dx) > (fabs dy)) {
            d = dx
        }
        return (this.wheel(x y d))
    }

    fn wheel:boolean (x:double y:double dy:double) {
        if ((this.layerAt(x y)) == "room") {
            room.wheel(x y dy)
            this.afterRoom()
            return true
        }
        if (review.on && ((this.layerAt(x y)) == "review")) {
            if (review.wheel(x y dy)) {
                chromeRev = (chromeRev + 1)
                return true
            }
        }
        if (mode == "present") {
            return false
        }
        if (recEditing && (trackRect.has(x y))) {
            this.recTimelineWheel(dy)
            return true
        }
        ; a dialog, or a window over what is under the pointer, keeps the wheel
        def top:string (this.layerAt(x y))
        if (top == "hint") {
            hint.wheel(dy)
            chromeRev = (chromeRev + 1)
            return true
        }
        ; a dialog taller than the page scrolls; the presentations window's
        ; wheel otherwise turns its pages
        if ((top == "dialog") && (panels.dialogWheel(dy))) {
            chromeRev = (chromeRev + 1)
            return true
        }
        if ((top == "dialog") && (panels.decksShowing())) {
            panels.decksWheel(dy)
            chromeRev = (chromeRev + 1)
            return true
        }
        if (top == "chart") {
            if (chart.wheel(dy)) {
                chromeRev = (chromeRev + 1)
            }
            return true
        }
        if (top == "dialog") {
            return true
        }
        if (panels.helpHas(x y)) {
            panels.scrollBy(dy)
            chromeRev = (chromeRev + 1)
            return true
        }
        if (panels.chatHas(x y)) {
            panels.chat.scrollBy((? (dy < 0.0) -1 1))
            panels.rebuild()
            chromeRev = (chromeRev + 1)
            return true
        }
        if (panels.filesHas(x y)) {
            if ((strlen filePath) == 0) {
                panels.filesScrollBy(dy)
            }
            chromeRev = (chromeRev + 1)
            return true
        }
        if (edRect.has(x y)) {
            def lines:int (to_int (dy / 20.0))
            if (lines == 0) {
                lines = (? (dy < 0.0) -1 1)
            }
            editor.scrollBy((0 - lines))
            chromeRev = (chromeRev + 1)
            return true
        }
        if (stripRect.has(x y)) {
            this.scrollStrip(dy)
            return true
        }
        return false
    }

    ; Which tab is under x: its box as the chrome's last layout placed it.
    fn tabAt:string (x:double) {
        def i:int 0
        while (i < (array_length laidTabs.items)) {
            def it:UiItem (itemAt laidTabs.items i)
            def el:EVGElement (unwrap it.el)
            if ((x >= el.calculatedX) && (x <= (el.calculatedX + el.calculatedWidth))) {
                return it.value
            }
            i = (i + 1)
        }
        return ""
    }

    ; A tip for what is under the pointer (main.js shows it): review mode's
    ; bar and pins say what they are; "" elsewhere.
    fn tipAt:string (x:double y:double) {
        this.place()
        if ((review.dragging || review.co.dragging) || ((strlen review.pinDown) > 0)) {
            return ""
        }
        if (review.on && ((this.layerAt(x y)) == "review")) {
            return (review.tipAt(x y))
        }
        return ""
    }

    fn cursorAt:string (x:double y:double) {
        this.place()
        if (review.dragging || review.co.dragging) {
            return "grabbing"
        }
        if room.resizing {
            return "col-resize"
        }
        if (room.open && (mode != "present")) {
            if (room.hoverAt(x y)) {
                chromeRev = (chromeRev + 1)
            }
            if ((this.layerAt(x y)) == "room") {
                def mc:string (room.cursorAt(x y))
                return (? ((strlen mc) > 0) mc "default")
            }
        }
        if (review.on && ((this.layerAt(x y)) == "review")) {
            def rc:string (review.cursorAt(x y))
            if ((strlen rc) > 0) {
                return rc
            }
        }
        if (mode == "present") {
            ; with the pen the slide's pointer is the one drawn (and recorded)
            if ((this.inkActive()) && (slideRect.has(x y))) {
                return "none"
            }
            if ((strlen (this.linkUnder(x y))) > 0) {
                return "pointer"
            }
            return "default"
        }
        ; the surface on top under the pointer says (the bar's open menu
        ; below, with the bar)
        def top:string (this.layerAt(x y))
        if (top == "sketch") {
            return (this.sketchCursor(x y))
        }
        if (((strlen top) > 0) && (top != "bar")) {
            def lc:string ""
            if (top == "hint") {
                lc = (hint.cursorAt(x y))
            }
            if (top == "chart") {
                lc = (chart.cursorAt(x y))
            }
            if (PresApp.panelLayer(top)) {
                lc = (panels.cursorAt(x y))
            }
            if ((strlen lc) > 0) {
                return lc
            }
            return "default"
        }
        if ((barH > 0.0) && (toolbar.has(x y))) {
            return (toolbar.cursorAt(x y))
        }
        if ((deckRect.has(x y)) && ((strlen (deckTabs.hitAt(x y))) > 0)) {
            return "pointer"
        }
        if (tabRect.has(x y)) {
            if ((strlen (this.tabAt(x))) > 0) {
                return "pointer"
            }
        }
        if (sepRect.has(x y)) {
            return "col-resize"
        }
        if (imgDrag.active()) {
            if (imgDrag.zone == "move") {
                return "grabbing"
            }
            return (PresImageDrag.cursorOf(imgDrag.zone))
        }
        if ((stageArea.has(x y)) && ((strlen (pick.partAt(x y))) > 0)) {
            def cpart:string (pick.partAt(x y))
            if ((cpart == "content") || (cpart == "style")) {
                return "pointer"
            }
        }
        if (stageArea.has(x y)) {
            def iz:string (pick.imageZoneAt(x y))
            if ((strlen iz) > 0) {
                return (PresImageDrag.cursorOf(iz))
            }
        }
        if ((stageArea.has(x y)) && ((strlen (pick.partAt(x y))) > 0)) {
            return "pointer"
        }
        if (((playing == false) && ((this.inkActive()) == false)) && ((strlen (this.linkUnder(x y))) > 0)) {
            return "pointer"
        }
        if (edRect.has(x y)) {
            return "text"
        }
        if stripReorder {
            return "grabbing"
        }
        if (stripRect.has(x y)) {
            ; a thumbnail can be carried to another place: a hand that grabs
            if ((this.thumbIndexAt(x y)) >= 0) {
                if ((deck.slideCount()) > 1) {
                    return "grab"
                }
            }
            return "pointer"
        }
        if (trackRect.has(x y)) {
            if (x >= laneX) {
                return "ew-resize"
            }
        }
        return "default"
    }

    ; =========================================================================
    ; The keyboard
    ; =========================================================================
    sfn keyByName:int (name:string) {
        if (name == "backspace") { return (UIKey.backspace()) }
        if (name == "enter")     { return (UIKey.enter()) }
        if (name == "tab")       { return (UIKey.tab()) }
        if (name == "escape")    { return (UIKey.escape()) }
        if (name == "left")      { return (UIKey.left()) }
        if (name == "right")     { return (UIKey.right()) }
        if (name == "up")        { return (UIKey.up()) }
        if (name == "down")      { return (UIKey.down()) }
        if (name == "delete")    { return (UIKey.del()) }
        if (name == "home")      { return (UIKey.home()) }
        if (name == "end")       { return (UIKey.end()) }
        if (name == "pageUp")    { return (UIKey.pageUp()) }
        if (name == "pageDown")  { return (UIKey.pageDown()) }
        return 0
    }

    fn key:boolean (name:string shift:boolean ctrl:boolean) {
        ; the deck's name being edited in the bar has the keys
        if ((barH > 0.0) && toolbar.titleEditing) {
            def usedT:boolean (toolbar.titleKey(name shift ctrl))
            this.takeToolbar()
            return usedT
        }
        if (this.roomHasKeys()) {
            return (this.roomKey(name shift ctrl))
        }
        if (review.hasKeys()) {
            return (this.reviewKey(name shift ctrl))
        }
        if ((((sketch.on || (sketch.menuOpen())) && (mode != "present")) && (focus == "sketch")) && (ctrl == false)) {
            if (sketch.key(name shift (this.sketchModel()))) {
                this.afterSketch()
                return true
            }
        }
        if ((name == "escape") && (review.escape())) {
            if (focus == "review") {
                focus = (? (mode == "present") "stage" "editor")
            }
            chromeRev = (chromeRev + 1)
            return true
        }
        ; a picture being resized or moved: Esc lets it go unchanged
        if ((name == "escape") && (imgDrag.active())) {
            imgDrag.cancel()
            pick.ghostOn = false
            chromeRev = (chromeRev + 1)
            return true
        }
        if (((name == "escape") && pick.on) && (((hint.isOpen == false) && (mode != "present")) && (focus == "stage"))) {
            pick.clear()
            chromeRev = (chromeRev + 1)
            return true
        }
        if (panels.shareOpen && (mode != "present")) {
            if (name == "escape") {
                panels.closeShare()
                chromeRev = (chromeRev + 1)
            }
            return true
        }
        if (this.chatHasKeys()) {
            return (this.chatKey(name shift ctrl))
        }
        if (((barH > 0.0) && (toolbar.listOpen())) && (name == "escape")) {
            toolbar.closeLists()
            chromeRev = (chromeRev + 1)
            return true
        }
        if (hint.isOpen && (mode != "present")) {
            if (name == "escape") {
                this.closeHint()
                return true
            }
            if (hint.hasKeys()) {
                def usedH:boolean (hint.key(name shift ctrl))
                this.afterHint()
                return usedH
            }
        }
        if ((this.chartHasKeys()) && (mode != "present")) {
            def used:boolean (chart.key(name shift ctrl))
            this.afterChart()
            return used
        }
        ; a replay: Esc ends it, nothing else drives it (the host's keys
        ; pause and seek it)
        if ((mode == "present") && replaying) {
            if (name == "escape") {
                this.replayStop()
            }
            return true
        }
        ; the pen has the keyboard: writing, and only the arrows and Page Up /
        ; Page Down change slides
        if (this.inkActive()) {
            if (this.inkKey(name shift)) {
                return true
            }
        }
        ; Backspace wipes what was drawn
        if ((((mode == "present") && (name == "backspace")) && ((ink.count()) > 0)) && ((nav.typing()) == false)) {
            this.inkClear()
            return true
        }
        ; a slide number being typed: Enter goes there, Esc forgets it
        if ((mode == "present") && (nav.typing())) {
            if (name == "enter") {
                def k:int (nav.take((deck.slideCount())))
                this.jump((PresNav.whole(deck k)))
                return true
            }
            if (name == "escape") {
                this.navClear()
                return true
            }
            if (name == "backspace") {
                nav.typed = (substring nav.typed 0 ((strlen nav.typed) - 1))
                chromeRev = (chromeRev + 1)
                return true
            }
            nav.clear()
            chromeRev = (chromeRev + 1)
        }
        if ((mode == "present") || (focus == "stage")) {
            if (this.diagramKey(name)) {
                return true
            }
        }
        if (mode == "present") {
            if (((name == "right") || (name == "down")) || (name == "enter")) {
                this.next()
                return true
            }
            if ((name == "left") || (name == "up")) {
                this.prev()
                return true
            }
            if (name == "pageDown") {
                this.pageNext()
                return true
            }
            if (name == "pageUp") {
                this.pagePrev()
                return true
            }
            if (name == "escape") {
                this.endPresent()
                return true
            }
            if (name == "home") {
                this.firstSlide()
                return true
            }
            if (name == "end") {
                this.lastSlide()
                return true
            }
            return false
        }
        if (focus == "strip") {
            return (this.stripKey(name shift ctrl))
        }
        if (focus == "stage") {
            ; the picked picture: Delete or Backspace takes it out (Ctrl+Z
            ; brings it back)
            if (((name == "delete") || (name == "backspace")) && (pick.on && (pick.sel == "img"))) {
                if (this.pickValid()) {
                    this.removePickedImage()
                    return true
                }
            }
            if ((name == "right") || (name == "down")) {
                this.selectSlide((selected + 1))
                return true
            }
            if ((name == "left") || (name == "up")) {
                this.selectSlide((selected - 1))
                return true
            }
            return false
        }
        if (focus != "editor") {
            return false
        }
        if (this.filesListShowing()) {
            return false
        }
        def code:int (PresApp.keyByName(name))
        if (code == 0) {
            return false
        }
        editor.handleKey(code shift ctrl)
        this.syncEditor()
        chromeRev = (chromeRev + 1)
        return true
    }

    ; Ctrl+Z / Ctrl+Y with the keyboard on the strip: the Markdown's undo, and
    ; the slide the edit was in selected (a deleted slide back is selected
    ; again, not the one after it).
    fn stripUndo:boolean (back:boolean) {
        def was:string focus
        if (edTab != "md") {
            this.showTab("md")
        }
        focus = was
        def line:int -1
        def st:[EditorUndoOp] mdEditor.buf.undoStack
        if (back == false) {
            st = mdEditor.buf.redoStack
        }
        def k:int (array_length st)
        if (k > 0) {
            def op:EditorUndoOp (itemAt st (k - 1))
            line = op.startLine
        }
        this.clipLink("md" back)
        if back {
            mdEditor.undo()
        } {
            mdEditor.redo()
        }
        this.syncEditor()
        if (line >= 0) {
            this.selectSlide((deck.pageOfOffset((this.offsetOf(line 0)))))
        }
        a11yFocus = ("thumb-" + (to_string selected))
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The filmstrip's keys: the arrows, Home and End move between slides,
    ; Ctrl/⌘ with an arrow moves the slide, Delete and Backspace delete it
    ; (Ctrl+Z brings it back), Enter edits it and Esc goes back to the
    ; editor. The keyboard stays on the strip, on the selected slide.
    fn stripKey:boolean (name:string shift:boolean ctrl:boolean) {
        def n:int (deck.slideCount())
        def used:boolean true
        def back:boolean ((name == "left") || (name == "up"))
        def fwd:boolean ((name == "right") || (name == "down"))
        if (ctrl && (back || fwd)) {
            this.slideCommand((? back "left" "right"))
        } {
            if (shift && (back || fwd)) {
                ; Shift + an arrow: the pick runs from where it began
                def to:int (? back (selected - 1) (selected + 1))
                if ((to >= 0) && (to < n)) {
                    if ((picks.active()) == false) {
                        picks.anchor = selected
                    }
                    picks.extend(to selected)
                    this.pickChanged()
                    this.selectSlide(to)
                }
            } {
                if (back || fwd) {
                    if (picks.active()) {
                        picks.clear()
                        this.pickChanged()
                    }
                }
                if back {
                    this.selectSlide((selected - 1))
                } {
                    if fwd {
                        this.selectSlide((selected + 1))
                    } {
                        if (name == "home") {
                            this.selectSlide(0)
                        } {
                            if (name == "end") {
                                this.selectSlide((n - 1))
                            } {
                                if ((name == "delete") || (name == "backspace")) {
                                    this.slideCommand("delete")
                                } {
                                    if ((name == "escape") && (picks.active())) {
                                        ; Esc lets the picked slides go first
                                        picks.clear()
                                        this.pickChanged()
                                    } {
                                        if ((name == "enter") || (name == "escape")) {
                                            ; Enter: the slide's heading in the editor
                                            if (name == "enter") {
                                                this.showTab("md")
                                            }
                                            focus = "editor"
                                            a11yFocus = ""
                                            chromeRev = (chromeRev + 1)
                                            return true
                                        } {
                                            used = false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if used {
            if playing {
                this.stop()
            }
            focus = "strip"
            a11yFocus = ("thumb-" + (to_string selected))
            chromeRev = (chromeRev + 1)
        }
        return used
    }

    fn text:void (s:string) {
        if ((barH > 0.0) && toolbar.titleEditing) {
            toolbar.titleType(s)
            this.takeToolbar()
            return
        }
        if (this.roomHasKeys()) {
            room.text(s)
            this.afterRoom()
            return
        }
        if (review.hasKeys()) {
            review.text(s)
            chromeRev = (chromeRev + 1)
            return
        }
        if (((sketch.on && (mode != "present")) && (focus == "sketch")) && (sketch.typing >= 0)) {
            sketch.text(s (this.sketchModel()))
            chromeRev = (chromeRev + 1)
            return
        }
        if (this.chatHasKeys()) {
            panels.chat.typeChar("" s)
            panels.rebuild()
            chromeRev = (chromeRev + 1)
            return
        }
        if ((this.chartHasKeys()) && (mode != "present")) {
            chart.type(s)
            this.afterChart()
            return
        }
        ; a field of the popover (the emoji picker's search) has the keys
        if ((hint.isOpen && (hint.hasKeys())) && (mode != "present")) {
            hint.type(s)
            this.afterHint()
            return
        }
        if ((mode == "present") && replaying) {
            return
        }
        if (this.inkWrites()) {
            this.inkType(s)
            return
        }
        ; a slide number: digits, then Enter (a number already begun takes
        ; the digits before a diagram's own keys do)
        if ((mode == "present") && (nav.typing())) {
            if (nav.digit(s)) {
                chromeRev = (chromeRev + 1)
                return
            }
            nav.clear()
            chromeRev = (chromeRev + 1)
        }
        ; T: the diagram's tour on this slide, started or stopped
        if (((mode == "present") || (focus == "stage")) && ((s == "t") || (s == "T"))) {
            if (this.toggleTour(0)) {
                return
            }
        }
        if ((mode == "present") || (focus == "stage")) {
            def asKey:string s
            if (s == " ") {
                asKey = "space"
            }
            if (this.diagramKey(asKey)) {
                return
            }
        }
        if (mode == "present") {
            if (nav.digit(s)) {
                chromeRev = (chromeRev + 1)
                return
            }
            if (s == " ") {
                this.next()
            }
            if ((s == "s") || (s == "S")) {
                speaker = (! speaker)
                chromeRev = (chromeRev + 1)
            }
            if ((s == "a") || (s == "A")) {
                auto = (! auto)
                chromeRev = (chromeRev + 1)
            }
            ; E: into the live sheet on this slide (the page moves the keyboard)
            if ((s == "e") || (s == "E")) {
                if (deck.hasLiveSheet(selected)) {
                    push requests "sheet-edit"
                }
            }
            return
        }
        if (focus != "editor") {
            return
        }
        if (this.filesListShowing()) {
            return
        }
        editor.handleText(s)
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    ; Pasted text. A paste that REPLACES the document — into an empty editor,
    ; or over a selection of all of it — is a new document, and a new
    ; document is read from its first slide: the caret goes to the top
    ; rather than being left at the end of what came in.
    fn pasteText:void (s:string) {
        if ((barH > 0.0) && toolbar.titleEditing) {
            toolbar.titleType(s)
            this.takeToolbar()
            return
        }
        if (this.roomHasKeys()) {
            room.text(s)
            this.afterRoom()
            return
        }
        if (review.hasKeys()) {
            review.text((PresReviewUi.oneLine(s)))
            chromeRev = (chromeRev + 1)
            return
        }
        if ((this.chartHasKeys()) && (mode != "present")) {
            chart.type(s)
            this.afterChart()
            return
        }
        if ((mode == "present") || (focus != "editor")) {
            return
        }
        if (this.filesListShowing()) {
            return
        }
        def whole:boolean false
        if ((edTab == "md") && ((indexOf s "\n") >= 0)) {
            if ((strlen (trim (editor.text()))) == 0) {
                whole = true
            }
            if ((editor.sel.isCollapsed()) == false) {
                def last:int ((editor.buf.lineCount()) - 1)
                def endCol:int (strlen (editor.buf.lineAt(last)))
                def a:EditorPos editor.sel.anchor
                def c:EditorPos editor.sel.caret
                def fromTop:boolean (((a.line == 0) && (a.col == 0)) || ((c.line == 0) && (c.col == 0)))
                def toEnd:boolean (((a.line == last) && (a.col == endCol)) || ((c.line == last) && (c.col == endCol)))
                if (fromTop && toEnd) {
                    whole = true
                }
            }
        }
        editor.handleText(s)
        this.syncEditor()
        if whole {
            editor.moveCaret(0 0 false)
            editor.sel.collapseToCaret()
            editor.layout.scrollLine = 0
            editor.layout.scrollX = 0
            editor.layout.ensureCaretVisible(editor.buf editor.sel)
            this.selectSlide(0)
        }
        chromeRev = (chromeRev + 1)
    }

    fn chord:boolean (ch:string) {
        ; Ctrl+A in the deck's name (or the rooms' search) in the bar
        if ((barH > 0.0) && toolbar.titleEditing) {
            if (ch == "a") {
                toolbar.titleKey("a" false true)
                this.takeToolbar()
                chromeRev = (chromeRev + 1)
            }
            return true
        }
        if (this.roomHasKeys()) {
            if (ch == "a") {
                room.selectAll()
                chromeRev = (chromeRev + 1)
            }
            return true
        }
        if (review.hasKeys()) {
            if (ch == "a") {
                review.selectAll()
                chromeRev = (chromeRev + 1)
            }
            return true
        }
        if (mode == "present") {
            return false
        }
        ; drawing: Ctrl+Z takes back the last change to a drawing
        if (sketch.on && (focus == "sketch")) {
            if (ch == "z") {
                this.sketchUndo()
            }
            return true
        }
        ; the editor's fields have no undo of their own, and an undo in the
        ; Markdown under it would move the fence it is writing
        if (this.chartHasKeys()) {
            if (ch == "a") {
                chart.selectAllInField()
                chromeRev = (chromeRev + 1)
            }
            return true
        }
        ; Ctrl+A in a field of the popover (a number, the emoji search, a
        ; colour's fields): all of its text
        if ((hint.isOpen && (hint.hasKeys())) && (ch == "a")) {
            hint.selectAllInField()
            this.afterHint()
            return true
        }
        ; Ctrl+A in the chat's field: all of its text
        if (this.chatHasKeys()) {
            if (ch == "a") {
                panels.chat.input.selectAll()
                chromeRev = (chromeRev + 1)
            }
            return true
        }
        if ((strlen ch) != 1) {
            return false
        }
        if (((focus == "strip") || (focus == "stage")) && ((ch == "z") || (ch == "y"))) {
            return (this.stripUndo((ch == "z")))
        }
        if ((ch == "z") || (ch == "y")) {
            this.clipLink((this.undoTarget()) (ch == "z"))
        }
        def took:boolean (editor.handleCtrlChar((charAt ch 0)))
        this.syncEditor()
        chromeRev = (chromeRev + 1)
        return took
    }

    ; ------------------------------------------------------------------
    ; Hints: what the value under the pointer is and could be
    ; ------------------------------------------------------------------
    ;
    ; `hintAt` answers for a point over the editor, `hintAtCaret` for the
    ; caret; both as PresHints' JSON with the value's box on the page added
    ; ("x", "y", "w", "h") and the line it is on ("line", "tab"). "" when
    ; there is nothing to say. `replaceRange` is how the page's popover
    ; writes a choice back: an ordinary edit, undone with Ctrl+Z.
    fn hintAt:string (x:double y:double) {
        if (((mode == "present") || ((edRect.has(x y)) == false)) || chart.isOpen) {
            return ""
        }
        def gutter:string (this.contrastHintAt(x y))
        if ((strlen gutter) > 0) {
            return gutter
        }
        def px:int (to_int x)
        def py:int (to_int y)
        def hit:EditorPos (editor.layout.hitTest(tr editor.buf px py))
        ; over the text itself, not the empty space after a line's end
        def endX:int (editor.caretViewX(tr hit.line (strlen (editor.buf.lineAt(hit.line)))))
        if (px > (endX + 2)) {
            return ""
        }
        return (this.hintFor(hit.line hit.col))
    }

    fn hintAtCaret:string () {
        if (mode == "present") {
            return ""
        }
        return (this.hintFor(editor.sel.caret.line editor.sel.caret.col))
    }

    fn hintFor:string (line:int col:int) {
        if ((line < 0) || (line >= (editor.buf.lineCount()))) {
            return ""
        }
        def text:string (editor.buf.lineAt(line))
        def md:string "md"
        if (edTab == "css") {
            md = "css"
        }
        def j:string ""
        if (edTab == "css") {
            j = (this.selectorHint(text col))
        }
        def inFm:boolean (this.inFrontMatter(line))
        if ((strlen j) == 0) {
            j = (PresHints.forLineIn(md text col inFm (this.ruleAt(line col)) (this.rangeBox())))
        }
        ; a `---` of the front matter: what the block is
        def fence:boolean (this.frontMatterFence(line))
        ; a picture of the deck under the caret: url(…) in the theme, ![](…) or
        ; bg= in the Markdown; its card offers the image editor and the
        ; vectorizer
        def pic:PresPicRef (PresApp.pictureAt(text col))
        if (((strlen j) == 0) && ((strlen pic.path) > 0)) {
            def ph:PresHint (PresHint.make("doc" (PresI18n.t("Image")) pic.path pic.start pic.end))
            ph.doc = (PresI18n.t("A picture of the deck's files."))
            j = (ph.json())
        }
        if ((strlen pic.path) > 0) {
            j = ((substring j 0 ((strlen j) - 1)) + ",\"picture\":" + (PresHint.q(pic.path)) + "}")
        }
        if (((strlen j) == 0) && fence) {
            def fh:PresHint (PresHint.make("doc" (PresI18n.t("Front matter")) "" 0 (strlen text)))
            fh.doc = (PresI18n.t("The deck's own settings: title, transition, header and footer."))
            j = (fh.json())
        }
        if ((strlen j) == 0) {
            return ""
        }
        ; anything in the front matter can open the whole of it as a window
        if (inFm || fence) {
            j = ((substring j 0 ((strlen j) - 1)) + ",\"docset\":true}")
        }
        ; a diagram's fence: the look it has, read from the whole block
        if ((edTab == "md") && ((indexOf j "\"looks\":[") >= 0)) {
            def dm:PresFlowModel (this.diagramAt(line))
            if dm.ok {
                j = ((substring j 0 ((strlen j) - 1)) + ",\"look\":" + (PresHint.q((dm.look()))) + "}")
            }
        }
        ; a list layout's fence: the theme's figure colours as they are drawn
        if ((edTab == "md") && ((indexOf j "\"figure\":true") >= 0)) {
            def fcl:string "["
            def fst:MdFigureStyle (deck.figureStyle())
            def fk:int 0
            while (fk < (array_length fst.colors)) {
                if (fk > 0) {
                    fcl = (fcl + ",")
                }
                fcl = (fcl + (PresHint.q((itemAt fst.colors fk))))
                fk = (fk + 1)
            }
            j = ((substring j 0 ((strlen j) - 1)) + ",\"figColors\":" + fcl + "]}")
        }
        def st:int (?? (str2int (PresApp.jsonNum(j "start"))) 0)
        def en:int (?? (str2int (PresApp.jsonNum(j "end"))) st)
        def x0:int (editor.caretViewX(tr line st))
        def x1:int (editor.caretViewX(tr line en))
        def y0:int (editor.layout.caretPixelY(line))
        def extra:string (",\"line\":" + (to_string line) + ",\"tab\":\"" + edTab + "\",\"x\":" + (to_string x0) + ",\"y\":" + (to_string y0) + ",\"w\":" + (to_string (x1 - x0)) + ",\"h\":" + (to_string editor.layout.lineHeight) + ",\"text\":" + (PresHint.q(text)) + "}")
        return ((substring j 0 ((strlen j) - 1)) + extra)
    }

    sfn isPicturePath:boolean (p:string) {
        def l:string (to_lowercase p)
        def exts:[string] ([] _:string (".png" ".jpg" ".jpeg" ".webp" ".gif" ".svg"))
        for exts e:string i {
            if (endsWith l e) {
                return true
            }
        }
        return false
    }

    ; The picture a column of a line is on: inside url(…), ![…](…) or bg=…;
    ; an empty path when none.
    sfn pictureAt:PresPicRef (line:string col:int) {
        def out (new PresPicRef())
        def n:int (strlen line)
        ; url(…)
        def at:int (indexOf line "url(")
        while (at >= 0) {
            def end:int (indexOfFrom line ")" at)
            if (end < 0) {
                end = n
            }
            if ((col >= at) && (col <= (end + 1))) {
                def p:string (PresApp.urlPath((substring line at (end + 1))))
                if (PresApp.isPicturePath(p)) {
                    out.path = p
                    out.start = (at + 4)
                    out.end = end
                    return out
                }
            }
            at = (indexOfFrom line "url(" (end + 1))
        }
        ; ![alt](path "title")
        def im:int (indexOf line "![")
        while (im >= 0) {
            def mid:int (indexOfFrom line "](" im)
            if (mid < 0) {
                im = -1
            } {
                def close:int (indexOfFrom line ")" mid)
                if (close < 0) {
                    close = n
                }
                if ((col >= im) && (col <= (close + 1))) {
                    def inner:string (trim (substring line (mid + 2) close))
                    def sp:int (indexOf inner " ")
                    if (sp > 0) {
                        inner = (substring inner 0 sp)
                    }
                    while (startsWith inner "/") {
                        inner = (substring inner 1 (strlen inner))
                    }
                    if (PresApp.isPicturePath(inner)) {
                        out.path = inner
                        out.start = (mid + 2)
                        out.end = close
                        return out
                    }
                }
                im = (indexOfFrom line "![" (close + 1))
            }
        }
        ; bg=path in an attribute block
        def bg:int (indexOf line "bg=")
        while (bg >= 0) {
            def e:int (bg + 3)
            while ((e < n) && (((charAt line e) != 32) && ((charAt line e) != 125))) {
                e = (e + 1)
            }
            if ((col >= bg) && (col <= e)) {
                def bp:string (substring line (bg + 3) e)
                def q:int 0
                if ((strlen bp) > 0) {
                    q = (charAt bp 0)
                }
                if (((q == 34) || (q == 39)) && ((strlen bp) >= 2)) {
                    bp = (substring bp 1 ((strlen bp) - 1))
                }
                while (startsWith bp "/") {
                    bp = (substring bp 1 (strlen bp))
                }
                if (PresApp.isPicturePath(bp)) {
                    out.path = bp
                    out.start = (bg + 3)
                    out.end = e
                    return out
                }
            }
            bg = (indexOfFrom line "bg=" (e + 1))
        }
        return out
    }

    ; The theme rule a column of the CSS tab is in ("" in the Markdown).
    fn ruleAt:string (line:int col:int) {
        if (edTab != "css") {
            return ""
        }
        return (PresRange.selectorAt((editor.text()) line col))
    }

    ; What a length's slider is measured against: the slide, and the picked
    ; element (before the slide grew, as the theme's values are).
    fn rangeBox:PresRangeBox () {
        def b:PresRangeBox (PresRangeBox.slide(deck.pageW deck.pageH))
        if (pick.on && (pick.grow > 0.0)) {
            b.elemW = (pick.w / pick.grow)
            b.elemH = (pick.h / pick.grow)
        }
        return b
    }

    ; A selector under the column (`page` in `page {`): what it styles, and
    ; the properties it can have — set ones with their values, the rest to
    ; add.
    fn selectorHint:string (text:string col:int) {
        def open:int (indexOf text "{")
        if ((open < 0) || (col > open)) {
            return ""
        }
        def cm:int (indexOf text "/*")
        if ((cm >= 0) && (cm < open)) {
            return ""
        }
        def a:int col
        while ((a > 0) && (PresApp.selChar((charAt text (a - 1))))) {
            a = (a - 1)
        }
        def b:int col
        while ((b < open) && (PresApp.selChar((charAt text b)))) {
            b = (b + 1)
        }
        if (b <= a) {
            return ""
        }
        def sel:string (substring text a b)
        def h:PresHint (PresHint.make("selector" sel "" a b))
        h.doc = (PresHints.selectorDoc(sel))
        def j:string (h.json())
        return ((substring j 0 ((strlen j) - 1)) + ",\"rule\":" + (PresHelp.selectorRule((this.themeCss()) sel)) + "}")
    }

    sfn selChar:boolean (c:int) {
        if ((c >= 97) && (c <= 122)) { return true }
        if ((c >= 65) && (c <= 90)) { return true }
        if ((c >= 48) && (c <= 57)) { return true }
        return ((c == 45) || ((c == 46) || ((c == 95) || (c == 35))))
    }

    ; The number after `"key":` in a flat JSON object.
    sfn jsonNum:string (j:string key:string) {
        def at:int (indexOf j ("\"" + key + "\":"))
        if (at < 0) {
            return ""
        }
        def a:int ((at + (strlen key)) + 3)
        def b:int a
        while ((b < (strlen j)) && ((((charAt j b) >= 48) && ((charAt j b) <= 57)) || ((charAt j b) == 45))) {
            b = (b + 1)
        }
        return (substring j a b)
    }

    ; Is the line inside the `---` front matter at the top?
    fn inFrontMatter:boolean (line:int) {
        if (edTab != "md") {
            return false
        }
        if ((editor.buf.lineCount()) == 0) {
            return false
        }
        if ((trim (editor.buf.lineAt(0))) != "---") {
            return false
        }
        def i:int 1
        while (i < (editor.buf.lineCount())) {
            if ((trim (editor.buf.lineAt(i))) == "---") {
                return ((line > 0) && (line < i))
            }
            i = (i + 1)
        }
        return false
    }

    ; Is the line the front matter's opening or closing `---`?
    fn frontMatterFence:boolean (line:int) {
        if ((edTab != "md") || ((editor.buf.lineCount()) == 0)) {
            return false
        }
        if ((trim (editor.buf.lineAt(0))) != "---") {
            return false
        }
        def i:int 1
        while (i < (editor.buf.lineCount())) {
            def ln:string (trim (editor.buf.lineAt(i)))
            if ((ln == "---") || (ln == "...")) {
                return ((line == 0) || (line == i))
            }
            i = (i + 1)
        }
        return false
    }

    ; What the selected slide is made of and the theme rules that draw it,
    ; as JSON for the help panel (PresHelp.rgr).
    fn slideHelp:string () {
        if ((deck.slideCount()) == 0) {
            return "[]"
        }
        def s:PresSlide (deck.slideAt(selected))
        def text:string (mdEditor.text())
        def a:int s.srcStart
        if (a < 0) {
            a = 0
        }
        def b:int (strlen text)
        def i:int (selected + 1)
        while (i < (deck.slideCount())) {
            def n:PresSlide (deck.slideAt(i))
            if (n.srcStart > a) {
                b = n.srcStart
                break
            }
            i = (i + 1)
        }
        if (b < a) {
            b = a
        }
        return (PresHelp.forSlide((substring text a b) s.title (this.themeCss())))
    }

    ; The help panel's "change this": the theme opens at `prop` in the rule
    ; for `sel`, added with `def` when the theme does not have it yet, and
    ; the caret waits on the value so its popover can be opened there.
    fn helpEdit:void (sel:string prop:string def0:string) {
        this.showTab("css")
        def ed:ScriptEditor cssEditor
        def n:int (ed.buf.lineCount())
        def ruleLine:int -1
        def endLine:int -1
        def propLine:int -1
        def propCol:int -1
        def i:int 0
        while (i < n) {
            def t:string (ed.buf.lineAt(i))
            def open:int (indexOf t "{")
            if ((open > 0) && (PresHelp.names((substring t 0 open) sel))) {
                def e:int i
                while ((e < n) && ((indexOf (ed.buf.lineAt(e)) "}") < 0)) {
                    e = (e + 1)
                }
                if (e >= n) {
                    e = (n - 1)
                }
                ruleLine = i
                endLine = e
                def k:int i
                while (k <= e) {
                    def lt:string (ed.buf.lineAt(k))
                    def from:int 0
                    if (k == i) {
                        from = (open + 1)
                    }
                    def at:int (indexOfFrom lt (prop + ":") from)
                    while (at >= 0) {
                        def before:int 32
                        if (at > 0) {
                            before = (charAt lt (at - 1))
                        }
                        if ((before == 32) || ((before == 9) || ((before == 59) || (before == 123)))) {
                            def v:int (at + (strlen prop) + 1)
                            while ((v < (strlen lt)) && ((charAt lt v) == 32)) {
                                v = (v + 1)
                            }
                            propLine = k
                            propCol = v
                        }
                        at = (indexOfFrom lt (prop + ":") (at + 1))
                    }
                    k = (k + 1)
                }
                i = e
            }
            i = (i + 1)
        }
        if (propLine < 0) {
            if (ruleLine < 0) {
                ; a rule of its own at the end
                def last:int (n - 1)
                def lastText:string (ed.buf.lineAt(last))
                def lead:string "\n\n"
                if ((strlen (trim lastText)) == 0) {
                    lead = "\n"
                }
                ed.moveCaret(last (strlen lastText) false)
                ed.insert((lead + sel + " {\n  " + prop + ": " + def0 + ";\n}\n"))
                if ((strlen (trim lastText)) == 0) {
                    propLine = (last + 2)
                } {
                    propLine = (last + 3)
                }
                propCol = ((strlen prop) + 4)
            } {
                def endText:string (ed.buf.lineAt(endLine))
                def close:int (indexOf endText "}")
                if (endLine == ruleLine) {
                    ; `sel { a: b }` on one line
                    def before:string (trim (substring endText 0 close))
                    def sep:string " "
                    if (((strlen before) > 0) && (((charAt before ((strlen before) - 1)) != 59) && ((charAt before ((strlen before) - 1)) != 123))) {
                        sep = "; "
                    }
                    def ins:string (sep + prop + ": " + def0 + "; ")
                    def at2:int close
                    while ((at2 > 0) && ((charAt endText (at2 - 1)) == 32)) {
                        at2 = (at2 - 1)
                    }
                    ed.moveCaret(endLine at2 false)
                    ed.moveCaret(endLine close true)
                    ed.insert(ins)
                    propLine = endLine
                    propCol = ((at2 + (strlen sep)) + ((strlen prop) + 2))
                } {
                    ed.moveCaret(endLine 0 false)
                    ed.insert(("  " + prop + ": " + def0 + ";\n"))
                    propLine = endLine
                    propCol = ((strlen prop) + 4)
                }
            }
        }
        ed.moveCaret(propLine propCol false)
        ed.sel.collapseToCaret()
        ed.layout.ensureCaretVisible(ed.buf ed.sel)
        focus = "editor"
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    ; --- the top bar ----------------------------------------------------------------
    fn useToolbar:void (on:boolean) {
        if on {
            barH = toolbar.barH
            if deckOn {
                ; the presentations' row is under it: what is below the bar
                ; starts below both
                barH = (barH + deckH)
            }
        } {
            barH = 0.0
        }
        chromeRev = (chromeRev + 1)
    }

    ; --- the open presentations' tabs ------------------------------------------------
    ; The row on or off (the editor's page has it; a reader's has no bar).
    fn useDeckTabs:void (on:boolean) {
        deckOn = on
        deckTabs.tid = "decktabs"
        deckTabs.tabs.most = 10
        this.useToolbar((barH > 0.0))
    }

    ; The deck shown now is `k`, called `label`: its tab, in front.
    fn deckTabOpen:void (k:string label:string) {
        deckTabs.tabs.open(k)
        deckTabs.setLabel(k label)
        chromeRev = (chromeRev + 1)
    }

    ; The deck of tab `from` is now `to` (a sample kept on its first change
    ; gets an id of its own), called `label`. Nothing when it has no tab.
    fn deckTabRename:void (from:string to:string label:string) {
        if ((deckTabs.tabs.has(from)) && (from != to)) {
            deckTabs.tabs.rename(from to)
        }
        if (deckTabs.tabs.has(to)) {
            deckTabs.setLabel(to label)
            chromeRev = (chromeRev + 1)
        }
    }

    ; Its tab closed (the deck stays where it is kept): the tab now in front.
    fn deckTabClose:string (k:string) {
        def next:string (deckTabs.tabs.close(k))
        chromeRev = (chromeRev + 1)
        return next
    }

    fn deckTabFront:string () {
        return deckTabs.tabs.active
    }

    ; The row as the page keeps it over a reload: the tab in front on the
    ; first line, then "<key>\t<label>" for each tab in order.
    fn deckTabsState:string () {
        def out:string deckTabs.tabs.active
        def i:int 0
        while (i < (deckTabs.tabs.count())) {
            def k:string (deckTabs.tabs.at(i))
            out = (out + (strfromcode 10) + k + (strfromcode 9) + (deckTabs.labelOf(k)))
            i = (i + 1)
        }
        return out
    }

    ; The row kept by deckTabsState, before the deck it shows is opened.
    fn deckTabsRestore:void (state:string) {
        def lines:[string] (strsplit state (strfromcode 10))
        def i:int 1
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                deckTabs.tabs.open((itemAt parts 0))
                deckTabs.setLabel((itemAt parts 0) (itemAt parts 1))
            }
            i = (i + 1)
        }
        if ((array_length lines) > 0) {
            def front:string (itemAt lines 0)
            if (deckTabs.tabs.has(front)) {
                deckTabs.tabs.open(front)
            }
        }
        chromeRev = (chromeRev + 1)
    }

    ; Fresh elements for each layout, sized to the row: tabs that do not fit
    ; wait beside it, and long names are cut to what a tab has room for.
    fn makeDeckTabs:void () {
        deckTabs.name = (PresI18n.t("Open presentations"))
        deckTabs.addWord = (PresI18n.t("New presentation"))
        deckTabs.closeWord = (PresI18n.t("Close "))
        deckTabs.room = deckRect.w
        def n:int (deckTabs.tabs.count())
        def chars:int 26
        if (n > 0) {
            def each:double (((deckRect.w - 56.0) / (to_double n)) - 58.0)
            def fit:int (to_int (each / 7.0))
            if (fit < chars) {
                chars = fit
            }
        }
        if (chars < 6) {
            chars = 6
        }
        deckTabs.maxChars = chars
        deckTabs.build()
    }

    fn deckSwitch:void (k:string) {
        if (((strlen k) > 0) && (k != deckTabs.tabs.active)) {
            push requests ("deck:switch:" + k)
        }
    }

    fn deckPress:void (x:double y:double) {
        def hit:string (deckTabs.pressAt(x y))
        deckPressed = ""
        deckDown = false
        if ((indexOf hit "close:") == 0) {
            def k:string (substring hit 6 (strlen hit))
            def front:boolean (k == deckTabs.tabs.active)
            def next:string (this.deckTabClose(k))
            if front {
                push requests ("deck:switch:" + next)
            }
            push requests "deck:tabs"
            return
        }
        if (hit == "add") {
            push requests "files:new"
            return
        }
        deckDown = true
        deckX0 = x
        deckY0 = y
        deckXN = x
        deckYN = y
        deckT0 = deck.uiNow
        if ((indexOf hit "tab:") == 0) {
            deckPressed = (substring hit 4 (strlen hit))
        }
    }

    ; With a mouse a pressed tab is dragged to another place; a finger
    ; swipes the row instead, to the deck beside the one in front.
    fn deckMove:void (x:double y:double) {
        deckXN = x
        deckYN = y
        ; over the Rooms panel the tab is a presentation going to a room:
        ; the row keeps its order
        def far:double (((x - deckX0) * (x - deckX0)) + ((y - deckY0) * (y - deckY0)))
        if (((touch == false) && toolbar.roomsOpen) && (((strlen deckPressed) > 0) && (far >= 36.0))) {
            if (x < (toolbar.railW + toolbar.roomsW)) {
                toolbar.tabDragTo(deckPressed (deckTabs.labelOf(deckPressed)) x y)
                chromeRev = (chromeRev + 1)
                return
            }
            toolbar.tabDragTo("" "" x y)
        }
        if ((touch == false) && (deckTabs.dragTabTo(x))) {
            push requests "deck:tabs"
        }
        if deckTabs.dragged {
            chromeRev = (chromeRev + 1)
        }
    }

    fn deckRelease:void () {
        deckDown = false
        def room:string (toolbar.tabDragEnd())
        if ((strlen room) > 0) {
            deckTabs.releaseTab()
            push requests ("room:tabdrop:" + room + ":" + deckPressed)
            chromeRev = (chromeRev + 1)
            return
        }
        if (deckTabs.releaseTab()) {
            chromeRev = (chromeRev + 1)
            return
        }
        if touch {
            def ms:double ((deck.uiNow - deckT0) * 1000.0)
            def dir:int (DocTabsCtl.swipeDir((deckXN - deckX0) (deckYN - deckY0) ms))
            if (dir != 0) {
                this.deckSwitch((deckTabs.tabs.neighbour(dir)))
                return
            }
        }
        this.deckSwitch(deckPressed)
    }

    ; A sideways wheel or two fingers on a touchpad: a step to the deck beside.
    fn deckWheelBy:void (dx:double) {
        deckWheel = (deckWheel + dx)
        if ((fabs deckWheel) >= 120.0) {
            def dir:int 1
            if (deckWheel < 0.0) {
                dir = -1
            }
            deckWheel = 0.0
            this.deckSwitch((deckTabs.tabs.neighbour(dir)))
        }
    }

    fn setAppName:void (name:string) {
        appName = name
        toolbar.brand = name
        if ((strlen toolbar.css) > 0) {
            toolbar.rebuild()
        }
        chromeRev = (chromeRev + 1)
    }

    ; The page's own buttons on the bar. The same rows again change nothing:
