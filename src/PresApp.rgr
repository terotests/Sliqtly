    fn pickStyle:void () {
        this.closeHint()
        def h:PresHint (PresHint.make("selector" pick.sel "" 0 0))
        h.doc = (PresHints.selectorDoc(pick.sel))
        def j:string (h.json())
        ; a menu of its button: hanging from Style (above it when there is no
        ; room under it), not across the slide from it
        j = ((substring j 0 ((strlen j) - 1)) + ",\"rule\":" + (pick.ruleJson((this.themeCss()))) + ",\"line\":-1,\"tab\":\"css\",\"x\":" + (EVGDisplayList.num(pick.sx2)) + ",\"y\":" + (EVGDisplayList.num(pick.by)) + ",\"h\":" + (EVGDisplayList.num(pick.bh)) + ",\"text\":\"\"}")
        stageHintX = pick.sx2
        stageHintY = pick.by
        stageHintH = pick.bh
        this.openHint(j)
        hintFromStage = true
    }

    ; A spacing band: its property in the theme (added at the value it has
    ; now when the theme leaves it out), with the value's slider next to it.
    fn pickBand:void (i:int) {
        def b:PresSelBand (itemAt pick.bands i)
        this.closeHint()
        this.helpEdit(b.sel b.prop (PresSelect.ptText(b.value)))
        this.openHintAtCaret()
        this.anchorHintAtStage(b.sel false)
    }

    ; The popover moved from the editor's caret to where it was asked for on
    ; the stage; `back`: it was opened from the element's Style list, which
    ; its ‹ opens again.
    fn anchorHintAtStage:void (sel:string back:boolean) {
        if (hint.isOpen == false) {
            return
        }
        ; which rule the value is in: `document › color` is every text of
        ; the deck, headings too, not the element's own
        hint.name = (sel + " › " + hint.name)
        if ((sel == "document") || (sel == "body")) {
            hint.doc = ((PresI18n.t("Changes all text of the presentation, headings included.")) + " " + hint.doc)
        }
        hint.ax = stageHintX
        hint.ay = stageHintY
        hint.ah = stageHintH
        ; a property from the Style list stays where the list was; a band's
        ; card stays off the element
        hint.keepX = pick.ox
        hint.keepW = pick.ow
        if back {
            hint.keepX = -1.0
        }
        hint.canBack = back
        hint.rebuild()
        hintFromStage = true
        chromeRev = (chromeRev + 1)
    }

    ; The page keeps a popover opened from the stage, or one pressed in, open
    ; while the pointer is elsewhere: a press outside closes it.
    fn hintPinned:boolean () {
        return (hint.isOpen && ((hintFromStage || hint.engaged) || (hint.kind == "emoji")))
    }

    ; --- the emoji picker -----------------------------------------------------------
    ; ⌃⌘Space: EVGUI's emoji picker in the value popover's place, under the
    ; caret. What is picked is written there (over a selection on one line)
    ; as an ordinary edit. False when there is no editor to write into.
    fn openEmojiAtCaret:boolean () {
        if ((mode == "present") || (focus != "editor")) {
            return false
        }
        if (this.filesListShowing()) {
            return false
        }
        def line:int editor.sel.caret.line
        def a:int editor.sel.caret.col
        def b:int a
        if (editor.sel.anchor.line == line) {
            def c:int editor.sel.anchor.col
            if (c < a) {
                a = c
            }
            if (c > b) {
                b = c
            }
        }
        def x0:int (editor.caretViewX(tr line a))
        def y0:int (editor.layout.caretPixelY(line))
        def j:string ("{\"kind\":\"emoji\",\"name\":\"emoji\",\"value\":\"\",\"start\":" + (to_string a) + ",\"end\":" + (to_string b) + ",\"line\":" + (to_string line) + ",\"tab\":\"" + edTab + "\",\"x\":" + (to_string x0) + ",\"y\":" + (to_string y0) + ",\"h\":" + (to_string editor.layout.lineHeight) + "}")
        this.closeHint()
        return (this.openHint(j))
    }

