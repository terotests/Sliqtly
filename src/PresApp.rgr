        this.meetSync()
    }

    ; the panel shows as the call says, and its requests go to the page
    fn meetSync:void () {
        meet.label()
        def want:boolean (meet.panelOpen && ((meet.on()) || (meet.joined())))
        if (want != panels.callOpen) {
            panels.setCall(want)
            if want {
                review.closePanel()
            }
        } {
            this.meetRebuild()
        }
        def rq:[string] (meet.takeRequests())
        for rq q:string i {
            push requests q
        }
        chromeRev = (chromeRev + 1)
    }

    fn meetRebuild:void () {
        if panels.callOpen {
            panels.rebuild()
            chromeRev = (chromeRev + 1)
        }
    }

    fn chatHasKeys:boolean () {
        return (((focus == "chat") && panels.chat.open) && (mode != "present"))
    }

    ; The chat's composer has the keys: Enter sends, Escape closes, PageUp and
    ; PageDown scroll, and the rest move and edit in the text field.
    fn chatKey:boolean (name:string shift:boolean ctrl:boolean) {
        def k:string (PresChartEditor.kitKey(name))
        if (name == "escape") {
            k = "Escape"
        }
        if (name == "enter") {
            k = "Enter"
        }
        if (name == "pageUp") {
            k = "PageUp"
        }
        if (name == "pageDown") {
            k = "PageDown"
        }
        if ((strlen k) == 0) {
            return false
        }
        panels.chat.keyDownWith("" k shift ctrl)
        if ((strlen panels.chat.sent) > 0) {
            push requests "chat-send"
        }
        if (panels.chat.open == false) {
            focus = "editor"
            push requests "chat-closed"
        }
        panels.rebuild()
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The Markdown editor's changes, counted: the page compares the text only
    ; when this moved.
    fn mdVersion:int () {
        return mdEditor.buf.version
    }

    ; the caret and the selection's other end, as offsets in source()
    fn mdCaret:int () {
        return (mdEditor.caretOffset())
    }

    fn mdAnchor:int () {
        return (mdEditor.anchorOffset())
    }

    ; Someone else's edit: `removed` units at `offset` replaced by `text`,
    ; the caret, selection and undo history here kept around it. The deck
    ; follows on `syncRemote`, once for all the edits that came together.
    ; The slide shown stays the one shown: a slide added or removed before
    ; it moves its number, not what is on the screen, and a presentation
    ; goes on at the same time into it (PresFollow).
    fn applyRemoteMd:void (offset:int removed:int text:string) {
        follow.begin(deck selected clock)
        follow.edit(offset removed (strlen text))
        mdEditor.applyRemoteAt(offset removed text)
    }

    fn syncRemote:void () {
        if (mdEditor.buf.version == bufSynced) {
            follow.on = false
            return
        }
        bufSynced = mdEditor.buf.version
        this.rebuildDeck()
        def s:int (follow.slide(deck))
        if ((s >= 0) && (s < (deck.slideCount()))) {
            if (fxSlide == selected) {
                fxSlide = s
            }
            selected = s
            this.revealThumb(s)
            if (this.isPlaying()) {
                clock = (follow.clockOn(deck s))
            }
        }
        chromeRev = (chromeRev + 1)
    }

    ; The others' carets in the Markdown: "name<TAB>r<TAB>g<TAB>b<TAB>caret<TAB>anchor"
    ; lines (offsets in source()).
    fn setPeers:void (rows:string) {
        mdEditor.clearPeers()
        def lines:[string] (strsplit rows "\n")
        for lines line:string i {
            def f:[string] (strsplit line (strfromcode 9))
            if ((array_length f) >= 6) {
                mdEditor.addPeer((itemAt f 0) (?? (str2int (itemAt f 1)) 0) (?? (str2int (itemAt f 2)) 0) (?? (str2int (itemAt f 3)) 0) (?? (str2int (itemAt f 4)) 0) (?? (str2int (itemAt f 5)) 0))
            }
        }
        chromeRev = (chromeRev + 1)
    }

    ; The share dialog's link to only the picked slides, set before
    ; openShare ("" for none); `live`: it follows the deck (a cloud share).
    fn setShareView:void (url:string live:boolean) {
        panels.setShareView(url (picks.count()) live)
    }

    ; How many people the owner invited to edit the presentation in the
    ; cloud (-1: not the owner's, or not in the cloud); set before openShare
    fn setShareEditors:void (n:int) {
        panels.setShareEditors(n)
    }

    fn openShare:void (showUrl:string editUrl:string note:string) {
        this.closeHint()
        panels.openShare(showUrl editUrl note)
        chromeRev = (chromeRev + 1)
    }

    ; File → Presentations…: the decks here and in the cloud (web/decklist.js)
    fn openDecks:void (json:string) {
        this.closeHint()
        panels.openDecks(json)
        chromeRev = (chromeRev + 1)
    }

    fn setDecks:void (json:string) {
        panels.setDecks(json)
        chromeRev = (chromeRev + 1)
    }

    fn decksShowing:boolean () {
        return (panels.decksShowing())
    }

    ; Open: a file from the computer or a sample deck ("value<TAB>label" rows)
    fn openOpen:void (rows:string) {
        this.closeHint()
        panels.openOpen(rows)
        chromeRev = (chromeRev + 1)
    }

    ; A data file dropped or added: {"name", "sheets": [{"name", "path",
    ; "csv"}]}. The dialog asks what to make of it; the file is kept only
    ; when something is made (`data-keep:<sheet>` to the page).
    fn openImport:boolean (json:string) {
        this.closeHint()
        def i (new PresImport())
        if ((i.load(json)) == false) {
            return false
        }
        panels.openData(i)
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The address a chart's or table's link is fetched from (a Google Sheet's
    ; CSV export for a sheet link), for the page.
    fn liveUrl:string (u:string) {
        return (MdVegaRender.resolveUrl(u))
    }

    fn dataRequest:void (what:string) {
        def imp:PresImport panels.imp
        def path:string (imp.path())
        push requests ("data-keep:" + (to_string imp.sheet))
        if (what == "file") {
            ; a pasted link, only as text after all
            if imp.live {
                this.showTab("md")
                editor.handleText(path)
                this.syncEditor()
                chromeRev = (chromeRev + 1)
            }
            return
        }
        this.showTab("md")
        if (what == "table") {
            this.insertBlock((((("```table\n" + path) + "\nrows: ") + (to_string (PresImport.pageRows()))) + "\n```\n"))
            return
        }
        if (what == "workbook") {
            def sn:string (itemAt imp.sheetNames imp.sheet)
            this.insertBlock((((((((("```sheet\n" + imp.xlsx) + "\nsheet: ") + sn) + "\ndata: ") + path) + "\nrows: ") + (to_string (PresImport.pageRows()))) + "\n```\n"))
            return
        }
        def m:PresChartModel (imp.chartModel())
        def spec:string (m.toSpec())
        if imp.live {
            def ls:string (imp.liveSpec(path))
            if ((strlen ls) > 0) {
                spec = ls
            }
        }
        if ((strlen spec) == 0) {
            return
        }
        this.insertBlock((("```vega-lite\n" + spec) + "\n```\n"))
        ; the caret is under the fence: the editor opens on it
        this.openChartEditor(((editor.sel.caret.line) - 2))
    }

    ; A fenced block, on its own lines, at the caret.
    fn insertBlock:void (text:string) {
        ; not inside the front matter: at the end of the document instead
        if (((editor.buf.lineCount()) > 0) && ((trim (editor.buf.lineAt(0))) == "---")) {
            def fm:int 1
            def fmEnd:int -1
            while ((fm < (editor.buf.lineCount())) && (fmEnd < 0)) {
                if ((trim (editor.buf.lineAt(fm))) == "---") {
                    fmEnd = fm
                }
                fm = (fm + 1)
            }
            if (editor.sel.caret.line <= fmEnd) {
                def lastLine:int ((editor.buf.lineCount()) - 1)
                editor.moveCaret(lastLine (strlen (editor.buf.lineAt(lastLine))) false)
            }
        }
        def line:string (editor.buf.lineAt(editor.sel.caret.line))
        def pre:string ""
        if ((strlen (trim line)) > 0) {
            editor.handleKey((UIKey.end()) false false)
            pre = "\n\n"
        }
        editor.handleText((pre + text))
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn closeShare:void () {
        panels.closeShare()
        chromeRev = (chromeRev + 1)
    }

    fn openSettings:void (contrast:boolean) {
        panels.openSettings(contrast)
        chromeRev = (chromeRev + 1)
    }

    ; File → Settings → Look: the standard skin's colours as chosen,
    ; "light", "dark" or "system" (what setSkin is given is the outcome).
    fn setLookMode:void (mode:string) {
        if (panels.lookMode == mode) {
            return
        }
        panels.lookMode = mode
        if ((strlen panels.css) > 0) {
            panels.rebuild()
        }
        chromeRev = (chromeRev + 1)
    }

    ; File → Settings → Look: the frame around the work, "" white or
    ; "terracotta" (the logo's colour).
    fn setLookFrame:void (frame:string) {
        if (panels.lookFrame == frame) {
            return
        }
        panels.lookFrame = frame
        toolbar.frame = frame
        if ((strlen toolbar.css) > 0) {
            toolbar.rebuild()
        }
        if ((strlen panels.css) > 0) {
            panels.rebuild()
        }
        chromeRev = (chromeRev + 1)
    }

    ; File → Settings → Look. Every host is built again under the new theme;
    ; the code editors have no stylesheet, so their palette is set here from
    ; the skin's hue (the page puts the same hue in the sheets as
    ; `--retro-hue`, see setChromeCss).
    fn setSkin:void (name:string hue:double) {
        def s:string ""
        if ((name == "retro") || (name == "dark")) {
            s = name
        }
        skin = s
        toolbar.skin = s
        panels.skin = s
        panels.skinHue = hue
        hint.skin = s
        chart.skin = s
        PresApp.skinEditor(editor s hue)
        PresApp.skinEditor(cssEditor s hue)
        PresApp.skinEditor(fileEditor s hue)
        if ((strlen toolbar.css) > 0) {
            toolbar.rebuild()
        }
        if ((strlen panels.css) > 0) {
            panels.rebuild()
        }
        if hint.isOpen {
            hint.rebuild()
        }
        if chart.isOpen {
            chart.rebuild()
        }
        panelsKey = ""
        chromeRev = (chromeRev + 1)
    }

    ; The chrome sheet again (pres.css and the skins after it): the page
    ; sends it once more when the skin's colour changes.
    fn setChromeCss:void (css:string) {
        def fresh (new EVGStyleSheet())
        sheet = fresh
        sheet.parse(css)
        hoverCls = (UiTree.hoverClasses(sheet))
        chromeRev = (chromeRev + 1)
    }

    ; What the chrome sheet (pres.css and the skins after it) could not
    ; read, one message per line; "" when it read everything.
    fn chromeCssErrors:string () {
        def out:string ""
        def i:int 0
        while (i < (array_length sheet.errors)) {
            out = ((out + (itemAt sheet.errors i)) + "\n")
            i = (i + 1)
        }
        return out
    }

    fn shareIsOpen:boolean () {
        return panels.shareOpen
    }

    ; "show" / "edit" copied (or not); "" puts the buttons back.
    fn shareCopied:void (which:string ok:boolean) {
        panels.setCopied(which ok)
        chromeRev = (chromeRev + 1)
    }

    fn toast:void (text:string) {
        panels.toast(text)
        chromeRev = (chromeRev + 1)
    }

    ; =========================================================================
    ; Text too faint on its slide
    ; =========================================================================
    ; The painter judges every run of text against what is under it (WCAG
    ; 4.5:1, 3:1 for large text) and lists the ones that fall short; the page
    ; hands that list here, as JSON: [{text, ratio, need}]. Each is found on
    ; the slide, and a warning goes on the Markdown line it came from and on
    ; every line of the theme that sets its colour, with what to do about it.
    ; Shown as a mark in the editors' gutter and, on a click on the line, in
    ; the popover; nothing is laid over the slide.
    def contrastKey:string ""
    def cssContrastCount:int 0

    fn setContrast:boolean (json:string) {
        def key:string (json + "|" + (to_string mdEditor.buf.version) + "|" + (to_string cssEditor.buf.version) + "|" + (to_string selected))
        if (key == contrastKey) {
            return false
        }
        contrastKey = key
        def mdOut:[EditorDiagnostic]
        def cssOut:[EditorDiagnostic]
        def p (new VlJsonParser())
        def j:VlJson (p.parse(json))
        def l:MdLayout (deck.layout())
        def i:int 0
        while (i < (j.count())) {
            def r:VlJson (j.at(i))
            def text:string (r.stringOr("text" ""))
            def ratio:double (r.doubleOr("ratio" 0.0))
            def need:double (r.doubleOr("need" 4.5))
            def fixed:string (r.stringOr("fixed" ""))
            def shown:string ""
            if (fixed == "colour") {
                shown = (" " + (PresI18n.t("On the slide it is shown in a corrected colour.")))
            }
            if (fixed == "outline") {
                shown = (" " + (PresI18n.t("On the slide it has an outline.")))
            }
            def b:int 0
            def found:int -1
            while (b < (array_length l.boxes)) {
                def box:MdBox (itemAt l.boxes b)
                if ((box.page == selected) && (box.text == text)) {
                    found = b
                    break
                }
                b = (b + 1)
            }
            if (found >= 0) {
                def box:MdBox (itemAt l.boxes found)
                def head:string (PresI18n.t("Low contrast: ") + (PresApp.ratioWords(ratio)) + ":1, " + (PresI18n.t("needs ")) + (PresApp.ratioWords(need)) + ":1.")
                def light:boolean (PresExport.isLight(box.color))
                def mdFix:string (PresI18n.t("Use a lighter text colour in the theme (CSS), or a lighter background."))
                def cssFix:string (PresI18n.t("Use a lighter colour here, or a lighter background."))
                if light {
                    mdFix = (PresI18n.t("Use a darker text colour in the theme (CSS), or darken the background (a darker picture, or a scrim over it)."))
                    cssFix = (PresI18n.t("Use a darker colour here, or darken the background (a darker picture, or a scrim over it)."))
                }
                def line:int (this.mdLineOf((PresDeck.boxSrc(box))))
                if (line >= 0) {
                    PresApp.warnOnce(mdOut line (((head + shown) + " ") + mdFix))
                }
                def words:string text
                if ((strlen words) > 40) {
                    words = ((substring words 0 39) + "…")
                }
                def cl:int 0
                while (cl < (cssEditor.buf.lineCount())) {
                    if (PresApp.setsColour((cssEditor.buf.lineAt(cl)) box.color)) {
                        PresApp.warnOnce(cssOut cl (PresI18n.t("Low contrast: ") + "“" + words + "” " + (PresApp.ratioWords(ratio)) + ":1, " + (PresI18n.t("needs ")) + (PresApp.ratioWords(need)) + ":1." + shown + " " + cssFix))
                    }
                    cl = (cl + 1)
                }
            }
            i = (i + 1)
        }
        this.fxDiagnostics(mdOut cssOut)
        mdEditor.setHostDiagnostics(mdOut)
        cssEditor.setHostDiagnostics(cssOut)
        if ((array_length cssOut) != cssContrastCount) {
            cssContrastCount = (array_length cssOut)
            this.makeTabs()
        }
        chromeRev = (chromeRev + 1)
        return true
    }

    ; What is wrong in the deck's own effects (```fx in the Markdown,
    ; `@effect` in the theme), on the line it is on: FxLang counts lines
    ; from 1, the editors from 0.
    fn fxDiagnostics:void (mdOut:[EditorDiagnostic] cssOut:[EditorDiagnostic]) {
        def fx:FxLang deck.fx
        def i:int 0
        while (i < (array_length fx.errors)) {
            def line:int ((itemAt fx.errorLines i) - 1)
            def msg:string ((PresI18n.t("Effect: ")) + (itemAt fx.errors i))
            if (i >= fx.themeFrom) {
                push cssOut (EditorDiagnostic.span(line 0 -1 (DiagnosticSeverity.error()) msg "fx"))
            } {
                push mdOut (EditorDiagnostic.span(line 0 -1 (DiagnosticSeverity.error()) msg "fx"))
            }
            i = (i + 1)
        }
    }

    ; One warning per line: a second run from the same line says nothing new.
    sfn warnOnce:void (out:[EditorDiagnostic] line:int message:string) {
        def i:int 0
        while (i < (array_length out)) {
            def d:EditorDiagnostic (itemAt out i)
            if (d.line == line) {
                return
            }
            i = (i + 1)
        }
        ; a negative end column: the whole line, marked in the gutter only
        push out (EditorDiagnostic.span(line 0 -1 (DiagnosticSeverity.warning()) message "contrast"))
    }

    ; The popover for the warning mark under the pointer, or "": only over
    ; the gutter's triangle, so typing on the line does not bring it up.
    fn contrastHintAt:string (x:double y:double) {
        if ((((mode == "present") || (edTab == "files")) || ((edRect.has(x y)) == false)) || chart.isOpen) {
            return ""
        }
        def px:int (to_int x)
        def py:int (to_int y)
        if ((px < editor.layout.x) || (px >= (editor.layout.x + 24))) {
            return ""
        }
        def hit:EditorPos (editor.layout.hitTest(tr editor.buf px py))
        def line:int hit.line
        def note:string (this.contrastNote(line))
        if ((strlen note) == 0) {
            return ""
        }
        def lead:string (PresI18n.t("Low contrast: "))
        def title:string (PresI18n.t("Low contrast"))
        if ((indexOf note lead) == 0) {
            note = (substring note (strlen lead) (strlen note))
        }
        def fxLead:string (PresI18n.t("Effect: "))
        if ((indexOf note fxLead) == 0) {
            note = (substring note (strlen fxLead) (strlen note))
            title = (PresI18n.t("Effect"))
        }
        def y0:int (editor.layout.caretPixelY(line))
        def gx:int (editor.layout.x + 4)
        return ("{\"kind\":\"warn\",\"name\":" + (PresHint.q(title)) + ",\"warn\":" + (PresHint.q(note)) + ",\"start\":0,\"end\":0,\"line\":" + (to_string line) + ",\"tab\":\"" + edTab + "\",\"x\":" + (to_string gx) + ",\"y\":" + (to_string y0) + ",\"w\":12,\"h\":" + (to_string editor.layout.lineHeight) + ",\"text\":\"\"}")
    }

    ; The warning on a line of the editor showing, or "".
    fn contrastNote:string (line:int) {
        def ds:[EditorDiagnostic] editor.hostDiagnostics
        def i:int 0
        while (i < (array_length ds)) {
            def d:EditorDiagnostic (itemAt ds i)
            if (d.line == line) {
                return d.message
            }
            i = (i + 1)
        }
        return ""
    }

    ; The Markdown line a source offset is on.
    fn mdLineOf:int (offset:int) {
        if (offset < 0) {
            return -1
        }
        def off:int 0
        def i:int 0
        def n:int (mdEditor.buf.lineCount())
        while (i < n) {
            def next:int ((off + (strlen (mdEditor.buf.lineAt(i)))) + 1)
            if (offset < next) {
                return i
            }
            off = next
            i = (i + 1)
        }
        return -1
    }

    ; Does this line of CSS set a text colour (`color:`, not `background-color`)
    ; to the given one?
    sfn setsColour:boolean (text:string hex:string) {
        def want:EVGColor (EVGColor.parse(hex))
        def n:int (strlen text)
        def at:int (indexOf text "color")
        while (at >= 0) {
            def before:int 32
            if (at > 0) {
                before = (charAt text (at - 1))
            }
            def k:int (at + 5)
            while ((k < n) && ((charAt text k) == 32)) {
                k = (k + 1)
            }
            if ((((before == 32) || (before == 9)) || ((before == 59) || (before == 123))) && ((k < n) && ((charAt text k) == 58))) {
                def e:int (k + 1)
                while ((e < n) && (((charAt text e) != 59) && ((charAt text e) != 125))) {
                    e = (e + 1)
                }
                def got:EVGColor (CssValue.color((trim (substring text (k + 1) e))))
                if got.isSet {
                    if ((((got.red()) == (want.red())) && ((got.green()) == (want.green()))) && ((got.blue()) == (want.blue()))) {
                        return true
                    }
                }
            }
            def rest:int (indexOf (substring text (at + 5) n) "color")
            if (rest < 0) {
                at = -1
            } {
                at = ((at + 5) + rest)
            }
        }
        return false
    }


    sfn ratioWords:string (v:double) {
        def t:int (to_int ((v * 10.0) + 0.5))
        def whole:int (to_int ((to_double t) / 10.0))
        def tenth:int (t - (whole * 10))
        if (tenth == 0) {
            return (to_string whole)
        }
        return ((to_string whole) + "." + (to_string tenth))
    }

    fn takePanels:void () {
        def i:int 0
        while (i < (array_length panels.requests)) {
            def r:string (itemAt panels.requests i)
            if ((indexOf r "help:") == 0) {
                def parts:[string] (strsplit (substring r 5 (strlen r)) (strfromcode 9))
                if ((array_length parts) >= 3) {
                    this.closeHint()
                    this.helpEdit((itemAt parts 0) (itemAt parts 1) (itemAt parts 2))
                    this.openHintAtCaret()
                }
            } {
                if (r == "help-close") {
                    this.setHelp(false)
                } {
                  if ((indexOf r "call-press") == 0) {
                    this.meetAct((substring r 11 (strlen r)))
                  } {
                  if (r == "call-closed") {
                    meet.panelOpen = false
                  } {
                    if ((indexOf r "files:") == 0) {
                        this.filesRequest((substring r 6 (strlen r)))
                    } {
                      if ((indexOf r "data:") == 0) {
                        this.dataRequest((substring r 5 (strlen r)))
                      } {
                        push requests r
                      }
                    }
                  }
                  }
                }
            }
            i = (i + 1)
        }
        def none:[string]
        panels.requests = none
        chromeRev = (chromeRev + 1)
    }

    ; The panels as a display list over the page: "" when none is showing.
    fn panelsJson:string () {
        if ((this.panelsReady()) == false) {
            return ""
        }
        def dl:EVGDisplayList (panels.displayList())
        return ("{\"x\":0,\"y\":0,\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    ; One of the panels' layers ("docked", "dialog", "toast"), for the page to
    ; paint where `layerOrder` puts it.
    fn panelsPartJson:string (part:string) {
        if ((this.panelsReady()) == false) {
            return ""
        }
        def dl:EVGDisplayList (panels.partList(part))
        return ("{\"x\":0,\"y\":0,\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    fn panelsReady:boolean () {
        this.placeFiles()
        ; the chat's field shows its caret while it has the keys
        panels.chat.input.setFocused((this.chatHasKeys()))
        if ((panels.any()) == false) {
            return false
        }
        panels.measurer = measurer
        panels.barH = barH
        def q:boolean (mode == "present")
        if (((panels.w != W) || (panels.h != H)) || (q != panels.quiet)) {
            panels.w = W
            panels.h = H
            panels.quiet = q
            panels.rebuild()
        }
        if (panels.helpOpen && (q == false)) {
            ; the slide's parts, looked at again only when something changed
            def key:string ((to_string chromeRev) + ":" + (to_string editor.buf.version) + ":" + (to_string (this.slideShown())))
            if (key != panelsKey) {
                panelsKey = key
                panels.setHelpData((this.slideHelp()) (this.slideShown()))
            }
        }
        return true
    }

    ; --- accessibility: the canvas as a tree the page mirrors into DOM ------------
    fn setA11yFocus:void (id:string) {
        a11yFocus = id
        ; a slide of the strip focused (a click, Tab, F6): its keys go there
        if (((indexOf id "thumb-") == 0) && (mode != "present")) {
            if (focus != "strip") {
                focus = "strip"
                chromeRev = (chromeRev + 1)
            }
        }
    }

    fn selectedSlide:int () {
        return selected
    }

    fn a11yJson:string () {
        def t (new EVGA11yTree())
        a11yGen = (a11yGen + 1)
        t.generation = a11yGen
        def root:EVGA11yNode (t.group("app" "" appName))
        t.place(root 0 0 (to_int W) (to_int H))
        def n:int (deck.slideCount())
        def shown:int (this.slideShown())
        def title:string ""
        if ((shown >= 0) && (shown < n)) {
            def cur:PresSlide (deck.slideAt(shown))
            title = cur.title
        }
        def where:string ((PresI18n.t("Slide ")) + (to_string (shown + 1)) + " / " + (to_string n) + ": " + title)
        if (mode != "present") {
            if (barH > 0.0) {
                def bar:EVGA11yNode (t.node("bar" "app" (EVGA11yRole.toolbar())))
                bar.name = (PresI18n.t("Toolbar"))
                t.place(bar 0 0 (to_int W) (to_int toolbar.barH))
                PresA11y.addHost(t toolbar.host "bar")
            }
            if ((deckRect.h > 0.0) && (!null? chromeRoot)) {
                this.a11yDeckTabs(t (unwrap chromeRoot))
            }
            if ((edRect.w > 0.0) && (!null? chromeRoot)) {
                def page:EVGElement (unwrap chromeRoot)
                def tl:EVGA11yNode (t.node("edtabs" "app" (EVGA11yRole.tabList())))
                tl.name = (PresI18n.t("Editor"))
                t.place(tl (to_int tabRect.x) (to_int tabRect.y) (to_int tabRect.w) (to_int tabRect.h))
                this.a11yTab(t page "md" "Markdown")
                this.a11yTab(t page "css" (PresI18n.t("Theme (CSS)")))
                this.a11yTab(t page "files" (PresI18n.t("Files")))
            }
            if (!null? chromeRoot) {
                def page2:EVGElement (unwrap chromeRoot)
                def list:EVGA11yNode (t.node("slides" "app" (EVGA11yRole.listBox())))
                list.name = (PresI18n.t("Slides"))
                list.description = (PresI18n.t("Arrows move between slides, Shift and an arrow picks several, Ctrl and an arrow moves the slide, Delete deletes it, Shift+F10 opens its menu."))
                t.place(list (to_int stripRect.x) (to_int stripRect.y) (to_int stripRect.w) (to_int stripRect.h))
                def i:int 0
                while (i < n) {
                    def s:PresSlide (deck.slideAt(i))
                    def el@(optional):EVGElement (PresA11y.find(page2 ("thumb" + (to_string i))))
                    if (!null? el) {
                        def e:EVGElement (unwrap el)
                        def b:EVGA11yNode (t.node(("thumb-" + (to_string i)) "slides" (EVGA11yRole.option())))
                        b.name = ((PresI18n.t("Slide ")) + (to_string (i + 1)) + ": " + s.title)
                        b.focusable = true
                        b.actActivate = true
                        b.selected = ((i == selected) || (picks.has(i)))
                        b.setSize = n
                        b.posInSet = (i + 1)
                        PresA11y.placeAt(b e)
                    }
                    i = (i + 1)
                }
                def adds:[string] ([] _:string ("slide-add" "slide-add-empty" "slide-add-dup"))
                def names:[string] ([] _:string ((PresI18n.t("Add a slide")) (PresI18n.t("Empty slide")) (PresI18n.t("Duplicate slide"))))
                def ai:int 0
                while (ai < (array_length adds)) {
                    def ael@(optional):EVGElement (PresA11y.find(page2 (itemAt adds ai)))
                    if (!null? ael) {
                        def ab:EVGA11yNode (t.button(("thumb-" + (itemAt adds ai)) "app" (itemAt names ai)))
                        PresA11y.placeAt(ab (unwrap ael))
                    }
                    ai = (ai + 1)
                }
            }
        }
        def stage:EVGA11yNode (t.node("stage" "app" (EVGA11yRole.region())))
        stage.name = where
        t.place(stage (to_int slideRect.x) (to_int slideRect.y) (to_int slideRect.w) (to_int slideRect.h))
        def lines:[string] (this.slideWords(shown))
        def k:int 0
        while (k < (array_length lines)) {
            def ln:EVGA11yNode (t.label(("stage-" + (to_string k)) "stage" (itemAt lines k)))
            t.place(ln (to_int slideRect.x) (to_int slideRect.y) (to_int slideRect.w) 1)
            k = (k + 1)
        }
        ; A live sheet says what it is and how to get into it; the page puts
        ; the workbook (with a tree of its own) over the box once it is opened.
        if ((mode == "present") && (deck.hasLiveSheet(shown))) {
            def hintNode:EVGA11yNode (t.label("stage-sheet" "stage" (PresI18n.t("A spreadsheet is on this slide. Press E to explore or edit it."))))
            t.place(hintNode (to_int slideRect.x) (to_int slideRect.y) (to_int slideRect.w) 1)
        }
        if (mode != "present") {
            if room.open {
                PresA11y.addHost(t room.host "app")
            }
            if (panels.any()) {
                PresA11y.addHost(t panels.host "app")
                if (panels.helpOpen && (!null? panels.host.lastPage)) {
                    def pp:EVGElement (unwrap panels.host.lastPage)
                    def h:int 0
                    while (h < (array_length panels.helpKeys)) {
                        def parts:[string] (strsplit (itemAt panels.helpKeys h) (strfromcode 9))
                        PresA11y.buttonAt(t pp ("pn-prop-" + (to_string h)) "app" ((itemAt parts 0) + " { " + (itemAt parts 1) + " }"))
                        h = (h + 1)
                    }
                }
            }
            if hint.isOpen {
                def hn:EVGA11yNode (t.node("hint" "app" (EVGA11yRole.dialog())))
                hn.name = (hint.name + ": " + hint.value)
                hn.description = hint.doc
                t.place(hn 0 0 (to_int W) (to_int H))
                PresA11y.addHost(t hint.host "hint")
                if ((hint.kind == "selector") && (!null? hint.host.lastPage)) {
                    def hp:EVGElement (unwrap hint.host.lastPage)
                    def props:VlJson (hint.rule.get("props"))
                    def q:int 0
                    while (q < (props.count())) {
                        def pj:VlJson (props.at(q))
                        PresA11y.buttonAt(t hp ("hp-prop-" + (to_string q)) "hint" ((pj.stringOr("name" "")) + " " + (pj.stringOr("value" (PresI18n.t("add"))))))
                        q = (q + 1)
                    }
                }
            }
            if chart.isOpen {
                def cn:EVGA11yNode (t.node("chart" "app" (EVGA11yRole.dialog())))
                cn.name = (PresI18n.t("Chart settings"))
                t.place(cn 0 0 (to_int W) (to_int H))
                PresA11y.addHost(t chart.host "chart")
            }
        }
        def st:EVGA11yNode (t.statusRegion("announce" "app" where))
        t.place(st 0 0 1 1)
        if (t.has(a11yFocus)) {
            t.setFocus(a11yFocus)
        }
        return (t.toJson())
    }

    ; The open presentations' row: a tab list, each tab with its close button.
    fn a11yDeckTabs:void (t:EVGA11yTree page:EVGElement) {
        def rows:[UiRow] (deckTabs.rows())
        def i:int 0
        while (i < (array_length rows)) {
            def row:UiRow (itemAt rows i)
            def parent:string "app"
            if (((strlen row.parentTid) > 0) && (t.has(row.parentTid))) {
                parent = row.parentTid
            }
            def n:EVGA11yNode (t.node(row.tid parent row.role))
            n.name = row.name
            n.focusable = row.focusable
            if (row.role != (EVGA11yRole.tabList())) {
                n.actActivate = true
            }
            n.selected = (row.selected == (EVGA11yTri.yes()))
            if (row.tid == deckTabs.tid) {
                t.place(n (to_int deckRect.x) (to_int deckRect.y) (to_int deckRect.w) (to_int deckRect.h))
            } {
                def el@(optional):EVGElement (PresA11y.find(page row.tid))
                if (!null? el) {
                    PresA11y.placeAt(n (unwrap el))
                }
            }
            i = (i + 1)
        }
    }

    fn a11yTab:void (t:EVGA11yTree page:EVGElement v:string name:string) {
        def id:string (tabs.tabTid(v))
        def el@(optional):EVGElement (PresA11y.find(page id))
        if (null? el) {
            return
        }
        def n:EVGA11yNode (t.node(id "edtabs" (EVGA11yRole.tab())))
        n.name = name
        n.focusable = true
        n.actActivate = true
        n.selected = (v == edTab)
        PresA11y.placeAt(n (unwrap el))
    }

    ; The slide's words for a reader: its source without the notes, the
    ; attribute blocks and the insides of fenced blocks.
    fn slideWords:[string] (i:int) {
        def out:[string]
        if ((i < 0) || (i >= (deck.slideCount()))) {
            return out
        }
        def s:PresSlide (deck.slideAt(i))
        def src:string deck.text
        if (((s.srcStart < 0) || (s.srcEnd <= s.srcStart)) || (s.srcEnd > (strlen src))) {
            push out s.title
            return out
        }
        def lines:[string] (strsplit (substring src s.srcStart s.srcEnd) (strfromcode 10))
        def inNotes:boolean false
        def inFence:boolean false
        def k:int 0
        while (k < (array_length lines)) {
            def l:string (trim (itemAt lines k))
            if ((indexOf l "```") == 0) {
                if (inFence == false) {
                    push out (PresI18n.t("[chart or code]"))
                }
                inFence = (inFence == false)
            } {
                if ((indexOf l ":::") == 0) {
                    inNotes = ((indexOf l "notes") > 0)
                } {
                    if (((inNotes == false) && (inFence == false)) && ((strlen l) > 0)) {
                        def w:string l
                        while ((indexOf w "#") == 0) {
                            w = (trim (substring w 1 (strlen w)))
                        }
                        def brace:int (indexOf w "{")
                        if (brace >= 0) {
                            w = (trim (substring w 0 brace))
                        }
                        if ((strlen w) > 0) {
                            push out w
                        }
                    }
                }
            }
            k = (k + 1)
        }
        return out
    }

    ; A slider moved from the keyboard: `delta` steps.
    fn a11ySlide:boolean (id0:string delta:int) {
        ; the focusable node is the slider's thumb
        def id:string id0
        if ((strlen id) > 6) {
            if ((substring id ((strlen id) - 6) (strlen id)) == "-thumb") {
                id = (substring id 0 ((strlen id) - 6))
            }
        }
        if (hint.isOpen && (id == hint.slider.tid)) {
            def v:int (hint.slider.value + delta)
            if (v < hint.slider.minValue) { v = hint.slider.minValue }
            if (v > hint.slider.maxValue) { v = hint.slider.maxValue }
            hint.slider.value = v
            hint.takeSlider()
            hint.rebuild()
            this.afterHint()
            return true
        }
        if chart.isOpen {
            def i:int 0
            while (i < (array_length chart.sliders)) {
                def c:SliderCtl (itemAt chart.sliders i)
                if (c.tid == id) {
                    def v2:int (c.value + (delta * c.step))
                    if (v2 < c.minValue) { v2 = c.minValue }
                    if (v2 > c.maxValue) { v2 = c.maxValue }
                    c.value = v2
                    chart.takeSliders()
                    chart.rebuild()
                    this.writeChart()
                    chromeRev = (chromeRev + 1)
                    return true
                }
                i = (i + 1)
            }
        }
        return false
    }

    ; --- files the charts read --------------------------------------------------
    ; The page fetches what `chartDataWanted` lists (one url per line) and
    ; hands each over; the charts on it are drawn again.
    fn chartDataWanted:string () {
        return (deck.chartDataWanted())
    }

    fn clearChartData:void () {
        deck.clearChartData()
    }

    ; PRO or not (the page: signed in, a cloud share, local development).
    ; The slides' line art is drawn only for PRO (the layouts drawn from
    ; lists are free); the slides are laid out again when it changes.
    fn setPro:void (on:boolean) {
        if (deck.artAllowed == on) {
            return
        }
        deck.artAllowed = on
        deck.rebuild()
        PresTimeline.planAll(deck)
        chromeRev = (chromeRev + 1)
    }

    fn setChartDataMissing:void (url:string) {
        deck.setChartDataMissing(url)
        PresTimeline.planAll(deck)
        chromeRev = (chromeRev + 1)
    }

    fn setChartData:void (url:string body:string) {
        deck.setChartData(url body)
        ; the slides are new objects: timed again, or every one lasts 0 s
        ; and its charts stay at the start of their animation
        PresTimeline.planAll(deck)
        chromeRev = (chromeRev + 1)
    }

    ; --- the chart settings editor ----------------------------------------------
    fn setChartCss:void (css:string) {
        chart.css = css
    }

    sfn isChartFence:boolean (t:string) {
        def s:string (trim t)
        if (((strlen s) < 3) || ((substring s 0 3) != "```")) {
            return false
        }
        def lang:string (trim (substring s 3 (strlen s)))
        return (((indexOf lang "vega-lite") == 0) || ((indexOf lang "vegalite") == 0))
    }

    ; Open the editor on the ```vega-lite fence at or around `line`. False
    ; when there is none there.
    fn openChartEditor:boolean (line:int) {
        if (mode == "present") {
            return false
        }
        this.showTab("md")
        def n:int (mdEditor.buf.lineCount())
        def start:int -1
        def i:int line
        if (i >= n) {
            i = (n - 1)
        }
        while ((i >= 0) && (start < 0)) {
            def t:string (mdEditor.buf.lineAt(i))
            if (PresApp.isChartFence(t)) {
                start = i
            } {
                if ((i < line) && ((indexOf (trim t) "```") == 0)) {
                    ; a fence closes above the line: it is not in a chart
                    i = -1
                }
            }
            i = (i - 1)
        }
        if (start < 0) {
            return false
        }
        def end:int -1
        def k:int (start + 1)
        while ((k < n) && (end < 0)) {
            if ((indexOf (trim (mdEditor.buf.lineAt(k))) "```") == 0) {
                end = k
            }
            k = (k + 1)
        }
        if (end < 0) {
            return false
        }
        chartStart = start
        chartEnd = end
        def body:string ""
        def b:int (start + 1)
        while (b < end) {
            body = (body + (mdEditor.buf.lineAt(b)) + "\n")
            b = (b + 1)
        }
        ; a fence naming a chart file: the file's spec is what is edited, and
        ; what is written back
        chartFile = (MdVegaRender.specFile(body))
        if ((strlen chartFile) > 0) {
            body = (MdVegaRender.fromFile(body deck.dataUrls deck.dataTexts))
        }
        def m:PresChartModel (PresChartModel.fromSpec(body))
        this.place()
        ; where the window was left, or over the Markdown beside the slide
        if (chartWinX < 0.0) {
            chartWinX = (edRect.x + 12.0)
            chartWinY = (edRect.y + 8.0)
        }
        if (chartWinX > (W - 120.0)) {
            chartWinX = (W - 120.0)
        }
        if (chartWinY > (H - 60.0)) {
            chartWinY = (H - 60.0)
        }
        chart.measurer = measurer
        chart.open(m chartWinX chartWinY W H)
        ; the slide the chart is on, beside it
        this.selectSlide((deck.pageOfOffset((this.offsetOf(start 0)))))
        mdEditor.sel.setCaret(start 0)
        mdEditor.sel.collapseToCaret()
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; --- a picked picture resized, moved or deleted on the slide ---------------------
    ; PresImageDrag: an edge or a corner held resizes it, the picture held
    ; moves it to the left, the middle or the right of the column; letting go
    ; writes its attribute line as one edit. Delete or Backspace takes it out.
    def imgDrag:PresImageDrag (new PresImageDrag())

    ; The picture on Markdown line `line` and its attribute line, as a model
    ; (an empty path when the line is not a picture).
    fn imageModelAt:PresImageModel (line:int) {
        def n:int (mdEditor.buf.lineCount())
        if ((line < 0) || (line >= n)) {
            return (new PresImageModel())
        }
        def attr:string ""
        def attrLine:int -1
        if ((line + 1) < n) {
            def next:string (mdEditor.buf.lineAt((line + 1)))
            if (PresImageModel.isAttrLine(next)) {
                attr = next
                attrLine = (line + 1)
            }
        }
        def m:PresImageModel (PresImageModel.read((mdEditor.buf.lineAt(line)) attr))
        m.line = line
        m.attrLine = attrLine
        return m
    }

    fn imageGrab:boolean (x:double y:double clicks:int) {
        if (((mode != "edit") || playing) || (review.on)) {
            return false
        }
        if ((pick.on == false) || (pick.sel != "img")) {
            return false
        }
        if ((this.pickValid()) == false) {
            return false
        }
        def z:string (pick.imageZoneAt(x y))
        if ((strlen z) == 0) {
            return false
        }
        ; a double click on the picture opens its settings, as before
        if ((z == "move") && (clicks >= 2)) {
            return false
        }
        def m:PresImageModel (this.imageModelAt(pick.line))
        if ((m.ok()) == false) {
            return false
        }
        def l:MdLayout (deck.layout())
        def place:string m.align
        if ((strlen place) == 0) {
            place = l.style.imgAlign
        }
        this.slidePoint(x y)
        def sc:double (this.slideScale())
        if (sc > 0.0) {
            imgDrag.slop = (4.0 / sc)
        }
        imgDrag.begin(z pick.x pick.y pick.w pick.h l.contentX l.contentW (l.contentBottom - l.contentTop) place spX spY)
        return true
    }

    fn imageDragTo:void (x:double y:double) {
        this.slidePoint(x y)
        imgDrag.moveTo(spX spY)
        if imgDrag.moved {
            pick.ghostOn = true
            pick.gx = imgDrag.x
            pick.gy = imgDrag.y
            pick.gw = imgDrag.w
            pick.gh = imgDrag.h
            pick.ghostLabel = (PresApp.imageDragLabel(imgDrag))
        }
        chromeRev = (chromeRev + 1)
    }

    sfn imageDragLabel:string (d:PresImageDrag) {
        if (d.zone == "move") {
            if (d.outAlign == "left") {
                return (PresI18n.t("Left"))
            }
            if (d.outAlign == "right") {
                return (PresI18n.t("Right"))
            }
            return (PresI18n.t("Center"))
        }
        if ((strlen d.outHeight) > 0) {
            return ((PresI18n.t("height")) + " " + d.outHeight)
        }
        return ((PresI18n.t("width")) + " " + d.outWidth)
    }

    fn imageDrop:void () {
        pick.ghostOn = false
        chromeRev = (chromeRev + 1)
        if (imgDrag.moved == false) {
            ; a click on the picked picture: it stays picked
            imgDrag.cancel()
            return
        }
        def line:int pick.line
        def m:PresImageModel (this.imageModelAt(line))
        def changed:boolean ((m.ok()) && (imgDrag.apply(m)))
        imgDrag.cancel()
        if (changed == false) {
            return
        }
        def last:int m.line
        if (m.attrLine >= 0) {
            last = m.attrLine
        }
        this.replaceLines(m.line last (m.markdown()))
        ; the edit moved the offsets: the same picture picked again
        def at:int (this.offsetOf(line 0))
        def pg:int (deck.pageOfOffset(at))
        if (pg != selected) {
            this.selectSlide(pg)
        }
        pick.pickSource((deck.layout()) selected at (mdEditor.text()) mdEditor.buf.version)
        pick.markSet((this.themeCss()))
    }

    ; The picked picture's lines taken out, and a blank line with them when
    ; there would be two in a row; one edit, undone with Ctrl+Z.
    fn removePickedImage:void () {
        def m:PresImageModel (this.imageModelAt(pick.line))
        if ((m.ok()) == false) {
            return
        }
        def last:int m.line
        if (m.attrLine >= 0) {
            last = m.attrLine
        }
        def n:int (mdEditor.buf.lineCount())
        def blankBefore:boolean ((m.line == 0) || ((strlen (trim (mdEditor.buf.lineAt((m.line - 1))))) == 0))
        if ((blankBefore && ((last + 1) < n)) && ((strlen (trim (mdEditor.buf.lineAt((last + 1))))) == 0)) {
            last = (last + 1)
        }
        pick.clear()
        this.replaceLines(m.line last "")
        chromeRev = (chromeRev + 1)
    }

    ; --- a picture's settings (the same window, in its image mode) ------------------
    ; The picture on Markdown line `line` (`![alt](path)` alone on it).
    fn openImageEditor:boolean (line:int) {
        def n:int (mdEditor.buf.lineCount())
        if ((line < 0) || (line >= n)) {
            return false
        }
        def t:string (mdEditor.buf.lineAt(line))
        def attr:string ""
        def attrLine:int -1
        if ((line + 1) < n) {
            def next:string (mdEditor.buf.lineAt((line + 1)))
            if (PresImageModel.isAttrLine(next)) {
                attr = next
                attrLine = (line + 1)
            }
        }
        def m:PresImageModel (PresImageModel.read(t attr))
        if ((m.editable()) == false) {
            return false
        }
        m.line = line
        m.attrLine = attrLine
        this.place()
        if (chartWinX < 0.0) {
            chartWinX = (edRect.x + 12.0)
            chartWinY = (edRect.y + 8.0)
        }
        if (chartWinX > (W - 120.0)) {
            chartWinX = (W - 120.0)
        }
        if (chartWinY > (H - 60.0)) {
            chartWinY = (H - 60.0)
        }
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
        chart.openImage(m chartWinX chartWinY W H)
        this.selectSlide((deck.pageOfOffset((this.offsetOf(line 0)))))
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; --- a picture pasted or dropped -------------------------------------------------
    ; The page has registered it for drawing at `path` (not kept yet): the
    ; window asks which part of it to keep and where it goes. `note` says
    ; where it will be kept. Add is "picture-place" to the page, which reads
    ; `pastePlan`, cuts and keeps the picture and calls `placePicture`;
    ; anything else is "picture-cancel".
    ; The picture in the paste window is flat (the page measured it): Add
    ; vectorizes it.
    fn pasteFlat:void (flat:boolean) {
        if (chart.isOpen && (chart.mode == "paste")) {
            chart.pasteVector = flat
            chart.rebuild()
            chromeRev = (chromeRev + 1)
        }
    }

    fn openPaste:boolean (path:string iw:int ih:int alt:string note:string) {
        if (mode == "present") {
            return false
        }
        this.closeHint()
        if chart.isOpen {
            this.closeChart()
        }
        this.place()
        def px:double ((W - 560.0) * 0.5)
        if (px < 8.0) {
            px = 8.0
        }
        def py:double (barH + 24.0)
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
        def aspect:double 0.0
        if (deck.pageH > 0.0) {
            aspect = (deck.pageW / deck.pageH)
        }
        chart.openPaste(path (to_double iw) (to_double ih) alt note aspect px py W H)
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; --- a picture of the files, edited ---------------------------------------------
    ; The files tab's image editor: the page has registered a preview of
    ; `file` at `path` (`iw` × `ih` are the file's pixels). The window crops
    ; and adjusts it; each change is "image-adjust" to the page, which reads
    ; `adjustPlan` and draws the preview again. Save is "image-save" (the
    ; page writes the file over and the slides follow), anything else
    ; "image-cancel".
    fn openAdjust:boolean (path:string file:string iw:int ih:int) {
        if (mode == "present") {
            return false
        }
        this.closeHint()
        if chart.isOpen {
            this.closeChart()
        }
        this.place()
        def px:double ((W - 560.0) * 0.5)
        if (px < 8.0) {
            px = 8.0
        }
        def py:double (barH + 24.0)
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
        chart.openAdjust(path file (to_double iw) (to_double ih) px py W H)
        ; the slide that shows the picture, so its change and its contrast
        ; can be seen (a picture only in the theme leaves the slide as it is)
        def at:int (indexOf (this.source()) file)
        if (at >= 0) {
            this.selectSlide((deck.pageOfOffset(at)))
        }
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The slide's runs too faint over what is under them, as the page drew
    ; it with the preview (the stage's lowContrast list: "ratio", "need",
    ; "fixed"), said in the image editor.
    fn setAdjustContrast:void (json:string) {
        if ((chart.isOpen == false) || (chart.mode != "adjust")) {
            return
        }
        def p (new VlJsonParser())
        def j:VlJson (p.parse(json))
        def n:int (j.count())
        def where:string ((PresI18n.t("Slide ")) + (to_string (selected + 1)) + ": ")
        if (n == 0) {
            chart.setAdjustContrast((where + (PresI18n.t("all text has enough contrast."))) false)
            chromeRev = (chromeRev + 1)
            return
        }
        def worst:double 99.0
        def need:double 4.5
        def fixed:int 0
        def i:int 0
        while (i < n) {
            def r:VlJson (j.at(i))
            if ((strlen (r.stringOr("fixed" ""))) > 0) {
                fixed = (fixed + 1)
            }
            def ratio:double (r.doubleOr("ratio" 99.0))
            if (ratio < worst) {
                worst = ratio
                need = (r.doubleOr("need" 4.5))
            }
            i = (i + 1)
        }
        def note:string (where + (to_string n) + (PresI18n.t(" text runs with low contrast, the lowest ")) + (PresApp.ratioWords(worst)) + ":1 (" + (PresI18n.t("needs ")) + (PresApp.ratioWords(need)) + ":1).")
        if (fixed == n) {
            note = (note + " " + (PresI18n.t("The slide corrects them (File → Settings), but a darker or lighter picture reads better.")))
        }
        chart.setAdjustContrast(note true)
        chromeRev = (chromeRev + 1)
    }

    ; {"file", "crop": "x,y,w,h" in pixels, "whole": nothing cut away,
    ;  "bright", "contrast", "sat", "temp", "tint": -100…100}
    fn adjustPlan:string () {
        def whole:string "false"
        if (chart.crop.isWhole()) {
            whole = "true"
        }
        return ("{\"file\":" + (PresApp.jsonStr(chart.adjFile)) + ",\"crop\":\"" + (chart.crop.cropPixels()) + "\",\"whole\":" + whole + ",\"bright\":" + (to_string chart.adjBright) + ",\"contrast\":" + (to_string chart.adjContrast) + ",\"sat\":" + (to_string chart.adjSat) + ",\"temp\":" + (to_string chart.adjTemp) + ",\"tint\":" + (to_string chart.adjTint) + "}")
    }

    ; --- a picture of the files, vectorized ----------------------------------------
    ; The vectorizer (PresChartEditor's "trace" mode) for `file`: the page has
    ; registered the picture at `orig` (`iw` × `ih` its pixels) and traces it
    ; in its own bundle (pres_trace.js) as "trace-run" asks, with
    ; `traceSettings`, handing the result back through `traceDone`. Save is
    ; "trace-save" (the page keeps the SVG and calls `swapPictureRefs` when
    ; `tracePlan` says so), anything else "trace-cancel".
    fn openTrace:boolean (orig:string file:string iw:int ih:int) {
        if (mode == "present") {
            return false
        }
        this.closeHint()
        if chart.isOpen {
            this.closeChart()
        }
        this.place()
        def px:double ((W - 560.0) * 0.5)
        if (px < 8.0) {
            px = 8.0
        }
        def py:double (barH + 16.0)
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
        def uses:int ((PresTraceRefs.countRefs((this.source()) file)) + (PresTraceRefs.countRefs((this.themeCss()) file)))
        chart.openTrace(orig file (to_double iw) (to_double ih) uses px py W H)
        def at:int (indexOf (this.source()) file)
        if (at >= 0) {
            this.selectSlide((deck.pageOfOffset(at)))
        }
        focus = "chart"
        chromeRev = (chromeRev + 1)
        push requests "trace-run"
        return true
    }

    ; The vectorizer opened to make the SVG `target` again: Save writes over
    ; it, and the settings it was made with (`settings`, "" the defaults)
    ; are where it starts.
    fn traceAgain:void (target:string settings:string) {
        if ((chart.isOpen == false) || (chart.mode != "trace")) {
            return
        }
        chart.trTarget = target
        chart.trReplace = false
        if ((strlen settings) > 0) {
            chart.trSet = (PresTraceSettings.parse(settings))
        }
        chart.rebuild()
        chromeRev = (chromeRev + 1)
    }

    fn traceSettings:string () {
        return (chart.trSet.text())
    }

    fn traceDone:void (preview:string info:string err:string) {
        if ((chart.isOpen == false) || (chart.mode != "trace")) {
            return
        }
        chart.traceDone(preview info err)
        chromeRev = (chromeRev + 1)
    }

    ; {"file", "replace": point the picture's uses at the SVG}
    fn tracePlan:string () {
        def rep:string "false"
        if chart.trReplace {
            rep = "true"
        }
        return ("{\"file\":" + (PresApp.jsonStr(chart.trFile)) + ",\"replace\":" + rep + "}")
    }

    ; Every use of the file `from` in the Markdown and the theme pointed at
    ; `to`, as edits that undo; how many there were.
    fn swapPictureRefs:int (from:string to:string) {
        def was:string edTab
        def n:int 0
        def tabsToDo:[string] ([] _:string ("md" "css"))
        for tabsToDo tab:string ti {
            this.showTab(tab)
            def ln:int 0
            while (ln < (editor.buf.lineCount())) {
                def lt:string (editor.buf.lineAt(ln))
                def c:int (PresTraceRefs.countRefs(lt from))
                if (c > 0) {
                    def cl:int editor.sel.caret.line
                    def cc:int editor.sel.caret.col
                    editor.moveCaret(ln 0 false)
                    editor.moveCaret(ln (strlen lt) true)
                    editor.insert((PresTraceRefs.swapRef(lt from to)))
                    editor.moveCaret(cl cc false)
                    n = (n + c)
                }
                ln = (ln + 1)
            }
            this.syncEditor()
        }
        this.showTab(was)
        chromeRev = (chromeRev + 1)
        return n
    }

    ; --- a new presentation ------------------------------------------------------
    ; File → New presentation: the window asks the name, the theme (`rows`,
    ; the page's "value<TAB>label" lines; `theme` the one in use) and what
    ; data it starts with. Create is "newdeck-create" to the page, which
    ; reads `newDeckPlan`; Cancel and Esc leave the deck that is open as it is.
    fn openNewDeck:boolean (rows:string theme:string name:string) {
        if (mode == "present") {
            return false
        }
        this.closeHint()
        if chart.isOpen {
            this.closeChart()
        }
        this.place()
        def px:double ((W - 560.0) * 0.5)
        if (px < 8.0) {
            px = 8.0
        }
        def py:double (barH + 24.0)
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
        chart.openNewDeck(rows theme name px py W H)
        focus = "chart"
        push requests "theme-pictures"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; Slide → Theme…: the themes as tiles, each a picture of a sample slide
    ; in it. `rows` are the page's theme select ("value<TAB>label<TAB>group"
    ; lines), `current` the one in use; the page draws the pictures
    ; ("theme-pictures", from `themeSampleJson`).
    fn openThemes:boolean (rows:string current:string) {
        if (mode == "present") {
            return false
        }
        this.closeHint()
        if chart.isOpen {
            this.closeChart()
        }
        this.place()
        def px:double ((W - 560.0) * 0.5)
        if (px < 8.0) {
            px = 8.0
        }
        def py:double (barH + 24.0)
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
        chart.openThemes(rows current px py W H)
        focus = "chart"
        push requests "theme-pictures"
        chromeRev = (chromeRev + 1)
        return true
    }

    ; The sample slide of the theme pictures (PresThemeGallery.sample) laid
    ; out under `css`, as the display list a thumbnail is drawn from. A deck
    ; of its own, so the open presentation is not touched.
    def themeDeck:PresDeck (new PresDeck())

    fn themeSampleJson:string (css:string) {
        themeDeck.setStyleSheet(css)
        themeDeck.setText((PresThemeGallery.sample()))
        PresTimeline.planAll(themeDeck)
        if ((themeDeck.slideCount()) == 0) {
            return ""
        }
        def l:EVGDisplayList (PresTimeline.finalFrame(themeDeck 0))
        return ("{\"width\":" + (EVGDisplayList.num(themeDeck.pageW)) + ",\"height\":" + (EVGDisplayList.num(themeDeck.pageH)) + ",\"list\":" + (l.toJson()) + "}")
    }

    ; File → Duplicate: the same window, asking only the copy's name (`name`,
    ; the suggestion, all selected). Duplicate is "newdeck-create" too; the
    ; plan's "dup" says which.
    ; Editing together: the window asks one's name (`name` now). Save is
    ; "newdeck-create" with the plan's "ask" "name".
    fn openAskName:boolean (name:string) {
        if ((this.openDupDeck(name)) == false) {
            return false
        }
        chart.openAskName(name chart.x chart.y W H)
        return true
    }

    ; Share → People who can edit: `list` the addresses invited (one a
    ; line), `owner` the owner's own. Save is "newdeck-create" with the
    ; plan's "ask" "editors" and "editors" the list (PresInvite).
    fn openInvite:boolean (list:string owner:string) {
        if ((this.openDupDeck("")) == false) {
            return false
        }
        chart.openInvite(list owner chart.x chart.y W H)
        return true
    }

    ; A shared room's people (sliqtly.com/editor): `list` the addresses in it
    ; besides `owner`'s, one a line. Save is "newdeck-create" with the plan's
    ; "ask" "editors", "invroom" the room and "editors" the list.
    fn openRoomInvite:boolean (room:string list:string owner:string) {
        if ((this.openDupDeck("")) == false) {
            return false
        }
        chart.openRoomInvite(room list owner chart.x chart.y W H)
        return true
    }

    ; The room's window just opened offers "Invite people…" (its plan's "act"
    ; "invite")
    fn roomDialogInvite:void () {
        chart.rmInvite = true
        chart.rebuild()
    }

    ; Rooms' "+" (`id` "") or a room's gear: the room's window, its name and
    ; description; `state` "new", "made" or "archived". Save is
    ; "newdeck-create" with the plan's "ask" "room", "room", "desc" and "act"
    ; ("" save, "archive", "unarchive", "delete").
    fn openRoomDialog:boolean (id:string state:string name:string desc:string) {
        if ((this.openDupDeck(name)) == false) {
            return false
        }
        chart.openRoom(id state name desc chart.x chart.y W H)
        return true
