        toolbar.rebuild()
    }

    ; One "value<TAB>label<TAB>group" row per line, and the chosen value.
    fn setToolbarOptions:void (id:string rows:string current:string) {
        toolbar.setOptions(id rows current)
        chromeRev = (chromeRev + 1)
    }

    fn takeToolbar:void () {
        def tr:[string] toolbar.requests
        def none0:[string]
        toolbar.requests = none0
        def i:int 0
        while (i < (array_length tr)) {
            this.request((itemAt tr i))
            i = (i + 1)
        }
        def none:[string]
        toolbar.requests = none
        chromeRev = (chromeRev + 1)
    }

    ; A menu or a list of the bar is open: the page draws the bar last, over
    ; the panels, the popover and the chart editor.
    ; --- the layers over the chrome -------------------------------------------------
    ; Each surface's own open flag, read into the z-order: one that opened
    ; since the last look comes to the front of its band.
    fn syncLayers:void () {
        def edit:boolean (mode != "present")
        layers.setOpen("room" (room.open && edit))
        layers.setOpen("bar" ((barH > 0.0) && edit))
        ; Rooms over the page (a narrow window) floats over a room's chat
        ; and the stage's drawing tools like a window
        if (this.toolbarOnTop()) {
            layers.setBand("bar" "menu")
        } {
            if (this.roomsOver()) {
                layers.setBand("bar" "window")
            } {
                layers.setBand("bar" "docked")
            }
        }
        layers.setOpen("panels" ((((panels.helpOpen || panels.filesOpen) || panels.chat.open) || panels.callOpen) && edit))
        layers.setOpen("sketch" (edit && ((deck.slideCount()) > 0)))
        layers.setOpen("review" (review.on && ((deck.slideCount()) > 0)))
        layers.setOpen("hint" (hint.isOpen && edit))
        layers.setOpen("chart" chart.isOpen)
        layers.setOpen("dialog" (panels.shareOpen && edit))
        layers.setOpen("toast" ((strlen panels.toastText) > 0))
    }

    sfn panelLayer:boolean (id:string) {
        return (((id == "panels") || (id == "dialog")) || (id == "toast"))
    }

    ; Whether a layer takes a press at the point. The bar takes it only with
    ; a menu or list open (anywhere: a press outside closes it); otherwise it
    ; is chrome and its press is handled with the chrome. A dialog is modal.
    fn layerHas:boolean (id:string x:double y:double) {
        if (id == "room") {
            this.placeRoom()
            return (room.has(x y))
        }
        if (id == "bar") {
            if (this.roomsOver()) {
                return ((this.toolbarOnTop()) || ((y >= barH) && (x < toolbar.roomsW)))
            }
            return (this.toolbarOnTop())
        }
        if (id == "panels") {
            return (panels.dockedHas(x y))
        }
        if (id == "review") {
            this.reviewReady()
            return (review.has(x y))
        }
        if (id == "sketch") {
            this.sketchPlace()
            return (sketch.has(x y))
        }
        if (id == "hint") {
            return (hint.has(x y))
        }
        if (id == "chart") {
            return (chart.has(x y))
        }
        if (id == "dialog") {
            return true
        }
        if (id == "toast") {
            return (panels.toastHas(x y))
        }
        return false
    }

    ; The top layer at the point: "bar", "panels", "hint", "chart", "dialog",
    ; "toast", or "" for the chrome and the stage under them.
    fn layerAt:string (x:double y:double) {
        this.syncLayers()
        def order:[string] (layers.hitOrder())
        def i:int 0
        while (i < (array_length order)) {
            def id:string (itemAt order i)
            if (this.layerHas(id x y)) {
                return id
            }
            i = (i + 1)
        }
        return ""
    }

    ; The page paints the layers in this order, bottom first: "a,b,c".
    fn layerOrder:string () {
        this.placeFiles()
        this.syncLayers()
        return (layers.paintOrderText())
    }

    fn roomsOver:boolean () {
        if ((barH <= 0.0) || (mode == "present")) {
            return false
        }
        toolbar.w = W
        return (toolbar.roomsOver())
    }

    fn toolbarOnTop:boolean () {
        return (((barH > 0.0) && (mode != "present")) && (toolbar.listOpen()))
    }

    ; The bar as a display list over the page: "" when there is none.
    fn toolbarJson:string () {
        if ((barH <= 0.0) || (mode == "present")) {
            return ""
        }
        toolbar.measurer = measurer
        if ((toolbar.w != W) || (toolbar.h != H)) {
            toolbar.w = W
            toolbar.h = H
            toolbar.rebuild()
        }
        toolbar.setState(playing (this.statusText()))
        ; Rooms and Review's list of comments stay open; the rest act at once
        toolbar.setRailState((? (this.reviewListOpen()) "review" "") (review.on && ((review.model.openCount()) > 0)) (this.docTitle()))
        def dl:EVGDisplayList (toolbar.displayList())
        return ("{\"x\":0,\"y\":0,\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    ; --- the value popover --------------------------------------------------------
    fn setHintCss:void (css:string) {
        hint.css = css
    }

    ; Open the popover on a hint (hintAt / hintAtCaret's JSON); "" closes it.
    fn openHint:boolean (json:string) {
        if ((strlen json) == 0) {
            this.closeHint()
            return false
        }
        if (hint.same(json)) {
            return true
        }
        hint.measurer = measurer
        def ok:boolean (hint.open(json W H))
        chromeRev = (chromeRev + 1)
        return ok
    }

    fn openHintAtCaret:boolean () {
        return (this.openHint((this.hintAtCaret())))
    }

    fn closeHint:void () {
        hintFromStage = false
        if hint.isOpen {
            hint.close()
            chromeRev = (chromeRev + 1)
        }
    }

    ; --- the element picked on the slide (PresSelect.rgr) -------------------------------
    ; Still the same block on the slide shown? An edit of the Markdown moves
    ; the offsets, another slide has other blocks: the pick goes.
    fn pickValid:boolean () {
        if (pick.on == false) {
            return false
        }
        if (((((mode == "present") || playing) || (pick.page != selected)) || (pick.version != mdEditor.buf.version)) || ((deck.slideCount()) == 0)) {
            pick.clear()
            return false
        }
        if ((pick.measure((deck.layout()))) == false) {
            pick.clear()
            return false
        }
        this.pickDiagramBox()
        pick.markSet((this.themeCss()))
        return true
    }

    ; A diagram is drawn larger than its slot in the layout: the pick takes
    ; in the drawing.
    fn pickDiagramBox:void () {
        if ((pick.sel != "diagram") || ((deck.slideCount()) == 0)) {
            return
        }
        def s:PresSlide (deck.slideAt(selected))
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            if ((u.srcStart >= pick.srcA) && (u.srcStart <= pick.srcB)) {
                def l:MdLayout (deck.layout())
                pick.growTo(l.style u.bx u.by u.bw u.bh)
            }
            k = (k + 1)
        }
    }

    ; A click on the slide that nothing else took: the block under it, or
    ; the slide itself.
    fn pickAt:void (x:double y:double) {
        if ((((mode == "present") || playing) || ((deck.slideCount()) == 0)) || ((slideRect.has(x y)) == false)) {
            return
        }
        this.slidePoint(x y)
        def dk:int (deck.diagramAt(selected spX spY))
        if (dk >= 0) {
            def ds:PresSlide (deck.slideAt(selected))
            def u:PresDiaUse (itemAt ds.diagrams dk)
            pick.pickSource((deck.layout()) selected u.srcStart (mdEditor.text()) mdEditor.buf.version)
        } {
            pick.pick((deck.layout()) selected spX spY (mdEditor.text()) mdEditor.buf.version)
        }
        this.pickDiagramBox()
        pick.markSet((this.themeCss()))
        pick.hoverOn = false
        chromeRev = (chromeRev + 1)
    }

    ; A click on the slide in the editor (PresStageClick): a double click
    ; picks, a single one follows a link or lets the pick go.
    fn stageClick:void (x:double y:double) {
        if ((((mode == "present") || playing) || ((deck.slideCount()) == 0)) || ((slideRect.has(x y)) == false)) {
            return
        }
        def link:string (this.linkUnder(x y))
        def a:string (PresStageClick.action(downClicks touch link (this.onPickAt(x y))))
        if (a == "follow") {
            push requests ("link:" + link)
            return
        }
        if (a == "pick") {
            this.pickAt(x y)
            return
        }
        if ((a == "drop") && pick.on) {
            pick.clear()
            chromeRev = (chromeRev + 1)
        }
    }

    ; The link of the text under a point of the stage, "" for none.
    fn linkUnder:string (x:double y:double) {
        if (((deck.slideCount()) == 0) || ((slideRect.has(x y)) == false)) {
            return ""
        }
        this.slidePoint(x y)
        return (PresStageClick.linkAt((deck.layout()) selected spX spY))
    }

    ; The point is on the block picked now (a diagram as drawn).
    fn onPickAt:boolean (x:double y:double) {
        if ((this.pickValid()) == false) {
            return false
        }
        this.slidePoint(x y)
        def src:int -1
        def dk:int (deck.diagramAt(selected spX spY))
        if (dk >= 0) {
            def ds:PresSlide (deck.slideAt(selected))
            def u:PresDiaUse (itemAt ds.diagrams dk)
            src = u.srcStart
        } {
            def l:MdLayout (deck.layout())
            def k:int (PresSelect.boxAt(l selected spX spY))
            if (k < 0) {
                return (pick.sel == "page")
            }
            def b:MdBox (itemAt l.boxes k)
            src = b.srcStart
        }
        return ((src >= pick.srcA) && (src <= pick.srcB))
    }

    ; The page follows a link after the double-click time: one to this
    ; deck's own slide is followed here (true), the rest is the page's.
    fn followLink:boolean (href:string) {
        def k:int (PresStageClick.slideOf(deck href))
        if (k < 0) {
            return false
        }
        if (mode == "present") {
            this.jump((PresNav.start(deck k)))
        } {
            this.selectSlide(k)
        }
        chromeRev = (chromeRev + 1)
        return true
    }

    fn pickHover:void (x:double y:double) {
        if ((((mode == "present") || playing) || ((deck.slideCount()) == 0)) || ((stageArea.has(x y)) == false)) {
            if (pick.hoverOn || ((strlen pick.hot) > 0)) {
                pick.hoverOn = false
                pick.hot = ""
                chromeRev = (chromeRev + 1)
            }
            return
        }
        def part:string (pick.partAt(x y))
        def changed:boolean (part != pick.hot)
        pick.hot = part
        if (((strlen part) == 0) && (slideRect.has(x y))) {
            this.slidePoint(x y)
            def dk:int (deck.diagramAt(selected spX spY))
            if (dk >= 0) {
                ; over a diagram: its drawing (unless it is the pick)
                def ds:PresSlide (deck.slideAt(selected))
                def u:PresDiaUse (itemAt ds.diagrams dk)
                def mine:boolean ((pick.on && (pick.sel == "diagram")) && ((u.srcStart >= pick.srcA) && (u.srcStart <= pick.srcB)))
                if ((mine == false) && ((pick.hoverOn == false) || (pick.hoverSrc != u.srcStart))) {
                    pick.hoverOn = true
                    pick.hoverSrc = u.srcStart
                    pick.hoverPage = selected
                    pick.hx = u.bx
                    pick.hy = u.by
                    pick.hw = u.bw
                    pick.hh = u.bh
                    changed = true
                }
                if (mine && pick.hoverOn) {
                    pick.hoverOn = false
                    changed = true
                }
            } {
                if (pick.hoverAt((deck.layout()) selected spX spY (mdEditor.text()))) {
                    changed = true
                }
            }
        } {
            if pick.hoverOn {
                pick.hoverOn = false
                changed = true
            }
        }
        if changed {
            chromeRev = (chromeRev + 1)
        }
    }

    fn pickPress:void (part:string) {
        ; where it was pressed, as drawn: measuring again makes the bands anew
        def bi0:int (pick.bandOf(part))
        if ((bi0 >= 0) && (bi0 < (array_length pick.bands))) {
            def hb:PresSelBand (itemAt pick.bands bi0)
            ; under (or over) the element, not over it, near the band
            stageHintX = hb.sx
            if ((hb.side == "top") || (hb.side == "bottom")) {
                stageHintX = ((hb.sx + (hb.sw / 2.0)) - 40.0)
            }
            stageHintY = pick.reachTop
            stageHintH = (pick.reachBottom - pick.reachTop)
        }
        if ((this.pickValid()) == false) {
            return
        }
        if (part == "content") {
            this.pickContent()
            return
        }
        if (part == "style") {
            this.pickStyle()
            return
        }
        def bi:int (pick.bandOf(part))
        if ((bi >= 0) && (bi < (array_length pick.bands))) {
            this.pickBand(bi)
        }
    }

    ; "Settings" / "Edit text": a picture's, a chart's, a diagram's or a table's own
    ; editor; otherwise its
    ; Markdown, selected in the editor. For the page, the document settings
    ; (the page lists the pictures for the logo first).
    fn pickContent:void () {
        this.closeHint()
        if (pick.sel == "page") {
            push requests "docset"
            return
        }
        if (pick.sel == "img") {
            if (this.openImageEditor(pick.line)) {
                return
            }
        }
        if (pick.sel == "chart") {
            if (this.openChartEditor(pick.line)) {
                return
            }
        }
        if (pick.sel == "diagram") {
            if (this.openDiagramEditor(pick.line)) {
                return
            }
        }
        ; a Markdown table, or a data file's (```table / ```sheet)
        if (this.openTableEditor(pick.line)) {
            return
        }
        this.showTab("md")
        def text:string (mdEditor.text())
        this.posOf(text pick.srcA)
        def l0:int posLine
        def c0:int posCol
        this.posOf(text pick.srcB)
        mdEditor.moveCaret(l0 c0 false)
        mdEditor.moveCaret(posLine posCol true)
        mdEditor.layout.ensureCaretVisible(mdEditor.buf mdEditor.sel)
        focus = "editor"
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    ; "Style": the theme rules for it, next to it — what is set in blue, what
