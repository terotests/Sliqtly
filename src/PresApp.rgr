    ; The reader's template, which beats what the document names; "" lets
    ; the document decide.
    fn setStyleSheet:void (css:string) {
        themeText = css
        cssEditor.init(css)
        cssSynced = cssEditor.buf.version
        this.applyTheme(css)
    }

    fn applyTheme:void (css:string) {
        deck.setStyleSheet(css)
        this.rebuildDeck()
    }

    ; The value card's pipette was pressed: the page samples a colour and
    ; hands it to `hintPicked` ("" when it was called off).
    fn hintWantsPick:boolean () {
        return (hint.isOpen && hint.wantsPick)
    }

    fn hintPicked:void (hex:string) {
        if (hint.isOpen == false) {
            return
        }
        hint.pickedColor(hex)
        this.afterHint()
    }

    ; One property of the theme set from a card over the Markdown, as one
    ; edit of the CSS tab (Ctrl+Z there undoes it); the slides follow.
    fn setThemeProp:void (sel:string prop:string value:string) {
        def css:string (cssEditor.text())
        def e:PresThemeEdit (PresThemeEdit.change(css sel prop value))
        def a:[int] (PresApp.lineColOf(css e.at))
        def b:[int] (PresApp.lineColOf(css e.end))
        cssEditor.buf.replaceRange((itemAt a 0) (itemAt a 1) (itemAt b 0) (itemAt b 1) e.text true)
        cssEditor.dirty = true
        cssSynced = cssEditor.buf.version
        themeText = (cssEditor.text())
        this.applyTheme(themeText)
        push requests "theme-edited"
        chromeRev = (chromeRev + 1)
    }

    sfn lineColOf:[int] (text:string off:int) {
        def line:int 0
        def start:int 0
        def i:int 0
        while (i < off) {
            if ((charAt text i) == 10) {
                line = (line + 1)
                start = (i + 1)
            }
            i = (i + 1)
        }
        def out:[int]
        push out line
        push out (off - start)
        return out
    }

    ; The theme as it stands in the CSS tab (the host keeps an edited one).
    fn themeCss:string () {
        return (cssEditor.text())
    }

    ; Fresh elements each time: the chrome stylesheet sets a matched class's
    ; properties and never takes them back, so a tab kept from the last
    ; build would keep the active look after it lost the class.
    fn makeTabs:void () {
        tabs = (new TabsCtl())
        tabs.tid = "edtabs"
        tabs.name = (PresI18n.t("Editor"))
        tabs.addItem("md" "Markdown" "" false)
        def cssLabel:string (PresI18n.t("Theme (CSS)"))
        if (cssContrastCount > 0) {
            cssLabel = (cssLabel + " ⚠")
        }
        tabs.addItem("css" cssLabel "" false)
        tabs.addItem("files" (PresI18n.t("Files")) "" false)
        tabs.value = edTab
        tabs.build()
    }

    fn editorTab:string () {
        return edTab
    }

    fn showTab:void (v:string) {
        if (((v != "md") && (v != "css")) && (v != "files")) {
            return
        }
        if (v != edTab) {
            this.closeHint()
        }
        edTab = v
        this.makeTabs()
        if (v == "css") {
            editor = cssEditor
        } {
            if (v == "files") {
                editor = fileEditor
                push requests "files-list"
            } {
                editor = mdEditor
            }
        }
        focus = "editor"
        chromeRev = (chromeRev + 1)
    }

    ; A presentation being opened (the page's beginDoc): its theme, pictures
    ; and data files arrive before its text, and each laid the deck before
    ; it out again (a data file each time), only for setSource to lay out
    ; the one opened. Until setSource the deck is held as it is
    ; (PresDeck.held).
    fn beginOpen:void () {
        deck.held = true
    }

    fn setSource:void (text:string) {
        deck.held = false
        ; Document settings are the deck's before: closed, not written into this one
        if chart.isOpen {
            this.closeChart()
        }
        this.showTab("md")
        ; the slides of the deck before say nothing about this one's
        sourceNew = true
        this.dropPicks()
        mdEditor.init(text)
        bufSynced = mdEditor.buf.version
        selected = 0
        localT = -1.0
        playing = false
        clock = 0.0
        this.rebuildDeck()
    }

    fn source:string () {
        return (mdEditor.text())
    }

    fn setPageSize:void (w:double h:double) {
        W = w
        H = h
        chromeRev = (chromeRev + 1)
    }

    fn rebuildDeck:void () {
        this.rebuildWith((? (mode == "edit") 2 -1) true)
        this.docSetFollow()
    }

    ; One rebuild that draws again at most `budget` charts and figures whose
    ; defaults changed (-1: all), the shown slide's and its neighbours'
    ; whatever the count. `lazy`: only those and the ones on the visible
    ; thumbnails are drawn at all; a deck of 200 slides opens at the cost of
    ; the slides on screen (`settle` draws the others as they come into
    ; view, `settleAll` before a file is written).
    fn rebuildWith:void (budget:int lazy:boolean) {
        if deck.held {
            return
        }
        deck.redrawBudget = budget
        deck.lazy = lazy
        this.aimDeck()
        deck.setText((mdEditor.text()))
        PresTimeline.planAll(deck)
        ; the Slide menu's Orientation ticks what the deck is
        def tall:boolean (deck.pageH > deck.pageW)
        if (toolbar.portrait != tall) {
            toolbar.portrait = tall
            if ((strlen toolbar.css) > 0) {
                toolbar.rebuild()
            }
        }
        if ((picks.active()) && ((picks.count()) > 0)) {
            def had:int (picks.count())
            picks.limit((deck.slideCount()))
            if ((picks.count()) != had) {
                this.pickChanged()
            }
        }
        if (selected >= (deck.slideCount())) {
            selected = ((deck.slideCount()) - 1)
        }
        if (selected < 0) {
            selected = 0
        }
        chromeRev = (chromeRev + 1)
    }

    ; The buffer moved; the deck follows, and the selection follows the caret.
    fn syncEditor:void () {
        if (edTab == "files") {
            ; an open file is kept as it is typed: the page saves it and
            ; hands it to the charts again
            if ((strlen filePath) > 0) {
                if (fileEditor.buf.version != fileSynced) {
                    fileSynced = fileEditor.buf.version
                    push requests ("file-save:" + filePath)
                }
            }
            chromeRev = (chromeRev + 1)
            return
        }
        if (edTab == "css") {
            ; the theme, live: the slides follow each keystroke
            if (cssEditor.buf.version != cssSynced) {
                cssSynced = cssEditor.buf.version
                themeText = (cssEditor.text())
                this.applyTheme(themeText)
                push requests "theme-edited"
            }
            chromeRev = (chromeRev + 1)
            return
        }
        if (mdEditor.buf.version == bufSynced) {
            this.followCaret()
            return
        }
        bufSynced = mdEditor.buf.version
        this.rebuildDeck()
        this.followCaret()
    }

    fn followCaret:void () {
        if ((playing || (mode == "present")) || (edTab != "md")) {
            return
        }
        def off:int (this.offsetOf(mdEditor.sel.caret.line mdEditor.sel.caret.col))
        def s:int (deck.pageOfOffset(off))
        if (s != selected) {
            selected = s
            localT = -1.0
            this.revealThumb(s)
        }
        chromeRev = (chromeRev + 1)
    }

    fn offsetOf:int (line:int col:int) {
        def off:int 0
        def i:int 0
        def n:int (mdEditor.buf.lineCount())
        while (i < line) {
            if (i >= n) {
                break
            }
            off = ((off + (strlen (mdEditor.buf.lineAt(i)))) + 1)
            i = (i + 1)
        }
        return (off + col)
    }

    fn posOf:void (text:string offset:int) {
        def n:int (strlen text)
        def stop:int offset
        if (stop > n) {
            stop = n
        }
        def line:int 0
        def col:int 0
        def i:int 0
        while (i < stop) {
            if ((charAt text i) == 10) {
                line = (line + 1)
                col = 0
            } {
                col = (col + 1)
            }
            i = (i + 1)
        }
        posLine = line
        posCol = col
    }

    ; Select a slide: the stage shows it, and the editor's caret goes to it.
    fn selectSlide:void (i:int) {
        if ((i < 0) || (i >= (deck.slideCount()))) {
            return
        }
        if (i != selected) {
            this.viewReset()
            activeDia = -1
        }
        selected = i
        localT = -1.0
        def s:PresSlide (deck.slideAt(i))
        if (s.srcStart >= 0) {
            ; The line the slide's first box came from — its heading, as a rule.
            this.posOf((mdEditor.text()) s.srcStart)
            mdEditor.sel.setCaret(posLine 0)
            mdEditor.sel.collapseToCaret()
            this.headingInView(posLine)
        }
        this.revealThumb(i)
        chromeRev = (chromeRev + 1)
    }

    ; Slide i's Markdown lines, into `linesFrom` (its first line, -1 when it
    ; has none) and `linesAt` (the next slide's first line, or the line
    ; count after the last). A slide the overflow went on to counts from its
    ; heading's slide, so a slide is always its whole section.
    fn slideLines:void (i:int) {
        def starts:[int]
        def titles:[string]
        def n:int (deck.slideCount())
        def k:int 0
        while (k < n) {
            def sk:PresSlide (deck.slideAt(k))
            push starts sk.srcStart
            push titles sk.title
            k = (k + 1)
        }
        def lay:MdLayout (deck.layout())
        def span:[int] (PresSlideSpans.linesIn((mdEditor.text()) starts titles i lay.splitLevel))
        linesFrom = (itemAt span 0)
        linesAt = (itemAt span 1)
        if (linesFrom < 0) {
            linesAt = (mdEditor.buf.lineCount())
        }
    }

    ; A new slide after the selected one: a copy of it (`dup`), or an empty
    ; one with a heading at the selected slide's level, its words selected
    ; to be typed over. The new slide is selected.
    fn addSlide:void (dup:boolean) {
        this.dropPicks()
        addOpen = false
        if (edTab != "md") {
            this.showTab("md")
        }
        def text:string (mdEditor.text())
        def lc:int (mdEditor.buf.lineCount())
        def n:int (deck.slideCount())
        ; the selected slide's lines: from its first line up to the next
        ; slide's (the end, after the last)
        this.slideLines(selected)
        def from:int linesFrom
        def at:int linesAt
        def level:string "#"
        if (from >= 0) {
            def hl:string (mdEditor.buf.lineAt(from))
            def h:int 0
            while ((h < (strlen hl)) && ((charAt hl h) == 35)) {
                h = (h + 1)
            }
            if (h > 0) {
                level = (substring hl 0 h)
            }
        }
        def title:string (PresI18n.t("New slide"))
        def body:string ((level + " ") + title)
        if (dup && (from >= 0)) {
            ; its lines, the blank ones at its end left out
            def last:int (at - 1)
            while ((last > from) && ((strlen (trim (mdEditor.buf.lineAt(last)))) == 0)) {
                last = (last - 1)
            }
            body = ""
            def li:int from
            while (li <= last) {
                if (li > from) {
                    body = (body + "\n")
                }
                body = (body + (mdEditor.buf.lineAt(li)))
                li = (li + 1)
            }
        }
        def keep:ScriptEditor editor
        editor = mdEditor
        def line:int at
        if (at < lc) {
            ; before the next slide, a blank line between
            mdEditor.moveCaret(at 0 false)
            mdEditor.insert((body + "\n\n"))
        } {
            ; at the end, after a blank line
