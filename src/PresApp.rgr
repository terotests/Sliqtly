        }
        if ((strlen code) == 0) {
            return false
        }
        def colon:int (indexOf code ":")
        def kn@(optional):int (str2int (substring code 0 colon))
        def k:int (?? kn 0)
        def what:string (substring code (colon + 1) (strlen code))
        def hitU@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hitU) {
            return false
        }
        def du:PresDiaUse (unwrap hitU)
        ; over the whole slide, the big one's buttons and boxes
        def dd:PresDiagram (du.active(deck.uiNow))
        if (what == "back") {
