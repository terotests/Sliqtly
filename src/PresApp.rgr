class PresRect {
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0

    fn has:boolean (px:double py:double) {
        if (px < x) { return false }
        if (py < y) { return false }
        if (px > (x + w)) { return false }
        if (py > (y + h)) { return false }
        return true
    }

    fn set:void (ax:double ay:double aw:double ah:double) {
        x = ax
        y = ay
        w = aw
        h = ah
    }
}

class PresApp {
    def deck:PresDeck (new PresDeck())
    ; `setSource` was given a new text: the next rebuild's slides are not
    ; the last one's (aimDeck)
    def sourceNew:boolean false
    def editor:ScriptEditor (new ScriptEditor())
    def tr:UITextRenderer (new UITextRenderer())
    def lang:R5MdLanguage (new R5MdLanguage())
    ; Two texts behind one editor pane, chosen by the tabs above it: the
    ; deck's Markdown and the theme's CSS. `editor` is whichever is showing,
    ; so keys, pointer and paint need no second path; building the deck
    ; always reads `mdEditor`.
    def mdEditor:ScriptEditor (new ScriptEditor())
    def cssEditor:ScriptEditor (new ScriptEditor())
    ; a picture the slides name came after they were laid out (addImage)
    def picturesArrived:boolean false
    ; the files tab: a file of the document's opened from it (data, a chart
    ; spec) in an editor of its own; "" while the list shows
    def fileEditor:ScriptEditor (new ScriptEditor())
    def filePath:string ""
    def fileSynced:int 0
    ; the chart editor's chart, when it lives in a file of the document
    def chartFile:string ""
    def chartFileText:string ""
    def cssLang:PresCssLanguage (new PresCssLanguage())
    ; the files tab's editor colours a file by its name (PresFileLanguage)
    def fileLangs:PresFileLanguage (new PresFileLanguage())
    def edTab:string "md"
    def cssSynced:int -1
    def themeText:string ""
    def tabs:TabsCtl (new TabsCtl())
    ; the strip as the chrome last laid it out: presses are found in it
    ; (`tabs` is made again by showTab before the next layout places it)
    def laidTabs:TabsCtl (new TabsCtl())
    def tabRect:PresRect (new PresRect())
    def tabH:double 34.0
    ; The presentations open in this tab of the browser, a tab each, in a row
    ; of their own under the top bar (EVGUI's DocTabsCtl). The page says
    ; which are open (deckTabOpen…) and opens the one a press, a swipe or a
    ; close asks for ("deck:switch:<key>").
    def deckTabs:DocTabsCtl (new DocTabsCtl())
    def deckRect:PresRect (new PresRect())
    def deckH:double 40.0
    def deckOn:boolean false
    ; a press in the row: the tab pressed, where and when it began, where
    ; the pointer is now
    def deckDown:boolean false
    def deckPressed:string ""
    def deckX0:double 0.0
    def deckY0:double 0.0
    def deckT0:double 0.0
    def deckXN:double 0.0
    def deckYN:double 0.0
    ; a sideways wheel over the row, summed until it is a step
    def deckWheel:double 0.0
    def sheet:EVGStyleSheet (new EVGStyleSheet())
    def measurer@(optional):TTFTextMeasurer
    def chromeRoot@(optional):EVGElement
    ; the chrome element under the pointer (UiTree.markHover), and the classes
    ; the chrome sheet has a `:hover` look for
    def chromeHover:string ""
    def hoverCls:[string]

    def W:double 1200.0
    def H:double 700.0
    ; "edit" | "present"
    def mode:string "edit"
    def speaker:boolean false
    ; past the last step of the last slide while presenting: the page shows
    ; its end panel (restart, previous, exit)
    def ended:boolean false
    ; present: steps come by themselves rather than by a click
    def auto:boolean false
    ; "editor" | "stage" | "strip" (the filmstrip: its keys move between,
    ; reorder and delete slides) | "chart" | ""
    def focus:string "editor"
    def blink:int 0
    def chromeRev:int 0
    def requests:[string]

    ; The editor's share of the width, and the rectangles the layout made.
    def split:double 0.40
    def splitDrag:boolean false
    def edRect:PresRect (new PresRect())
    def sepRect:PresRect (new PresRect())
    def stageArea:PresRect (new PresRect())
    def slideRect:PresRect (new PresRect())
    def trackRect:PresRect (new PresRect())
    def laneX:double 0.0
    def laneW:double 0.0
    def stripRect:PresRect (new PresRect())
    def nextRect:PresRect (new PresRect())
    def thumbW:double 128.0
    def thumbH:double 72.0
    def thumbGap:double 10.0
    def stripScroll:double 0.0
    ; A press on the filmstrip: a drag scrolls it, a press let go where it
    ; was selects the thumbnail it landed on.
    def stripPressed:boolean false
    def stripDragging:boolean false
    def stripIdx:int -1
    def stripDownX:double 0.0
    def stripLastX:double 0.0
    ; A mouse drag that began on a thumbnail moves that slide: a box the
    ; size of the slide follows the pointer (held where it was grabbed,
    ; `stripGrabDx` from its left edge) and the others move out of its way
    ; (PresStripDrag). `stripDrop` is the gap it would land in (0 = before
    ; the first, n = after the last), -1 where it stays.
    def stripReorder:boolean false
    def stripDrop:int -1
    def stripGrabDx:double 0.0
    def stripMove:PresStripDrag (new PresStripDrag())
    ; Slides picked for an export or a shared view (PresPick): Ctrl/⌘ +
    ; click and Shift + click on the strip, Shift + an arrow on its keys.
    ; `pressCtrl` / `pressShift`: the keys held at the strip's press.
    def picks:PresPick (new PresPick())
    ; copy and paste of slides and elements (PresClip): the copy being
    ; made, the paste being asked about, the text pasted, the pastes Undo
    ; takes back whole
    def clipDoc:PresClipDoc (new PresClipDoc())
    def clipPlan:PresClipPlan (new PresClipPlan())
    def clipRaw:string ""
    def clipFocus:string ""
    def clipUndo:PresClipUndo (new PresClipUndo())
    def pressCtrl:boolean false
    def pressShift:boolean false
    ; The "+" after the last thumbnail: pressed, it offers an empty slide or
    ; a copy of the selected one. `stripAdd` is what the press on it asks
    ; for: "open", "empty", "dup" or "".
    ; slideLines' answer
    def linesFrom:int -1
    def linesAt:int 0
    def addOpen:boolean false
    def stripAdd:string ""
    ; The stage seen closer: how many times the fitted size, and which point
    ; of the slide (0..1 across and down) is at the middle of the fitted
    ; rectangle. 1.0 is the slide as it fits.
    def viewZoom:double 1.0
    def viewU:double 0.5
    def viewV:double 0.5
    def viewBase:PresRect (new PresRect())
    ; The press is a finger. A finger on a diagram does not pan it until the
    ; diagram has been tapped (activeDia), so a slide is not knocked about
    ; by a thumb that only meant to scroll or zoom.
    def touch:boolean false
    def activeDia:int -1
    def activatedNow:boolean false
    def editorDrag:boolean false
    def scrubDrag:boolean false

    ; Which slide is selected, and where on its timeline the stage is. A
    ; local time below zero means "as it stands at the end".
    def selected:int 0
    def localT:double -1.0
    ; The deck clock, in seconds from the first slide.
    def playing:boolean false
    def clock:double 0.0
    ; present mode: how many build steps of the slide on screen are released
    def pStep:int 0
    ; wall-clock seconds since the presentation started, for the speaker view
    def elapsed:double 0.0
    ; after a step back the clock waits this long, so several presses can
    ; go several steps back before the walk moves on again
    def backWait:double 0.0
    ; The seconds the deck clock has been held on the slide on screen (a
    ; build step or the slide's end waiting for a click). The slide's effect
    ; goes on through them: rain does not stop while the speaker talks.
    def fxHeld:double 0.0
    def fxSlide:int -1

    def bufSynced:int -1
    ; the slide shown kept while someone else's edits come (PresFollow)
    def follow:PresFollow (new PresFollow())
    def posLine:int 0
    def posCol:int 0
    ; the PDF and PPTX exports, with the effects the host rendered to
    ; pictures for them and the contrast guard's repairs
    def exporter:PresExport (new PresExport())
    ; The chart settings editor, and the fence it is editing: the lines of
    ; its opening and closing ``` in the Markdown.
    def chart:PresChartEditor (new PresChartEditor())
    def chartStart:int -1
    def chartWinX:double -1.0
    ; The top bar, drawn on the canvas; `barH` is the band it takes (0 when
    ; the page keeps its own, or in a shared presentation).
    def toolbar:PresToolbar (new PresToolbar())
    ; what the page calls the app: the bar's name and the canvas's label
    def appName:string "EVG Presentation"
    def hint:PresHintPopover (new PresHintPopover())
    ; the element picked on the slide, with its handles (PresSelect.rgr)
    def pick:PresSelect (new PresSelect())
    ; the popover was opened from the pick: it stays where it was opened,
    ; next to the element, and does not close when the pointer leaves it
    def hintFromStage:boolean false
    def stageHintX:double 0.0
    def stageHintY:double 0.0
    def stageHintH:double 0.0
    def panels:PresPanels (new PresPanels())
    ; the deck's call on a server of one's own (PresMeet, web/meet.js)
    def meet:PresMeet (new PresMeet())
    ; review mode: comments pinned to the slides (PresReviewUi, PresReview)
    def review:PresReviewUi (new PresReviewUi())
    ; Slide → Draw on slide: what is drawn stays on the slide (PresSketchUi,
    ; PresSketch); a drawing begun on a slide without one is the deck's
    ; until its reference is written (PresDeck.newSketchPath/newSketchSlide),
    ; so the slide shows it from the first stroke
    def sketch:PresSketchUi (new PresSketchUi())
    def sketchScratch:PresSketch (new PresSketch())
    ; a room's chat over the work area (PresRoomView, EVGUI ChannelCtl)
    def room:PresRoomView (new PresRoomView())
    ; the jumps while presenting and the slide number being typed
    def nav:PresNav (new PresNav())
    def reviewTitlesKey:string ""
    ; Which surface over the chrome is on top: the order they are painted in
    ; (`layerOrder`, read by the page) and the order a press, a wheel or the
    ; cursor goes to them (`layerAt`). EVGUI's UiLayers; see `syncLayers`.
    def layers:UiLayers (new UiLayers())
    ; the page is used with a finger: `@media (pointer: coarse)`
    def coarse:boolean false
    ; The editor's skin: "" for the light look, "dark" for the dark one,
    ; "retro" for the glossy lime one. It is a theme name every chrome sheet
    ; is applied with; the skins' rules are `.theme-retro .x` and
    ; `.theme-dark .x`, so "" leaves them all asleep.
    def skin:string ""
    ; the mirrored control the keyboard is on ("" = the editor or the stage)
    def a11yFocus:string ""
    def a11yGen:int 0
    ; when the chart was last written during a drag (deck.uiNow, seconds)
    def chartLiveAt:double -1.0
    ; the undo stack's length when a drag's first live write was made: the
    ; drag's writes are merged into one undo step (-1 = no drag writing)
    def chartUndoBase:int -1
    ; the undo stack's length when the document settings opened
    def docUndoBase:int -1
    ; the editor's text version when Document settings last gave up the keys
    def docSetSeen:int -1
    def panelsKey:string ""
    def barH:double 0.0
    def chartWinY:double -1.0
    def chartEnd:int -1

    Constructor () {
        def r:[string]
        requests = r
        panels.call = meet.people
        ; docked: the bar (in "menu" while one of its menus or lists is
        ; open) and the help and files panels; windows: the value popover
        ; ("Style") and the chart / picture editor; the modal dialogs; the
        ; toast over all
        layers.add("room" "docked")
        layers.add("bar" "docked")
        layers.add("panels" "docked")
        layers.add("sketch" "docked")
        layers.add("review" "docked")
        layers.add("hint" "window")
        layers.add("chart" "window")
        layers.add("dialog" "modal")
        layers.add("toast" "toast")
    }

    ; =========================================================================
    ; Starting
    ; =========================================================================
    fn init:void (css:string w:double h:double) {
        sheet.parse(css)
        hoverCls = (UiTree.hoverClasses(sheet))
        mdEditor = editor
        cssEditor.setLanguage(cssLang)
        cssEditor.autoComplete = false
        cssEditor.fontFamily = "Open Sans"
        cssEditor.layout.fontSize = 13.0
        cssEditor.init("")
        cssSynced = cssEditor.buf.version
        this.makeTabs()
        editor.setLanguage(lang)
        editor.autoComplete = false
        editor.fontFamily = "Open Sans"
        editor.layout.fontSize = 13.0
        editor.init("")
        bufSynced = editor.buf.version
        fileEditor.setLanguage(cssLang)
        fileEditor.autoComplete = false
        fileEditor.fontFamily = "Open Sans"
        fileEditor.layout.fontSize = 13.0
        fileEditor.init("")
        fileSynced = fileEditor.buf.version
        PresApp.lightEditor(editor)
        PresApp.lightEditor(cssEditor)
        PresApp.lightEditor(fileEditor)
        W = w
        H = h
    }

    fn attachFont:boolean (name:string data:buffer) {
        def ok:boolean (deck.md.attachFont(name data))
        if ok {
            set deck.haveFaces name true
            chromeRev = (chromeRev + 1)
        }
        if (name == editor.fontFamily) {
            tr.loadFontBytes(name data)
        }
        if ok {
            measurer = (new TTFTextMeasurer(deck.md.fontManager))
        }
        return ok
    }

    ; The faces the deck's diagram looks want (comma-separated): the page
    ; loads the ones it has not and hands them to `attachFont`.
    fn wantedFaces:string () {
        if inkFace {
            if ((strlen deck.wantFaces) == 0) {
                return (PresInk.FACE())
            }
            return (deck.wantFaces + "," + (PresInk.FACE()))
        }
        return deck.wantFaces
    }

    ; A picture handed over after the slides that name it were laid out (a
    ; file someone else in the deck's room added, read from the share after
    ; their Markdown edit arrived) showed as its "[alt]" text: the slides are
    ; laid out again on the next frame (`settle`), once however many came.
    fn addImage:boolean (name:string data:buffer contentType:string w:int h:int) {
        def ok:boolean (deck.addImage(name data contentType w h))
        if (ok && ((deck.slideCount()) > 0) && (this.namesPicture(name))) {
            picturesArrived = true
        }
        return ok
    }

    ; The Markdown or the theme names the picture at `name` ("/media/a.png").
    fn namesPicture:boolean (name:string) {
        def rel:string name
        if ((indexOf rel "/") == 0) {
            rel = (substring rel 1 (strlen rel))
        }
        if ((strlen rel) == 0) {
            return false
        }
        return (((indexOf (mdEditor.text()) rel) >= 0) || ((indexOf (cssEditor.text()) rel) >= 0))
    }

    ; `[{"path":"/inline-svg/….svg","svg":"<svg …>"}]`: the <svg> drawings
    ; the Markdown writes that the page has not drawn into the store yet
    ; (`PresDeck.inlineSvgsMissing`)
    fn inlineSvgsJson:string () {
        def parts:[string]
        for (deck.inlineSvgsMissing()) u:MdSvgUse i {
            push parts ("{\"path\":" + (PresApp.jsonStr(("/" + u.path))) + ",\"svg\":" + (PresApp.jsonStr(u.svg)) + "}")
        }
        return ("[" + (join parts ",") + "]")
    }

    ; The pictures `inlineSvgsJson` named are in the store now: the slides
    ; are laid out again to show them, and timed again (new slide objects).
    fn inlineSvgsAdded:void () {
        deck.rebuild()
        PresTimeline.planAll(deck)
        chromeRev = (chromeRev + 1)
    }

    ; Another deck opened: the pictures of the one before are gone
    ; (PresDeck.clearImages); the page hands over the new one's.
    fn clearImages:void () {
        deck.clearImages()
        deck.clearPlays()
    }

    ; =========================================================================
    ; Programs on slides (```app): web/apps.js runs each in CErXes and hands
    ; its frames, its stylesheet and what it asks in here (PresPlay)
    ; =========================================================================

    ; Every program of the deck: [{key, slide, src, css, w, h, allow}].
    fn playsJson:string () {
        def out:JVal (JVal.mkArr())
        def all:[PresPlayUse] (deck.playUses())
        def i:int 0
        while (i < (array_length all)) {
            def u:PresPlayUse (itemAt all i)
            def o:JVal (JVal.mkObj())
            o.setStr("key" u.key)
            o.setInt("slide" u.page)
            o.setStr("src" u.spec.src)
            o.setStr("css" u.spec.css)
            o.setNum("w" u.spec.width)
            o.setNum("h" u.spec.height)
            o.setBool("loaded" (deck.hasDataText(u.spec.src)))
            def al:JVal (JVal.mkArr())
            def k:int 0
            while (k < (array_length u.spec.allow)) {
                al.add((JVal.mkStr((itemAt u.spec.allow k))))
                k = (k + 1)
            }
            o.set("allow" al)
            out.add(o)
            i = (i + 1)
        }
        ; the slides' scripts (`{script=…}`), on the whole slide
        def si:int 0
        while (si < (deck.slideCount())) {
            def key:string (deck.scriptKeyOf(si))
            if ((strlen key) > 0) {
                def ss:PresSlide (deck.slideAt(si))
                def so:JVal (JVal.mkObj())
                so.setStr("key" key)
                so.setInt("slide" si)
                so.setStr("src" ss.script)
                so.setStr("css" "")
                so.setNum("w" deck.pageW)
                so.setNum("h" deck.pageH)
                so.setBool("loaded" (deck.hasDataText(ss.script)))
                so.setBool("script" true)
                def sal:JVal (JVal.mkArr())
                for ss.scriptAllow ga:string gai {
                    sal.add((JVal.mkStr(ga)))
                }
                so.set("allow" sal)
                out.add(so)
            }
            si = (si + 1)
        }
        return (out.toJson())
    }

    ; A program's source as the page handed it over, "" before.
    fn playSource:string (key:string) {
        def u@(optional):PresPlayUse (deck.playUse(key))
        if (null? u) {
            return ""
        }
        def use:PresPlayUse (unwrap u)
        return (deck.dataText(use.spec.src))
    }

    ; The programs on the slide the stage shows, one key a line: these run.
    fn playsShown:string () {
        if (((deck.slideCount()) == 0) || (selected >= (deck.slideCount()))) {
            return ""
        }
        def s:PresSlide (deck.slideAt(selected))
        def out:string ""
        def k:int 0
        while (k < (array_length s.plays)) {
            def u:PresPlayUse (itemAt s.plays k)
            out = (out + u.key + (strfromcode 10))
            k = (k + 1)
        }
        def sk:string (deck.scriptKeyOf(selected))
        if ((strlen sk) > 0) {
            out = (out + sk + (strfromcode 10))
        }
        return out
    }

    ; ---- a slide's script (`{script=…}`, PresScript) ----

    ; What script `key`'s onLeave set (web/apps.js, as its slide is left).
    fn setScriptLeave:boolean (key:string json:string) {
        return (deck.setScriptLeave(key json))
    }

    ; A frame of script `key` ({p, a, k, build, click}): false when it was
    ; none.
    fn setScriptFrame:boolean (key:string json:string) {
        def was:int deck.revision
        def ok:boolean (deck.setScriptFrame(key json))
        if (deck.revision != was) {
            PresTimeline.planAll(deck)
            chromeRev = (chromeRev + 1)
        }
        return ok
    }

    ; Where script `key` ends: the slide as thumbnails and exports show it.
    fn setScriptFinal:boolean (key:string json:string) {
        def ok:boolean (deck.setScriptFinal(key json))
        if ok {
            PresTimeline.planAll(deck)
            chromeRev = (chromeRev + 1)
        }
        return ok
    }

    ; Script `key` left the stage, or was stopped (`why`).
    fn endScriptLive:void (key:string why:string) {
        deck.endScriptLive(key why)
        chromeRev = (chromeRev + 1)
    }

    ; The entities script `key` is handed (PresScene.toJson), "" for none.
    fn scriptTree:string (key:string) {
        return (deck.scriptTree(key))
    }

    ; What the final frame of script `key` runs to: {steps, seconds} — its
    ; slide's build steps, and `export-frame` or the slide's length.
    fn scriptFinalArgs:string (key:string) {
        return ((deck.scriptFinalArgs(key)).toJson())
    }

    ; Whether script `key` has onClick: then a press on its slide, while
    ; presenting, is its.
    fn scriptOwnsClick:boolean (key:string) {
        def ro@(optional):PresScriptRun (deck.scriptRun(key))
        if (null? ro) {
            return false
        }
        def r:PresScriptRun (unwrap ro)
        return r.ownsClick
    }

    ; Window point (x, y) on the stage in slide px, with the entity of
    ; script `key`'s slide under it (the smallest, a word before its line),
    ; {"x", "y", "id"}; "" off the slide or when the stage shows another.
    fn scriptHit:string (key:string x:double y:double) {
        def pg:int (deck.scriptPage(key))
        if (((pg < 0) || (pg != selected)) || ((slideRect.has(x y)) == false)) {
            return ""
        }
        this.slidePoint(x y)
        def o:JVal (JVal.mkObj())
        o.setNum("x" spX)
        o.setNum("y" spY)
        o.setStr("id" (deck.scriptEntityAt(pg spX spY)))
        return (o.toJson())
    }

    ; The 3-D worlds on the slide the stage shows, for the page to draw:
    ; [{src, scene, x, y, w, h}] in slide units, "[]" for none.
    fn playScenesJson:string () {
        return ((deck.playScenes(selected)).toJson())
    }

    ; A frame of program `key`: its view() as JSON. False when that was no
    ; element tree (the program's error then says so).
    fn setPlayFrame:boolean (key:string tree:string) {
        def v@(optional):PresPlayView (deck.playView(key))
        if (null? v) {
            return false
        }
        def view:PresPlayView (unwrap v)
        return (view.setTree(tree))
    }

    ; Why the page stopped program `key` or could not start it, "" when it
    ; runs: said on its plate while it has no picture.
    fn setPlayStopped:void (key:string why:string) {
        def v@(optional):PresPlayView (deck.playView(key))
        if (null? v) {
            return
        }
        def view:PresPlayView (unwrap v)
        if (view.stopped != why) {
            view.stopped = why
            deck.revision = (deck.revision + 1)
            chromeRev = (chromeRev + 1)
        }
    }

    ; What a program reads each frame beside the keys and the pointer: where
    ; the deck is and its data. {slide, slides, step, mode, data}
    fn playState:string (key:string) {
        def o:JVal (JVal.mkObj())
        def page:int selected
        def u@(optional):PresPlayUse (deck.playUse(key))
        if (!null? u) {
            def use:PresPlayUse (unwrap u)
            o.setInt("home" (use.page + 1))
        }
        o.setInt("slide" (selected + 1))
        o.setInt("slides" (deck.slideCount()))
        o.setInt("step" pStep)
        ; the slide the stage showed before this one (1-based, 0 for none):
        ; a script's onEnter(from)
        o.setInt("from" cameFrom)
        o.setStr("mode" mode)
        o.setBool("focused" (deck.playFocus == key))
        o.set("data" (deck.playData(page)))
        return (o.toJson())
    }

    ; What a frame of program `key` asked of the deck (a JSON list), done as
    ; far as its fence allows: looks and values in the deck, moves between
    ; slides here. True when the stage changed.
    fn playAsks:boolean (key:string json:string) {
        if ((strlen json) < 3) {
            return false
        }
        def was:int deck.revision
        def moves:[PresPlayAsk] (deck.takeAsks(key json))
        if deck.playRebuilt {
            ; the slides are new objects: timed again (see setChartData)
            deck.playRebuilt = false
            PresTimeline.planAll(deck)
            chromeRev = (chromeRev + 1)
        }
        def i:int 0
        while (i < (array_length moves)) {
            def a:PresPlayAsk (itemAt moves i)
            this.playMove(a)
            i = (i + 1)
        }
        if ((array_length moves) > 0) {
            chromeRev = (chromeRev + 1)
            return true
        }
        return (deck.revision != was)
    }

    fn playMove:void (a:PresPlayAsk) {
        def n:int (deck.slideCount())
        if (n == 0) {
            return
        }
        if (mode == "present") {
            if (a.kind == "slide.next") {
                this.pageNext()
            }
            if (a.kind == "slide.prev") {
                this.pagePrev()
            }
            if (a.kind == "slide.step") {
                this.next()
            }
            if (a.kind == "slide.go") {
                this.goToSlide((to_string a.n))
            }
            return
        }
        if (a.kind == "slide.next") {
            this.selectSlide((selected + 1))
        }
        if (a.kind == "slide.prev") {
            this.selectSlide((selected - 1))
        }
        if (a.kind == "slide.go") {
            this.selectSlide((a.n - 1))
        }
    }

    ; The program under window point (x, y) on the stage, "" for none.
    fn playAt:string (x:double y:double) {
        if (((deck.slideCount()) == 0) || ((slideRect.has(x y)) == false)) {
            return ""
        }
        this.slidePoint(x y)
        return (deck.playAt(selected spX spY))
    }

    ; Window point (x, y) in program `key`'s units with the id under it
    ; ({"x", "y", "id"}), "" outside it.
    fn playPoint:string (key:string x:double y:double) {
        this.slidePoint(x y)
        return (deck.playPoint(key spX spY))
    }

    ; The program that has the keyboard ("" gives it back to the deck).
    fn setPlayFocus:void (key:string) {
        if (deck.playFocus != key) {
            deck.playFocus = key
            chromeRev = (chromeRev + 1)
        }
    }

    fn playFocus:string () {
        return deck.playFocus
    }

    ; What the deck's programs got wrong, one line each.
    fn playNotes:string () {
        return (join (deck.playNotes()) (strfromcode 10))
    }

    ; An SVG picture's own text and bytes, and a small PNG of it, beside the
    ; PNG `addImage` was given: the PDF draws its paths, the PPTX carries it.
    fn addSvgPicture:void (name:string text:string bytes:buffer small:buffer) {
        deck.addSvgPicture(name text bytes small)
    }

    fn addTemplate:void (name:string css:string) {
        deck.addTemplate(name css)
    }

