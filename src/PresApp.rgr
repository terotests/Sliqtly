    fn openDupDeck:boolean (name:string) {
        if (mode == "present") {
            return false
        }
        this.closeHint()
        if chart.isOpen {
            this.closeChart()
        }
        this.place()
        def px:double ((W - 560.0) * 0.5)
        if (px < 8.0) {
            px = 8.0
        }
        def py:double (barH + 24.0)
        chartStart = -1
        chartFile = ""
        chart.measurer = measurer
        chart.openDupDeck(name px py W H)
        focus = "chart"
        chromeRev = (chromeRev + 1)
        return true
