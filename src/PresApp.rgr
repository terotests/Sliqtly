; ============================================================================
; PresApp.rgr — the presentation editor, as one class a browser holds.
; ============================================================================
;
;   ┌──────────────┬──────────────────────────────────────┐
;   │ ScriptEditor │  stage: the slide at the playhead    │
;   │  (markdown)  ├──────────────────────────────────────┤
;   │              │  tracks: text · speech · animation   │
;   │              ├──────────────────────────────────────┤
;   │              │  filmstrip                           │
;   └──────────────┴──────────────────────────────────────┘
;
; Everything on the canvas is EVG: the editor paints into the chrome list,
; the tracks and the filmstrip frames are an element tree laid out by
; `pres.css`, and each slide is a display list of its own (`stageJson`,
; `thumbJson`) that the host draws through a camera into the rectangle
; `layoutJson` names. The toolbar, the menus and the browser's own APIs are
; the host's HTML — this class never learns what a button looks like.
;
; TIME is the host's. It says what time it is (`setTime`) and reads back what
; time the app agreed to (`currentTime`): in a presentation the clock stops
; at the next build step until a click releases it, so the host's clock is
; rebased on the answer. Nothing here counts frames.
;
; What the host is asked to do leaves as strings through `takeRequest()`,
; so the class runs under Node in a check exactly as it does in a tab.
; ============================================================================

Import "PresTimeline.rgr"
Import "../datagrid/src/script/ScriptEditor.rgr"
Import "../game_engine/ui/UITextRenderer.rgr"
Import "../game_engine/ui/UIInput.rgr"
Import "../r5/src/R5MdLanguage.rgr"
Import "PresCssLanguage.rgr"
Import "PresHints.rgr"
Import "../ui/src/TabsCtl.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGStyleSheet.rgr"
Import "pkg:evg/EVGHitTest.rgr"
Import "pkg:evg/EVGImageDecode.rgr"

class PresRect {
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0

    fn has:boolean (px:double py:double) {
        if (px < x) { return false }
        if (py < y) { return false }
        if (px > (x + w)) { return false }
        if (py > (y + h)) { return false }
        return true
    }

    fn set:void (ax:double ay:double aw:double ah:double) {
        x = ax
        y = ay
        w = aw
        h = ah
    }
}

class PresApp {
    def deck:PresDeck (new PresDeck())
    def editor:ScriptEditor (new ScriptEditor())
    def tr:UITextRenderer (new UITextRenderer())
    def lang:R5MdLanguage (new R5MdLanguage())
    ; Two texts behind one editor pane, chosen by the tabs above it: the
    ; deck's Markdown and the theme's CSS. `editor` is whichever is showing,
    ; so keys, pointer and paint need no second path; building the deck
    ; always reads `mdEditor`.
    def mdEditor:ScriptEditor (new ScriptEditor())
    def cssEditor:ScriptEditor (new ScriptEditor())
    def cssLang:PresCssLanguage (new PresCssLanguage())
    def edTab:string "md"
    def cssSynced:int -1
    def themeText:string ""
    def tabs:TabsCtl (new TabsCtl())
    def tabRect:PresRect (new PresRect())
    def tabH:double 34.0
    def sheet:EVGStyleSheet (new EVGStyleSheet())
    def measurer@(optional):TTFTextMeasurer
    def chromeRoot@(optional):EVGElement

    def W:double 1200.0
    def H:double 700.0
    ; "edit" | "present"
    def mode:string "edit"
    def speaker:boolean false
    ; present: steps come by themselves rather than by a click
    def auto:boolean false
    ; "editor" | "stage" | ""
    def focus:string "editor"
    def blink:int 0
    def chromeRev:int 0
    def requests:[string]

    ; The editor's share of the width, and the rectangles the layout made.
    def split:double 0.40
    def splitDrag:boolean false
    def edRect:PresRect (new PresRect())
    def sepRect:PresRect (new PresRect())
    def stageArea:PresRect (new PresRect())
    def slideRect:PresRect (new PresRect())
    def trackRect:PresRect (new PresRect())
    def laneX:double 0.0
    def laneW:double 0.0
    def stripRect:PresRect (new PresRect())
    def nextRect:PresRect (new PresRect())
    def thumbW:double 128.0
    def thumbH:double 72.0
    def thumbGap:double 10.0
    def stripScroll:double 0.0
    def editorDrag:boolean false
    def scrubDrag:boolean false

    ; Which slide is selected, and where on its timeline the stage is. A
    ; local time below zero means "as it stands at the end".
    def selected:int 0
    def localT:double -1.0
    ; The deck clock, in seconds from the first slide.
    def playing:boolean false
    def clock:double 0.0
    ; present mode: how many build steps of the slide on screen are released
    def pStep:int 0
    ; wall-clock seconds since the presentation started, for the speaker view
    def elapsed:double 0.0
    ; after a step back the clock waits this long, so several presses can
    ; go several steps back before the walk moves on again
    def backWait:double 0.0

    def bufSynced:int -1
    def posLine:int 0
    def posCol:int 0

    Constructor () {
        def r:[string]
        requests = r
    }

    ; =========================================================================
    ; Starting
    ; =========================================================================
    fn init:void (css:string w:double h:double) {
        sheet.parse(css)
        mdEditor = editor
        cssEditor.setLanguage(cssLang)
        cssEditor.autoComplete = false
        cssEditor.fontFamily = "Open Sans"
        cssEditor.layout.fontSize = 13.0
        cssEditor.init("")
        cssSynced = cssEditor.buf.version
        this.makeTabs()
        editor.setLanguage(lang)
        editor.autoComplete = false
        editor.fontFamily = "Open Sans"
        editor.layout.fontSize = 13.0
        editor.init("")
        bufSynced = editor.buf.version
        W = w
        H = h
    }

    fn attachFont:boolean (name:string data:buffer) {
        def ok:boolean (deck.md.attachFont(name data))
        if (name == editor.fontFamily) {
            tr.loadFontBytes(name data)
        }
        if ok {
            measurer = (new TTFTextMeasurer(deck.md.fontManager))
        }
        return ok
    }

    fn addImage:boolean (name:string data:buffer contentType:string w:int h:int) {
        return (deck.md.addImage(name data contentType w h))
    }

    fn addTemplate:void (name:string css:string) {
        deck.md.addTheme(name css)
    }

    ; The reader's template, which beats what the document names; "" lets
    ; the document decide.
    fn setStyleSheet:void (css:string) {
        themeText = css
        cssEditor.init(css)
        cssSynced = cssEditor.buf.version
        this.applyTheme(css)
    }

    fn applyTheme:void (css:string) {
        deck.setTheme(css)
        deck.md.setStyleSheet(css)
        this.rebuildDeck()
    }

    ; The theme as it stands in the CSS tab (the host keeps an edited one).
    fn themeCss:string () {
        return (cssEditor.text())
    }

    ; Fresh elements each time: the chrome stylesheet sets a matched class's
    ; properties and never takes them back, so a tab kept from the last
    ; build would keep the active look after it lost the class.
    fn makeTabs:void () {
        tabs = (new TabsCtl())
        tabs.tid = "edtabs"
        tabs.name = "Editori"
        tabs.addItem("md" "Markdown" "" false)
        tabs.addItem("css" "Teema (CSS)" "" false)
        tabs.value = edTab
        tabs.build()
    }

    fn editorTab:string () {
        return edTab
    }

    fn showTab:void (v:string) {
        if ((v != "md") && (v != "css")) {
            return
        }
        edTab = v
        this.makeTabs()
        if (v == "css") {
            editor = cssEditor
        } {
            editor = mdEditor
        }
        focus = "editor"
        chromeRev = (chromeRev + 1)
    }

    fn setSource:void (text:string) {
        this.showTab("md")
        mdEditor.init(text)
        bufSynced = mdEditor.buf.version
        selected = 0
        localT = -1.0
        playing = false
        clock = 0.0
        this.rebuildDeck()
    }

    fn source:string () {
        return (mdEditor.text())
    }

    fn setPageSize:void (w:double h:double) {
        W = w
        H = h
        chromeRev = (chromeRev + 1)
    }

    fn rebuildDeck:void () {
        deck.setText((mdEditor.text()))
        PresTimeline.planAll(deck)
        if (selected >= (deck.slideCount())) {
            selected = ((deck.slideCount()) - 1)
        }
        if (selected < 0) {
            selected = 0
        }
        chromeRev = (chromeRev + 1)
    }

    ; The buffer moved; the deck follows, and the selection follows the caret.
    fn syncEditor:void () {
        if (edTab == "css") {
            ; the theme, live: the slides follow each keystroke
            if (cssEditor.buf.version != cssSynced) {
                cssSynced = cssEditor.buf.version
                themeText = (cssEditor.text())
                this.applyTheme(themeText)
                push requests "theme-edited"
            }
            chromeRev = (chromeRev + 1)
            return
        }
        if (mdEditor.buf.version == bufSynced) {
            this.followCaret()
            return
        }
        bufSynced = mdEditor.buf.version
        this.rebuildDeck()
        this.followCaret()
    }

    fn followCaret:void () {
        if ((playing || (mode == "present")) || (edTab != "md")) {
            return
        }
        def off:int (this.offsetOf(mdEditor.sel.caret.line mdEditor.sel.caret.col))
        def s:int (deck.pageOfOffset(off))
        if (s != selected) {
            selected = s
            localT = -1.0
            this.revealThumb(s)
        }
        chromeRev = (chromeRev + 1)
    }

    fn offsetOf:int (line:int col:int) {
        def off:int 0
        def i:int 0
        def n:int (mdEditor.buf.lineCount())
        while (i < line) {
            if (i >= n) {
                break
            }
            off = ((off + (strlen (mdEditor.buf.lineAt(i)))) + 1)
            i = (i + 1)
        }
        return (off + col)
    }

    fn posOf:void (text:string offset:int) {
        def n:int (strlen text)
        def stop:int offset
        if (stop > n) {
            stop = n
        }
        def line:int 0
        def col:int 0
        def i:int 0
        while (i < stop) {
            if ((charAt text i) == 10) {
                line = (line + 1)
                col = 0
            } {
                col = (col + 1)
            }
            i = (i + 1)
        }
        posLine = line
        posCol = col
    }

    ; Select a slide: the stage shows it, and the editor's caret goes to it.
    fn selectSlide:void (i:int) {
        if ((i < 0) || (i >= (deck.slideCount()))) {
            return
        }
        selected = i
        localT = -1.0
        def s:PresSlide (deck.slideAt(i))
        if (s.srcStart >= 0) {
            ; The line the slide's first box came from — its heading, as a rule.
            this.posOf((mdEditor.text()) s.srcStart)
            mdEditor.sel.setCaret(posLine 0)
            mdEditor.sel.collapseToCaret()
            mdEditor.layout.ensureCaretVisible(mdEditor.buf mdEditor.sel)
        }
        this.revealThumb(i)
        chromeRev = (chromeRev + 1)
    }

    fn revealThumb:void (i:int) {
        if (mode != "edit") {
            return
        }
        this.place()
        def x:double ((to_double i) * (thumbW + thumbGap))
        def view:double (stripRect.w - 24.0)
        if (x < stripScroll) {
            stripScroll = x
        }
        if ((x + thumbW) > (stripScroll + view)) {
            stripScroll = ((x + thumbW) - view)
        }
        if (stripScroll < 0.0) {
            stripScroll = 0.0
        }
    }

    ; =========================================================================
    ; Time
    ; =========================================================================
    fn slideShown:int () {
        return selected
    }

    ; The local time the stage draws the shown slide at.
    fn stageTime:double () {
        if ((selected < 0) || (selected >= (deck.slideCount()))) {
            return 0.0
        }
        def s:PresSlide (deck.slideAt(selected))
        if (playing || (mode == "present")) {
            def t:double (clock - (PresTimeline.slideStart(deck selected)))
            if (t < 0.0) {
                t = 0.0
            }
            return t
        }
        if (localT < 0.0) {
            return s.duration
        }
        return localT
    }

    fn isPlaying:boolean () {
        return (playing || (mode == "present"))
    }

    fn currentTime:double () {
        if (this.isPlaying()) {
            return clock
        }
        return ((PresTimeline.slideStart(deck selected)) + (this.stageTime()))
    }

    ; The host's clock. Returns the time the app accepted, which is less
    ; when a presentation is holding for a click.
    fn setTime:double (t:double) {
        if ((deck.slideCount()) == 0) {
            return 0.0
        }
        def want:double t
        if (want < 0.0) {
            want = 0.0
        }
        if ((backWait > 0.0) && (this.isPlaying())) {
            if (want > clock) {
                backWait = (backWait - (want - clock))
            }
            chromeRev = (chromeRev + 1)
            return clock
        }
        ; a diagram asking which way to go stops the clock, in any mode
        if (this.isPlaying()) {
            def on:int selected
            if playing {
                on = (PresTimeline.slideAtTime(deck clock))
            }
            def dh:double (deck.diagramHold(on))
            def held:boolean false
            if (dh >= 0.0) {
                def stopAt:double ((PresTimeline.slideStart(deck on)) + dh)
                if ((clock <= (stopAt + 0.001)) && (want > stopAt)) {
                    want = stopAt
                    held = true
                }
            }
            ; A question no one answers (or a loop no one leaves) does not
            ; keep the room waiting: after `skipAfter` seconds it is skipped.
            if held {
                if (holdSince < 0.0) {
                    holdSince = deck.uiNow
                }
                def left:double (skipAfter - (deck.uiNow - holdSince))
                if (left <= 0.0) {
                    return (this.skipQuestion(on))
                }
                deck.setSkipLeft(on left)
            } {
                holdSince = -1.0
            }
        }
        if (mode == "present") {
            def start:double (PresTimeline.slideStart(deck selected))
            def s:PresSlide (deck.slideAt(selected))
            if auto {
                if (want >= (start + s.duration)) {
                    if (selected < ((deck.slideCount()) - 1)) {
                        selected = (selected + 1)
                        pStep = 0
                    } {
                        want = (start + s.duration)
                    }
                }
                def sNow:PresSlide (deck.slideAt(selected))
                def local:double (want - (PresTimeline.slideStart(deck selected)))
                pStep = 0
                def k:int 1
                while (k <= sNow.steps) {
                    if ((PresTimeline.stepTime(sNow k)) <= local) {
                        pStep = k
                    }
                    k = (k + 1)
                }
            } {
                def hold:double (start + s.duration)
                if (pStep < s.steps) {
                    hold = (start + (PresTimeline.stepTime(s (pStep + 1))))
                }
                if (want > hold) {
                    want = hold
                }
            }
            clock = want
            chromeRev = (chromeRev + 1)
            return clock
        }
        if playing {
            def total:double (PresTimeline.total(deck))
            if (want >= total) {
                want = total
                playing = false
                localT = -1.0
            }
            clock = want
            def was:int selected
            selected = (PresTimeline.slideAtTime(deck want))
            if (selected != was) {
                this.revealThumb(selected)
            }
            if (! playing) {
                localT = -1.0
            }
            chromeRev = (chromeRev + 1)
            return clock
        }
        return (this.currentTime())
    }

    ; Play from the selected slide's start (or from the playhead, when the
    ; tracks have been scrubbed).
    fn play:void () {
        if ((deck.slideCount()) == 0) {
            return
        }
        def start:double (PresTimeline.slideStart(deck selected))
        if (localT >= 0.0) {
            start = (start + localT)
        }
        clock = start
        playing = true
        deck.resetExplore()
        chromeRev = (chromeRev + 1)
    }

    fn stop:void () {
        playing = false
        localT = (this.clampLocal((clock - (PresTimeline.slideStart(deck selected)))))
        chromeRev = (chromeRev + 1)
    }

    fn clampLocal:double (t:double) {
        if ((selected < 0) || (selected >= (deck.slideCount()))) {
            return -1.0
        }
        def s:PresSlide (deck.slideAt(selected))
        if (t < 0.0) {
            return 0.0
        }
        if (t >= s.duration) {
            return -1.0
        }
        return t
    }

    ; =========================================================================
    ; Steering a diagram
    ; =========================================================================
    fn slidePoint:void (x:double y:double) {
        def sc:double (this.slideScale())
        spX = ((x - slideRect.x) / sc)
        spY = ((y - slideRect.y) / sc)
    }

    def spX:double 0.0
    def spY:double 0.0

    ; A press on the stage that meant something to a diagram.
    fn stagePress:boolean (x:double y:double) {
        if (! (slideRect.has(x y))) {
            return false
        }
        this.slidePoint(x y)
        def code:string (deck.diagramHit(selected (this.stageTime()) spX spY))
        if ((strlen code) == 0) {
            return false
        }
        def colon:int (indexOf code ":")
        def kn@(optional):int (str2int (substring code 0 colon))
        def k:int (?? kn 0)
        def what:string (substring code (colon + 1) (strlen code))
        def hitU@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hitU) {
            return false
        }
        def du:PresDiaUse (unwrap hitU)
        if (what == "back") {
            if (! (du.diagram.exploreBack())) {
                this.diagramBack(k)
            }
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "skip") {
            def on:int selected
            if playing {
                on = (PresTimeline.slideAtTime(deck clock))
            }
            this.skipQuestion(on)
            return true
        }
        if (what == "menu") {
            du.diagram.menuOpen = (! du.diagram.menuOpen)
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "none") {
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "all") {
            du.diagram.uiNow = deck.uiNow
            du.diagram.showEverything()
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "restart") {
            du.diagram.restart()
            PresTimeline.plan((deck.slideAt(selected)))
            localT = du.start
            if (localT < 0.0) {
                localT = 0.0
            }
            this.play()
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "zin") {
            du.diagram.zoomBy(1.4)
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "zout") {
            du.diagram.zoomBy((1.0 / 1.4))
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "fit") {
            du.diagram.exploreOverview()
            chromeRev = (chromeRev + 1)
            return true
        }
        if (((strlen what) > 3) && ((substring what 0 3) == "way")) {
            def wi@(optional):int (str2int (substring what 3 (strlen what)))
            du.diagram.exGo((?? wi -1) ((this.stageTime()) - du.start))
            chromeRev = (chromeRev + 1)
            return true
        }
        if (((strlen what) > 4) && ((substring what 0 4) == "node")) {
            def ni@(optional):int (str2int (substring what 4 (strlen what)))
            du.diagram.explore((?? ni -1))
            chromeRev = (chromeRev + 1)
            return true
        }
        if (what == "back") {
            this.diagramBack(k)
        } {
            def on@(optional):int (str2int what)
            this.diagramPick(k (?? on 0))
        }
        return true
    }

    fn diagramPick:void (k:int i:int) {
        def hit@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hit) {
            return
        }
        def u:PresDiaUse (unwrap hit)
        def local:double (this.stageTime())
        ; a choice made: the walk's camera takes over again
        u.diagram.exploreHome()
        if (u.diagram.pick(i)) {
            PresTimeline.plan((deck.slideAt(selected)))
            if (! (this.isPlaying())) {
                localT = local
                this.play()
            }
        }
        chromeRev = (chromeRev + 1)
    }

    fn diagramBack:void (k:int) {
        def hit@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hit) {
            return
        }
        def u:PresDiaUse (unwrap hit)
        u.diagram.exploreHome()
        def local:double ((u.start) + (u.diagram.back(((this.stageTime()) - u.start))))
        PresTimeline.plan((deck.slideAt(selected)))
        if (this.isPlaying()) {
            clock = ((PresTimeline.slideStart(deck selected)) + local)
            backWait = 1.2
        } {
            localT = local
        }
        chromeRev = (chromeRev + 1)
    }

    ; Keys for a diagram that is asking, or for going back in one. True when
    ; the key was taken.
    fn diagramKey:boolean (name:string) {
        def t:double (this.stageTime())
        def k:int (deck.askingAt(selected t))
        def sl0:PresSlide (deck.slideAt(selected))
        if ((array_length sl0.diagrams) > 0) {
            def ue:PresDiaUse (itemAt sl0.diagrams 0)
            if ((name == "+") || (name == "=")) {
                ue.diagram.zoomBy(1.4)
                chromeRev = (chromeRev + 1)
                return true
            }
            if (name == "-") {
                ue.diagram.zoomBy((1.0 / 1.4))
                chromeRev = (chromeRev + 1)
                return true
            }
            if (name == "0") {
                ue.diagram.exploreOverview()
                chromeRev = (chromeRev + 1)
                return true
            }
            ; exploring: arrows choose the way on, Enter takes it
            def te:double (t - ue.start)
            if ((name == "left") || (name == "up")) {
                if (ue.diagram.exMoveSel(-1 te)) {
                    chromeRev = (chromeRev + 1)
                    return true
                }
            }
            if ((name == "right") || (name == "down")) {
                if (ue.diagram.exMoveSel(1 te)) {
                    chromeRev = (chromeRev + 1)
                    return true
                }
            }
            if ((name == "enter") || (name == "space")) {
                if (ue.diagram.exGo(-1 te)) {
                    chromeRev = (chromeRev + 1)
                    return true
                }
            }
            if ((name == "backspace") && ue.diagram.exploring) {
                ue.diagram.exploreBack()
                chromeRev = (chromeRev + 1)
                return true
            }
        }
        if (name == "backspace") {
            def s:PresSlide (deck.slideAt(selected))
            if ((array_length s.diagrams) > 0) {
                def u0:PresDiaUse (itemAt s.diagrams 0)
                if (u0.diagram.canGoBack((t - u0.start))) {
                    this.diagramBack(0)
                    return true
                }
            }
            return false
        }
        if (k < 0) {
            return false
        }
        def hit@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hit) {
            return false
        }
        def u:PresDiaUse (unwrap hit)
        if ((name == "left") || (name == "up")) {
            u.diagram.moveSel(-1)
            chromeRev = (chromeRev + 1)
            return true
        }
        if ((name == "right") || (name == "down")) {
            u.diagram.moveSel(1)
            chromeRev = (chromeRev + 1)
            return true
        }
        if ((name == "enter") || (name == "space")) {
            this.diagramPick(k u.diagram.optSel)
            return true
        }
        if (((strlen name) == 1) && (((charAt name 0) >= 49) && ((charAt name 0) <= 57))) {
            this.diagramPick(k ((charAt name 0) - 49))
            return true
        }
        return false
    }

    ; =========================================================================
    ; Presenting
    ; =========================================================================
    fn present:void (fromStart:boolean) {
        mode = "present"
        playing = false
        if fromStart {
            selected = 0
        }
        pStep = 0
        clock = (PresTimeline.slideStart(deck selected))
        elapsed = 0.0
        deck.resetExplore()
        push requests "fullscreen"
        chromeRev = (chromeRev + 1)
    }

    fn endPresent:void () {
        if (mode != "present") {
            return
        }
        mode = "edit"
        localT = -1.0
        push requests "exit-fullscreen"
        this.selectSlide(selected)
        chromeRev = (chromeRev + 1)
    }

    fn setElapsed:void (s:double) {
        elapsed = s
    }

    ; A click, a space, an arrow: the next build step, or the next slide.
    fn next:void () {
        if ((deck.slideCount()) == 0) {
            return
        }
        def s:PresSlide (deck.slideAt(selected))
        if (pStep < s.steps) {
            pStep = (pStep + 1)
            ; A click during the step's own run shows it at once rather than
            ; waiting for the clock to reach it.
            def at:double ((PresTimeline.slideStart(deck selected)) + (PresTimeline.stepTime(s pStep)))
            if (clock < at) {
                clock = at
            }
        } {
            if (selected < ((deck.slideCount()) - 1)) {
                selected = (selected + 1)
                pStep = 0
                clock = (PresTimeline.slideStart(deck selected))
            }
        }
        chromeRev = (chromeRev + 1)
    }

    fn prev:void () {
        if (selected <= 0) {
            clock = 0.0
            pStep = 0
            chromeRev = (chromeRev + 1)
            return
        }
        selected = (selected - 1)
        def s:PresSlide (deck.slideAt(selected))
        pStep = s.steps
        clock = ((PresTimeline.slideStart(deck selected)) + s.duration)
        chromeRev = (chromeRev + 1)
    }

    ; =========================================================================
    ; Layout
    ; =========================================================================
    fn place:void () {
        if (mode == "present") {
            this.placePresent()
            return
        }
        def edW:double (W * split)
        if (edW < 280.0) { edW = 280.0 }
        if (edW > (W - 360.0)) { edW = (W - 360.0) }
        tabRect.set(0.0 0.0 edW tabH)
        edRect.set(0.0 tabH edW (H - tabH))
        sepRect.set(edW 0.0 6.0 H)
        def rx:double (edW + 6.0)
        def rw:double (W - rx)
        def stripH:double (thumbH + 34.0)
        def trackH:double 118.0
        stripRect.set(rx (H - stripH) rw stripH)
        trackRect.set(rx ((H - stripH) - trackH) rw trackH)
        laneX = (rx + 92.0)
        laneW = (rw - 108.0)
        stageArea.set(rx 0.0 rw ((H - stripH) - trackH))
        this.fitSlide(stageArea 20.0)
    }

    fn placePresent:void () {
        edRect.set(0.0 0.0 0.0 0.0)
        tabRect.set(0.0 0.0 0.0 0.0)
        sepRect.set(0.0 0.0 0.0 0.0)
        trackRect.set(0.0 0.0 0.0 0.0)
        stripRect.set(0.0 0.0 0.0 0.0)
        if speaker {
            stageArea.set(0.0 0.0 (W * 0.64) H)
            this.fitSlide(stageArea 24.0)
            def nx:double ((W * 0.64) + 12.0)
            def nw:double ((W - nx) - 24.0)
            nextRect.set(nx 64.0 nw (nw * (deck.pageH / deck.pageW)))
        } {
            stageArea.set(0.0 0.0 W H)
            this.fitSlide(stageArea 0.0)
            nextRect.set(0.0 0.0 0.0 0.0)
        }
    }

    fn fitSlide:void (area:PresRect pad:double) {
        def aw:double (area.w - (pad * 2.0))
        def ah:double (area.h - (pad * 2.0))
        if (aw < 10.0) { aw = 10.0 }
        if (ah < 10.0) { ah = 10.0 }
        def sc:double (aw / deck.pageW)
        if ((deck.pageH * sc) > ah) {
            sc = (ah / deck.pageH)
        }
        def w:double (deck.pageW * sc)
        def h:double (deck.pageH * sc)
        slideRect.set((area.x + ((area.w - w) * 0.5)) (area.y + ((area.h - h) * 0.5)) w h)
    }

    fn slideScale:double () {
        return (slideRect.w / deck.pageW)
    }

    fn thumbX:double (i:int) {
        return (((stripRect.x + 12.0) + ((to_double i) * (thumbW + thumbGap))) - stripScroll)
    }

    ; Only whole thumbnails: the host draws them without a clip.
    fn thumbFits:boolean (x:double) {
        return ((x >= (stripRect.x + 4.0)) && ((x + thumbW) <= ((stripRect.x + stripRect.w) - 4.0)))
    }

    fn thumbY:double () {
        return (stripRect.y + 22.0)
    }

    ; Where the host draws what: the stage and every thumbnail on screen.
    fn layoutJson:string () {
        this.place()
        def sc:double (this.slideScale())
        def out:string ("{\"mode\":\"" + mode + "\"")
        out = (out + ",\"rev\":" + (to_string deck.revision))
        out = (out + ",\"slide\":" + (to_string selected))
        out = (out + ",\"slides\":" + (to_string (deck.slideCount())))
        out = (out + ",\"time\":" + (EVGDisplayList.num((this.currentTime()))))
        out = (out + ",\"playing\":" + (? (this.isPlaying()) "true" "false"))
        out = (out + ",\"stage\":[" + (PresApp.nums4(slideRect.x slideRect.y sc 0.0)) + "]")
        out = (out + ",\"clip\":[" + (PresApp.nums4(stageArea.x stageArea.y stageArea.w stageArea.h)) + "]")
        out = (out + ",\"thumbs\":[")
        def first:boolean true
        if (mode == "edit") {
            def ts:double (thumbW / deck.pageW)
            def i:int 0
            while (i < (deck.slideCount())) {
                def x:double (this.thumbX(i))
                if (this.thumbFits(x)) {
                    if (! first) {
                        out = (out + ",")
                    }
                    first = false
                    out = (out + "[" + (to_string i) + "," + (PresApp.nums4(x (this.thumbY()) ts 0.0)) + "]")
                }
                i = (i + 1)
            }
        }
        if ((mode == "present") && speaker) {
            if (selected < ((deck.slideCount()) - 1)) {
                def ns:double (nextRect.w / deck.pageW)
                out = (out + "[" + (to_string (selected + 1)) + "," + (PresApp.nums4(nextRect.x nextRect.y ns 0.0)) + "]")
            }
        }
        out = (out + "]")
        out = (out + ",\"strip\":[" + (PresApp.nums4(stripRect.x stripRect.y stripRect.w stripRect.h)) + "]")
        out = (out + ",\"focus\":\"" + focus + "\"}")
        return out
    }

    sfn nums4:string (a:double b:double c:double d:double) {
        return ((EVGDisplayList.num(a)) + "," + (EVGDisplayList.num(b)) + "," + (EVGDisplayList.num(c)) + "," + (EVGDisplayList.num(d)))
    }

    ; =========================================================================
    ; The slides, as display lists in slide coordinates
    ; =========================================================================
    fn listJson:string (l:EVGDisplayList) {
        return ("{\"width\":" + (EVGDisplayList.num(deck.pageW)) + ",\"height\":" + (EVGDisplayList.num(deck.pageH)) + ",\"list\":" + (l.toJson()) + "}")
    }

    def holdSince:double -1.0
    def skipAfter:double 8.0

    ; Past the question on slide `on`, to the next slide. Returns the clock.
    fn skipQuestion:double (on:int) {
        deck.skipQuestions(on)
        holdSince = -1.0
        def last:int ((deck.slideCount()) - 1)
        if (on < last) {
            if (mode == "present") {
                selected = (on + 1)
                pStep = 0
            }
            clock = (PresTimeline.slideStart(deck (on + 1)))
            if playing {
                selected = (on + 1)
                this.revealThumb(selected)
            }
        }
        chromeRev = (chromeRev + 1)
        return clock
    }

    fn stageJson:string () {
        deck.live = (this.isPlaying())
        deck.showControls = true
        def out:string (this.listJson((PresTimeline.frame(deck selected (this.stageTime())))))
        deck.showControls = false
        deck.live = false
        return out
    }

    ; The host's wall clock, for the viewer's own camera moves in a diagram.
    fn setUiTime:void (s:double) {
        deck.uiNow = s
    }

    fn uiBusy:boolean () {
        return (deck.uiBusy(selected))
    }

    fn slideJson:string (i:int) {
        return (this.listJson((PresTimeline.finalFrame(deck i))))
    }

    ; The frame at a deck time, for a capture that walks the timeline.
    fn frameAtJson:string (t:double) {
        def i:int (PresTimeline.slideAtTime(deck t))
        def local:double (t - (PresTimeline.slideStart(deck i)))
        return (this.listJson((PresTimeline.frame(deck i local))))
    }

    ; =========================================================================
    ; The chrome
    ; =========================================================================
    sfn div:EVGElement (id:string cls:string x:double y:double w:double h:double) {
        def el (EVGElement.createDiv())
        el.id = id
        el.className = cls
        el.setAttribute("position" "absolute")
        el.setAttribute("left" ((EVGDisplayList.num(x)) + "px"))
        el.setAttribute("top" ((EVGDisplayList.num(y)) + "px"))
        el.setAttribute("width" ((EVGDisplayList.num(w)) + "px"))
        el.setAttribute("height" ((EVGDisplayList.num(h)) + "px"))
        return el
    }

    sfn label:EVGElement (id:string cls:string words:string x:double y:double) {
        def el (EVGElement.createDiv())
        el.id = id
        el.className = cls
        el.textContent = words
        el.setAttribute("position" "absolute")
        el.setAttribute("left" ((EVGDisplayList.num(x)) + "px"))
        el.setAttribute("top" ((EVGDisplayList.num(y)) + "px"))
        return el
    }

    fn timeX:double (t:double dur:double) {
        if (dur <= 0.0) {
            return laneX
        }
        return (laneX + ((t / dur) * laneW))
    }

    fn chromeTree:EVGElement () {
        this.place()
        def root (EVGElement.createDiv())
        root.id = "root"
        if (mode == "present") {
            root.className = "present"
        } {
            root.className = "app"
        }
        root.setAttribute("width" ((EVGDisplayList.num(W)) + "px"))
        root.setAttribute("height" ((EVGDisplayList.num(H)) + "px"))
        if (mode == "present") {
            this.presentChrome(root)
            return root
        }
        ; the tabs over the editor pane: Ranger UI's TabsCtl, styled in pres.css
        def tabBar:EVGElement (PresApp.div("ed-tabs" "ed-tabs" tabRect.x tabRect.y tabRect.w tabRect.h))
        this.makeTabs()
        tabBar.addChild((unwrap tabs.rootEl))
        root.addChild(tabBar)
        root.addChild((PresApp.div("sep" "sep" sepRect.x sepRect.y sepRect.w sepRect.h)))
        root.addChild((PresApp.div("stage-area" "stage-area" stageArea.x stageArea.y stageArea.w stageArea.h)))
        root.addChild((PresApp.div("slide-shadow" "slide-shadow" (slideRect.x - 1.0) (slideRect.y - 1.0) (slideRect.w + 2.0) (slideRect.h + 2.0))))
        if ((deck.slideCount()) == 0) {
            root.addChild((PresApp.label("empty" "empty" "Kirjoita vasemmalle: ## Otsikko aloittaa dian" (stageArea.x + 24.0) (stageArea.y + 24.0))))
        }
        this.tracks(root)
        this.filmstrip(root)
        return root
    }

    fn tracks:void (root:EVGElement) {
        def r:PresRect trackRect
        def box:EVGElement (PresApp.div("tracks" "tracks" r.x r.y r.w r.h))
        root.addChild(box)
        if ((deck.slideCount()) == 0) {
            return
        }
        def s:PresSlide (deck.slideAt(selected))
        def dur:double s.duration
        def head:string ("Dia " + (to_string (selected + 1)) + " / " + (to_string (deck.slideCount())))
        if ((strlen s.title) > 0) {
            head = (head + " — " + s.title)
        }
        root.addChild((PresApp.label("tr-head" "track-head" head (r.x + 12.0) (r.y + 6.0))))
        root.addChild((PresApp.label("tr-time" "track-time" ((PresApp.secs((this.stageTime()))) + " / " + (PresApp.secs(dur))) ((r.x + r.w) - 110.0) (r.y + 6.0))))
        def rowY:double (r.y + 28.0)
        def rowH:double 26.0
        def names:[string] ([] _:string ("Teksti" "Puhe" "Animaatio"))
        def k:int 0
        while (k < 3) {
            def y:double (rowY + ((to_double k) * (rowH + 2.0)))
            root.addChild((PresApp.label(("tr-name" + (to_string k)) "track-name" (itemAt names k) (r.x + 12.0) (y + 5.0))))
            root.addChild((PresApp.div(("lane" + (to_string k)) "lane" laneX y laneW rowH)))
            k = (k + 1)
        }
        ; text: the groups, where they arrive
        def g:int 0
        while (g < (array_length s.groups)) {
            def gr:PresGroup (itemAt s.groups g)
            def x0:double (this.timeX(gr.at dur))
            def x1:double (this.timeX((gr.at + gr.seconds) dur))
            def w:double (x1 - x0)
            if (w < 44.0) { w = 44.0 }
            def cls:string "clip clip-text"
            def piece:EVGElement (PresApp.div(("grp" + (to_string g)) cls x0 (rowY + 3.0) w (rowH - 6.0)))
            root.addChild(piece)
            def name:string gr.label
            if (gr.step > 0) {
                name = ((to_string gr.step) + ". " + name)
            }
            root.addChild((PresApp.label(("grl" + (to_string g)) "clip-label" name (x0 + 5.0) (rowY + 7.0))))
            g = (g + 1)
        }
        ; speech
        def sy:double (rowY + (rowH + 2.0))
        if ((strlen s.audio) > 0) {
            root.addChild((PresApp.div("aud" "clip clip-audio" laneX (sy + 3.0) laneW (rowH - 6.0))))
            root.addChild((PresApp.label("audl" "clip-label" s.audio (laneX + 6.0) (sy + 7.0))))
        } {
            def hint:string "ei ääntä"
            if ((strlen s.notes) > 0) {
                hint = "muistiinpanot valmiina, ääni tulee vaiheessa 5"
            }
            root.addChild((PresApp.label("audl" "lane-hint" hint (laneX + 8.0) (sy + 7.0))))
        }
        ; animation: the transition in, the surface effect across
        def ay:double (rowY + ((rowH + 2.0) * 2.0))
        def ts:double (PresTimeline.transitionSeconds(s))
        if (ts > 0.0) {
            def tx1:double (this.timeX(ts dur))
            def tw:double (tx1 - laneX)
            if (tw < 44.0) { tw = 44.0 }
            root.addChild((PresApp.div("trn" "clip clip-anim" laneX (ay + 3.0) tw (rowH - 6.0))))
            root.addChild((PresApp.label("trnl" "clip-label" s.transition (laneX + 5.0) (ay + 7.0))))
        }
        def dg:int 0
        while (dg < (array_length s.diagrams)) {
            def du:PresDiaUse (itemAt s.diagrams dg)
            def dx0:double (this.timeX(du.start dur))
            def dx1:double (this.timeX((du.start + du.diagram.total) dur))
            root.addChild((PresApp.div(("dia" + (to_string dg)) "clip clip-dia" dx0 (ay + 3.0) (dx1 - dx0) (rowH - 6.0))))
            def dl:string "kaavio: piirto"
            if du.diagram.tour {
                dl = "kaavio: piirto + kierros"
            }
            root.addChild((PresApp.label(("dial" + (to_string dg)) "clip-label" dl (dx0 + 6.0) (ay + 7.0))))
            dg = (dg + 1)
        }
        if ((strlen s.fx) > 0) {
            def fx0:double (laneX + 90.0)
            root.addChild((PresApp.div("fxc" "clip clip-fx" fx0 (ay + 3.0) ((laneX + laneW) - fx0) (rowH - 6.0))))
            root.addChild((PresApp.label("fxl" "clip-label" ("fx: " + s.fx) (fx0 + 6.0) (ay + 7.0))))
        }
        ; the playhead
        def px:double (this.timeX((this.stageTime()) dur))
        root.addChild((PresApp.div("playhead" "playhead" (px - 1.0) (rowY - 4.0) 2.0 ((rowH + 2.0) * 3.0))))
    }

    sfn secs:string (t:double) {
        def tenths:int (to_int ((t * 10.0) + 0.5))
        def whole:int (idiv tenths 10)
        def frac:int (tenths - (whole * 10))
        return ((to_string whole) + "." + (to_string frac) + " s")
    }

    fn filmstrip:void (root:EVGElement) {
        def r:PresRect stripRect
        root.addChild((PresApp.div("strip" "strip" r.x r.y r.w r.h)))
        def i:int 0
        while (i < (deck.slideCount())) {
            def x:double (this.thumbX(i))
            if (this.thumbFits(x)) {
                def cls:string "thumb"
                if (i == selected) {
                    cls = "thumb thumb-on"
                }
                root.addChild((PresApp.div(("thumb" + (to_string i)) cls (x - 3.0) ((this.thumbY()) - 3.0) (thumbW + 6.0) (thumbH + 6.0))))
                root.addChild((PresApp.label(("tn" + (to_string i)) "thumb-num" (to_string (i + 1)) x (r.y + 4.0))))
            }
            i = (i + 1)
        }
    }

    fn presentChrome:void (root:EVGElement) {
        if (! speaker) {
            return
        }
        if ((deck.slideCount()) == 0) {
            return
        }
        def s:PresSlide (deck.slideAt(selected))
        def nx:double nextRect.x
        root.addChild((PresApp.label("sp-clock" "sp-clock" (PresApp.clockText(elapsed)) nx 18.0)))
        def where:string ("Dia " + (to_string (selected + 1)) + " / " + (to_string (deck.slideCount())))
        if (s.steps > 0) {
            where = (where + "  ·  askel " + (to_string pStep) + " / " + (to_string s.steps))
        }
        root.addChild((PresApp.label("sp-where" "sp-where" where (nx + 110.0) 24.0)))
        def ny:double ((nextRect.y + nextRect.h) + 18.0)
        if ((selected + 1) >= (deck.slideCount())) {
            ny = nextRect.y
            root.addChild((PresApp.label("sp-end" "sp-where" "Viimeinen dia" nx ny)))
            ny = (ny + 28.0)
        }
        def notes:string s.notes
        if ((strlen notes) == 0) {
            notes = "(ei muistiinpanoja)"
        }
        def box:EVGElement (PresApp.div("sp-notes" "sp-notes" nx ny nextRect.w ((H - ny) - 24.0)))
        box.textContent = notes
        root.addChild(box)
    }

    sfn clockText:string (s:double) {
        def total:int (to_int s)
        def m:int (idiv total 60)
        def sec:int (total - (m * 60))
        def ss:string (to_string sec)
        if (sec < 10) {
            ss = ("0" + ss)
        }
        return ((to_string m) + ":" + ss)
    }

    fn layoutChrome:EVGLayout () {
        def root:EVGElement (this.chromeTree())
        sheet.setViewport(W H false)
        sheet.applyTree(root "")
        def lay (new EVGLayout())
        lay.setPageSize(W H)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        lay.layout(root)
        chromeRoot = root
        return lay
    }

    fn chromeJson:string () {
        def lay:EVGLayout (this.layoutChrome())
        def root:EVGElement (unwrap chromeRoot)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(root)
        if (mode == "edit") {
            editor.focused = (focus == "editor")
            editor.layout.showLineNumbers = (edRect.w >= 360.0)
            editor.setBounds((to_int edRect.x) (to_int edRect.y) (to_int edRect.w) (to_int edRect.h))
            editor.paint(dl tr blink)
        }
        return ("{\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    fn revision:string () {
        def out:string (to_string chromeRev)
        out = (out + ":" + (to_string editor.buf.version))
        out = (out + ":" + (to_string editor.sel.caret.line) + "," + (to_string editor.sel.caret.col))
        out = (out + ":" + (to_string editor.sel.anchor.line) + "," + (to_string editor.sel.anchor.col))
        out = (out + ":" + (to_string editor.layout.scrollLine) + ":" + (to_string blink))
        out = (out + ":" + focus + ":" + mode + ":" + (EVGDisplayList.num(W)) + "x" + (EVGDisplayList.num(H)))
        return out
    }

    fn takeRequest:string () {
        if ((array_length requests) == 0) {
            return ""
        }
        def first:string (itemAt requests 0)
        remove_index requests 0
        return first
    }

    ; =========================================================================
    ; The pointer
    ; =========================================================================
    ; Where a press landed: "editor", "sep", "scrub", "thumb", "stage" or "".
    fn pointerDown:string (x:double y:double shift:boolean clicks:int) {
        this.place()
        if (mode == "present") {
            this.stageDown(x y)
            return "stage"
        }
        if (sepRect.has(x y)) {
            splitDrag = true
            return "sep"
        }
        if (tabRect.has(x y)) {
            def hitTab:string (this.tabAt(x))
            if ((strlen hitTab) > 0) {
                this.showTab(hitTab)
            }
            return "editor"
        }
        if (edRect.has(x y)) {
            def px:int (to_int x)
            def py:int (to_int y)
            if (clicks >= 3) {
                editor.selectLineAt(tr px py)
            } {
                if (clicks == 2) {
                    editor.selectWordAt(tr px py)
                } {
                    editor.pointerDown(tr px py shift)
                    editorDrag = true
                }
            }
            focus = "editor"
            this.syncEditor()
            chromeRev = (chromeRev + 1)
            return "editor"
        }
        if (trackRect.has(x y)) {
            if ((x >= laneX) && (x <= (laneX + laneW))) {
                if playing {
                    this.stop()
                }
                scrubDrag = true
                this.scrubTo(x)
                return "scrub"
            }
            return ""
        }
        if (stripRect.has(x y)) {
            def i:int 0
            while (i < (deck.slideCount())) {
                def tx:double (this.thumbX(i))
                if ((x >= tx) && (x <= (tx + thumbW))) {
                    if playing {
                        playing = false
                    }
                    this.selectSlide(i)
                    return "thumb"
                }
                i = (i + 1)
            }
            return ""
        }
        if (slideRect.has(x y)) {
            focus = "stage"
            this.stageDown(x y)
            chromeRev = (chromeRev + 1)
            return "stage"
        }
        return ""
    }

    ; A press on the stage is a click (on release, when the pointer has not
    ; moved) or a drag that pans a diagram's view.
    def stagePressed:boolean false
    def stagePanning:boolean false
    def stageDia:int -1
    def downX:double 0.0
    def downY:double 0.0
    def lastX:double 0.0
    def lastY:double 0.0

    fn stageDown:void (x:double y:double) {
        stagePressed = true
        stagePanning = false
        downX = x
        downY = y
        lastX = x
        lastY = y
        stageDia = -1
        if (slideRect.has(x y)) {
            this.slidePoint(x y)
            stageDia = (deck.diagramAt(selected spX spY))
        }
    }

    def dragSlop:double 6.0

    fn setDragSlop:void (px:double) {
        dragSlop = px
    }

    fn stageMove:void (x:double y:double) {
        if (stageDia < 0) {
            return
        }
        def hit@(optional):PresDiaUse (deck.diagramUse(selected stageDia))
        if (null? hit) {
            return
        }
        def u:PresDiaUse (unwrap hit)
        if (! stagePanning) {
            def mx:double (x - downX)
            def my:double (y - downY)
            if (((mx * mx) + (my * my)) < (dragSlop * dragSlop)) {
                return
            }
            stagePanning = true
            u.diagram.uiNow = deck.uiNow
            u.diagram.panStart()
        }
        def sc:double (this.slideScale())
        u.diagram.uiNow = deck.uiNow
        u.diagram.panBy(((x - lastX) / sc) ((y - lastY) / sc))
        lastX = x
        lastY = y
        chromeRev = (chromeRev + 1)
    }

    fn stageUp:void () {
        if (! stagePressed) {
            return
        }
        stagePressed = false
        if stagePanning {
            stagePanning = false
            return
        }
        if (mode == "present") {
            if (! (this.stagePress(downX downY))) {
                this.next()
            }
        } {
            this.stagePress(downX downY)
        }
        chromeRev = (chromeRev + 1)
    }

    fn scrubTo:void (x:double) {
        if ((deck.slideCount()) == 0) {
            return
        }
        def s:PresSlide (deck.slideAt(selected))
        def t:double (((x - laneX) / laneW) * s.duration)
        if (t < 0.0) { t = 0.0 }
        if (t >= s.duration) {
            localT = -1.0
        } {
            localT = t
        }
        chromeRev = (chromeRev + 1)
    }

    fn pointerMove:void (x:double y:double) {
        if splitDrag {
            def f:double (x / W)
            if (f < 0.2) { f = 0.2 }
            if (f > 0.7) { f = 0.7 }
            split = f
            chromeRev = (chromeRev + 1)
            return
        }
        if editorDrag {
            editor.pointerDrag(tr (to_int x) (to_int y))
            chromeRev = (chromeRev + 1)
            return
        }
        if scrubDrag {
            this.scrubTo(x)
        }
        if stagePressed {
            this.stageMove(x y)
        }
    }

    fn pointerUp:void () {
        if editorDrag {
            this.followCaret()
        }
        editorDrag = false
        splitDrag = false
        scrubDrag = false
        this.stageUp()
    }

    ; A wheel or a trackpad: mostly sideways over the editor scrolls it
    ; sideways, everything else goes where a vertical wheel goes.
    fn wheelXY:boolean (x:double y:double dx:double dy:double) {
        if (((mode != "present") && (edRect.has(x y))) && ((fabs dx) > (fabs dy))) {
            editor.scrollByX((to_int dx))
            chromeRev = (chromeRev + 1)
            return true
        }
        def d:double dy
        if ((fabs dx) > (fabs dy)) {
            d = dx
        }
        return (this.wheel(x y d))
    }

    fn wheel:boolean (x:double y:double dy:double) {
        if (mode == "present") {
            return false
        }
        if (edRect.has(x y)) {
            def lines:int (to_int (dy / 20.0))
            if (lines == 0) {
                lines = (? (dy < 0.0) -1 1)
            }
            editor.scrollBy((0 - lines))
            chromeRev = (chromeRev + 1)
            return true
        }
        if (stripRect.has(x y)) {
            stripScroll = (stripScroll + dy)
            def most:double (((to_double (deck.slideCount())) * (thumbW + thumbGap)) - (stripRect.w - 24.0))
            if (stripScroll > most) { stripScroll = most }
            if (stripScroll < 0.0) { stripScroll = 0.0 }
            chromeRev = (chromeRev + 1)
            return true
        }
        return false
    }

    ; Which tab is under x: its box as the chrome's last layout placed it.
    fn tabAt:string (x:double) {
        def i:int 0
        while (i < (array_length tabs.items)) {
            def it:UiItem (itemAt tabs.items i)
            def el:EVGElement (unwrap it.el)
            if ((x >= el.calculatedX) && (x <= (el.calculatedX + el.calculatedWidth))) {
                return it.value
            }
            i = (i + 1)
        }
        return ""
    }

    fn cursorAt:string (x:double y:double) {
        this.place()
        if (mode == "present") {
            return "default"
        }
        if (tabRect.has(x y)) {
            if ((strlen (this.tabAt(x))) > 0) {
                return "pointer"
            }
        }
        if (sepRect.has(x y)) {
            return "col-resize"
        }
        if (edRect.has(x y)) {
            return "text"
        }
        if (stripRect.has(x y)) {
            return "pointer"
        }
        if (trackRect.has(x y)) {
            if (x >= laneX) {
                return "ew-resize"
            }
        }
        return "default"
    }

    ; =========================================================================
    ; The keyboard
    ; =========================================================================
    sfn keyByName:int (name:string) {
        if (name == "backspace") { return (UIKey.backspace()) }
        if (name == "enter")     { return (UIKey.enter()) }
        if (name == "tab")       { return (UIKey.tab()) }
        if (name == "escape")    { return (UIKey.escape()) }
        if (name == "left")      { return (UIKey.left()) }
        if (name == "right")     { return (UIKey.right()) }
        if (name == "up")        { return (UIKey.up()) }
        if (name == "down")      { return (UIKey.down()) }
        if (name == "delete")    { return (UIKey.del()) }
        if (name == "home")      { return (UIKey.home()) }
        if (name == "end")       { return (UIKey.end()) }
        if (name == "pageUp")    { return (UIKey.pageUp()) }
        if (name == "pageDown")  { return (UIKey.pageDown()) }
        return 0
    }

    fn key:boolean (name:string shift:boolean ctrl:boolean) {
        if ((mode == "present") || (focus == "stage")) {
            if (this.diagramKey(name)) {
                return true
            }
        }
        if (mode == "present") {
            if ((((name == "right") || (name == "down")) || (name == "pageDown")) || (name == "enter")) {
                this.next()
                return true
            }
            if (((name == "left") || (name == "up")) || (name == "pageUp")) {
                this.prev()
                return true
            }
            if (name == "escape") {
                this.endPresent()
                return true
            }
            if (name == "home") {
                selected = 0
                pStep = 0
                clock = 0.0
                chromeRev = (chromeRev + 1)
                return true
            }
            return false
        }
        if (focus == "stage") {
            if ((name == "right") || (name == "down")) {
                this.selectSlide((selected + 1))
                return true
            }
            if ((name == "left") || (name == "up")) {
                this.selectSlide((selected - 1))
                return true
            }
            return false
        }
        if (focus != "editor") {
            return false
        }
        def code:int (PresApp.keyByName(name))
        if (code == 0) {
            return false
        }
        editor.handleKey(code shift ctrl)
        this.syncEditor()
        chromeRev = (chromeRev + 1)
        return true
    }

    fn text:void (s:string) {
        if ((mode == "present") || (focus == "stage")) {
            def asKey:string s
            if (s == " ") {
                asKey = "space"
            }
            if (this.diagramKey(asKey)) {
                return
            }
        }
        if (mode == "present") {
            if (s == " ") {
                this.next()
            }
            if ((s == "s") || (s == "S")) {
                speaker = (! speaker)
                chromeRev = (chromeRev + 1)
            }
            if ((s == "a") || (s == "A")) {
                auto = (! auto)
                chromeRev = (chromeRev + 1)
            }
            return
        }
        if (focus != "editor") {
            return
        }
        editor.handleText(s)
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn chord:boolean (ch:string) {
        if (mode == "present") {
            return false
        }
        if ((strlen ch) != 1) {
            return false
        }
        def took:boolean (editor.handleCtrlChar((charAt ch 0)))
        this.syncEditor()
        chromeRev = (chromeRev + 1)
        return took
    }

    ; ------------------------------------------------------------------
    ; Hints: what the value under the pointer is and could be
    ; ------------------------------------------------------------------
    ;
    ; `hintAt` answers for a point over the editor, `hintAtCaret` for the
    ; caret; both as PresHints' JSON with the value's box on the page added
    ; ("x", "y", "w", "h") and the line it is on ("line", "tab"). "" when
    ; there is nothing to say. `replaceRange` is how the page's popover
    ; writes a choice back: an ordinary edit, undone with Ctrl+Z.
    fn hintAt:string (x:double y:double) {
        if ((mode == "present") || ((edRect.has(x y)) == false)) {
            return ""
        }
        def px:int (to_int x)
        def py:int (to_int y)
        def hit:EditorPos (editor.layout.hitTest(tr editor.buf px py))
        ; over the text itself, not the empty space after a line's end
        def endX:int (editor.caretViewX(tr hit.line (strlen (editor.buf.lineAt(hit.line)))))
        if (px > (endX + 2)) {
            return ""
        }
        return (this.hintFor(hit.line hit.col))
    }

    fn hintAtCaret:string () {
        if (mode == "present") {
            return ""
        }
        return (this.hintFor(editor.sel.caret.line editor.sel.caret.col))
    }

    fn hintFor:string (line:int col:int) {
        if ((line < 0) || (line >= (editor.buf.lineCount()))) {
            return ""
        }
        def text:string (editor.buf.lineAt(line))
        def md:string "md"
        if (edTab == "css") {
            md = "css"
        }
        def j:string (PresHints.forLine(md text col (this.inFrontMatter(line))))
        if ((strlen j) == 0) {
            return ""
        }
        def st:int (?? (str2int (PresApp.jsonNum(j "start"))) 0)
        def en:int (?? (str2int (PresApp.jsonNum(j "end"))) st)
        def x0:int (editor.caretViewX(tr line st))
        def x1:int (editor.caretViewX(tr line en))
        def y0:int (editor.layout.caretPixelY(line))
        def extra:string (",\"line\":" + (to_string line) + ",\"tab\":\"" + edTab + "\",\"x\":" + (to_string x0) + ",\"y\":" + (to_string y0) + ",\"w\":" + (to_string (x1 - x0)) + ",\"h\":" + (to_string editor.layout.lineHeight) + ",\"text\":" + (PresHint.q(text)) + "}")
        return ((substring j 0 ((strlen j) - 1)) + extra)
    }

    ; The number after `"key":` in a flat JSON object.
    sfn jsonNum:string (j:string key:string) {
        def at:int (indexOf j ("\"" + key + "\":"))
        if (at < 0) {
            return ""
        }
        def a:int ((at + (strlen key)) + 3)
        def b:int a
        while ((b < (strlen j)) && ((((charAt j b) >= 48) && ((charAt j b) <= 57)) || ((charAt j b) == 45))) {
            b = (b + 1)
        }
        return (substring j a b)
    }

    ; Is the line inside the `---` front matter at the top?
    fn inFrontMatter:boolean (line:int) {
        if (edTab != "md") {
            return false
        }
        if ((editor.buf.lineCount()) == 0) {
            return false
        }
        if ((trim (editor.buf.lineAt(0))) != "---") {
            return false
        }
        def i:int 1
        while (i < (editor.buf.lineCount())) {
            if ((trim (editor.buf.lineAt(i))) == "---") {
                return ((line > 0) && (line < i))
            }
            i = (i + 1)
        }
        return false
    }

    ; Columns a..b of a line become `text`, as one edit.
    fn replaceRange:void (line:int a:int b:int text:string) {
        if ((line < 0) || (line >= (editor.buf.lineCount()))) {
            return
        }
        editor.moveCaret(line a false)
        editor.moveCaret(line b true)
        editor.insert(text)
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn undo:void () {
        editor.undo()
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn redo:void () {
        editor.redo()
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn copySelection:string () {
        return (editor.selectionText())
    }

    fn cutSelection:string () {
        def out:string (editor.cutSelection())
        this.syncEditor()
        chromeRev = (chromeRev + 1)
        return out
    }

    ; A picture the host stored, as markdown on its own line at the caret.
    fn insertPicture:void (path:string alt:string) {
        def line:string (editor.buf.lineAt(editor.sel.caret.line))
        def pre:string ""
        if ((strlen (trim line)) > 0) {
            editor.handleKey((UIKey.end()) false false)
            pre = "\n\n"
        } {
            ; an empty line right under a paragraph would still continue it
            def ln:int editor.sel.caret.line
            if (ln > 0) {
                def above:string (editor.buf.lineAt((ln - 1)))
                if ((strlen (trim above)) > 0) {
                    pre = "\n"
                }
            }
        }
        editor.handleText((pre + "![" + alt + "](" + path + ")\n"))
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    fn currentLine:string () {
        return (editor.buf.lineAt(editor.sel.caret.line))
    }

    fn caretCol:int () {
        return editor.sel.caret.col
    }

    fn caretLine:int () {
        return editor.sel.caret.line
    }

    fn anchorLine:int () {
        return editor.sel.anchor.line
    }

    fn anchorCol:int () {
        return editor.sel.anchor.col
    }

    fn hasSelection:boolean () {
        return (! (editor.sel.isCollapsed()))
    }

    fn setFocus:void (where:string) {
        if (where == focus) {
            return
        }
        focus = where
        chromeRev = (chromeRev + 1)
    }

    fn focusTarget:string () {
        return focus
    }

    fn setBlink:void (phase:int) {
        blink = phase
    }

    ; =========================================================================
    ; Exports
    ; =========================================================================
    ; The slides as PDF pages, through the markdown module's own print road
    ; (`MdToEvg.buildPrint`), with one addition: the pictures. The renderer
    ; reads a picture from disk unless it is handed the pixels, and a browser
    ; has no disk — so every picture the slides use is decoded from the byte
    ; store and registered under the name the page element carries.
    ; The deck as the stage draws it, one page per slide: the slide's own
    ; colours and type, and each diagram at rest in the holo style, in the
    ; direction the stage chose. It used to be the markdown module's print
    ; layout — white paper, which lost a dark theme's light text, and the
    ; plain diagram laid out as written, a strip on a long chain. A surface
    ; effect cannot be printed and leaves the slide's own colour.
    ; What the deck calls itself, for an exported file's name: the front
    ; matter's `title`, or the first heading when there is none, or "".
    fn docTitle:string () {
        def doc:MdNode deck.md.edit.doc
        def meta:MdMeta (MdFrontMatter.of(doc))
        def t:string (trim (meta.get("title" "")))
        if ((strlen t) > 0) {
            return t
        }
        def i:int 0
        while (i < (doc.childCount())) {
            def ch:MdNode (doc.childAt(i))
            if (ch.kind == "heading") {
                return (trim (ch.plainText()))
            }
            i = (i + 1)
        }
        return ""
    }

    fn pdf:buffer () {
        def mw:MarkdownWeb deck.md
        def e:MarkdownEdit mw.edit
        def l:MdLayout (deck.layout())
        def paper:string "#ffffff"
        if ((strlen l.style.pageBackground) > 0) {
            paper = l.style.pageBackground
        }
        def bg:EVGColor (EVGColor.parse(paper))
        def pw:double deck.pageW
        def ph:double deck.pageH
        def root:EVGElement (EVGListToElements.printRoot(pw ph))
        def section:EVGElement (EVGListToElements.sectionOf(root))
        deck.still = true
        def i:int 0
        while (i < (deck.slideCount())) {
            def groups:[int]
            def dl:EVGDisplayList (deck.slideList(i groups 0.0))
            section.addChild((EVGListToElements.pageFrom(dl pw ph bg true)))
            i = (i + 1)
        }
        deck.still = false
        def renderer (new EVGPDFRenderer())
        renderer.init(renderer)
        renderer.setPageSize(pw ph)
        if (mw.faceCount > 0) {
            renderer.setFontManager(mw.fontManager)
            if (!null? mw.measurer) {
                renderer.setMeasurer((unwrap mw.measurer))
            }
        }
        if e.haveImages {
            def k:int 0
            while (k < (array_length l.boxes)) {
                def b:MdBox (itemAt l.boxes k)
                if ((b.kind == 4) && ((strlen b.imagePath) > 0)) {
                    def bytes:buffer (e.imageStore.read(b.imagePath))
                    if ((buffer_length bytes) > 0) {
                        def pix@(optional):ImageBuffer (EVGImageDecode.decode(bytes))
                        if (!null? pix) {
                            renderer.registerImage(b.imagePath (unwrap pix))
                        }
                    }
                }
                k = (k + 1)
            }
        }
        return (renderer.render(root))
    }

    ; The deck through the markdown module's own PPTX road, then what the
    ; presentation adds on each slide: the speaker's notes, the transition,
    ; and a build step per `{.build}` item.
    fn pptx:buffer () {
        def d:PptxDeck (deck.md.buildDeck())
        def n:int (array_length d.pres.slides)
        ; slide points per stage unit
        def unit:double (d.pres.slideWidth / deck.pageW)
        def i:int 0
        while (i < n) {
            if (i < (deck.slideCount())) {
                def ps:PptxSlide (itemAt d.pres.slides i)
                def s:PresSlide (deck.slideAt(i))
                this.stillDiagrams(ps s unit)
                this.stillCharts(ps i unit)
                PresApp.dressSlide(ps s)
            }
            PresApp.fontsIn(((itemAt d.pres.slides i).shapes))
            i = (i + 1)
        }
        d.pres.theme.majorFont = "Arial"
        d.pres.theme.minorFont = "Arial"
        return (d.save())
    }

    ; The faces the stage draws with are shipped with the page, not with
    ; Keynote or PowerPoint: a file that names them opens with "missing font".
    ; Arial is on every Mac and every Windows machine, and it is narrower than
    ; Open Sans, so every line still fits the box it was measured for.
    sfn exportFont:string (f:string) {
        if ((strlen f) == 0) {
            return f
        }
        ; …and the generic "sans-serif" a chart's labels ask for, which comes
        ; out as Calibri or as a made-up face name
        def low:string (MdChar.lower(f))
        if (((indexOf low "sans") >= 0) || ((indexOf low "calibri") >= 0)) {
            return "Arial"
        }
        return f
    }

    sfn fontsInBody:void (body:PptxTextBody) {
        def p:int 0
        while (p < (array_length body.paragraphs)) {
            def para:PptxParagraph (itemAt body.paragraphs p)
            para.bulletFont = (PresApp.exportFont(para.bulletFont))
            def r:int 0
            while (r < (array_length para.runs)) {
                def run:PptxTextRun (itemAt para.runs r)
                run.fontFamily = (PresApp.exportFont(run.fontFamily))
                r = (r + 1)
            }
            p = (p + 1)
        }
    }

    sfn fontsIn:void (shapes:[PptxShape]) {
        def i:int 0
        while (i < (array_length shapes)) {
            def sh:PptxShape (itemAt shapes i)
            PresApp.fontsInBody(sh.text)
            def c:int 0
            while (c < (array_length sh.tableCells)) {
                def cell:PptxTableCell (itemAt sh.tableCells c)
                PresApp.fontsInBody(cell.body)
                c = (c + 1)
            }
            PresApp.fontsIn(sh.children)
            i = (i + 1)
        }
    }

    ; The diagrams as the stage draws them, at rest, in place of the markdown
    ; module's plain drawing: the glass nodes, the lines of light and the
    ; label pills, in the direction the stage chose and filling the room the
    ; stage gives them. The plain drawing is laid out at the fence's written
    ; direction and the column's width, so a long left-to-right chain came out
    ; as a strip with labels too small to keep. The group keeps the plain
    ; one's name, alt text and embedded source, so it still reads back.
    fn stillDiagrams:void (ps:PptxSlide s:PresSlide unit:double) {
        def l:MdLayout (deck.layout())
        def paper:string "#ffffff"
        if ((strlen l.style.pageBackground) > 0) {
            paper = l.style.pageBackground
        }
        def k:int 0
        while (k < (array_length s.diagrams)) {
            def u:PresDiaUse (itemAt s.diagrams k)
            def at:int -1
            def j:int 0
            while (j < (array_length ps.shapes)) {
                def sh:PptxShape (itemAt ps.shapes j)
                if ((at < 0) && (sh.embedSource == u.source)) {
                    at = j
                }
                j = (j + 1)
            }
            if (at >= 0) {
                def dl (new EVGDisplayList())
                u.diagram.paintStill(dl u.bx u.by u.bw u.bh l.style.textColor paper l)
                def conv (new PptxFromEvg())
                conv.unit = unit
                ; The stage reads small labels by zooming in; a still cannot,
                ; so a small label is kept rather than left an empty pill.
                conv.minFontPt = 1.0
                def group:PptxShape (conv.build(dl 0.0 0.0))
                if ((array_length group.children) > 0) {
                    PresApp.tighten(group)
                    def old:PptxShape (itemAt ps.shapes at)
                    group.name = old.name
                    group.altText = old.altText
                    group.embedNotation = old.embedNotation
                    group.embedSource = old.embedSource
                    group.mdSrcStart = old.mdSrcStart
                    group.mdSrcEnd = old.mdSrcEnd
                    set ps.shapes at group
                }
            }
            k = (k + 1)
        }
    }

    ; The charts as the stage draws them when they have finished (PresChart:
    ; the warm columns, the accent grid), in place of the markdown module's
    ; flat drawing, keeping its name, alt text and embedded source.
    fn stillCharts:void (ps:PptxSlide i:int unit:double) {
        def l:MdLayout (deck.layout())
        def boxes:[int] (deck.chartBoxes(i))
        def k:int 0
        while (k < (array_length boxes)) {
            def bi:int (itemAt boxes k)
            def b:MdBox (itemAt l.boxes bi)
            def at:int -1
            def j:int 0
            while (j < (array_length ps.shapes)) {
                def sh:PptxShape (itemAt ps.shapes j)
                if ((at < 0) && (sh.embedSource == b.embedSource)) {
                    at = j
                }
                j = (j + 1)
            }
            if (at >= 0) {
                def dl:EVGDisplayList (deck.chartStill(bi))
                def conv (new PptxFromEvg())
                conv.unit = unit
                conv.minFontPt = 1.0
                def group:PptxShape (conv.build(dl 0.0 0.0))
                if ((array_length group.children) > 0) {
                    PresApp.tighten(group)
                    def old:PptxShape (itemAt ps.shapes at)
                    group.name = old.name
                    group.altText = old.altText
                    group.embedNotation = old.embedNotation
                    group.embedSource = old.embedSource
                    group.mdSrcStart = old.mdSrcStart
                    group.mdSrcEnd = old.mdSrcEnd
                    set ps.shapes at group
                }
            }
            k = (k + 1)
        }
    }

    ; A group's box around what is in it, not from the slide's corner.
    sfn tighten:void (group:PptxShape) {
        def x0:double 1000000.0
        def y0:double 1000000.0
        def x1:double -1000000.0
        def y1:double -1000000.0
        def i:int 0
        while (i < (array_length group.children)) {
            def c:PptxShape (itemAt group.children i)
            if (c.x < x0) { x0 = c.x }
            if (c.y < y0) { y0 = c.y }
            if ((c.x + c.width) > x1) { x1 = (c.x + c.width) }
            if ((c.y + c.height) > y1) { y1 = (c.y + c.height) }
            i = (i + 1)
        }
        group.x = x0
        group.y = y0
        group.width = (x1 - x0)
        group.height = (y1 - y0)
        group.chX = x0
        group.chY = y0
        group.chW = group.width
        group.chH = group.height
    }

    sfn dressSlide:void (ps:PptxSlide s:PresSlide) {
        if ((strlen s.notes) > 0) {
            ps.notes.hasText = true
            PptxEditor.setBodyText(ps.notes.text (PresApp.speakable(s.notes)))
        }
        if ((s.transition != "none") && (s.index > 0)) {
            def tr:PptxTransition ps.transition
            tr.isSet = true
            tr.kind = "fade"
            if (s.transition == "slide") {
                tr.kind = "push"
                tr.dir = "l"
            }
            if (s.transition == "zoom") {
                tr.kind = "zoom"
            }
            tr.seconds = s.seconds
        }
        ; One build step per revealed group. The shape is the one the markdown
        ; module made from the group's source: by the source range when the
        ; shape carries one, otherwise by the paragraph whose words the group
        ; begins with (a list shape carries no range, and its items are its
        ; paragraphs). The writer finds a step's shape by `editId`, so each
        ; target gets one.
        def g:int 0
        while (g < (array_length s.groups)) {
            def gr:PresGroup (itemAt s.groups g)
            if (gr.step > 0) {
                PresApp.addBuild(ps gr (9000 + g))
            }
            g = (g + 1)
        }
    }

    sfn paraText:string (para:PptxParagraph) {
        def out:string ""
        def j:int 0
        while (j < (array_length para.runs)) {
            def run:PptxTextRun (itemAt para.runs j)
            out = (out + run.text)
            j = (j + 1)
        }
        return (trim out)
    }

    sfn addBuild:void (ps:PptxSlide gr:PresGroup editId:int) {
        def want:string (trim gr.label)
        if ((strlen want) > 12) {
            want = (substring want 0 12)
        }
        def k:int 0
        while (k < (array_length ps.shapes)) {
            def sh:PptxShape (itemAt ps.shapes k)
            def para:int -2
            if ((sh.mdSrcStart >= 0) && ((gr.start >= sh.mdSrcStart) && (gr.start < sh.mdSrcEnd))) {
                para = -1
            }
            if ((para == -2) && sh.hasText) {
                def p:int 0
                while (p < (array_length sh.text.paragraphs)) {
                    def words:string (PresApp.paraText((itemAt sh.text.paragraphs p)))
                    if (((strlen want) > 0) && ((indexOf words want) == 0)) {
                        para = p
                        break
                    }
                    p = (p + 1)
                }
            }
            if (para > -2) {
                if (sh.editId <= 0) {
                    sh.editId = editId
                }
                def b (new PptxBuildStep())
                b.editId = sh.editId
                b.kind = "fade"
                if (gr.anim == "fly") {
                    b.kind = "fly"
                    b.dir = "l"
                }
                b.seconds = gr.seconds
                b.paragraph = para
                push ps.build b
                return
            }
            k = (k + 1)
        }
    }

    ; Notes as a person reads them: the cue marks out.
    sfn speakable:string (notes:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen notes)
        while (i < n) {
            if (((i + 1) < n) && (((charAt notes i) == 91) && ((charAt notes (i + 1)) == 91))) {
                def rest:string (substring notes i n)
                def close:int (indexOf rest "]]")
                if (close > 0) {
                    i = ((i + close) + 2)
                    continue
                }
            }
            out = (out + (substring notes i (i + 1)))
            i = (i + 1)
        }
        return out
    }

    fn statusText:string () {
        def n:int (deck.slideCount())
        return ((to_string n) + " diaa · " + (PresApp.secs((PresTimeline.total(deck)))))
    }
}
