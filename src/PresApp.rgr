    ; --- editing together (a server of one's own: web/collab.js) --------------------
    ; The chat beside the deck: the page adds what arrives and posts what is
    ; sent ("chat-send" asks it to take it); "chat-closed" when it closed here.
    fn chatOpen:void (on:boolean) {
        panels.setChat(on)
        if on {
            review.closePanel()
            focus = "chat"
        } {
            if (focus == "chat") {
                focus = "editor"
            }
        }
        panelsKey = ""
        chromeRev = (chromeRev + 1)
    }

    fn chatIsOpen:boolean () {
        return panels.chat.open
    }

    ; -> false when the message was here already
    fn chatAdd:boolean (id:string who:string name:string color:string text:string time:string mine:boolean) {
        def added:boolean (panels.chat.add(id who name color text time mine))
        if (added && panels.chat.open) {
            panels.rebuild()
            chromeRev = (chromeRev + 1)
        }
        return added
