    ; review mode's layer, for the page to paint where `layerOrder` puts it
    fn reviewJson:string () {
        reviewBusy = false
        if ((review.on == false) || ((deck.slideCount()) == 0)) {
            return ""
        }
        if ((mode == "present") && ended) {
            return ""
        }
        this.place()
        this.reviewReady()
        reviewBusy = (review.pulse(deck.uiNow (this.reviewShow())))
        def dl:EVGDisplayList (review.displayList())
        return ("{\"x\":0,\"y\":0,\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    ; after a press or a key in review mode: the keys, a slide to go to, the
    ; file to write
    fn afterReview:void () {
        if (review.hasKeys()) {
            focus = "review"
        } {
            if (focus == "review") {
                focus = (? (mode == "present") "stage" "editor")
            }
        }
        if ((review.panelOpen()) && (mode != "present")) {
            if panels.helpOpen {
                panels.setHelp(false)
            }
            if panels.chat.open {
                panels.setChat(false)
                push requests "chat-closed"
            }
            if panels.callOpen {
                meet.panelOpen = false
                panels.setCall(false)
            }
        }
        if (review.wantSlide >= 0) {
            def to:int review.wantSlide
            review.wantSlide = -1
            this.showSlideForReview(to)
        }
        while ((array_length review.requests) > 0) {
            def rq:string (itemAt review.requests 0)
            if (rq == "review-copy-open") {
                review.clip = (this.reviewOpenMarkdown())
                rq = "review-copy"
            }
            push requests rq
            remove_index review.requests 0
        }
        chromeRev = (chromeRev + 1)
    }

    ; a slide shown whole: edited, it is selected; presenting, it is shown as
    ; it stands after its last step
    fn showSlideForReview:void (i:int) {
        if ((i < 0) || (i >= (deck.slideCount()))) {
            return
        }
        if (mode == "present") {
            ended = false
            selected = i
            this.viewReset()
            activeDia = -1
            def s:PresSlide (deck.slideAt(i))
            pStep = s.steps
            clock = ((PresTimeline.slideStart(deck i)) + s.duration)
            chromeRev = (chromeRev + 1)
        } {
            if playing {
                this.stop()
            }
            this.selectSlide(i)
        }
    }

    fn reviewKey:boolean (name:string shift:boolean ctrl:boolean) {
        def k:string (PresChartEditor.kitKey(name))
        if (name == "escape") {
            k = "Escape"
        }
        if (name == "enter") {
            k = "Enter"
        }
        if (name == "pageUp") {
            k = "PageUp"
        }
        if (name == "pageDown") {
            k = "PageDown"
        }
        if ((strlen k) == 0) {
            return false
        }
        review.key(k shift ctrl)
        this.afterReview()
        return true
    }

    fn setHelp:void (on:boolean) {
        panels.setHelp(on)
        if on {
            review.closePanel()
        }
        panelsKey = ""
        chromeRev = (chromeRev + 1)
    }

    fn helpIsOpen:boolean () {
