        def line:string (editor.buf.lineAt(editor.sel.caret.line))
        def pre:string ""
        if ((strlen (trim line)) > 0) {
            editor.handleKey((UIKey.end()) false false)
            pre = "\n\n"
        }
        editor.handleText((pre + text))
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

