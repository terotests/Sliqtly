    sfn skinEditor:void (ed:ScriptEditor s:string hue:double) {
        if (s == "retro") {
            PresApp.retroEditor(ed hue)
            return
        }
        if (s == "dark") {
            PresApp.darkEditor(ed)
            return
        }
        PresApp.lightEditor(ed)
    }

    ; The dark overlay of a light chrome sheet for a host applied with
    ; `theme` (EVGUI's UiDark.overlay): the page appends it to each sheet.
    ; What is drawn over the slide (the picked element's frame, the review
    ; bar) and the presenting screen keep their colours: they are read
    ; against the slide, which keeps its own theme.
    sfn darkCss:string (css:string theme:string) {
        return (UiDark.overlayKeep(css theme "sel- pick- rv- present"))
    }

    ; The editors in the retro skin: a dark display with phosphor text in the
    ; skin's hue (`--retro-hue`), numbers and attributes in amber.
    sfn hueColor:EVGColor (h:double s:double l:double a:double) {
        def c:EVGColor (EVGColor.hslToRgb(h s l))
        c.a = a
        return c
    }

