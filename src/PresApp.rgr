    ; The pick and its handles over the stage, as a display list ("" when
    ; there is nothing to draw).
    fn pickJson:string () {
        if (((mode == "present") || playing) || ((deck.slideCount()) == 0)) {
            return ""
        }
        this.pickValid()
        if (pick.hoverOn && (pick.hoverPage != selected)) {
            pick.hoverOn = false
        }
        if ((pick.on == false) && (pick.hoverOn == false)) {
            return ""
        }
        def root (EVGElement.createDiv())
        root.id = "pick"
        root.className = "pick-layer"
        root.setAttribute("width" ((EVGDisplayList.num(W)) + "px"))
        root.setAttribute("height" ((EVGDisplayList.num(H)) + "px"))
        pick.draw(root slideRect.x slideRect.y (this.slideScale()) stageArea.y stageArea.x (stageArea.x + stageArea.w))
        sheet.setViewport(W H coarse)
        sheet.applyTree(root skin)
        def lay (new EVGLayout())
        lay.setPageSize(W H)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        lay.layout(root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(root)
        return ("{\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    fn hintIsOpen:boolean () {
        return hint.isOpen
    }

    fn hintHas:boolean (x:double y:double) {
        return (hint.has(x y))
    }

    fn hintHasKeys:boolean () {
        return (hint.isOpen && (hint.hasKeys()))
    }

    ; What the popover asked for: its edits into the text, a close, a
    ; selector's property opened in its rule (with its own popover there).
    fn afterHint:void () {
        def i:int 0
        while (i < (array_length hint.edits)) {
            def e:PresHintEdit (itemAt hint.edits i)
            if (hint.tab == edTab) {
                this.replaceRange(e.line e.a e.b e.text)
                ; an emoji: the caret after it, as typing it would leave it
                if (hint.kind == "emoji") {
                    editor.moveCaret(e.line (e.a + (strlen e.text)) false)
                    this.syncEditor()
                }
            }
            i = (i + 1)
        }
        def none:[PresHintEdit]
        hint.edits = none
        if ((strlen hint.wantsFigColors) > 0) {
            def fcs:string hint.wantsFigColors
            hint.wantsFigColors = ""
            this.setThemeProp("figure" "colors" fcs)
        }
        if ((strlen hint.wantsLook) > 0) {
            def lk:string hint.wantsLook
            hint.wantsLook = ""
            if ((hint.tab == "md") && (edTab == "md")) {
                this.setDiagramLook(hint.line lk)
            }
        }
        if hint.wantsClose {
            hint.wantsClose = false
            this.closeHint()
        }
        if hint.wantsBack {
            hint.wantsBack = false
            this.closeHint()
            if (this.pickValid()) {
                this.pickStyle()
            }
        }
        if hint.wantsDoc {
            hint.wantsDoc = false
            this.closeHint()
            push requests "docset"
        }
        if ((strlen hint.wantsPic) > 0) {
            def act:string hint.wantsPic
            def path:string hint.picture
            hint.wantsPic = ""
            this.closeHint()
            if (act == "draw") {
                this.setSketching(true)
                return
            }
            if (act == "trace") {
                push requests ("image-trace:" + path)
            } {
                push requests ("image-edit:" + path)
            }
        }
        if ((strlen hint.wantsProp) > 0) {
            def parts:[string] (strsplit hint.wantsProp (strfromcode 9))
            def fromStage:boolean hintFromStage
            hint.wantsProp = ""
            this.closeHint()
            if ((array_length parts) >= 3) {
                this.helpEdit((itemAt parts 0) (itemAt parts 1) (itemAt parts 2))
                this.openHintAtCaret()
                if fromStage {
                    this.anchorHintAtStage((itemAt parts 0) true)
                }
            }
        }
        chromeRev = (chromeRev + 1)
    }

    ; The popover as a display list over the page: "" when it is closed.
    fn hintJson:string () {
        if ((hint.isOpen == false) || (mode == "present")) {
            return ""
        }
        hint.measurer = measurer
        if ((hint.w != W) || (hint.h != H)) {
            hint.w = W
            hint.h = H
            hint.rebuild()
        }
        def dl:EVGDisplayList (hint.displayList())
        return ("{\"x\":0,\"y\":0,\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    ; --- the files tab ---------------------------------------------------------------
    ; The list shows in the editor's place while no file is open in it.
    fn filesListShowing:boolean () {
        return ((edTab == "files") && ((strlen filePath) == 0))
    }

    fn placeFiles:void () {
        def on:boolean (((edTab == "files") && (mode == "edit")) && (edRect.w > 0.0))
        panels.measurer = measurer
        panels.setFiles(on edRect.x edRect.y edRect.w edRect.h filePath)
    }

    ; The page's list of the document's files.
    fn setFileList:void (json:string) {
        panels.setFilesData(json)
        chromeRev = (chromeRev + 1)
    }

    ; A file of the document, opened in the files tab's editor.
    fn openFile:void (path:string text:string) {
        filePath = path
        fileEditor.setLanguage((fileLangs.forPath(path)))
        fileEditor.init(text)
        fileSynced = fileEditor.buf.version
        this.showTab("files")
        focus = "editor"
        chromeRev = (chromeRev + 1)
    }

    fn chartFileBody:string () {
        return chartFileText
    }

    fn openFilePath:string () {
        return filePath
    }

    fn fileText:string () {
        return (fileEditor.text())
    }

    fn closeFile:void () {
        filePath = ""
        fileEditor.init("")
        fileSynced = fileEditor.buf.version
        chromeRev = (chromeRev + 1)
    }

    ; What a press in the files tab asked for: the tabs and the insertions
    ; are done here, the rest goes to the page (`files:<action>:<what>`).
    fn filesRequest:void (r:string) {
        if (r == "back") {
            this.closeFile()
            push requests "files-list"
            return
        }
        if ((indexOf r "tab:") == 0) {
            this.showTab((substring r 4 (strlen r)))
            return
        }
        if ((indexOf r "insert:") == 0) {
            def path:string (substring r 7 (strlen r))
            this.showTab("md")
            def lower:string (to_lowercase path)
            if ((indexOf lower ".json") > 0) {
                this.insertChartFile(path)
            } {
                def slash:int (PresPanels.lastSlash(path))
                def name:string (substring path (slash + 1) (strlen path))
                def dot:int (indexOf name ".")
                if (dot > 0) {
                    name = (substring name 0 dot)
                }
                this.insertPicture(path name)
            }
            return
        }
        push requests ("files:" + r)
    }

    ; A chart kept in a file, as a fence naming it, on its own line.
    fn insertChartFile:void (path:string) {
        def line:string (editor.buf.lineAt(editor.sel.caret.line))
        def pre:string ""
        if ((strlen (trim line)) > 0) {
            editor.handleKey((UIKey.end()) false false)
            pre = "\n\n"
        }
        editor.handleText((pre + "```vega-lite\n" + path + "\n```\n"))
        this.syncEditor()
        chromeRev = (chromeRev + 1)
    }

    ; --- the help panel, the share dialog, the toast --------------------------------
    fn setPanelsCss:void (css:string) {
        panels.css = css
        panels.rebuild()
        room.css = css
        room.changed()
        review.css = css
        review.changed()
    }

    ; =========================================================================
    ; Review mode (PresReviewUi): comments pinned to the slides
    ; =========================================================================
    ; on or off: the page turns it on in the editor, off in the viewer
    fn setReviewMode:void (on:boolean) {
        review.setOn(on)
        if ((on == false) && (focus == "review")) {
            focus = (? (mode == "present") "stage" "editor")
        }
        chromeRev = (chromeRev + 1)
    }

    fn reviewMode:boolean () {
        return review.on
    }

    ; the list of comments docked on the right (the rail's Review)
    fn reviewListOpen:boolean () {
        return ((review.on && review.listing) && (mode != "present"))
    }

    ; The rail's Review opens or closes the list; commenting itself (the
    ; pins, + Add comment) stays on whatever the list does.
    fn toggleReviewList:void () {
        if (review.on == false) {
            return
        }
        if review.listing {
            review.closePanel()
            if (focus == "review") {
                focus = "editor"
            }
        } {
            review.openList()
        }
        chromeRev = (chromeRev + 1)
    }

    ; a comment is being written: the page's keys go to it
    fn reviewHasKeys:boolean () {
        return (review.hasKeys())
    }

    ; who writes the comments made here: an id for the person, the name and
    ; colour shown, and a prefix for the ids made here (unique to the page)
    fn reviewSetMe:void (who:string name:string color:string prefix:string) {
        review.setMe(who name color prefix)
        chromeRev = (chromeRev + 1)
    }

    ; the page's clock: ms since 1970 and the time zone (minutes east of UTC)
    fn reviewClock:void (now:double zone:int) {
        review.nowMs = now
        review.zoneMin = zone
    }

    ; the deck's review/comments.json; `merge` unites it with what is here
    ; (a copy from elsewhere) instead of putting it in its place (a deck
    ; opened). "" is a deck without comments.
    fn reviewLoad:void (text:string merge:boolean) {
        if ((merge == false) && ((strlen text) == 0)) {
            review.reset()
        } {
            review.load(text merge)
        }
        reviewTitlesKey = ""
        chromeRev = (chromeRev + 1)
    }

    sfn rectJson:VlJson (x:double y:double w:double h:double) {
        def a:VlJson (VlJson.arrayValue())
        push a.arr (VlJson.numberValue(x))
        push a.arr (VlJson.numberValue(y))
        push a.arr (VlJson.numberValue(w))
        push a.arr (VlJson.numberValue(h))
        return a
    }

    ; the file to keep, after "review-save"
    fn reviewFile:string () {
        return (review.fileText())
    }

    fn reviewCount:int () {
        return (review.model.count())
    }

    ; The slides' titles to the review (threads follow their slides), and
    ; where the stage and the slide are now.
    def reviewSlide:int -1
    ; the pins pulse (or fade in): the page draws again each frame
    def reviewBusy:boolean false

    fn reviewReady:void () {
        ; presenting, a thread of another slide closes when the slide changes
        if (selected != reviewSlide) {
            reviewSlide = selected
            if ((mode == "present") && ((strlen review.openId) > 0)) {
                def ot@(optional):PresReviewThread (review.model.find(review.openId))
                if (!null? ot) {
                    def otv:PresReviewThread (unwrap ot)
                    if (otv.slide != selected) {
                        review.closePanel()
                    }
                }
            }
        }
        def key:string ((to_string mdEditor.buf.version) + ":" + (to_string (deck.slideCount())))
        if (key != reviewTitlesKey) {
            reviewTitlesKey = key
            def ts:[string]
            def i:int 0
            while (i < (deck.slideCount())) {
                def sl:PresSlide (deck.slideAt(i))
                push ts sl.title
                i = (i + 1)
            }
            review.setTitles(ts)
        }
        review.measurer = measurer
        review.skin = skin
        this.reviewSpots()
        def pres:boolean (mode == "present")
        if pres {
            review.place(W H 0.0 true selected slideRect.x slideRect.y slideRect.w slideRect.h 0.0 W H)
        } {
            review.shift = (0.0 - ((sketch.barW + 8.0) * 0.5))
            review.place(W H barH false selected slideRect.x slideRect.y slideRect.w slideRect.h stageArea.x stageArea.w (stageArea.y + stageArea.h))
        }
    }

    ; A comment pinned on a diagram is a point of the diagram: where the
    ; diagram's camera shows it now, or nowhere when it is out of view. A
    ; draft placed on one is given its point first.
    fn reviewSpots:void () {
        review.clearSpots()
        if (((selected < 0) || (selected >= (deck.slideCount()))) || ((deck.pageW <= 0.0) || (deck.pageH <= 0.0))) {
            return
        }
        def t:double (this.stageTime())
        def pw:double deck.pageW
        def ph:double deck.pageH
        ; a pin dropped somewhere else: on the diagram (and its box) under it,
        ; if any
        if ((strlen review.moveAsk) > 0) {
            def mid:string review.moveAsk
            review.moveAsk = ""
            def mh@(optional):PresReviewThread (review.model.find(mid))
            if (!null? mh) {
                def mt:PresReviewThread (unwrap mh)
                if (mt.slide == selected) {
                    def ma:[double] (this.reviewAnchorAt(t (mt.x * pw) (mt.y * ph)))
                    if ((array_length ma) == 4) {
                        def mdu@(optional):PresDiaUse (deck.diagramUse(selected (floor (itemAt ma 0))))
                        if (!null? mdu) {
                            def mu:PresDiaUse (unwrap mdu)
                            review.model.anchor(mid (floor (itemAt ma 0)) (mu.diagram.nodeIdAt((floor (itemAt ma 1)))) (itemAt ma 2) (itemAt ma 3))
                        }
                    }
                }
                review.save()
            }
        }
        if review.draftAsk {
            review.draftAsk = false
            if (review.draftSlide == selected) {
                def a:[double] (this.reviewAnchorAt(t (review.draftX * pw) (review.draftY * ph)))
                if ((array_length a) == 4) {
                    def k:int (floor (itemAt a 0))
                    def hit@(optional):PresDiaUse (deck.diagramUse(selected k))
                    if (!null? hit) {
                        def du:PresDiaUse (unwrap hit)
                        review.draftDia = k
                        review.draftNode = (du.diagram.nodeIdAt((floor (itemAt a 1))))
                        review.draftAX = (itemAt a 2)
                        review.draftAY = (itemAt a 3)
                    }
                }
            }
        }
        def out:[double]
        if ((review.drafting && (review.draftSlide == selected)) && (review.draftDia >= 0)) {
            def dh@(optional):PresDiaUse (deck.diagramUse(selected review.draftDia))
            if (!null? dh) {
                def dd:PresDiaUse (unwrap dh)
                def seen:boolean (dd.diagram.anchorPoint((t - dd.start) dd.bx dd.by dd.bw dd.bh review.draftNode review.draftAX review.draftAY out))
                if ((array_length out) == 2) {
                    review.setSpot("rv-draft" ((itemAt out 0) / pw) ((itemAt out 1) / ph) seen)
                }
            }
        }
        for review.model.threads th:PresReviewThread i {
            if ((th.slide == selected) && (th.dia >= 0)) {
                def uh@(optional):PresDiaUse (deck.diagramUse(selected th.dia))
                if (!null? uh) {
                    def u:PresDiaUse (unwrap uh)
                    def on:boolean (u.diagram.anchorPoint((t - u.start) u.bx u.by u.bw u.bh th.node th.ax th.ay out))
                    if ((array_length out) == 2) {
                        review.setSpot(th.id ((itemAt out 0) / pw) ((itemAt out 1) / ph) on)
                    }
                }
            }
        }
    }

    ; The diagram under a point of the selected slide (slide units) at time
    ; `t`: [its index, the node's index (-1 none), u, v], empty when none.
    fn reviewAnchorAt:[double] (t:double px:double py:double) {
        def r:[double]
        def k:int (deck.diagramAt(selected px py))
        def hit@(optional):PresDiaUse (deck.diagramUse(selected k))
        if (null? hit) {
            return r
        }
        def du:PresDiaUse (unwrap hit)
        def a:[double] (du.diagram.anchorAt((t - du.start) du.bx du.by du.bw du.bh px py))
        if ((array_length a) == 3) {
            push r (to_double k)
            push r (itemAt a 0)
            push r (itemAt a 1)
            push r (itemAt a 2)
        }
        return r
    }

    ; The open comments with the Markdown of the slides they are on, for the
    ; clipboard (PresReview.openMarkdown): a slide's Markdown is its section.
    ; where each slide's section starts in the Markdown (-1: none)
    fn reviewSectionStarts:[int] () {
        def src:string (this.source())
        def l:MdLayout (deck.layout())
        def secs:[PresPickSection] (PresPick.sections(src l.splitLevel))
        def starts:[int]
        def i:int 0
        while (i < (deck.slideCount())) {
            def k:int (PresPick.sectionAt(secs (this.spanFrom(i))))
            if (k >= 0) {
                def sec:PresPickSection (itemAt secs k)
                push starts sec.start
            } {
                push starts -1
            }
            i = (i + 1)
        }
        return starts
    }

    fn reviewOpenMarkdown:string () {
        def src:string (this.source())
        def l:MdLayout (deck.layout())
        def secs:[PresPickSection] (PresPick.sections(src l.splitLevel))
        def sources:[string]
        def i:int 0
        while (i < (deck.slideCount())) {
            def k:int (PresPick.sectionAt(secs (this.spanFrom(i))))
            if (k >= 0) {
                def sec:PresPickSection (itemAt secs k)
                push sources (substring src sec.start sec.end)
            } {
                push sources ""
            }
            i = (i + 1)
        }
        def name:string ""
        if ((deck.slideCount()) > 0) {
            def first:PresSlide (deck.slideAt(0))
            name = first.title
        }
        return (review.model.openMarkdown(name review.titles sources))
    }

    ; the deck's Markdown with the open comments in it as footnotes
    fn reviewMarkdownWithComments:string () {
        return (review.model.markdownWithComments((this.source()) (this.reviewSectionStarts()) review.titles false))
    }

    ; The Markdown of these slides (the sections they are in, under the
    ; front matter), with the open comments on them as footnotes when
    ; `notes`.
    fn slidesMarkdown:string (pages:[int] notes:boolean) {
        def src:string (this.source())
        def l:MdLayout (deck.layout())
        def secs:[PresPickSection] (PresPick.sections(src l.splitLevel))
        def want:[boolean]
        for secs s0:PresPickSection i0 {
            push want false
        }
        for pages p:int ip {
            if ((p >= 0) && (p < (deck.slideCount()))) {
                def k:int (PresPick.sectionAt(secs (this.spanFrom(p))))
                if (k >= 0) {
                    set want k true
                }
            }
        }
        def keys:string ""
        for secs s1:PresPickSection i1 {
            if (itemAt want i1) {
                if ((strlen keys) > 0) {
                    keys = (keys + ",")
                }
                keys = (keys + s1.key)
            }
        }
        def text:string (PresPick.viewText(src l.splitLevel keys))
        if ((notes == false) || ((strlen text) == 0)) {
            return text
        }
        ; the sections kept are there in the same order: the j-th one kept
        ; starts where the j-th section of `text` does
        def sub:[PresPickSection] (PresPick.sections(text l.splitLevel))
        def pos:[int]
        def j:int 0
        for secs s2:PresPickSection i2 {
            def at:int -1
            if ((itemAt want i2) && (j < (array_length sub))) {
                def sj:PresPickSection (itemAt sub j)
                at = sj.start
                j = (j + 1)
            }
            push pos at
        }
        def starts:[int]
        def i:int 0
        while (i < (deck.slideCount())) {
            def k2:int (PresPick.sectionAt(secs (this.spanFrom(i))))
            if (k2 >= 0) {
                push starts (itemAt pos k2)
            } {
                push starts -1
            }
            i = (i + 1)
        }
        return (review.model.markdownWithComments(text starts review.titles true))
    }

    ; What Copy puts on the clipboard: "md" the deck's Markdown, "mdc" with
    ; the open comments as footnotes, "comments" the open comments with
    ; their slides; "mdSlide"/"mdcSlide" the selected slide's, and
    ; "mdPicked"/"mdcPicked" the picked slides'.
    fn copyText:string (which:string) {
        ; the slides' titles, for the comments' labels
        this.reviewReady()
        if (which == "mdc") {
            return (this.reviewMarkdownWithComments())
        }
        if (which == "comments") {
            return (this.reviewOpenMarkdown())
        }
        if ((which == "mdSlide") || (which == "mdcSlide")) {
            def one:[int]
            push one selected
            return (this.slidesMarkdown(one (which == "mdcSlide")))
        }
        if ((which == "mdPicked") || (which == "mdcPicked")) {
            return (this.slidesMarkdown(picks.pages (which == "mdcPicked")))
        }
        return (this.source())
    }

    ; the text a copy in review mode put aside ("review-copy")
    fn reviewClip:string () {
        return review.clip
    }

    ; How much of the pins shows: while the slide plays they wait until
    ; everything on it has arrived (`settled`), then come in over 0.4 s.
    fn reviewShow:double () {
        if ((this.isPlaying()) == false) {
            return 1.0
        }
        def sl:PresSlide (deck.slideAt(selected))
        def local:double (clock - (PresTimeline.slideStart(deck selected)))
        def f:double ((local - sl.settled) / 0.4)
        if (f < 0.0) {
            return 0.0
        }
        if (f > 1.0) {
            return 1.0
        }
        return f
    }

    ; --- drawing on the slide (PresSketchUi) ------------------------------------------

    fn setSketching:void (on:boolean) {
        if (on && (mode == "present")) {
            return
        }
        sketch.setActive(on)
        if on {
            this.dropPicks()
            focus = "sketch"
            this.sketchPlace()
        } {
            sketch.close((this.sketchModel()))
            this.afterSketch()
        }
        chromeRev = (chromeRev + 1)
    }

    fn sketching:boolean () {
        return (sketch.on && (mode != "present"))
    }

    ; The slide's drawing: the first it refers to, the one begun on it, or
    ; none ("").
    fn sketchPathOf:string (i:int) {
        if ((i < 0) || (i >= (deck.slideCount()))) {
            return ""
        }
        def sl:PresSlide (deck.slideAt(i))
        if ((array_length sl.sketches) > 0) {
            def u:PresSketchUse (itemAt sl.sketches 0)
            return u.path
        }
        if ((deck.newSketchSlide == i) && ((strlen deck.newSketchPath) > 0)) {
            return deck.newSketchPath
        }
        return ""
    }

    ; The pill at the foot of the stage: beside review mode's bar (the two in
    ; the middle together), or in the middle by itself.
    fn sketchPlace:void () {
        this.place()
        sketch.bar = ((mode != "present") && ((deck.slideCount()) > 0))
        def foot:double (stageArea.y + stageArea.h)
        sketch.barY = ((foot - sketch.barH) - 12.0)
        sketch.barX = ((stageArea.x + (stageArea.w * 0.5)) - (sketch.barW * 0.5))
        if (review.on && (review.barW > 0.0)) {
            sketch.barX = ((review.barX()) + review.barW + 8.0)
        }
        sketch.place(W H slideRect.x slideRect.y slideRect.w slideRect.h (this.slideScale()) stageArea.x stageArea.y stageArea.w stageArea.h)
        sketch.showSlide(selected (this.sketchPathOf(selected)))
        sketch.css = panels.css
        sketch.skin = skin
        sketch.measurer = measurer
    }

    ; The drawing being edited (an empty one stands in on a slide without).
    fn sketchModel:PresSketch () {
        if ((strlen sketch.path) == 0) {
            sketchScratch.w = deck.pageW
            sketchScratch.h = deck.pageH
            return sketchScratch
        }
        return (deck.sketchFor(sketch.path))
    }

    fn sketchPress:void (x:double y:double clicks:int) {
        this.sketchPlace()
        if (sketch.pressPalette(x y (this.sketchModel()))) {
            this.afterSketch()
            return
        }
        ; a press beside an open menu only closes it
        if (sketch.menuOpen()) {
            sketch.closeMenu()
            chromeRev = (chromeRev + 1)
            return
        }
        if (sketch.on == false) {
            return
        }
        ; the first line or text on a slide without a drawing begins one
        if (((strlen sketch.path) == 0) && ((sketch.tool()) != "select")) {
            def np:string (this.newSketchPath(selected))
            deck.sketchFor(np)
            deck.newSketchPath = (PresDeck.sketchKey(np))
            deck.newSketchSlide = selected
            sketch.path = deck.newSketchPath
        }
        sketch.pressSlide(x y clicks (this.sketchModel()))
        this.afterSketch()
    }

    fn afterSketch:void () {
        def rs:[string] sketch.requests
        def none:[string]
        sketch.requests = none
        def i:int 0
        while (i < (array_length rs)) {
            def r:string (itemAt rs i)
            if (r == "sketch-save") {
                this.sketchSave()
            }
            if (r == "sketch-on") {
                this.dropPicks()
                focus = "sketch"
            }
            if (r == "sketch-done") {
                if (focus == "sketch") {
                    focus = "editor"
                }
            }
            i = (i + 1)
        }
        PresTimeline.planAll(deck)
        chromeRev = (chromeRev + 1)
    }

    ; The drawing changed: the slide refers to it (the line is added when
    ; it does not), and the page writes its file.
    fn sketchSave:void () {
        this.sketchSync(sketch.path)
    }

    ; The drawing at `path` (on the selected slide) as it is now: one with
    ; something in it is referred to from the slide (the line is added when
    ; it is not), an emptied one is not (its line is removed; it stays the
    ; slide's drawing to go on with, and comes back with what is drawn or
    ; undone into it); the page writes its file.
    fn sketchSync:void (path:string) {
        if ((strlen path) == 0) {
            return
        }
        def name:string (substring path 1 (strlen path))
        def empty:boolean (((deck.sketchFor(path)).count()) == 0)
        if empty {
            if (this.sketchUnref(selected name)) {
                deck.newSketchPath = path
                deck.newSketchSlide = selected
                sketch.path = path
            }
        } {
            if ((deck.newSketchSlide == selected) && (deck.newSketchPath == path)) {
                def sl:PresSlide (deck.slideAt(selected))
                if ((array_length sl.sketches) == 0) {
                    this.sketchRef(selected name)
                }
                deck.newSketchPath = ""
                deck.newSketchSlide = -1
            }
        }
        push requests ("sketch-file:" + name)
    }

    ; The line referring to drawing `path` removed from slide i, as one edit
    ; of the Markdown; false when the slide has none.
    fn sketchUnref:boolean (i:int path:string) {
        this.slideLines(i)
        if (linesFrom < 0) {
            return false
        }
        def lines:[string]
        def k:int linesFrom
        while (k < linesAt) {
            push lines (mdEditor.buf.lineAt(k))
            k = (k + 1)
        }
        def span:[int] (PresSketch.refSpan(lines path))
        if ((itemAt span 0) < 0) {
            return false
        }
        def from:int (linesFrom + (itemAt span 0))
        def last:int (linesFrom + (itemAt span 1))
        ; the caret stays where it was in the text around the lines
        def cl:int mdEditor.sel.caret.line
        def cc:int mdEditor.sel.caret.col
        this.replaceLines(from last "")
        if (cl > last) {
            cl = (cl - ((last - from) + 1))
        } {
            if (cl >= from) {
                cl = (from - 1)
                if (cl < 0) {
                    cl = 0
                }
                cc = (strlen (mdEditor.buf.lineAt(cl)))
            }
        }
        mdEditor.moveCaret(cl cc false)
        this.syncEditor()
        return true
    }

    ; What the page writes to the drawing's file.
    fn sketchFileBody:string (path:string) {
        return ((deck.sketchFor(path)).toJson())
    }

    fn sketchUndo:void () {
        def u:string (sketch.takeUndo())
        def at:int (indexOf u "\n")
        if (at <= 0) {
            return
        }
        def path:string (substring u 0 at)
        deck.setSketch(path (substring u (at + 1) (strlen u)))
        this.sketchSync(path)
        PresTimeline.planAll(deck)
        chromeRev = (chromeRev + 1)
    }

    ; A file name for slide i's drawing: drawings/<its id or title>.ink,
    ; numbered when taken.
    fn newSketchPath:string (i:int) {
        def base:string ""
        if ((i >= 0) && (i < (deck.slideCount()))) {
            def sl:PresSlide (deck.slideAt(i))
            base = (PresApp.slug(sl.id))
            if ((strlen base) == 0) {
                base = (PresApp.slug(sl.title))
            }
        }
        if ((strlen base) == 0) {
            base = ("slide-" + (to_string (i + 1)))
        }
        def p:string ("drawings/" + base + ".ink")
        def n:int 2
        while (deck.hasSketch(p)) {
            p = ("drawings/" + base + "-" + (to_string n) + ".ink")
            n = (n + 1)
        }
        return p
    }

    ; Lower-case letters and digits, the rest one "-"; at most 40.
    sfn slug:string (t:string) {
        def out:string ""
        def dash:boolean false
        def low:string (to_lowercase t)
        def i:int 0
        while ((i < (strlen low)) && ((strlen out) < 40)) {
            def c:int (charAt low i)
            ; ä å → a, ö → o
            if ((c == 228) || (c == 229)) {
                c = 97
            }
            if (c == 246) {
                c = 111
            }
            if (((c >= 97) && (c <= 122)) || ((c >= 48) && (c <= 57))) {
                if (dash && ((strlen out) > 0)) {
                    out = (out + "-")
                }
                out = (out + (strfromcode c))
                dash = false
            } {
                dash = true
            }
            i = (i + 1)
        }
        return out
    }

    ; `![](path)` on slide i, after its last block (before its notes), as
    ; one edit of the Markdown.
    fn sketchRef:void (i:int path:string) {
        this.slideLines(i)
        if (linesFrom < 0) {
            return
        }
        def last:int linesFrom
        def k:int linesFrom
        def going:boolean true
        while (going && (k < linesAt)) {
            def ln:string (trim (mdEditor.buf.lineAt(k)))
            if ((k > linesFrom) && ((indexOf ln ":::") == 0)) {
                going = false
            } {
                if ((strlen ln) > 0) {
                    last = k
                }
                k = (k + 1)
            }
        }
        def cl:int mdEditor.sel.caret.line
        def cc:int mdEditor.sel.caret.col
        def after:string ""
        if ((last + 1) < (mdEditor.buf.lineCount())) {
            if ((strlen (trim (mdEditor.buf.lineAt((last + 1))))) > 0) {
                after = "\n"
            }
        }
        mdEditor.moveCaret(last (strlen (mdEditor.buf.lineAt(last))) false)
        mdEditor.insert(("\n\n![](" + path + ")" + after))
        if (cl > last) {
            cl = (cl + 2)
        }
        mdEditor.moveCaret(cl cc false)
        this.syncEditor()
    }

    fn sketchCursor:string (x:double y:double) {
        if ((strlen (sketch.paletteAt(x y))) > 0) {
            return "pointer"
        }
        if sketch.dragging {
            return "grabbing"
        }
        def t:string (sketch.tool())
        if (t == "select") {
            def m:PresSketch (this.sketchModel())
            if ((m.hit((sketch.toX(x)) (sketch.toY(y)) (6.0 / sketch.sc))) >= 0) {
                return "move"
            }
            return "default"
        }
        if (t == "text") {
            return "text"
        }
        return "crosshair"
    }

    ; The drawing's layer: the palette, what is picked, the caret.
    fn sketchJson:string () {
        if ((mode == "present") || ((deck.slideCount()) == 0)) {
            return ""
        }
        this.sketchPlace()
        def m:PresSketch (this.sketchModel())
        def l:MdLayout (deck.layout())
        m.measure(l.engine l.style.bodyFamily)
        def dl:EVGDisplayList (sketch.displayList(m ((blink % 2) == 0)))
        return ("{\"x\":0,\"y\":0,\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    ; =========================================================================
    ; A room's chat (PresRoomView): the work area right of the rail
    ; =========================================================================
    fn placeRoom:void () {
        def L:double (this.leftW())
        ; Rooms over the page: the chat beside it while that leaves a chat
        ; to read, else under it until Rooms is closed
        if ((this.roomsOver()) && ((W - toolbar.roomsW) >= 320.0)) {
            L = toolbar.roomsW
        }
        def top:double barH
        def rw:double ((W - L) - (this.dockW()))
        if (rw < 320.0) {
            rw = (W - L)
        }
        room.place(L top rw (H - top) W H)
        room.measurer = measurer
        if (room.skin != skin) {
            room.skin = skin
            room.changed()
        }
    }

    fn roomJson:string () {
        if ((room.open == false) || (mode == "present")) {
            return ""
        }
        this.placeRoom()
        def dl:EVGDisplayList (room.displayList())
        return ("{\"x\":0,\"y\":0,\"width\":" + (EVGDisplayList.num(W)) + ",\"height\":" + (EVGDisplayList.num(H)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    fn roomHasKeys:boolean () {
        return (((focus == "room") && (room.hasKeys())) && (mode != "present"))
    }

    fn roomKey:boolean (name:string shift:boolean ctrl:boolean) {
        def k:string (PresChartEditor.kitKey(name))
        if (name == "pageUp") {
            k = "PageUp"
        }
        if (name == "pageDown") {
            k = "PageDown"
        }
        if (name == "tab") {
            k = "Tab"
        }
        if ((strlen k) == 0) {
            return false
        }
        room.key(k shift ctrl)
        this.afterRoom()
        return true
    }

    ; after a press, a key or the wheel in the channel: who has the keys,
    ; and what the reader asked for, to the page ("roomchat:<request>")
    fn afterRoom:void () {
        if (room.hasKeys()) {
            focus = "room"
        } {
            if (focus == "room") {
                focus = "editor"
            }
        }
        def r:string (room.take())
        while ((strlen r) > 0) {
            push requests ("roomchat:" + r)
            r = (room.take())
        }
        chromeRev = (chromeRev + 1)
    }

    ; --- the page's side ---------------------------------------------------------
    ; The channel of room `id` opens (or shows another room); `notice` is a
    ; line under its head ("" none).
    fn roomChatShow:void (id:string title:string about:string readOnly:boolean notice:string) {
        room.css = panels.css
        room.show(id title about readOnly notice)
        focus = "room"
        room.ch.keys = "main"
        chromeRev = (chromeRev + 1)
