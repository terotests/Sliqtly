    ; --- the deck's call (PresMeet; the page's web/meet.js does the audio) ---------
    ; The page names this page's client, hands in the server's tellings and
    ; the loudness it hears, and takes the "meet:" requests.
    fn meetClient:void (c:string) {
        meet.setClient(c)
    }

    ; -> whether the bar or the panel changed
    fn meetMembers:boolean (rows:string) {
        def changed:boolean (meet.setMembers(rows))
        this.meetSync()
        return changed
    }

    fn meetLevel:boolean (c:string l:double now:double) {
        def changed:boolean (meet.level(c l now))
        if changed {
            this.meetRebuild()
        }
        return changed
    }

    fn meetTick:boolean (now:double) {
        def changed:boolean (meet.tick(now))
        if changed {
            this.meetRebuild()
        }
        return changed
    }

    fn meetButton:string () {
        return (meet.buttonLabel())
    }

    fn meetState:string () {
        return meet.state
