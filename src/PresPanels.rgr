; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresPanels.rgr — the help panel, the share dialog and the toast, in EVGUI
; ============================================================================
;
; What the page used to draw in HTML around the canvas, drawn on it in the
; EVGUI playground's look (web/panels.css over the kit's theme):
;
;   help    docked on the right under the bar: what the selected slide is
;           made of (PresApp.slideHelp's JSON), the theme rules that draw
;           each part at their values now; a property opens in the theme
;   share   a modal card with the two links (presenting / editing), each
;           with a copy button
;   toast   a short line at the bottom, taken away by the page's timer
;   chat    docked on the right like help (one of the two at a time): the
;           deck's conversation on a server of one's own (EVGUI ChatCtl);
;           the page adds the messages and posts what is sent
;   call    the people in the deck's call (EVGUI ParticipantsCtl, PresMeet
;           holds it), docked on the right above the chat; a press on its
;           buttons is "call-press\t<target>" for PresMeet
;
; Like the bar, the panels do not act themselves: a press is a request
; ("help:<sel>\t<prop>\t<default>", "copy:show", "copy:edit") the app or
; the page acts on. The links come from the page (`openShare`), which also
; does the copying, since the clipboard is the browser's.
; ============================================================================

Import "PresInvite.rgr"
Import "../evgui/src/UiHost.rgr"
Import "UiKit.rgr"
Import "../evgui/src/ChatCtl.rgr"
Import "../evgui/src/ParticipantsCtl.rgr"
Import "../evgui/src/PaginationCtl.rgr"
Import "../evgui/src/UiPick.rgr"
Import "../vela/src/VlJson.rgr"
Import "PresI18n.rgr"
Import "PresImport.rgr"
Import "PresHelp.rgr"

; A select that says what it is for while nothing is chosen. SelectCtl draws
; the chosen item's label in its trigger, so a prompt there used to be a
; disabled first item, which then showed up as a row in the open list.
class PresPromptSelect extends SelectCtl {
    def prompt:string ""

    fn labelOf:string (v:string) {
        if ((this.indexOfValue(v)) < 0) {
            return prompt
        }
        def it:UiItem (itemAt items (this.indexOfValue(v)))
        return it.name
    }
}

class PresPanels {
    def host:UiHost (new UiHost())
    def css:string ""
    ; The editor's skin ("" or "retro"): a theme name added to this host's own.
    def skin:string ""
    ; the standard skin's colours as chosen: "light", "dark" or "system"
    def lookMode:string "light"
    ; the frame around the work: "" white, "terracotta" the logo's colour
    def lookFrame:string ""
    ; ...and its base colour, as a hue (`--retro-hue`).
    def skinHue:double 88.0
    def w:double 1200.0
    def h:double 700.0
    def barH:double 48.0
    def helpW:double 380.0
    ; the help panel
    def helpOpen:boolean false
    def helpJson:string ""
    ; the help panel's tab: "slide" (this slide's parts) or "guide" (how
    ; Sliqtly is used, PresHelp.guide)
    def helpTab:string "slide"
    def helpSlide:int 0
    def helpScroll:double 0.0
    def helpKeys:[string]
    ; the share dialog
    def shareOpen:boolean false
    def shareShow:string ""
    def shareEdit:string ""
    def shareNote:string ""
    ; a link to only the slides picked on the strip ("" without a pick), how
    ; many they are, and whether it follows the deck (a cloud share) or
    ; carries their text
    def shareView:string ""
    def shareViewCount:int 0
    def shareViewLive:boolean false
    ; a presentation in the cloud has no editing link: its owner invites
    ; people instead (the editors window, "share-invite") and can stop
    ; sharing ("share-stop"). How many are invited; -1: not the owner's,
    ; so neither is offered
    def shareEditors:int -1
    ; which modal dialog `shareOpen` shows: "share", or "open" (a file from
    ; the computer or a sample deck, `openRows` "value<TAB>label" lines)
    def dialogKind:string "share"
    ; The dialog is held to the page (`holdDialog`): what does not fit
    ; scrolls in it, by the wheel or a finger (`touch`, set by the page before
    ; each press: a press waits to see whether it is a tap or a scroll).
    def dlgScroll:UiScroll (new UiScroll())
    ; the dialog's padding and border, down: what its scrolling part is
    ; shorter than the page by (measured after a layout, a guess before)
    def dlgChrome:double 42.0
    def touch:boolean false
    def tapping:boolean false
    def openRows:string ""
    ; File → Presentations… ("decks"): the decks of this browser and the
    ; user's cloud, from the page (web/decklist.js deckListJson):
    ;   {"sort": "updated" | "created" | "name", "dir": "asc" | "desc", "rows": [{"id", "name",
    ;    "added", "modified", "where", "cloudOnly", "current"}], "note"}
    def decksJson:string ""
    ; the list's pages (EVGUI's PaginationCtl does the arithmetic)
    def decksPager:PaginationCtl (new PaginationCtl())
    ; the deck id of each row on the page: `pd-r-<n>` opens it, `pd-x-<n>`
    ; deletes it; a delete pressed once waits for the second press
    def decksKeys:[string]
    def decksArmed:string ""
    def decksWheelSum:double 0.0
    ; the Open dialog's sample decks: a select whose trigger says what it is
    def samplePick:PresPromptSelect (new PresPromptSelect())
    ; the import dialog ("data"): the dropped file and its selects, one of
    ; which may be open (`dataOpenSel`, its tid)
    def imp:PresImport (new PresImport())
    def dataSels:[SelectCtl]
    def dataOpenSel:string ""
    ; "show" or "edit": the button that says it copied
    def copied:string ""
    def copyOk:boolean true
    ; the files tab: the document's files and the stored documents, in the
    ; editor's place (`filesX`…`filesH`). `filesJson` comes from the page:
    ;   {"doc": name, "files": [{"path", "size", "kind"}], "note": text,
    ;    "promo": {"title", "text", "button"} (optional, drawn first)}
    ; With a file open in the editor (`filesOpenPath`) only a bar over it.
    def filesOpen:boolean false
    def filesX:double 0.0
    def filesY:double 0.0
    def filesW:double 400.0
    def filesH:double 400.0
    def filesJson:string ""
    def filesOpenPath:string ""
    def filesScroll:double 0.0
    ; what each row's button stands for: "<action>\t<path or id>"
    def filesKeys:[string]
    ; a delete pressed once, waiting for the second press
    def filesArmed:string ""
    ; the rows' checkboxes (a data table's): which files are ticked, by path;
    ; `filesBoxes` is what each box `pf-c-<k>` stands for
    def filesPick:UiPick (new UiPick())
    def filesBoxes:[string]
    ; the pictures' rows (`pf-img-<k>`): their paths and pixel sizes (the
    ; page's "w", "h"); the one under the pointer shows a preview beside the
    ; panel (`filesHover`, at the pointer's height `hoverY`)
    def imgPaths:[string]
    def imgW:[int]
    def imgH:[int]
    def filesHover:string ""
    def hoverW:int 0
    def hoverH:int 0
    def hoverY:double 0.0
    ; the chat (its `open` says whether it shows)
    def chat:ChatCtl (new ChatCtl())
    def chatW:double 340.0
    ; a press in the chat's text field, while the button is down
    def chatSelecting:boolean false
    ; the call's people (PresMeet's control) and whether they show
    def call:ParticipantsCtl (new ParticipantsCtl())
    def callOpen:boolean false
    ; Text that can be selected and copied (EVGUI TextCtl): the toast, the
    ; notes of the dialogs. A rebuild makes new ones and keeps what was
    ; selected in the one before with the same id and text.
    def texts:[TextCtl]
    def textsBefore:[TextCtl]
    ; a drag selecting in one of them, or in a link's field
    def textSelecting:boolean false
    ; the toast
    def toastText:string ""
    ; presenting: only the toast shows
    def quiet:boolean false
    def requests:[string]
    def rev:int 0
    def measurer@(optional):TTFTextMeasurer

    Constructor () {
        chat.setup("pn-chat" (PresI18n.t("Chat")))
        chat.placeholder = (PresI18n.t("Write a message…"))
        chat.emptyText = (PresI18n.t("No messages yet."))
        chat.sendText = (PresI18n.t("Send"))
        chat.closeText = (PresI18n.t("Close"))
        chat.newText = (PresI18n.t("new"))
    }

    ; --- what is showing ---------------------------------------------------------
    fn any:boolean () {
        return (((((helpOpen || shareOpen) || filesOpen) || chat.open) || callOpen) || ((strlen toastText) > 0))
    }

    ; the width a docked panel takes off the right edge (0: none open)
    fn dockW:double () {
        if helpOpen {
            return helpW
        }
        if (chat.open || callOpen) {
            return chatW
        }
        return 0.0
    }

    ; --- the call ------------------------------------------------------------------------
    ; Above the chat when both show; the whole edge when the chat is closed.
    fn setCall:void (on:boolean) {
        if (on != callOpen) {
            callOpen = on
            if on {
                helpOpen = false
            }
            this.rebuild()
        }
    }

    fn callShows:boolean () {
        return ((callOpen && (helpOpen == false)) && (quiet == false))
    }

    ; the height the call takes off the top of the right edge
    fn callH:double () {
        if ((this.callShows()) == false) {
            return 0.0
        }
        if (chat.open == false) {
            return (h - barH)
        }
        def need:double (call.needH())
        def most:double ((h - barH) * 0.5)
        if (need > most) {
            return most
        }
        return need
    }

    fn callHas:boolean (px:double py:double) {
        return ((((this.callShows()) && (px >= (w - chatW))) && (py >= barH)) && (py < (barH + (this.callH()))))
    }

    fn callPanel:EVGElement () {
        def ch:double (this.callH())
        def p:EVGElement (UiKit.div("pn-call-dock"))
        p.id = "pn-call-dock"
        UiTree.surface(p "free" "start")
        p.overlayX = (w - chatW)
        p.overlayY = barH
        p.width = (EVGUnit.px(chatW))
        p.height = (EVGUnit.px(ch))
        call.build()
        def cr:EVGElement (unwrap call.rootEl)
        UiTree.inline(cr "width" ((to_string chatW) + "px"))
        UiTree.inline(cr "height" ((to_string ch) + "px"))
        UiTree.inline(cr "border-radius" "0px")
        UiTree.inline(cr "border-width" "0px")
        if chat.open {
            UiTree.inline(cr "border-bottom-width" "1px")
        }
        UiKit.put(host call p)
        return p
    }

    ; a press in the call's panel: for PresMeet (its buttons)
    fn callPress:void (px:double py:double) {
        def tid:string (host.hitTest(px py))
        if ((strlen tid) > 0) {
            push requests ("call-press" + (strfromcode 9) + tid)
        }
    }

    ; --- the chat -----------------------------------------------------------------------
    ; help and the chat share the right edge: opening one closes the other
    fn setChat:void (on:boolean) {
        if (on != chat.open) {
            chat.setOpen(on)
            if on {
                helpOpen = false
            }
            this.rebuild()
        }
    }

    ; A selectable text (TextCtl `selectable`), in the host.
    fn copyable:EVGElement (tid:string cls:string t:string) {
        def c:TextCtl (TextCtl.make(tid t cls))
        c.selectable = true
        def i:int 0
        while (i < (array_length textsBefore)) {
            def old:TextCtl (itemAt textsBefore i)
            if ((old.tid == tid) && (old.text == t)) {
                c.sel.anchor = old.sel.anchor
                c.sel.caret = old.sel.caret
            }
            i = (i + 1)
        }
        c.build()
        push host.ctls c
        push texts c
        return (unwrap c.rootEl)
    }

    ; Text a press can select: a TextCtl here, or a share link's field.
    fn copyableAt:boolean (tid:string) {
        if ((strlen tid) == 0) {
            return false
        }
        if ((indexOf tid "pn-url-") == 0) {
            return true
        }
        def i:int 0
        while (i < (array_length texts)) {
            def c:TextCtl (itemAt texts i)
            if (c.owns(tid)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn textDragTo:void (px:double py:double) {
        if textSelecting {
            host.textDragToAt(px py)
            rev = (rev + 1)
        }
    }

    fn textRelease:void () {
        if textSelecting {
            host.textRelease()
        }
        textSelecting = false
    }

    ; What Ctrl+C copies from the panels: the chat field's selection while it
    ; has the keyboard, else what was selected in a text or a link.
    fn copyText:string (chatFocused:boolean) {
        if chatFocused {
            def ct:string (chat.input.selectedText())
            if ((strlen ct) > 0) {
                return ct
            }
        }
        return (host.copyText())
    }

    fn dropSelection:void () {
        host.dropSelections("")
        rev = (rev + 1)
    }

    ; The toast stays while its text is selected or being selected, so it
    ; can be copied.
    fn toastHeld:boolean () {
        if ((strlen toastText) == 0) {
            return false
        }
        if textSelecting {
            return true
        }
        def i:int 0
        while (i < (array_length texts)) {
            def c:TextCtl (itemAt texts i)
            if ((c.tid == "pn-toast-text") && (c.hasSelection())) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn chatDragTo:void (px:double py:double) {
        if chatSelecting {
            chat.textPointerDragAt(px py)
        }
    }

    fn chatRelease:void () {
        if chatSelecting {
            chat.textPointerUp()
        }
        chatSelecting = false
    }

    fn chatHas:boolean (px:double py:double) {
        return (((chat.open && (quiet == false)) && (px >= (w - chatW))) && (py >= (barH + (this.callH()))))
    }

    fn chatPanel:EVGElement () {
        def p:EVGElement (UiKit.div("pn-chat-dock"))
        p.id = "pn-chat-dock"
        UiTree.surface(p "free" "start")
        def top:double (barH + (this.callH()))
        p.overlayX = (w - chatW)
        p.overlayY = top
        p.width = (EVGUnit.px(chatW))
        p.height = (EVGUnit.px((h - top)))
        chat.height = (h - top)
        chat.build()
        def cr:EVGElement (unwrap chat.rootEl)
        UiTree.inline(cr "width" ((to_string chatW) + "px"))
        UiTree.inline(cr "border-radius" "0px")
        UiTree.inline(cr "border-width" "0px")
        UiKit.put(host chat p)
        return p
    }

    ; A press in the chat: its buttons, or the text field (the caret, a word
    ; on a double click, all of it on a triple; a drag selects).
    fn chatPress:void (px:double py:double clicks:int shift:boolean) {
        def tid:string (host.hitTest(px py))
        def c:string (chat.tid)
        if (chat.input.owns(tid)) {
            chatSelecting = (chat.textPointerDownAt(tid px py clicks shift))
            return
        }
        if ((tid == (c + "-close")) || (tid == (c + "-send")) || (tid == (c + "-jump"))) {
            chat.activate(tid)
            if (tid == (c + "-close")) {
                push requests "chat-closed"
            }
            if ((strlen chat.sent) > 0) {
                push requests "chat-send"
            }
        }
        this.rebuild()
    }

    ; --- the files tab ----------------------------------------------------------------
    fn setFiles:void (on:boolean x:double y:double fw:double fh:double openPath:string) {
        if ((((on != filesOpen) || (openPath != filesOpenPath)) || ((x != filesX) || (y != filesY))) || ((fw != filesW) || (fh != filesH))) {
            if (on != filesOpen) {
                filesScroll = 0.0
                filesArmed = ""
            }
            filesHover = ""
            filesOpen = on
            filesX = x
            filesY = y
            filesW = fw
            filesH = fh
            filesOpenPath = openPath
            this.rebuild()
        }
    }

    fn setFilesData:void (json:string) {
        if (json != filesJson) {
            filesJson = json
            filesArmed = ""
            filesHover = ""
            this.rebuild()
        }
    }

    ; the bar over an open file
    sfn filesBarH:double () {
        return 44.0
    }

    fn setHelp:void (on:boolean) {
        if (on != helpOpen) {
            helpOpen = on
            helpScroll = 0.0
            if (on && chat.open) {
                chat.setOpen(false)
                push requests "chat-closed"
            }
            if (on && callOpen) {
                callOpen = false
                push requests "call-closed"
            }
            this.rebuild()
        }
    }

    fn setHelpTab:void (tab:string) {
        if (tab != helpTab) {
            helpTab = tab
            helpScroll = 0.0
            this.rebuild()
        }
    }

    ; The slide's parts, rebuilt only when they changed.
    fn setHelpData:void (json:string slide:int) {
        if ((json != helpJson) || (slide != helpSlide)) {
            if (slide != helpSlide) {
                helpScroll = 0.0
            }
            helpJson = json
            helpSlide = slide
            this.rebuild()
        }
    }

    ; set before openShare: how many people the owner invited to edit
    ; (-1: none of that is shown)
    fn setShareEditors:void (n:int) {
        shareEditors = n
    }

    ; set before openShare; "" for none
    fn setShareView:void (url:string count:int live:boolean) {
        shareView = url
        shareViewCount = count
        shareViewLive = live
    }

    fn openShare:void (showUrl:string editUrl:string note:string) {
        shareShow = showUrl
        shareEdit = editUrl
        shareNote = note
        dialogKind = "share"
        dlgScroll.reset()
        shareOpen = true
        copied = ""
        this.rebuild()
    }

    fn openOpen:void (rows:string) {
        openRows = rows
        dialogKind = "open"
        dlgScroll.reset()
        shareOpen = true
        this.rebuild()
    }

    fn openDecks:void (json:string) {
        decksJson = json
        decksPager.page = 1
        decksArmed = ""
        dialogKind = "decks"
        dlgScroll.reset()
        shareOpen = true
        this.rebuild()
    }

    ; the list again (sorted otherwise, a deck deleted, the cloud's read),
    ; only while the window shows
    fn setDecks:void (json:string) {
        if ((shareOpen && (dialogKind == "decks")) && (json != decksJson)) {
            decksJson = json
            this.rebuild()
        }
    }

    fn decksShowing:boolean () {
        return ((shareOpen && (quiet == false)) && (dialogKind == "decks"))
    }

    ; File → Settings: the editor's own preferences, kept by the page.
    def autoContrast:boolean true
    ; review mode (comments on the slides); a comment's colour is picked
    ; with it (how serious, PresReviewUi), not here

    fn openSettings:void (contrast:boolean) {
        autoContrast = contrast
        dialogKind = "settings"
        dlgScroll.reset()
        shareOpen = true
        this.rebuild()
    }

    fn openData:void (i:PresImport) {
        imp = i
        dialogKind = "data"
        dataOpenSel = ""
        dlgScroll.reset()
        shareOpen = true
        this.rebuild()
    }

    fn closeShare:void () {
        if shareOpen {
            shareOpen = false
            this.rebuild()
        }
    }

    fn setCopied:void (which:string ok:boolean) {
        copied = which
        copyOk = ok
        this.rebuild()
    }

    fn toast:void (t:string) {
        if (t != toastText) {
            toastText = t
            this.rebuild()
        }
    }

    ; --- building -------------------------------------------------------------------
    fn button:ButtonCtl (tid:string label:string variant:string parent:EVGElement) {
        def c:ButtonCtl (UiKit.button(tid label variant))
        UiTree.addClass((unwrap c.rootEl) "pn-button")
        if (variant == "primary") {
            UiKit.labelClass(c "pn-onprimary")
        }
        UiKit.put(host c parent)
        return c
    }

    ; The retro skin's colours: a name and the hue it stands for.
    sfn hueNames:[string] () {
        def n:[string]
        push n "Lime"
        push n "Ice"
        push n "Ember"
        push n "Violet"
        push n "Rose"
        return n
    }

    sfn hueValues:[int] () {
        def v:[int]
        push v 88
        push v 200
        push v 25
        push v 275
        push v 335
        return v
    }

    sfn isColour:boolean (v:string) {
        def t:string (trim v)
        return ((((strlen t) >= 4) && ((charAt t 0) == 35)) || ((indexOf t "rgb") == 0))
    }

    fn swatch:EVGElement (colour:string) {
        def sw:EVGElement (UiKit.div("pn-swatch"))
        UiTree.inline(sw "background-color" colour)
        return sw
    }

    fn rebuild:void () {
        def fresh (new UiHost())
        fresh.addStyleSheetFrom(css host)
        ; what the pointer is over stays hovered across a rebuild
        fresh.hoverTid = host.hoverTid
        host = fresh
        host.setTheme((trim ("pn " + skin)))
        host.setPageSize(w h)
        textsBefore = texts
        def noTexts:[TextCtl]
        texts = noTexts
        def root:EVGElement (unwrap host.root)
        root.className = "ui-root pn-page"
        if (helpOpen && (quiet == false)) {
            root.addChild((this.helpPanel()))
        }
        if (this.callShows()) {
            root.addChild((this.callPanel()))
        }
        if ((chat.open && (helpOpen == false)) && (quiet == false)) {
            root.addChild((this.chatPanel()))
        }
        if (filesOpen && (quiet == false)) {
            root.addChild((this.filesPanel()))
            if (((strlen filesHover) > 0) && ((strlen filesOpenPath) == 0)) {
                root.addChild((this.imagePreview()))
            }
        }
        if ((strlen toastText) > 0) {
            def t:EVGElement (UiKit.div("pn-toast"))
            t.id = "pn-toast"
            t.addChild((this.copyable("pn-toast-text" "pn-toast-text" toastText)))
            UiTree.surface(t "free" "start")
            t.overlayX = ((w * 0.5) - 180.0)
            t.overlayY = (h - 70.0)
            root.addChild(t)
        }
        if (shareOpen && (quiet == false)) {
            def back:EVGElement (UiKit.div("pn-backdrop"))
            back.id = "pn-backdrop"
            UiTree.backdrop(back)
            root.addChild(back)
            if (dialogKind == "open") {
                root.addChild((this.openDialog()))
            } {
              if (dialogKind == "decks") {
                root.addChild((this.decksDialog()))
              } {
              if (dialogKind == "settings") {
                root.addChild((this.settingsDialog()))
              } {
              if (dialogKind == "data") {
                root.addChild((this.dataDialog()))
              } {
                root.addChild((this.shareDialog()))
              }
              }
              }
            }
            this.holdDialog()
        }
        rev = (rev + 1)
    }

    ; The dialog on the page whatever the page's size: never wider than it
    ; less 8 pixels a side, never taller, and what does not fit scrolls. On a
    ; phone (390 wide) the 520-pixel dialogs ran off both sides, and on a low
    ; window Settings ran off the top and the bottom.
    ;
    ; What scrolls is a column inside the dialog (`pn-dscroll`), not the
    ; dialog: EVG measures a floating surface's scroll extent after it has
    ; moved the content by the scroll, so a dialog that scrolled itself had
    ; less to scroll the further it went. `page` centres it on its real size.
    fn holdDialog:void () {
        def r:EVGElement (unwrap host.root)
        def d@(optional):EVGElement (host.findEl(r "pn-dialog"))
        if (null? d) {
            return
        }
        def de:EVGElement (unwrap d)
        UiTree.inline(de "max-width" ((to_string (to_int (w - 16.0))) + "px"))
        def inner:EVGElement (UiKit.div("pn-dscroll"))
        inner.id = "pn-dscroll"
        if ((indexOf de.className "pd-dialog") >= 0) {
            UiTree.addClass(inner "pd-dscroll")
        }
        def kids:[EVGElement] de.children
        UiTree.clearChildren(de)
        def i:int 0
        while (i < (array_length kids)) {
            inner.addChild((itemAt kids i))
            i = (i + 1)
        }
        de.addChild(inner)
        UiTree.inline(inner "overflow-y" "auto")
        this.fitDialog(inner)
        inner.scrollTop = dlgScroll.top
    }

    fn fitDialog:void (inner:EVGElement) {
        def mh:double ((h - 16.0) - dlgChrome)
        if (mh < 60.0) {
            mh = 60.0
        }
        UiTree.inline(inner "max-height" ((to_string (to_int mh)) + "px"))
    }

    fn dialogEl@(optional):EVGElement () {
        def none@(optional):EVGElement
        if ((shareOpen == false) || quiet) {
            return none
        }
        if (null? host.lastPage) {
            this.page()
        }
        return (host.findEl((unwrap host.lastPage) "pn-dscroll"))
    }

    ; The wheel over the dialog: it scrolls. True when it moved.
    fn dialogWheel:boolean (dy:double) {
        def d@(optional):EVGElement (this.dialogEl())
        if (null? d) {
            return false
        }
        if (dlgScroll.scrollBy((unwrap d) dy)) {
            rev = (rev + 1)
            return true
        }
        return false
    }

    fn dialogPanning:boolean () {
        return dlgScroll.panning
    }

    ; A finger moved on the dialog.
    fn dialogPanTo:void (py:double) {
        def d@(optional):EVGElement (this.dialogEl())
        if ((!null? d) && (dlgScroll.panTo((unwrap d) py))) {
            rev = (rev + 1)
        }
    }

    ; It lifted: true when it was a tap, pressed now.
    fn dialogPanEnd:boolean () {
        if ((dlgScroll.endPan()) == false) {
            return false
        }
        tapping = true
        this.press(dlgScroll.downX dlgScroll.downY dlgScroll.clicks dlgScroll.shift)
        tapping = false
        return true
    }

    ; --- the help panel -------------------------------------------------------------
    fn helpPanel:EVGElement () {
        def keys:[string]
        helpKeys = keys
        def p:EVGElement (UiKit.div("pn-help"))
        p.id = "pn-help"
        UiTree.surface(p "free" "start")
        p.overlayX = (w - helpW)
        p.overlayY = barH
        p.width = (EVGUnit.px(helpW))
        p.height = (EVGUnit.px((h - barH)))
        def top:EVGElement (UiKit.div("pn-top"))
        def guide:boolean (helpTab == "guide")
        this.button("pn-help-slide" ((PresI18n.t("Slide ")) + (to_string (helpSlide + 1))) (? guide "ghost" "secondary") top)
        this.button("pn-help-guide" (PresI18n.t("How to use")) (? guide "secondary" "ghost") top)
        top.addChild((UiKit.div("pn-grow")))
        this.button("pn-help-close" "✕" "ghost" top)
        p.addChild(top)
        def view:EVGElement (UiKit.div("pn-view"))
        view.id = "pn-view"
        view.setAttribute("overflow" "hidden")
        view.scrollTop = helpScroll
        view.height = (EVGUnit.px(((h - barH) - 49.0)))
        def body:EVGElement (UiKit.div("pn-body"))
        if guide {
            body.addChild((UiKit.words("pn-intro" (PresI18n.t("What Sliqtly is used for and where each thing is.")))))
            def pg (new VlJsonParser())
            def parts:VlJson (pg.parse((PresHelp.guide())))
            def g:int 0
            while (g < (parts.count())) {
                body.addChild((this.feature((parts.at(g)))))
                g = (g + 1)
            }
            view.addChild(body)
            p.addChild(view)
            return p
        }
        body.addChild((UiKit.words("pn-intro" (PresI18n.t("This slide has these parts. Click a property to change it in the theme CSS.")))))
        body.addChild((UiKit.words("pn-intro" (PresI18n.t("Keys: F6 moves between areas (bar, tabs, editor, slides, help), arrows and Tab within an area, Enter selects, Ctrl+Space opens the choices for the value at the cursor, Esc returns to the editor.")))))
        def p0 (new VlJsonParser())
        def feats:VlJson (p0.parse(helpJson))
        def i:int 0
        while (i < (feats.count())) {
            body.addChild((this.feature((feats.at(i)))))
            i = (i + 1)
        }
        view.addChild(body)
        p.addChild(view)
        return p
    }

    fn feature:EVGElement (f:VlJson) {
        def sec:EVGElement (UiKit.div("pn-sec"))
        sec.addChild((UiKit.words("pn-h3" (f.stringOr("title" "")))))
        def syn:string (f.stringOr("syntax" ""))
        if ((strlen syn) > 0) {
            def row:EVGElement (UiKit.div("pn-syn"))
            def parts:[string] (strsplit syn "   ")
            def k:int 0
            while (k < (array_length parts)) {
                def t:string (trim (itemAt parts k))
                if ((strlen t) > 0) {
                    row.addChild((UiKit.words("pn-code" t)))
                }
                k = (k + 1)
            }
            sec.addChild(row)
        }
        def doc:string (f.stringOr("doc" ""))
        if ((strlen doc) > 0) {
            sec.addChild((UiKit.words("pn-doc" doc)))
        }
        def rules:VlJson (f.get("rules"))
        def r:int 0
        while (r < (rules.count())) {
            sec.addChild((this.rule((rules.at(r)))))
            r = (r + 1)
        }
        def attrs:VlJson (f.get("attrs"))
        def a:int 0
        while (a < (attrs.count())) {
            def at:VlJson (attrs.at(a))
            def row2:EVGElement (UiKit.div("pn-attr"))
            row2.addChild((UiKit.words("pn-code" ((at.stringOr("name" "")) + "=" + (at.stringOr("value" ""))))))
            row2.addChild((UiKit.words("pn-pd" (at.stringOr("doc" "")))))
            sec.addChild(row2)
            a = (a + 1)
        }
        return sec
    }

    fn rule:EVGElement (r:VlJson) {
        def box:EVGElement (UiKit.div("pn-rule"))
        def sel:string (r.stringOr("sel" ""))
        def head:EVGElement (UiKit.div("pn-rhead"))
        head.addChild((UiKit.words("pn-sel" (sel + " { }"))))
        head.addChild((UiKit.words("pn-sd" (r.stringOr("doc" "")))))
        box.addChild(head)
        def props:VlJson (r.get("props"))
        def i:int 0
        while (i < (props.count())) {
            def p:VlJson (props.at(i))
            def name:string (p.stringOr("name" ""))
            def value:string (p.stringOr("value" ""))
            def eff:string (p.stringOr("eff" ""))
            def row:EVGElement (UiKit.div("pn-prop"))
            row.id = ("pn-prop-" + (to_string (array_length helpKeys)))
            push helpKeys (sel + (strfromcode 9) + name + (strfromcode 9) + (p.stringOr("def" "")))
            def line:EVGElement (UiKit.div("pn-pline"))
            line.addChild((UiKit.words("pn-nm" name)))
            line.addChild((UiKit.div("pn-grow")))
            if ((strlen value) > 0) {
                if (PresPanels.isColour(value)) {
                    line.addChild((this.swatch(value)))
                }
                line.addChild((UiKit.words("pn-val" value)))
            } {
                if ((strlen eff) > 0) {
                    if (PresPanels.isColour(eff)) {
                        line.addChild((this.swatch(eff)))
                    }
                    line.addChild((UiKit.words("pn-unset" ((PresI18n.t("default ")) + eff + (PresI18n.t(" – add"))))))
                } {
                    line.addChild((UiKit.words("pn-unset" (PresI18n.t("not set – add")))))
                }
            }
            row.addChild(line)
            def pd:string (p.stringOr("doc" ""))
            if ((strlen pd) > 0) {
                row.addChild((UiKit.words("pn-pd" pd)))
            }
            box.addChild(row)
            i = (i + 1)
        }
        return box
    }

    ; --- the files tab ---------------------------------------------------------------
    fn filesPanel:EVGElement () {
        def keys:[string]
        filesKeys = keys
        def noPaths:[string]
        imgPaths = noPaths
        def noW:[int]
        imgW = noW
        def noH:[int]
        imgH = noH
        def p:EVGElement (UiKit.div("pf-panel"))
        p.id = "pf-panel"
        UiTree.surface(p "free" "start")
        p.overlayX = filesX
        p.overlayY = filesY
        p.width = (EVGUnit.px(filesW))
        if ((strlen filesOpenPath) > 0) {
            ; a file in the editor: a bar to go back by
            p.height = (EVGUnit.px((PresPanels.filesBarH())))
            def bar:EVGElement (UiKit.div("pf-top"))
            this.button("pf-back" (PresI18n.t("← Files")) "ghost" bar)
            bar.addChild((UiKit.words("pf-path" filesOpenPath)))
            bar.addChild((UiKit.div("pn-grow")))
            bar.addChild((UiKit.words("pf-saved" (PresI18n.t("saves automatically")))))
            p.addChild(bar)
            return p
        }
        p.height = (EVGUnit.px(filesH))
        def noBoxes:[string]
        filesBoxes = noBoxes
        def p0 (new VlJsonParser())
        def data:VlJson (p0.parse(filesJson))
        def loaded:boolean ((p0.ok == true) && (data.isObject()))
        def top:EVGElement (UiKit.div("pf-top"))
        top.addChild((UiKit.words("pn-title" (PresI18n.t("Files")))))
        top.addChild((UiKit.div("pn-grow")))
        ; files copied from a presentation (here or another): {"count", "from"}
        if loaded {
            def clip:VlJson (data.get("clip"))
            if (clip.isObject()) {
                def n:int (clip.intOr("count" 0))
                if (n > 0) {
                    def label:string ((PresI18n.t("Paste ")) + (to_string n) + (? (n == 1) (PresI18n.t(" file")) (PresI18n.t(" files"))))
                    this.button("pf-paste" label "secondary" top)
                }
            }
        }
        this.button("pf-add" (PresI18n.t("Add files…")) "secondary" top)
        p.addChild(top)
        ; the files that can be ticked: all but the deck's own text and theme
        def files:VlJson (data.get("files"))
        def keys:[string]
        if loaded {
            def fi:int 0
            while (fi < (files.count())) {
                def ff:VlJson (files.at(fi))
                def fk:string (ff.stringOr("kind" ""))
                if ((fk != "md") && (fk != "css")) {
                    push keys (ff.stringOr("path" ""))
                }
                fi = (fi + 1)
            }
        }
        filesPick.setKeys(keys)
        def selH:double 0.0
        if ((array_length keys) > 0) {
            selH = 40.0
            p.addChild((this.filesSelBar()))
        }
        def view:EVGElement (UiKit.div("pn-view"))
        view.id = "pf-view"
        view.setAttribute("overflow" "hidden")
        view.scrollTop = filesScroll
        view.height = (EVGUnit.px(((filesH - 49.0) - selH)))
        def body:EVGElement (UiKit.div("pf-body"))
        if (loaded == false) {
            body.addChild((UiKit.words("pn-intro" (PresI18n.t("Loading files…")))))
            view.addChild(body)
            p.addChild(view)
            return p
        }
        ; the page's offer above everything (Sliqtly: PRO), {"title", "text", "button"}
        def promo:VlJson (data.get("promo"))
        if (promo.isObject()) {
            def box:EVGElement (UiKit.div("pf-promo"))
            box.addChild((UiKit.words("pf-promo-title" (promo.stringOr("title" "")))))
            box.addChild((UiKit.words("pf-promo-text" (promo.stringOr("text" "")))))
            def label:string (promo.stringOr("button" ""))
            if ((strlen label) > 0) {
                def row:EVGElement (UiKit.div("pf-promo-row"))
                def b:ButtonCtl (this.button("pf-promo" label "primary" row))
                UiTree.addClass((unwrap b.rootEl) "pf-promo-btn")
                box.addChild(row)
            }
            body.addChild(box)
        }
        body.addChild((UiKit.words("pf-h" ((PresI18n.t("This presentation: ")) + (data.stringOr("doc" ""))))))
        ; the files, a folder's under its name (the page lists them so)
        def folder:string "-"
        def i:int 0
        while (i < (files.count())) {
            def f:VlJson (files.at(i))
            def path:string (f.stringOr("path" ""))
            def slash:int (PresPanels.lastSlash(path))
            def dir:string ""
            if (slash > 0) {
                dir = (substring path 0 (slash + 1))
            }
            if (dir != folder) {
                folder = dir
                if (dir == "data/live/") {
                    ; the copies kept of linked sources (main.js keepLiveCopy)
                    body.addChild((UiKit.words("pf-dir" (PresI18n.t("Linked data")))))
                } {
                    if ((strlen dir) > 0) {
                        body.addChild((UiKit.words("pf-dir" dir)))
                    }
                }
            }
            body.addChild((this.fileRow(f (substring path (slash + 1) (strlen path)))))
            i = (i + 1)
        }
        if ((files.count()) == 0) {
            body.addChild((UiKit.words("pn-intro" (PresI18n.t("No files yet.")))))
        }
        def note:string (data.stringOr("note" ""))
        if ((strlen note) > 0) {
            body.addChild((this.copyable("pf-note-text" "pf-note" note)))
        }
        view.addChild(body)
        p.addChild(view)
        return p
    }

    ; Over the rows, as a data table's header: the box that ticks them all,
    ; and with some ticked, what can be done to them.
    fn filesSelBar:EVGElement () {
        def bar:EVGElement (UiKit.div("pf-sel"))
        def all (new CheckboxCtl())
        all.tid = "pf-all"
        all.name = (PresI18n.t("Select all"))
        all.checkState = (filesPick.checkState())
        all.labelShown = false
        all.build()
        UiTree.addClass((unwrap all.rootEl) "pf-check")
        UiKit.put(host all bar)
        def n:int (filesPick.count())
        if (n == 0) {
            bar.addChild((UiKit.words("pf-sel-text" (PresI18n.t("Select all")))))
            bar.addChild((UiKit.div("pn-grow")))
            return bar
        }
        bar.addChild((UiKit.words("pf-sel-text pf-sel-count" ((to_string n) + (PresI18n.t(" selected"))))))
        bar.addChild((UiKit.div("pn-grow")))
        def c:ButtonCtl (this.button("pf-copy" (PresI18n.t("Copy")) "secondary" bar))
        UiTree.addClass((unwrap c.rootEl) "pf-act")
        if (filesArmed == "bulkdel") {
            def d:ButtonCtl (this.button("pf-bulkdel" ((PresI18n.t("Delete ")) + (to_string n) + "?") "primary" bar))
            UiTree.addClass((unwrap d.rootEl) "pf-act")
        } {
            def d2:ButtonCtl (this.button("pf-bulkdel" (PresI18n.t("Delete")) "ghost" bar))
            UiTree.addClass((unwrap d2.rootEl) "pf-act")
        }
        return bar
    }

    ; A row's box, ticked when its file is.
    fn rowBox:void (path:string row:EVGElement) {
        def k:int (array_length filesBoxes)
        push filesBoxes path
        def c (new CheckboxCtl())
        c.tid = ("pf-c-" + (to_string k))
        c.name = ((PresI18n.t("Select ")) + (PresPanels.nameOf(path)))
        if (filesPick.has(path)) {
            c.checkState = 1
        }
        c.labelShown = false
        c.build()
        UiTree.addClass((unwrap c.rootEl) "pf-check")
        UiKit.put(host c row)
    }

    ; the joined paths of the ticked files, for the page
    fn pickedText:string () {
        def ps:[string] (filesPick.selected())
        def out:string ""
        def i:int 0
        while (i < (array_length ps)) {
            if (i > 0) {
                out = (out + (strfromcode 10))
            }
            out = (out + (itemAt ps i))
            i = (i + 1)
        }
        return out
    }

    sfn lastSlash:int (path:string) {
        def at:int -1
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == 47) {
                at = i
            }
            i = (i + 1)
        }
        return at
    }

    sfn sizeText:string (n:int) {
        if (n < 0) {
            return ""
        }
        if (n < 1024) {
            return ((to_string n) + (PresI18n.t(" B")))
        }
        if (n < (1024 * 1024)) {
            return ((to_string (idiv n 1024)) + (PresI18n.t(" KB")))
        }
        return ((to_string (idiv n (1024 * 1024))) + (PresI18n.t(" MB")))
    }

    ; A button standing for `action` on `what`.
    fn act:void (action:string what:string label:string variant:string parent:EVGElement) {
        def k:int (array_length filesKeys)
        push filesKeys (action + (strfromcode 9) + what)
        def b:ButtonCtl (this.button(("pf-k-" + (to_string k)) label variant parent))
        UiTree.addClass((unwrap b.rootEl) "pf-act")
    }

    fn fileRow:EVGElement (f:VlJson name:string) {
        def path:string (f.stringOr("path" ""))
        def kind:string (f.stringOr("kind" ""))
        def row:EVGElement (UiKit.div("pf-row"))
        if ((kind == "md") || (kind == "css")) {
            ; the deck's own text and theme: not copied, the box's place kept
            row.addChild((UiKit.div("pf-check-gap")))
        } {
            this.rowBox(path row)
            if (filesPick.has(path)) {
                UiTree.addClass(row "pf-row-picked")
            }
        }
        if (kind == "image") {
            row.id = ("pf-img-" + (to_string (array_length imgPaths)))
            push imgPaths path
            push imgW (f.intOr("w" 0))
            push imgH (f.intOr("h" 0))
        }
        def tag:string "TXT"
        if (kind == "md") { tag = "MD" }
        if (kind == "css") { tag = "CSS" }
        if (kind == "image") { tag = (PresI18n.t("IMAGE")) }
        if (kind == "chart") { tag = "VL" }
        if (kind == "data") { tag = "DATA" }
        if (kind == "form") {
            ; a questionnaire: its text, and on a server that keeps answers
            ; (the page marks the row `served`) its answer link and responses
            tag = (PresI18n.t("FORM"))
        }
        if (kind == "live") {
            ; a linked source (a Google Sheet, a CSV / JSON address): its name,
            ; where it is read from and when; the copy itself is not edited
            row.addChild((UiKit.words("pf-tag pf-tag-live" (f.stringOr("tag" "LIVE")))))
            def ln:EVGElement (UiKit.div("pf-name"))
            ln.addChild((UiKit.words("pf-fname" (f.stringOr("title" name)))))
            ln.addChild((UiKit.words("pf-fsize" (f.stringOr("note" "")))))
            row.addChild(ln)
            row.addChild((UiKit.div("pn-grow")))
            if ((strlen (f.stringOr("source" ""))) > 0) {
                this.act("source" path (PresI18n.t("Open source")) "secondary" row)
                this.act("refresh" path (PresI18n.t("Refresh")) "secondary" row)
            }
            if (filesArmed == ("unlink" + (strfromcode 9) + path)) {
                this.act("unlink" path (PresI18n.t("Unlink?")) "primary" row)
            } {
                this.act("unlink" path (PresI18n.t("Unlink")) "ghost" row)
            }
            return row
        }
        if (kind == "recording") {
            ; the presentation recorded (its sound with it): played, its
            ; parts cut in Edit, deleted
            row.addChild((UiKit.words("pf-tag pf-tag-rec" "REC")))
            def rn:EVGElement (UiKit.div("pf-name"))
            rn.addChild((UiKit.words("pf-fname" (f.stringOr("title" name)))))
            rn.addChild((UiKit.words("pf-fsize" (f.stringOr("note" "")))))
            row.addChild(rn)
            row.addChild((UiKit.div("pn-grow")))
            this.act("recplay" path (PresI18n.t("▶ Play")) "secondary" row)
            this.act("recedit" path (PresI18n.t("Edit")) "secondary" row)
            if (filesArmed == ("del" + (strfromcode 9) + path)) {
                this.act("del" path (PresI18n.t("Delete?")) "primary" row)
            } {
                this.act("del" path "✕" "ghost" row)
            }
            return row
        }
        row.addChild((UiKit.words(("pf-tag pf-tag-" + kind) tag)))
        def nm:EVGElement (UiKit.div("pf-name"))
        nm.addChild((UiKit.words("pf-fname" name)))
        def size:string (PresPanels.sizeText((f.intOr("size" -1))))
        if ((strlen size) > 0) {
            nm.addChild((UiKit.words("pf-fsize" size)))
        }
        row.addChild(nm)
        row.addChild((UiKit.div("pn-grow")))
        if ((kind == "md") || (kind == "css")) {
            this.act("tab" kind (PresI18n.t("Edit")) "secondary" row)
            return row
        }
        if (kind == "image") {
            ; an SVG: Edit vectorizes its picture again, while the picture
            ; is in the files (the page marks the row `retrace`)
            if ((PresPanels.editable(path)) || (f.boolOr("retrace" false))) {
                this.act("imgedit" path (PresI18n.t("Edit")) "secondary" row)
            }
            this.act("insert" path (PresI18n.t("Add to slide")) "secondary" row)
        } {
            this.act("open" path (PresI18n.t("Open")) "secondary" row)
            if ((kind == "form") && (f.boolOr("served" false))) {
                this.act("formlink" path (PresI18n.t("Answer link")) "secondary" row)
                this.act("formcsv" path (PresI18n.t("Responses")) "secondary" row)
            }
            if (kind == "chart") {
                this.act("insert" path (PresI18n.t("Add to slide")) "secondary" row)
            }
        }
        def armed:boolean (filesArmed == ("del" + (strfromcode 9) + path))
        if armed {
            this.act("del" path (PresI18n.t("Delete?")) "primary" row)
        } {
            this.act("del" path "✕" "ghost" row)
        }
        return row
    }

    ; a picture the editor can change: pixels, not a drawing (SVG)
    sfn editable:boolean (path:string) {
        return ((indexOf (to_lowercase path) ".svg") < 0)
    }

    ; The picture under the pointer, as it is, beside the panel (over the
    ; slides) or inside its right edge when there is no room.
    fn imagePreview:EVGElement () {
        def most:double 240.0
        def pw:double most
        def ph:double (most * 0.66)
        if ((hoverW > 0) && (hoverH > 0)) {
            def k:double (most / (to_double hoverW))
            if ((to_double hoverH) > (to_double hoverW)) {
                k = (most / (to_double hoverH))
            }
            if (k > 1.0) {
                k = 1.0
            }
            pw = ((to_double hoverW) * k)
            ph = ((to_double hoverH) * k)
        }
        def card:EVGElement (UiKit.div("pf-preview"))
        card.id = "pf-preview"
        UiTree.surface(card "free" "start")
        card.width = (EVGUnit.px((pw + 20.0)))
        def im (EVGElement.createImg())
        im.id = "pf-preview-img"
        im.className = "pf-preview-img"
        im.src = ("/" + filesHover)
        im.objectFit = "contain"
        im.sourceWidth = (to_double hoverW)
        im.sourceHeight = (to_double hoverH)
        im.width = (EVGUnit.px(pw))
        im.height = (EVGUnit.px(ph))
        card.addChild(im)
        def cap:string (PresPanels.nameOf(filesHover))
        if ((hoverW > 0) && (hoverH > 0)) {
            cap = (cap + "  ·  " + (to_string hoverW) + " × " + (to_string hoverH) + " px")
        }
        card.addChild((UiKit.words("pf-preview-cap" cap)))
        if (PresPanels.editable(filesHover)) {
            card.addChild((UiKit.words("pf-preview-hint" (PresI18n.t("Click to edit")))))
        }
        def cw:double (pw + 20.0)
        def chh:double (ph + 58.0)
        def px:double ((filesX + filesW) + 10.0)
        if ((px + cw) > (w - 8.0)) {
            px = (((filesX + filesW) - cw) - 24.0)
        }
        def py:double (hoverY - (chh * 0.5))
        if ((py + chh) > (h - 8.0)) {
            py = ((h - 8.0) - chh)
        }
        if (py < (filesY + 8.0)) {
            py = (filesY + 8.0)
        }
        card.overlayX = px
        card.overlayY = py
        return card
    }

    sfn nameOf:string (path:string) {
        def slash:int (PresPanels.lastSlash(path))
        return (substring path (slash + 1) (strlen path))
    }

    ; A picture's row under the point: its index in `imgPaths`, or -1.
    fn imgRowAt:int (px:double py:double) {
        if ((null? host.lastPage) || ((strlen filesOpenPath) > 0)) {
            return -1
        }
        if ((this.inEl("pf-view" px py)) == false) {
            return -1
        }
        def hit (new EVGHitTest())
        def order:[EVGElement] (hit.paintOrder((unwrap host.lastPage)))
        def i:int ((array_length order) - 1)
        while (i >= 0) {
            def el:EVGElement (itemAt order i)
            if ((indexOf el.id "pf-img-") == 0) {
                if (host.containsPoint(el px py)) {
                    def k:int (?? (str2int (substring el.id 7 (strlen el.id))) -1)
                    if ((k >= 0) && (k < (array_length imgPaths))) {
                        return k
                    }
                }
            }
            i = (i - 1)
        }
        return -1
    }

    ; The preview follows the pointer over the pictures' rows.
    fn filesHoverAt:void (px:double py:double) {
        if ((filesOpen == false) || (quiet || shareOpen)) {
            return
        }
        def k:int -1
        if (this.filesHas(px py)) {
            k = (this.imgRowAt(px py))
        }
        def path:string ""
        if (k >= 0) {
            path = (itemAt imgPaths k)
        }
        if (path != filesHover) {
            filesHover = path
            hoverY = py
            if (k >= 0) {
                hoverW = (itemAt imgW k)
                hoverH = (itemAt imgH k)
            }
            this.rebuild()
        }
    }

    fn filesHas:boolean (px:double py:double) {
        if ((filesOpen == false) || quiet) {
            return false
        }
        def hh:double filesH
        if ((strlen filesOpenPath) > 0) {
            hh = (PresPanels.filesBarH())
        }
        return ((((px >= filesX) && (px <= (filesX + filesW))) && (py >= filesY)) && (py <= (filesY + hh)))
    }

    fn filesPress:void (px:double py:double shift:boolean) {
        def c:string (this.ownerAt(px py))
        if (c == "pf-all") {
            filesPick.toggleAll()
            filesArmed = ""
            this.rebuild()
            return
        }
        if ((indexOf c "pf-c-") == 0) {
            def bk:int (?? (str2int (substring c 5 (strlen c))) -1)
            if ((bk >= 0) && (bk < (array_length filesBoxes))) {
                def bp:string (itemAt filesBoxes bk)
                if shift {
                    filesPick.extendTo(bp)
                } {
                    filesPick.toggle(bp)
                }
                filesArmed = ""
                this.rebuild()
            }
            return
        }
        if (c == "pf-copy") {
            if ((filesPick.count()) > 0) {
                push requests ("files:copy:" + (this.pickedText()))
            }
            return
        }
        if (c == "pf-bulkdel") {
            if ((filesPick.count()) == 0) {
                return
            }
            if (filesArmed != "bulkdel") {
                ; the first press only asks
                filesArmed = "bulkdel"
                this.rebuild()
                return
            }
            filesArmed = ""
            push requests ("files:delmany:" + (this.pickedText()))
            filesPick.none()
            this.rebuild()
            return
        }
        if (c == "pf-paste") {
            push requests "files:paste"
            return
        }
        if (c == "pf-back") {
            push requests "files:back"
            return
        }
        if (c == "pf-add") {
            push requests "files:add"
            return
        }
        if (c == "pf-promo") {
            push requests "files:promo"
            return
        }
        if ((indexOf c "pf-k-") == 0) {
            def k:int (?? (str2int (substring c 5 (strlen c))) -1)
            if ((k >= 0) && (k < (array_length filesKeys))) {
                def key:string (itemAt filesKeys k)
                def tab:int (indexOf key (strfromcode 9))
                def action:string (substring key 0 tab)
                def what:string (substring key (tab + 1) (strlen key))
                if ((action == "del") || (action == "unlink")) {
                    if (filesArmed != key) {
                        ; the first press only asks
                        filesArmed = key
                        this.rebuild()
                        return
                    }
                    filesArmed = ""
                }
                push requests ("files:" + action + ":" + what)
                return
            }
        }
        ; a picture's row, not one of its buttons: the image editor
        if ((strlen c) == 0) {
            def k:int (this.imgRowAt(px py))
            if (k >= 0) {
                def path:string (itemAt imgPaths k)
                if (PresPanels.editable(path)) {
                    filesHover = ""
                    filesArmed = ""
                    push requests ("files:imgedit:" + path)
                    this.rebuild()
                    return
                }
            }
        }
        if (filesArmed != "") {
            filesArmed = ""
            this.rebuild()
        }
    }

    fn filesScrollBy:void (dy:double) {
        filesScroll = (filesScroll + dy)
        if (filesScroll < 0.0) {
            filesScroll = 0.0
        }
        this.rebuild()
    }

    ; --- the share dialog -------------------------------------------------------------
    fn shareDialog:EVGElement () {
        def d:EVGElement (UiKit.div("pn-dialog"))
        d.id = "pn-dialog"
        UiTree.surface(d "free" "start")
        d.overlayX = ((w - 520.0) * 0.5)
