            tall = 440.0
        }
        d.overlayY = ((h - tall) * 0.5)
        d.addChild((UiKit.words("pn-dtitle" (PresI18n.t("Share presentation")))))
        d.addChild((this.shareOption("show" (PresI18n.t("Presentation")) (PresI18n.t("Opens straight into presentation mode, without the editor or edit buttons.")) shareShow "primary")))
        if ((strlen shareView) > 0) {
            def title:string ((PresI18n.t("Selected slides")) + " (" + (to_string shareViewCount) + ")")
            def desc:string (PresI18n.t("Only these slides, in presentation mode. They follow the presentation's changes; the presentation itself stays whole."))
            if (shareViewLive == false) {
