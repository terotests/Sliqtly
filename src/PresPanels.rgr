        if ((strlen shareEdit) > 0) {
            d.addChild((this.shareOption("edit" (PresI18n.t("Editing")) (PresI18n.t("Opens in the editor: the recipient can edit their own copy.")) shareEdit "secondary")))
        } {
            ; in the cloud: no editing link, only the people invited edit it
            def o:EVGElement (UiKit.div("pn-opt"))
            o.addChild((UiKit.words("pn-otitle" (PresI18n.t("Editing")))))
            def who:string (PresI18n.t("Only you edit this presentation. The people you invite edit it too; nobody else."))
            if (shareEditors > 0) {
                who = (PresInvite.withCount((PresI18n.t("You and {n} people you invited edit this presentation; nobody else.")) shareEditors))
            }
            o.addChild((UiKit.words("pn-odesc" who)))
            if (shareEditors >= 0) {
                def row:EVGElement (UiKit.div("pn-orow"))
                this.button("pn-share-invite" (PresI18n.t("People who can edit…")) "secondary" row)
                this.button("pn-share-stop" (PresI18n.t("Stop sharing")) "secondary" row)
                o.addChild(row)
            }
            d.addChild(o)
        }
        def foot:EVGElement (UiKit.div("pn-dfoot"))
        foot.addChild((this.copyable("pn-share-note" "pn-note" shareNote)))
        foot.addChild((UiKit.div("pn-grow")))
        this.button("pn-share-close" (PresI18n.t("Close")) "secondary" foot)
        d.addChild(foot)
        return d
    }

    ; Open: a presentation, data or a picture from the computer, or one of the
