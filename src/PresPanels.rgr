    ; --- the presentations window (File → Presentations…) -------------------------
    fn decksW:double () {
        def dw:double 760.0
        if (dw > (w - 24.0)) {
            dw = (w - 24.0)
        }
        return dw
    }

    ; rows a page holds: what the page leaves besides the window's title,
    ; column heads, pager and foot (about 220 px), at 42 px a row
    fn decksPageSize:int () {
        def room:double ((h - 40.0) - 220.0)
        if (room > 420.0) {
            room = 420.0
        }
        def n:int (to_int (room / 42.0))
        if (n < 3) {
            n = 3
        }
        return n
    }

    ; on a narrow window the times go under the name, the modified one only
    fn decksNarrow:boolean () {
        return ((this.decksW()) < 600.0)
    }

    ; A column's head: pressed, the list is sorted by it.
    ; Pressed again, the order turns round (web/decklist.js nextSort); the
    ; arrow shows the way: ↓ newest or Z first, ↑ oldest or A first.
    fn decksHead:void (key:string label:string sort:string dir:string cls:string parent:EVGElement) {
        def cell:EVGElement (UiKit.div(cls))
        def text:string label
        if (key == sort) {
            if (dir == "asc") {
                text = (label + " ↑")
            } {
                text = (label + " ↓")
            }
        }
        def b:ButtonCtl (this.button(("pd-sort-" + key) text "ghost" cell))
        UiTree.addClass((unwrap b.rootEl) "pd-sorthead")
        if (cls == "pd-when") {
            UiTree.addClass((unwrap b.rootEl) "pd-sorttime")
        }
        if (key == sort) {
            UiTree.addClass((unwrap b.rootEl) "pd-sorted")
        }
        parent.addChild(cell)
    }

    sfn clip:string (text:string most:int) {
        if ((strlen text) <= most) {
            return text
        }
        if (most < 2) {
            return "…"
        }
        return ((trim (substring text 0 (most - 1))) + "…")
    }

    fn decksDialog:EVGElement () {
        def keys:[string]
        decksKeys = keys
        def dw:double (this.decksW())
        def narrow:boolean (this.decksNarrow())
        def p0 (new VlJsonParser())
        def data:VlJson (p0.parse(decksJson))
        def ready:boolean ((p0.ok) && (data.isObject()))
        def rows:VlJson (new VlJson())
        def count:int 0
        if ready {
            rows = (data.get("rows"))
            count = (rows.count())
        }
        decksPager.total = count
        decksPager.pageSize = (this.decksPageSize())
        decksPager.page = (decksPager.clampPage(decksPager.page))
        def paged:boolean ((decksPager.pageCount()) > 1)
        def from:int ((decksPager.page - 1) * decksPager.pageSize)
        def until:int (from + decksPager.pageSize)
        if (until > count) {
            until = count
        }
        def shown:int (until - from)
        if (shown < 1) {
            shown = 1
        }
        def estH:double (176.0 + ((to_double shown) * 42.0))
        if paged {
            estH = (estH + 44.0)
        }
        ; pd-dialog, not pn-dialog: that one's width is fixed in the theme
        def d:EVGElement (UiKit.div("pd-dialog"))
        d.id = "pn-dialog"
        UiTree.surface(d "free" "start")
        d.width = (EVGUnit.px(dw))
        d.overlayX = ((w - dw) * 0.5)
        d.overlayY = ((h - estH) * 0.5)
        def top:EVGElement (UiKit.div("pd-top"))
        top.addChild((UiKit.words("pn-dtitle" (PresI18n.t("Presentations")))))
        top.addChild((UiKit.div("pn-grow")))
        this.button("pd-new" (PresI18n.t("New presentation")) "secondary" top)
        d.addChild(top)
        def sort:string "updated"
        def dir:string "desc"
        if ready {
            sort = (data.stringOr("sort" "updated"))
            dir = (data.stringOr("dir" "desc"))
        }
        ; the inner width of a row: the window less its padding
        def rowW:double (dw - 40.0)
        def head:EVGElement (UiKit.div("pd-head"))
        def hn:EVGElement (UiKit.div("pd-hrow"))
        hn.width = (EVGUnit.px((rowW - 36.0)))
        this.decksHead("name" (PresI18n.t("Name")) sort dir "pd-hname" hn)
        if narrow {
            this.decksHead("updated" (PresI18n.t("Modified")) sort dir "pd-hnarrow" hn)
        } {
            this.decksHead("created" (PresI18n.t("Added")) sort dir "pd-when" hn)
            this.decksHead("updated" (PresI18n.t("Modified")) sort dir "pd-when" hn)
        }
        head.addChild(hn)
        d.addChild(head)
        def body:EVGElement (UiKit.div("pd-body"))
        if (ready == false) {
            body.addChild((UiKit.words("pn-intro" (PresI18n.t("Loading…")))))
        } {
            def i:int from
            while (i < until) {
                body.addChild((this.deckRow((rows.at(i)) narrow rowW)))
                i = (i + 1)
            }
            if (count == 0) {
                body.addChild((UiKit.words("pn-intro" (PresI18n.t("A presentation is saved here when you edit it.")))))
            }
        }
        d.addChild(body)
        if paged {
            d.addChild((this.decksPagerRow(rowW)))
        }
        def foot:EVGElement (UiKit.div("pn-dfoot"))
        def note:EVGElement (UiKit.div("pd-note"))
        if ready {
            note.addChild((this.copyable("pd-note-text" "pn-note" (data.stringOr("note" "")))))
        }
        foot.addChild(note)
        this.button("pd-close" (PresI18n.t("Close")) "secondary" foot)
        d.addChild(foot)
        return d
    }

    ; ‹ 1 2 … 5 ›, and which rows of how many show
    fn decksPagerRow:EVGElement (rowW:double) {
        def row:EVGElement (UiKit.div("pd-pager"))
        row.width = (EVGUnit.px(rowW))
        def pv:ButtonCtl (this.button("pd-pg-prev" "‹" "ghost" row))
        pv.disabled = ((decksPager.canPrevious()) == false)
        pv.build()
        UiTree.addClass((unwrap pv.rootEl) "pd-pg")
        def items:[string] (decksPager.items())
        def i:int 0
        while (i < (array_length items)) {
            def it:string (itemAt items i)
            if (PaginationCtl.isEllipsis(it)) {
                row.addChild((UiKit.words("pd-pg-gap" "…")))
            } {
                def variant:string "ghost"
                if (it == (to_string decksPager.page)) {
                    variant = "secondary"
                }
                def b:ButtonCtl (this.button(("pd-pg-" + it) it variant row))
                UiTree.addClass((unwrap b.rootEl) "pd-pg")
            }
            i = (i + 1)
        }
        def nx:ButtonCtl (this.button("pd-pg-next" "›" "ghost" row))
        nx.disabled = ((decksPager.canNext()) == false)
        nx.build()
        UiTree.addClass((unwrap nx.rootEl) "pd-pg")
        row.addChild((UiKit.div("pn-grow")))
        def first:int (((decksPager.page - 1) * decksPager.pageSize) + 1)
        def last:int (decksPager.page * decksPager.pageSize)
        if (last > decksPager.total) {
            last = decksPager.total
        }
        row.addChild((UiKit.words("pd-time pd-range" ((((to_string first) + "–") + (to_string last)) + (" / " + (to_string decksPager.total))))))
        return row
    }

    ; A deck's row: the row itself opens it (it lights up under the pointer);
    ; the ✕ beside it, in a column of its own, deletes a deck kept here.
    fn deckRow:EVGElement (r:VlJson narrow:boolean rowW:double) {
        def id:string (r.stringOr("id" ""))
        def k:int (array_length decksKeys)
        push decksKeys id
        def armed:boolean (decksArmed == id)
        def delW:double 36.0
        if armed {
            delW = 84.0
        }
        def line:EVGElement (UiKit.div("pd-line"))
        line.width = (EVGUnit.px(rowW))
        def b:ButtonCtl (this.button(("pd-r-" + (to_string k)) "" "ghost" line))
        def el:EVGElement (unwrap b.rootEl)
        UiTree.addClass(el "pd-open")
        if (r.boolOr("current" false)) {
            UiTree.addClass(el "pd-cur")
        }
        UiTree.clearChildren(el)
        ; the name's room in characters, about 7 px each, less the columns
        def nameW:double ((rowW - delW) - 16.0)
        if (narrow == false) {
            nameW = (nameW - 280.0)
        }
        def nm:EVGElement (UiKit.div("pf-name pd-name"))
        def title:string (PresPanels.clip((r.stringOr("name" "")) (to_int (nameW / 7.0))))
        nm.addChild((UiKit.words("pf-fname" title)))
        def where:string (r.stringOr("where" ""))
        if (r.boolOr("current" false)) {
            where = (((PresI18n.t("open")) + " · ") + where)
        }
        if narrow {
            where = ((where + " · ") + (r.stringOr("modified" "")))
        }
        nm.addChild((UiKit.words("pf-fsize" where)))
        el.addChild(nm)
        if (narrow == false) {
            el.addChild((UiKit.words("pd-when pd-time" (r.stringOr("added" "")))))
            el.addChild((UiKit.words("pd-when pd-time" (r.stringOr("modified" "")))))
        }
        def del:EVGElement (UiKit.div("pd-del"))
        del.width = (EVGUnit.px(delW))
        ; the open deck, and one only in the cloud, are deleted with File →
        ; Delete presentation… once open
        if (((r.boolOr("cloudOnly" false)) == false) && ((r.boolOr("current" false)) == false)) {
            def x:ButtonCtl (this.button(("pd-x-" + (to_string k)) (? armed (PresI18n.t("Delete?")) "✕") (? armed "primary" "ghost") del))
            UiTree.addClass((unwrap x.rootEl) "pf-act")
        }
        line.addChild(del)
        return line
    }

    ; "pd-r-<n>" / "pd-x-<n>" → the deck id of row n on the page, or ""
    fn deckOf:string (c:string) {
        def k:int (?? (str2int (substring c 5 (strlen c))) -1)
        if ((k >= 0) && (k < (array_length decksKeys))) {
            return (itemAt decksKeys k)
        }
        return ""
    }

    fn decksPress:void (px:double py:double) {
        def c:string (this.ownerAt(px py))
        if (c == "pd-new") {
            push requests "files:new"
            this.closeShare()
            return
        }
        if ((indexOf c "pd-sort-") == 0) {
            decksPager.page = 1
            push requests ("decks:sort:" + (substring c 8 (strlen c)))
            return
        }
        if ((indexOf c "pd-pg-") == 0) {
            def what:string (substring c 6 (strlen c))
            def moved:boolean false
            if (what == "prev") {
                moved = (decksPager.previous())
            } {
                if (what == "next") {
                    moved = (decksPager.next())
                } {
                    moved = (decksPager.setPage((?? (str2int what) decksPager.page)))
                }
            }
            if moved {
                decksArmed = ""
                this.rebuild()
            }
            return
        }
        if ((indexOf c "pd-r-") == 0) {
            def id:string (this.deckOf(c))
            if ((strlen id) > 0) {
                push requests ("files:doc:" + id)
                this.closeShare()
            }
            return
        }
        if ((indexOf c "pd-x-") == 0) {
            def id2:string (this.deckOf(c))
            if ((strlen id2) > 0) {
                if (decksArmed != id2) {
                    ; the first press only asks
                    decksArmed = id2
                    this.rebuild()
                    return
                }
                decksArmed = ""
                push requests ("decks:del:" + id2)
            }
            return
        }
        if ((c == "pd-close") || ((this.inEl("pn-dialog" px py)) == false)) {
            this.closeShare()
            return
        }
        if (decksArmed != "") {
            decksArmed = ""
            this.rebuild()
        }
    }

    ; the wheel over the window turns its pages, a page a notch (a trackpad's
    ; many small steps add up to one)
    fn decksWheel:void (dy:double) {
        decksWheelSum = (decksWheelSum + dy)
        if ((fabs decksWheelSum) < 100.0) {
            return
        }
        def moved:boolean false
        if (decksWheelSum > 0.0) {
            moved = (decksPager.next())
        } {
            moved = (decksPager.previous())
        }
        decksWheelSum = 0.0
        if moved {
            decksArmed = ""
            this.rebuild()
        }
    }

    ; --- the settings dialog -------------------------------------------------------------
    fn settingsDialog:EVGElement () {
        def d:EVGElement (UiKit.div("pn-dialog"))
        d.id = "pn-dialog"
        UiTree.surface(d "free" "start")
        d.overlayX = ((w - 520.0) * 0.5)
        d.overlayY = ((h - 490.0) * 0.5)
        d.addChild((UiKit.words("pn-dtitle" (PresI18n.t("Settings")))))
        def o:EVGElement (UiKit.div("pn-opt"))
        o.addChild((UiKit.words("pn-otitle" (PresI18n.t("Automatic contrast correction")))))
        o.addChild((UiKit.words("pn-odesc" (PresI18n.t("Text too faint on its slide is made readable: small text gets a lighter or darker colour, big text a thin outline. Your own colours stay as they are wherever they already read well.")))))
        def r:EVGElement (UiKit.div("pn-orow"))
        def label:string (PresI18n.t("On"))
        def variant:string "primary"
        if (autoContrast == false) {
            label = (PresI18n.t("Off"))
            variant = "secondary"
        }
        this.button("pn-set-contrast" label variant r)
        o.addChild(r)
        d.addChild(o)
        ; The editor's look; the slides keep their own theme in either.
        def lk:EVGElement (UiKit.div("pn-opt"))
        lk.addChild((UiKit.words("pn-otitle" (PresI18n.t("Look")))))
        lk.addChild((UiKit.words("pn-odesc" (PresI18n.t("How the editor around the slides looks. Your slides and their themes stay as they are.")))))
        def lr:EVGElement (UiKit.div("pn-orow"))
        this.button("pn-set-skin-light" (PresI18n.t("Standard")) (? (skin != "retro") "primary" "secondary") lr)
        this.button("pn-set-skin-retro" (PresI18n.t("Retro")) (? (skin == "retro") "primary" "secondary") lr)
        lk.addChild(lr)
        if (skin != "retro") {
            ; the standard skin in light or dark, or as the device is set
            def mr:EVGElement (UiKit.div("pn-orow"))
            this.button("pn-set-mode-system" (PresI18n.t("Automatic")) (? (lookMode == "system") "primary" "secondary") mr)
            this.button("pn-set-mode-light" (PresI18n.t("Light mode")) (? (lookMode == "light") "primary" "secondary") mr)
            this.button("pn-set-mode-dark" (PresI18n.t("Dark mode")) (? (lookMode == "dark") "primary" "secondary") mr)
            lk.addChild(mr)
            ; the frame (the bar and the left rail) white or in the logo's terracotta
            def fr:EVGElement (UiKit.div("pn-orow"))
            this.button("pn-set-frame-white" (PresI18n.t("White frame")) (? (lookFrame != "terracotta") "primary" "secondary") fr)
            this.button("pn-set-frame-terracotta" (PresI18n.t("Terracotta frame")) (? (lookFrame == "terracotta") "primary" "secondary") fr)
            lk.addChild(fr)
        }
        if (skin == "retro") {
            ; the skin's base colour: one hue every shade of it follows
            def hr:EVGElement (UiKit.div("pn-orow"))
            def names:[string] (PresPanels.hueNames())
            def hues:[int] (PresPanels.hueValues())
            def i:int 0
            while (i < (array_length hues)) {
                def hv:int (itemAt hues i)
                def b:ButtonCtl (this.button(("pn-set-hue-" + (to_string hv)) (PresI18n.t((itemAt names i))) (? ((to_int skinHue) == hv) "primary" "secondary") hr))
                def sw:EVGElement (this.swatch((((("hsl(" + (to_string hv)) + " 70% 50%)")))))
                def br:EVGElement (unwrap b.rootEl)
                br.addChild(sw)
                i = (i + 1)
            }
            lk.addChild(hr)
        }
        d.addChild(lk)
        ; what a room is called (PresTerm); written as it is, not swapped
        def tw:EVGElement (UiKit.div("pn-opt"))
        tw.addChild((UiKit.words("pn-otitle" (PresI18n.plain("Name for rooms")))))
        tw.addChild((UiKit.words("pn-odesc" (PresI18n.plain("A room gathers the presentations of one whole piece of work. Call them rooms or projects; the editor opens again with the word you choose.")))))
        def tr:EVGElement (UiKit.div("pn-orow"))
        def word:string (PresI18n.term())
        this.button("pn-set-term-room" (PresI18n.plain("Room")) (? (word == "room") "primary" "secondary") tr)
        this.button("pn-set-term-project" (PresI18n.plain("Project")) (? (word == "project") "primary" "secondary") tr)
        tw.addChild(tr)
        d.addChild(tw)
        def foot:EVGElement (UiKit.div("pn-dfoot"))
        foot.addChild((UiKit.div("pn-grow")))
        this.button("pn-set-close" (PresI18n.t("Close")) "secondary" foot)
        d.addChild(foot)
        return d
    }

    ; --- the import dialog --------------------------------------------------------------
    ; A data file: its first rows, and what to make of it.
    fn dataDialog:EVGElement () {
        def none:[SelectCtl]
        dataSels = none
        def d:EVGElement (UiKit.div("pn-dialog"))
        d.id = "pn-dialog"
        UiTree.inline(d "width" "640px")
        UiTree.surface(d "free" "start")
        d.overlayX = ((w - 640.0) * 0.5)
        d.overlayY = ((h - 520.0) * 0.5)
        d.addChild((UiKit.words("pn-dtitle" (? imp.live (PresI18n.t("Link live data")) (PresI18n.t("Import data"))))))
        def info:string ((((imp.name + " · ") + (to_string imp.rows)) + " ") + (PresI18n.t("rows")))
        info = (((info + " · ") + (to_string (imp.cols()))) + " ") + (PresI18n.t("columns"))
        d.addChild((UiKit.words("pn-odesc" info)))
        if imp.live {
            d.addChild((UiKit.words("pn-odesc" (PresI18n.t("The chart or table reads this address each time the presentation opens, so it shows what the sheet has then. Nothing is copied into the presentation.")))))
        }
        if ((imp.sheetCount()) > 1) {
            def sr:EVGElement (UiKit.div("pn-field"))
            sr.addChild((UiKit.words("pn-flabel" (PresI18n.t("Sheet")))))
            def sel:SelectCtl (this.dataSelect("pn-d-sheet"))
            def i:int 0
            while (i < (imp.sheetCount())) {
                sel.addItem((to_string i) (itemAt imp.sheetNames i) false)
                i = (i + 1)
            }
            this.finishSelect(sel (to_string imp.sheet) sr)
            d.addChild(sr)
        }
        d.addChild((this.dataPreview()))
        if (imp.step == "chart") {
            this.chartStep(d)
        } {
            this.pickStep(d)
        }
        return d
    }

    ; The header and the first rows, a few columns of each.
    fn dataPreview:EVGElement () {
        def g:EVGElement (UiKit.div("pn-grid"))
        def nc:int (imp.cols())
        def shown:int nc
        if (shown > 6) {
            shown = 6
        }
        if (shown == 0) {
            g.addChild((UiKit.words("pn-note" (PresI18n.t("No rows in this sheet.")))))
            return g
        }
        def cw:double (576.0 / (to_double shown))
        def last:int imp.rows
        if (last > 5) {
            last = 5
        }
        def r:int 0
        while (r <= last) {
            def row:EVGElement (UiKit.div("pn-grid-row"))
            if (r == 0) {
                row.className = "pn-ghead"
            }
            def c:int 0
            while (c < shown) {
                def v:string (imp.model.getCell(r c))
                if ((strlen v) > 18) {
                    v = ((substring v 0 17) + "…")
                }
                def cell:EVGElement (UiKit.words((? (r == 0) "pn-hcell" "pn-cell") v))
                UiTree.inline(cell "width" ((to_string (to_int cw)) + "px"))
                row.addChild(cell)
                c = (c + 1)
            }
            g.addChild(row)
            r = (r + 1)
        }
        if ((imp.rows > 5) || (nc > shown)) {
            def more:string ""
            if (imp.rows > 5) {
                more = ((to_string (imp.rows - 5)) + " " + (PresI18n.t("more rows")))
            }
            if (nc > shown) {
                if ((strlen more) > 0) {
                    more = (more + " · ")
                }
                more = ((more + (to_string (nc - shown))) + " " + (PresI18n.t("more columns")))
            }
            g.addChild((UiKit.words("pn-gmore" more)))
        }
        return g
    }

    fn pickStep:void (d:EVGElement) {
        d.addChild((this.dataChoice("chart" (PresI18n.t("Chart")) (PresI18n.t("Pick the columns; Sliqtly suggests the chart type.")) (PresI18n.t("Make a chart")) "primary")))
        if ((strlen imp.xlsx) > 0) {
            d.addChild((this.dataChoice("workbook" (PresI18n.t("Live spreadsheet")) (PresI18n.t("The workbook itself on the slide: explore it, or edit it, while presenting.")) (PresI18n.t("Put on a slide")) "secondary")))
        }
        d.addChild((this.dataChoice("table" (PresI18n.t("Table")) (PresI18n.t("All rows on one slide, page by page: ‹ 1/5 › in the show.")) (PresI18n.t("Make a table")) "secondary")))
        if imp.live {
            d.addChild((this.dataChoice("file" (PresI18n.t("Just the address")) (PresI18n.t("Pasted into the text as it is.")) (PresI18n.t("Paste as text")) "secondary")))
        } {
            d.addChild((this.dataChoice("file" (PresI18n.t("Just the file")) (PresI18n.t("Kept under data/ for charts and tables to use.")) (PresI18n.t("Add file")) "secondary")))
        }
        def foot:EVGElement (UiKit.div("pn-dfoot"))
        foot.addChild((UiKit.div("pn-grow")))
        this.button("pn-d-close" (PresI18n.t("Cancel")) "secondary" foot)
        d.addChild(foot)
    }

    fn dataChoice:EVGElement (which:string title:string desc:string label:string variant:string) {
        def o:EVGElement (UiKit.div("pn-choice"))
        def tx:EVGElement (UiKit.div("pn-ctext"))
        tx.addChild((UiKit.words("pn-otitle" title)))
        tx.addChild((UiKit.words("pn-odesc" desc)))
        o.addChild(tx)
        o.addChild((UiKit.div("pn-grow")))
        this.button(("pn-d-" + which) label variant o)
        return o
    }

    ; The chart's question: grouped by what, which numbers, combined how,
    ; drawn as what. Every part starts at what the columns suggest.
    fn chartStep:void (d:EVGElement) {
        def cr:EVGElement (UiKit.div("pn-field"))
        cr.addChild((UiKit.words("pn-flabel" (PresI18n.t("Group by")))))
        def cs:SelectCtl (this.dataSelect("pn-d-cat"))
        cs.addItem("-1" (PresI18n.t("Each row on its own")) false)
        def c:int 0
        while (c < (imp.cols())) {
            cs.addItem((to_string c) (itemAt imp.headers c) false)
            c = (c + 1)
        }
        this.finishSelect(cs (to_string imp.catCol) cr)
        d.addChild(cr)

        def vr:EVGElement (UiKit.div("pn-field"))
        vr.addChild((UiKit.words("pn-flabel" (PresI18n.t("Values")))))
        def chips:EVGElement (UiKit.div("pn-chips"))
        def any:boolean false
        def k:int 0
        while (k < (imp.cols())) {
            if ((k != imp.catCol) && (imp.isMeasure(k))) {
                def on:boolean (itemAt imp.valueOn k)
                def label:string (itemAt imp.headers k)
                if on {
                    label = ("✓ " + label)
                }
                def b:ButtonCtl (this.button(("pn-d-v-" + (to_string k)) label (? on "primary" "secondary") chips))
                UiTree.addClass((unwrap b.rootEl) "pn-chip")
                any = true
            }
            k = (k + 1)
        }
        if (any == false) {
            chips.addChild((UiKit.words("pn-note" (PresI18n.t("No columns of numbers: the chart counts rows.")))))
        }
        vr.addChild(chips)
        d.addChild(vr)

        def ar:EVGElement (UiKit.div("pn-field"))
        ar.addChild((UiKit.words("pn-flabel" (PresI18n.t("Combine")))))
        def as:SelectCtl (this.dataSelect("pn-d-agg"))
        as.addItem("auto" (PresI18n.t("Automatic")) false)
        as.addItem("sum" (PresI18n.t("Sum")) false)
        as.addItem("avg" (PresI18n.t("Average")) false)
        as.addItem("count" (PresI18n.t("Count rows")) false)
        as.addItem("none" (PresI18n.t("Each row as it is")) false)
        this.finishSelect(as imp.agg ar)
        d.addChild(ar)

        def kr:EVGElement (UiKit.div("pn-field"))
        kr.addChild((UiKit.words("pn-flabel" (PresI18n.t("Chart type")))))
        def ks:SelectCtl (this.dataSelect("pn-d-kind"))
        def kinds:[int] (PresImport.kinds())
        def i:int 0
        while (i < (array_length kinds)) {
            def kk:int (itemAt kinds i)
            def name:string (PresChartModel.kindLabel(kk))
            if (kk == imp.suggested) {
                name = ((name + " · ") + (PresI18n.t("suggested")))
            }
            ks.addItem((to_string kk) name false)
            i = (i + 1)
        }
        this.finishSelect(ks (to_string imp.kind) kr)
        d.addChild(kr)

        def m:PresChartModel (imp.chartModel())
        def foot:EVGElement (UiKit.div("pn-dfoot"))
        def note:string ""
        if m.ok {
            note = ((((to_string (m.rows())) + " ") + (PresI18n.t("categories"))) + " · ") + (PresI18n.t("the chart editor opens next"))
        } {
            note = m.note
        }
        foot.addChild((UiKit.words("pn-note" note)))
        foot.addChild((UiKit.div("pn-grow")))
        this.button("pn-d-back" (PresI18n.t("Back")) "secondary" foot)
        this.button("pn-d-make" (PresI18n.t("Create chart")) "primary" foot)
        d.addChild(foot)
    }

    fn dataSelect:SelectCtl (tid:string) {
        def sel (new SelectCtl())
        sel.tid = tid
        sel.name = tid
        return sel
    }

    fn finishSelect:void (sel:SelectCtl value:string parent:EVGElement) {
        sel.value = value
        sel.build()
        UiTree.addClass((unwrap sel.rootEl) "pn-dsel")
        push dataSels sel
        UiKit.put(host sel parent)
        if (dataOpenSel == sel.tid) {
            sel.openList()
            sel.build()
        }
    }

    fn dataSel@(optional):SelectCtl (tid:string) {
        def i:int 0
        while (i < (array_length dataSels)) {
            def s:SelectCtl (itemAt dataSels i)
            if (s.tid == tid) {
                def hit@(optional):SelectCtl s
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):SelectCtl
        return miss
    }

    ; A select of the import dialog changed: the question with it.
    fn dataChanged:void (tid:string v:string) {
        if (tid == "pn-d-sheet") {
            imp.useSheet((?? (str2int v) 0))
        }
        if (tid == "pn-d-cat") {
            imp.catCol = (?? (str2int v) -1)
        }
        if (tid == "pn-d-agg") {
            imp.agg = v
        }
        if (tid == "pn-d-kind") {
            imp.kind = (?? (str2int v) 1)
        }
    }

    fn dataPress:void (px:double py:double) {
        def oc:string (this.ownerAt(px py))
        def s@(optional):SelectCtl (this.dataSel(oc))
        if (!null? s) {
            def sel:SelectCtl (unwrap s)
            def before:string sel.value
            host.click((host.hitTest(px py)))
            sel.build()
            dataOpenSel = (? sel.open sel.tid "")
            if (sel.value != before) {
                dataOpenSel = ""
                this.dataChanged(sel.tid sel.value)
                this.rebuild()
                return
            }
            rev = (rev + 1)
            return
        }
        if ((strlen dataOpenSel) > 0) {
            dataOpenSel = ""
            this.rebuild()
            return
        }
        if (oc == "pn-d-chart") {
            imp.step = "chart"
            this.rebuild()
            return
        }
        if (oc == "pn-d-back") {
            imp.step = "pick"
            this.rebuild()
            return
        }
        if ((indexOf oc "pn-d-v-") == 0) {
            imp.toggleValue((?? (str2int (substring oc 7 (strlen oc))) -1))
            this.rebuild()
            return
        }
        if (oc == "pn-d-make") {
            def m:PresChartModel (imp.chartModel())
            if m.ok {
                push requests "data:chart"
                this.closeShare()
            }
            return
        }
        if ((oc == "pn-d-table") || (oc == "pn-d-file") || (oc == "pn-d-workbook")) {
            push requests ("data:" + (substring oc 5 (strlen oc)))
            this.closeShare()
            return
        }
        if ((oc == "pn-d-close") || ((this.inEl("pn-dialog" px py)) == false)) {
            this.closeShare()
        }
    }

    fn shareOption:EVGElement (which:string title:string desc:string url:string variant:string) {
        def o:EVGElement (UiKit.div("pn-opt"))
        o.addChild((UiKit.words("pn-otitle" title)))
        o.addChild((UiKit.words("pn-odesc" desc)))
        def row:EVGElement (UiKit.div("pn-orow"))
        def f (new InputCtl())
        f.tid = ("pn-url-" + which)
        f.name = title
        ; shown to be copied with the button beside it, never typed in
        f.readOnly = true
        f.boxClass = "pn-url"
        f.setValue(url)
        f.build()
        UiKit.put(host f row)
        def label:string (PresI18n.t("Copy"))
        if (copied == which) {
            label = (? copyOk (PresI18n.t("Copied ✓")) (PresI18n.t("Select and copy")))
        }
        this.button(("pn-copy-" + which) label variant row)
        o.addChild(row)
        return o
    }

    ; --- drawing ------------------------------------------------------------------------
    fn page:EVGElement () {
        def r:EVGElement (unwrap host.root)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h false)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        lay.layout(pg)
        ; the dialog in the middle, now that its height is known, and on the
        ; page (`holdDialog` keeps it no taller)
        if shareOpen {
            def d@(optional):EVGElement (host.findEl(r "pn-dialog"))
            if (!null? d) {
                def de:EVGElement (unwrap d)
                ; its scrolling part as tall as the page leaves it
                def inner@(optional):EVGElement (host.findEl(de "pn-dscroll"))
                if (!null? inner) {
                    def ie:EVGElement (unwrap inner)
                    def chrome:double (de.calculatedHeight - ie.calculatedHeight)
                    if (((chrome - dlgChrome) * (chrome - dlgChrome)) > 0.25) {
                        dlgChrome = chrome
                        this.fitDialog(ie)
                        lay.layout(pg)
                    }
                }
                def left:double ((w - de.calculatedWidth) * 0.5)
                if (left < 8.0) {
                    left = 8.0
                }
                def top:double ((h - de.calculatedHeight) * 0.5)
                if (top < 8.0) {
                    top = 8.0
                }
                ; laid out again only when it moved: a second pass over a
                ; scrolled dialog measured its content short by the scroll
                ; (the wheel then stopped before the end)
                if ((de.overlayX != left) || (de.overlayY != top)) {
                    de.overlayX = left
                    de.overlayY = top
                    lay.layout(pg)
                }
                if (!null? inner) {
                    def ie2:EVGElement (unwrap inner)
                    dlgScroll.top = ie2.scrollTop
                }
            }
        }
        ; the scroll as the layout clamped it
        if helpOpen {
            def v@(optional):EVGElement (host.findEl(r "pn-view"))
            if (!null? v) {
                def ve:EVGElement (unwrap v)
                helpScroll = ve.scrollTop
            }
        }
        if (filesOpen && ((strlen filesOpenPath) == 0)) {
            def fv@(optional):EVGElement (host.findEl(r "pf-view"))
            if (!null? fv) {
                def fe:EVGElement (unwrap fv)
                filesScroll = fe.scrollTop
            }
        }
        ; the fields draw their caret and selection on what was laid out
        host.placeText((lay.getTextEngine()))
        host.lastPage = pg
        return pg
    }

    ; --- the layers ------------------------------------------------------------------
    ; The panels are three layers of the app's z-order (UiLayers): the docked
    ; help and files ("docked"), the modal dialog with its backdrop ("dialog")
    ; and the toast ("toast"). They are laid out together and drawn as three
    ; display lists, so a window the app opens can sit between them.
    sfn partOf:string (id:string) {
        if ((id == "pn-dialog") || (id == "pn-backdrop")) {
            return "dialog"
        }
        if (id == "pn-toast") {
            return "toast"
        }
        return "docked"
    }

    fn toastOpen:boolean () {
        return ((strlen toastText) > 0)
    }

    fn dockedHas:boolean (px:double py:double) {
        return ((((this.helpHas(px py)) || (this.filesHas(px py))) || (this.chatHas(px py))) || (this.callHas(px py)))
    }

    fn toastHas:boolean (px:double py:double) {
        if ((this.toastOpen()) == false) {
            return false
        }
        return (this.inEl("pn-toast" px py))
    }

    ; One layer's display list: the page laid out whole, the other layers'
    ; surfaces left out of the walk (`display: none` after the layout, so
    ; nothing moves) and put back.
    fn partList:EVGDisplayList (part:string) {
        def pg:EVGElement (this.page())
        def r:EVGElement (unwrap host.root)
        def was:[string]
        def i:int 0
        while (i < (array_length r.children)) {
            def c:EVGElement (itemAt r.children i)
            push was c.display
            if ((PresPanels.partOf(c.id)) != part) {
                c.display = "none"
            }
            i = (i + 1)
        }
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        def k:int 0
        while (k < (array_length r.children)) {
            def ck:EVGElement (itemAt r.children k)
            ck.display = (itemAt was k)
            k = (k + 1)
        }
        return dl
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.page())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; --- the pointer ---------------------------------------------------------------------
    fn helpHas:boolean (px:double py:double) {
        return (((helpOpen && (quiet == false)) && (px >= (w - helpW))) && (py >= barH))
    }

    ; The dialog is modal: while it is open every press is its.
    fn has:boolean (px:double py:double) {
        if (shareOpen && (quiet == false)) {
            return true
        }
        if (this.helpHas(px py)) {
            return true
        }
        if (this.chatHas(px py)) {
            return true
        }
        if (this.callHas(px py)) {
            return true
        }
        if (this.filesHas(px py)) {
            return true
        }
        if ((strlen toastText) > 0) {
            return (this.inEl("pn-toast" px py))
        }
        return false
    }

    fn inEl:boolean (id:string px:double py:double) {
        if (null? host.lastPage) {
            this.page()
        }
        def e@(optional):EVGElement (host.findEl((unwrap host.lastPage) id))
        if (null? e) {
            return false
        }
        def el:EVGElement (unwrap e)
        return (host.containsPoint(el px py))
    }

    ; A property row of the help under the point: its index, or -1.
    fn propAt:int (px:double py:double) {
        if (null? host.lastPage) {
            return -1
        }
        if ((this.inEl("pn-view" px py)) == false) {
            return -1
        }
        def hit (new EVGHitTest())
        def order:[EVGElement] (hit.paintOrder((unwrap host.lastPage)))
        def i:int ((array_length order) - 1)
        while (i >= 0) {
            def el:EVGElement (itemAt order i)
            if ((indexOf el.id "pn-prop-") == 0) {
                if (host.containsPoint(el px py)) {
                    return (?? (str2int (substring el.id 8 (strlen el.id))) -1)
                }
            }
            i = (i - 1)
        }
        return -1
    }

    fn ownerAt:string (px:double py:double) {
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return ""
        }
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            return owner.tid
        }
        return tid
    }

    fn press:void (px:double py:double clicks:int shift:boolean) {
        if (null? host.lastPage) {
            this.page()
        }
        ; a finger on the dialog: a tap or a scroll, known when it lifts or
        ; moves (a link's field, which selects, takes its own press)
        if ((touch && (tapping == false)) && (this.inEl("pn-dialog" px py))) {
            if ((indexOf (this.ownerAt(px py)) "pn-url-") != 0) {
                dlgScroll.beginPan(px py clicks shift)
                return
            }
        }
        ; a press in a text that can be copied selects in it (a drag, a
        ; word, the paragraph); a press anywhere else lets a selection go
        def hit:string (host.hitTest(px py))
        host.dropSelections(hit)
        if (this.copyableAt(hit)) {
            textSelecting = (host.textPressAt(hit px py clicks shift))
            rev = (rev + 1)
            return
        }
        if ((shareOpen && (quiet == false)) && (dialogKind == "data")) {
            this.dataPress(px py)
            return
        }
        if (this.decksShowing()) {
            this.decksPress(px py)
            return
        }
        if ((shareOpen && (quiet == false)) && (dialogKind == "settings")) {
            def sc:string (this.ownerAt(px py))
            if (sc == "pn-set-contrast") {
                autoContrast = (autoContrast == false)
                push requests ("setting:contrast:" + (? autoContrast "on" "off"))
                this.rebuild()
                return
            }
            if ((sc == "pn-set-term-room") || (sc == "pn-set-term-project")) {
                def want:string (substring sc 12 (strlen sc))
                if (want != (PresI18n.term())) {
                    push requests ("setting:term:" + want)
                }
                return
            }
            if ((indexOf sc "pn-set-hue-") == 0) {
                push requests ("setting:skinhue:" + (substring sc 11 (strlen sc)))
                return
            }
            if ((indexOf sc "pn-set-mode-") == 0) {
                push requests ("setting:mode:" + (substring sc 12 (strlen sc)))
                return
            }
            if ((indexOf sc "pn-set-frame-") == 0) {
                push requests ("setting:frame:" + (substring sc 13 (strlen sc)))
                return
            }
            if ((sc == "pn-set-skin-light") || (sc == "pn-set-skin-retro")) {
                push requests ("setting:skin:" + (? (sc == "pn-set-skin-retro") "retro" "light"))
                return
            }
            if ((sc == "pn-set-close") || ((this.inEl("pn-dialog" px py)) == false)) {
                this.closeShare()
            }
            return
        }
        if ((shareOpen && (quiet == false)) && (dialogKind == "open")) {
            def oc:string (this.ownerAt(px py))
            if (oc == "pn-open-file") {
                push requests "click:open"
                this.closeShare()
                return
            }
            if (oc == samplePick.tid) {
                ; the list opens over the dialog's edge: a press in it is the select's
                host.click((host.hitTest(px py)))
                samplePick.build()
                if ((strlen samplePick.value) > 0) {
                    push requests ("select:sample:" + samplePick.value)
                    samplePick.open = false
                    this.closeShare()
                    return
                }
                rev = (rev + 1)
                return
            }
            if samplePick.open {
                samplePick.closeList()
                samplePick.build()
                rev = (rev + 1)
                return
            }
            if ((oc == "pn-open-close") || ((this.inEl("pn-dialog" px py)) == false)) {
                this.closeShare()
            }
            return
        }
        if (shareOpen && (quiet == false)) {
            def c:string (this.ownerAt(px py))
            if (((c == "pn-copy-show") || (c == "pn-copy-edit")) || (c == "pn-copy-view")) {
                push requests ("copy:" + (substring c 8 (strlen c)))
                return
            }
            if ((c == "pn-share-invite") || (c == "pn-share-stop")) {
                push requests (substring c 3 (strlen c))
                this.closeShare()
                return
            }
            if ((c == "pn-share-close") || ((this.inEl("pn-dialog" px py)) == false)) {
                this.closeShare()
            }
            return
        }
        if (this.filesHas(px py)) {
            this.filesPress(px py shift)
            return
        }
        if (this.chatHas(px py)) {
            this.chatPress(px py clicks shift)
            return
        }
        if (this.callHas(px py)) {
            this.callPress(px py)
            return
        }
        if (this.helpHas(px py)) {
            def c2:string (this.ownerAt(px py))
            if (c2 == "pn-help-close") {
                push requests "help-close"
                return
            }
            if (c2 == "pn-help-slide") {
                this.setHelpTab("slide")
                return
            }
            if (c2 == "pn-help-guide") {
                this.setHelpTab("guide")
                return
            }
            def k:int (this.propAt(px py))
            if ((k >= 0) && (k < (array_length helpKeys))) {
                push requests ("help:" + (itemAt helpKeys k))
            }
        }
    }

    fn scrollBy:void (dy:double) {
        helpScroll = (helpScroll + dy)
        if (helpScroll < 0.0) {
            helpScroll = 0.0
        }
        this.rebuild()
    }

    fn hoverAt:void (px:double py:double) {
        if (null? host.lastPage) {
            return
        }
        this.filesHoverAt(px py)
        if (null? host.lastPage) {
            return
        }
        def tid:string ""
        if (this.has(px py)) {
            tid = (host.hitTest(px py))
        }
        if (tid != host.hoverTid) {
            if ((strlen tid) > 0) {
                host.hover(tid)
            } {
                host.unhover()
            }
            rev = (rev + 1)
        }
    }

    fn cursorAt:string (px:double py:double) {
        if ((this.has(px py)) == false) {
            return ""
        }
        if ((this.propAt(px py)) >= 0) {
            return "pointer"
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            if ((this.imgRowAt(px py)) >= 0) {
                return "pointer"
            }
            return "default"
        }
        if (this.copyableAt(tid)) {
            return "text"
        }
        return "pointer"
    }
}
