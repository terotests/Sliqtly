; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresPanels.rgr — the help panel, the share dialog and the toast, in EVGUI
; ============================================================================
;
; What the page used to draw in HTML around the canvas, drawn on it in the
; EVGUI playground's look (web/panels.css over the kit's theme):
;
;   help    docked on the right under the bar: what the selected slide is
;           made of (PresApp.slideHelp's JSON), the theme rules that draw
;           each part at their values now; a property opens in the theme
;   share   a modal card with the two links (presenting / editing), each
;           with a copy button
;   toast   a short line at the bottom, taken away by the page's timer
;
; Like the bar, the panels do not act themselves: a press is a request
; ("help:<sel>\t<prop>\t<default>", "copy:show", "copy:edit") the app or
; the page acts on. The links come from the page (`openShare`), which also
; does the copying, since the clipboard is the browser's.
; ============================================================================

Import "../evgui/src/UiHost.rgr"
Import "../vela/src/VlJson.rgr"
Import "PresI18n.rgr"
Import "PresImport.rgr"

; A select that says what it is for while nothing is chosen. SelectCtl draws
; the chosen item's label in its trigger, so a prompt there used to be a
; disabled first item, which then showed up as a row in the open list.
class PresPromptSelect extends SelectCtl {
    def prompt:string ""

    fn labelOf:string (v:string) {
        if ((this.indexOfValue(v)) < 0) {
            return prompt
        }
        def it:UiItem (itemAt items (this.indexOfValue(v)))
        return it.name
    }
}

class PresPanels {
    def host:UiHost (new UiHost())
    def css:string ""
    def w:double 1200.0
    def h:double 700.0
    def barH:double 48.0
    def helpW:double 380.0
    ; the help panel
    def helpOpen:boolean false
    def helpJson:string ""
    def helpSlide:int 0
    def helpScroll:double 0.0
    def helpKeys:[string]
    ; the share dialog
    def shareOpen:boolean false
    def shareShow:string ""
    def shareEdit:string ""
    def shareNote:string ""
    ; which modal dialog `shareOpen` shows: "share", or "open" (a file from
    ; the computer or a sample deck, `openRows` "value<TAB>label" lines)
    def dialogKind:string "share"
    def openRows:string ""
    ; the Open dialog's sample decks: a select whose trigger says what it is
    def samplePick:PresPromptSelect (new PresPromptSelect())
    ; the import dialog ("data"): the dropped file and its selects, one of
    ; which may be open (`dataOpenSel`, its tid)
    def imp:PresImport (new PresImport())
    def dataSels:[SelectCtl]
    def dataOpenSel:string ""
    ; "show" or "edit": the button that says it copied
    def copied:string ""
    def copyOk:boolean true
    ; the files tab: the document's files and the stored documents, in the
    ; editor's place (`filesX`…`filesH`). `filesJson` comes from the page:
    ;   {"doc": name, "files": [{"path", "size", "kind"}], "docs": [{"id",
    ;    "name", "when", "current"}], "note": text,
    ;    "promo": {"title", "text", "button"} (optional, drawn first)}
    ; With a file open in the editor (`filesOpenPath`) only a bar over it.
    def filesOpen:boolean false
    def filesX:double 0.0
    def filesY:double 0.0
    def filesW:double 400.0
    def filesH:double 400.0
    def filesJson:string ""
    def filesOpenPath:string ""
    def filesScroll:double 0.0
    ; what each row's button stands for: "<action>\t<path or id>"
    def filesKeys:[string]
    ; a delete pressed once, waiting for the second press
    def filesArmed:string ""
    ; the pictures' rows (`pf-img-<k>`): their paths and pixel sizes (the
    ; page's "w", "h"); the one under the pointer shows a preview beside the
    ; panel (`filesHover`, at the pointer's height `hoverY`)
    def imgPaths:[string]
    def imgW:[int]
    def imgH:[int]
    def filesHover:string ""
    def hoverW:int 0
    def hoverH:int 0
    def hoverY:double 0.0
    ; the toast
    def toastText:string ""
    ; presenting: only the toast shows
    def quiet:boolean false
    def requests:[string]
    def rev:int 0
    def measurer@(optional):TTFTextMeasurer

    Constructor () {
    }

    ; --- what is showing ---------------------------------------------------------
    fn any:boolean () {
        return (((helpOpen || shareOpen) || filesOpen) || ((strlen toastText) > 0))
    }

    ; --- the files tab ----------------------------------------------------------------
    fn setFiles:void (on:boolean x:double y:double fw:double fh:double openPath:string) {
        if ((((on != filesOpen) || (openPath != filesOpenPath)) || ((x != filesX) || (y != filesY))) || ((fw != filesW) || (fh != filesH))) {
            if (on != filesOpen) {
                filesScroll = 0.0
                filesArmed = ""
            }
            filesHover = ""
            filesOpen = on
            filesX = x
            filesY = y
            filesW = fw
            filesH = fh
            filesOpenPath = openPath
            this.rebuild()
        }
    }

    fn setFilesData:void (json:string) {
        if (json != filesJson) {
            filesJson = json
            filesArmed = ""
            filesHover = ""
            this.rebuild()
        }
    }

    ; the bar over an open file
    sfn filesBarH:double () {
        return 44.0
    }

    fn setHelp:void (on:boolean) {
        if (on != helpOpen) {
            helpOpen = on
            helpScroll = 0.0
            this.rebuild()
        }
    }

    ; The slide's parts, rebuilt only when they changed.
    fn setHelpData:void (json:string slide:int) {
        if ((json != helpJson) || (slide != helpSlide)) {
            if (slide != helpSlide) {
                helpScroll = 0.0
            }
            helpJson = json
            helpSlide = slide
            this.rebuild()
        }
    }

    fn openShare:void (showUrl:string editUrl:string note:string) {
        shareShow = showUrl
        shareEdit = editUrl
        shareNote = note
        dialogKind = "share"
        shareOpen = true
        copied = ""
        this.rebuild()
    }

    fn openOpen:void (rows:string) {
        openRows = rows
        dialogKind = "open"
        shareOpen = true
        this.rebuild()
    }

    ; File → Settings: the editor's own preferences, kept by the page.
    def autoContrast:boolean true

    fn openSettings:void (contrast:boolean) {
        autoContrast = contrast
        dialogKind = "settings"
        shareOpen = true
        this.rebuild()
    }

    fn openData:void (i:PresImport) {
        imp = i
        dialogKind = "data"
        dataOpenSel = ""
        shareOpen = true
        this.rebuild()
    }

    fn closeShare:void () {
        if shareOpen {
            shareOpen = false
            this.rebuild()
        }
    }

    fn setCopied:void (which:string ok:boolean) {
        copied = which
        copyOk = ok
        this.rebuild()
    }

    fn toast:void (t:string) {
        if (t != toastText) {
            toastText = t
            this.rebuild()
        }
    }

    ; --- building -------------------------------------------------------------------
    fn div:EVGElement (cls:string) {
        def d (EVGElement.createDiv())
        d.className = cls
        return d
    }

    fn words:EVGElement (cls:string t:string) {
        def s (EVGElement.createSpan())
        s.className = cls
        s.textContent = t
        return s
    }

    fn put:void (c:UiCtl parent:EVGElement) {
        push host.ctls c
        parent.addChild((unwrap c.rootEl))
    }

    fn button:ButtonCtl (tid:string label:string variant:string parent:EVGElement) {
        def c (new ButtonCtl())
        c.tid = tid
        c.name = label
        c.variant = variant
        c.build()
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r "pn-button")
        if ((variant == "primary") && ((r.getChildCount()) > 0)) {
            UiTree.addClass((r.getChild(0)) "pn-onprimary")
        }
        this.put(c parent)
        return c
    }

    sfn isColour:boolean (v:string) {
        def t:string (trim v)
        return ((((strlen t) >= 4) && ((charAt t 0) == 35)) || ((indexOf t "rgb") == 0))
    }

    fn swatch:EVGElement (colour:string) {
        def sw:EVGElement (this.div("pn-swatch"))
        UiTree.inline(sw "background-color" colour)
        return sw
    }

    fn rebuild:void () {
        def fresh (new UiHost())
        host = fresh
        host.addStyleSheet(css)
        host.setTheme("pn")
        host.setPageSize(w h)
        def root:EVGElement (unwrap host.root)
        root.className = "ui-root pn-page"
        if (helpOpen && (quiet == false)) {
            root.addChild((this.helpPanel()))
        }
        if (filesOpen && (quiet == false)) {
            root.addChild((this.filesPanel()))
            if (((strlen filesHover) > 0) && ((strlen filesOpenPath) == 0)) {
                root.addChild((this.imagePreview()))
            }
        }
        if ((strlen toastText) > 0) {
            def t:EVGElement (this.div("pn-toast"))
            t.id = "pn-toast"
            t.addChild((this.words("pn-toast-text" toastText)))
            UiTree.surface(t "free" "start")
            t.overlayX = ((w * 0.5) - 180.0)
            t.overlayY = (h - 70.0)
            root.addChild(t)
        }
        if (shareOpen && (quiet == false)) {
            def back:EVGElement (this.div("pn-backdrop"))
            back.id = "pn-backdrop"
            UiTree.backdrop(back)
            root.addChild(back)
            if (dialogKind == "open") {
                root.addChild((this.openDialog()))
            } {
              if (dialogKind == "settings") {
                root.addChild((this.settingsDialog()))
              } {
              if (dialogKind == "data") {
                root.addChild((this.dataDialog()))
              } {
                root.addChild((this.shareDialog()))
              }
              }
            }
        }
        rev = (rev + 1)
    }

    ; --- the help panel -------------------------------------------------------------
    fn helpPanel:EVGElement () {
        def keys:[string]
        helpKeys = keys
        def p:EVGElement (this.div("pn-help"))
        p.id = "pn-help"
        UiTree.surface(p "free" "start")
        p.overlayX = (w - helpW)
        p.overlayY = barH
        p.width = (EVGUnit.px(helpW))
        p.height = (EVGUnit.px((h - barH)))
        def top:EVGElement (this.div("pn-top"))
        top.addChild((this.words("pn-title" ((PresI18n.t("Help: slide ")) + (to_string (helpSlide + 1))))))
        top.addChild((this.div("pn-grow")))
        this.button("pn-help-close" "✕" "ghost" top)
        p.addChild(top)
        def view:EVGElement (this.div("pn-view"))
        view.id = "pn-view"
        view.setAttribute("overflow" "hidden")
        view.scrollTop = helpScroll
        view.height = (EVGUnit.px(((h - barH) - 49.0)))
        def body:EVGElement (this.div("pn-body"))
        body.addChild((this.words("pn-intro" (PresI18n.t("This slide has these parts. Click a property to change it in the theme CSS.")))))
        body.addChild((this.words("pn-intro" (PresI18n.t("Keys: F6 moves between areas (bar, tabs, editor, slides, help), arrows and Tab within an area, Enter selects, Ctrl+Space opens the choices for the value at the cursor, Esc returns to the editor.")))))
        def p0 (new VlJsonParser())
        def feats:VlJson (p0.parse(helpJson))
        def i:int 0
        while (i < (feats.count())) {
            body.addChild((this.feature((feats.at(i)))))
            i = (i + 1)
        }
        view.addChild(body)
        p.addChild(view)
        return p
    }

    fn feature:EVGElement (f:VlJson) {
        def sec:EVGElement (this.div("pn-sec"))
        sec.addChild((this.words("pn-h3" (f.stringOr("title" "")))))
        def syn:string (f.stringOr("syntax" ""))
        if ((strlen syn) > 0) {
            def row:EVGElement (this.div("pn-syn"))
            def parts:[string] (strsplit syn "   ")
            def k:int 0
            while (k < (array_length parts)) {
                def t:string (trim (itemAt parts k))
                if ((strlen t) > 0) {
                    row.addChild((this.words("pn-code" t)))
                }
                k = (k + 1)
            }
            sec.addChild(row)
        }
        def doc:string (f.stringOr("doc" ""))
        if ((strlen doc) > 0) {
            sec.addChild((this.words("pn-doc" doc)))
        }
        def rules:VlJson (f.get("rules"))
        def r:int 0
        while (r < (rules.count())) {
            sec.addChild((this.rule((rules.at(r)))))
            r = (r + 1)
        }
        def attrs:VlJson (f.get("attrs"))
        def a:int 0
        while (a < (attrs.count())) {
            def at:VlJson (attrs.at(a))
            def row2:EVGElement (this.div("pn-attr"))
            row2.addChild((this.words("pn-code" ((at.stringOr("name" "")) + "=" + (at.stringOr("value" ""))))))
            row2.addChild((this.words("pn-pd" (at.stringOr("doc" "")))))
            sec.addChild(row2)
            a = (a + 1)
        }
        return sec
    }

    fn rule:EVGElement (r:VlJson) {
        def box:EVGElement (this.div("pn-rule"))
        def sel:string (r.stringOr("sel" ""))
        def head:EVGElement (this.div("pn-rhead"))
        head.addChild((this.words("pn-sel" (sel + " { }"))))
        head.addChild((this.words("pn-sd" (r.stringOr("doc" "")))))
        box.addChild(head)
        def props:VlJson (r.get("props"))
        def i:int 0
        while (i < (props.count())) {
            def p:VlJson (props.at(i))
            def name:string (p.stringOr("name" ""))
            def value:string (p.stringOr("value" ""))
            def eff:string (p.stringOr("eff" ""))
            def row:EVGElement (this.div("pn-prop"))
            row.id = ("pn-prop-" + (to_string (array_length helpKeys)))
            push helpKeys (sel + (strfromcode 9) + name + (strfromcode 9) + (p.stringOr("def" "")))
            def line:EVGElement (this.div("pn-pline"))
            line.addChild((this.words("pn-nm" name)))
            line.addChild((this.div("pn-grow")))
            if ((strlen value) > 0) {
                if (PresPanels.isColour(value)) {
                    line.addChild((this.swatch(value)))
                }
                line.addChild((this.words("pn-val" value)))
            } {
                if ((strlen eff) > 0) {
                    if (PresPanels.isColour(eff)) {
                        line.addChild((this.swatch(eff)))
                    }
                    line.addChild((this.words("pn-unset" ((PresI18n.t("default ")) + eff + (PresI18n.t(" – add"))))))
                } {
                    line.addChild((this.words("pn-unset" (PresI18n.t("not set – add")))))
                }
            }
            row.addChild(line)
            def pd:string (p.stringOr("doc" ""))
            if ((strlen pd) > 0) {
                row.addChild((this.words("pn-pd" pd)))
            }
            box.addChild(row)
            i = (i + 1)
        }
        return box
    }

    ; --- the files tab ---------------------------------------------------------------
    fn filesPanel:EVGElement () {
        def keys:[string]
        filesKeys = keys
        def noPaths:[string]
        imgPaths = noPaths
        def noW:[int]
        imgW = noW
        def noH:[int]
        imgH = noH
        def p:EVGElement (this.div("pf-panel"))
        p.id = "pf-panel"
        UiTree.surface(p "free" "start")
        p.overlayX = filesX
        p.overlayY = filesY
        p.width = (EVGUnit.px(filesW))
        if ((strlen filesOpenPath) > 0) {
            ; a file in the editor: a bar to go back by
            p.height = (EVGUnit.px((PresPanels.filesBarH())))
            def bar:EVGElement (this.div("pf-top"))
            this.button("pf-back" (PresI18n.t("← Files")) "ghost" bar)
            bar.addChild((this.words("pf-path" filesOpenPath)))
            bar.addChild((this.div("pn-grow")))
            bar.addChild((this.words("pf-saved" (PresI18n.t("saves automatically")))))
            p.addChild(bar)
            return p
        }
        p.height = (EVGUnit.px(filesH))
        def p0 (new VlJsonParser())
        def data:VlJson (p0.parse(filesJson))
        def top:EVGElement (this.div("pf-top"))
        top.addChild((this.words("pn-title" (PresI18n.t("Files")))))
        top.addChild((this.div("pn-grow")))
        this.button("pf-add" (PresI18n.t("Add files…")) "secondary" top)
        p.addChild(top)
        def view:EVGElement (this.div("pn-view"))
        view.id = "pf-view"
        view.setAttribute("overflow" "hidden")
        view.scrollTop = filesScroll
        view.height = (EVGUnit.px((filesH - 49.0)))
        def body:EVGElement (this.div("pf-body"))
        if ((p0.ok == false) || ((data.isObject()) == false)) {
            body.addChild((this.words("pn-intro" (PresI18n.t("Loading files…")))))
            view.addChild(body)
            p.addChild(view)
            return p
        }
        ; the page's offer above everything (Sliqtly: PRO), {"title", "text", "button"}
        def promo:VlJson (data.get("promo"))
        if (promo.isObject()) {
            def box:EVGElement (this.div("pf-promo"))
            box.addChild((this.words("pf-promo-title" (promo.stringOr("title" "")))))
            box.addChild((this.words("pf-promo-text" (promo.stringOr("text" "")))))
            def label:string (promo.stringOr("button" ""))
            if ((strlen label) > 0) {
                def row:EVGElement (this.div("pf-promo-row"))
                def b:ButtonCtl (this.button("pf-promo" label "primary" row))
                UiTree.addClass((unwrap b.rootEl) "pf-promo-btn")
                box.addChild(row)
            }
            body.addChild(box)
        }
        body.addChild((this.words("pf-h" ((PresI18n.t("This presentation: ")) + (data.stringOr("doc" ""))))))
        ; the files, a folder's under its name
        def files:VlJson (data.get("files"))
        def folder:string "-"
        def i:int 0
        while (i < (files.count())) {
            def f:VlJson (files.at(i))
            def path:string (f.stringOr("path" ""))
            def slash:int (PresPanels.lastSlash(path))
            def dir:string ""
            if (slash > 0) {
                dir = (substring path 0 (slash + 1))
            }
            if (dir != folder) {
                folder = dir
                if (dir == "data/live/") {
                    ; the copies kept of linked sources (main.js keepLiveCopy)
                    body.addChild((this.words("pf-dir" (PresI18n.t("Linked data")))))
                } {
                    if ((strlen dir) > 0) {
                        body.addChild((this.words("pf-dir" dir)))
                    }
                }
            }
            body.addChild((this.fileRow(f (substring path (slash + 1) (strlen path)))))
            i = (i + 1)
        }
        if ((files.count()) == 0) {
            body.addChild((this.words("pn-intro" (PresI18n.t("No files yet.")))))
        }
        def note:string (data.stringOr("note" ""))
        if ((strlen note) > 0) {
            body.addChild((this.words("pf-note" note)))
        }
        ; the documents kept in this browser
        def dh:EVGElement (this.div("pf-hrow"))
        def listHead:string (PresI18n.t("Presentations in this browser"))
        if (data.boolOr("mine" false)) {
            listHead = (PresI18n.t("Your presentations"))
        }
        dh.addChild((this.words("pf-h" listHead)))
        dh.addChild((this.div("pn-grow")))
        this.button("pf-new" (PresI18n.t("New presentation")) "secondary" dh)
        body.addChild(dh)
        def docs:VlJson (data.get("docs"))
        def d:int 0
        while (d < (docs.count())) {
            body.addChild((this.docRow((docs.at(d)))))
            d = (d + 1)
        }
        if ((docs.count()) == 0) {
            body.addChild((this.words("pn-intro" (PresI18n.t("A presentation is saved here when you edit it.")))))
        }
        view.addChild(body)
        p.addChild(view)
        return p
    }

    sfn lastSlash:int (path:string) {
        def at:int -1
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == 47) {
                at = i
            }
            i = (i + 1)
        }
        return at
    }

    sfn sizeText:string (n:int) {
        if (n < 0) {
            return ""
        }
        if (n < 1024) {
            return ((to_string n) + (PresI18n.t(" B")))
        }
        if (n < (1024 * 1024)) {
            return ((to_string (idiv n 1024)) + (PresI18n.t(" KB")))
        }
        return ((to_string (idiv n (1024 * 1024))) + (PresI18n.t(" MB")))
    }

    ; A button standing for `action` on `what`.
    fn act:void (action:string what:string label:string variant:string parent:EVGElement) {
        def k:int (array_length filesKeys)
        push filesKeys (action + (strfromcode 9) + what)
        def b:ButtonCtl (this.button(("pf-k-" + (to_string k)) label variant parent))
        UiTree.addClass((unwrap b.rootEl) "pf-act")
    }

    fn fileRow:EVGElement (f:VlJson name:string) {
        def path:string (f.stringOr("path" ""))
        def kind:string (f.stringOr("kind" ""))
        def row:EVGElement (this.div("pf-row"))
        if (kind == "image") {
            row.id = ("pf-img-" + (to_string (array_length imgPaths)))
            push imgPaths path
            push imgW (f.intOr("w" 0))
            push imgH (f.intOr("h" 0))
        }
        def tag:string "TXT"
        if (kind == "md") { tag = "MD" }
        if (kind == "css") { tag = "CSS" }
        if (kind == "image") { tag = (PresI18n.t("IMAGE")) }
        if (kind == "chart") { tag = "VL" }
        if (kind == "data") { tag = "DATA" }
        if (kind == "live") {
            ; a linked source (a Google Sheet, a CSV / JSON address): its name,
            ; where it is read from and when; the copy itself is not edited
            row.addChild((this.words("pf-tag pf-tag-live" (f.stringOr("tag" "LIVE")))))
            def ln:EVGElement (this.div("pf-name"))
            ln.addChild((this.words("pf-fname" (f.stringOr("title" name)))))
            ln.addChild((this.words("pf-fsize" (f.stringOr("note" "")))))
            row.addChild(ln)
            row.addChild((this.div("pn-grow")))
            if ((strlen (f.stringOr("source" ""))) > 0) {
                this.act("source" path (PresI18n.t("Open source")) "secondary" row)
                this.act("refresh" path (PresI18n.t("Refresh")) "secondary" row)
            }
            if (filesArmed == ("unlink" + (strfromcode 9) + path)) {
                this.act("unlink" path (PresI18n.t("Unlink?")) "primary" row)
            } {
                this.act("unlink" path (PresI18n.t("Unlink")) "ghost" row)
            }
            return row
        }
        row.addChild((this.words(("pf-tag pf-tag-" + kind) tag)))
        def nm:EVGElement (this.div("pf-name"))
        nm.addChild((this.words("pf-fname" name)))
        def size:string (PresPanels.sizeText((f.intOr("size" -1))))
        if ((strlen size) > 0) {
            nm.addChild((this.words("pf-fsize" size)))
        }
        row.addChild(nm)
        row.addChild((this.div("pn-grow")))
        if ((kind == "md") || (kind == "css")) {
            this.act("tab" kind (PresI18n.t("Edit")) "secondary" row)
            return row
        }
        if (kind == "image") {
            if (PresPanels.editable(path)) {
                this.act("imgedit" path (PresI18n.t("Edit")) "secondary" row)
            }
            this.act("insert" path (PresI18n.t("Add to slide")) "secondary" row)
        } {
            this.act("open" path (PresI18n.t("Open")) "secondary" row)
            if (kind == "chart") {
                this.act("insert" path (PresI18n.t("Add to slide")) "secondary" row)
            }
        }
        def armed:boolean (filesArmed == ("del" + (strfromcode 9) + path))
        if armed {
            this.act("del" path (PresI18n.t("Delete?")) "primary" row)
        } {
            this.act("del" path "✕" "ghost" row)
        }
        return row
    }

    ; a picture the editor can change: pixels, not a drawing (SVG)
    sfn editable:boolean (path:string) {
        return ((indexOf (to_lowercase path) ".svg") < 0)
    }

    ; The picture under the pointer, as it is, beside the panel (over the
    ; slides) or inside its right edge when there is no room.
    fn imagePreview:EVGElement () {
        def most:double 240.0
        def pw:double most
        def ph:double (most * 0.66)
        if ((hoverW > 0) && (hoverH > 0)) {
            def k:double (most / (to_double hoverW))
            if ((to_double hoverH) > (to_double hoverW)) {
                k = (most / (to_double hoverH))
            }
            if (k > 1.0) {
                k = 1.0
            }
            pw = ((to_double hoverW) * k)
            ph = ((to_double hoverH) * k)
        }
        def card:EVGElement (this.div("pf-preview"))
        card.id = "pf-preview"
        UiTree.surface(card "free" "start")
        card.width = (EVGUnit.px((pw + 20.0)))
        def im (EVGElement.createImg())
        im.id = "pf-preview-img"
        im.className = "pf-preview-img"
        im.src = ("/" + filesHover)
        im.objectFit = "contain"
        im.sourceWidth = (to_double hoverW)
        im.sourceHeight = (to_double hoverH)
        im.width = (EVGUnit.px(pw))
        im.height = (EVGUnit.px(ph))
        card.addChild(im)
        def cap:string (PresPanels.nameOf(filesHover))
        if ((hoverW > 0) && (hoverH > 0)) {
            cap = (cap + "  ·  " + (to_string hoverW) + " × " + (to_string hoverH) + " px")
        }
        card.addChild((this.words("pf-preview-cap" cap)))
        if (PresPanels.editable(filesHover)) {
            card.addChild((this.words("pf-preview-hint" (PresI18n.t("Click to edit")))))
        }
        def cw:double (pw + 20.0)
        def chh:double (ph + 58.0)
        def px:double ((filesX + filesW) + 10.0)
        if ((px + cw) > (w - 8.0)) {
            px = (((filesX + filesW) - cw) - 24.0)
        }
        def py:double (hoverY - (chh * 0.5))
        if ((py + chh) > (h - 8.0)) {
            py = ((h - 8.0) - chh)
        }
        if (py < (filesY + 8.0)) {
            py = (filesY + 8.0)
        }
        card.overlayX = px
        card.overlayY = py
        return card
    }

    sfn nameOf:string (path:string) {
        def slash:int (PresPanels.lastSlash(path))
        return (substring path (slash + 1) (strlen path))
    }

    ; A picture's row under the point: its index in `imgPaths`, or -1.
    fn imgRowAt:int (px:double py:double) {
        if ((null? host.lastPage) || ((strlen filesOpenPath) > 0)) {
            return -1
        }
        if ((this.inEl("pf-view" px py)) == false) {
            return -1
        }
        def hit (new EVGHitTest())
        def order:[EVGElement] (hit.paintOrder((unwrap host.lastPage)))
        def i:int ((array_length order) - 1)
        while (i >= 0) {
            def el:EVGElement (itemAt order i)
            if ((indexOf el.id "pf-img-") == 0) {
                if (host.containsPoint(el px py)) {
                    def k:int (?? (str2int (substring el.id 7 (strlen el.id))) -1)
                    if ((k >= 0) && (k < (array_length imgPaths))) {
                        return k
                    }
                }
            }
            i = (i - 1)
        }
        return -1
    }

    ; The preview follows the pointer over the pictures' rows.
    fn filesHoverAt:void (px:double py:double) {
        if ((filesOpen == false) || (quiet || shareOpen)) {
            return
        }
        def k:int -1
        if (this.filesHas(px py)) {
            k = (this.imgRowAt(px py))
        }
        def path:string ""
        if (k >= 0) {
            path = (itemAt imgPaths k)
        }
        if (path != filesHover) {
            filesHover = path
            hoverY = py
            if (k >= 0) {
                hoverW = (itemAt imgW k)
                hoverH = (itemAt imgH k)
            }
            this.rebuild()
        }
    }

    fn docRow:EVGElement (d:VlJson) {
        def id:string (d.stringOr("id" ""))
        def row:EVGElement (this.div("pf-row"))
        def nm:EVGElement (this.div("pf-name"))
        nm.addChild((this.words("pf-fname" (d.stringOr("name" "")))))
        nm.addChild((this.words("pf-fsize" (d.stringOr("when" "")))))
        row.addChild(nm)
        row.addChild((this.div("pn-grow")))
        if (d.boolOr("current" false)) {
            row.addChild((this.words("pf-current" (PresI18n.t("open")))))
            return row
        }
        this.act("doc" id (PresI18n.t("Open")) "secondary" row)
        ; a deck only in the cloud is deleted once open (File → Delete)
        if (d.boolOr("cloud" false)) {
            return row
        }
        def armed:boolean (filesArmed == ("deldoc" + (strfromcode 9) + id))
        if armed {
            this.act("deldoc" id (PresI18n.t("Delete?")) "primary" row)
        } {
            this.act("deldoc" id "✕" "ghost" row)
        }
        return row
    }

    fn filesHas:boolean (px:double py:double) {
        if ((filesOpen == false) || quiet) {
            return false
        }
        def hh:double filesH
        if ((strlen filesOpenPath) > 0) {
            hh = (PresPanels.filesBarH())
        }
        return ((((px >= filesX) && (px <= (filesX + filesW))) && (py >= filesY)) && (py <= (filesY + hh)))
    }

    fn filesPress:void (px:double py:double) {
        def c:string (this.ownerAt(px py))
        if (c == "pf-back") {
            push requests "files:back"
            return
        }
        if (c == "pf-add") {
            push requests "files:add"
            return
        }
        if (c == "pf-new") {
            push requests "files:new"
            return
        }
        if (c == "pf-promo") {
            push requests "files:promo"
            return
        }
        if ((indexOf c "pf-k-") == 0) {
            def k:int (?? (str2int (substring c 5 (strlen c))) -1)
            if ((k >= 0) && (k < (array_length filesKeys))) {
                def key:string (itemAt filesKeys k)
                def tab:int (indexOf key (strfromcode 9))
                def action:string (substring key 0 tab)
                def what:string (substring key (tab + 1) (strlen key))
                if ((action == "del") || (action == "deldoc") || (action == "unlink")) {
                    if (filesArmed != key) {
                        ; the first press only asks
                        filesArmed = key
                        this.rebuild()
                        return
                    }
                    filesArmed = ""
                }
                push requests ("files:" + action + ":" + what)
                return
            }
        }
        ; a picture's row, not one of its buttons: the image editor
        if ((strlen c) == 0) {
            def k:int (this.imgRowAt(px py))
            if (k >= 0) {
                def path:string (itemAt imgPaths k)
                if (PresPanels.editable(path)) {
                    filesHover = ""
                    filesArmed = ""
                    push requests ("files:imgedit:" + path)
                    this.rebuild()
                    return
                }
            }
        }
        if (filesArmed != "") {
            filesArmed = ""
            this.rebuild()
        }
    }

    fn filesScrollBy:void (dy:double) {
        filesScroll = (filesScroll + dy)
        if (filesScroll < 0.0) {
            filesScroll = 0.0
        }
        this.rebuild()
    }

    ; --- the share dialog -------------------------------------------------------------
    fn shareDialog:EVGElement () {
        def d:EVGElement (this.div("pn-dialog"))
        d.id = "pn-dialog"
        UiTree.surface(d "free" "start")
        d.overlayX = ((w - 520.0) * 0.5)
        d.overlayY = ((h - 330.0) * 0.5)
        d.addChild((this.words("pn-dtitle" (PresI18n.t("Share presentation")))))
        d.addChild((this.shareOption("show" (PresI18n.t("Presentation")) (PresI18n.t("Opens straight into presentation mode, without the editor or edit buttons.")) shareShow "primary")))
        d.addChild((this.shareOption("edit" (PresI18n.t("Editing")) (PresI18n.t("Opens in the editor: the recipient can edit their own copy.")) shareEdit "secondary")))
        def foot:EVGElement (this.div("pn-dfoot"))
        foot.addChild((this.words("pn-note" shareNote)))
        foot.addChild((this.div("pn-grow")))
        this.button("pn-share-close" (PresI18n.t("Close")) "secondary" foot)
        d.addChild(foot)
        return d
    }

    ; Open: a presentation, data or a picture from the computer, or one of the
    ; sample decks.
    fn openDialog:EVGElement () {
        def d:EVGElement (this.div("pn-dialog"))
        d.id = "pn-dialog"
        UiTree.surface(d "free" "start")
        d.overlayX = ((w - 520.0) * 0.5)
        d.overlayY = ((h - 480.0) * 0.5)
        d.addChild((this.words("pn-dtitle" (PresI18n.t("Open")))))
        def f:EVGElement (this.div("pn-opt"))
        f.addChild((this.words("pn-otitle" (PresI18n.t("From your computer")))))
        f.addChild((this.words("pn-odesc" (PresI18n.t("A presentation (.md), or data (Excel, CSV, JSON) and pictures, which go to Files.")))))
        def fr:EVGElement (this.div("pn-orow"))
        this.button("pn-open-file" (PresI18n.t("Choose file…")) "primary" fr)
        f.addChild(fr)
        d.addChild(f)
        def o:EVGElement (this.div("pn-opt"))
        o.addChild((this.words("pn-otitle" (PresI18n.t("Sample documents")))))
        def keepOpen:boolean samplePick.open
        def sel (new PresPromptSelect())
        sel.tid = "pn-samples"
        sel.name = (PresI18n.t("Open sample document…"))
        sel.prompt = sel.name
        def lines:[string] (strsplit openRows (strfromcode 10))
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) (strfromcode 9))
            if ((array_length parts) >= 2) {
                sel.addItem((itemAt parts 0) (itemAt parts 1) false)
            }
            i = (i + 1)
        }
        sel.value = ""
        sel.build()
        UiTree.addClass((unwrap sel.rootEl) "pn-samplesel")
        samplePick = sel
        this.put(sel o)
        if keepOpen {
            sel.openList()
            sel.build()
        }
        d.addChild(o)
        def foot:EVGElement (this.div("pn-dfoot"))
        foot.addChild((this.div("pn-grow")))
        this.button("pn-open-close" (PresI18n.t("Close")) "secondary" foot)
        d.addChild(foot)
        return d
    }

    ; --- the settings dialog -------------------------------------------------------------
    fn settingsDialog:EVGElement () {
        def d:EVGElement (this.div("pn-dialog"))
        d.id = "pn-dialog"
        UiTree.surface(d "free" "start")
        d.overlayX = ((w - 520.0) * 0.5)
        d.overlayY = ((h - 300.0) * 0.5)
        d.addChild((this.words("pn-dtitle" (PresI18n.t("Settings")))))
        def o:EVGElement (this.div("pn-opt"))
        o.addChild((this.words("pn-otitle" (PresI18n.t("Automatic contrast correction")))))
        o.addChild((this.words("pn-odesc" (PresI18n.t("Text too faint on its slide is made readable: small text gets a lighter or darker colour, big text a thin outline. Your own colours stay as they are wherever they already read well.")))))
        def r:EVGElement (this.div("pn-orow"))
        def label:string (PresI18n.t("On"))
        def variant:string "primary"
        if (autoContrast == false) {
            label = (PresI18n.t("Off"))
            variant = "secondary"
        }
        this.button("pn-set-contrast" label variant r)
        o.addChild(r)
        d.addChild(o)
        def foot:EVGElement (this.div("pn-dfoot"))
        foot.addChild((this.div("pn-grow")))
        this.button("pn-set-close" (PresI18n.t("Close")) "secondary" foot)
