; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresHelp.rgr — what is on this slide, and which theme rules draw it
; ============================================================================
;
; The help panel lists the things the selected slide is made of — a
; highlight, a key cap, a list, a formula, a chart — each with how it is
; written in the Markdown and the CSS rules and properties that change how
; it looks, with the value the theme gives them now. Only what the slide
; has is listed: a slide without a formula says nothing about formulas.
;
; `forSlide(text title css)` reads the slide's Markdown and answers as JSON:
;
;   [ { "key": "mark", "title": "Korostus", "syntax": "<mark>…</mark>",
;       "doc": "…",
;       "rules": [ { "sel": "mark", "doc": "…",
;                    "props": [ { "name": "background-color",
;                                 "value": "", "def": "#ffe766",
;                                 "eff": "#ffe766",
;                                 "doc": "…" } ] } ],
;       "attrs": [ { "name": "fx", "value": "starfield", "doc": "…" } ] } ]
;
; `value` is "" when the theme does not set the property; `def` is what is
; written into the theme when the property is added from the panel; `eff`
; what the slide draws while it is not set, when that is known.
; ============================================================================

Import "PresHints.rgr"
Import "../markdown/src/MdAnchor.rgr"
Import "PresI18n.rgr"

class PresSlideScan {
    def levels:string ""
    def para:boolean false
    def list:boolean false
    def quote:boolean false
    def code:boolean false
    def inlineCode:boolean false
    def table:boolean false
    def htmlTable:boolean false
    def link:boolean false
    def hr:boolean false
    def mark:boolean false
    def kbd:boolean false
    def emph:boolean false
    def math:boolean false
    def diagram:boolean false
    def chart:boolean false
    def image:boolean false
    ; inline HTML tag names met, " u sub sup " style
    def tags:string " "
    ; `.lead` style classes met, space separated with a leading space
    def classes:string " "
    def attrNames:[string]
    def attrValues:[string]

    Constructor () {
    }

    fn addTag:void (t:string) {
        if ((indexOf tags (" " + t + " ")) < 0) {
            tags = (tags + t + " ")
        }
    }

    fn addClass:void (c:string) {
        if ((indexOf classes (" " + c + " ")) < 0) {
            classes = (classes + c + " ")
        }
    }

    fn addAttr:void (k:string v:string) {
        def i:int 0
        while (i < (array_length attrNames)) {
            if ((itemAt attrNames i) == k) {
                return
            }
            i = (i + 1)
        }
        push attrNames k
        push attrValues v
    }
}

class PresHelp {
    ; --- the theme's values -----------------------------------------------------
    sfn noComments:string (css:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen css)
        while (i < n) {
            if (((i + 1) < n) && (((charAt css i) == 47) && ((charAt css (i + 1)) == 42))) {
                def e:int (indexOfFrom css "*/" (i + 2))
                if (e < 0) {
                    return out
                }
                i = (e + 2)
            } {
                out = (out + (strfromcode (charAt css i)))
                i = (i + 1)
            }
        }
        return out
    }

    ; Does a selector list ("h1, h2") name `sel`?
    sfn names:boolean (selectors:string sel:string) {
        def parts:[string] (strsplit selectors ",")
        def i:int 0
        while (i < (array_length parts)) {
            if ((trim (itemAt parts i)) == sel) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; What the last rule for `sel` says `prop` is, or "".
    sfn valueOf:string (css:string sel:string prop:string) {
        def found:string ""
        def rules:[string] (strsplit css "}")
        def i:int 0
        while (i < (array_length rules)) {
            def r:string (itemAt rules i)
            def open:int (indexOf r "{")
            if (open > 0) {
                if (PresHelp.names((substring r 0 open) sel)) {
                    def decls:[string] (strsplit (substring r (open + 1) (strlen r)) ";")
                    def k:int 0
                    while (k < (array_length decls)) {
                        def d:string (itemAt decls k)
                        def colon:int (indexOf d ":")
                        if (colon > 0) {
                            if ((trim (substring d 0 colon)) == prop) {
                                found = (trim (substring d (colon + 1) (strlen d)))
                            }
                        }
                        k = (k + 1)
                    }
                }
            }
            i = (i + 1)
        }
        return found
    }

    ; The properties a rule for `sel` sets, "a,b,c".
    sfn propsOf:string (css:string sel:string) {
        def out:string ""
        def rules:[string] (strsplit css "}")
        def i:int 0
        while (i < (array_length rules)) {
            def r:string (itemAt rules i)
            def open:int (indexOf r "{")
            if (open > 0) {
                if (PresHelp.names((substring r 0 open) sel)) {
                    def decls:[string] (strsplit (substring r (open + 1) (strlen r)) ";")
                    def k:int 0
                    while (k < (array_length decls)) {
                        def d:string (itemAt decls k)
                        def colon:int (indexOf d ":")
                        if (colon > 0) {
                            def p:string (trim (substring d 0 colon))
                            if ((indexOf ("," + out + ",") ("," + p + ",")) < 0) {
                                if ((strlen out) > 0) {
                                    out = (out + ",")
                                }
                                out = (out + p)
                            }
                        }
                        k = (k + 1)
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; What the slide draws when the theme leaves the property out, when that
    ; is known; "" otherwise.
    sfn effectiveOf:string (css:string sel:string prop:string) {
        if (sel == "mark") {
            if (prop == "background-color") { return "#ffe766" }
            if (prop == "color") { return "#1f2328" }
        }
        if (sel == "kbd") {
            if (prop == "background-color") { return (PresHelp.valueOf(css "code" "background-color")) }
            if (prop == "border-color") { return (PresHelp.valueOf(css "code" "border-color")) }
        }
        if ((sel == "blockquote") && (prop == "color")) { return (PresHelp.valueOf(css "document" "color")) }
        if (((strlen sel) > 0) && ((charAt sel 0) == 46)) {
            if ((prop == "font-size") || (prop == "color")) { return (PresHelp.valueOf(css "document" prop)) }
        }
        return ""
    }

    ; What a property gets when it is added from the panel: what the slide
    ; shows now, so adding it changes nothing until the value is edited.
    sfn defaultOf:string (css:string sel:string prop:string) {
        def eff:string (PresHelp.effectiveOf(css sel prop))
        if ((strlen eff) > 0) {
            return eff
        }
        if (sel == "mark") {
            if (prop == "background-color") { return "#ffe766" }
            if (prop == "color") { return "#1f2328" }
        }
        if (prop == "accent-color") { return "#59C3C4" }
        if (PresHints.isColorProp(prop)) { return "#ffffff" }
        if (prop == "font-family") { return "Open Sans" }
        if (prop == "font-size") { return "20pt" }
        if (prop == "line-height") { return "1.4" }
        if (prop == "border-width") { return "3pt" }
        if (prop == "column-count") { return "2" }
        if (prop == "chart-style") { return "flat" }
        if (prop == "chart-effects") { return "glow gradient" }
        if (prop == "background-image") { return "none" }
        if (prop == "width") { return "13.333in" }
        if (prop == "height") { return "7.5in" }
        if (prop == "split-level") { return "2" }
        if (prop == "fx") { return "starfield" }
        if (prop == "list-style") { return "swot" }
        if (prop == "colors") { return "#1f6feb #0f9d8a #7c4dff #f08c00" }
        if (prop == "overflow") { return "split" }
        if (prop == "aspect-ratio") { return "16 / 9" }
        return "12pt"
    }

    sfn propDoc:string (sel:string prop:string) {
        if ((sel == "kbd") && (prop == "background-color")) { return (PresI18n.t("Key cap face (default: the code background).")) }
        if ((sel == "kbd") && (prop == "border-color")) { return (PresI18n.t("Key cap border (default: the code border).")) }
        if ((sel == "mark") && (prop == "background-color")) { return (PresI18n.t("Highlight background color.")) }
        if ((sel == "mark") && (prop == "color")) { return (PresI18n.t("Highlighted text color.")) }
        if ((sel == "table") && (prop == "background-color")) { return (PresI18n.t("Header row background.")) }
        if ((sel == "container") && (prop == "background-color")) { return (PresI18n.t("The colour of the plates under {container=box} and {container=bubble} blocks. Translucent: #ffffffcc (the last two digits are the opacity).")) }
        if ((sel == "container") && (prop == "border-radius")) { return (PresI18n.t("How round the plates' corners are, e.g. 8pt.")) }
        if ((sel == "code") && (prop == "background-color")) { return (PresI18n.t("Code background. Translucent: #151c4833 (the last two digits are the opacity) or none.")) }
        if ((sel == "page") && (prop == "padding")) { return (PresI18n.t("Margin at the slide edges.")) }
        if ((sel == "hr") && (prop == "color")) { return (PresI18n.t("Rule color (also under headings).")) }
        if ((sel == "blockquote") && (prop == "border-color")) { return (PresI18n.t("Vertical bar color.")) }
        if ((sel == "blockquote") && (prop == "border-width")) { return (PresI18n.t("Vertical bar width.")) }
        if ((sel == "list") && (prop == "margin-left")) { return (PresI18n.t("Space between the bullet and the text.")) }
        if ((sel == "list") && (prop == "color")) { return (PresI18n.t("Bullet and number colour.")) }
        if ((sel == "li") && (prop == "margin-bottom")) { return (PresI18n.t("Space between items.")) }
        if (prop == "margin-top") { return (PresI18n.t("Space above.")) }
        if (prop == "margin-bottom") { return (PresI18n.t("Space below.")) }
        if (prop == "margin-left") { return (PresI18n.t("Space on the left.")) }
        if (prop == "padding") { return (PresI18n.t("Padding from the edges.")) }
        if (prop == "padding-left") { return (PresI18n.t("Padding on the left.")) }
        if (prop == "padding-top") { return (PresI18n.t("Padding at the top.")) }
        if (prop == "border-width") { return (PresI18n.t("Border width.")) }
        if (prop == "background-image") { return (PresI18n.t("Background image: url(media/image.png); paste an image into the editor with Ctrl+V. none: no image.")) }
        if ((sel == "page") && (prop == "width")) { return (PresI18n.t("Slide width (e.g. 13.333in = 16:9).")) }
        if ((sel == "page") && (prop == "height")) { return (PresI18n.t("Slide height (e.g. 7.5in).")) }
        return (PresHints.cssDoc(prop))
    }

    ; Every property the layout reads for a selector, "a,b,c"; "" for one it
    ; does not know.
    sfn knownProps:string (sel:string) {
        if (sel == "page") { return "width,height,padding,background-color,background-image" }
        if (sel == "img") { return "justify-content,max-height" }
        if ((sel == "header") || (sel == "footer")) { return "content,content-left,content-center,content-right,background-image,text-align,font-size,font-weight,color,background-color,border-color,height" }
        if ((sel == "document") || (sel == "body")) { return "font-family,font-size,line-height,color" }
        if (sel == "heading") { return "font-family,color,margin-top,margin-bottom" }
        if (((strlen sel) == 2) && (((charAt sel 0) == 104) && (((charAt sel 1) >= 49) && ((charAt sel 1) <= 54)))) { return "font-size,color" }
        if (sel == "p") { return "margin-bottom" }
        if (sel == "code") { return "font-family,font-size,line-height,padding,background-color,border-color" }
        if (sel == "mark") { return "background-color,color" }
        if (sel == "kbd") { return "background-color,border-color" }
        if (sel == "a") { return "color" }
        if (sel == "hr") { return "color" }
        if (sel == "blockquote") { return "color,border-color,border-width,padding-left,padding-top" }
        if (sel == "list") { return "padding-left,margin-left,color,list-style" }
        if (((indexOf sel "#") == 0) && ((indexOf sel " list") > 0)) { return "list-style" }
        if (sel == "li") { return "margin-bottom" }
        if (sel == "table") { return "border-color,background-color,padding-left,padding-top" }
        if (sel == "deck") { return "split-level,overflow,aspect-ratio,fx" }
        if (sel == "figure") { return "colors,color,accent-color,font-size" }
        if (sel == "chart") { return "color,accent-color,label-color,contrast,chart-style,chart-effects,font-size,title-font-size,title-gap,padding,justify-content" }
        ; `#anchor chart`: the charts under one heading
        if (((indexOf sel "#") == 0) && ((indexOf sel " chart") > 0)) { return "font-size,title-font-size,title-gap,padding,justify-content" }
        if (sel == "diagram") { return "color,accent-color" }
        if (sel == "container") { return "background-color,border-radius" }
        if (((strlen sel) > 1) && ((charAt sel 0) == 46)) { return "font-size,color,column-count,column-gap" }
        return ""
    }

    ; The rule for a selector as the CSS editor's popover shows it: what can
    ; be set, what is set, and what each does. The theme's own properties
    ; the list does not name come last.
    sfn selectorRule:string (css0:string sel:string) {
        def css:string (PresHelp.noComments(css0))
        def props:string (PresHelp.knownProps(sel))
        def extra:[string] (strsplit (PresHelp.propsOf(css sel)) ",")
        def i:int 0
        while (i < (array_length extra)) {
            def p:string (itemAt extra i)
            if (((strlen p) > 0) && ((indexOf ("," + props + ",") ("," + p + ",")) < 0)) {
                if ((strlen props) > 0) {
                    props = (props + ",")
                }
                props = (props + p)
            }
            i = (i + 1)
        }
        return (PresHelp.rule(css sel (PresHints.selectorDoc(sel)) props))
    }

    ; --- JSON -------------------------------------------------------------------
    sfn rule:string (css:string sel:string doc:string props:string) {
        def out:string ("{\"sel\":" + (PresHint.q(sel)) + ",\"doc\":" + (PresHint.q(doc)) + ",\"props\":[")
        def ps:[string] (strsplit props ",")
        def i:int 0
        def first:boolean true
        while (i < (array_length ps)) {
            def p:string (trim (itemAt ps i))
            if ((strlen p) > 0) {
                if (first == false) {
                    out = (out + ",")
                }
                first = false
                out = (out + "{\"name\":" + (PresHint.q(p)) + ",\"value\":" + (PresHint.q((PresHelp.valueOf(css sel p)))) + ",\"def\":" + (PresHint.q((PresHelp.defaultOf(css sel p)))) + ",\"eff\":" + (PresHint.q((PresHelp.effectiveOf(css sel p)))) + ",\"doc\":" + (PresHint.q((PresHelp.propDoc(sel p)))) + "}")
            }
            i = (i + 1)
        }
        return (out + "]}")
    }

    sfn feature:string (key:string title:string syntax:string doc:string rules:string) {
        return ("{\"key\":" + (PresHint.q(key)) + ",\"title\":" + (PresHint.q(title)) + ",\"syntax\":" + (PresHint.q(syntax)) + ",\"doc\":" + (PresHint.q(doc)) + ",\"rules\":[" + rules + "],\"attrs\":[]}")
    }

    ; --- reading the slide --------------------------------------------------------
    sfn startsWith:boolean (s:string p:string) {
        if ((strlen s) < (strlen p)) {
            return false
        }
        return ((substring s 0 (strlen p)) == p)
    }

    sfn isListLine:boolean (t:string) {
        if ((PresHelp.startsWith(t "- ")) || ((PresHelp.startsWith(t "* ")) || (PresHelp.startsWith(t "+ ")))) {
            return true
        }
        def i:int 0
        def n:int (strlen t)
        while ((i < n) && (((charAt t i) >= 48) && ((charAt t i) <= 57))) {
            i = (i + 1)
        }
        if ((i > 0) && ((i + 1) < n)) {
            def c:int (charAt t i)
            if (((c == 46) || (c == 41)) && ((charAt t (i + 1)) == 32)) {
                return true
            }
        }
        return false
    }

    ; A `$` that opens a formula: another `$` later on the line, and not a
    ; price (`$10`).
    sfn hasMath:boolean (t:string) {
        def a:int (indexOf t "$")
        while (a >= 0) {
            if ((a + 1) < (strlen t)) {
                def c:int (charAt t (a + 1))
                def isDigit:boolean ((c >= 48) && (c <= 57))
                if (((isDigit == false) && (c != 32)) && ((indexOfFrom t "$" (a + 1)) > a)) {
                    return true
                }
            }
            a = (indexOfFrom t "$" (a + 1))
        }
        return false
    }

    ; `{.lead fx=starfield #id}` at the end of a line (or alone on it).
    sfn attrsOf:void (sc:PresSlideScan t:string) {
        def open:int (lastIndexOf t "{")
        if (open < 0) {
            return
        }
        def close:int (indexOfFrom t "}" open)
        if (close < 0) {
            return
        }
        def items:[string] (strsplit (substring t (open + 1) close) " ")
        def i:int 0
        while (i < (array_length items)) {
            def it:string (trim (itemAt items i))
            if ((strlen it) > 1) {
                if ((charAt it 0) == 46) {
                    sc.addClass(it)
                } {
                    def eq:int (indexOf it "=")
                    if (eq > 0) {
                        sc.addAttr((substring it 0 eq) (substring it (eq + 1) (strlen it)))
                    }
                }
            }
            i = (i + 1)
        }
    }

    sfn inline:void (sc:PresSlideScan t:string) {
        if ((indexOf t "`") >= 0) {
            sc.inlineCode = true
        }
        def img:int (indexOf t "![")
        if (img >= 0) {
            sc.image = true
        }
        ; a `](` whose `[` is not a picture's `![`
        def lk:int (indexOf t "](")
        while (lk > 0) {
            def open:int (lastIndexOf (substring t 0 lk) "[")
            if (open >= 0) {
                if ((open == 0) || ((charAt t (open - 1)) != 33)) {
                    sc.link = true
                }
            }
            lk = (indexOfFrom t "](" (lk + 2))
        }
        if (PresHelp.hasMath(t)) {
            sc.math = true
        }
        if (((indexOf t "**") >= 0) || (((indexOf t " *") >= 0) || ((indexOf t " _") >= 0))) {
            sc.emph = true
        }
        if ((indexOf t "~~") >= 0) {
            sc.addTag("~~")
        }
        ; the HTML tags in it
        def lower:string (MdHtml.lower(t))
        def at:int (MdHtml.nextTag(lower 0))
        while (at >= 0) {
            def tg:MdHtmlTag (MdHtml.tagAt(lower at))
            if (tg.close == false) {
                def nm:string tg.name
                if (nm == "mark") {
                    sc.mark = true
                } {
                    if (nm == "kbd") {
                        sc.kbd = true
                    } {
                        if (nm == "a") {
                            sc.link = true
                        } {
                            if (nm == "table") {
                                sc.htmlTable = true
                            } {
                                if ((strlen nm) > 0) {
                                    sc.addTag(nm)
                                }
                            }
                        }
                    }
                }
                if ((strlen (tg.attr("style"))) > 0) {
                    sc.addTag("style")
                }
            }
            at = (MdHtml.nextTag(lower tg.end))
        }
    }

    sfn scan:PresSlideScan (text:string) {
        def sc:PresSlideScan (new PresSlideScan())
        def lines:[string] (strsplit text "\n")
        def inFence:boolean false
        def fenceMark:string ""
        def inMath:boolean false
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (itemAt lines i)
            def t:string (trim raw)
            i = (i + 1)
            if inFence {
                if (PresHelp.startsWith(t fenceMark)) {
                    inFence = false
                }
                continue
            }
            if inMath {
                if ((indexOf t "$$") >= 0) {
                    inMath = false
                }
                continue
            }
            if ((strlen t) == 0) {
                continue
            }
            if ((PresHelp.startsWith(t "```")) || (PresHelp.startsWith(t "~~~"))) {
                inFence = true
                fenceMark = (substring t 0 3)
                def lang:string (MdHtml.lower((trim (substring t 3 (strlen t)))))
                def sp:int (indexOf lang " ")
                if (sp > 0) {
                    lang = (substring lang 0 sp)
                }
                def br:int (indexOf lang "{")
                if (br >= 0) {
                    lang = (trim (substring lang 0 br))
                }
                PresHelp.attrsOf(sc t)
                if ((lang == "math") || (lang == "latex") || (lang == "tex")) {
                    sc.math = true
                } {
                    if ((lang == "mermaid") || ((lang == "dot") || ((lang == "graphviz") || ((lang == "d2") || ((lang == "plantuml") || (lang == "puml")))))) {
                        sc.diagram = true
                    } {
                        if ((lang == "vega-lite") || ((lang == "vegalite") || (lang == "vega"))) {
                            sc.chart = true
                        } {
                            sc.code = true
                        }
                    }
                }
                continue
            }
            if ((charAt t 0) == 35) {
                def lv:int 0
                while ((lv < (strlen t)) && ((charAt t lv) == 35)) {
                    lv = (lv + 1)
                }
                if ((lv <= 6) && ((indexOf sc.levels (to_string lv)) < 0)) {
                    sc.levels = (sc.levels + (to_string lv))
                }
                PresHelp.attrsOf(sc t)
                PresHelp.inline(sc t)
                continue
            }
            if (((charAt t 0) == 123) && ((charAt t ((strlen t) - 1)) == 125)) {
                PresHelp.attrsOf(sc t)
                continue
            }
            if (PresHelp.startsWith(t "$$")) {
                sc.math = true
                if (((strlen t) == 2) || ((indexOfFrom t "$$" 2) < 0)) {
                    inMath = true
                }
                continue
            }
            if (((t == "---") || (t == "***")) || (t == "___")) {
                sc.hr = true
                continue
            }
            if ((charAt t 0) == 62) {
                sc.quote = true
            } {
                if (PresHelp.isListLine(t)) {
                    sc.list = true
                    if (((indexOf t "[ ]") >= 0) || ((indexOf t "[x]") >= 0)) {
                        sc.addTag("task")
                    }
                } {
                    if ((charAt t 0) == 124) {
                        sc.table = true
                    } {
                        if ((PresHelp.startsWith(t "![")) == false) {
                            if ((charAt t 0) != 60) {
                                sc.para = true
                            }
                        }
                    }
                }
            }
            PresHelp.attrsOf(sc t)
            PresHelp.inline(sc t)
        }
        return sc
    }

    ; --- the answer ---------------------------------------------------------------
    sfn hasTag:boolean (sc:PresSlideScan t:string) {
        return ((indexOf sc.tags (" " + t + " ")) >= 0)
    }

    sfn levelDoc:string (lv:int) {
        if (lv == 1) { return (PresI18n.t("Presentation title: # Title.")) }
        if (lv == 2) { return (PresI18n.t("Slide title: ## Title starts a slide.")) }
        if (lv == 3) { return (PresI18n.t("Subheading within a slide: ### Title.")) }
        return ((PresI18n.t("Level ")) + (to_string lv) + (PresI18n.t(" heading.")))
    }

    sfn forSlide:string (text:string title:string css0:string) {
        def css:string (PresHelp.noComments(css0))
        def sc:PresSlideScan (PresHelp.scan(text))
        def out:[string]
        push out (PresHelp.feature("slide" (PresI18n.t("Slide and text")) (PresI18n.t("## Title starts a new slide")) (PresI18n.t("The slide's background and margins, and the font, size and color of all text.")) ((PresHelp.rule(css "page" (PresI18n.t("Slide background and margin.")) "background-color,padding")) + "," + (PresHelp.rule(css "document" (PresI18n.t("Defaults for all text.")) "font-family,font-size,line-height,color")))))
        if (((strlen title) > 0) || ((strlen sc.levels) > 0)) {
            def rules:string (PresHelp.rule(css "heading" (PresI18n.t("All headings.")) "font-family,color,margin-top,margin-bottom"))
            def lv:int 1
            def syn:string ""
            while (lv <= 6) {
                def ls:string (to_string lv)
                if (((indexOf sc.levels ls) >= 0) || ((lv == 2) && ((strlen sc.levels) == 0))) {
                    rules = (rules + "," + (PresHelp.rule(css ("h" + ls) (PresHelp.levelDoc(lv)) "font-size,color")))
                    def hashes:string ""
                    def k:int 0
                    while (k < lv) {
                        hashes = (hashes + "#")
                        k = (k + 1)
                    }
                    if ((strlen syn) > 0) {
                        syn = (syn + "   ")
                    }
                    syn = (syn + hashes + (PresI18n.t(" Title")))
                }
                lv = (lv + 1)
            }
            push out (PresHelp.feature("heading" (PresI18n.t("Headings")) syn (PresI18n.t("# is the presentation title (h1, opening slide), ## starts a new slide and is its title (h2), ### is a subheading within a slide (h3). Color: hN { color }, or heading { color } for all; otherwise the text color. The rule under h1 and h2 takes the hr rule's color.")) rules))
        }
        if sc.para {
            push out (PresHelp.feature("p" (PresI18n.t("Paragraph")) (PresI18n.t("Text; a blank line separates paragraphs.")) "" (PresHelp.rule(css "p" (PresI18n.t("Paragraph.")) "margin-bottom"))))
        }
        if sc.emph {
            push out (PresHelp.feature("emph" (PresI18n.t("Bold and italic")) (PresI18n.t("**bold**   *italic*   ***both***")) (PresI18n.t("Uses the bold and italic faces of the text font. It has no CSS rule of its own.")) ""))
        }
        if sc.list {
            def ls:string (PresI18n.t("- item   1. numbered item   indent with two spaces"))
            if (PresHelp.hasTag(sc "task")) {
                ls = (ls + (PresI18n.t("   - [ ] task   - [x] done")))
            }
            push out (PresHelp.feature("list" (PresI18n.t("List")) ls (PresI18n.t("An item is never split across two slides; if one item doesn't fit, the slide's text is made slightly smaller.")) ((PresHelp.rule(css "list" (PresI18n.t("The whole list.")) "padding-left,margin-left,color")) + "," + (PresHelp.rule(css "li" (PresI18n.t("One item.")) "margin-bottom")))))
        }
        if sc.quote {
            push out (PresHelp.feature("quote" (PresI18n.t("Quote")) (PresI18n.t("> quoted text")) "" (PresHelp.rule(css "blockquote" (PresI18n.t("The quote and its bar.")) "color,border-color,border-width,padding-left,padding-top"))))
        }
        if (sc.code || sc.inlineCode) {
            def cs:string (PresI18n.t("`code` inline"))
            if sc.code {
                cs = (cs + (PresI18n.t("   ```js … ``` as a block")))
            }
            push out (PresHelp.feature("code" (PresI18n.t("Code")) cs (PresI18n.t("The same rule applies to code blocks and inline code.")) (PresHelp.rule(css "code" (PresI18n.t("Code.")) "font-family,font-size,line-height,padding,background-color,border-color"))))
        }
        if (sc.table || sc.htmlTable) {
            def ts:string ""
            if sc.table {
                ts = "| A | B |   |---|---|   | 1 | 2 |"
            }
            if sc.htmlTable {
                if ((strlen ts) > 0) {
                    ts = (ts + "   ")
                }
                ts = (ts + "<table> <tr><th colspan=\"2\">…</th></tr> <td rowspan=\"2\">…</td>")
            }
            push out (PresHelp.feature("table" (PresI18n.t("Table")) ts (PresI18n.t("Cell alignment: :---: in the column separator row, or align=\"center\" in an HTML cell.")) (PresHelp.rule(css "table" (PresI18n.t("Table lines, header row and cell spacing.")) "border-color,background-color,padding-left,padding-top"))))
        }
        if sc.link {
            push out (PresHelp.feature("link" (PresI18n.t("Link")) (PresI18n.t("[text](https://…)   <a href=\"…\">text</a>")) "" (PresHelp.rule(css "a" (PresI18n.t("Link.")) "color"))))
        }
        if sc.hr {
            push out (PresHelp.feature("hr" (PresI18n.t("Horizontal rule")) "---" "" (PresHelp.rule(css "hr" (PresI18n.t("Rule.")) "color"))))
        }
        if sc.mark {
            push out (PresHelp.feature("mark" (PresI18n.t("Highlight")) (PresI18n.t("<mark>highlighted</mark>")) "" (PresHelp.rule(css "mark" (PresI18n.t("Highlighted text.")) "background-color,color"))))
        }
        if sc.kbd {
            push out (PresHelp.feature("kbd" (PresI18n.t("Key")) "<kbd>Ctrl</kbd> + <kbd>C</kbd>" (PresI18n.t("The text uses the code font (code { font-family }).")) (PresHelp.rule(css "kbd" (PresI18n.t("The key cap.")) "background-color,border-color"))))
        }
        ; the inline HTML that has no rule of its own
        def known:string "u ins s del strike ~~ sub sup small big abbr acronym q br span font style em strong b i"
        def parts:[string] (strsplit known " ")
        def syn2:string ""
        def k2:int 0
        while (k2 < (array_length parts)) {
            def tg:string (itemAt parts k2)
            if (PresHelp.hasTag(sc tg)) {
                def ex:string ""
                if ((tg == "u") || (tg == "ins")) { ex = (PresI18n.t("<u>underlined</u>")) }
                if ((tg == "s") || ((tg == "del") || (tg == "strike"))) { ex = (PresI18n.t("<s>struck through</s>")) }
                if (tg == "~~") { ex = (PresI18n.t("~~struck through~~")) }
                if (tg == "sub") { ex = "H<sub>2</sub>O" }
                if (tg == "sup") { ex = "x<sup>2</sup>" }
                if (tg == "small") { ex = (PresI18n.t("<small>small text</small> (85%)")) }
                if (tg == "big") { ex = (PresI18n.t("<big>big text</big> (115%)")) }
                if ((tg == "abbr") || (tg == "acronym")) { ex = (PresI18n.t("<abbr title=\"explanation\">GUI</abbr> (dashed underline)")) }
                if (tg == "q") { ex = (PresI18n.t("<q>quote</q>")) }
                if (tg == "br") { ex = (PresI18n.t("line break<br>")) }
                if ((tg == "span") || ((tg == "font") || (tg == "style"))) { ex = (PresI18n.t("<span style=\"color: #ff8800\">custom color</span>")) }
                if ((tg == "em") || (tg == "i")) { ex = (PresI18n.t("<em>italic</em>")) }
                if ((tg == "strong") || (tg == "b")) { ex = (PresI18n.t("<strong>bold</strong>")) }
                if (((strlen ex) > 0) && ((indexOf syn2 ex) < 0)) {
                    if ((strlen syn2) > 0) {
                        syn2 = (syn2 + "   ")
                    }
                    syn2 = (syn2 + ex)
                }
            }
            k2 = (k2 + 1)
        }
        if ((strlen syn2) > 0) {
            push out (PresHelp.feature("html" (PresI18n.t("HTML formatting")) syn2 (PresI18n.t("These have no theme rule of their own: the color comes from the text (document { color }). To color a single spot, add style=\"color: …\" to any of these tags.")) ""))
        }
        if sc.math {
            push out (PresHelp.feature("math" (PresI18n.t("Formulas")) (PresI18n.t("$E = mc^2$ inline   $$\\frac{a}{b}$$ on its own line   ```math … ```")) (PresI18n.t("A formula is drawn in the size and color of the surrounding text. To change its color inside the formula: \\color{red}{x}.")) (PresHelp.rule(css "document" (PresI18n.t("The formula's size and color come from the text.")) "font-size,color"))))
        }
        if sc.image {
            push out (PresHelp.feature("image" (PresI18n.t("Image")) (PresI18n.t("![description](image.png)   {width=60% height=50% align=center}")) (PresI18n.t("Click the image's line in the editor or double-click the image on the slide: Image settings (size, position, description, use as background). The image shrinks to fit the slide. Drag an image into the editor, paste it from the clipboard or add it from the Files tab.")) ((PresHelp.rule(css "img" (PresI18n.t("All images.")) "justify-content,max-height")) + "," + (PresHelp.rule(css "page" (PresI18n.t("Background image for all slides.")) "background-image")))))
        }
        if sc.diagram {
            push out (PresHelp.feature("diagram" (PresI18n.t("Diagram")) "```mermaid {tour=on style=sketch} … ```" (PresI18n.t("Mermaid, DOT, D2 and PlantUML diagrams, shown whole. ▶ next to the zoom buttons (T in the presentation) walks through the diagram; tour=on starts the tour on its own. style= picks the look: holo, sketch, mermaid, jurassic, cartoon or romantic. Per-diagram settings go in braces on the block's first line.")) (PresHelp.rule(css "diagram" (PresI18n.t("Diagram colors.")) "color,accent-color"))))
        }
        if sc.chart {
            ; the charts of this slide alone: its heading's anchor
            def anchor:string (MdAnchor.slug(title))
            def rules:string (PresHelp.rule(css "chart" (PresI18n.t("Chart colors, style and sizes.")) "color,accent-color,label-color,contrast,chart-style,chart-effects,font-size,title-font-size,title-gap,padding,justify-content"))
            def doc:string (PresI18n.t("The chart's own settings (\"config\", \"padding\") override the theme."))
            if ((strlen anchor) > 0) {
                rules = (rules + "," + (PresHelp.rule(css ("#" + anchor + " chart") (PresI18n.t("Only this slide's charts (the heading's anchor).")) "font-size,title-font-size,title-gap,padding,justify-content")))
                doc = ((PresI18n.t("Only this slide's charts: #")) + anchor + (PresI18n.t(" chart { … } – the name is the heading's anchor, the same as in a link #")) + anchor + ". " + doc)
            }
            push out (PresHelp.feature("chart" (PresI18n.t("Vega-Lite chart")) "```vega-lite { … } ```" doc rules))
        }
        ; classes
        def cls:[string] (strsplit (trim sc.classes) " ")
        def c:int 0
        while (c < (array_length cls)) {
            def cl:string (trim (itemAt cls c))
            if ((strlen cl) > 1) {
                def props:string "font-size,color"
                if ((cl == ".c2") || ((cl == ".c3") || (cl == ".c4"))) {
                    props = "column-count,column-gap"
                }
                def extra:string (PresHelp.propsOf(css cl))
                def eps:[string] (strsplit extra ",")
                def e:int 0
                while (e < (array_length eps)) {
                    def ep:string (itemAt eps e)
                    if (((strlen ep) > 0) && ((indexOf ("," + props + ",") ("," + ep + ",")) < 0)) {
                        if ((strlen props) > 0) {
                            props = (props + ",")
                        }
                        props = (props + ep)
                    }
                    e = (e + 1)
                }
                def rules2:string ""
                if ((strlen props) > 0) {
                    rules2 = (PresHelp.rule(css cl (PresHints.classDoc(cl)) props))
                }
                def cdoc:string ((PresHints.classDoc(cl)) + (PresI18n.t(" Size: pt, em (1.3em) or % of the text size.")))
                push out (PresHelp.feature(("class" + cl) ((PresI18n.t("Class ")) + cl) (cl + (PresI18n.t(" in braces: {")) + cl + (PresI18n.t("} after a paragraph or at the end of a heading"))) cdoc rules2))
            }
            c = (c + 1)
        }
        ; what every slide carries at its top and bottom
        push out (PresHelp.feature("furniture" (PresI18n.t("Header and footer")) (PresI18n.t("---   header-left: Company Ltd   header-right: ![](media/logo.png)   footer-right: {page} / {pages}   footer-skip: first last   ---")) (PresI18n.t("In the front matter (at the start of the document) or in the theme. Each edge has three places: -left, -center and -right. {page}, {pages} and {title} are filled in on every slide. footer-skip: first last leaves the first and last slide without it; ## Title {header=off} one slide. A slide's own background image: ## Title {bg=media/image.jpg bg-dim=0.4}.")) ((PresHelp.rule(css "header" (PresI18n.t("The top of every slide.")) "content,content-left,content-right,font-weight,color,background-color,border-color")) + "," + (PresHelp.rule(css "footer" (PresI18n.t("The bottom of every slide.")) "content,content-left,content-right,font-weight,color,background-color,border-color")))))
        ; the slide's own settings
        if ((array_length sc.attrNames) > 0) {
            def f:string (PresHelp.feature("attrs" (PresI18n.t("Slide settings")) (PresI18n.t("## Title {transition=zoom fx=starfield}")) (PresI18n.t("These are in the Markdown, not the theme. Hover over a value in the editor to change it.")) ""))
            def a:string ""
            def i:int 0
            while (i < (array_length sc.attrNames)) {
                def nm:string (itemAt sc.attrNames i)
                def d:string (PresHints.attrDoc(nm))
                if (((strlen d) == 0) && (PresHelp.startsWith(nm "fx-"))) {
                    d = (PresI18n.t("A background effect parameter."))
                }
                if ((strlen a) > 0) {
                    a = (a + ",")
                }
                a = (a + "{\"name\":" + (PresHint.q(nm)) + ",\"value\":" + (PresHint.q((itemAt sc.attrValues i))) + ",\"doc\":" + (PresHint.q(d)) + "}")
                i = (i + 1)
            }
            f = ((substring f 0 ((strlen f) - 3)) + "[" + a + "]}")
            push out f
        }
        def json:string "["
        def j:int 0
        while (j < (array_length out)) {
            if (j > 0) {
                json = (json + ",")
            }
            json = (json + (itemAt out j))
            j = (j + 1)
        }
        return (json + "]")
    }

    ; --- how Sliqtly is used --------------------------------------------------------
    ; The help panel's other tab: the everyday things, each with where it is
    ; and the keys for it, in the same shape as forSlide's parts (no rules).
    sfn guide:string () {
        def out:[string]
        push out (PresHelp.feature("present" (PresI18n.t("Presenting")) (PresI18n.t("⛶ Present   F5   → Space click: next   ← back   PageDown PageUp: whole slide   Home End   number + Enter   Esc: stop")) (PresI18n.t("Shows the presentation full screen. A step is the next build on the slide, then the next slide. The bar at the bottom right has the same jumps, the slide counter (type a number) and ⋯ for export and copy.")) ""))
        push out (PresHelp.feature("speaker" (PresI18n.t("Speaker view")) (PresI18n.t("S while presenting   ⋯ → Speaker view")) (PresI18n.t("For the presenter's own screen: the current slide on the left, the next slide, the time since you started, the slide number and the slide's notes on the right. Write the notes under the slide in a ::: notes block. S again (or the same menu row) goes back to the slide alone.")) ""))
        push out (PresHelp.feature("auto" (PresI18n.t("Auto-advance")) (PresI18n.t("A while presenting   ⋯ → Auto-advance")) (PresI18n.t("The slides go on by themselves, each after its own time ({seconds=…} on the slide). A again stops it.")) ""))
        push out (PresHelp.feature("pen" (PresI18n.t("Pen and pointer")) (PresI18n.t("✎ in the presenting bar   Backspace: wipe")) (PresI18n.t("Draw lines, arrows and ellipses on the slide while presenting. The drawing goes away when the slide changes.")) ""))
        push out (PresHelp.feature("record" (PresI18n.t("Recording")) (PresI18n.t("Record → ● Record presentation   Record → ▶ Play recording")) (PresI18n.t("Presents and records your voice, the pointer and the pen at the same time. The recording is kept in the presentation's files and plays back from the Record menu, with a voice filter if you like.")) ""))
        push out (PresHelp.feature("review" (PresI18n.t("Comments (review)")) (PresI18n.t("Settings → Review mode   Review in the left rail   💬 Comment")) (PresI18n.t("With review mode on, press 💬 Comment and then the slide to pin a comment there; each comment is its own conversation that can be closed. Review in the left rail lists them. The comments are kept in the presentation's files.")) ""))
        push out (PresHelp.feature("export" (PresI18n.t("Export")) (PresI18n.t("File → Export   PDF   PowerPoint   Word   Web page   Presentation player   Markdown   All files (.zip)")) (PresI18n.t("Saves the presentation as a file. Pick slides in the strip with Ctrl/⌘ or Shift + click to export only them. The presentation player is one .html file that presents without Sliqtly.")) ""))
        push out (PresHelp.feature("copy" (PresI18n.t("Copy to the clipboard")) (PresI18n.t("File → Export ▸ Clipboard   right click a slide → Copy ▸   while presenting ⋯ → Copy ▸")) (PresI18n.t("Copies the Markdown of this slide, the picked slides or the whole presentation, with the open comments as footnotes or without, or only the open comments with their slides, for example to hand to an assistant.")) ""))
        push out (PresHelp.feature("share" (PresI18n.t("Sharing")) (PresI18n.t("Share")) (PresI18n.t("Gives a link that shows the presentation and a link to edit a copy of it. Signed in, the link is short and carries the pictures and data. With slides picked in the strip, also a link that shows only them.")) ""))
        push out (PresHelp.feature("rooms" (PresI18n.t("Rooms")) (PresI18n.t("Rooms in the left rail")) (PresI18n.t("A room gathers presentations that belong together, for example one per project or ticket. New presentations start in General. Drag a presentation to another room to move it.")) ""))
        push out (PresHelp.feature("versions" (PresI18n.t("Versions")) (PresI18n.t("Versions in the left rail")) (PresI18n.t("Earlier versions of the presentation: view one, and restore it if you want it back.")) ""))
        push out (PresHelp.feature("claude" (PresI18n.t("Edit in Claude")) (PresI18n.t("File → Edit in Claude…")) (PresI18n.t("Opens Claude with the presentation and a ready prompt. Claude reads and saves the presentation with the Sliqtly connector, so add the connector first (sliqtly.com/connect.html). Open the link Claude gives to see the changes here.")) ""))
        push out (PresHelp.feature("mcp" (PresI18n.t("Sliqtly connector (MCP)")) "https://sliqtly.com/mcp" (PresI18n.t("Lets an assistant such as Claude make and change presentations itself: create, update, render a slide, export, and read and answer comments.")) ""))
        push out (PresHelp.feature("slidehelp" (PresI18n.t("This slide's parts")) (PresI18n.t("Help → Help for this slide")) (PresI18n.t("The other tab of this panel: what the selected slide is made of, how each part is written and which theme rules change how it looks.")) ""))
        def json:string "["
        def j:int 0
        while (j < (array_length out)) {
            if (j > 0) {
                json = (json + ",")
            }
            json = (json + (itemAt out j))
            j = (j + 1)
        }
        return (json + "]")
    }
}
