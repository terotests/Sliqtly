; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresHintPopover.rgr — what a value is and what it could be, in EVGUI
; ============================================================================
;
; Over `{fx=starfield}` in the Markdown or `chart-style: forge` in the theme,
; a small card says what the value does and offers the others:
;
;   enum, class, font   the choices, as a row of toggle buttons
;   color               EVGUI's colour picker (ColorPickerCtl, drawn by
;                       PresColorPanel), alpha included; `none` for a
;                       background
;   number              a slider and the number, in the value's own unit
;   adds                the parameters an effect could still take
;   wholeStart..End     a button that removes the item
;   selector            (`page {` in the theme) the properties it has and the
;                       ones it could have; one opens in the rule
;
; The hint itself is PresHints' JSON (PresApp.hintFor). A choice is written
; into the text as an ordinary edit: the card queues it (`edits`) and the app
; applies it with replaceRange, so Ctrl+Z undoes it. The card is a UiHost of
; its own as big as the app, drawn over it, in the EVGUI playground's look
; (web/hint.css over the kit's theme).
; ============================================================================

Import "PresI18n.rgr"
Import "PresColorPanel.rgr"
Import "../evgui/src/UiHost.rgr"
Import "PresKeep.rgr"
Import "../vela/src/VlJson.rgr"

class PresHintEdit {
    def line:int 0
    def a:int 0
    def b:int 0
    def text:string ""
    Constructor () {
    }
}

class PresHintPopover {
    def host:UiHost (new UiHost())
    def css:string ""
    ; The editor's skin ("" or "retro"): a theme name added to this host's own.
    def skin:string ""
    def isOpen:boolean false
    def w:double 1200.0
    def h:double 700.0
    ; where the card goes: under the value's box, in app coordinates
    def ax:double 0.0
    def ay:double 0.0
    def ah:double 20.0
    ; opened from the slide: the element's left edge and width (keepX < 0:
    ; not), which the card stays off — under it, over it, or beside it
    def keepX:double -1.0
    def keepW:double 0.0
    ; the hint
    def kind:string ""
    def name:string ""
    def value:string ""
    def doc:string ""
    ; a warning about the line (text too faint on its slide), above the rest
    def warn:string ""
    def unit:string ""
    def tab:string "md"
    def line:int 0
    def start:int 0
    def end:int 0
    def wholeStart:int -1
    def wholeEnd:int -1
    def text:string ""
    def options:[string]
    def adds:[string]
    def hasRange:boolean false
    def rmin:double 0.0
    def rmax:double 100.0
    def rstep:double 1.0
    def rule:VlJson (VlJson.nullValue())
    ; what the app is asked to do
    def edits:[PresHintEdit]
    def wantsClose:boolean false
    ; opened from a selector's list on the slide: ‹ goes back to that list
    def canBack:boolean false
    ; the head, and the × placed in its corner once the head is laid out
    def headEl@(optional):EVGElement
    def closeEl@(optional):EVGElement
    def wantsBack:boolean false
    ; the hint is in the front matter: a button opens the document settings
    def docset:boolean false
    def wantsDoc:boolean false
    ; "sel<TAB>prop<TAB>default" when a property of a selector was picked
    def wantsProp:string ""
    ; the doc line of the selector property under the pointer
    def tip:string ""
    ; the doc line's element and the height kept for it: the tallest doc line of
    ; the selector, so a longer line never moves the rows (-1: not measured yet)
    def tipEl@(optional):EVGElement
    def tipH:double -1.0
    def rev:int 0
    def keep:PresKeep (new PresKeep())
    def measurer@(optional):TTFTextMeasurer
    def picker:ColorPickerCtl (new ColorPickerCtl())
    def cp:PresColorPanel (new PresColorPanel())
    def dragPart:string ""
    def slider:SliderCtl (new SliderCtl())
    def sliding:boolean false
    def field:InputCtl (new InputCtl())
    def fieldOn:boolean false
    ; the value in the header, updated in place while the slider is dragged
    def valueEl:EVGElement (EVGElement.createSpan())

    Constructor () {
    }

    ; --- opening ------------------------------------------------------------------
    ; The same hint as the one showing: nothing to rebuild.
    fn same:boolean (json:string) {
        if (isOpen == false) {
            return false
        }
        def p (new VlJsonParser())
        def j:VlJson (p.parse(json))
        return ((((j.intOr("line" -1)) == line) && ((j.intOr("start" -1)) == start)) && (((j.stringOr("name" "")) == name) && ((j.stringOr("tab" "")) == tab)))
    }

    fn open:boolean (json:string pw:double ph:double) {
        def p (new VlJsonParser())
        def j:VlJson (p.parse(json))
        if ((j.isObject()) == false) {
            return false
        }
        w = pw
        h = ph
        kind = (j.stringOr("kind" ""))
        name = (j.stringOr("name" ""))
        value = (j.stringOr("value" ""))
        doc = (j.stringOr("doc" ""))
        warn = (j.stringOr("warn" ""))
        unit = (j.stringOr("unit" ""))
        tab = (j.stringOr("tab" "md"))
        line = (j.intOr("line" 0))
        docset = (j.boolOr("docset" false))
        start = (j.intOr("start" 0))
        end = (j.intOr("end" 0))
        wholeStart = (j.intOr("wholeStart" -1))
        wholeEnd = (j.intOr("wholeEnd" -1))
        text = (j.stringOr("text" ""))
        ax = (j.doubleOr("x" 0.0))
        ay = (j.doubleOr("y" 0.0))
        ah = (j.doubleOr("h" 20.0))
        keepX = (j.doubleOr("keepX" -1.0))
        keepW = (j.doubleOr("keepW" 0.0))
        def o:[string]
        def ov:VlJson (j.get("options"))
        def i:int 0
        while (i < (ov.count())) {
            push o ((ov.at(i)).asString())
            i = (i + 1)
        }
        options = o
        def ad:[string]
        def av:VlJson (j.get("adds"))
        i = 0
        while (i < (av.count())) {
            push ad ((av.at(i)).asString())
            i = (i + 1)
        }
        adds = ad
        hasRange = ((j.has("min")) && (j.has("max")))
        rmin = (j.doubleOr("min" 0.0))
        rmax = (j.doubleOr("max" 100.0))
        rstep = (j.doubleOr("step" 1.0))
        if (rstep <= 0.0) {
            rstep = 1.0
        }
        rule = (j.get("rule"))
        tip = ""
        tipH = -1.0
        wantsClose = false
        wantsBack = false
        canBack = false
        wantsDoc = false
        wantsProp = ""
        dragPart = ""
        sliding = false
        fieldOn = false
        cp.focused = ""
        if (kind == "color") {
            def fresh (new ColorPickerCtl())
            picker = fresh
            def start0:string value
            if ((PresHintPopover.isHex(value)) == false) {
                start0 = "#ffffff"
            }
            picker.setup("hp-cp" (PresI18n.t("Color")) start0 true)
            picker.inline = true
            picker.hexBoxW = 150.0
            picker.numBoxW = 30.0
            def presets:[string] (strsplit "#ef4444,#f97316,#eab308,#22c55e,#06b6d4,#3b82f6,#8b5cf6,#ec4899" ",")
            def pi:int 0
            while (pi < (array_length presets)) {
                push picker.swatches (itemAt presets pi)
                pi = (pi + 1)
            }
            picker.syncFields()
        }
        isOpen = true
        this.rebuild()
        return true
    }

    fn close:void () {
        isOpen = false
        rev = (rev + 1)
    }

    sfn isHex:boolean (v:string) {
        def t:string (trim v)
        return (((strlen t) >= 4) && ((charAt t 0) == 35))
    }

    ; --- the text --------------------------------------------------------------------
    ; The value's text written back, and the hint moved on to the new text.
    fn write:void (t:string) {
        def e (new PresHintEdit())
        e.line = line
        e.a = start
        e.b = end
        e.text = t
        push edits e
        text = ((substring text 0 start) + t + (substring text end (strlen text)))
        if (wholeEnd >= 0) {
            wholeEnd = (wholeEnd + ((strlen t) - (end - start)))
        }
        end = (start + (strlen t))
        value = t
        rev = (rev + 1)
    }

    fn hasFlag:boolean (f:string) {
        def ws:[string] (strsplit value " ")
        def i:int 0
        while (i < (array_length ws)) {
            if ((itemAt ws i) == f) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; The value with `f` turned on or off, in the options' order; "none" when
    ; nothing is left.
    fn toggledFlags:string (f:string) {
        def on:boolean (this.hasFlag(f))
        def out:string ""
        def i:int 0
        while (i < (array_length options)) {
            def o:string (itemAt options i)
            def keep:boolean (this.hasFlag(o))
            if (o == f) {
                keep = (on == false)
            }
            if keep {
                if ((strlen out) > 0) {
                    out = (out + " ")
                }
                out = (out + o)
            }
            i = (i + 1)
        }
        if ((strlen out) == 0) {
            return "none"
        }
        return out
    }

    ; --- building --------------------------------------------------------------------
    fn div:EVGElement (cls:string) {
        def d (EVGElement.createDiv())
        d.className = cls
        return d
    }

    fn words:EVGElement (cls:string t:string) {
        def s (EVGElement.createSpan())
        s.className = cls
        s.textContent = t
        return s
    }

    fn put:void (c:UiCtl parent:EVGElement) {
        push host.ctls c
        parent.addChild((unwrap c.rootEl))
    }

    fn button:ButtonCtl (tid:string label:string variant:string parent:EVGElement) {
        def c (new ButtonCtl())
        c.tid = tid
        c.name = label
        c.variant = variant
        c.build()
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r "hp-button")
        if ((variant == "primary") && ((r.getChildCount()) > 0)) {
            UiTree.addClass((r.getChild(0)) "hp-onprimary")
        }
        if ((variant == "danger") && ((r.getChildCount()) > 0)) {
            UiTree.addClass((r.getChild(0)) "hp-ondanger")
        }
        this.put(c parent)
        return c
    }

    fn rebuild:void () {
        def fresh (new UiHost())
        host = fresh
        host.addStyleSheet(css)
        host.setTheme((trim ("hp " + skin)))
        host.setPageSize(w h)
        def root:EVGElement (unwrap host.root)
        root.className = "ui-root hp-page"
        def card:EVGElement (this.div("hp-card"))
        card.id = "hp-card"
        def head:EVGElement (this.div("hp-head"))
        if canBack {
            def bk:ButtonCtl (this.button("hp-back" "‹" "secondary" head))
            UiTree.addClass((unwrap bk.rootEl) "hp-x")
        }
        head.addChild((this.words("hp-name" name)))
        valueEl = (this.words("hp-value" value))
        if (kind == "warn") {
            head.className = "hp-foot hp-warnhead"
        } {
            head.addChild(valueEl)
        }
        ; room in the head for the × drawn in its corner (built last, below)
        head.addChild((this.div("hp-grow")))
        head.addChild((this.div("hp-xroom")))
        headEl = head
        card.addChild(head)
        if ((strlen warn) > 0) {
            card.addChild((this.words("hp-warn" warn)))
        }
        if ((strlen doc) > 0) {
            card.addChild((this.words("hp-doc" doc)))
        }
        if (kind == "selector") {
            this.selectorRows(card)
        }
        if (((kind == "enum") || (kind == "class")) || (kind == "font")) {
            def chips:EVGElement (this.div("hp-chips"))
            def i:int 0
            while (i < (array_length options)) {
                def o:string (itemAt options i)
                def v:string "secondary"
                if (o == value) {
                    v = "primary"
                }
                this.button(("hp-opt-" + (to_string i)) o v chips)
                i = (i + 1)
            }
            card.addChild(chips)
        }
        ; any of the words together: each chip turns its word on or off
        if (kind == "flags") {
            def fchips:EVGElement (this.div("hp-chips"))
            def fi:int 0
            while (fi < (array_length options)) {
                def fo:string (itemAt options fi)
                def fv:string "secondary"
                if (this.hasFlag(fo)) {
                    fv = "primary"
                }
                this.button(("hp-flag-" + (to_string fi)) fo fv fchips)
                fi = (fi + 1)
            }
            card.addChild(fchips)
        }
        if (kind == "color") {
            card.addChild((cp.panel(picker)))
            push host.ctls picker
            if ((indexOf name "background") >= 0) {
                def row:EVGElement (this.div("hp-chips"))
                this.button("hp-none" "none" "secondary" row)
                card.addChild(row)
            }
        }
        if (kind == "number") {
            this.numberRow(card)
        }
        if ((array_length adds) > 0) {
            def left:[string] (this.addsLeft())
            if ((array_length left) > 0) {
                card.addChild((this.words("hp-label" (PresI18n.t("Add parameter")))))
                def ar:EVGElement (this.div("hp-chips"))
                def k:int 0
                while (k < (array_length left)) {
                    this.button(("hp-add-" + (to_string k)) (itemAt left k) "secondary" ar)
                    k = (k + 1)
                }
                card.addChild(ar)
            }
        }
        def hasRemove:boolean ((wholeStart >= 0) && (wholeEnd > wholeStart))
        if (hasRemove || docset) {
            def foot:EVGElement (this.div("hp-foot"))
            if docset {
                this.button("hp-docset" (PresI18n.t("Document settings…")) "secondary" foot)
            }
            foot.addChild((this.div("hp-grow")))
            if hasRemove {
                this.button("hp-remove" (PresI18n.t("Remove")) "danger" foot)
            }
            card.addChild(foot)
        }
        ; every card closes from its corner (Esc and a press outside close it
        ; too); last in the card, so the keyboard reaches the values first
        card.position = "relative"
        def x:ButtonCtl (this.button("hp-close" "×" "secondary" card))
        def xe:EVGElement (unwrap x.rootEl)
        UiTree.addClass(xe "hp-x")
        xe.position = "absolute"
        closeEl = xe
        ; under the value, kept on the screen (flipped above when it would not fit)
        UiTree.surface(card "free" "start")
        def cx:double ax
        if ((cx + 320.0) > (w - 8.0)) {
            cx = ((w - 8.0) - 320.0)
        }
        if (cx < 8.0) {
            cx = 8.0
        }
        card.overlayX = cx
        card.overlayY = ((ay + ah) + 4.0)
        root.addChild(card)
        keep.remember(host)
        rev = (rev + 1)
    }

    ; The adds not in the text yet.
    fn addsLeft:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length adds)) {
            def a:string (itemAt adds i)
            def eq:int (indexOf a "=")
            def key:string a
            if (eq > 0) {
                key = (substring a 0 eq)
            }
            if ((indexOf text (key + "=")) < 0) {
                push out a
            }
            i = (i + 1)
        }
        return out
    }

    fn numberParts:[string] () {
        ; the number and what follows it
        def t:string (trim value)
        def i:int 0
        def n:int (strlen t)
        while ((i < n) && ((((charAt t i) >= 48) && ((charAt t i) <= 57)) || (((charAt t i) == 46) || ((charAt t i) == 45)))) {
            i = (i + 1)
        }
        def out:[string]
        push out (substring t 0 i)
        push out (substring t i n)
        return out
    }

    fn numberRow:void (card:EVGElement) {
        def parts:[string] (this.numberParts())
        def num:double (?? (str2double (itemAt parts 0)) 0.0)
        def u:string unit
        if ((strlen u) == 0) {
            u = (itemAt parts 1)
        }
        def lo:double rmin
        def hi:double rmax
        if (hasRange == false) {
            lo = 0.0
            hi = 100.0
        }
        if (num < lo) {
            lo = num
        }
        if (num > hi) {
            hi = num
        }
        def row:EVGElement (this.div("hp-row"))
        def s (new SliderCtl())
        slider = s
        slider.tid = "hp-slider"
        slider.name = name
        slider.minValue = (to_int (lo / rstep))
        slider.maxValue = (to_int ((hi / rstep) + 0.5))
        slider.step = 1
        slider.value = (to_int ((num / rstep) + 0.5))
        slider.build()
        UiTree.addClass((unwrap slider.rootEl) "hp-slider")
        this.put(slider row)
        def f (new InputCtl())
        field = f
        field.tid = "hp-num"
        field.name = name
        field.fontFamily = "Open Sans"
        field.fontSize = 13.0
        field.boxWidth = 60.0
        field.setValue((itemAt parts 0))
        field.moveTo((strlen (itemAt parts 0)) false)
        field.build()
        UiTree.addClass((unwrap field.rootEl) "hp-numfield")
        if fieldOn {
            UiTree.addClass((unwrap field.rootEl) "hp-focus")
        }
        this.put(field row)
        if ((strlen u) > 0) {
            row.addChild((this.words("hp-unit" u)))
        }
        card.addChild(row)
    }

    fn selectorRows:void (card:EVGElement) {
        def props:VlJson (rule.get("props"))
        def setBox:EVGElement (this.div("hp-props"))
        def unsetBox:EVGElement (this.div("hp-props"))
        def nSet:int 0
        def nUnset:int 0
        def i:int 0
        while (i < (props.count())) {
            def p:VlJson (props.at(i))
            def pv:string (p.stringOr("value" ""))
            ; set ones blue, the ones that can be added grey; a property of
            ; another rule (the stage's style panel merges a few) says whose
            def psel:string (p.stringOr("sel" ""))
            def pn:string (p.stringOr("name" ""))
            if (((strlen psel) > 0) && (psel != (rule.stringOr("sel" name)))) {
                pn = (psel + " › " + pn)
            }
            ; the stage's style panel names what a property does ("bullet
            ; colour") and shows the value the slide uses and its rule
            def plabel:string (p.stringOr("label" ""))
            if ((strlen plabel) > 0) {
                pn = plabel
            }
            def peff:string (p.stringOr("eff" ""))
            def pfrom:string (p.stringOr("from" "-"))
            def staged:boolean (pfrom != "-")
            def row:EVGElement (this.div("hp-prop"))
            row.id = ("hp-prop-" + (to_string i))
            def pcls:string "hp-pname hp-pname-unset"
            if ((strlen pv) > 0) {
                pcls = "hp-pname hp-pname-set"
            }
            row.addChild((this.words(pcls pn)))
            row.addChild((this.div("hp-grow")))
            if ((strlen pv) > 0) {
                if (PresHintPopover.isHex(pv)) {
                    def sw:EVGElement (this.div("hp-swatch"))
                    UiTree.inline(sw "background-color" pv)
                    row.addChild(sw)
                }
                row.addChild((this.words("hp-pvalue" pv)))
                ; set here, but another rule decides what the slide shows
                if (staged && ((pfrom != psel) && ((strlen pfrom) > 0))) {
                    row.addChild((this.words("hp-pfrom" ("→ " + pfrom))))
                } {
                    ; the element's value lives in a wider rule (`document`)
                    if (staged && (psel != (rule.stringOr("sel" name)))) {
                        row.addChild((this.words("hp-pfrom" ("← " + psel))))
                    }
                }
                setBox.addChild(row)
                nSet = (nSet + 1)
            } {
                if (staged && ((strlen peff) > 0)) {
                    if (PresHintPopover.isHex(peff)) {
                        def sw2:EVGElement (this.div("hp-swatch"))
                        UiTree.inline(sw2 "background-color" peff)
                        row.addChild(sw2)
                    }
                    row.addChild((this.words("hp-pinh" peff)))
                    def fromText:string pfrom
                    if ((strlen fromText) == 0) {
                        fromText = (PresI18n.t("default"))
                    }
                    row.addChild((this.words("hp-pfrom" ("← " + fromText))))
                } {
                    row.addChild((this.words("hp-padd" (PresI18n.t("+ add")))))
                }
                unsetBox.addChild(row)
                nUnset = (nUnset + 1)
            }
            i = (i + 1)
        }
        if (nSet > 0) {
            card.addChild((this.words("hp-label" (PresI18n.t("Set")))))
            card.addChild(setBox)
        }
        if (nUnset > 0) {
            def unsetTitle:string (PresI18n.t("Can be added"))
            if ((rule.stringOr("stage" "")) == "1") {
                unsetTitle = (PresI18n.t("Not set here: inherited or default"))
            }
            card.addChild((this.words("hp-label" unsetTitle)))
            card.addChild(unsetBox)
        }
        if ((nSet + nUnset) == 0) {
            card.addChild((this.words("hp-doc" (PresI18n.t("Unknown selector: its properties don't affect the slides.")))))
        } {
            def t:string tip
            if ((strlen t) == 0) {
                t = (PresI18n.t("Hover over a property to see what it does."))
            }
            def te:EVGElement (this.words("hp-tip" t))
            if (tipH > 0.0) {
                UiTree.inline(te "min-height" ((to_string tipH) + "px"))
            }
            tipEl = te
            card.addChild(te)
        }
    }

    ; --- drawing ------------------------------------------------------------------------
    fn page:EVGElement () {
        def r:EVGElement (unwrap host.root)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h false)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def eng:EVGTextEngine (lay.getTextEngine())
        cp.eng = eng
        if (kind == "number") {
            def car:EVGElement (unwrap field.caretEl)
            if fieldOn {
                field.ensureCaretVisible(eng)
                def box:EVGElement (unwrap field.rootEl)
                box.position = "relative"
                car.position = "absolute"
                car.left = (EVGUnit.px(((field.caretXAt(eng field.caret)) - field.scrollX)))
                car.top = (EVGUnit.px(6.0))
            } {
                car.width = (EVGUnit.px(0.0))
            }
        }
        lay.layout(pg)
        if ((!null? headEl) && (!null? closeEl)) {
            def hd:EVGElement (unwrap headEl)
            def xb:EVGElement (unwrap closeEl)
            xb.left = (EVGUnit.px((hd.calculatedWidth - xb.calculatedWidth)))
            xb.top = (EVGUnit.px(((hd.calculatedHeight - xb.calculatedHeight) / 2.0)))
            lay.layout(pg)
        }
        if ((kind == "selector") && (tipH < 0.0)) {
            this.measureTip(lay pg)
        }
        ; above the value when there is no room under it
        def c:EVGElement (this.cardEl())
        def ch:double c.calculatedHeight
        def cw:double c.calculatedWidth
        def under:boolean ((c.calculatedY + ch) <= (h - 8.0))
        def over:boolean (((ay - ch) - 4.0) > 8.0)
        if ((under == false) && over) {
            c.overlayY = ((ay - ch) - 4.0)
            lay.layout(pg)
        }
        ; an element on the slide with room neither under nor over it: the
        ; card beside it, so what it changes stays in sight
        if (((keepX >= 0.0) && (under == false)) && (over == false)) {
            def side:double -1.0
            if ((((keepX + keepW) + 8.0) + cw) <= (w - 8.0)) {
                side = ((keepX + keepW) + 8.0)
            } {
                if (((keepX - 8.0) - cw) >= 8.0) {
                    side = ((keepX - 8.0) - cw)
                }
            }
            def top:double ay
            if ((top + ch) > (h - 8.0)) {
                top = ((h - 8.0) - ch)
            }
            if (top < 8.0) {
                top = 8.0
            }
            if (side >= 0.0) {
                c.overlayX = side
            }
            c.overlayY = top
            lay.layout(pg)
        }
        if (kind == "color") {
            cp.placeThumbs(pg picker)
        }
        host.lastPage = pg
        return pg
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.page())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; The tallest doc line the selector can show, kept as the line's height from
    ; now on: a line that grows under the pointer would move the rows (and the
    ; card, when it sits above the value) away from the pointer and back.
    fn measureTip:void (lay:EVGLayout pg:EVGElement) {
        tipH = 0.0
        if (null? tipEl) {
            return
        }
        def te:EVGElement (unwrap tipEl)
        def shown:string te.textContent
        def most:double te.calculatedHeight
        def props:VlJson (rule.get("props"))
        def i:int 0
        while (i < (props.count())) {
            def p:VlJson (props.at(i))
            te.textContent = ((p.stringOr("name" "")) + ": " + (p.stringOr("doc" "")))
            lay.layout(pg)
            if (te.calculatedHeight > most) {
                most = te.calculatedHeight
            }
            i = (i + 1)
        }
        te.textContent = shown
        tipH = (to_double (ceil most))
        UiTree.inline(te "min-height" ((to_string tipH) + "px"))
        lay.layout(pg)
    }

    fn cardEl:EVGElement () {
        def r:EVGElement (unwrap host.root)
        def i:int 0
        while (i < (r.getChildCount())) {
            def k:EVGElement (r.getChild(i))
            if (k.id == "hp-card") {
                return k
            }
            i = (i + 1)
        }
        return r
    }

    ; --- the pointer ---------------------------------------------------------------------
    fn has:boolean (px:double py:double) {
        if (isOpen == false) {
            return false
        }
        if (null? host.lastPage) {
            this.page()
        }
        def c:EVGElement (this.cardEl())
        return (((px >= c.calculatedX) && (px <= (c.calculatedX + c.calculatedWidth))) && ((py >= c.calculatedY) && (py <= (c.calculatedY + c.calculatedHeight))))
    }

    fn dragging:boolean () {
        return (sliding || ((strlen dragPart) > 0))
    }

    ; A plain box under the point with an id (a selector's property row).
    fn rowAt:string (px:double py:double) {
        if (null? host.lastPage) {
            return ""
        }
        def hit (new EVGHitTest())
        def order:[EVGElement] (hit.paintOrder((unwrap host.lastPage)))
        def i:int ((array_length order) - 1)
        while (i >= 0) {
            def el:EVGElement (itemAt order i)
            if ((indexOf el.id "hp-prop-") == 0) {
                if (host.containsPoint(el px py)) {
                    return el.id
                }
            }
            i = (i - 1)
        }
        return ""
    }

    fn press:void (px:double py:double) {
        if (null? host.lastPage) {
            this.page()
        }
        ; a selector's property: opened in its rule
        def row:string (this.rowAt(px py))
        if ((strlen row) > 0) {
            def idx:int (?? (str2int (substring row 8 (strlen row))) -1)
            def p:VlJson ((rule.get("props")).at(idx))
            wantsProp = ((p.stringOr("sel" (rule.stringOr("sel" name)))) + (strfromcode 9) + (p.stringOr("name" "")) + (strfromcode 9) + (p.stringOr("def" "")))
            return
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            this.leaveField()
            return
        }
        def ctlTid:string tid
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            ctlTid = owner.tid
        }
        if ((kind == "color") && (ctlTid == picker.tid)) {
            def what:string (cp.press((unwrap host.lastPage) picker tid px py))
            if (((what == "sv") || (what == "hue")) || (what == "alpha")) {
                dragPart = what
                this.write((picker.hex()))
            }
            if (what == "changed") {
                this.write((picker.hex()))
            }
            this.rebuild()
            return
        }
        cp.leaveField(picker)
        if (ctlTid == "hp-slider") {
            this.leaveField()
            host.pressAt(px py)
            keep.restore()
            sliding = true
            this.takeSlider()
            return
        }
        if (ctlTid == "hp-num") {
            fieldOn = true
            host.focus("hp-num")
            this.rebuild()
            return
        }
        this.leaveField()
        if ((indexOf ctlTid "hp-opt-") == 0) {
            def oi:int (?? (str2int (substring ctlTid 7 (strlen ctlTid))) -1)
            if ((oi >= 0) && (oi < (array_length options))) {
                this.write((itemAt options oi))
                this.rebuild()
            }
            return
        }
        if ((indexOf ctlTid "hp-flag-") == 0) {
            def fi:int (?? (str2int (substring ctlTid 8 (strlen ctlTid))) -1)
            if ((fi >= 0) && (fi < (array_length options))) {
                this.write((this.toggledFlags((itemAt options fi))))
                this.rebuild()
            }
            return
        }
        if (ctlTid == "hp-docset") {
            wantsDoc = true
            return
        }
        if (ctlTid == "hp-close") {
            wantsClose = true
            return
        }
        if (ctlTid == "hp-back") {
            wantsBack = true
            return
        }
        if (ctlTid == "hp-none") {
            this.write("none")
            this.rebuild()
            return
        }
        if ((indexOf ctlTid "hp-add-") == 0) {
            def left:[string] (this.addsLeft())
            def ai:int (?? (str2int (substring ctlTid 7 (strlen ctlTid))) -1)
            if ((ai >= 0) && (ai < (array_length left))) {
                def e (new PresHintEdit())
                e.line = line
                e.a = wholeEnd
                e.b = wholeEnd
                e.text = (" " + (itemAt left ai))
                push edits e
                wantsClose = true
            }
            return
        }
        if (ctlTid == "hp-remove") {
            def e2 (new PresHintEdit())
            e2.line = line
            e2.a = wholeStart
            e2.b = wholeEnd
            e2.text = ""
            push edits e2
            wantsClose = true
            return
        }
    }

    fn leaveField:void () {
        if fieldOn {
            fieldOn = false
            this.rebuild()
        }
    }

    fn numberText:string (v:double) {
        def decimals:int 0
        def st:string (to_string rstep)
        def dot:int (indexOf st ".")
        if (dot >= 0) {
            decimals = (((strlen st) - dot) - 1)
            if (decimals > 3) {
                decimals = 3
            }
        }
        return (VlJson.formatNumber(v decimals))
    }

    fn unitText:string () {
        if ((strlen unit) > 0) {
            return unit
        }
        def parts:[string] (this.numberParts())
        return (itemAt parts 1)
    }

    fn takeSlider:void () {
        def v:double ((to_double slider.value) * rstep)
        def t:string ((this.numberText(v)) + (this.unitText()))
        if (t != value) {
            this.write(t)
        }
    }

    fn dragTo:void (px:double py:double) {
        if ((strlen dragPart) > 0) {
            cp.dragAt((unwrap host.lastPage) picker dragPart px py)
            this.write((picker.hex()))
            this.rebuild()
            this.page()
            return
        }
        if sliding {
            ; the host keeps the drag: the card is not rebuilt until release
            host.pointerMove(px py)
            keep.restore()
            this.takeSlider()
            def parts:[string] (this.numberParts())
            field.setValue((itemAt parts 0))
            field.build()
            valueEl.textContent = value
            rev = (rev + 1)
        }
    }

    fn release:void () {
        if sliding {
            sliding = false
            host.pointerUp()
            keep.restore()
            this.rebuild()
        }
        if ((strlen dragPart) > 0) {
            dragPart = ""
            this.rebuild()
        }
    }

    ; The doc line follows the pointer over a selector's properties.
    fn hoverAt:void (px:double py:double) {
        if (kind != "selector") {
            return
        }
        def row:string (this.rowAt(px py))
        def t:string ""
        if ((strlen row) > 0) {
            def idx:int (?? (str2int (substring row 8 (strlen row))) -1)
            def p:VlJson ((rule.get("props")).at(idx))
            t = ((p.stringOr("name" "")) + ": " + (p.stringOr("doc" "")))
        }
        if (t != tip) {
            tip = t
            this.rebuild()
        }
    }

    ; --- keys ---------------------------------------------------------------------------
    ; Keys and text go here while a field of the card has them.
    fn hasKeys:boolean () {
        return (fieldOn || ((strlen cp.focused) > 0))
    }

    fn key:boolean (name0:string shift:boolean ctrl:boolean) {
        def k:string ""
        if (name0 == "left") { k = "ArrowLeft" }
        if (name0 == "right") { k = "ArrowRight" }
        if (name0 == "up") { k = "ArrowUp" }
        if (name0 == "down") { k = "ArrowDown" }
        if (name0 == "home") { k = "Home" }
        if (name0 == "end") { k = "End" }
        if (name0 == "backspace") { k = "Backspace" }
        if (name0 == "delete") { k = "Delete" }
        if (name0 == "enter") { k = "Enter" }
        if ((strlen cp.focused) > 0) {
            if ((strlen k) > 0) {
                cp.keyWith(picker k shift ctrl)
                this.write((picker.hex()))
                this.rebuild()
            }
            return true
        }
        if fieldOn {
            if (name0 == "enter") {
                this.leaveField()
                return true
            }
            if (((strlen k) > 0) && ((k != "ArrowUp") && (k != "ArrowDown"))) {
                host.keyWith(k shift ctrl)
                keep.restore()
                this.takeField()
                this.rebuild()
            }
            return true
        }
        return false
    }

    fn type:void (s:string) {
        if ((strlen cp.focused) > 0) {
            def i:int 0
            while (i < (strlen s)) {
                cp.type(picker (substring s i (i + 1)))
                i = (i + 1)
            }
            this.write((picker.hex()))
            this.rebuild()
            return
        }
        if fieldOn {
            def j:int 0
            while (j < (strlen s)) {
                host.type((substring s j (j + 1)))
                keep.restore()
                j = (j + 1)
            }
            this.takeField()
            this.rebuild()
        }
    }

    fn takeField:void () {
        def v:string (trim field.value)
        def d@(optional):double (str2double v)
        if (!null? d) {
            this.write((v + (this.unitText())))
        }
    }

    fn cursorAt:string (px:double py:double) {
        if ((this.has(px py)) == false) {
            return ""
        }
        if ((strlen (this.rowAt(px py))) > 0) {
            return "pointer"
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return "default"
        }
        return "pointer"
    }
}
