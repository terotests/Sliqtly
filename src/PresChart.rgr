; SPDX-License-Identifier: AGPL-3.0-or-later
;
; PresChart — a chart (a ```vega-lite fence) dressed for the stage.
;
; The markdown module draws a chart the way a report prints it: flat bars on
; a white card. On a slide that reads as a screenshot. Here the commands it
; produced are taken over after the fact: the card is dropped, the grid and
; axes go into the theme's accent, and the bars become hard-edged columns of
; light — the theme's warm colour burning down into rust, a bright cap with a
; glow, fine machined grooves across them. On the timeline the columns rise
; one after another, and a scan beam passes over the finished chart once.
;
; Deterministic like the rest: the picture is a function of `t`, the time
; since the slide started. `still` (an export) is the finished chart.

Import "PresDiagram.rgr"

class PresChart {

    ; `spec` is the fence's own text. What it says outright wins over the
    ; theme: a mark "color" is the columns' colour (still dressed: the burn,
    ; the cap, the grooves), a labelColor/titleColor keeps the words as the
    ; chart drew them, a gridColor/domainColor/tickColor the lines.
    ; `style` is the theme's `chart { chart-style }`: flat (plain columns, the
    ; default), forge (burning down into rust, grooves, a glowing cap, a
    ; scan pass), neon (lit edges round a faint body) or glass (a clear
    ; gradient with a bright rim).
    sfn dress:void (out:EVGDisplayList from:int t:double still:boolean accentHex:string warmHex:string spec:string style:string) {
        ; `style` is the theme's chart-style and, after it, its chart-effects
        ; ("forge glow gradient")
        def words:[string] (strsplit (trim style) " ")
        def style0:string ""
        if ((array_length words) > 0) {
            style0 = (itemAt words 0)
        }
        def st:string "flat"
        if (((style0 == "forge") || (style0 == "neon")) || (style0 == "glass")) {
            st = style0
        }
        ; the chart's own dressing (the editor writes it into `usermeta`)
        def own:string (PresChart.specString(spec "presStyle"))
        if ((((own == "flat") || (own == "forge")) || (own == "neon")) || (own == "glass")) {
            st = own
        }
        def fx:string ""
        def wi:int 1
        while (wi < (array_length words)) {
            def wd:string (itemAt words wi)
            if (((wd == "glow") || (wd == "shadow")) || (wd == "gradient")) {
                fx = (fx + " " + wd)
            }
            wi = (wi + 1)
        }
        if (PresChart.specTrue(spec "presGlow")) {
            fx = (fx + " glow")
        }
        if (PresChart.specTrue(spec "presShadow")) {
            fx = (fx + " shadow")
        }
        if (PresChart.specTrue(spec "presGradient")) {
            fx = (fx + " gradient")
        }
        def ac:EVGColor (PresChart.colour(accentHex "#5ce1ff"))
        ; the mark's colour: looked for in the mark alone, not in a title's
        def markAt:int (indexOf spec "\"mark\"")
        def markHex:string ""
        if (markAt >= 0) {
            def markText:string (substring spec markAt (strlen spec))
            def encAt:int (indexOf markText "\"encoding\"")
            if (encAt > 0) {
                markText = (substring markText 0 encAt)
            }
            markHex = (PresChart.specString(markText "color"))
        }
        def wm:EVGColor (PresChart.colour(warmHex "#ffa546"))
        if ((strlen markHex) > 0) {
            wm = (EVGColor.parse(markHex))
        }
        def keepText:boolean (((indexOf spec "\"labelColor\"") >= 0) || ((indexOf spec "\"titleColor\"") >= 0))
        def keepLines:boolean ((((indexOf spec "\"gridColor\"") >= 0) || ((indexOf spec "\"domainColor\"") >= 0)) || ((indexOf spec "\"tickColor\"") >= 0))
        def acR:int (ac.red())
        def acG:int (ac.green())
        def acB:int (ac.blue())
        def wmR:int (wm.red())
        def wmG:int (wm.green())
        def wmB:int (wm.blue())
        ; the rust the columns burn down into: the warm colour, darker and redder
        def ruR:int (to_int ((to_double wmR) * 0.55))
        def ruG:int (to_int ((to_double wmG) * 0.2))
        def ruB:int (to_int ((to_double wmB) * 0.12))

        def tail:[EVGDrawCmd]
        def i:int from
        while (i < (array_length out.cmds)) {
            push tail (itemAt out.cmds i)
            i = (i + 1)
        }
        while ((array_length out.cmds) > from) {
            removeLast out.cmds
        }

        ; the columns, in the order they were drawn
        def bars:[EVGDrawCmd]
        def groundSeen:boolean false
        def k:int 0
        while (k < (array_length tail)) {
            def c:EVGDrawCmd (itemAt tail k)
            if (c.kind == 0) {
                if (! groundSeen) {
                    groundSeen = true
                } {
                    if ((PresChart.isBar(c)) && ((PresChart.rectChart(spec)) == false)) {
                        push bars c
                    }
                }
            }
            k = (k + 1)
        }
        def nb:int (array_length bars)
        ; Coloured by category: more than one fill among the columns. Then
        ; each keeps its own colour — the legend says what they mean — and
        ; only the style is the theme's.
        def perBar:boolean false
        def pb:int 1
        while (pb < nb) {
            def c0:EVGDrawCmd (itemAt bars 0)
            def cb:EVGDrawCmd (itemAt bars pb)
            if (((c0.r != cb.r) || (c0.g != cb.g)) || (c0.b != cb.b)) {
                perBar = true
            }
            pb = (pb + 1)
        }
        def left:double 1000000.0
        def right:double -1000000.0
        def top:double 1000000.0
        def base:double -1000000.0
        def b:int 0
        while (b < nb) {
            def c:EVGDrawCmd (itemAt bars b)
            if (c.x < left) { left = c.x }
            if ((c.x + c.w) > right) { right = (c.x + c.w) }
            if (c.y < top) { top = c.y }
            if ((c.y + c.h) > base) { base = (c.y + c.h) }
            b = (b + 1)
        }
        ; the finished chart's timing
        def growStart:double 0.3
        ; one after another, but all up within a second and a half however
        ; many there are (sixty stacked pieces took six seconds and the slide
        ; ended with the last months not drawn)
        def growEach:double 0.1
        if (nb > 15) {
            growEach = (1.5 / (to_double nb))
        }
        def growDur:double 0.7
        def scanStart:double ((growStart + (growEach * (to_double nb))) + growDur)
        def scanDur:double 1.1
        def tt:double t
        if still {
            tt = 1000000.0
        }
        def scanU:double ((tt - scanStart) / scanDur)
        def scanX:double (left + ((right - left) * scanU))

        ; the lines of the series: coloured apart, or all one; and where the
        ; plot's floor is, for a fill under them
        def perLine:boolean false
        def firstLine:int -1
        def plotBottom:double -1000000.0
        def q:int 0
        while (q < (array_length tail)) {
            def lc:EVGDrawCmd (itemAt tail q)
            if (lc.kind == 7) {
                if (PresChart.isDataLine(lc)) {
                    if (firstLine < 0) {
                        firstLine = q
                    } {
                        def l0:EVGDrawCmd (itemAt tail firstLine)
                        if (((l0.r != lc.r) || (l0.g != lc.g)) || (l0.b != lc.b)) {
                            perLine = true
                        }
                    }
                } {
                    def yb:double (PresChart.flatY(lc))
                    if (yb > plotBottom) {
                        plotBottom = yb
                    }
                }
            }
            q = (q + 1)
        }
        ; the first line's own colour, before it is dressed: a dot ringed in
        ; it is that line's point
        def lineR:int -1
        def lineG:int -1
        def lineB:int -1
        if (firstLine >= 0) {
            def fl:EVGDrawCmd (itemAt tail firstLine)
            lineR = fl.r
            lineG = fl.g
            lineB = fl.b
        }

        ; everything but the columns, restyled, in its own order
        def barAt:int 0
        groundSeen = false
        k = 0
        while (k < (array_length tail)) {
            def c:EVGDrawCmd (itemAt tail k)
            if (c.kind == 0) {
                if (! groundSeen) {
                    ; the card: left out
                    groundSeen = true
                } {
                    if ((PresChart.isBar(c)) && ((PresChart.rectChart(spec)) == false)) {
                        if perBar {
                            def oR:int c.r
                            def oG:int c.g
                            def oB:int c.b
                            PresChart.column(out c barAt tt growStart growEach growDur scanU scanX oR oG oB (to_int ((to_double oR) * 0.55)) (to_int ((to_double oG) * 0.2)) (to_int ((to_double oB) * 0.12)) st fx)
                        } {
                            PresChart.column(out c barAt tt growStart growEach growDur scanU scanX wmR wmG wmB ruR ruG ruB st fx)
                        }
                        barAt = (barAt + 1)
                    } {
                        ; a legend swatch or a point, a heat map's cell, a colour
                        ; ramp: its own colour
                        ; …and a rule in a data colour (an error bar, a mean line)
                        def thin:boolean ((c.w < 2.5) || (c.h < 2.5))
                        def grey:boolean (((PresChart.absI((c.r - c.g))) < 14) && ((PresChart.absI((c.g - c.b))) < 14))
                        if ((((c.radius > 0.0) || (PresChart.rectChart(spec))) || c.hasGrad) || (thin && (grey == false))) {
                            push out.cmds c
                            k = (k + 1)
                            continue
                        }
                        c.r = acR
                        c.g = acG
                        c.b = acB
                        c.a = 0.25
                        push out.cmds c
                    }
                }
            } {
                ; a line's point (a dot ringed in the line's colour): the
                ; ring takes the colour the line is given here
                if (((((c.kind == 1) && (c.radius > 0.0)) && (c.w < 40.0)) && ((perLine == false) && ((strlen markHex) == 0))) && (((c.r == lineR) && (c.g == lineG)) && (c.b == lineB))) {
                    c.r = wmR
                    c.g = wmG
                    c.b = wmB
                    push out.cmds c
                    k = (k + 1)
                    continue
                }
                if ((c.kind == 7) && (PresChart.isDataLine(c))) {
                    ; a series' line: its own colour when the lines differ,
                    ; the warm colour when there is one; and what the chart
                    ; asked for under it
                    if ((perLine == false) && ((strlen markHex) == 0)) {
                        c.r = wmR
                        c.g = wmG
                        c.b = wmB
                    }
                    ; a slide is read from further away than a report
                    if ((c.thickness < 2.5) && ((indexOf spec "\"strokeWidth\"") < 0)) {
                        c.thickness = 3.0
                    }
                    PresChart.lineUnder(out c plotBottom fx st)
                    push out.cmds c
                    k = (k + 1)
                    continue
                }
                if ((c.kind == 6) && ((indexOf fx "gradient") >= 0)) {
                    ; an area, fading down into the ground
                    c.hasGrad = true
                    c.gradDir = 0
                    c.r2 = c.r
                    c.g2 = c.g
                    c.b2 = c.b
                    c.a2 = 0.04
                    push out.cmds c
                    k = (k + 1)
                    continue
                }
                if (c.kind == 7) {
                    ; grid and axes: the accent, the grid faint, the axis less so
                    if (! keepLines) {
                        def axis:boolean (c.r > 70)
                        c.r = acR
                        c.g = acG
                        c.b = acB
                        if axis {
                            c.a = 0.5
                        } {
                            c.a = 0.16
                        }
                    }
                    push out.cmds c
                } {
                    if ((c.kind == 3) && (! keepText)) {
                        ; labels in a cooler, quieter light than the columns
                        c.r = (PresDiagram.mixI(acR 230 0.55))
                        c.g = (PresDiagram.mixI(acG 236 0.55))
                        c.b = (PresDiagram.mixI(acB 245 0.55))
                        ; quieter, never shown when hidden: an axis hides the
                        ; labels that would overprint (opacity 0)
                        c.a = (c.a * 0.8)
                        push out.cmds c
                    } {
                        push out.cmds c
                    }
                }
            }
            k = (k + 1)
        }

        ; the scan beam, once, over the finished chart
        if (((nb > 0) && ((scanU > 0.0) && (scanU < 1.0))) && ((st == "forge") || (st == "neon"))) {
            def fade:double (1.0 - scanU)
            def wide (new EVGDrawCmd())
            wide.kind = 0
            wide.x = (scanX - 18.0)
            wide.y = (top - 12.0)
            wide.w = 36.0
            wide.h = ((base - top) + 12.0)
            wide.hasGrad = true
            wide.gradDir = 1
            wide.r = acR
            wide.g = acG
            wide.b = acB
            wide.a = 0.0
            wide.r2 = acR
            wide.g2 = acG
            wide.b2 = acB
            wide.a2 = (0.22 * fade)
            push out.cmds wide
            def beam (new EVGDrawCmd())
            beam.kind = 0
            beam.x = (scanX - 1.0)
            beam.y = (top - 12.0)
            beam.w = 2.0
            beam.h = ((base - top) + 12.0)
            beam.r = 230
            beam.g = 250
            beam.b = 255
            beam.a = (0.85 * fade)
            beam.hasShadow = true
            beam.shadowBlur = 10.0
            beam.shadowR = acR
            beam.shadowG = acG
            beam.shadowB = acB
            beam.shadowA = (0.8 * fade)
            push out.cmds beam
        }
    }

    ; A stroke that is data rather than furniture: coloured (the grid and the
    ; axes are grey), or a run of more than one segment.
    sfn isDataLine:boolean (c:EVGDrawCmd) {
        def grey:boolean (((PresChart.absI((c.r - c.g))) < 14) && ((PresChart.absI((c.g - c.b))) < 14))
        if (grey == false) {
            return true
        }
        return ((array_length c.pts) > 6)
    }

    ; The y of a horizontal stroke (a grid line, the axis), or a very small
    ; number for one that is not.
    sfn flatY:double (c:EVGDrawCmd) {
        def n:int (array_length c.pts)
        if (n < 4) {
            return -1000000.0
        }
        def y0:double (itemAt c.pts 1)
        def i:int 3
        while (i < n) {
            if ((fabs ((itemAt c.pts i) - y0)) > 0.5) {
                return -1000000.0
            }
            i = (i + 2)
        }
        return y0
    }

    sfn stroke:EVGDrawCmd (c:EVGDrawCmd dx:double dy:double) {
        def s (new EVGDrawCmd())
        s.kind = 7
        s.thickness = c.thickness
        s.strokeCap = 1
        s.strokeJoin = 1
        s.r = c.r
        s.g = c.g
        s.b = c.b
        s.a = c.a
        def i:int 0
        while (i < (array_length c.pts)) {
            push s.pts ((itemAt c.pts i) + dx)
            push s.pts ((itemAt c.pts (i + 1)) + dy)
            i = (i + 2)
        }
        def k:int 0
        while (k < (array_length c.ringEnds)) {
            push s.ringEnds (itemAt c.ringEnds k)
            k = (k + 1)
        }
        return s
    }

    ; What goes under a series' line: a fill fading to the floor, a shadow,
    ; a glow (neon glows by itself).
    sfn lineUnder:void (out:EVGDisplayList c:EVGDrawCmd floor:double fx:string st:string) {
        c.strokeCap = 1
        c.strokeJoin = 1
        def n:int (array_length c.pts)
        if (((indexOf fx "gradient") >= 0) && ((n >= 4) && (floor > -1000.0))) {
            def f (new EVGDrawCmd())
            f.kind = 6
            def i:int 0
            while (i < n) {
                push f.pts (itemAt c.pts i)
                push f.pts (itemAt c.pts (i + 1))
                i = (i + 2)
            }
            push f.pts (itemAt c.pts (n - 2))
            push f.pts floor
            push f.pts (itemAt c.pts 0)
            push f.pts floor
            push f.ringEnds (array_length f.pts)
            f.r = c.r
            f.g = c.g
            f.b = c.b
            f.a = 0.42
            f.hasGrad = true
            f.gradDir = 0
            f.r2 = c.r
            f.g2 = c.g
            f.b2 = c.b
            f.a2 = 0.0
            push out.cmds f
        }
        if ((indexOf fx "shadow") >= 0) {
            def sh:EVGDrawCmd (PresChart.stroke(c 3.0 4.0))
            sh.r = 0
            sh.g = 0
            sh.b = 0
            sh.a = 0.35
            sh.thickness = (c.thickness + 1.0)
            push out.cmds sh
        }
        if (((indexOf fx "glow") >= 0) || (st == "neon")) {
            def g1:EVGDrawCmd (PresChart.stroke(c 0.0 0.0))
            g1.thickness = (c.thickness + 12.0)
            g1.a = 0.08
            push out.cmds g1
            def g2:EVGDrawCmd (PresChart.stroke(c 0.0 0.0))
            g2.thickness = (c.thickness + 6.0)
            g2.a = 0.16
            push out.cmds g2
        }
    }

    sfn absI:int (v:int) {
        if (v < 0) {
            return (0 - v)
        }
        return v
    }

    ; `"key": true` anywhere in the text.
    sfn specTrue:boolean (spec:string key:string) {
        def at:int (indexOf spec ("\"" + key + "\""))
        if (at < 0) {
            return false
        }
        def i:int ((at + (strlen key)) + 2)
        def n:int (strlen spec)
        while ((i < n) && (((charAt spec i) == 32) || ((charAt spec i) == 58))) {
            i = (i + 1)
        }
        return ((indexOf (substring spec i (strlen spec)) "true") == 0)
    }

    ; A column of a bar chart: a filled, square-cornered box of some size.
    ; Rounded ones are symbols — a legend's swatches, a scatter's points.
    sfn isBar:boolean (c:EVGDrawCmd) {
        ; a gradient (a colour legend's ramp) is not a column
        return ((((c.w > 2.0) && (c.h > 0.5)) && (c.radius <= 0.0)) && (c.hasGrad == false))
    }

    ; A chart of `rect` marks (a heat map): its cells are data coloured by
    ; value, not columns to dress.
    sfn rectChart:boolean (spec:string) {
        return (((indexOf spec "\"mark\": \"rect\"") >= 0) || (((indexOf spec "\"mark\":\"rect\"") >= 0) || ((indexOf spec "\"type\": \"rect\"") >= 0)))
    }

    ; One column: rising from its base at its turn, a gradient from the warm
    ; colour down into rust, grooves across it, a bright cap with a glow,
    ; lit up a little while the beam is over it.
    sfn column:void (out:EVGDisplayList c:EVGDrawCmd j:int t:double g0:double ge:double gd:double scanU:double scanX:double wR:int wG:int wB:int rR:int rG:int rB:int st:string fx:string) {
        def u:double ((t - (g0 + (ge * (to_double j)))) / gd)
        if (u <= 0.0) {
            return
        }
        if (u > 1.0) { u = 1.0 }
        ; a quick rise that settles, not a bounce
        def e:double (1.0 - ((1.0 - u) * (1.0 - u) * (1.0 - u)))
        def bottom:double (c.y + c.h)
        def h:double (c.h * e)
        def y:double (bottom - h)
        def x:double c.x
        def w:double c.w
        def lit:double 0.0
        if ((scanU > 0.0) && (scanU < 1.0)) {
            def d:double (fabs ((x + (w * 0.5)) - scanX))
            if (d < (w * 0.9)) {
                lit = (1.0 - (d / (w * 0.9)))
            }
        }
        ; under the column: a shadow cast down and right, a glow around it
        if ((indexOf fx "shadow") >= 0) {
            def sh (new EVGDrawCmd())
            sh.kind = 0
            sh.x = (x + 5.0)
            sh.y = (y + 5.0)
            sh.w = w
            sh.h = h
            sh.r = 0
            sh.g = 0
            sh.b = 0
            sh.a = 0.3
            sh.hasShadow = true
            sh.shadowBlur = 10.0
            sh.shadowA = 0.45
            push out.cmds sh
        }
        if ((indexOf fx "glow") >= 0) {
            def gl (new EVGDrawCmd())
            gl.kind = 0
            gl.x = x
            gl.y = y
            gl.w = w
            gl.h = h
            gl.r = wR
            gl.g = wG
            gl.b = wB
            gl.a = 0.6
            gl.hasShadow = true
            gl.shadowBlur = 22.0
            gl.shadowR = wR
            gl.shadowG = wG
            gl.shadowB = wB
            gl.shadowA = 0.85
            push out.cmds gl
        }
        if (st == "flat") {
            if ((indexOf fx "gradient") >= 0) {
                def gb (new EVGDrawCmd())
                gb.kind = 0
                gb.x = x
                gb.y = y
                gb.w = w
                gb.h = h
                gb.hasGrad = true
                gb.gradDir = 0
                gb.r = (PresDiagram.mixI(wR 255 0.25))
                gb.g = (PresDiagram.mixI(wG 255 0.25))
                gb.b = (PresDiagram.mixI(wB 255 0.25))
                gb.a = 1.0
                gb.r2 = rR
                gb.g2 = rG
                gb.b2 = rB
                gb.a2 = 0.85
                push out.cmds gb
                return
            }
            PresChart.flatColumn(out x y w h wR wG wB)
            return
        }
        if (st == "neon") {
            PresChart.neonColumn(out x y w h wR wG wB lit)
            return
        }
        if (st == "glass") {
            PresChart.glassColumn(out x y w h wR wG wB)
            return
        }
        def body (new EVGDrawCmd())
        body.kind = 0
        body.x = x
        body.y = y
        body.w = w
        body.h = h
        body.hasGrad = true
        body.gradDir = 0
        body.r = wR
        body.g = wG
        body.b = wB
        body.a = (0.78 + (0.2 * lit))
        body.r2 = rR
        body.g2 = rG
        body.b2 = rB
        body.a2 = 0.35
        push out.cmds body
        ; machined grooves across the column
        def gy:double (y + 6.0)
        while (gy < (bottom - 2.0)) {
            def groove (new EVGDrawCmd())
            groove.kind = 0
            groove.x = (x + 2.0)
            groove.y = gy
            groove.w = (w - 4.0)
            groove.h = 1.0
            groove.r = 0
            groove.g = 0
            groove.b = 0
            groove.a = 0.22
            push out.cmds groove
            gy = (gy + 5.0)
        }
        ; the edges, hard
        def edge (new EVGDrawCmd())
        edge.kind = 1
        edge.x = x
        edge.y = y
        edge.w = w
        edge.h = h
        edge.thickness = 1.0
        edge.r = wR
        edge.g = wG
        edge.b = wB
        edge.a = 0.55
        push out.cmds edge
        ; the cap, burning
        def cap (new EVGDrawCmd())
        cap.kind = 0
        cap.x = x
        cap.y = (y - 1.0)
        cap.w = w
        cap.h = 3.0
        cap.r = (PresDiagram.mixI(wR 255 0.55))
        cap.g = (PresDiagram.mixI(wG 245 0.55))
        cap.b = (PresDiagram.mixI(wB 220 0.55))
        cap.a = 1.0
        cap.hasShadow = true
        cap.shadowBlur = (10.0 + (8.0 * lit))
        cap.shadowR = wR
        cap.shadowG = wG
        cap.shadowB = wB
        cap.shadowA = (0.7 + (0.3 * lit))
        push out.cmds cap
    }

    ; The first `"key": "value"` in a JSON text whose value is a string, or
    ; "". Enough for the few colour keys looked for here; not a JSON reader.
    sfn specString:string (spec:string key:string) {
        def pat:string ("\"" + key + "\"")
        def n:int (strlen spec)
        def from:int 0
        while (from < n) {
            def rest:string (substring spec from n)
            def at:int (indexOf rest pat)
            if (at < 0) {
                return ""
            }
            def i:int ((from + at) + (strlen pat))
            while ((i < n) && (((charAt spec i) == 32) || (((charAt spec i) == 58) || (((charAt spec i) == 10) || ((charAt spec i) == 9))))) {
                i = (i + 1)
            }
            if ((i < n) && ((charAt spec i) == 34)) {
                def j:int (i + 1)
                while ((j < n) && ((charAt spec j) != 34)) {
                    j = (j + 1)
                }
                return (substring spec (i + 1) j)
            }
            from = i
        }
        return ""
    }

    ; For an export: the see-through outlines and gradients from `from` on mixed onto the
    ; slide's ground and made solid. The PDF path drops the alpha of an
    ; outline and of a gradient's stops, so a neon glow came out as a thick
    ; solid frame and a glass column as solid paint. Mixed here, the file
    ; looks as the stage does; what it loses is a grid line showing through
    ; a clear column.
    sfn flatten:void (out:EVGDisplayList from:int groundHex:string) {
        def g:EVGColor (EVGColor.parse(groundHex))
        def gr:int (g.red())
        def gg:int (g.green())
        def gb:int (g.blue())
        def i:int from
        while (i < (array_length out.cmds)) {
            def c:EVGDrawCmd (itemAt out.cmds i)
            ; only what loses its alpha on the way: outlines and gradients
            ; (a plain see-through fill keeps it, and a groove has to darken
            ; the column under it, not show the ground)
            def lossy:boolean ((c.kind == 1) || c.hasGrad)
            if ((lossy && (c.a < 0.999)) && (c.a > 0.0)) {
                c.r = (PresDiagram.mixI(gr c.r c.a))
                c.g = (PresDiagram.mixI(gg c.g c.a))
                c.b = (PresDiagram.mixI(gb c.b c.a))
                c.a = 1.0
            }
            if (c.hasGrad && (c.a2 < 0.999)) {
                c.r2 = (PresDiagram.mixI(gr c.r2 c.a2))
                c.g2 = (PresDiagram.mixI(gg c.g2 c.a2))
                c.b2 = (PresDiagram.mixI(gb c.b2 c.a2))
                c.a2 = 1.0
            }
            i = (i + 1)
        }
    }

    sfn rectCmd:EVGDrawCmd (x:double y:double w:double h:double r:int g:int b:int a:double) {
        def c (new EVGDrawCmd())
        c.kind = 0
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.r = r
        c.g = g
        c.b = b
        c.a = a
        return c
    }

    sfn edgeCmd:EVGDrawCmd (x:double y:double w:double h:double th:double r:int g:int b:int a:double) {
        def c (new EVGDrawCmd())
        c.kind = 1
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.thickness = th
        c.r = r
        c.g = g
        c.b = b
        c.a = a
        return c
    }

    ; flat: a plain column in the colour, as a report would draw it
    sfn flatColumn:void (out:EVGDisplayList x:double y:double w:double h:double r:int g:int b:int) {
        push out.cmds (PresChart.rectCmd(x y w h r g b 0.92))
    }

    ; neon: a faint body inside edges of light, the light spilling round them
    sfn neonColumn:void (out:EVGDisplayList x:double y:double w:double h:double r:int g:int b:int lit:double) {
        push out.cmds (PresChart.rectCmd(x y w h r g b (0.1 + (0.1 * lit))))
        push out.cmds (PresChart.edgeCmd((x - 4.0) (y - 4.0) (w + 8.0) (h + 4.0) 4.0 r g b 0.08))
        push out.cmds (PresChart.edgeCmd((x - 2.0) (y - 2.0) (w + 4.0) (h + 2.0) 3.0 r g b 0.2))
        def tube:EVGDrawCmd (PresChart.edgeCmd(x y w h 1.6 (PresDiagram.mixI(r 255 0.35)) (PresDiagram.mixI(g 255 0.35)) (PresDiagram.mixI(b 255 0.35)) 0.95))
        push out.cmds tube
        def cap:EVGDrawCmd (PresChart.rectCmd(x (y - 1.0) w 2.0 255 255 255 0.9))
        cap.hasShadow = true
        cap.shadowBlur = 12.0
        cap.shadowR = r
        cap.shadowG = g
        cap.shadowB = b
        cap.shadowA = 0.9
        push out.cmds cap
    }

    ; glass: clear at the base, the colour gathering towards the top, a
    ; highlight down one side and a bright rim along the top
    sfn glassColumn:void (out:EVGDisplayList x:double y:double w:double h:double r:int g:int b:int) {
        def body:EVGDrawCmd (PresChart.rectCmd(x y w h r g b 0.55))
        body.hasGrad = true
        body.gradDir = 0
        body.r2 = r
        body.g2 = g
        body.b2 = b
        body.a2 = 0.1
        body.radius = 3.0
        push out.cmds body
        push out.cmds (PresChart.rectCmd((x + 3.0) (y + 3.0) 3.0 (h - 6.0) 255 255 255 0.22))
        push out.cmds (PresChart.edgeCmd(x y w h 1.0 r g b 0.45))
        push out.cmds (PresChart.rectCmd(x y w 1.5 (PresDiagram.mixI(r 255 0.6)) (PresDiagram.mixI(g 255 0.6)) (PresDiagram.mixI(b 255 0.6)) 0.95))
    }

    sfn colour:EVGColor (hex:string fallback:string) {
        if ((strlen hex) > 0) {
            return (EVGColor.parse(hex))
        }
        return (EVGColor.parse(fallback))
    }
}
