; ============================================================================
; PresPick.rgr — slides picked in the filmstrip, and a view of only those
; ============================================================================
;
; Ctrl/⌘ + click on a thumbnail adds it to the pick or takes it out, Shift +
; click picks the run from the last one clicked. The pick is pages of the
; deck, in deck order; a plain click empties it. The exports take only the
; picked pages (PresApp.pdfPicked, pptxPicked).
;
; A shared view shows only some slides of the live presentation: the link
; names them (`/s/{id}?slides=…`) and the player keeps only their Markdown
; (`viewText`). A slide is named by its section, not by its number, so the
; view still shows the same slides after slides were added, moved or taken
; out elsewhere in the deck:
;
;   a section   a heading at or above the level slides break at (the deck's
;               `splitLevel`) and everything up to the next such heading;
;               the text before the first heading is one too ("start")
;   its key     the heading's `{#id}`, else its words in lower case with
;               every other character a dash ("## Tulos 2025" → tulos-2025);
;               the second section with the same key is key~2, and so on
;
; A page the overflow went on to belongs to its heading's section, so a view
; shows a section whole. A section whose heading was renamed is no longer in
; the view.
; ============================================================================

Import "PresDeck.rgr"

class PresPickSection {
    ; offsets in the Markdown: the section's first character and the one
    ; past its last
    def start:int 0
    def end:int 0
    def key:string ""
}

class PresPick {
    ; picked pages, ascending
    def pages:[int]
    ; the page a Shift + click picks from
    def anchor:int -1

    Constructor () {
        def p:[int]
        pages = p
    }

    fn active:boolean () {
        return ((array_length pages) > 0)
    }

    fn count:int () {
        return (array_length pages)
    }

    fn has:boolean (i:int) {
        return ((indexOf pages i) >= 0)
    }

    fn clear:void () {
        def p:[int]
        pages = p
        anchor = -1
    }

    fn add:void (i:int) {
        if (i < 0) {
            return
        }
        if (this.has(i)) {
            return
        }
        def out:[int]
        def put:boolean false
        def k:int 0
        while (k < (array_length pages)) {
            def v:int (itemAt pages k)
            if ((put == false) && (v > i)) {
                push out i
                put = true
            }
            push out v
            k = (k + 1)
        }
        if (put == false) {
            push out i
        }
        pages = out
    }

    fn drop:void (i:int) {
        def out:[int]
        def k:int 0
        while (k < (array_length pages)) {
            def v:int (itemAt pages k)
            if (v != i) {
                push out v
            }
            k = (k + 1)
        }
        pages = out
    }

    ; Ctrl/⌘ + click on page i, `current` being the selected slide: the
    ; first such click picks the selected slide too, as a file list does.
    fn toggle:void (i:int current:int) {
        if (((array_length pages) == 0) && (current >= 0)) {
            this.add(current)
        }
        if (this.has(i)) {
            this.drop(i)
        } {
            this.add(i)
        }
        anchor = i
    }

    ; Shift + click on page i: the pages from the last one clicked (else the
    ; selected slide) to i, in place of what was picked.
    fn extend:void (i:int current:int) {
        def from:int anchor
        if (from < 0) {
            from = current
        }
        if (from < 0) {
            from = i
        }
        def keep:int anchor
        this.clear()
        def a:int from
        def b:int i
        if (a > b) {
            a = i
            b = from
        }
        def k:int a
        while (k <= b) {
            push pages k
            k = (k + 1)
        }
        anchor = keep
        if (anchor < 0) {
            anchor = from
        }
    }

    ; the deck has n pages now: the ones past its end are let go
    fn limit:void (n:int) {
        def out:[int]
        def k:int 0
        while (k < (array_length pages)) {
            def v:int (itemAt pages k)
            if (v < n) {
                push out v
            }
            k = (k + 1)
        }
        pages = out
        if (anchor >= n) {
            anchor = -1
        }
    }

    ; "1,4,5": the picked pages counted from 1, for the page
    fn list:string () {
        def out:string ""
        def k:int 0
        while (k < (array_length pages)) {
            if (k > 0) {
                out = (out + ",")
            }
            out = (out + (to_string ((itemAt pages k) + 1)))
            k = (k + 1)
        }
        return out
    }

    ; --- sections and their keys ---------------------------------------------------
    ; A heading's level (1-6) when the line is an ATX heading, else 0.
    sfn headingLevel:int (line:string) {
        def n:int 0
        def len:int (strlen line)
        while ((n < len) && ((charAt line n) == 35)) {
            n = (n + 1)
        }
        if ((n == 0) || (n > 6)) {
            return 0
        }
        if (n == len) {
            return n
        }
        def c:int (charAt line n)
        if ((c == 32) || (c == 9)) {
            return n
        }
        return 0
    }

    ; Lower case letters and digits, each run of anything else one dash, no
    ; dash at either end. Letters outside ASCII (ä, ö, å…) are kept.
    sfn slug:string (s:string) {
        def out:string ""
        def dash:boolean false
        def k:int 0
        def len:int (strlen s)
        while (k < len) {
            def c:int (charAt s k)
            if ((c >= 65) && (c <= 90)) {
                c = (c + 32)
            }
            def keep:boolean ((((c >= 97) && (c <= 122)) || ((c >= 48) && (c <= 57))) || (c >= 192))
            if keep {
                if (dash && ((strlen out) > 0)) {
                    out = (out + "-")
                }
                dash = false
                out = (out + (substring s k (k + 1)))
                if ((charAt s k) != c) {
                    out = ((substring out 0 ((strlen out) - 1)) + (strfromcode c))
                }
            } {
                dash = true
            }
            k = (k + 1)
        }
        return out
    }

    ; A closing run of #s is not part of a heading's words.
    sfn closingHashes:string (s:string) {
        def t:string s
        while (((strlen t) > 0) && ((charAt t ((strlen t) - 1)) == 35)) {
            t = (trim (substring t 0 ((strlen t) - 1)))
        }
        return t
    }

    ; The key a heading line gives its section: its `{#id}`, else its words.
    sfn headingKey:string (line:string) {
        def t:string (trim line)
        def k:int 0
        while ((k < (strlen t)) && ((charAt t k) == 35)) {
            k = (k + 1)
        }
        t = (trim (substring t k (strlen t)))
        t = (PresPick.closingHashes(t))
        ; `{#id .class key=value}` at the end
        def len:int (strlen t)
        if ((len > 0) && ((charAt t (len - 1)) == 125)) {
            def open:int (lastIndexOf t "{")
            if (open >= 0) {
                def attrs:[string] (strsplit (substring t (open + 1) (len - 1)) " ")
                def a:int 0
                while (a < (array_length attrs)) {
                    def at:string (itemAt attrs a)
                    if (((strlen at) > 1) && ((charAt at 0) == 35)) {
                        def id:string (PresPick.slug((substring at 1 (strlen at))))
                        if ((strlen id) > 0) {
                            return id
                        }
                    }
                    a = (a + 1)
                }
                t = (trim (substring t 0 open))
            }
        }
        def s:string (PresPick.slug((PresPick.closingHashes(t))))
        if ((strlen s) == 0) {
            return "slide"
        }
        return s
    }

    ; The next line break at or after `at`, -1 when there is none.
    sfn lineEnd:int (text:string at:int) {
        def len:int (strlen text)
        def k:int at
        while (k < len) {
            if ((charAt text k) == 10) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; The offset past the front matter (`---` … `---` at the very top), 0
    ; when there is none.
    sfn frontEnd:int (text:string) {
        if ((indexOf text "---") != 0) {
            return 0
        }
        def first:int (indexOf text (strfromcode 10))
        if ((first < 0) || ((trim (substring text 0 first)) != "---")) {
            return 0
        }
        def at:int (first + 1)
        def len:int (strlen text)
        while (at < len) {
            def nl:int (PresPick.lineEnd(text at))
            def stop:int nl
            if (nl < 0) {
                stop = len
            }
            def line:string (trim (substring text at stop))
            if ((line == "---") || (line == "...")) {
                if (nl < 0) {
                    return len
                }
                return (nl + 1)
            }
            if (nl < 0) {
                return 0
            }
            at = (nl + 1)
        }
        return 0
    }

    ; The deck's sections, in order. Headings in a code fence or a `:::`
    ; block (the speaker's notes) do not count.
    sfn sections:[PresPickSection] (text:string level:int) {
        def out:[PresPickSection]
        def keys:[string]
        def counts:[int]
        def lvl:int level
        if (lvl < 1) {
            lvl = 1
        }
        def len:int (strlen text)
        def at:int (PresPick.frontEnd(text))
        def body:int at
        def fence:string ""
        def blocks:int 0
        def starts:[int]
        def heads:[string]
        while (at < len) {
            def nl:int (PresPick.lineEnd(text at))
            def stop:int nl
            if (nl < 0) {
                stop = len
            }
            def line:string (substring text at stop)
            def t:string (trim line)
            if ((strlen fence) > 0) {
                if ((indexOf t fence) == 0) {
                    fence = ""
                }
            } {
                if (((indexOf t "```") == 0) || ((indexOf t "~~~") == 0)) {
                    fence = (substring t 0 3)
                } {
                    if ((strlen (PresSource.openingWord(t))) > 0) {
                        blocks = (blocks + 1)
                    } {
                        if ((t == ":::") && (blocks > 0)) {
                            blocks = (blocks - 1)
                        } {
                            def h:int (PresPick.headingLevel(line))
                            if (((blocks == 0) && (h > 0)) && (h <= lvl)) {
                                push starts at
                                push heads (PresPick.headingKey(line))
                            }
                        }
                    }
                }
            }
            if (nl < 0) {
                at = len
            } {
                at = (nl + 1)
            }
        }
        ; what is above the first heading, when it is more than blank lines
        def firstHead:int len
        if ((array_length starts) > 0) {
            firstHead = (itemAt starts 0)
        }
        if ((strlen (trim (substring text body firstHead))) > 0) {
            def s0 (new PresPickSection())
            s0.start = body
            s0.end = firstHead
            s0.key = "start"
            push out s0
        }
        def i:int 0
        while (i < (array_length starts)) {
            def s (new PresPickSection())
            s.start = (itemAt starts i)
            s.end = len
            if ((i + 1) < (array_length starts)) {
                s.end = (itemAt starts (i + 1))
            }
            def base:string (itemAt heads i)
            def seen:int (indexOf keys base)
            if (seen < 0) {
                push keys base
                push counts 1
                s.key = base
            } {
                def c:int ((itemAt counts seen) + 1)
                set counts seen c
                s.key = (base + "~" + (to_string c))
            }
            push out s
            i = (i + 1)
        }
        return out
    }

    ; The section the offset is in, -1 when it is above all of them.
    sfn sectionAt:int (secs:[PresPickSection] offset:int) {
        def found:int -1
        def i:int 0
        while (i < (array_length secs)) {
            def s:PresPickSection (itemAt secs i)
            if (s.start <= offset) {
                found = i
            }
            i = (i + 1)
        }
        return found
    }

    ; The keys of the sections the pages starting at these offsets are in,
    ; once each, in the deck's order, joined with commas.
    sfn keysAt:string (text:string level:int offsets:[int]) {
        def secs:[PresPickSection] (PresPick.sections(text level))
        def hit:[boolean]
        def i:int 0
        while (i < (array_length secs)) {
            push hit false
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length offsets)) {
            def off:int (itemAt offsets k)
            if (off >= 0) {
                def at:int (PresPick.sectionAt(secs off))
                if (at >= 0) {
                    set hit at true
                }
            }
            k = (k + 1)
        }
        def out:string ""
        def j:int 0
        while (j < (array_length secs)) {
            if (itemAt hit j) {
                if ((strlen out) > 0) {
                    out = (out + ",")
                }
                out = (out + ((itemAt secs j).key))
            }
            j = (j + 1)
        }
        return out
    }

    ; The deck with only the sections `keys` names (comma separated), in the
    ; deck's order, under its front matter. "" when none of them is there.
    sfn viewText:string (text:string level:int keys:string) {
        def want:[string] (strsplit keys ",")
        def secs:[PresPickSection] (PresPick.sections(text level))
        def parts:[string]
        def i:int 0
        while (i < (array_length secs)) {
            def s:PresPickSection (itemAt secs i)
            if ((indexOf want s.key) >= 0) {
                def body:string (substring text s.start s.end)
                ; the blank lines at its end left out
                def e:int (strlen body)
                while ((e > 0) && (((charAt body (e - 1)) == 10) || (((charAt body (e - 1)) == 32) || ((charAt body (e - 1)) == 13)))) {
                    e = (e - 1)
                }
                push parts (substring body 0 e)
            }
            i = (i + 1)
        }
        if ((array_length parts) == 0) {
            return ""
        }
        def front:int (PresPick.frontEnd(text))
        def out:string (substring text 0 front)
        if (front > 0) {
            out = (out + (strfromcode 10))
        }
        def p:int 0
        while (p < (array_length parts)) {
            if (p > 0) {
                out = (out + (strfromcode 10) + (strfromcode 10))
            }
            out = (out + (itemAt parts p))
            p = (p + 1)
        }
        return (out + (strfromcode 10))
    }

    ; The keys of the sections the deck's pages are in (its own Markdown, at
    ; the level its slides break at).
    sfn keysOfPages:string (deck:PresDeck text:string pages:[int]) {
        def offs:[int]
        def k:int 0
        while (k < (array_length pages)) {
            def p:int (itemAt pages k)
            if ((p >= 0) && (p < (deck.slideCount()))) {
                push offs ((deck.slideAt(p)).srcStart)
            }
            k = (k + 1)
        }
        def l:MdLayout (deck.layout())
        return (PresPick.keysAt(text l.splitLevel offs))
    }
}
