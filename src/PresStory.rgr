; ============================================================================
; PresStory.rgr — a slide's story, told by the presenter in its corner
; ============================================================================
;
;   ::: story
;   conformanceIssues() kertoo, kelpaako PDF painoon X-1a-tiedostona.
;   Paitsi RGB-tilassa. Siellä vastaus on aina nolla.
;   Niinpä koodi bugaa tässä. {pose=aim}
;   :::
;
; Each line is a BEAT and a build step of the slide (after the slide's own
; steps). The presenter (PresPuppet) changes pose, then the speech bubble
; pops in with the whole line, and from then on NOTHING moves until the next
; step: every motion pulls the reader's eye, so the character, its eyes
; included, hold still while the line is read (Tero 2026-10-10).
;
; A line's first word says what kind of beat it is: a BUT turns the story
; (mutta, paitsi, vaikka, but, except, …) and is drawn red, a THEREFORE
; follows from it (siksi, joten, niinpä, therefore, so, …) and is drawn
; amber; anything else sets the scene. The pose follows the kind unless the
; line says `{pose=…}`: pen, chin, open, finger, aim, thumb.
;
; Nothing here draws: `stateAt` is a pure function of (beats, step, seconds
; since that step began), the puppet's numbers for one moment.
; ============================================================================

class PresStoryBeat {
    ; the line as written, without its {…} attributes
    def text:string ""
    ; "setup", "but" or "so"
    def kind:string "setup"
    ; the connective as written ("" for a setup), coloured in the bubble
    def word:string ""
    ; the line after the connective
    def rest:string ""
    def pose:string "pen"
    ; the build step it is shown at, 1-based on its slide
    def step:int 0
    ; its line in the block's body, from 0, and the block's offset in the
    ; deck's text (the editor shows the beat the caret is on)
    def line:int 0
    def at:int 0
}

; A line without its `{…}` attributes, and the attributes it had.
class PresStoryCut {
    def text:string ""
    def attrs:string ""
}

; The puppet's numbers at one moment (PresPuppet draws them).
class PresPuppetState {
    def gazeX:double 0.0
    def gazeY:double 0.0
    ; 1 open, 0 shut
    def lid:double 1.0
    def brow:double 0.0
    def smile:double 0.0
    def tilt:double 0.0
    ; hand shapes, weights that sum to 1
    def fist:double 1.0
    def point:double 0.0
    def open:double 0.0
    def chin:double 0.0
    def thumb:double 0.0
    def aim:double 0.0
    ; the cut-out's bounce while it changes pose (0 otherwise)
    def hop:double 0.0
    def squash:double 0.0
    ; a degree of hand-cut wobble per frame while moving, seeded
    def jitter:double 0.0
    ; the bubble shown: its beat (-1 none) and 0..1 how far it is in
    def bubbleBeat:int -1
    def bubble:double 0.0
    ; still (nothing moves): the line is being read
    def still:boolean true
}

class PresStory {
    ; seconds: pose change, bubble pop, bubble out
    sfn poseSeconds:double () { return 1.2 }
    sfn popSeconds:double () { return 0.22 }
    sfn outSeconds:double () { return 0.25 }
    ; the bubble's hand-written face
    sfn face:string () { return "Gloria Hallelujah" }

    ; The words and phrases a turning beat (BUT) opens with. A story told in
    ; rich language uses more than "but", so the synonyms are known too.
    sfn butWords:[string] () {
        return ([] _:string ("mutta" "paitsi" "vaikka" "kuitenkin" "toisaalta" "silti" "onneksi" "valitettavasti" "sen sijaan" "päinvastoin" "ikävä kyllä" "harmi vain" "yllättäen" "tosin" "ellei" "but" "except" "although" "though" "however" "yet" "unless" "luckily" "sadly" "unfortunately" "instead" "nevertheless" "nonetheless" "on the other hand" "even so" "whereas"))
    }

    ; …and a following beat (THEREFORE)
    sfn soWords:[string] () {
        return ([] _:string ("siksi" "joten" "niinpä" "siispä" "tästä syystä" "siitä syystä" "sen vuoksi" "tämän vuoksi" "sen takia" "tämän takia" "näin ollen" "niin ollen" "seurauksena" "therefore" "so" "thus" "hence" "as a result" "that is why" "which is why" "consequently" "because of this" "accordingly" "this means" "that means"))
    }

    ; "but", "so" or "setup" for a line's first word (any case, without its
    ; comma or full stop)
    sfn kindOf:string (word:string) {
        def w:string (to_lowercase (PresStory.bare(word)))
        if ((indexOf (PresStory.butWords()) w) >= 0) {
            return "but"
        }
        if ((indexOf (PresStory.soWords()) w) >= 0) {
            return "so"
        }
        return "setup"
    }

    ; The connective a line opens with, as written ("" for none): the
    ; longest known word or phrase at its start, followed by a space, a
    ; punctuation mark or the line's end.
    sfn leadOf:string (t:string) {
        def lower:string (to_lowercase t)
        def best:string ""
        def all:[string] (PresStory.butWords())
        for (PresStory.soWords()) sw:string si {
            push all sw
        }
        for all w:string wi {
            def n:int (strlen w)
            if ((n > (strlen best)) && ((n <= (strlen lower)) && ((indexOf lower w) == 0))) {
                def ok:boolean (n == (strlen lower))
                if (ok == false) {
                    def c:int (charAt lower n)
                    ok = (((c == 32) || (c == 44)) || (((c == 46) || (c == 58)) || (((c == 59) || (c == 33)) || (c == 63))))
                }
                if ok {
                    best = w
                }
            }
        }
        if ((strlen best) == 0) {
            return ""
        }
        return (substring t 0 (strlen best))
    }

    sfn bare:string (word:string) {
        def w:string word
        while ((strlen w) > 0) {
            def c:int (charAt w ((strlen w) - 1))
            if ((((c == 44) || (c == 46)) || ((c == 58) || (c == 59))) || ((c == 33) || (c == 63))) {
                w = (substring w 0 ((strlen w) - 1))
            } {
                return w
            }
        }
        return w
    }

    sfn poseFor:string (kind:string) {
        if (kind == "but") {
            return "chin"
        }
        if (kind == "so") {
            return "open"
        }
        return "pen"
    }

    sfn knownPose:boolean (p:string) {
        return ((indexOf ([] _:string ("pen" "chin" "open" "finger" "aim" "thumb")) p) >= 0)
    }

    ; The beats of a `::: story` block's body: one per non-empty line, a
    ; leading "- " or "* " dropped. Attributes in braces (`{pose=aim}`,
    ; `{kind=but}`) are read wherever they stand on the line, also with
    ; spaces, quotes or punctuation after them, and never shown; a line of
    ; nothing but attributes gives them to the line before it.
    sfn parse:[PresStoryBeat] (body:string) {
        def out:[PresStoryBeat]
        def lines:[string] (strsplit body "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def t:string (trim (itemAt lines i))
            if (((strlen t) >= 2) && (((substring t 0 2) == "- ") || ((substring t 0 2) == "* "))) {
                t = (trim (substring t 2 (strlen t)))
            }
            def cut:PresStoryCut (PresStory.cutAttrs(t))
            t = cut.text
            if (((strlen t) == 0) && (((strlen cut.attrs) > 0) && ((array_length out) > 0))) {
                PresStory.dress((itemAt out ((array_length out) - 1)) cut.attrs)
            }
            if ((strlen t) > 0) {
                def b (new PresStoryBeat())
                b.text = t
                b.line = i
                def lead:string (PresStory.leadOf(t))
                b.kind = "setup"
                if ((strlen lead) > 0) {
                    b.kind = (PresStory.kindOf(lead))
                }
                b.word = lead
                b.rest = (substring t (strlen lead) (strlen t))
                b.pose = (PresStory.poseFor(b.kind))
                PresStory.dress(b cut.attrs)
                push out b
            }
            i = (i + 1)
        }
        return out
    }

    ; A beat's attributes: `kind=but|so|setup` (when its opening word is one
    ; the lists do not know, that word is coloured) and `pose=…`.
    sfn dress:void (b:PresStoryBeat attrs:string) {
        def kind:string (to_lowercase (PresStory.attr(attrs "kind")))
        if ((((kind == "but") || (kind == "so")) || (kind == "setup")) && (kind != b.kind)) {
            b.kind = kind
            b.word = ""
            if (kind != "setup") {
                def sp:int (indexOf b.text " ")
                b.word = b.text
                if (sp > 0) {
                    b.word = (PresStory.bare((substring b.text 0 sp)))
                }
            }
            b.rest = (substring b.text (strlen b.word) (strlen b.text))
            b.pose = (PresStory.poseFor(b.kind))
        }
        def want:string (to_lowercase (PresStory.attr(attrs "pose")))
        if (PresStory.knownPose(want)) {
            b.pose = want
        }
    }

    ; The line without its attribute groups, and the attributes they held.
    ; A group is `{…}` whose words are all `key=value`, `.class` or `#id`
    ; (a `\{` a Markdown writer escaped counts too); other braces are text.
    sfn cutAttrs:PresStoryCut (line:string) {
        def c:PresStoryCut (new PresStoryCut())
        def t:string line
        def from:int 0
        while true {
            def rest:string (substring t from (strlen t))
            def ob:int (indexOf rest "{")
            if (ob < 0) {
                break
            }
            def open:int (from + ob)
            def cbRel:int (indexOf (substring t open (strlen t)) "}")
            if (cbRel < 0) {
                break
            }
            def close:int (open + cbRel)
            def inner:string (substring t (open + 1) close)
            def start:int open
            if ((start > 0) && ((charAt t (start - 1)) == 92)) {
                start = (start - 1)
            }
            if ((strlen inner) > 0) {
                if ((charAt inner ((strlen inner) - 1)) == 92) {
                    inner = (substring inner 0 ((strlen inner) - 1))
                }
            }
            if (PresStory.isAttrs(inner)) {
                if ((strlen c.attrs) > 0) {
                    c.attrs = (c.attrs + " ")
                }
                c.attrs = (c.attrs + (PresStory.tidyAttrs(inner)))
                t = ((substring t 0 start) + (substring t (close + 1) (strlen t)))
                from = start
            } {
                from = (close + 1)
            }
        }
        c.text = (PresStory.tidyText(t))
        return c
    }

    ; `key = "value"` → `key=value`, words split by spaces
    sfn tidyAttrs:string (inner:string) {
        def s:string ""
        def i:int 0
        def n:int (strlen inner)
        while (i < n) {
            def ch:int (charAt inner i)
            if ((ch == 34) || (ch == 39)) {
                i = (i + 1)
                continue
            }
            if (ch == 61) {
                s = (trim s)
                s = (s + "=")
                i = (i + 1)
                while ((i < n) && (((charAt inner i) == 32) || ((charAt inner i) == 9))) {
                    i = (i + 1)
                }
                continue
            }
            s = (s + (substring inner i (i + 1)))
            i = (i + 1)
        }
        return (trim s)
    }

    sfn isAttrs:boolean (inner:string) {
        def words:[string] (strsplit (PresStory.tidyAttrs(inner)) " ")
        def any:boolean false
        for words w:string wi {
            if ((strlen w) > 0) {
                def c:int (charAt w 0)
                def eq:int (indexOf w "=")
                if (((c == 46) || (c == 35)) && ((strlen w) > 1)) {
                    any = true
                } {
                    if (eq > 0) {
                        any = true
                    } {
                        return false
                    }
                }
            }
        }
        return any
    }

    ; doubled spaces gone, no space left before a punctuation mark
    sfn tidyText:string (t:string) {
        def s:string ""
        def i:int 0
        def n:int (strlen t)
        while (i < n) {
            def ch:int (charAt t i)
            if (((ch == 32) || (ch == 9)) && ((i + 1) < n)) {
                def nx:int (charAt t (i + 1))
                if ((((nx == 32) || (nx == 9)) || ((nx == 46) || (nx == 44))) || (((nx == 33) || (nx == 63)) || ((nx == 58) || (nx == 59)))) {
                    i = (i + 1)
                    continue
                }
            }
            s = (s + (substring t i (i + 1)))
            i = (i + 1)
        }
        return (trim s)
    }

    ; The lines of one slide's Markdown that read as a presenter's beat (they
    ; open with a turning or following word) but stand in the slide's own
    ; text: list items and paragraphs outside code fences and `:::` blocks.
    sfn leaked:[string] (md:string) {
        def out:[string]
        def lines:[string] (strsplit md "\n")
        def fence:boolean false
        def box:int 0
        for lines raw:string li {
            def t:string (trim raw)
            ; a code fence (three backticks or tildes, as char codes: this
            ; file also goes into a String.raw runtime)
            if (((strlen t) >= 3) && ((PresStory.fenceMark(t)) == true)) {
                fence = (fence == false)
                continue
            }
            if fence {
                continue
            }
            if (((strlen t) >= 3) && ((substring t 0 3) == ":::")) {
                if ((strlen (trim (substring t 3 (strlen t)))) > 0) {
                    box = (box + 1)
                } {
                    if (box > 0) {
                        box = (box - 1)
                    }
                }
                continue
            }
            if ((box > 0) || ((strlen t) == 0)) {
                continue
            }
            if (((charAt t 0) == 35) || (((charAt t 0) == 123) || ((charAt t 0) == 124))) {
                continue
            }
            def body:string t
            if (((strlen body) >= 2) && ((((substring body 0 2) == "- ") || ((substring body 0 2) == "* ")) || ((substring body 0 2) == "+ "))) {
                body = (trim (substring body 2 (strlen body)))
            }
            def dot:int (indexOf body ". ")
            if ((dot > 0) && (dot < 4)) {
                if ((PresStory.allDigits((substring body 0 dot))) == true) {
                    body = (trim (substring body (dot + 2) (strlen body)))
                }
            }
            if ((strlen body) >= 2) {
                if ((substring body 0 2) == "**") {
                    body = (substring body 2 (strlen body))
                }
            }
            if ((strlen (PresStory.leadOf(body))) > 0) {
                def cb:PresStoryCut (PresStory.cutAttrs(body))
                push out cb.text
            }
        }
        return out
    }

    sfn fenceMark:boolean (t:string) {
        def c:int (charAt t 0)
        if ((c != 96) && (c != 126)) {
            return false
        }
        return (((charAt t 1) == c) && ((charAt t 2) == c))
    }

    sfn allDigits:boolean (s:string) {
        if ((strlen s) == 0) {
            return false
        }
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if ((c < 48) || (c > 57)) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    sfn lastIndexOf:int (s:string sub:string) {
        def at:int -1
        def from:int 0
        while true {
            def k:int (indexOf (substring s from (strlen s)) sub)
            if (k < 0) {
                return at
            }
            at = (from + k)
            from = (at + 1)
        }
        return at
    }

    ; `key=value` among space-separated attributes, "" when it is not there
    sfn attr:string (attrs:string key:string) {
        def parts:[string] (strsplit attrs " ")
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (trim (itemAt parts i))
            def eq:int (indexOf p "=")
            if ((eq > 0) && ((substring p 0 eq) == key)) {
                return (substring p (eq + 1) (strlen p))
            }
            i = (i + 1)
        }
        return ""
    }

    ; How long a line takes to read: about 14 characters a second and a
    ; moment to find the bubble, never under 2.4 s.
    sfn readSeconds:double (b:PresStoryBeat) {
        def r:double (1.2 + ((to_double (strlen b.text)) / 14.0))
        if (r < 2.4) {
            r = 2.4
        }
        return r
    }

    ; From the beat's step to the end of its reading time.
    sfn beatSeconds:double (b:PresStoryBeat) {
        return (((PresStory.poseSeconds()) + (PresStory.popSeconds())) + (PresStory.readSeconds(b)))
    }

    ; A pose's face and hand.
    sfn poseState:PresPuppetState (pose:string) {
        def s (new PresPuppetState())
        s.fist = 0.0
        if (pose == "chin") {
            s.gazeX = 0.35
            s.gazeY = -0.8
            s.brow = 1.0
            s.smile = -0.2
            s.tilt = 5.0
            s.chin = 1.0
            return s
        }
        if (pose == "open") {
            s.gazeX = -0.1
            s.brow = 0.7
            s.smile = -0.4
            s.tilt = -5.0
            s.open = 1.0
            return s
        }
        if (pose == "finger") {
            s.gazeX = -0.5
            s.gazeY = -0.5
            s.brow = 0.9
            s.tilt = 2.0
            s.point = 1.0
            return s
        }
        if (pose == "aim") {
            s.gazeX = -1.0
            s.gazeY = 0.55
            s.brow = -0.7
            s.smile = -0.1
            s.tilt = -6.0
            s.aim = 1.0
            return s
        }
        if (pose == "thumb") {
            s.gazeX = -0.3
            s.brow = 0.4
            s.smile = 0.6
            s.tilt = 3.0
            s.thumb = 1.0
            return s
        }
        ; pen
        s.gazeX = -0.8
        s.gazeY = -0.4
        s.brow = 0.3
        s.smile = 0.4
        s.tilt = -3.0
        s.fist = 1.0
        return s
    }

    sfn lerp:double (a:double b:double t:double) {
        return (a + ((b - a) * t))
    }

    sfn ease:double (t:double) {
        if (t <= 0.0) { return 0.0 }
        if (t >= 1.0) { return 1.0 }
        return ((t * t) * (3.0 - (2.0 * t)))
    }

    ; a cut-out pose change: a little past the new pose, then settle
    sfn back:double (t:double) {
        if (t <= 0.0) { return 0.0 }
        if (t >= 1.0) { return 1.0 }
        def u:double (t - 1.0)
        return ((1.0 + ((2.5 * u) * (u * u))) + ((1.5 * u) * u))
    }

    sfn mix:PresPuppetState (a:PresPuppetState b:PresPuppetState f:double) {
        def s (new PresPuppetState())
        s.gazeX = (PresStory.lerp(a.gazeX b.gazeX f))
        s.gazeY = (PresStory.lerp(a.gazeY b.gazeY f))
        s.brow = (PresStory.lerp(a.brow b.brow f))
        s.smile = (PresStory.lerp(a.smile b.smile f))
        s.tilt = (PresStory.lerp(a.tilt b.tilt f))
        ; the hand overshoots with the body but its shape weights do not
        def g:double f
        if (g > 1.0) { g = 1.0 }
        if (g < 0.0) { g = 0.0 }
        s.fist = (PresStory.lerp(a.fist b.fist g))
        s.point = (PresStory.lerp(a.point b.point g))
        s.open = (PresStory.lerp(a.open b.open g))
        s.chin = (PresStory.lerp(a.chin b.chin g))
        s.thumb = (PresStory.lerp(a.thumb b.thumb g))
        s.aim = (PresStory.lerp(a.aim b.aim g))
        return s
    }

    ; a fixed small number in -0.5..0.5 for a whole number (hand-cut wobble)
    sfn noise:double (n:int) {
        def x:double ((sin (((to_double n) * 127.1) + 311.7)) * 43758.5453)
        return ((x - (to_double (floor x))) - 0.5)
    }

    ; The puppet at `since` seconds into build step `step` (0: before the
    ; first beat). Steps past the beats keep the last beat's bubble.
    sfn stateAt:PresPuppetState (beats:[PresStoryBeat] step:int since:double) {
        def n:int (array_length beats)
        if (n == 0) {
            return (new PresPuppetState())
        }
        if (step <= 0) {
            def first:PresStoryBeat (itemAt beats 0)
            def s0:PresPuppetState (PresStory.poseState(first.pose))
            return s0
        }
        def k:int step
        def at:double since
        if (k > n) {
            k = n
            at = 1000000.0
        }
        def b:PresStoryBeat (itemAt beats (k - 1))
        def prevPose:string b.pose
        if (k > 1) {
            def pb:PresStoryBeat (itemAt beats (k - 2))
            prevPose = pb.pose
        }
        def change:boolean (prevPose != b.pose)
        def poseT:double (PresStory.poseSeconds())
        ; the first beat, or the same pose again: no change, the bubble comes sooner
        if (change == false) {
            poseT = 0.35
        }
        def moving:boolean (change && (at < poseT))
        def f:double 1.0
        if moving {
            f = (PresStory.back((at / poseT)))
        }
        def s:PresPuppetState (PresStory.mix((PresStory.poseState(prevPose)) (PresStory.poseState(b.pose)) f))
        s.still = true
        if moving {
            s.still = false
            def hopT:double (at / 0.5)
            if (hopT > 1.0) { hopT = 1.0 }
            s.hop = (6.0 * (sin (hopT * 3.141592653589793)))
            if (at < 0.12) {
                s.squash = 0.05
            }
            s.jitter = ((PresStory.noise((floor (at * 12.0)))) * 1.6)
            ; a blink hides the swap of the hand
            def d:double (at - 0.15)
            if ((d >= 0.0) && (d < 0.16)) {
                s.lid = (fabs ((d / 0.08) - 1.0))
            }
        }
        ; the previous line goes as the new pose starts, the new one pops in
        ; after it and stays until the next step
        def outT:double (PresStory.outSeconds())
        if ((k > 1) && (at < outT)) {
            s.bubbleBeat = (k - 2)
            s.bubble = (1.0 - (PresStory.ease((at / outT))))
            s.still = false
            return s
        }
        if (at < poseT) {
            return s
        }
        s.bubbleBeat = (k - 1)
        s.bubble = (PresStory.ease(((at - poseT) / (PresStory.popSeconds()))))
        if (s.bubble < 1.0) {
            s.still = false
        }
        return s
    }
}
