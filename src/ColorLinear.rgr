; An sRGB channel (0..1) as linear light, the way glTF's baseColorFactor and
; Three's colour management hold colours.
class ColorLinear {
    ; x^(1/5) for 0 <= x <= 1, by halving
    sfn root5:double (x:double) {
        def a:double 0.0
        def b:double 1.0
        def k:int 0
        while (k < 40) {
            def m:double ((a + b) * 0.5)
            if (((((m * m) * m) * m) * m) > x) {
                b = m
            } {
                a = m
            }
            k = (k + 1)
        }
        return ((a + b) * 0.5)
    }

    sfn of:double (c:double) {
        if (c <= 0.04045) {
            return (c / 12.92)
        }
        def t:double ((c + 0.055) / 1.055)
        ; t^2.4 = t^2 · (t^(1/5))^2
        def f:double (ColorLinear.root5(t))
        return (((t * t) * f) * f)
    }

    ; linear light (0..1) back to an sRGB channel: `of` turned round
    sfn toSrgb:double (l:double) {
        if (l <= 0.0) {
            return 0.0
        }
        if (l >= 1.0) {
            return 1.0
        }
        def a:double 0.0
        def b:double 1.0
        def k:int 0
        while (k < 40) {
            def m:double ((a + b) * 0.5)
            if ((ColorLinear.of(m)) > l) {
                b = m
            } {
                a = m
            }
            k = (k + 1)
        }
        return ((a + b) * 0.5)
    }
}
