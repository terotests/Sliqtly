; ============================================================================
; PresCommentNotes.rgr — review comments as an export's footnotes
; ============================================================================
;
; "Export review comments too": the open comments (PresReview) go into a
; PDF or a web page as footnotes, numbered as "Markdown with comments"
; numbers them (by slide, then as they were made). Each is tied to what it
; is on, so a page can put its mark there:
;
;   thread ──► the element it is pinned to (`el`), else the element under
;              its point (PresReview.blockAt) ──► the top-level block of the
;              deck's text that holds it (`at`, its first source character)
;
; A comment on no element (an empty spot of the slide, a source file) has
; `at` -1: it belongs to the slide as a whole. Its point (`x`, `y`, 0..1 of
; the slide) is where a PDF page marks it. Nothing here draws.
; ============================================================================

Import "PresReview.rgr"

class PresCommentNote {
    ; the footnote's number, 1 = first
    def num:int 0
    ; the slide it is on, 0 = first
    def page:int 0
    ; the top-level block it is on: its first source character (-1: the
    ; slide as a whole)
    def at:int -1
    ; its point on the slide, 0..1
    def x:double 0.5
    def y:double 0.5
    ; "", "low", "medium" or "high"
    def severity:string ""
    def msgs:[PresReviewMsg]

    Constructor () {
    }
}

class PresCommentNotes {
    def notes:[PresCommentNote]

    Constructor () {
    }

    ; The open comments of `model` on the slides `only` names (all when it
    ; is empty). `blocks`: every slide's elements (with their source,
    ; PresReviewBlock.src); `starts`: where each top-level block of the
    ; text begins, in order.
    sfn make:PresCommentNotes (model:PresReview blocks:[PresReviewBlock] starts:[int] only:[int]) {
        def out (new PresCommentNotes())
        def order:[PresReviewThread] (model.openOrder())
        def k:int 0
        for order t:PresReviewThread i {
            def wanted:boolean true
            if ((array_length only) > 0) {
                wanted = ((indexOf only t.slide) >= 0)
            }
            if wanted {
                k = (k + 1)
                def n (new PresCommentNote())
                n.num = k
                n.page = t.slide
                n.x = t.x
                n.y = t.y
                n.severity = t.severity
                n.msgs = t.msgs
                if ((t.isCode()) == false) {
                    n.at = (PresCommentNotes.blockStart((PresCommentNotes.srcOf(t blocks)) starts))
                }
                push out.notes n
            }
        }
        return out
    }

    ; The source offset of the element the thread is on, -1 when none.
    sfn srcOf:int (t:PresReviewThread blocks:[PresReviewBlock]) {
        if ((strlen t.el) > 0) {
            for blocks b:PresReviewBlock i {
                if ((b.page == t.slide) && (b.key == t.el)) {
                    return b.src
                }
            }
        }
        def k:int (PresReview.blockAt(blocks t.slide t.x t.y))
        if (k < 0) {
            return -1
        }
        def hit:PresReviewBlock (itemAt blocks k)
        return hit.src
    }

    ; The top-level block holding `src`: the last start at or before it.
    sfn blockStart:int (src:int starts:[int]) {
        if (src < 0) {
            return -1
        }
        def best:int -1
        for starts s:int i {
            if (s <= src) {
                best = s
            }
        }
        return best
    }

    fn count:int () {
        return (array_length notes)
    }

    ; The notes on slide `p`.
    fn onPage:[PresCommentNote] (p:int) {
        def out:[PresCommentNote]
        for notes n:PresCommentNote i {
            if (n.page == p) {
                push out n
            }
        }
        return out
    }

    ; The notes on the block starting at `src` of slide `p`; `src` -1: the
    ; slide's own (on no element).
    fn atBlock:[PresCommentNote] (p:int src:int) {
        def out:[PresCommentNote]
        for notes n:PresCommentNote i {
            if ((n.page == p) && (n.at == src)) {
                push out n
            }
        }
        return out
    }

    ; A note's messages as Markdown: "**Name:** text", one paragraph each.
    sfn markdown:string (n:PresCommentNote someone:string) {
        def nl:string (strfromcode 10)
        def out:string ""
        for n.msgs m:PresReviewMsg i {
            def nm:string (trim m.name)
            if ((strlen nm) == 0) {
                nm = someone
            }
            if (i > 0) {
                out = (out + nl + nl)
            }
            out = (out + "**" + (PresCommentNotes.plain(nm)) + ":** " + (trim m.text))
        }
        return out
    }

    ; a name with Markdown's emphasis marks taken out
    sfn plain:string (s:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:string (substring s i (i + 1))
            if ((((ch != "*") && (ch != "_")) && (ch != "`")) && (ch != "[")) {
                out = (out + ch)
            }
            i = (i + 1)
        }
        return out
    }
}
