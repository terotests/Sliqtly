; ============================================================================
; PresTocDrawer.rgr — the ToC drawer: EVGUI's DrawerCtl listing the headings.
; ============================================================================
;
; The table of contents (PresToc) in a drawer at the left edge, over the
; app while editing (under the bar) and over the slide while presenting. A
; row a heading, set in by its depth; the one being read is marked and kept
; in view when the drawer opens. A row pressed is `picked` for PresApp to
; go to; the drawer stays open, as a drawer does, until ×, Esc or ToC.
;
; Above the list a search field (EVGUI's InputCtl): what is typed keeps the
; headings that have it (PresToc.finds), ↑/↓ move through them and Enter
; goes to the one marked (the first by default). Esc empties the field
; first; PresApp gives it the keys while `typing`.
;
; Its own UiHost as big as the app, the sheet ui.css + web/toc.css under
; the theme "toc" (the dark and retro looks derived for it by the page).
; ============================================================================

Import "PresI18n.rgr"
Import "PresToc.rgr"
Import "../evgui/src/UiHost.rgr"
Import "../evgui/src/DrawerCtl.rgr"
Import "../evgui/src/InputCtl.rgr"
Import "UiKit.rgr"

class PresTocDrawer {
    def host:UiHost (new UiHost())
    def css:string ""
    def skin:string ""
    def drawer:DrawerCtl (new DrawerCtl())
    def w:double 1200.0
    def h:double 700.0
    ; the panel's place (app coordinates): its top, height and width
    def top:double 0.0
    def height:double 700.0
    def width:double 320.0
    ; the rows shown: each entry's words and depth, and which is read
    def texts:[string]
    def depths:[int]
    ; the slide each is on (shown from 1, as a book's page number)
    def slides:[int]
    ; the dots between each heading and its number, measured to fit once
    ; the rows are laid out (a text that overflows is not cut off here)
    def leads:[string]
    def leadsOk:boolean false
    def current:int -1
    ; the row to bring into view at the next layout (-1: none)
    def reveal:int -1
    def hot:string ""
    ; the search: the field, the entries it keeps (indices into texts), the
    ; one ↑/↓ marked among them (-1: none), and whether it has the keys
    def search:InputCtl (new InputCtl())
    def shown:[int]
    def kbd:int -1
    def typing:boolean false
    def selecting:boolean false
    def measurer@(optional):TTFTextMeasurer
    def rev:int 0

    Constructor () {
        drawer.tid = "toc"
        drawer.side = "left"
        drawer.durationMs = 0.0
        search.tid = "toc-search"
        search.boxClass = "toc-search"
        search.textClass = "toc-search-text"
        search.placeholderClass = "toc-search-ph"
        search.clearable = true
        search.clearLabel = "×"
    }

    fn query:string () {
        return search.value
    }

    ; The entries the search keeps, from the words as they are now.
    fn filter:void () {
        def out:[int]
        def i:int 0
        while (i < (array_length texts)) {
            if (PresToc.finds((itemAt texts i) search.value)) {
                push out i
            }
            i = (i + 1)
        }
        def same:boolean ((array_length out) == (array_length shown))
        if same {
            def k:int 0
            while (k < (array_length out)) {
                if ((itemAt out k) != (itemAt shown k)) {
                    same = false
                    break
                }
                k = (k + 1)
            }
        }
        if (same == false) {
            shown = out
            leadsOk = false
            kbd = -1
        }
    }

    fn isOpen:boolean () {
        return drawer.open
    }

    ; The rows from the list; `cur` the one being read.
    fn setEntries:void (toc:PresToc cur:int) {
        def t:[string]
        def d:[int]
        def sl:[int]
        def i:int 0
        while (i < (toc.count())) {
            def e:PresTocEntry (toc.entryAt(i))
            push t e.text
            push d e.depth
            push sl e.slide
            i = (i + 1)
        }
        def same:boolean ((array_length t) == (array_length texts))
        if same {
            def k:int 0
            while (k < (array_length t)) {
                if ((((itemAt t k) != (itemAt texts k)) || ((itemAt d k) != (itemAt depths k))) || ((itemAt sl k) != (itemAt slides k))) {
                    same = false
                    break
                }
                k = (k + 1)
            }
        }
        if (same && (cur == current)) {
            return
        }
        if (same == false) {
            leadsOk = false
        }
        texts = t
        depths = d
        slides = sl
        current = cur
        this.filter()
        if drawer.open {
            this.rebuild()
        }
    }

    ; The panel's room: top, height and width (app coordinates).
    fn place:void (atTop:double tall:double wide:double) {
        if (((atTop == top) && (tall == height)) && (wide == width)) {
            return
        }
        if (wide != width) {
            leadsOk = false
        }
        top = atTop
        height = tall
        width = wide
        if drawer.open {
            this.rebuild()
        }
    }

    fn open:void () {
        drawer.show()
        drawer.progress = 1.0
        drawer.phase = 1.0
        reveal = current
        this.rebuild()
    }

    fn close:void () {
        drawer.closeNow()
        hot = ""
        typing = false
        selecting = false
        search.setFocused(false)
        rev = (rev + 1)
    }

    fn toggle:void () {
        if drawer.open {
            this.close()
        } {
            this.open()
        }
    }

    sfn rowTid:string (i:int) {
        return ("toc-" + (to_string i))
    }

    ; The entry a row id names, -1 for none.
    sfn rowOf:int (t:string) {
        if (((indexOf t "toc-") != 0) || ((strlen t) <= 4)) {
            return -1
        }
        ; the search field's ids (toc-search…) are no row's
        def c0:int (charAt t 4)
        if ((c0 < 48) || (c0 > 57)) {
            return -1
        }
        def n@(optional):int (str2int (substring t 4 (strlen t)))
        if (null? n) {
            return -1
        }
        return (unwrap n)
    }

    fn rebuild:void () {
        def fresh (new UiHost())
        fresh.addStyleSheetFrom(css host)
        fresh.hoverTid = hot
        host = fresh
        host.setTheme((trim ("toc " + skin)))
        host.setPageSize(w h)
        def root:EVGElement (unwrap host.root)
        root.className = "ui-root"
        drawer.title = (PresI18n.t("Contents"))
        drawer.closeLabel = "×"
        drawer.width = width
        drawer.top = top
        drawer.panelHeight = height
        drawer.pageWidth = w
        drawer.clearContentTids()
        drawer.build()
        ; the search between the title and the list (the list scrolls, the
        ; field stays)
        def panel:EVGElement drawer.panelEl
        UiTree.clearChildren(panel)
        panel.addChild(drawer.titleEl)
        panel.addChild(drawer.closeEl)
        search.placeholder = (PresI18n.t("Search headings"))
        search.name = search.placeholder
        search.focused = typing
        search.build()
        UiKit.put(host search panel)
        panel.addChild(drawer.bodyEl)
        def body:EVGElement (drawer.body())
        UiTree.clearChildren(body)
        if ((array_length texts) == 0) {
            def none (EVGElement.createDiv())
            none.className = "toc-none"
            none.textContent = (PresI18n.t("No headings yet: # and ## lines are listed here"))
            body.addChild(none)
        } {
            if ((array_length shown) == 0) {
                def none2 (EVGElement.createDiv())
                none2.className = "toc-none"
                none2.textContent = (PresI18n.t("No heading has these words"))
                body.addChild(none2)
            }
        }
        def kbdTid:string ""
        if ((kbd >= 0) && (kbd < (array_length shown))) {
            kbdTid = (PresTocDrawer.rowTid((itemAt shown kbd)))
        }
        def at:int 0
        while (at < (array_length shown)) {
            def i:int (itemAt shown at)
            def row (EVGElement.createDiv())
            row.id = (PresTocDrawer.rowTid(i))
            def d:int (itemAt depths i)
            if (d > 3) {
                d = 3
            }
            def cls:string ("toc-row toc-d" + (to_string d))
            if (i == current) {
                cls = (cls + " toc-on")
            }
            def marked:boolean ((row.id == hot) || (row.id == kbdTid))
            if marked {
                cls = (cls + " toc-hot")
            }
            row.className = cls
            ; the heading as a link, dots to its slide's number, as a book's
            ; contents page reads; the parts take the row's state as classes
            ; (a hover rule reaches only the element hovered)
            def state:string ""
            if (i == current) {
                state = " toc-on"
            }
            if marked {
                state = (state + " toc-hot")
            }
            def title (EVGElement.createDiv())
            title.className = ("toc-t toc-t" + (to_string d) + state)
            title.textContent = (itemAt texts i)
            row.addChild(title)
            def lead (EVGElement.createDiv())
            lead.className = ("toc-lead" + state)
            if (leadsOk && (at < (array_length leads))) {
                lead.textContent = (itemAt leads at)
            }
            row.addChild(lead)
            def num (EVGElement.createDiv())
            num.className = ("toc-n" + state)
            num.textContent = (to_string ((itemAt slides i) + 1))
            row.addChild(num)
            body.addChild(row)
            drawer.addContentTid(row.id)
            at = (at + 1)
        }
        UiKit.put(host drawer root)
        rev = (rev + 1)
    }

    fn layoutPage:EVGElement () {
        def r:EVGElement (unwrap host.root)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h false)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        lay.layout(pg)
        if (this.fillLeads()) {
            lay.layout(pg)
        }
        ; the row being read in view, a little below the top
        def at:int (this.shownAt(reveal))
        reveal = -1
        if (at >= 0) {
            def body:EVGElement (drawer.body())
            if (at < (body.getChildCount())) {
                def row:EVGElement (body.getChild(at))
                def inBody:double ((row.calculatedY - body.calculatedY) + body.scrollTop)
                def want:double (inBody - (body.clientHeight() * 0.3))
                if (want < 0.0) {
                    want = 0.0
                }
                if (want > (body.maxScrollTop())) {
                    want = (body.maxScrollTop())
                }
                if (want != body.scrollTop) {
                    body.scrollTop = want
                    lay.layout(pg)
                }
            }
        }
        host.placeText((lay.getTextEngine()))
        host.lastPage = pg
        return pg
    }

    ; Each row's dots as many as fit the room the row left them: true when
    ; they were made now (the page is laid out again with them).
    fn fillLeads:boolean () {
        if leadsOk {
            return false
        }
        def unit:double 5.6
        if (!null? measurer) {
            def m:TTFTextMeasurer (unwrap measurer)
            def mw:double (m.measureTextWidth(". " "Open Sans" 11.0))
            if (mw > 0.0) {
                unit = mw
            }
        }
        def body:EVGElement (drawer.body())
        def out:[string]
        def i:int 0
        while (i < (array_length shown)) {
            def dots:string ""
            if (i < (body.getChildCount())) {
                def row:EVGElement (body.getChild(i))
                if ((row.getChildCount()) >= 2) {
                    def lead:EVGElement (row.getChild(1))
                    def n:int (to_int ((lead.calculatedWidth - 2.0) / unit))
                    def k:int 0
                    while (k < n) {
                        dots = (dots + ". ")
                        k = (k + 1)
                    }
                    lead.textContent = dots
                }
            }
            push out dots
            i = (i + 1)
        }
        leads = out
        leadsOk = true
        return true
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.layoutPage())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; --- the pointer -------------------------------------------------------------
    fn has:boolean (px:double py:double) {
        if (drawer.open == false) {
            return false
        }
        return ((((px >= 0.0) && (px <= width)) && (py >= top)) && (py <= (top + height)))
    }

    ; Where entry i is among the rows shown, -1 when it is not.
    fn shownAt:int (i:int) {
        def k:int 0
        while (k < (array_length shown)) {
            if ((itemAt shown k) == i) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; A press: the entry pressed (-1 for none); × closes; on the search
    ; field, its caret (and the keys), anywhere else the field lets them go.
    fn press:int (px:double py:double clicks:int shift:boolean) {
        if (null? host.lastPage) {
            this.layoutPage()
        }
        def t:string (host.hitTest(px py))
        if (search.owns(t)) {
            def before:string search.value
            typing = true
            search.textPointerDown(t px clicks shift)
            selecting = search.dragging
            if (search.value != before) {
                this.filter()
            }
            this.rebuild()
            return -1
        }
        if typing {
            typing = false
            search.setFocused(false)
            rev = (rev + 1)
        }
        drawer.activate(t)
        def k:string (drawer.consumePicked())
        if (drawer.open == false) {
            this.close()
            return -1
        }
        return (PresTocDrawer.rowOf(k))
    }

    ; A drag that began in the field: its selection.
    fn dragTo:void (px:double) {
        if selecting {
            search.textPointerDrag(px)
            rev = (rev + 1)
        }
    }

    fn release:void () {
        if selecting {
            selecting = false
            search.pointerUp()
            rev = (rev + 1)
        }
    }

    ; The field lets the keys go (a press outside the drawer).
    fn blur:void () {
        if typing {
            typing = false
            selecting = false
            search.setFocused(false)
            if drawer.open {
                this.rebuild()
            }
        }
    }

    ; Words typed into the field.
    fn type:void (s:string) {
        search.typeChar(search.tid s)
        this.filter()
        this.rebuild()
    }

    fn selectAll:void () {
        search.selectAll()
        rev = (rev + 1)
    }

    ; A key while the field has them (`k` as EVGUI names it: "ArrowDown",
    ; "Enter", "Backspace", …): the entry Enter goes to, else -1.
    fn key:int (k:string shift:boolean ctrl:boolean) {
        def n:int (array_length shown)
        if ((k == "ArrowDown") || (k == "ArrowUp")) {
            if (n > 0) {
                if (k == "ArrowDown") {
                    kbd = (? (kbd < 0) 0 (kbd + 1))
                } {
                    kbd = (? (kbd < 0) (n - 1) (kbd - 1))
                }
                if (kbd >= n) {
                    kbd = (n - 1)
                }
                if (kbd < 0) {
                    kbd = 0
                }
                reveal = (itemAt shown kbd)
                this.rebuild()
            }
            return -1
        }
        if (k == "Enter") {
            if (n == 0) {
                return -1
            }
            def pos:int (? (kbd >= 0) kbd 0)
            if (pos >= n) {
                pos = 0
            }
            return (itemAt shown pos)
        }
        search.keyDownWith(search.tid k shift ctrl)
        this.filter()
        this.rebuild()
        return -1
    }

    ; Esc: the search emptied first; true when it had something to empty.
    fn clearSearch:boolean () {
        if ((strlen search.value) == 0) {
            return false
        }
        search.setValue("")
        search.moveTo(0 false)
        this.filter()
        reveal = current
        this.rebuild()
        return true
    }

    fn hoverAt:void (px:double py:double) {
        def t:string ""
        if (this.has(px py)) {
            if (null? host.lastPage) {
                this.layoutPage()
            }
            t = (host.hitTest(px py))
        }
        if ((PresTocDrawer.rowOf(t)) < 0) {
            if (t != (drawer.closeTid())) {
                t = ""
            }
        }
        if (t != hot) {
            hot = t
            this.rebuild()
        }
    }

    fn cursorAt:string (px:double py:double) {
        if ((this.has(px py)) == false) {
            return ""
        }
        if (null? host.lastPage) {
            this.layoutPage()
        }
        def t:string (host.hitTest(px py))
        if (search.isClearHit(t)) {
            return "pointer"
        }
        if (search.owns(t)) {
            return "text"
        }
        if (((PresTocDrawer.rowOf(t)) >= 0) || (t == (drawer.closeTid()))) {
            return "pointer"
        }
        return "default"
    }

    fn wheel:void (dy:double) {
        if (null? host.lastPage) {
            this.layoutPage()
        }
        drawer.scrollBy(dy)
        rev = (rev + 1)
    }
}
