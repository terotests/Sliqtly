; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresSketch.rgr — drawings made on a slide while editing, kept in a file
; ============================================================================
;
; The pen of presenting (PresInk) in the editor, where what is drawn stays:
; a freehand line, an arrow, a straight line, an ellipse, and text put
; anywhere on the slide. A drawing is a file of the deck (drawings/*.ink,
; JSON) referenced from the slide's Markdown as a picture is:
;
;     ![](drawings/slide-3.ink)
;
; so deleting that line deletes the drawing from the slide (the file stays
; in Files). The reference takes no room (RangerMarkdown's overlay
; pictures); the drawing is over the whole slide.
;
; Played, the items come on in the order they were drawn, each drawn as a
; hand would: a line along its length (an arrow's head when the line is
; done), text letter by letter. `seconds` and `startOf` are the timing,
; `paint` the picture at a moment; nothing here has a clock.
;
; Coordinates are the slide's own units (the deck's page, PresDeck.pageW ×
; pageH), with the page size they were drawn on (`w`, `h`), so a drawing
; follows the slide to another page size (`fitTo`).
;
; File:
;   { "version": 1, "w": 960, "h": 540,
;     "items": [ { "tool": "pen", "color": "#facc15", "width": 4.5,
;                  "pts": [x, y, x, y, …] },
;                { "tool": "text", "color": "#ffffff", "size": 30,
;                  "x": 100, "y": 80, "text": "Look here" } ] }
; ============================================================================

Import "PresInk.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGColor.rgr"
Import "pkg:evg/EVGTextEngine.rgr"
Import "../vela/src/VlJson.rgr"

class PresSketchItem {
    ; pen | arrow | line | ellipse (PresInk's) | text
    def tool:string "pen"
    def color:string "#facc15"
    ; a line's width, in slide units
    def width:double 4.5
    ; a line's points: x, y, x, y, … (a line and an ellipse: the first and
    ; the last count)
    def pts:[double]
    ; text: its words (lines split at "\n"), the top left of its first
    ; line and its size
    def text:string ""
    def x:double 0.0
    def y:double 0.0
    def size:double 30.0
    ; text: measured by the host's fonts (`PresSketch.measure`), not saved;
    ; 0 until then, and an estimate stands in
    def tw:double 0.0
    ; …and its last line's (where a caret goes)
    def lw:double 0.0

    fn isText:boolean () {
        return (tool == "text")
    }

    fn lines:[string] () {
        return (strsplit text "\n")
    }

    fn lineHeight:double () {
        return (size * 1.25)
    }

    fn copy:PresSketchItem () {
        def c (new PresSketchItem())
        c.tool = tool
        c.color = color
        c.width = width
        def i:int 0
        while (i < (array_length pts)) {
            push c.pts (itemAt pts i)
            i = (i + 1)
        }
        c.text = text
        c.x = x
        c.y = y
        c.size = size
        c.tw = tw
        c.lw = lw
        return c
    }

    fn asStroke:PresInkStroke () {
        def s (new PresInkStroke())
        s.tool = tool
        s.color = color
        s.width = width
        s.pts = pts
        return s
    }
}

class PresSketch {
    def items:[PresSketchItem]
    ; the page size the coordinates are in
    def w:double 960.0
    def h:double 540.0
    ; bumped on every change
    def rev:int 0

    sfn TYPE:string () {
        return "application/vnd.sliqtly.ink+json"
    }

    ; A file name a drawing is kept under: *.ink
    sfn isPath:boolean (path:string) {
        def n:int (strlen path)
        if (n < 4) {
            return false
        }
        return ((substring path (n - 4) n) == ".ink")
    }

    sfn tools:[string] () {
        return ([] _:string ("pen" "arrow" "line" "ellipse" "text"))
    }

    ; Whether a Markdown line is the reference to the drawing at `path`
    ; (`![…](path)` alone on the line; with or without a leading "/").
    sfn isRefLine:boolean (line:string path:string) {
        def t:string (trim line)
        def p:string path
        while (startsWith p "/") {
            p = (substring p 1 (strlen p))
        }
        if (((strlen p) == 0) || ((startsWith t "![") == false)) {
            return false
        }
        return ((endsWith t ("](" + p + ")")) || (endsWith t ("](/" + p + ")")))
    }

    ; The lines to remove with the reference to `path` among a slide's
    ; `lines`: [first, last] (indexes into `lines`), the blank line after it
    ; too when one is before it, so no gap is left; [-1, -1] when there is
    ; none. An emptied drawing goes from the slide this way.
    sfn refSpan:[int] (lines:[string] path:string) {
        def n:int (array_length lines)
        def i:int 0
        while (i < n) {
            if (PresSketch.isRefLine((itemAt lines i) path)) {
                def last:int i
                def blankBefore:boolean ((i == 0) || ((strlen (trim (itemAt lines (i - 1)))) == 0))
                if ((blankBefore && ((i + 1) < n)) && ((strlen (trim (itemAt lines (i + 1)))) == 0)) {
                    last = (i + 1)
                }
                return ([] _:int (i last))
            }
            i = (i + 1)
        }
        return ([] _:int (-1 -1))
    }

    sfn knownTool:boolean (t:string) {
        return ((PresInk.knownTool(t)) || (t == "text"))
    }

    fn count:int () {
        return (array_length items)
    }

    fn itemAt:PresSketchItem (i:int) {
        return (itemAt items i)
    }

    ; --- the file ---------------------------------------------------------------

    sfn r1:double (v:double) {
        if (v < 0.0) {
            return (0.0 - (PresSketch.r1((0.0 - v))))
        }
        return ((to_double (to_int ((v * 10.0) + 0.5))) / 10.0)
    }

    sfn num:VlJson (v:double) {
        return (VlJson.numberValue((PresSketch.r1(v))))
    }

    fn toJson:string () {
        def root:VlJson (VlJson.objectValue())
        root.setMember("version" (VlJson.intValue(1)))
        root.setMember("w" (PresSketch.num(w)))
        root.setMember("h" (PresSketch.num(h)))
        def arr:VlJson (VlJson.arrayValue())
        def i:int 0
        while (i < (array_length items)) {
            def it:PresSketchItem (itemAt items i)
            def o:VlJson (VlJson.objectValue())
            o.setMember("tool" (VlJson.stringValue(it.tool)))
            o.setMember("color" (VlJson.stringValue(it.color)))
            if (it.isText()) {
                o.setMember("size" (PresSketch.num(it.size)))
                o.setMember("x" (PresSketch.num(it.x)))
                o.setMember("y" (PresSketch.num(it.y)))
                o.setMember("text" (VlJson.stringValue(it.text)))
            } {
                o.setMember("width" (PresSketch.num(it.width)))
                def ps:VlJson (VlJson.arrayValue())
                def k:int 0
                while (k < (array_length it.pts)) {
                    push ps.arr (PresSketch.num((itemAt it.pts k)))
                    k = (k + 1)
                }
                o.setMember("pts" ps)
            }
            push arr.arr o
            i = (i + 1)
        }
        root.setMember("items" arr)
        def wr (new VlJsonWriter())
        wr.decimals = 1
        return (wr.write(root))
    }

    ; A file read back: an empty drawing when the text is not one; items of
    ; a tool it does not know, and lines without two points, are left out.
    sfn parse:PresSketch (text:string) {
        def out (new PresSketch())
        if ((strlen (trim text)) == 0) {
            return out
        }
        def p (new VlJsonParser())
        def root:VlJson (p.parse(text))
        if ((p.ok == false) || ((root.isObject()) == false)) {
            return out
        }
        def pw:double (root.doubleOr("w" 960.0))
        def ph:double (root.doubleOr("h" 540.0))
        if ((pw > 0.0) && (ph > 0.0)) {
            out.w = pw
            out.h = ph
        }
        def arr:VlJson (root.get("items"))
        def i:int 0
        while (i < (arr.count())) {
            def o:VlJson (arr.at(i))
            if (o.isObject()) {
                def it (new PresSketchItem())
                it.tool = (o.stringOr("tool" ""))
                it.color = (o.stringOr("color" "#facc15"))
                if (it.isText()) {
                    it.size = (o.doubleOr("size" 30.0))
                    if (it.size < 4.0) {
                        it.size = 4.0
                    }
                    it.x = (o.doubleOr("x" 0.0))
                    it.y = (o.doubleOr("y" 0.0))
                    it.text = (o.stringOr("text" ""))
                    if ((strlen (trim it.text)) > 0) {
                        push out.items it
                    }
                } {
                    it.width = (o.doubleOr("width" 4.5))
                    if (it.width <= 0.0) {
                        it.width = 4.5
                    }
                    def ps:VlJson (o.get("pts"))
                    def k:int 0
                    while ((k + 1) < (ps.count())) {
                        push it.pts ((ps.at(k)).asDouble())
                        push it.pts ((ps.at((k + 1))).asDouble())
                        k = (k + 2)
                    }
                    if ((PresInk.knownTool(it.tool)) && ((array_length it.pts) >= 4)) {
                        push out.items it
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; The drawing on a page `pw` × `ph`: drawn on another size, everything
    ; is moved and scaled there (sizes and widths with the width).
    fn fitTo:void (pw:double ph:double) {
        if ((pw <= 0.0) || (ph <= 0.0)) {
            return
        }
        if (((fabs (pw - w)) < 0.01) && ((fabs (ph - h)) < 0.01)) {
            return
        }
        def kx:double (pw / w)
        def ky:double (ph / h)
        def i:int 0
        while (i < (array_length items)) {
            def it:PresSketchItem (itemAt items i)
            def k:int 0
            while ((k + 1) < (array_length it.pts)) {
                set it.pts k ((itemAt it.pts k) * kx)
                set it.pts (k + 1) ((itemAt it.pts (k + 1)) * ky)
                k = (k + 2)
            }
            it.x = (it.x * kx)
            it.y = (it.y * ky)
            it.width = (it.width * kx)
            it.size = (it.size * kx)
            it.tw = (it.tw * kx)
            it.lw = (it.lw * kx)
            i = (i + 1)
        }
        w = pw
        h = ph
        rev = (rev + 1)
    }

    ; --- drawing ---------------------------------------------------------------

    ; A line starts at (x, y); `extend` goes on with it; `finish` keeps it
    ; when it is more than a dot.
    fn begin:void (tool:string color:string width:double x:double y:double) {
        def it (new PresSketchItem())
        it.tool = tool
        if (((PresInk.knownTool(tool)) == false)) {
            it.tool = "pen"
        }
        it.color = color
        it.width = width
        if (it.width <= 0.0) {
            it.width = 4.5
        }
        push it.pts x
        push it.pts y
        push items it
        rev = (rev + 1)
    }

    fn extend:void (x:double y:double) {
        def n:int (array_length items)
        if (n == 0) {
            return
        }
        def it:PresSketchItem (itemAt items (n - 1))
        if (it.isText()) {
            return
        }
        def m:int (array_length it.pts)
        if ((it.tool == "line") || (it.tool == "ellipse")) {
            if (m >= 4) {
                set it.pts (m - 2) x
                set it.pts (m - 1) y
            } {
                push it.pts x
                push it.pts y
            }
        } {
            push it.pts x
            push it.pts y
        }
        rev = (rev + 1)
    }

    ; The line just drawn stays when it reaches further than `slop` from its
    ; start; else it goes (a click, not a line). True when it stayed.
    fn finish:boolean (slop:double) {
        def n:int (array_length items)
        if (n == 0) {
            return false
        }
        def it:PresSketchItem (itemAt items (n - 1))
        if (it.isText()) {
            return true
        }
        def b:[double] (PresSketch.boundsOfPts(it.pts))
        if ((((itemAt b 2) - (itemAt b 0)) < slop) && (((itemAt b 3) - (itemAt b 1)) < slop)) {
            removeLast items
            rev = (rev + 1)
            return false
        }
        if ((array_length it.pts) < 4) {
            push it.pts (itemAt it.pts 0)
            push it.pts (itemAt it.pts 1)
        }
        rev = (rev + 1)
        return true
    }

    ; Text at (x, y), its top left. Returns its index.
    fn addText:int (x:double y:double text:string color:string size:double) {
        def it (new PresSketchItem())
        it.tool = "text"
        it.x = x
        it.y = y
        it.text = text
        it.color = color
        it.size = size
        push items it
        rev = (rev + 1)
        return ((array_length items) - 1)
    }

    fn setText:void (i:int text:string) {
        if ((i < 0) || (i >= (array_length items))) {
            return
        }
        def it:PresSketchItem (itemAt items i)
        it.text = text
        it.tw = 0.0
        it.lw = 0.0
        rev = (rev + 1)
    }

    fn removeAt:void (i:int) {
        if ((i < 0) || (i >= (array_length items))) {
            return
        }
        def keep:[PresSketchItem]
        def k:int 0
        while (k < (array_length items)) {
            if (k != i) {
                push keep (itemAt items k)
            }
            k = (k + 1)
        }
        items = keep
        rev = (rev + 1)
    }

    fn moveBy:void (i:int dx:double dy:double) {
        if ((i < 0) || (i >= (array_length items))) {
            return
        }
        def it:PresSketchItem (itemAt items i)
        it.x = (it.x + dx)
        it.y = (it.y + dy)
        def k:int 0
        while ((k + 1) < (array_length it.pts)) {
            set it.pts k ((itemAt it.pts k) + dx)
            set it.pts (k + 1) ((itemAt it.pts (k + 1)) + dy)
            k = (k + 2)
        }
        rev = (rev + 1)
    }

    ; --- where things are ----------------------------------------------------

    sfn boundsOfPts:[double] (pts:[double]) {
        def x0:double 1000000000.0
        def y0:double 1000000000.0
        def x1:double -1000000000.0
        def y1:double -1000000000.0
        def k:int 0
        while ((k + 1) < (array_length pts)) {
            def px:double (itemAt pts k)
            def py:double (itemAt pts (k + 1))
            if (px < x0) {
                x0 = px
            }
            if (py < y0) {
                y0 = py
            }
            if (px > x1) {
                x1 = px
            }
            if (py > y1) {
                y1 = py
            }
            k = (k + 2)
        }
        if (x1 < x0) {
            return ([] _:double (0.0 0.0 0.0 0.0))
        }
        return ([] _:double (x0 y0 x1 y1))
    }

    ; A text's width: measured when it has been, else guessed from its
    ; letters.
    sfn textWidth:double (it:PresSketchItem) {
        if (it.tw > 0.0) {
            return it.tw
        }
        def most:int 0
        def ls:[string] (it.lines())
        def i:int 0
        while (i < (array_length ls)) {
            def n:int (strlen (itemAt ls i))
            if (n > most) {
                most = n
            }
            i = (i + 1)
        }
        return (((to_double most) * it.size) * 0.55)
    }

    ; Where a text's last line ends, from its left.
    sfn lastLineWidth:double (it:PresSketchItem) {
        if (it.tw > 0.0) {
            return it.lw
        }
        def ls:[string] (it.lines())
        if ((array_length ls) == 0) {
            return 0.0
        }
        return (((to_double (strlen (itemAt ls ((array_length ls) - 1)))) * it.size) * 0.55)
    }

    ; What item i covers: [x0, y0, x1, y1], a line's with its width.
    fn bounds:[double] (i:int) {
        def it:PresSketchItem (itemAt items i)
        if (it.isText()) {
            def tw:double (PresSketch.textWidth(it))
            def th:double ((to_double (array_length (it.lines()))) * (it.lineHeight()))
            return ([] _:double (it.x it.y (it.x + tw) (it.y + th)))
        }
        def line:[double] (PresInk.shape((it.asStroke())))
        def b:[double] (PresSketch.boundsOfPts(line))
        def half:double (it.width * 0.5)
        if (it.tool == "arrow") {
            half = (it.width * 2.5)
            if (half < 9.0) {
                half = 9.0
            }
        }
        return ([] _:double (((itemAt b 0) - half) ((itemAt b 1) - half) ((itemAt b 2) + half) ((itemAt b 3) + half)))
    }

    sfn segDist2:double (px:double py:double ax:double ay:double bx:double by:double) {
        def dx:double (bx - ax)
        def dy:double (by - ay)
        def len2:double ((dx * dx) + (dy * dy))
        def t:double 0.0
        if (len2 > 0.0) {
            t = ((((px - ax) * dx) + ((py - ay) * dy)) / len2)
            if (t < 0.0) {
                t = 0.0
            }
            if (t > 1.0) {
                t = 1.0
            }
        }
        def qx:double ((ax + (t * dx)) - px)
        def qy:double ((ay + (t * dy)) - py)
        return ((qx * qx) + (qy * qy))
    }

    ; The item at (x, y), the one drawn last first; `slop` is how far off a
    ; line a press still takes it. -1 none.
    fn hit:int (x:double y:double slop:double) {
        def i:int ((array_length items) - 1)
        while (i >= 0) {
            def it:PresSketchItem (itemAt items i)
            def b:[double] (this.bounds(i))
            if ((((x >= ((itemAt b 0) - slop)) && (x <= ((itemAt b 2) + slop))) && (y >= ((itemAt b 1) - slop))) && (y <= ((itemAt b 3) + slop))) {
                if (it.isText()) {
                    return i
                }
                def line:[double] (PresInk.shape((it.asStroke())))
                def reach:double ((it.width * 0.5) + slop)
                if (it.tool == "arrow") {
                    def hd:[double] (PresInk.head(line it.width))
                    if ((array_length hd) == 6) {
                        def hb:[double] (PresSketch.boundsOfPts(hd))
                        if ((((x >= (itemAt hb 0)) && (x <= (itemAt hb 2))) && (y >= (itemAt hb 1))) && (y <= (itemAt hb 3))) {
                            return i
                        }
                    }
                }
                def n:int (idiv (array_length line) 2)
                if (n == 1) {
                    def d0:double (PresSketch.segDist2(x y (itemAt line 0) (itemAt line 1) (itemAt line 0) (itemAt line 1)))
                    if (d0 <= (reach * reach)) {
                        return i
                    }
                }
                def k:int 0
                while (k < (n - 1)) {
                    def d:double (PresSketch.segDist2(x y (itemAt line (k * 2)) (itemAt line ((k * 2) + 1)) (itemAt line ((k + 1) * 2)) (itemAt line (((k + 1) * 2) + 1))))
                    if (d <= (reach * reach)) {
                        return i
                    }
                    k = (k + 1)
                }
            }
            i = (i - 1)
        }
        return -1
    }

    ; --- time ------------------------------------------------------------------

    sfn lengthOf:double (line:[double]) {
        def out:double 0.0
        def n:int (idiv (array_length line) 2)
        def k:int 1
        while (k < n) {
            def dx:double ((itemAt line (k * 2)) - (itemAt line ((k - 1) * 2)))
            def dy:double ((itemAt line ((k * 2) + 1)) - (itemAt line (((k - 1) * 2) + 1)))
            out = (out + (sqrt ((dx * dx) + (dy * dy))))
            k = (k + 1)
        }
        return out
    }

    ; The pause between two items.
    sfn GAP:double () {
        return 0.15
    }

    ; How long an item takes to come on: a line at a hand's speed (a slide
    ; width in about a second), text a letter at a time, each within bounds
    ; that keep a dot visible and a long scribble from holding the slide.
    fn seconds:double (i:int) {
        def it:PresSketchItem (itemAt items i)
        if (it.isText()) {
            def s:double ((to_double (strlen it.text)) * 0.045)
            if (s < 0.3) {
                s = 0.3
            }
            if (s > 1.6) {
                s = 1.6
            }
            return s
        }
        def line:[double] (PresInk.shape((it.asStroke())))
        def unitsPerSecond:double (w * 1.1)
        if (unitsPerSecond <= 0.0) {
            unitsPerSecond = 1000.0
        }
        def s2:double ((PresSketch.lengthOf(line)) / unitsPerSecond)
        if (s2 < 0.25) {
            s2 = 0.25
        }
        if (s2 > 1.4) {
            s2 = 1.4
        }
        return s2
    }

    ; When item i starts, from the drawing's own start.
    fn startOf:double (i:int) {
        def t:double 0.0
        def k:int 0
        while (k < i) {
            t = ((t + (this.seconds(k))) + (PresSketch.GAP()))
            k = (k + 1)
        }
        return t
    }

    ; How long the whole drawing takes to come on.
    fn total:double () {
        def n:int (array_length items)
        if (n == 0) {
            return 0.0
        }
        return ((this.startOf((n - 1))) + (this.seconds((n - 1))))
    }

    ; The first `f` (0…1) of a line, along its length.
    sfn cut:[double] (line:[double] f:double) {
        if (f >= 1.0) {
            return line
        }
        def out:[double]
        def n:int (idiv (array_length line) 2)
        if (n == 0) {
            return out
        }
        push out (itemAt line 0)
        push out (itemAt line 1)
        if (f <= 0.0) {
            return out
        }
        def want:double ((PresSketch.lengthOf(line)) * f)
        def got:double 0.0
        def k:int 1
        while (k < n) {
            def ax:double (itemAt line ((k - 1) * 2))
            def ay:double (itemAt line (((k - 1) * 2) + 1))
            def bx:double (itemAt line (k * 2))
            def by:double (itemAt line ((k * 2) + 1))
            def d:double (sqrt (((bx - ax) * (bx - ax)) + ((by - ay) * (by - ay))))
            if ((got + d) >= want) {
                def u:double 1.0
                if (d > 0.0) {
                    u = ((want - got) / d)
                }
                push out (ax + ((bx - ax) * u))
                push out (ay + ((by - ay) * u))
                return out
            }
            push out bx
            push out by
            got = (got + d)
            k = (k + 1)
        }
        return out
    }

    ; --- the picture -------------------------------------------------------------

    ; Text items are measured with the host's fonts: their boxes are then
    ; where the letters are.
    fn measure:void (engine:EVGTextEngine family:string) {
        def i:int 0
        while (i < (array_length items)) {
            def it:PresSketchItem (itemAt items i)
            if (it.isText()) {
                def most:double 0.0
                def ls:[string] (it.lines())
                def k:int 0
                while (k < (array_length ls)) {
                    def m:EVGTextMetrics (engine.measureRun((itemAt ls k) family it.size))
                    if (m.width > most) {
                        most = m.width
                    }
                    it.lw = m.width
                    k = (k + 1)
                }
                it.tw = most
            }
            i = (i + 1)
        }
    }

    ; The drawing `t` seconds after it started (a large `t`: all of it),
    ; into `dl` in slide units. `hide`: an item not drawn (the one whose
    ; text is being written, which the editor draws itself), -1 none.
    fn paint:void (dl:EVGDisplayList t:double family:string hide:int) {
        def at:double 0.0
        def i:int 0
        while (i < (array_length items)) {
            def secs:double (this.seconds(i))
            if (t < at) {
                return
            }
            def f:double 1.0
            if (secs > 0.0) {
                f = ((t - at) / secs)
            }
            if (f > 1.0) {
                f = 1.0
            }
            if (i != hide) {
                PresSketch.paintItem(dl (itemAt items i) f family)
            }
            at = ((at + secs) + (PresSketch.GAP()))
            i = (i + 1)
        }
    }

    ; One item, the first `f` of it.
    sfn paintItem:void (dl:EVGDisplayList it:PresSketchItem f:double family:string) {
        def col:EVGColor (EVGColor.parse(it.color))
        if (it.isText()) {
            def shown:int (to_int (((to_double (strlen it.text)) * f) + 0.999))
            if (f >= 1.0) {
                shown = (strlen it.text)
            }
            def part:string (substring it.text 0 shown)
            def ls:[string] (strsplit part "\n")
            def k:int 0
            while (k < (array_length ls)) {
                def ln:string (itemAt ls k)
                dl.addText(ln it.x (it.y + ((to_double k) * (it.lineHeight()))) it.size col family false false 0.0 it.size)
                k = (k + 1)
            }
            return
        }
        if (f >= 1.0) {
            PresInk.drawStroke(dl (it.asStroke()))
            return
        }
        ; on its way: the line so far, a dot at its start; an arrow's head
        ; comes with its end
        def line:[double] (PresSketch.cut((PresInk.shape((it.asStroke()))) f))
        if ((array_length line) < 4) {
            def dot (new PresInkStroke())
            dot.color = it.color
            dot.width = it.width
            push dot.pts (itemAt line 0)
            push dot.pts (itemAt line 1)
            PresInk.drawStroke(dl dot)
            return
        }
        PresInk.strokeLine(dl line it.width col)
    }
}
