; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresChartEditor.rgr — the chart settings window, in EVGUI controls
; ============================================================================
;
; Opened on a ```vega-lite fence. A movable window (WindowCtl) with three
; tabs (TabsCtl):
;
;   Kaavio    the size (two sliders, SliderCtl), the kind (a row of toggle
;             buttons: the ones the table cannot make are disabled and say
;             what they need), the title and the legend (SwitchCtl)
;   Ulkoasu   the colours: the theme's, a palette, or one colour from EVGUI's
;             colour picker (ColorPickerCtl, drawn by PresColorPanel as its
;             demo draws it); the text colour the same way; the stage style,
;             glow, shadow and gradient (switches) and a line's width (slider)
;   Tiedot    the data, a grid of fields: categories down the side, a column
;             per series
;
; Every change is written straight back into the fence (PresChartModel's
; toSpec), so the slide beside the window is the preview and Ctrl+Z undoes a
; change like any other edit. The controls sit in a UiHost of their own as
; big as the app; the window is an overlay in it. The host lays them out with
; the app's font measurer and hands back a display list the page draws over
; everything; the app routes the pointer and the keys here while it is open.
; The look is the EVGUI playground's: white cards, zinc greys, black primary
; (web/chart-editor.css, over the kit's theme).
; ============================================================================

Import "PresChartModel.rgr"
Import "PresImageModel.rgr"
Import "PresColorPanel.rgr"
Import "../ui/src/UiHost.rgr"
Import "PresKeep.rgr"

class PresChartEditor {
    def host:UiHost (new UiHost())
    def model:PresChartModel (new PresChartModel())
    def css:string ""
    def isOpen:boolean false
    ; the window's top-left corner and the page it moves on (the app's), in
    ; app coordinates
    def x:double 0.0
    def y:double 0.0
    def w:double 1200.0
    def h:double 700.0
    def win:WindowCtl (new WindowCtl())
    def tabs:TabsCtl (new TabsCtl())
    def tab:string "kaavio"
    def dragX:double 0.0
    def dragY:double 0.0
    def inputs:[InputCtl]
    def sliders:[SliderCtl]
    def focusTid:string ""
    ; the model changed since the fence was last written
    def changed:boolean false
    ; set by a control that wants the editor closed, or a fresh table
    def wantsClose:boolean false
    def wantsFresh:boolean false
    ; the chart's data file, asked to be opened in the files tab
    def wantsFile:string ""
    ; The same window for a picture's settings: `mode` "image", the picture
    ; in `img`. A picture asked to become a background ("slide", "all") or
    ; to be taken out goes to the app, which owns the Markdown and the theme.
    def mode:string "chart"
    def img:PresImageModel (new PresImageModel())
    def wantsBg:string ""
    def wantsRemove:boolean false
    def message:string ""
    def rev:int 0
    def keep:PresKeep (new PresKeep())
    def measurer@(optional):TTFTextMeasurer
    ; the colour picker, what it picks for ("color" the marks, "text" the
    ; words, "" closed) and the part being dragged ("sv", "hue", "alpha")
    def picker:ColorPickerCtl (new ColorPickerCtl())
    def cp:PresColorPanel (new PresColorPanel())
    def pickFor:string ""
    def dragPart:string ""
    ; a slider being dragged, by its host
    def sliding:boolean false

    Constructor () {
    }

    fn openImage:void (m:PresImageModel px:double py:double pw:double ph:double) {
        mode = "image"
        img = m
        wantsBg = ""
        wantsRemove = false
        this.openAt(px py pw ph)
    }

    fn open:void (m:PresChartModel px:double py:double pw:double ph:double) {
        mode = "chart"
        model = m
        this.openAt(px py pw ph)
    }

    fn openAt:void (px:double py:double pw:double ph:double) {
        x = px
        y = py
        w = pw
        h = ph
        isOpen = true
        wantsClose = false
        wantsFresh = false
        changed = false
        message = ""
        focusTid = ""
        pickFor = ""
        this.rebuild()
    }

    fn close:void () {
        isOpen = false
        focusTid = ""
        rev = (rev + 1)
    }

    ; Inside the window (its frame as last laid out).
    fn has:boolean (px:double py:double) {
        if ((strlen pickFor) > 0) {
            def pc@(optional):EVGElement (this.cardEl())
            if (!null? pc) {
                def c:EVGElement (unwrap pc)
                if ((((px >= c.calculatedX) && (px <= (c.calculatedX + c.calculatedWidth))) && ((py >= c.calculatedY) && (py <= (c.calculatedY + c.calculatedHeight))))) {
                    return true
                }
            }
        }
        def f:EVGElement (unwrap win.frameEl)
        if (f.calculatedWidth <= 0.0) {
            return false
        }
        return (((px >= f.calculatedX) && (px <= (f.calculatedX + f.calculatedWidth))) && ((py >= f.calculatedY) && (py <= (f.calculatedY + f.calculatedHeight))))
    }

    fn cardEl@(optional):EVGElement () {
        def none@(optional):EVGElement
        def r:EVGElement (unwrap host.root)
        def i:int 0
        while (i < (r.getChildCount())) {
            def k:EVGElement (r.getChild(i))
            if (k.id == "ce-pickcard") {
                def hit@(optional):EVGElement k
                return hit
            }
            i = (i + 1)
        }
        return none
    }

    fn dragging:boolean () {
        return ((win.dragging || sliding) || ((strlen dragPart) > 0))
    }

    fn dragTo:void (px:double py:double) {
        if ((strlen dragPart) > 0) {
            this.pickAt(px py)
            return
        }
        if sliding {
            host.pointerMove(px py)
            keep.restore()
            this.takeSliders()
            rev = (rev + 1)
            return
        }
        if (win.dragging == false) {
            return
        }
        win.dragBy((px - dragX) (py - dragY))
        dragX = px
        dragY = py
        x = win.x
        y = win.y
        if ((strlen pickFor) > 0) {
            def c@(optional):EVGElement (this.cardEl())
            if (!null? c) {
                def ce:EVGElement (unwrap c)
                def px2:double ((x + 560.0) + 12.0)
                if ((px2 + 280.0) > w) {
                    px2 = ((x - 280.0) - 12.0)
                }
                ce.overlayX = px2
                ce.overlayY = (y + 44.0)
            }
        }
        rev = (rev + 1)
    }

    fn release:void () {
        if win.dragging {
            win.release()
            rev = (rev + 1)
        }
        if sliding {
            sliding = false
            host.pointerUp()
            keep.restore()
            this.takeSliders()
            this.rebuild()
        }
        if ((strlen dragPart) > 0) {
            dragPart = ""
            this.rebuild()
        }
    }

    ; --- building ---------------------------------------------------------------
    fn div:EVGElement (cls:string) {
        def d (EVGElement.createDiv())
        d.className = cls
        return d
    }

    fn text:EVGElement (cls:string words:string) {
        def s (EVGElement.createSpan())
        s.className = cls
        s.textContent = words
        return s
    }

    fn put:void (c:UiCtl parent:EVGElement) {
        push host.ctls c
        parent.addChild((unwrap c.rootEl))
    }

    fn button:ButtonCtl (tid:string name:string variant:string parent:EVGElement) {
        def c (new ButtonCtl())
        c.tid = tid
        c.name = name
        c.variant = variant
        c.build()
        this.dressButton(c)
        this.put(c parent)
        return c
    }

    ; The label is its own text node and takes no colour from the button, so
    ; a black button says so to its label.
    fn dressButton:void (c:ButtonCtl) {
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r "ce-small")
        if ((c.variant == "primary") && ((r.getChildCount()) > 0)) {
            UiTree.addClass((r.getChild(0)) "ce-onprimary")
        }
    }

    ; A toggle among others: the pressed one is the primary.
    fn chip:ButtonCtl (tid:string name:string on:boolean parent:EVGElement) {
        def v:string "outline"
        if on {
            v = "primary"
        }
        def c:ButtonCtl (this.button(tid name v parent))
        UiTree.addClass((unwrap c.rootEl) "ce-chip")
        return c
    }

    fn input:InputCtl (tid:string name:string value:string cls:string parent:EVGElement) {
        def c (new InputCtl())
        c.tid = tid
        c.name = name
        c.fontFamily = "Open Sans"
        c.fontSize = 13.0
        c.boxWidth = 80.0
        c.setValue(value)
        c.moveTo((strlen value) false)
        c.build()
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r cls)
        if (tid == focusTid) {
            UiTree.addClass(r "ce-focus")
        }
        this.put(c parent)
        push inputs c
        return c
    }

    fn switchOf:SwitchCtl (tid:string name:string on:boolean parent:EVGElement) {
        def c (new SwitchCtl())
        c.tid = tid
        c.name = name
        if on {
            c.checkState = 1
        }
        c.build()
        this.put(c parent)
        return c
    }

    fn slider:SliderCtl (tid:string name:string v:int lo:int hi:int st:int parent:EVGElement) {
        def c (new SliderCtl())
        c.tid = tid
        c.name = name
        c.minValue = lo
        c.maxValue = hi
        c.step = st
        c.value = v
        c.build()
        UiTree.addClass((unwrap c.rootEl) "ce-slider")
        this.put(c parent)
        push sliders c
        return c
    }

    fn swatch:EVGElement (hex:string) {
        def d:EVGElement (this.div("ce-swatch"))
        UiTree.inline(d "background-color" hex)
        return d
    }

    ; A labelled row: the words on the left, the control on the right.
    fn field:EVGElement (label:string) {
        def r:EVGElement (this.div("ce-field"))
        r.addChild((this.text("ce-flabel" label)))
        return r
    }

    fn section:EVGElement (root:EVGElement title:string) {
        root.addChild((this.text("ce-section" title)))
        def s:EVGElement (this.div("ce-group"))
        root.addChild(s)
        return s
    }

    fn rebuild:void () {
        def fresh (new UiHost())
        host = fresh
        host.addStyleSheet(css)
        host.setTheme("ce")
        host.setPageSize(w h)
        def none:[InputCtl]
        inputs = none
        def noSliders:[SliderCtl]
        sliders = noSliders
        def page0:EVGElement (unwrap host.root)
        page0.className = "ui-root ce-page"
        def w0 (new WindowCtl())
        win = w0
        win.tid = "ce-win"
        win.name = "Kaavion asetukset"
        win.title = "Kaavion asetukset"
        if (mode == "image") {
            win.name = "Kuvan asetukset"
            win.title = "Kuvan asetukset"
        }
        win.closeLabel = "Sulje"
        win.isModal = false
        win.x = x
        win.y = y
        win.pageW = w
        win.pageH = h
        win.openWindow()
        def body:EVGElement (unwrap win.bodyEl)
        body.className = "ce-body"
        UiTree.clearChildren(body)
        this.fillBody(body)
        win.build()
        push host.ctls win
        page0.addChild((unwrap win.rootEl))
        if ((strlen pickFor) > 0) {
            page0.addChild((this.pickerCard()))
        }
        if ((strlen focusTid) > 0) {
            host.focus(focusTid)
        }
        keep.remember(host)
        rev = (rev + 1)
    }

    fn fillBody:void (root:EVGElement) {
        if (mode == "image") {
            this.imageBody(root)
            return
        }
        if (model.ok == false) {
            root.addChild((this.text("ce-note" model.note)))
            root.addChild((this.text("ce-doc" "Voit aloittaa uuden taulukon: kaavion nykyinen sisältö korvataan esimerkkitaulukolla.")))
            def row0:EVGElement (this.div("ce-row"))
            this.button("ce-fresh" "Aloita taulukosta" "primary" row0)
            this.button("ce-done" "Sulje" "outline" row0)
            root.addChild(row0)
            return
        }
        ; the tabs
        def t0 (new TabsCtl())
        tabs = t0
        tabs.tid = "ce-tabs"
        tabs.name = "Kaavion asetukset"
        tabs.addItem("kaavio" "Kaavio" "" false)
        tabs.addItem("ulkoasu" "Ulkoasu" "" false)
        tabs.addItem("tiedot" "Tiedot" "" false)
        tabs.value = tab
        tabs.build()
        UiTree.addClass((unwrap tabs.rootEl) "ce-tabs")
        this.put(tabs root)

        def pane:EVGElement (this.div("ce-pane"))
        if (tab == "kaavio") {
            this.chartTab(pane)
        }
        if (tab == "ulkoasu") {
            this.looksTab(pane)
        }
        if (tab == "tiedot") {
            this.dataTab(pane)
        }
        root.addChild(pane)

        def bottom:EVGElement (this.div("ce-foot"))
        def note:string "Muutokset näkyvät diassa heti. Ctrl+Z kumoaa ne ikkunan sulkemisen jälkeen."
        if ((strlen message) > 0) {
            note = message
        }
        bottom.addChild((this.text("ce-doc" note)))
        bottom.addChild((this.div("ce-grow")))
        this.button("ce-done" "Valmis" "primary" bottom)
        root.addChild(bottom)
    }

    ; --- a picture ---------------------------------------------------------------
    fn imageBody:void (root:EVGElement) {
        def pane:EVGElement (this.div("ce-pane"))
        root.addChild(pane)
        pane.addChild((this.text("ce-doc" img.path)))
        def size:EVGElement (this.section(pane "Koko"))
        def wp:int (PresImageModel.percent(img.width))
        def wr:EVGElement (this.field("Leveys"))
        def wv:int wp
        if (wv <= 0) {
            wv = 100
        }
        this.slider("ie-width" "Leveys" wv 10 100 5 wr)
        def wl:string ((to_string wp) + " %")
        if ((strlen img.width) == 0) {
            wl = "oma koko"
        } {
            if (wp <= 0) {
                wl = img.width
            }
        }
        wr.addChild((this.text("ce-value" wl)))
        size.addChild(wr)
        def hp:int (PresImageModel.percent(img.height))
        def hr:EVGElement (this.field("Korkeus"))
        this.slider("ie-height" "Korkeus" hp 0 100 5 hr)
        def hl:string ((to_string hp) + " % diasta")
        if ((strlen img.height) == 0) {
            hl = "mahtuu diaan"
        } {
            if (hp <= 0) {
                hl = img.height
            }
        }
        hr.addChild((this.text("ce-value" hl)))
        size.addChild(hr)
        def nr:EVGElement (this.div("ce-row"))
        this.button("ie-natural" "Oma koko" "outline" nr)
        size.addChild(nr)
        size.addChild((this.text("ce-doc" "Kuva pysyy muodossaan: leveys on palstan leveydestä, korkeus dian sisällön korkeudesta, ja pienempi niistä ratkaisee.")))

        def place:EVGElement (this.section(pane "Paikka"))
        def chips:EVGElement (this.div("ce-chips"))
        this.chip("ie-align-" "Teeman" ((strlen img.align) == 0) chips)
        this.chip("ie-align-left" "Vasen" (img.align == "left") chips)
        this.chip("ie-align-center" "Keskellä" (img.align == "center") chips)
        this.chip("ie-align-right" "Oikea" (img.align == "right") chips)
        place.addChild(chips)

        def words:EVGElement (this.section(pane "Vaihtoehtoinen teksti"))
        def al:EVGElement (this.field("Kuvaus"))
        this.input("ie-alt" "Kuvaus" img.alt "ce-wide" al)
        words.addChild(al)
        words.addChild((this.text("ce-doc" "Ruudunlukija lukee tämän, ja se näkyy, jos kuvaa ei löydy.")))

        def bg:EVGElement (this.section(pane "Taustakuvaksi"))
        def br:EVGElement (this.div("ce-row"))
        this.button("ie-bg-slide" "Tämän dian tausta" "outline" br)
        this.button("ie-bg-all" "Kaikkien diojen tausta" "outline" br)
        bg.addChild(br)
        bg.addChild((this.text("ce-doc" "Kuva siirtyy dian otsikon bg-asetukseksi tai teeman page-säännön background-imageksi ja peittää koko dian. bg-dim=0.4 otsikossa himmentää sitä tekstin alla.")))

        def bottom:EVGElement (this.div("ce-foot"))
        this.button("ie-remove" "Poista kuva" "outline" bottom)
        bottom.addChild((this.div("ce-grow")))
        this.button("ce-done" "Valmis" "primary" bottom)
        root.addChild(bottom)
    }

    fn imageAct:boolean (tid:string) {
        if (tid == "ie-natural") {
            img.width = ""
            img.height = ""
            changed = true
            this.rebuild()
            return true
        }
        if ((indexOf tid "ie-align-") == 0) {
            img.align = (substring tid 9 (strlen tid))
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ie-bg-slide") {
            wantsBg = "slide"
            wantsClose = true
            return true
        }
        if (tid == "ie-bg-all") {
            wantsBg = "all"
            wantsClose = true
            return true
        }
        if (tid == "ie-remove") {
            wantsRemove = true
            wantsClose = true
            return true
        }
        return false
    }

    fn sizeW:int () {
        if (model.width > 0) {
            return model.width
        }
        return 640
    }

    fn sizeH:int () {
        if (model.height > 0) {
            return model.height
        }
        return 300
    }

    fn chartTab:void (pane:EVGElement) {
        ; the size first: it is what a slide asks of a chart most
        def size:EVGElement (this.section(pane "Koko"))
        def wr:EVGElement (this.field("Leveys"))
        this.slider("ce-width" "Leveys" (this.sizeW()) 200 960 10 wr)
        wr.addChild((this.text("ce-value" ((to_string (this.sizeW())) + " px"))))
        size.addChild(wr)
        def hr:EVGElement (this.field("Korkeus"))
        this.slider("ce-height" "Korkeus" (this.sizeH()) 120 600 10 hr)
        hr.addChild((this.text("ce-value" ((to_string (this.sizeH())) + " px"))))
        size.addChild(hr)
        if ((model.width <= 0) && (model.height <= 0)) {
            size.addChild((this.text("ce-doc" "Nyt kaavio saa koon diasta; liukusäädin asettaa oman.")))
        } {
            def ar:EVGElement (this.div("ce-row"))
            this.button("ce-autosize" "Koko diasta" "outline" ar)
            size.addChild(ar)
        }

        if model.lookOnly {
            ; the kind is the specification's own: the table that would
            ; choose another is not there
            def words0:EVGElement (this.section(pane "Otsikko ja selite"))
            def tl0:EVGElement (this.field("Otsikko"))
            this.input("ce-titlein" "Otsikko" model.title "ce-wide" tl0)
            words0.addChild(tl0)
            this.switchOf("ce-legend" "Näytä selite" model.legend words0)
            return
        }
        def kind:EVGElement (this.section(pane "Tyyppi"))
        def kinds:EVGElement (this.div("ce-chips"))
        def k:int 1
        while (k <= 20) {
            def b:ButtonCtl (this.chip(("ce-kind-" + (to_string k)) (PresChartModel.kindLabel(k)) (k == model.kind) kinds))
            if ((k != model.kind) && ((model.suits(k)) == false)) {
                b.disabled = true
                b.build()
                this.dressButton(b)
                UiTree.addClass((unwrap b.rootEl) "ce-chip")
            }
            k = (k + 1)
        }
        kind.addChild(kinds)
        if ((model.suits(model.kind)) == false) {
            kind.addChild((this.text("ce-warn" ((PresChartModel.kindLabel(model.kind)) + " tarvitsee " + (PresChartModel.kindNeeds(model.kind)) + "."))))
        }

        def words:EVGElement (this.section(pane "Otsikko ja selite"))
        def tl:EVGElement (this.field("Otsikko"))
        this.input("ce-titlein" "Otsikko" model.title "ce-wide" tl)
        words.addChild(tl)
        this.switchOf("ce-legend" "Näytä selite" model.legend words)
    }

    fn looksTab:void (pane:EVGElement) {
        def col:EVGElement (this.section(pane "Värit"))
        def cols:EVGElement (this.div("ce-chips"))
        this.chip("ce-scheme-" "Teeman" (((strlen model.scheme) == 0) && ((strlen model.color) == 0)) cols)
        this.chip("ce-pick-color" "Oma väri" ((strlen model.color) > 0) cols)
        if ((strlen model.color) > 0) {
            cols.addChild((this.swatch(model.color)))
        }
        def names:[string] (strsplit (PresChartModel.schemes()) " ")
        def s:int 0
        while (s < (array_length names)) {
            def nm:string (itemAt names s)
            this.chip(("ce-scheme-" + nm) nm (nm == model.scheme) cols)
            s = (s + 1)
        }
        col.addChild(cols)

        def tx:EVGElement (this.section(pane "Tekstin väri"))
        def tr:EVGElement (this.div("ce-chips"))
        this.chip("ce-text-theme" "Teeman" ((strlen model.textColor) == 0) tr)
        this.chip("ce-pick-text" "Oma väri" ((strlen model.textColor) > 0) tr)
        if ((strlen model.textColor) > 0) {
            tr.addChild((this.swatch(model.textColor)))
        }
        tx.addChild(tr)

        def st:EVGElement (this.section(pane "Tyyli diassa"))
        def ef:EVGElement (this.div("ce-chips"))
        def effects:[string] (strsplit ",flat,forge,neon,glass" ",")
        def effectNames:[string] (strsplit "Teeman,Tasainen,Ahjo,Neon,Lasi" ",")
        def e:int 0
        while (e < (array_length effects)) {
            this.chip(("ce-effect-" + (itemAt effects e)) (itemAt effectNames e) ((itemAt effects e) == model.effect) ef)
            e = (e + 1)
        }
        st.addChild(ef)
        def sw:EVGElement (this.div("ce-row ce-switches"))
        this.switchOf("ce-glow" "Hehku" model.glow sw)
        this.switchOf("ce-shadow" "Varjo" model.shadow sw)
        this.switchOf("ce-gradient" "Liukuväri" model.gradient sw)
        st.addChild(sw)
        if ((model.kind >= 6) && (model.kind <= 9)) {
            def wr:EVGElement (this.field("Viivan paksuus"))
            this.slider("ce-stroke" "Viivan paksuus" (to_int model.strokeWidth) 0 10 1 wr)
            def label:string ((to_string (to_int model.strokeWidth)) + " px")
            if (model.strokeWidth <= 0.0) {
                label = "oletus"
            }
            wr.addChild((this.text("ce-value" label)))
            st.addChild(wr)
            def pr:EVGElement (this.div("ce-row ce-switches"))
            this.switchOf("ce-points" "Pisteet" model.points pr)
            st.addChild(pr)
        }
    }

    ; The picker: a card of its own beside the window (on its left when
    ; there is no room on the right), so the window keeps its height.
    fn pickerCard:EVGElement () {
        picker.inline = true
        def card:EVGElement (this.div("ce-pickcard"))
        card.id = "ce-pickcard"
        def head:EVGElement (this.div("ce-pickhead"))
        def what:string "Kaavion väri"
        if (pickFor == "text") {
            what = "Tekstin väri"
        }
        head.addChild((this.text("ce-picktitle" what)))
        head.addChild((this.div("ce-grow")))
        this.button("ce-pick-done" "Valmis" "primary" head)
        card.addChild(head)
        card.addChild((cp.panel(picker)))
        push host.ctls picker
        def px:double ((x + 560.0) + 12.0)
        if ((px + 280.0) > w) {
            px = ((x - 280.0) - 12.0)
        }
        if (px < 0.0) {
            px = (w - 280.0)
        }
        UiTree.surface(card "free" "start")
        card.overlayX = px
        card.overlayY = (y + 44.0)
        return card
    }

    fn dataTab:void (pane:EVGElement) {
        if model.lookOnly {
            pane.addChild((this.text("ce-doc" model.why)))
            if ((strlen model.dataFile) > 0) {
                def src:EVGElement (this.field("Tiedosto"))
                src.addChild((this.text("ce-value" model.dataFile)))
                pane.addChild(src)
                pane.addChild((this.text("ce-doc" "Tiedot ovat esityksen tiedostossa: muokkaa niitä Tiedostot-välilehdellä. Kaavio piirtyy uudelleen, kun tiedosto muuttuu.")))
            } {
                pane.addChild((this.text("ce-doc" "Tiedot ja niiden käsittely ovat kaavion JSONissa Markdown-välilehdellä.")))
            }
            def row:EVGElement (this.div("ce-row"))
            if ((strlen model.dataFile) > 0) {
                this.button("ce-openfile" "Avaa tiedosto" "primary" row)
            }
            this.button("ce-fresh" "Korvaa esimerkkitaulukolla" "outline" row)
            pane.addChild(row)
            return
        }
        pane.addChild((this.text("ce-doc" "Ensimmäinen sarake: luokat. Muut sarakkeet: sarjat.")))
        def grid:EVGElement (this.div("ce-grid"))
        def hr:EVGElement (this.div("ce-gridrow ce-gridhead"))
        def c:int 0
        while (c < (model.cols())) {
            this.input(("ce-h-" + (to_string c)) "Sarake" (itemAt model.header c) "ce-cell ce-head" hr)
            c = (c + 1)
        }
        this.button("ce-addcol" "+ Sarja" "ghost" hr)
        grid.addChild(hr)
        def r:int 0
        while (r < (model.rows())) {
            def row:EVGElement (this.div("ce-gridrow"))
            def cc:int 0
            while (cc < (model.cols())) {
                def cls:string "ce-cell"
                if (cc == 0) {
                    cls = "ce-cell ce-cat"
                }
                this.input(("ce-c-" + (to_string r) + "-" + (to_string cc)) "Solu" (model.cell(r cc)) cls row)
                cc = (cc + 1)
            }
            def x0:ButtonCtl (this.button(("ce-delrow-" + (to_string r)) "×" "ghost" row))
            UiTree.addClass((unwrap x0.rootEl) "ce-x")
            grid.addChild(row)
            r = (r + 1)
        }
        pane.addChild(grid)
        def foot:EVGElement (this.div("ce-row"))
        this.button("ce-addrow" "+ Rivi" "outline" foot)
        if ((model.cols()) > 2) {
            this.button("ce-delcol" "− Viimeinen sarja" "outline" foot)
        }
        pane.addChild(foot)
    }

    ; --- drawing ------------------------------------------------------------------
    fn page:EVGElement () {
        def r:EVGElement (unwrap host.root)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h false)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        ; the focused field's caret where its caret is, not after the text
        def eng:EVGTextEngine (lay.getTextEngine())
        cp.eng = eng
        def i:int 0
        while (i < (array_length inputs)) {
            def c:InputCtl (itemAt inputs i)
            def car:EVGElement (unwrap c.caretEl)
            if (c.tid == focusTid) {
                c.ensureCaretVisible(eng)
                def box:EVGElement (unwrap c.rootEl)
                box.position = "relative"
                car.position = "absolute"
                car.left = (EVGUnit.px(((10.0 + (c.caretXAt(eng c.caret))) - c.scrollX)))
                car.top = (EVGUnit.px(6.0))
            } {
                car.width = (EVGUnit.px(0.0))
            }
            i = (i + 1)
        }
        lay.layout(pg)
        if ((strlen pickFor) > 0) {
            cp.placeThumbs(pg picker)
        }
        host.lastPage = pg
        return pg
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.page())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; --- input --------------------------------------------------------------------
    fn inputFor@(optional):InputCtl (tid:string) {
        def found@(optional):InputCtl
        def i:int 0
        while (i < (array_length inputs)) {
            def c:InputCtl (itemAt inputs i)
            if (c.tid == tid) {
                found = c
            }
            i = (i + 1)
        }
        return found
    }

    fn focusInput:void (tid:string) {
        def prev@(optional):InputCtl (this.inputFor(focusTid))
        if (!null? prev) {
            def pc:InputCtl (unwrap prev)
            UiTree.removeClass((unwrap pc.rootEl) "ce-focus")
        }
        cp.leaveField(picker)
        focusTid = tid
        def next@(optional):InputCtl (this.inputFor(tid))
        if (!null? next) {
            def nc:InputCtl (unwrap next)
            UiTree.addClass((unwrap nc.rootEl) "ce-focus")
            nc.moveTo((strlen nc.value) false)
            host.focus(tid)
        }
        rev = (rev + 1)
    }

    sfn isSlider:boolean (tid:string) {
        return (((((indexOf tid "ce-width") == 0) || ((indexOf tid "ce-height") == 0)) || ((indexOf tid "ce-stroke") == 0)) || ((tid == "ie-width") || (tid == "ie-height")))
    }

    ; A press in app coordinates. What it did is in the model (and `changed`),
    ; or in `wantsClose` / `wantsFresh` for the app to act on.
    fn press:void (px:double py:double) {
        if ((this.has(px py)) == false) {
            return
        }
        if (null? host.lastPage) {
            this.page()
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return
        }
        if (tid == (win.closeTid())) {
            wantsClose = true
            return
        }
        if (win.isHandle(tid)) {
            win.press(tid)
            dragX = px
            dragY = py
            rev = (rev + 1)
            return
        }
        ; the part of a control that was hit carries its own id: the control's
        ; is the root's
        def ctlTid:string tid
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            ctlTid = owner.tid
        }
        ; the colour picker's parts
        if (((strlen pickFor) > 0) && (ctlTid == picker.tid)) {
            if ((strlen focusTid) > 0) {
                this.focusInput("")
            }
            def what:string (cp.press((unwrap host.lastPage) picker tid px py))
            if (((what == "sv") || (what == "hue")) || (what == "alpha")) {
                dragPart = what
                this.takeColour((picker.hex()))
            }
            if (what == "changed") {
                this.takeColour((picker.hex()))
            }
            this.rebuild()
            return
        }
        cp.leaveField(picker)
        ; a slider: pressed and dragged through its host
        if (PresChartEditor.isSlider(ctlTid)) {
            host.pressAt(px py)
            keep.restore()
            sliding = true
            this.takeSliders()
            rev = (rev + 1)
            return
        }
        if (ctlTid == tabs.tid) {
            host.click(tid)
            keep.restore()
            if (tabs.value != tab) {
                tab = tabs.value
                focusTid = ""
                pickFor = ""
                this.rebuild()
            }
            return
        }
        def asInput@(optional):InputCtl (this.inputFor(ctlTid))
        if (!null? asInput) {
            this.focusInput(ctlTid)
            return
        }
        this.act(ctlTid)
    }

    fn sliderValue:int (tid:string dflt:int) {
        def i:int 0
        while (i < (array_length sliders)) {
            def sc:SliderCtl (itemAt sliders i)
            if (sc.tid == tid) {
                return sc.value
            }
            i = (i + 1)
        }
        return dflt
    }

    ; The sliders' values into the model.
    fn takeSliders:void () {
        if (mode == "image") {
            def wp:int (PresImageModel.percent(img.width))
            def wv:int (this.sliderValue("ie-width" -1))
            if ((wv > 0) && ((wv != wp) && ((wv != 100) || ((strlen img.width) > 0)))) {
                img.width = ((to_string wv) + "%")
                changed = true
            }
            def hp:int (PresImageModel.percent(img.height))
            def hv:int (this.sliderValue("ie-height" -1))
            if ((hv >= 0) && (hv != hp)) {
                if (hv == 0) {
                    img.height = ""
                } {
                    img.height = ((to_string hv) + "%")
                }
                changed = true
            }
            return
        }
        if (tab == "kaavio") {
            def sw:int (this.sliderValue("ce-width" (this.sizeW())))
            def sh:int (this.sliderValue("ce-height" (this.sizeH())))
            if ((sw != (this.sizeW())) || (sh != (this.sizeH()))) {
                model.width = sw
                model.height = sh
                changed = true
            }
        }
        if (tab == "ulkoasu") {
            def ss:int (this.sliderValue("ce-stroke" (to_int model.strokeWidth)))
            if ((to_double ss) != model.strokeWidth) {
                model.strokeWidth = (to_double ss)
                changed = true
            }
        }
    }

    ; A press or a drag in the picker's area or bars.
    fn pickAt:void (px:double py:double) {
        if (null? host.lastPage) {
            return
        }
        cp.dragAt((unwrap host.lastPage) picker dragPart px py)
        this.takeColour((picker.hex()))
        this.rebuild()
        this.page()
    }

    fn takeColour:void (hex:string) {
        if (pickFor == "text") {
            if (model.textColor != hex) {
                model.textColor = hex
                changed = true
            }
        } {
            if (model.color != hex) {
                model.color = hex
                model.scheme = ""
                changed = true
            }
        }
    }

    fn openPicker:void (what:string hex:string) {
        pickFor = what
        focusTid = ""
        def start:string hex
        if ((strlen start) == 0) {
            start = "#f97316"
            if (what == "text") {
                start = "#e7eaff"
            }
        }
        def fresh (new ColorPickerCtl())
        picker = fresh
        picker.setup("ce-cp" "Väri" start (what == "color"))
        picker.inline = true
        picker.hexBoxW = 150.0
        picker.numBoxW = 30.0
        def presets:[string] (strsplit "#ef4444,#f97316,#eab308,#22c55e,#06b6d4,#3b82f6,#8b5cf6,#ec4899" ",")
        def i:int 0
        while (i < (array_length presets)) {
            push picker.swatches (itemAt presets i)
            i = (i + 1)
        }
        picker.syncFields()
        this.takeColour((picker.hex()))
        this.rebuild()
    }

    fn act:void (tid:string) {
        message = ""
        if ((mode == "image") && (this.imageAct(tid))) {
            return
        }
        if (tid == "ce-done") {
            wantsClose = true
            return
        }
        if (tid == "ce-fresh") {
            wantsFresh = true
            return
        }
        if (tid == "ce-openfile") {
            wantsFile = model.dataFile
            wantsClose = true
            return
        }
        if (tid == "ce-autosize") {
            model.width = 0
            model.height = 0
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-kind-") == 0) {
            def k:int (?? (str2int (substring tid 8 (strlen tid))) 0)
            if ((k > 0) && ((k == model.kind) || (model.suits(k)))) {
                model.kind = k
                changed = true
            } {
                message = ((PresChartModel.kindLabel(k)) + " tarvitsee " + (PresChartModel.kindNeeds(k)) + ".")
            }
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-scheme-") == 0) {
            model.scheme = (substring tid 10 (strlen tid))
            model.color = ""
            if (pickFor == "color") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-pick-color") {
            this.openPicker("color" model.color)
            return
        }
        if (tid == "ce-pick-text") {
            this.openPicker("text" model.textColor)
            return
        }
        if (tid == "ce-pick-done") {
            cp.leaveField(picker)
            pickFor = ""
            this.rebuild()
            return
        }
        if (tid == "ce-text-theme") {
            model.textColor = ""
            if (pickFor == "text") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-effect-") == 0) {
            model.effect = (substring tid 10 (strlen tid))
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-legend") {
            model.legend = (model.legend == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-points") {
            model.points = (model.points == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-glow") {
            model.glow = (model.glow == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-shadow") {
            model.shadow = (model.shadow == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-gradient") {
            model.gradient = (model.gradient == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-addrow") {
            model.addRow()
            focusTid = ("ce-c-" + (to_string ((model.rows()) - 1)) + "-0")
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-addcol") {
            model.addCol(("Sarja " + (to_string (model.cols()))))
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-delcol") {
            model.removeCol(((model.cols()) - 1))
            focusTid = ""
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-delrow-") == 0) {
            model.removeRow((?? (str2int (substring tid 10 (strlen tid))) -1))
            focusTid = ""
            changed = true
            this.rebuild()
            return
        }
    }

    ; The focused field's text into the model.
    fn take:void () {
        def maybe@(optional):InputCtl (this.inputFor(focusTid))
        if (null? maybe) {
            return
        }
        def c:InputCtl (unwrap maybe)
        def v:string c.value
        if (focusTid == "ce-titlein") {
            model.title = v
        }
        if (focusTid == "ie-alt") {
            img.alt = v
        }
        if ((indexOf focusTid "ce-h-") == 0) {
            model.setHeader((?? (str2int (substring focusTid 5 (strlen focusTid))) -1) v)
        }
        if ((indexOf focusTid "ce-c-") == 0) {
            def parts:[string] (strsplit (substring focusTid 5 (strlen focusTid)) "-")
            if ((array_length parts) == 2) {
                model.setCell((?? (str2int (itemAt parts 0)) -1) (?? (str2int (itemAt parts 1)) -1) v)
            }
        }
        changed = true
        rev = (rev + 1)
    }

    fn type:void (s:string) {
        def i:int 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            if ((ch != (strfromcode 10)) && (ch != (strfromcode 13))) {
                if ((strlen cp.focused) > 0) {
                    cp.type(picker ch)
                } {
                    if ((strlen focusTid) > 0) {
                        host.type(ch)
                        keep.restore()
                    }
                }
            }
            i = (i + 1)
        }
        if ((strlen cp.focused) > 0) {
            this.takeColour((picker.hex()))
            this.rebuild()
            return
        }
        if ((strlen focusTid) > 0) {
            this.take()
        }
    }

    ; The fields in reading order, for Tab and Enter.
    fn nextField:string (from:string back:boolean) {
        def i:int 0
        def at:int -1
        while (i < (array_length inputs)) {
            def ci:InputCtl (itemAt inputs i)
            if (ci.tid == from) {
                at = i
            }
            i = (i + 1)
        }
        def n:int (array_length inputs)
        if (n == 0) {
            return ""
        }
        def j:int (at + 1)
        if back {
            j = (at - 1)
        }
        if (j < 0) {
            j = (n - 1)
        }
        if (j >= n) {
            j = 0
        }
        def cj:InputCtl (itemAt inputs j)
        return cj.tid
    }

    sfn kitKey:string (name:string) {
        if (name == "left") { return "ArrowLeft" }
        if (name == "right") { return "ArrowRight" }
        if (name == "up") { return "ArrowUp" }
        if (name == "down") { return "ArrowDown" }
        if (name == "home") { return "Home" }
        if (name == "end") { return "End" }
        if (name == "backspace") { return "Backspace" }
        if (name == "delete") { return "Delete" }
        if (name == "enter") { return "Enter" }
        if (name == "escape") { return "Escape" }
        return ""
    }

    ; A key by the app's names. True when the editor used it.
    fn key:boolean (name:string shift:boolean ctrl:boolean) {
        ; a field of the picker
        if ((strlen cp.focused) > 0) {
            if (name == "escape") {
                cp.leaveField(picker)
                this.rebuild()
                return true
            }
            def k:string (PresChartEditor.kitKey(name))
            if ((strlen k) > 0) {
                cp.keyWith(picker k shift ctrl)
                this.takeColour((picker.hex()))
                this.rebuild()
            }
            return true
        }
        if (name == "escape") {
            wantsClose = true
            return true
        }
        if ((name == "tab") || (name == "enter")) {
            if ((strlen focusTid) > 0) {
                this.focusInput((this.nextField(focusTid shift)))
            }
            return true
        }
        if ((strlen focusTid) == 0) {
            return true
        }
        def kit:string (PresChartEditor.kitKey(name))
        if (((strlen kit) > 0) && ((kit != "ArrowUp") && (kit != "ArrowDown"))) {
            host.keyWith(kit shift ctrl)
            keep.restore()
            if ((name == "backspace") || (name == "delete")) {
                this.take()
            }
            rev = (rev + 1)
        }
        return true
    }

    fn cursorAt:string (px:double py:double) {
        if ((this.has(px py)) == false) {
            return ""
        }
        if (null? host.lastPage) {
            return "default"
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return "default"
        }
        if (win.isHandle(tid)) {
            return "move"
        }
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            if (owner.tid == picker.tid) {
                def part:string (picker.partOf(tid))
                if ((part == "f0") || ((part == "f1") || ((part == "f2") || (part == "f3")))) {
                    return "text"
                }
                if (part == "sv") {
                    return "crosshair"
                }
                return "pointer"
            }
            def asInput@(optional):InputCtl (this.inputFor(owner.tid))
            if (!null? asInput) {
                return "text"
            }
        }
        return "pointer"
    }
}
