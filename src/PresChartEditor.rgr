; ============================================================================
; PresChartEditor.rgr — the chart settings editor, in EVG controls
; ============================================================================
;
; Opened on a ```vega-lite fence: the chart's kind as a row of buttons (the
; ones the table cannot make are disabled, and say what they need), its
; title, legend and colours, and its data as a grid of fields — a header row
; naming the series, a row per category. Every change is written straight
; back into the fence (PresChartModel.toSpec), so the slide beside the editor
; is the preview and Ctrl+Z undoes a change like any other edit.
;
; The controls are gallery/ui's: ButtonCtl, InputCtl and CheckboxCtl in a
; UiHost of their own, styled by the kit's theme and the few rules in
; web/chart-editor.css. The host lays them out with the app's font measurer
; and hands back a display list the page draws over everything else; the app
; routes the pointer and the keys here while the editor is open.
; ============================================================================

Import "PresChartModel.rgr"
Import "../ui/src/UiHost.rgr"
Import "ColorPickerCtl.rgr"

class PresChartEditor {
    def host:UiHost (new UiHost())
    def model:PresChartModel (new PresChartModel())
    def css:string ""
    def isOpen:boolean false
    ; the window's top-left corner and the page it moves on, in app
    ; coordinates: the host is as big as the app, the window an overlay in it
    def x:double 0.0
    def y:double 0.0
    def w:double 1200.0
    def h:double 700.0
    def win:WindowCtl (new WindowCtl())
    def dragX:double 0.0
    def dragY:double 0.0
    def inputs:[InputCtl]
    def focusTid:string ""
    ; the model changed since the fence was last written
    def changed:boolean false
    ; set by a button that wants the editor closed, or a fresh table
    def wantsClose:boolean false
    def wantsFresh:boolean false
    def message:string ""
    def rev:int 0
    def measurer@(optional):TTFTextMeasurer
    ; the colour picker (EVGUI's ColorPickerCtl, drawn here), what it is
    ; picking for ("color" the marks, "text" the words, "" closed), and the
    ; part being dragged ("sv", "hue")
    def picker:ColorPickerCtl (new ColorPickerCtl())
    def pickFor:string ""
    def dragPart:string ""
    ; the tab showing: "kaavio", "ulkoasu", "tiedot"
    def tab:string "kaavio"

    Constructor () {
    }

    fn open:void (m:PresChartModel px:double py:double pw:double ph:double) {
        model = m
        x = px
        y = py
        w = pw
        h = ph
        isOpen = true
        wantsClose = false
        wantsFresh = false
        changed = false
        message = ""
        focusTid = ""
        this.rebuild()
    }

    fn close:void () {
        isOpen = false
        focusTid = ""
        rev = (rev + 1)
    }

    ; Inside the window (its frame as last laid out).
    fn has:boolean (px:double py:double) {
        def f:EVGElement (unwrap win.frameEl)
        if (f.calculatedWidth <= 0.0) {
            return false
        }
        return (((px >= f.calculatedX) && (px <= (f.calculatedX + f.calculatedWidth))) && ((py >= f.calculatedY) && (py <= (f.calculatedY + f.calculatedHeight))))
    }

    fn dragging:boolean () {
        return (win.dragging || ((strlen dragPart) > 0))
    }

    ; The title bar, dragged: the window moves by the pointer's delta.
    fn dragTo:void (px:double py:double) {
        if ((strlen dragPart) > 0) {
            this.pickAt(px py)
            return
        }
        if (win.dragging == false) {
            return
        }
        win.dragBy((px - dragX) (py - dragY))
        dragX = px
        dragY = py
        x = win.x
        y = win.y
        rev = (rev + 1)
    }

    fn release:void () {
        if win.dragging {
            win.release()
            rev = (rev + 1)
        }
        if ((strlen dragPart) > 0) {
            dragPart = ""
            this.rebuild()
        }
    }

    ; --- building ---------------------------------------------------------------
    fn div:EVGElement (cls:string) {
        def d (EVGElement.createDiv())
        d.className = cls
        return d
    }

    fn text:EVGElement (cls:string words:string) {
        def s (EVGElement.createSpan())
        s.className = cls
        s.textContent = words
        return s
    }

    fn put:void (c:UiCtl parent:EVGElement) {
        push host.ctls c
        parent.addChild((unwrap c.rootEl))
    }

    fn button:ButtonCtl (tid:string name:string variant:string parent:EVGElement) {
        def c (new ButtonCtl())
        c.tid = tid
        c.name = name
        c.variant = variant
        c.build()
        UiTree.addClass((unwrap c.rootEl) "ce-small")
        if (name == "×") {
            UiTree.addClass((unwrap c.rootEl) "ce-x")
        }
        this.put(c parent)
        return c
    }

    fn input:InputCtl (tid:string name:string value:string cls:string parent:EVGElement) {
        def c (new InputCtl())
        c.tid = tid
        c.name = name
        c.fontFamily = "Open Sans"
        c.fontSize = 13.0
        c.boxWidth = 80.0
        c.setValue(value)
        c.moveTo((strlen value) false)
        c.build()
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r cls)
        if (tid == focusTid) {
            UiTree.addClass(r "ce-focus")
        }
        this.put(c parent)
        push inputs c
        return c
    }

    fn check:CheckboxCtl (tid:string name:string on:boolean parent:EVGElement) {
        def c (new CheckboxCtl())
        c.tid = tid
        c.name = name
        if on {
            c.checkState = 1
        }
        c.build()
        this.put(c parent)
        return c
    }

    fn swatch:EVGElement (hex:string) {
        def d:EVGElement (this.div("ce-swatch"))
        UiTree.inline(d "background-color" hex)
        return d
    }

    ; The picker, as its demo draws it: the saturation / brightness area (a
    ; white-to-hue ramp under a clear-to-black one) with its handle, the hue
    ; bar in six ramps with its handle, the hex field and a row of presets.
    fn pickerPanel:EVGElement () {
        def c:ColorPickerCtl picker
        def panel:EVGElement (this.div("ce-picker"))
        def sv:EVGElement (this.div("cp-sv"))
        sv.id = (c.svTid())
        UiTree.inline(sv "gradient-from" "#ffffff")
        UiTree.inline(sv "gradient-to" (c.hueHex()))
        UiTree.inline(sv "gradient-dir" "1")
        def shade:EVGElement (this.div("cp-shade"))
        shade.id = ((c.svTid()) + "-shade")
        UiTree.inline(shade "gradient-from" "rgba(0, 0, 0, 0)")
        UiTree.inline(shade "gradient-to" "#000000")
        UiTree.inline(shade "gradient-dir" "0")
        sv.addChild(shade)
        def th:EVGElement (this.div("cp-thumb"))
        th.id = (c.svThumbTid())
        UiTree.inline(th "left" (((to_string (to_int ((c.sat * 240.0) - 7.0)))) + "px"))
        UiTree.inline(th "top" (((to_string (to_int (((1.0 - c.val) * 120.0) - 7.0)))) + "px"))
        UiTree.inline(th "background-color" (c.hex6()))
        sv.addChild(th)
        panel.addChild(sv)
        def hue:EVGElement (this.div("cp-hue"))
        hue.id = (c.hueTid())
        def stops:[string] (strsplit "#ff0000,#ffff00,#00ff00,#00ffff,#0000ff,#ff00ff,#ff0000" ",")
        def i:int 0
        while (i < 6) {
            def seg:EVGElement (this.div("cp-seg"))
            seg.id = ((c.hueTid()) + "-seg-" + (to_string i))
            UiTree.inline(seg "gradient-from" (itemAt stops i))
            UiTree.inline(seg "gradient-to" (itemAt stops (i + 1)))
            UiTree.inline(seg "gradient-dir" "1")
            hue.addChild(seg)
            i = (i + 1)
        }
        def ht:EVGElement (this.div("cp-hthumb"))
        ht.id = ((c.hueTid()) + "-thumb")
        UiTree.inline(ht "left" (((to_string (to_int (((c.hueFrac()) * 240.0) - 4.0)))) + "px"))
        hue.addChild(ht)
        panel.addChild(hue)
        def row:EVGElement (this.div("ce-row"))
        row.addChild((this.swatch((c.hex6()))))
        this.input("ce-hex" "Väri" (c.hex6()) "ce-cell" row)
        this.button("ce-pick-done" "OK" "primary" row)
        panel.addChild(row)
        def pre:EVGElement (this.div("ce-chips"))
        def presets:[string] (strsplit "#ffa546,#ff6b6b,#f7d154,#5ce1ff,#7c8cff,#b18cff,#4ade80,#ffffff,#94a3b8,#1f2937" ",")
        def p:int 0
        while (p < (array_length presets)) {
            def sw:EVGElement (this.swatch((itemAt presets p)))
            sw.id = ("ce-preset-" + (itemAt presets p))
            UiTree.addClass(sw "ce-preset")
            pre.addChild(sw)
            p = (p + 1)
        }
        panel.addChild(pre)
        push host.ctls picker
        return panel
    }

    ; A press or a drag on the area or the bar, as a fraction of its box.
    fn pickAt:void (px:double py:double) {
        def id:string (picker.svTid())
        if (dragPart == "hue") {
            id = (picker.hueTid())
        }
        def box@(optional):EVGElement (this.byId(id))
        if (null? box) {
            return
        }
        def b:EVGElement (unwrap box)
        if (b.calculatedWidth <= 0.0) {
            return
        }
        def fx:double ((px - b.calculatedX) / b.calculatedWidth)
        def fy:double ((py - b.calculatedY) / b.calculatedHeight)
        if (dragPart == "hue") {
            picker.setHueFrac(fx)
        } {
            picker.setSV(fx fy)
        }
        this.takeColour((picker.hex6()))
        this.rebuild()
        this.page()
    }

    fn takeColour:void (hex:string) {
        if (pickFor == "text") {
            model.textColor = hex
        } {
            model.color = hex
            model.scheme = ""
        }
        changed = true
    }

    fn byId@(optional):EVGElement (id:string) {
        def found@(optional):EVGElement
        if (null? host.lastPage) {
            return found
        }
        def hit (new EVGHitTest())
        def order:[EVGElement] (hit.paintOrder((unwrap host.lastPage)))
        def i:int 0
        while (i < (array_length order)) {
            def el:EVGElement (itemAt order i)
            if (el.id == id) {
                found = el
            }
            i = (i + 1)
        }
        return found
    }

    fn openPicker:void (what:string hex:string) {
        pickFor = what
        def start:string hex
        if ((strlen start) == 0) {
            start = "#ffa546"
            if (what == "text") {
                start = "#e7eaff"
            }
        }
        picker.setup("ce-cp" "Väri" start false)
        this.rebuild()
    }

    fn rebuild:void () {
        def fresh (new UiHost())
        host = fresh
        host.addStyleSheet(css)
        host.setTheme("dark ce")
        host.setPageSize(w h)
        def none:[InputCtl]
        inputs = none
        def page0:EVGElement (unwrap host.root)
        page0.className = "ui-root ce-page"
        def w0 (new WindowCtl())
        win = w0
        win.tid = "ce-win"
        win.name = "Kaavion asetukset"
        win.title = "Kaavion asetukset"
        win.closeLabel = "Sulje"
        win.isModal = false
        win.x = x
        win.y = y
        win.pageW = w
        win.pageH = h
        win.openWindow()
        ; the window's body is where everything below goes
        def root:EVGElement (unwrap win.bodyEl)
        root.className = "chart-ed"
        UiTree.clearChildren(root)
        this.fillBody(root)
        win.build()
        push host.ctls win
        page0.addChild((unwrap win.rootEl))
        if ((strlen focusTid) > 0) {
            host.focus(focusTid)
        }
        rev = (rev + 1)
    }

    fn fillBody:void (root:EVGElement) {
        if (model.ok == false) {
            root.addChild((this.text("ce-note" model.note)))
            root.addChild((this.text("ce-doc" "Voit aloittaa uuden taulukon: kaavion nykyinen sisältö korvataan esimerkkitaulukolla.")))
            def row0:EVGElement (this.div("ce-row"))
            this.button("ce-fresh" "Aloita taulukosta" "secondary" row0)
            this.button("ce-done" "Sulje" "secondary" row0)
            root.addChild(row0)
            return
        }

        ; the tabs: what the chart is, how it looks, what it shows
        def tabRow:EVGElement (this.div("ce-tabs"))
        def tabIds:[string] (strsplit "kaavio,ulkoasu,tiedot" ",")
        def tabNames:[string] (strsplit "Kaavio,Ulkoasu,Tiedot" ",")
        def ti:int 0
        while (ti < (array_length tabIds)) {
            def tvar:string "ghost"
            if ((itemAt tabIds ti) == tab) {
                tvar = "primary"
            }
            this.button(("ce-tab-" + (itemAt tabIds ti)) (itemAt tabNames ti) tvar tabRow)
            ti = (ti + 1)
        }
        root.addChild(tabRow)
        if (tab == "kaavio") {
            ; the kind
            root.addChild((this.text("ce-label" "Tyyppi")))
            def kinds:EVGElement (this.div("ce-chips"))
            def k:int 1
            while (k <= 20) {
                def variant:string "secondary"
                if (k == model.kind) {
                    variant = "primary"
                }
                def b:ButtonCtl (new ButtonCtl())
                b.tid = ("ce-kind-" + (to_string k))
                b.name = (PresChartModel.kindLabel(k))
                b.variant = variant
                if ((k != model.kind) && ((model.suits(k)) == false)) {
                    b.disabled = true
                }
                b.build()
                UiTree.addClass((unwrap b.rootEl) "ce-small")
                this.put(b kinds)
                k = (k + 1)
            }
            root.addChild(kinds)
            if ((model.suits(model.kind)) == false) {
                root.addChild((this.text("ce-warn" ((PresChartModel.kindLabel(model.kind)) + " tarvitsee " + (PresChartModel.kindNeeds(model.kind)) + "."))))
            }

            ; title and legend
            def tl:EVGElement (this.div("ce-row"))
            tl.addChild((this.text("ce-label" "Otsikko")))
            this.input("ce-titlein" "Otsikko" model.title "ce-wide" tl)
            def lg (new CheckboxCtl())
            lg.tid = "ce-legend"
            lg.name = "Selite"
            if model.legend {
                lg.checkState = 1
            }
            lg.build()
            this.put(lg tl)
            root.addChild(tl)

        }
        if (tab == "ulkoasu") {
            ; colours
            root.addChild((this.text("ce-label" "Värit")))
            def cols:EVGElement (this.div("ce-chips"))
            def tv:string "secondary"
            if (((strlen model.scheme) == 0) && ((strlen model.color) == 0)) {
                tv = "primary"
            }
            this.button("ce-scheme-" "Teeman" tv cols)
            def ov:string "secondary"
            if ((strlen model.color) > 0) {
                ov = "primary"
            }
            this.button("ce-pick-color" "Oma väri" ov cols)
            if ((strlen model.color) > 0) {
                cols.addChild((this.swatch(model.color)))
            }
            def names:[string] (strsplit (PresChartModel.schemes()) " ")
            def s:int 0
            while (s < (array_length names)) {
                def nm:string (itemAt names s)
                def v:string "secondary"
                if (nm == model.scheme) {
                    v = "primary"
                }
                this.button(("ce-scheme-" + nm) nm v cols)
                s = (s + 1)
            }
            root.addChild(cols)
            if (pickFor == "color") {
                root.addChild((this.pickerPanel()))
            }

            ; the words
            def tr:EVGElement (this.div("ce-row"))
            tr.addChild((this.text("ce-label" "Tekstin väri")))
            def tt:string "secondary"
            if ((strlen model.textColor) == 0) {
                tt = "primary"
            }
            this.button("ce-text-theme" "Teeman" tt tr)
            def to:string "secondary"
            if ((strlen model.textColor) > 0) {
                to = "primary"
            }
            this.button("ce-pick-text" "Oma väri" to tr)
            if ((strlen model.textColor) > 0) {
                tr.addChild((this.swatch(model.textColor)))
            }
            root.addChild(tr)
            if (pickFor == "text") {
                root.addChild((this.pickerPanel()))
            }

            ; the stage's dressing
            root.addChild((this.text("ce-label" "Tyyli diassa")))
            def ef:EVGElement (this.div("ce-chips"))
            def effects:[string] (strsplit ",flat,forge,neon,glass" ",")
            def effectNames:[string] (strsplit "Teeman,Tasainen,Ahjo,Neon,Lasi" ",")
            def e:int 0
            while (e < (array_length effects)) {
                def ev:string "secondary"
                if ((itemAt effects e) == model.effect) {
                    ev = "primary"
                }
                this.button(("ce-effect-" + (itemAt effects e)) (itemAt effectNames e) ev ef)
                e = (e + 1)
            }
            root.addChild(ef)
            def fxr:EVGElement (this.div("ce-row"))
            this.check("ce-glow" "Hehku" model.glow fxr)
            this.check("ce-shadow" "Varjo" model.shadow fxr)
            this.check("ce-gradient" "Liukuväri" model.gradient fxr)
            root.addChild(fxr)
            if ((model.kind >= 6) && (model.kind <= 9)) {
                def wr:EVGElement (this.div("ce-row"))
                wr.addChild((this.text("ce-label" "Viivan paksuus")))
                def widths:[string] (strsplit "0,1,2,3,4,6,8" ",")
                def wi:int 0
                while (wi < (array_length widths)) {
                    def wv:string (itemAt widths wi)
                    def cur:double (?? (str2double wv) 0.0)
                    def wvar:string "secondary"
                    if ((fabs (cur - model.strokeWidth)) < 0.01) {
                        wvar = "primary"
                    }
                    def label:string wv
                    if (wv == "0") {
                        label = "Oletus"
                    }
                    this.button(("ce-width-" + wv) label wvar wr)
                    wi = (wi + 1)
                }
                root.addChild(wr)
            }

        }
        if (tab == "tiedot") {
            ; the data
            root.addChild((this.text("ce-label" "Tiedot  (ensimmäinen sarake: luokat, muut: sarjat)")))
            def grid:EVGElement (this.div("ce-grid"))
            def hr:EVGElement (this.div("ce-gridrow"))
            def c:int 0
            while (c < (model.cols())) {
                this.input(("ce-h-" + (to_string c)) "Sarake" (itemAt model.header c) "ce-cell ce-head" hr)
                c = (c + 1)
            }
            this.button("ce-addcol" "+ sarja" "ghost" hr)
            grid.addChild(hr)
            def r:int 0
            while (r < (model.rows())) {
                def row:EVGElement (this.div("ce-gridrow"))
                def cc:int 0
                while (cc < (model.cols())) {
                    def cls:string "ce-cell"
                    if (cc == 0) {
                        cls = "ce-cell ce-cat"
                    }
                    this.input(("ce-c-" + (to_string r) + "-" + (to_string cc)) "Solu" (model.cell(r cc)) cls row)
                    cc = (cc + 1)
                }
                this.button(("ce-delrow-" + (to_string r)) "×" "ghost" row)
                grid.addChild(row)
                r = (r + 1)
            }
            def foot:EVGElement (this.div("ce-gridrow"))
            this.button("ce-addrow" "+ rivi" "ghost" foot)
            if ((model.cols()) > 2) {
                this.button("ce-delcol" "− viimeinen sarja" "ghost" foot)
            }
            grid.addChild(foot)
            root.addChild(grid)
            if ((strlen message) > 0) {
                root.addChild((this.text("ce-doc" message)))
            }
        }
        def bottom:EVGElement (this.div("ce-top"))
        bottom.addChild((this.text("ce-doc" "Muutokset näkyvät diassa heti. Ctrl+Z kumoaa ne ikkunan sulkemisen jälkeen.")))
        bottom.addChild((this.div("ce-grow")))
        this.button("ce-done" "Valmis" "primary" bottom)
        root.addChild(bottom)
    }

    ; --- drawing ------------------------------------------------------------------
    fn page:EVGElement () {
        def r:EVGElement (unwrap host.root)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h false)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        ; the focused field's caret where its caret is, not after the text
        def eng:EVGTextEngine (lay.getTextEngine())
        def i:int 0
        while (i < (array_length inputs)) {
            def c:InputCtl (itemAt inputs i)
            def car:EVGElement (unwrap c.caretEl)
            if (c.tid == focusTid) {
                c.ensureCaretVisible(eng)
                def box:EVGElement (unwrap c.rootEl)
                box.position = "relative"
                car.position = "absolute"
                car.left = (EVGUnit.px(((8.0 + (c.caretXAt(eng c.caret))) - c.scrollX)))
                car.top = (EVGUnit.px(7.0))
            } {
                car.width = (EVGUnit.px(0.0))
            }
            i = (i + 1)
        }
        lay.layout(pg)
        host.lastPage = pg
        return pg
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.page())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; --- input --------------------------------------------------------------------
    fn inputFor@(optional):InputCtl (tid:string) {
        def found@(optional):InputCtl
        def i:int 0
        while (i < (array_length inputs)) {
            def c:InputCtl (itemAt inputs i)
            if (c.tid == tid) {
                found = c
            }
            i = (i + 1)
        }
        return found
    }

    fn focusInput:void (tid:string) {
        def prev@(optional):InputCtl (this.inputFor(focusTid))
        if (!null? prev) {
            def pc:InputCtl (unwrap prev)
            UiTree.removeClass((unwrap pc.rootEl) "ce-focus")
        }
        focusTid = tid
        def next@(optional):InputCtl (this.inputFor(tid))
        if (!null? next) {
            def nc:InputCtl (unwrap next)
            UiTree.addClass((unwrap nc.rootEl) "ce-focus")
            nc.moveTo((strlen nc.value) false)
            host.focus(tid)
        }
        rev = (rev + 1)
    }

    ; A press in panel coordinates. What it did is in the model (and
    ; `changed`), or in `wantsClose` / `wantsFresh` for the app to act on.
    fn press:void (px:double py:double) {
        if ((this.has(px py)) == false) {
            return
        }
        if (null? host.lastPage) {
            this.page()
        }
        def tid:string (host.hitTest(px py))
        def preset:string (this.presetAt(px py))
        if ((strlen preset) > 0) {
            picker.setFromString(preset)
            this.takeColour(preset)
            this.rebuild()
            return
        }
        if ((strlen tid) == 0) {
            return
        }
        if (tid == (win.closeTid())) {
            wantsClose = true
            return
        }
        if (win.isHandle(tid)) {
            win.press(tid)
            dragX = px
            dragY = py
            rev = (rev + 1)
            return
        }
        if ((strlen pickFor) > 0) {
            if ((indexOf tid (picker.svTid())) == 0) {
                dragPart = "sv"
                this.pickAt(px py)
                return
            }
            if ((indexOf tid (picker.hueTid())) == 0) {
                dragPart = "hue"
                this.pickAt(px py)
                return
            }
        }
        ; the part of a control that was hit (a field's text, a box's tick)
        ; carries its own id: the control's is the root's
        def ctlTid:string tid
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            ctlTid = owner.tid
        }
        def asInput@(optional):InputCtl (this.inputFor(ctlTid))
        if (!null? asInput) {
            this.focusInput(ctlTid)
            return
        }
        this.act(ctlTid)
    }

    ; A preset swatch under the point (plain boxes, not controls), or "".
    fn presetAt:string (px:double py:double) {
        if (((strlen pickFor) == 0) || (null? host.lastPage)) {
            return ""
        }
        def hit (new EVGHitTest())
        def order:[EVGElement] (hit.paintOrder((unwrap host.lastPage)))
        def i:int 0
        while (i < (array_length order)) {
            def el:EVGElement (itemAt order i)
            if ((indexOf el.id "ce-preset-") == 0) {
                if (host.containsPoint(el px py)) {
                    return (substring el.id 10 (strlen el.id))
                }
            }
            i = (i + 1)
        }
        return ""
    }

    fn act:void (tid:string) {
        message = ""
        if (tid == "ce-done") {
            wantsClose = true
            return
        }
        if (tid == "ce-fresh") {
            wantsFresh = true
            return
        }
        if ((indexOf tid "ce-kind-") == 0) {
            def k:int (?? (str2int (substring tid 8 (strlen tid))) 0)
            if ((k > 0) && ((k == model.kind) || (model.suits(k)))) {
                model.kind = k
                changed = true
            } {
                message = ((PresChartModel.kindLabel(k)) + " tarvitsee " + (PresChartModel.kindNeeds(k)) + ".")
            }
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-scheme-") == 0) {
            model.scheme = (substring tid 10 (strlen tid))
            model.color = ""
            if (pickFor == "color") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-tab-") == 0) {
            tab = (substring tid 7 (strlen tid))
            focusTid = ""
            this.rebuild()
            return
        }
        if (tid == "ce-pick-color") {
            this.openPicker("color" model.color)
            return
        }
        if (tid == "ce-pick-text") {
            this.openPicker("text" model.textColor)
            return
        }
        if (tid == "ce-pick-done") {
            pickFor = ""
            focusTid = ""
            this.rebuild()
            return
        }
        if (tid == "ce-text-theme") {
            model.textColor = ""
            if (pickFor == "text") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-effect-") == 0) {
            model.effect = (substring tid 10 (strlen tid))
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-width-") == 0) {
            model.strokeWidth = (?? (str2double (substring tid 9 (strlen tid))) 0.0)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-glow") {
            model.glow = (model.glow == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-shadow") {
            model.shadow = (model.shadow == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-gradient") {
            model.gradient = (model.gradient == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-legend") {
            model.legend = (model.legend == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-addrow") {
            model.addRow()
            focusTid = ("ce-c-" + (to_string ((model.rows()) - 1)) + "-0")
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-addcol") {
            model.addCol(("Sarja " + (to_string (model.cols()))))
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-delcol") {
            model.removeCol(((model.cols()) - 1))
            focusTid = ""
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-delrow-") == 0) {
            model.removeRow((?? (str2int (substring tid 10 (strlen tid))) -1))
            focusTid = ""
            changed = true
            this.rebuild()
            return
        }
    }

    ; The focused field's text into the model.
    fn take:void () {
        def maybe@(optional):InputCtl (this.inputFor(focusTid))
        if (null? maybe) {
            return
        }
        def c:InputCtl (unwrap maybe)
        def v:string c.value
        if (focusTid == "ce-titlein") {
            model.title = v
        }
        if (focusTid == "ce-hex") {
            if (picker.setFromString(v)) {
                this.takeColour((picker.hex6()))
            }
            rev = (rev + 1)
            return
        }
        if ((indexOf focusTid "ce-h-") == 0) {
            model.setHeader((?? (str2int (substring focusTid 5 (strlen focusTid))) -1) v)
        }
        if ((indexOf focusTid "ce-c-") == 0) {
            def parts:[string] (strsplit (substring focusTid 5 (strlen focusTid)) "-")
            if ((array_length parts) == 2) {
                model.setCell((?? (str2int (itemAt parts 0)) -1) (?? (str2int (itemAt parts 1)) -1) v)
            }
        }
        changed = true
        rev = (rev + 1)
    }

    fn type:void (s:string) {
        if ((strlen focusTid) == 0) {
            return
        }
        def i:int 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            if ((ch != (strfromcode 10)) && (ch != (strfromcode 13))) {
                host.type(ch)
            }
            i = (i + 1)
        }
        this.take()
    }

    ; The fields in reading order, for Tab and Enter.
    fn nextField:string (from:string back:boolean) {
        def i:int 0
        def at:int -1
        while (i < (array_length inputs)) {
            def ci:InputCtl (itemAt inputs i)
            if (ci.tid == from) {
                at = i
            }
            i = (i + 1)
        }
        def n:int (array_length inputs)
        if (n == 0) {
            return ""
        }
        def j:int (at + 1)
        if back {
            j = (at - 1)
        }
        if (j < 0) {
            j = (n - 1)
        }
        if (j >= n) {
            j = 0
        }
        def cj:InputCtl (itemAt inputs j)
        return cj.tid
    }

    ; A key by the app's names. True when the editor used it.
    fn key:boolean (name:string shift:boolean ctrl:boolean) {
        if (name == "escape") {
            wantsClose = true
            return true
        }
        if ((name == "tab") || (name == "enter")) {
            if ((strlen focusTid) > 0) {
                this.focusInput((this.nextField(focusTid shift)))
            }
            return true
        }
        if ((strlen focusTid) == 0) {
            return true
        }
        def kit:string ""
        if (name == "left") { kit = "ArrowLeft" }
        if (name == "right") { kit = "ArrowRight" }
        if (name == "home") { kit = "Home" }
        if (name == "end") { kit = "End" }
        if (name == "backspace") { kit = "Backspace" }
        if (name == "delete") { kit = "Delete" }
        if ((strlen kit) > 0) {
            host.keyWith(kit shift ctrl)
            if ((name == "backspace") || (name == "delete")) {
                this.take()
            }
            rev = (rev + 1)
        }
        return true
    }

    fn cursorAt:string (px:double py:double) {
        if ((this.has(px py)) == false) {
            return ""
        }
        if (null? host.lastPage) {
            return "default"
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return "default"
        }
        if (win.isHandle(tid)) {
            return "move"
        }
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            def asInput@(optional):InputCtl (this.inputFor(owner.tid))
            if (!null? asInput) {
                return "text"
            }
        }
        return "pointer"
    }
}
