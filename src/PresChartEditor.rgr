; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; PresChartEditor.rgr — the chart settings window, in EVGUI controls
; ============================================================================
;
; Opened on a ```vega-lite fence. A movable window (WindowCtl) with three
; tabs (TabsCtl):
;
;   Kaavio    the size (two sliders, SliderCtl), the kind (a row of toggle
;             buttons: the ones the table cannot make are disabled and say
;             what they need), the title and the legend (SwitchCtl)
;   Ulkoasu   the colours: the theme's, a palette, or one colour from EVGUI's
;             colour picker (ColorPickerCtl, drawn by PresColorPanel as its
;             demo draws it); the text colour the same way; the stage style,
;             glow, shadow and gradient (switches) and a line's width (slider)
;   Tiedot    the data, a grid of fields: categories down the side, a column
;             per series
;
; Every change is written straight back into the fence (PresChartModel's
; toSpec), so the slide beside the window is the preview and Ctrl+Z undoes a
; change like any other edit. The controls sit in a UiHost of their own as
; big as the app; the window is an overlay in it. The host lays them out with
; the app's font measurer and hands back a display list the page draws over
; everything; the app routes the pointer and the keys here while it is open.
; The look is the EVGUI playground's: white cards, zinc greys, black primary
; (web/chart-editor.css, over the kit's theme).
; ============================================================================

Import "PresChartModel.rgr"
Import "PresImageModel.rgr"
Import "PresFlowModel.rgr"
Import "PresGridModel.rgr"
Import "PresDocSettings.rgr"
Import "PresTraceSettings.rgr"
Import "PresColorPanel.rgr"
Import "../evgui/src/UiHost.rgr"
Import "PresKeep.rgr"
Import "PresI18n.rgr"

class PresChartEditor {
    def host:UiHost (new UiHost())
    def model:PresChartModel (new PresChartModel())
    def css:string ""
    ; The editor's skin ("" or "retro"): a theme name added to this host's own.
    def skin:string ""
    def isOpen:boolean false
    ; the window's top-left corner and the page it moves on (the app's), in
    ; app coordinates
    def x:double 0.0
    def y:double 0.0
    def w:double 1200.0
    def h:double 700.0
    def win:WindowCtl (new WindowCtl())
    def tabs:TabsCtl (new TabsCtl())
    def tab:string "kaavio"
    def dragX:double 0.0
    def dragY:double 0.0
    ; A finger (the page says so before each press): a press on the window's
    ; body waits to see whether it is a tap or the start of a scroll
    ; (WindowCtl's `beginPan`). A tap is pressed when the finger lifts.
    def touch:boolean false
    def tapping:boolean false
    ; the field last scrolled into sight (`page`): Tab to one below the fold
    ; brings it up once, not on every frame
    def revealed:string ""
    def inputs:[InputCtl]
    ; the fields of the card before the last rebuild (inputWith keeps their caret)
    def before:[InputCtl]
    def sliders:[SliderCtl]
    ; the window's dropdowns, and the one whose list is open ("" none)
    def sels:[SelectCtl]
    def openSel:string ""
    def focusTid:string ""
    ; the model changed since the fence was last written
    def changed:boolean false
    ; set by a control that wants the editor closed, or a fresh table
    def wantsClose:boolean false
    def wantsFresh:boolean false
    ; the chart's data file, asked to be opened in the files tab
    def wantsFile:string ""
    ; The same window for a picture's settings: `mode` "image", the picture
    ; in `img`. A picture asked to become a background ("slide", "all") or
    ; to be taken out goes to the app, which owns the Markdown and the theme.
    def mode:string "chart"
    def img:PresImageModel (new PresImageModel())
    def wantsBg:string ""
    def wantsRemove:boolean false
    def message:string ""
    def rev:int 0
    def keep:PresKeep (new PresKeep())
    def measurer@(optional):TTFTextMeasurer
    ; the colour picker, what it picks for ("color" the marks, "text" the
    ; words, "" closed) and the part being dragged ("sv", "hue", "alpha")
    def picker:ColorPickerCtl (new ColorPickerCtl())
    def cp:PresColorPanel (new PresColorPanel())
    def pickFor:string ""
    def dragPart:string ""
    ; a slider being dragged, by its host
    def sliding:boolean false
    ; A picture pasted or dropped (`mode` "paste"): the part of it to keep
    ; (CropCtl) and where it goes ("slide", "bg-slide", "bg-all"). `pasteShape`
    ; is the crop's aspect ("free", "slide", "4:3", "1:1"); `pasteNote` says
    ; where the picture is kept. Add sets `wantsPlace` and closes.
    def crop:CropCtl (new CropCtl())
    def pasteTo:string "slide"
    def pasteShape:string "free"
    def pasteAlt:string ""
    def pasteNote:string ""
    def slideAspect:double 1.7777777
    def wantsPlace:boolean false
    ; Add and vectorize: placed, then opened in the vectorizer
    def pasteTrace:boolean false
    ; the picture on its way in is flat (few colours: a drawing, a logo, a
    ; chart, a screenshot — the page measures it): vectorizing is what
    ; Add (and Enter) does, since an SVG stays sharp on any screen
    def pasteVector:boolean false
    ; A picture of the deck's files edited where it is kept (`mode`
    ; "adjust"): the part to keep (`crop`, as for a paste) and its colours,
    ; each -100…100 with 0 leaving it as it is. The page draws the preview
    ; (the crop's picture, registered again as the sliders move: `adjDirty`)
    ; and on Save (`wantsSave`) writes the picture back over `adjFile`, so
    ; every slide that shows it changes.
    def adjFile:string ""
    def adjBright:int 0
    def adjContrast:int 0
    def adjSat:int 0
    def adjTemp:int 0
    def adjTint:int 0
    def adjDirty:boolean false
    ; what the page measured on the slide drawn with the preview: the
    ; contrast of its text over the picture ("" not measured yet), and
    ; whether a run is too faint
    def adjContrastNote:string ""
    def adjContrastBad:boolean false
    def wantsSave:boolean false
    ; Edit image's "Vectorize…": the window closes and the page opens the
    ; picture in the vectorizer
    def wantsTrace:boolean false
    ; A picture of the files traced into vectors (`mode` "trace"): the
    ; settings (PresTraceSettings), the picture as the page registered it
    ; (`trOrig`) and the last trace (`trPreview`, "" before the first), what
    ; that trace made (`trInfo`) or why it failed (`trErr`). A change sets
    ; `trDirty`; the page traces again when no slider is held. Save
    ; (`wantsTraceSave`) keeps the SVG beside the picture and, with
    ; `trReplace`, points the picture's `trUses` uses at it.
    def trFile:string ""
    def trOrig:string ""
    def trPreview:string ""
    def trW:double 0.0
    def trH:double 0.0
    def trSet:PresTraceSettings (new PresTraceSettings())
    def trShow:string "traced"
    def trTab:string "colors"
    def trInfo:string ""
    def trErr:string ""
    def trBusy:boolean false
    def trDirty:boolean false
    def trReplace:boolean true
    def trUses:int 0
    ; the SVG traced again (Edit on an SVG of the files): Save writes over
    ; it; "" a new SVG beside the picture
    def trTarget:string ""
    def wantsTraceSave:boolean false
    ; A new presentation (`mode` "newdeck"): its name, theme and what data it
    ; starts with ("none", "sample" a chart with a sample table, "file" a
    ; data file picked after it is made). `ndRows` are the page's themes,
    ; "value<TAB>label" lines; `ndTab` the tab showing. Create sets
    ; `wantsCreate` and closes; Cancel and Esc only close.
    def ndName:string ""
    def ndTheme:string ""
    def ndRows:string ""
    def ndData:string "none"
    def ndTab:string "name"
    def wantsCreate:boolean false
    ; File → Duplicate asks only the copy's name: `ndDup` hides the theme and
    ; data tabs, the name starts as the page's suggestion, all selected
    def ndDup:boolean false
    ; ...the same window asking one's own name for editing together ("name"),
    ; or a room's name and description ("room")
    def ndAsk:string ""
    ; The room's window: `rmId` "" for a new room; `rmState` "new", "made" or
    ; "archived"; `ndDesc` its description. Archive and Delete set `rmAct`
    ; and answer as Save does ("newdeck-create", the plan's "act").
    def rmId:string ""
    def rmState:string ""
    def ndDesc:string ""
    def rmAct:string ""
    ; A question before something that cannot be undone (`mode` "confirm"):
    ; `cfKey` names it to the page, `cfOk` is the red button's word. The red
    ; button sets `wantsConfirm` and closes; Cancel and Esc only close. With
    ; no `cfOk` it only tells (Help → About): its lines and OK.
    def cfKey:string ""
    def cfTitle:string ""
    def cfText:string ""
    def cfOk:string ""
    def wantsConfirm:boolean false
    ; A question with two answers rather than a warning (`cfAlt` is the
    ; other one's word): `ok` is then the main button, not a red one, and the
    ; other sets `wantsAlt` ("confirm:<key>:alt" to the page).
    def cfAlt:string ""
    def wantsAlt:boolean false
    ; The document's settings (`mode` "docset"): the front matter's title,
    ; transition, header and footer (`ds`), the tab showing ("header",
    ; "footer", "deck") and the deck's pictures, for a logo. Every change is
    ; written into the front matter as it is made.
    def ds:PresDocSettings (new PresDocSettings())
    ; the document's own settings (its title) first
    def dsTab:string "deck"
    def dsPics:[string]
    ; the theme's background picture for every slide (page's
    ; background-image, "" none), and what the Background tab asked the app
    ; to do with it: "set:<path>", "none", "edit", "trace" ("" nothing)
    def dsBg:string ""
    def dsBgAct:string ""
    ; the presentation's home room (ADR 0001), as the page gave the rooms
    ; (setDocRooms): their ids and names, the one it is in, a note in place
    ; of the list ("" none), and the room chosen here for the app to move it
    ; to ("" nothing asked)
    def dsRoomIds:[string]
    def dsRoomNames:[string]
    def dsRoom:string ""
    def dsRoomNote:string ""
    def dsRoomAct:string ""
    ; a field (or a text) whose text is being selected by a drag, by its tid
    def selecting:string ""
    ; Text that can be selected and copied (EVGUI TextCtl): the About lines,
    ; notes and errors, a picture's or a data file's name. A rebuild makes
    ; new ones and keeps what was selected in the one before with the same
    ; id and text.
    def texts:[TextCtl]
    def textsBefore:[TextCtl]
    ; A diagram (`mode` "diagram") and a table (`mode` "grid"): the block
    ; as its model, written back into the Markdown at every change. The
    ; tab showing, the page of a long list (eight to a page), the box, link
    ; or column the shape, line and alignment buttons are for, and the new
    ; link's fields. "Edit as text" (`wantsText`) closes the window with the
    ; block selected in the editor.
    def flow:PresFlowModel (new PresFlowModel())
    def grid:PresGridModel (new PresGridModel())
    def deTab:string "diagram"
    def listPage:int 0
    def selNode:string ""
    def selEdge:int -1
    def selCol:int 0
    def linkFrom:string ""
    def linkTo:string ""
    def linkLabel:string ""
    def wantsText:boolean false

    Constructor () {
    }

    fn openImage:void (m:PresImageModel px:double py:double pw:double ph:double) {
        mode = "image"
        img = m
        wantsBg = ""
        wantsRemove = false
        this.openAt(px py pw ph)
    }

    ; A picture that is not in the Markdown yet: `path` is where the page
    ; registered it for drawing, `pw` × `ph` its pixels.
    fn openPaste:void (path:string iw:double ih:double alt:string note:string aspect:double px:double py:double pw:double ph:double) {
        mode = "paste"
        def c (new CropCtl())
        crop = c
        crop.tid = "pe-crop"
        crop.name = (PresI18n.t("Crop image"))
        crop.maxW = 528.0
        crop.maxH = 300.0
        crop.setImage(path iw ih)
        pasteTo = "slide"
        pasteShape = "free"
        pasteAlt = alt
        pasteNote = note
        if (aspect > 0.0) {
            slideAspect = aspect
        }
        wantsPlace = false
        pasteTrace = false
        pasteVector = false
        this.openAt(px py pw ph)
    }

    ; A picture in the files tab: `path` is its preview as the page
    ; registered it, `file` the file it is kept in, `iw` × `ih` its pixels.
    fn openAdjust:void (path:string file:string iw:double ih:double px:double py:double pw:double ph:double) {
        mode = "adjust"
        def c (new CropCtl())
        crop = c
        crop.tid = "pe-crop"
        crop.name = (PresI18n.t("Crop image"))
        crop.maxW = 528.0
        crop.maxH = 260.0
        crop.setImage(path iw ih)
        adjFile = file
        adjContrastNote = ""
        adjContrastBad = false
        this.adjustZero()
        adjDirty = false
        wantsSave = false
        wantsTrace = false
        this.openAt(px py pw ph)
    }

    fn adjustZero:void () {
        adjBright = 0
        adjContrast = 0
        adjSat = 0
        adjTemp = 0
        adjTint = 0
    }

    ; the crop is the picture's: a paste's or an edited file's
    fn cropping:boolean () {
        return ((mode == "paste") || (mode == "adjust"))
    }

    fn openNewDeck:void (rows:string theme:string name:string px:double py:double pw:double ph:double) {
        mode = "newdeck"
        ndRows = rows
        ndTheme = theme
        ndName = name
        ndData = "none"
        ndTab = "name"
        ndDup = false
        ndAsk = ""
        wantsCreate = false
        this.openAt(px py pw ph)
        this.focusInput("nd-name")
    }

    fn openDupDeck:void (name:string px:double py:double pw:double ph:double) {
        mode = "newdeck"
        ndRows = ""
        ndTheme = ""
        ndName = name
        ndData = "none"
        ndTab = "name"
        ndDup = true
        ndAsk = "dup"
        wantsCreate = false
        this.openAt(px py pw ph)
        this.focusInput("nd-name")
        this.selectAllInField()
    }

    ; Rooms' "+" (no `id`) or a room's gear: its name and description, and
    ; for a room that is there, Archive (or Restore) and Delete.
    fn openRoom:void (id:string state:string name:string desc:string px:double py:double pw:double ph:double) {
        this.openDupDeck(name px py pw ph)
        ndAsk = "room"
        rmId = id
        rmState = state
        ndDesc = desc
        rmAct = ""
        this.rebuild()
    }

    ; Editing together: the name the others see, all selected.
    fn openAskName:void (name:string px:double py:double pw:double ph:double) {
        this.openDupDeck(name px py pw ph)
        ndAsk = "name"
        this.rebuild()
    }

    fn openDocSet:void (d:PresDocSettings pics:[string] px:double py:double pw:double ph:double) {
        mode = "docset"
        ds = d
        dsPics = pics
        def ni:[string]
        dsRoomIds = ni
        def nn:[string]
        dsRoomNames = nn
        dsRoom = ""
        dsRoomNote = ""
        dsRoomAct = ""
        this.openAt(px py pw ph)
    }

    ; The rooms the presentation can be in: `rows` one "id\tname" a line,
    ; `current` the one it is in; `note` instead of the list when it cannot
    ; be moved (not kept yet).
    fn setDocRooms:void (rows:string current:string note:string) {
        def ids:[string]
        def names:[string]
        def lines:[string] (strsplit rows "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def parts:[string] (strsplit (itemAt lines i) "\t")
            if (((array_length parts) >= 2) && ((strlen (itemAt parts 0)) > 0)) {
                push ids (itemAt parts 0)
                push names (itemAt parts 1)
            }
            i = (i + 1)
        }
        dsRoomIds = ids
        dsRoomNames = names
        dsRoom = current
        dsRoomNote = note
        if (isOpen && (mode == "docset")) {
            this.rebuild()
        }
    }

    fn openConfirm:void (key:string title:string words:string ok:string px:double py:double pw:double ph:double) {
        mode = "confirm"
        cfKey = key
        cfTitle = title
        cfText = words
        cfOk = ok
        cfAlt = ""
        wantsConfirm = false
        wantsAlt = false
        this.openAt(px py pw ph)
    }

    fn openDiagram:void (m:PresFlowModel px:double py:double pw:double ph:double) {
        mode = "diagram"
        flow = m
        deTab = "diagram"
        this.resetLists()
        this.openAt(px py pw ph)
    }

    fn openGrid:void (m:PresGridModel px:double py:double pw:double ph:double) {
        mode = "grid"
        grid = m
        this.resetLists()
        this.openAt(px py pw ph)
    }

    fn resetLists:void () {
        listPage = 0
        selNode = ""
        selEdge = -1
        selCol = 0
        linkFrom = ""
        linkTo = ""
        linkLabel = ""
        wantsText = false
    }

    fn open:void (m:PresChartModel px:double py:double pw:double ph:double) {
        mode = "chart"
        model = m
        this.openAt(px py pw ph)
    }

    fn openAt:void (px:double py:double pw:double ph:double) {
        x = px
        y = py
        w = pw
        h = ph
        ; a window opened starts at its top
        win.scroll.reset()
        revealed = ""
        isOpen = true
        wantsClose = false
        wantsFresh = false
        changed = false
        message = ""
        focusTid = ""
        pickFor = ""
        this.rebuild()
    }

    fn close:void () {
        isOpen = false
        focusTid = ""
        rev = (rev + 1)
    }

    ; Inside the window (its frame as last laid out).
    fn has:boolean (px:double py:double) {
        if ((strlen pickFor) > 0) {
            def pc@(optional):EVGElement (this.cardEl())
            if (!null? pc) {
                def c:EVGElement (unwrap pc)
                if ((((px >= c.calculatedX) && (px <= (c.calculatedX + c.calculatedWidth))) && ((py >= c.calculatedY) && (py <= (c.calculatedY + c.calculatedHeight))))) {
                    return true
                }
            }
        }
        def f:EVGElement (unwrap win.frameEl)
        if (f.calculatedWidth <= 0.0) {
            return false
        }
        return (((px >= f.calculatedX) && (px <= (f.calculatedX + f.calculatedWidth))) && ((py >= f.calculatedY) && (py <= (f.calculatedY + f.calculatedHeight))))
    }

    fn cardEl@(optional):EVGElement () {
        def none@(optional):EVGElement
        def r:EVGElement (unwrap host.root)
        def i:int 0
        while (i < (r.getChildCount())) {
            def k:EVGElement (r.getChild(i))
            if (k.id == "ce-pickcard") {
                def hit@(optional):EVGElement k
                return hit
            }
            i = (i + 1)
        }
        return none
    }

    fn dragging:boolean () {
        return (((((win.dragging || (win.panning())) || sliding) || ((strlen dragPart) > 0)) || ((this.cropping()) && (crop.dragging()))) || ((strlen selecting) > 0)))
    }

    ; A point as fractions of the crop's rectangle, as last laid out.
    fn cropFx:double (px:double) {
        def r:EVGElement (unwrap crop.rootEl)
        if (r.calculatedWidth <= 0.0) {
            return 0.0
        }
        return ((px - r.calculatedX) / r.calculatedWidth)
    }

    fn cropFy:double (py:double) {
        def r:EVGElement (unwrap crop.rootEl)
        if (r.calculatedHeight <= 0.0) {
            return 0.0
        }
        return ((py - r.calculatedY) / r.calculatedHeight)
    }

    fn dragTo:void (px:double py:double) {
        if (win.panning()) {
            if (win.panTo(py)) {
                rev = (rev + 1)
            }
            return
        }
        if ((strlen selecting) > 0) {
            this.selectTo(px py)
            return
        }
        if ((this.cropping()) && (crop.dragging())) {
            crop.dragAt((this.cropFx(px)) (this.cropFy(py)))
            rev = (rev + 1)
            return
        }
        if (dragPart == "field") {
            cp.dragField(picker px)
            rev = (rev + 1)
            return
        }
        if ((strlen dragPart) > 0) {
            this.pickAt(px py)
            return
        }
        if sliding {
            host.pointerMove(px py)
            keep.restore()
            this.takeSliders()
            rev = (rev + 1)
            return
        }
        if (win.dragging == false) {
            return
        }
        win.dragBy((px - dragX) (py - dragY))
        dragX = px
        dragY = py
        x = win.x
        y = win.y
        if ((strlen pickFor) > 0) {
            def c@(optional):EVGElement (this.cardEl())
            if (!null? c) {
                def ce:EVGElement (unwrap c)
                def px2:double ((x + 560.0) + 12.0)
                if ((px2 + 280.0) > w) {
                    px2 = ((x - 280.0) - 12.0)
                }
                ce.overlayX = px2
                ce.overlayY = (y + 44.0)
            }
        }
        rev = (rev + 1)
    }

    ; True when the finger lifted was a tap, pressed now: the page then
    ; does what it does after a press.
    fn release:boolean () {
        if (win.panning()) {
            if ((win.endPan()) == false) {
                rev = (rev + 1)
                return false
            }
            def sc:UiScroll win.scroll
            tapping = true
            this.press(sc.downX sc.downY sc.clicks sc.shift)
            tapping = false
            this.release()
            return true
        }
        if ((strlen selecting) > 0) {
            def maybe@(optional):InputCtl (this.inputFor(selecting))
            if (!null? maybe) {
                def c:InputCtl (unwrap maybe)
                c.pointerUp()
            }
            host.textRelease()
            selecting = ""
            rev = (rev + 1)
        }
        if ((this.cropping()) && (crop.dragging())) {
            crop.release()
            rev = (rev + 1)
        }
        if win.dragging {
            win.release()
            rev = (rev + 1)
        }
        if sliding {
            sliding = false
            host.pointerUp()
            keep.restore()
            this.takeSliders()
            this.rebuild()
        }
        if ((strlen dragPart) > 0) {
            if (dragPart == "field") {
                cp.releaseField(picker)
            }
            dragPart = ""
            this.rebuild()
        }
        return false
    }

    ; The wheel over the window: its body scrolls.
    fn wheel:boolean (dy:double) {
        if (win.scrollBody(dy)) {
            rev = (rev + 1)
            return true
        }
        return false
    }

    ; Where a finger on the body scrolls it rather than working the control
    ; under it: anything but a field (its caret and selection), a slider, the
    ; crop and the colour picker, which all take a drag of their own.
    fn pansAt:boolean (px:double py:double) {
        if ((win.overBody(px py)) == false) {
            return false
        }
        def tid:string (host.hitTest(px py))
        def ctlTid:string tid
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            ctlTid = owner.tid
        }
        if (!null? (this.inputFor(ctlTid))) {
            return false
        }
        if (PresChartEditor.isSlider(ctlTid)) {
            return false
        }
        if ((this.cropping()) && (ctlTid == crop.tid)) {
            return false
        }
        if (((strlen pickFor) > 0) && (ctlTid == picker.tid)) {
            return false
        }
        return true
    }

    ; --- building ---------------------------------------------------------------
    fn div:EVGElement (cls:string) {
        def d (EVGElement.createDiv())
        d.className = cls
        return d
    }

    fn text:EVGElement (cls:string words:string) {
        def s (EVGElement.createSpan())
        s.className = cls
        s.textContent = words
        return s
    }

    ; A text the reader can select and copy (TextCtl `selectable`).
    fn copyable:EVGElement (tid:string cls:string words:string) {
        def c:TextCtl (TextCtl.make(tid words cls))
        c.selectable = true
        def i:int 0
        while (i < (array_length textsBefore)) {
            def old:TextCtl (itemAt textsBefore i)
            if ((old.tid == tid) && (old.text == words)) {
                c.sel.anchor = old.sel.anchor
                c.sel.caret = old.sel.caret
            }
            i = (i + 1)
        }
        c.build()
        push host.ctls c
        push texts c
        return (unwrap c.rootEl)
    }

    fn textFor@(optional):TextCtl (tid:string) {
        def found@(optional):TextCtl
        def i:int 0
        while (i < (array_length texts)) {
            def c:TextCtl (itemAt texts i)
            if (c.tid == tid) {
                found = c
            }
            i = (i + 1)
        }
        return found
    }

    ; What Ctrl+C copies from the window: the focused field's selection,
    ; else what was selected in a text.
    fn copyText:string () {
        def f@(optional):InputCtl (this.inputFor(focusTid))
        if (!null? f) {
            def fc:InputCtl (unwrap f)
            def t:string (fc.selectedText())
            if ((strlen t) > 0) {
                return t
            }
        }
        return (host.copyText())
    }

    fn put:void (c:UiCtl parent:EVGElement) {
        push host.ctls c
        parent.addChild((unwrap c.rootEl))
    }

    fn button:ButtonCtl (tid:string name:string variant:string parent:EVGElement) {
        def c (new ButtonCtl())
        c.tid = tid
        c.name = name
        c.variant = variant
        c.build()
        this.dressButton(c)
        this.put(c parent)
        return c
    }

    ; The label is its own text node and takes no colour from the button, so
    ; a black button says so to its label.
    fn dressButton:void (c:ButtonCtl) {
        def r:EVGElement (unwrap c.rootEl)
        UiTree.addClass(r "ce-small")
        if (((c.variant == "primary") || (c.variant == "danger")) && ((r.getChildCount()) > 0)) {
            UiTree.addClass((r.getChild(0)) "ce-onprimary")
        }
    }

    ; A dropdown of `values` named by `names`. Choosing one acts as the chip
    ; `tid + "-" + value` would (`act`), so a list of chips becomes a
    ; dropdown without a second path for what it does.
    fn dropdown:SelectCtl (tid:string name:string value:string values:[string] names:[string] parent:EVGElement) {
        def c (new SelectCtl())
        c.tid = tid
        c.name = name
        def i:int 0
        while (i < (array_length values)) {
            c.addItem((itemAt values i) (itemAt names i) false)
            i = (i + 1)
        }
        c.value = value
        if (openSel == tid) {
            c.openList()
        }
        c.build()
        UiTree.addClass((unwrap c.rootEl) "ce-select")
        push sels c
        this.put(c parent)
        return c
    }

    fn selFor@(optional):SelectCtl (tid:string) {
        def found@(optional):SelectCtl
        def i:int 0
        while (i < (array_length sels)) {
            def c:SelectCtl (itemAt sels i)
            if (c.tid == tid) {
                found = c
            }
            i = (i + 1)
        }
        return found
    }

    ; A press on a dropdown: its list opens or closes, or an item is chosen
    ; and acted on. Any other press closes an open list (and is not taken).
    fn pressSelect:boolean (ctlTid:string tid:string) {
        def asSel@(optional):SelectCtl (this.selFor(ctlTid))
        if (!null? asSel) {
            def sel:SelectCtl (unwrap asSel)
            if ((strlen focusTid) > 0) {
                this.focusInput("")
            }
            def was:string sel.value
            host.click(tid)
            keep.restore()
            if (sel.value != was) {
                openSel = ""
                this.act((sel.tid + "-" + sel.value))
                this.rebuild()
                return true
            }
            openSel = (? sel.open sel.tid "")
            this.rebuild()
            return true
        }
        if ((strlen openSel) > 0) {
            openSel = ""
            this.rebuild()
            return true
        }
        return false
    }

    ; A toggle among others: the pressed one is the primary.
    fn chip:ButtonCtl (tid:string name:string on:boolean parent:EVGElement) {
        def v:string "outline"
        if on {
            v = "primary"
        }
        def c:ButtonCtl (this.button(tid name v parent))
        UiTree.addClass((unwrap c.rootEl) "ce-chip")
        return c
    }

    fn input:InputCtl (tid:string name:string value:string cls:string parent:EVGElement) {
        return this.inputWith(tid name value "" cls parent)
    }

    fn inputWith:InputCtl (tid:string name:string value:string hint:string cls:string parent:EVGElement) {
        def c (new InputCtl())
        c.tid = tid
        c.name = name
        c.placeholder = hint
        ; the wide fields (names, titles, descriptions) have a clear button
        c.clearable = (cls == "ce-wide")
        c.clearLabel = (PresI18n.t("Clear"))
        c.focused = (tid == focusTid)
        c.boxClass = cls
        c.setValue(value)
        c.moveTo((strlen value) false)
        ; the same field before this rebuild: its caret and selection stay
        def i:int 0
        while (i < (array_length before)) {
            def o:InputCtl (itemAt before i)
            if ((o.tid == tid) && (o.value == value)) {
                c.anchor = o.anchor
                c.caret = o.caret
                c.scrollX = o.scrollX
            }
            i = (i + 1)
        }
        c.build()
        this.put(c parent)
        push inputs c
        return c
    }

    fn switchOf:SwitchCtl (tid:string name:string on:boolean parent:EVGElement) {
        def c (new SwitchCtl())
        c.tid = tid
        c.name = name
        if on {
            c.checkState = 1
        }
        c.build()
        this.put(c parent)
        return c
    }

    fn slider:SliderCtl (tid:string name:string v:int lo:int hi:int st:int parent:EVGElement) {
        def c (new SliderCtl())
        c.tid = tid
        c.name = name
        c.minValue = lo
        c.maxValue = hi
        c.step = st
        c.value = v
        c.build()
        UiTree.addClass((unwrap c.rootEl) "ce-slider")
        this.put(c parent)
        push sliders c
        return c
    }

    fn swatch:EVGElement (hex:string) {
        def d:EVGElement (this.div("ce-swatch"))
        UiTree.inline(d "background-color" hex)
        return d
    }

    ; A labelled row: the words on the left, the control on the right.
    fn field:EVGElement (label:string) {
        def r:EVGElement (this.div("ce-field"))
        r.addChild((this.text("ce-flabel" label)))
        return r
    }

    fn section:EVGElement (root:EVGElement title:string) {
        root.addChild((this.text("ce-section" title)))
        def s:EVGElement (this.div("ce-group"))
        root.addChild(s)
        return s
    }

    fn rebuild:void () {
        def fresh (new UiHost())
        host = fresh
        host.addStyleSheet(css)
        host.setTheme((trim ("ce " + skin)))
        host.setPageSize(w h)
        before = inputs
        def none:[InputCtl]
        inputs = none
        textsBefore = texts
        def noTexts:[TextCtl]
        texts = noTexts
        def noSliders:[SliderCtl]
        sliders = noSliders
        def noSels:[SelectCtl]
        sels = noSels
        def page0:EVGElement (unwrap host.root)
        page0.className = "ui-root ce-page"
        def w0 (new WindowCtl())
        ; the rebuilt window stays scrolled where it was, a finger on it
        ; included
        def sc:UiScroll win.scroll
        def chrome:double win.chromeH
        win = w0
        win.tid = "ce-win"
        win.name = (PresI18n.t("Chart settings"))
        win.title = (PresI18n.t("Chart settings"))
        if (mode == "image") {
            win.name = (PresI18n.t("Image settings"))
            win.title = (PresI18n.t("Image settings"))
        }
        if (mode == "paste") {
            win.name = (PresI18n.t("Add image"))
            win.title = (PresI18n.t("Add image"))
        }
        if (mode == "adjust") {
            win.name = (PresI18n.t("Edit image"))
            win.title = (PresI18n.t("Edit image"))
        }
        if (mode == "trace") {
            win.name = (PresI18n.t("Vectorize image"))
            win.title = win.name
        }
        if (mode == "newdeck") {
            win.name = (PresI18n.t("New presentation"))
            if ndDup {
                win.name = (PresI18n.t("Duplicate presentation"))
            }
            if (ndAsk == "name") {
                win.name = (PresI18n.t("Your name"))
            }
            if (ndAsk == "room") {
                win.name = (PresI18n.t("New room"))
                if ((strlen rmId) > 0) {
                    win.name = (PresI18n.t("Room settings"))
                }
            }
            win.title = win.name
        }
        if (mode == "docset") {
            win.name = (PresI18n.t("Document settings"))
            win.title = (PresI18n.t("Document settings"))
        }
        if (mode == "confirm") {
            win.name = cfTitle
            win.title = cfTitle
        }
        if (mode == "diagram") {
            win.name = (PresI18n.t("Diagram"))
            win.title = win.name
        }
        if (mode == "grid") {
            win.name = (PresI18n.t("Table"))
            win.title = win.name
        }
        win.closeLabel = (PresI18n.t("Close"))
        win.isModal = false
        win.x = x
        win.y = y
        win.pageW = w
        win.pageH = h
        win.openWindow()
        win.scroll = sc
        win.chromeH = chrome
        def body:EVGElement (unwrap win.bodyEl)
        body.className = "ce-body"
        UiTree.clearChildren(body)
        this.fillBody(body)
        win.build()
        push host.ctls win
        page0.addChild((unwrap win.rootEl))
        if ((strlen pickFor) > 0) {
            page0.addChild((this.pickerCard()))
        }
        if ((strlen focusTid) > 0) {
            host.focus(focusTid)
        }
        keep.remember(host)
        rev = (rev + 1)
    }

    fn fillBody:void (root:EVGElement) {
        if (mode == "diagram") {
            this.diagramBody(root)
            return
        }
        if (mode == "grid") {
            this.gridBody(root)
            return
        }
        if (mode == "confirm") {
            this.confirmBody(root)
            return
        }
        if (mode == "newdeck") {
            this.newDeckBody(root)
            return
        }
        if (mode == "docset") {
            this.docSetBody(root)
            return
        }
        if (mode == "paste") {
            this.pasteBody(root)
            return
        }
        if (mode == "adjust") {
            this.adjustBody(root)
            return
        }
        if (mode == "trace") {
            this.traceBody(root)
            return
        }
        if (mode == "image") {
            this.imageBody(root)
            return
        }
        if (model.ok == false) {
            root.addChild((this.copyable("ce-t-note" "ce-note" model.note)))
            root.addChild((this.text("ce-doc" (PresI18n.t("You can start a new table: the chart's current content is replaced with a sample table.")))))
            def row0:EVGElement (this.div("ce-row"))
            this.button("ce-fresh" (PresI18n.t("Start from a table")) "primary" row0)
            this.button("ce-done" (PresI18n.t("Close")) "outline" row0)
            root.addChild(row0)
            return
        }
        ; the tabs
        def t0 (new TabsCtl())
        tabs = t0
        tabs.tid = "ce-tabs"
        tabs.name = (PresI18n.t("Chart settings"))
        tabs.addItem("kaavio" (PresI18n.t("Chart")) "" false)
        tabs.addItem("ulkoasu" (PresI18n.t("Appearance")) "" false)
        tabs.addItem("tiedot" (PresI18n.t("Data")) "" false)
        tabs.value = tab
        tabs.build()
        UiTree.addClass((unwrap tabs.rootEl) "ce-tabs")
        this.put(tabs root)

        def pane:EVGElement (this.div("ce-pane"))
        if (tab == "kaavio") {
            this.chartTab(pane)
        }
        if (tab == "ulkoasu") {
            this.looksTab(pane)
        }
        if (tab == "tiedot") {
            this.dataTab(pane)
        }
        root.addChild(pane)

        def bottom:EVGElement (this.div("ce-foot"))
        def note:string (PresI18n.t("Changes show on the slide right away. Ctrl+Z undoes them after you close the window."))
        if ((strlen message) > 0) {
            note = message
        }
        bottom.addChild((this.copyable("ce-t-msg" "ce-doc" note)))
        bottom.addChild((this.div("ce-grow")))
        this.button("ce-done" (PresI18n.t("Done")) "primary" bottom)
        root.addChild(bottom)
    }

    ; --- a picture ---------------------------------------------------------------
    fn imageBody:void (root:EVGElement) {
        def pane:EVGElement (this.div("ce-pane"))
        root.addChild(pane)
        pane.addChild((this.copyable("ce-t-path" "ce-doc" img.path)))
        def size:EVGElement (this.section(pane (PresI18n.t("Size"))))
        def wp:int (PresImageModel.percent(img.width))
        def wr:EVGElement (this.field((PresI18n.t("Width"))))
        def wv:int wp
        if (wv <= 0) {
            wv = 100
        }
        this.slider("ie-width" (PresI18n.t("Width")) wv 10 100 5 wr)
        def wl:string ((to_string wp) + " %")
        if ((strlen img.width) == 0) {
            wl = (PresI18n.t("original size"))
        } {
            if (wp <= 0) {
                wl = img.width
            }
        }
        wr.addChild((this.text("ce-value" wl)))
        size.addChild(wr)
        def hp:int (PresImageModel.percent(img.height))
        def hr:EVGElement (this.field((PresI18n.t("Height"))))
        this.slider("ie-height" (PresI18n.t("Height")) hp 0 100 5 hr)
        def hl:string ((to_string hp) + (PresI18n.t(" % of the slide")))
        if ((strlen img.height) == 0) {
            hl = (PresI18n.t("fits the slide"))
        } {
            if (hp <= 0) {
                hl = img.height
            }
        }
        hr.addChild((this.text("ce-value" hl)))
        size.addChild(hr)
        def nr:EVGElement (this.div("ce-row"))
        this.button("ie-natural" (PresI18n.t("Original size")) "outline" nr)
        size.addChild(nr)
        size.addChild((this.text("ce-doc" (PresI18n.t("The image keeps its proportions: width is a share of the column width, height of the slide content height, and the smaller one wins.")))))

        def place:EVGElement (this.section(pane (PresI18n.t("Position"))))
        def chips:EVGElement (this.div("ce-chips"))
        this.chip("ie-align-" (PresI18n.t("From theme")) ((strlen img.align) == 0) chips)
        this.chip("ie-align-left" (PresI18n.t("Left")) (img.align == "left") chips)
        this.chip("ie-align-center" (PresI18n.t("Center")) (img.align == "center") chips)
        this.chip("ie-align-right" (PresI18n.t("Right")) (img.align == "right") chips)
        place.addChild(chips)

        def words:EVGElement (this.section(pane (PresI18n.t("Alt text"))))
        def al:EVGElement (this.field((PresI18n.t("Description"))))
        this.input("ie-alt" (PresI18n.t("Description")) img.alt "ce-wide" al)
        words.addChild(al)
        words.addChild((this.text("ce-doc" (PresI18n.t("Screen readers read this, and it shows if the image can't be found.")))))

        def bg:EVGElement (this.section(pane (PresI18n.t("Use as background"))))
        def br:EVGElement (this.div("ce-row"))
        this.button("ie-bg-slide" (PresI18n.t("This slide's background")) "outline" br)
        this.button("ie-bg-all" (PresI18n.t("Background for all slides")) "outline" br)
        bg.addChild(br)
        bg.addChild((this.text("ce-doc" (PresI18n.t("The image becomes the bg setting on the slide's heading, or the background-image of the theme's page rule, and covers the whole slide. bg-dim=0.4 in the heading dims it behind the text.")))))

        def bottom:EVGElement (this.div("ce-foot"))
        this.button("ie-remove" (PresI18n.t("Remove image")) "outline" bottom)
        bottom.addChild((this.div("ce-grow")))
        this.button("ce-done" (PresI18n.t("Done")) "primary" bottom)
        root.addChild(bottom)
    }

    ; --- a picture on its way in ------------------------------------------------
    fn pasteBody:void (root:EVGElement) {
        def pane:EVGElement (this.div("ce-pane"))
        root.addChild(pane)
        crop.build()
        this.put(crop pane)
        pane.addChild((this.text("ce-doc" (PresI18n.t("Drag the frame or its corners to choose the part that shows. Arrow keys move it, Shift+arrows resize it.")))))

        def shape:EVGElement (this.section(pane (PresI18n.t("Shape"))))
        def sc:EVGElement (this.div("ce-chips"))
        this.chip("pe-shape-free" (PresI18n.t("Free")) (pasteShape == "free") sc)
        this.chip("pe-shape-slide" (PresI18n.t("Slide")) (pasteShape == "slide") sc)
        this.chip("pe-shape-4:3" "4:3" (pasteShape == "4:3") sc)
        this.chip("pe-shape-1:1" "1:1" (pasteShape == "1:1") sc)
        this.button("pe-reset" (PresI18n.t("Whole image")) "ghost" sc)
        shape.addChild(sc)

        def to:EVGElement (this.section(pane (PresI18n.t("Use as"))))
        def tc:EVGElement (this.div("ce-chips"))
        this.chip("pe-to-slide" (PresI18n.t("Image on this slide")) (pasteTo == "slide") tc)
        this.chip("pe-to-bg-slide" (PresI18n.t("This slide's background")) (pasteTo == "bg-slide") tc)
        this.chip("pe-to-bg-all" (PresI18n.t("Background for all slides")) (pasteTo == "bg-all") tc)
        to.addChild(tc)
        if (pasteTo == "slide") {
            def al:EVGElement (this.field((PresI18n.t("Description"))))
            this.input("pe-alt" (PresI18n.t("Description")) pasteAlt "ce-wide" al)
            to.addChild(al)
        }
        if (pasteVector && (pasteTo == "slide")) {
            pane.addChild((this.text("ce-doc" (PresI18n.t("A drawing with few colors: it is vectorized into an SVG, which stays sharp at any size. The original is kept in the files.")))))
        }
        if ((strlen pasteNote) > 0) {
            pane.addChild((this.copyable("ce-t-paste" "ce-doc" pasteNote)))
        }

        def bottom:EVGElement (this.div("ce-foot"))
        this.button("pe-cancel" (PresI18n.t("Cancel")) "outline" bottom)
        bottom.addChild((this.div("ce-grow")))
        if (pasteVector && (pasteTo == "slide")) {
            this.button("pe-add" (PresI18n.t("Add as it is")) "outline" bottom)
            this.button("pe-add-trace" (PresI18n.t("Add and vectorize…")) "primary" bottom)
        } {
            this.button("pe-add-trace" (PresI18n.t("Add and vectorize…")) "outline" bottom)
            this.button("pe-add" (PresI18n.t("Add image")) "primary" bottom)
        }
        root.addChild(bottom)
    }

    ; --- a picture of the files, edited -------------------------------------------
    sfn signed:string (v:int) {
        if (v > 0) {
            return ("+" + (to_string v))
        }
        return (to_string v)
    }

    fn adjustRow:void (parent:EVGElement tid:string label:string v:int) {
        def r:EVGElement (this.field(label))
        this.slider(tid label v -100 100 1 r)
        r.addChild((this.text("ce-value" (PresChartEditor.signed(v)))))
        parent.addChild(r)
    }

    fn adjustBody:void (root:EVGElement) {
        def pane:EVGElement (this.div("ce-pane"))
        root.addChild(pane)
        crop.build()
        this.put(crop pane)
        pane.addChild((this.text("ce-doc" ((PresI18n.t("Drag the frame or its corners to crop. ")) + adjFile))))
        def light:EVGElement (this.section(pane (PresI18n.t("Exposure"))))
        this.adjustRow(light "ae-s-bright" (PresI18n.t("Brightness")) adjBright)
        this.adjustRow(light "ae-s-contrast" (PresI18n.t("Contrast")) adjContrast)
        def col:EVGElement (this.section(pane (PresI18n.t("Color"))))
        this.adjustRow(col "ae-s-sat" (PresI18n.t("Saturation")) adjSat)
        this.adjustRow(col "ae-s-temp" (PresI18n.t("Warmth")) adjTemp)
        this.adjustRow(col "ae-s-tint" (PresI18n.t("Tint")) adjTint)
        if ((strlen adjContrastNote) > 0) {
            def cls:string "ce-ok"
            if adjContrastBad {
                cls = "ce-warn"
            }
            pane.addChild((this.copyable("ce-t-contrast" cls adjContrastNote)))
        }
        pane.addChild((this.text("ce-doc" (PresI18n.t("Save replaces the file: every slide that shows this image changes.")))))
        def bottom:EVGElement (this.div("ce-foot"))
        this.button("ae-cancel" (PresI18n.t("Cancel")) "outline" bottom)
        this.button("ae-reset" (PresI18n.t("Reset")) "ghost" bottom)
        bottom.addChild((this.div("ce-grow")))
        this.button("ae-trace" (PresI18n.t("Vectorize…")) "outline" bottom)
        this.button("ae-save" (PresI18n.t("Save")) "primary" bottom)
        root.addChild(bottom)
    }

    ; The slide's contrast as the page measured it, shown under the sliders.
    ; A drag keeps its controls: the window is built again when it ends.
    fn setAdjustContrast:void (note:string bad:boolean) {
        if ((note == adjContrastNote) && (bad == adjContrastBad)) {
            return
        }
        adjContrastNote = note
        adjContrastBad = bad
        if ((this.dragging()) == false) {
            this.rebuild()
        }
    }

    fn adjustAct:boolean (tid:string) {
        if (tid == "ae-reset") {
            this.adjustZero()
            crop.reset()
            adjDirty = true
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ae-cancel") {
            wantsClose = true
            return true
        }
        if (tid == "ae-save") {
            wantsSave = true
            wantsClose = true
            return true
        }
        if (tid == "ae-trace") {
            wantsTrace = true
            wantsClose = true
            return true
        }
        return false
    }

    ; --- a picture of the files, vectorized ----------------------------------------
    ; `orig` is the picture as the page registered it for drawing, `file` the
    ; file it is kept in, `iw` × `ih` its pixels, `uses` how many times the
    ; Markdown and the theme name it.
    fn openTrace:void (orig:string file:string iw:double ih:double uses:int px:double py:double pw:double ph:double) {
        mode = "trace"
        trFile = file
        trOrig = orig
        trPreview = ""
        trW = iw
        trH = ih
        trUses = uses
        def st (new PresTraceSettings())
        trSet = st
        trShow = "traced"
        trTab = "colors"
        trInfo = ""
        trErr = ""
        trBusy = true
        trDirty = false
        trReplace = (uses > 0)
        trTarget = ""
        wantsTraceSave = false
        this.openAt(px py pw ph)
    }

    ; the page traced: `preview` the traced picture as registered ("" when
    ; it failed), `info` what it made, `err` why not
    fn traceDone:void (preview:string info:string err:string) {
        trBusy = false
        if ((strlen preview) > 0) {
            trPreview = preview
        }
        trInfo = info
        trErr = err
        if ((this.dragging()) == false) {
            this.rebuild()
        }
    }

    ; the slider's value of an option: whole numbers, or hundredths
    fn trValue:int (opt:string scale:int) {
        if (scale == 1) {
            return (trSet.intOf(opt 0))
        }
        return (to_int (((trSet.numOf(opt 0.0)) * (to_double scale)) + 0.5))
    }

    fn trSlider:void (parent:EVGElement opt:string label:string lo:int hi:int st:int scale:int shown:string) {
        def r:EVGElement (this.field(label))
        this.slider(("tr-s-" + opt) label (this.trValue(opt scale)) lo hi st r)
        def words:string shown
        if ((strlen words) == 0) {
            words = (trSet.get(opt ""))
        }
        r.addChild((this.text("ce-value" words)))
        parent.addChild(r)
    }

    fn trTake:void (opt:string scale:int) {
        def cur:int (this.trValue(opt scale))
        def v:int (this.sliderValue(("tr-s-" + opt) cur))
        if (v == cur) {
            return
        }
        if (scale == 1) {
            trSet.set(opt (to_string v))
        } {
            trSet.set(opt (to_string ((to_double v) / (to_double scale))))
        }
        trDirty = true
        changed = true
    }

    sfn presetLabel:string (p:string) {
        if (p == "logo") {
            return (PresI18n.t("Logo"))
        }
        if (p == "poster") {
            return (PresI18n.t("Poster"))
        }
        if (p == "photo") {
            return (PresI18n.t("Photo"))
        }
        if (p == "lineart") {
            return (PresI18n.t("Line art"))
        }
        return (PresI18n.t("Illustration"))
    }

    sfn presetDoc:string (p:string) {
        if (p == "logo") {
            return (PresI18n.t("A few flat colors and a dropped plain background: logos, icons, symbols."))
        }
        if (p == "poster") {
            return (PresI18n.t("Twelve vivid colors, small colored details kept: posters, paintings, bold graphics."))
        }
        if (p == "photo") {
            return (PresI18n.t("24 colors with the noise smoothed away: a photo becomes a drawing. Good for blurry or low-resolution backgrounds."))
        }
        if (p == "lineart") {
            return (PresI18n.t("Black and white, the threshold found from the picture: drawings, signatures, scanned text."))
        }
        return (PresI18n.t("Eight colors: drawings, diagrams, clip art and screenshots."))
    }

    ; the picture shown: the trace (or the picture), at most 528 × 240
    fn tracePreview:EVGElement () {
        def bw:double 528.0
        def bh:double 240.0
        def k:double 1.0
        if ((trW > 0.0) && (trH > 0.0)) {
            k = (bw / trW)
            if ((bh / trH) < k) {
                k = (bh / trH)
            }
        }
        def pw:double (trW * k)
        def ph:double (trH * k)
        def box:EVGElement (this.div("ce-trace-box"))
        UiTree.inline(box "width" ((to_string (to_int bw)) + "px"))
        UiTree.inline(box "height" ((to_string (to_int (ph + 0.5))) + "px"))
        def im (EVGElement.createImg())
        im.id = "tr-img"
        im.className = "ce-trace-img"
        im.src = trPreview
        if ((trShow == "original") || ((strlen trPreview) == 0)) {
            im.src = trOrig
        }
        im.objectFit = "fill"
        im.sourceWidth = trW
        im.sourceHeight = trH
        UiTree.inline(im "width" ((to_string (to_int (pw + 0.5))) + "px"))
        UiTree.inline(im "height" ((to_string (to_int (ph + 0.5))) + "px"))
        box.addChild(im)
        return box
    }

    fn traceBody:void (root:EVGElement) {
        def pane:EVGElement (this.div("ce-pane"))
        root.addChild(pane)
        pane.addChild((this.tracePreview()))
        def sr:EVGElement (this.div("ce-chips"))
        this.chip("tr-show-traced" (PresI18n.t("Vectorized")) (trShow != "original") sr)
        this.chip("tr-show-original" (PresI18n.t("Original")) (trShow == "original") sr)
        pane.addChild(sr)
        if trBusy {
            pane.addChild((this.text("ce-doc" (PresI18n.t("Vectorizing…")))))
        } {
            if ((strlen trErr) > 0) {
                pane.addChild((this.copyable("ce-t-trace" "ce-warn" trErr)))
            } {
                if ((strlen trInfo) > 0) {
                    pane.addChild((this.copyable("ce-t-trace" "ce-ok" trInfo)))
                }
            }
        }

        def t0 (new TabsCtl())
        tabs = t0
        tabs.tid = "tr-tabs"
        tabs.name = (PresI18n.t("Vectorize image"))
        tabs.addItem("colors" (PresI18n.t("Colors")) "" false)
        tabs.addItem("shapes" (PresI18n.t("Shapes")) "" false)
        tabs.addItem("use" (PresI18n.t("Save")) "" false)
        tabs.value = trTab
        tabs.build()
        UiTree.addClass((unwrap tabs.rootEl) "ce-tabs")
        this.put(tabs pane)

        if (trTab == "colors") {
            def ps:EVGElement (this.section(pane (PresI18n.t("Starting point"))))
            def pc:EVGElement (this.div("ce-chips"))
            for (PresTraceSettings.presetNames()) p:string i {
                this.chip(("tr-pre-" + p) (PresChartEditor.presetLabel(p)) (trSet.preset == p) pc)
            }
            ps.addChild(pc)
            ps.addChild((this.text("ce-doc" (PresChartEditor.presetDoc(trSet.preset)))))
            def cs:EVGElement (this.section(pane (PresI18n.t("Colors"))))
            def n:int (trSet.intOf("colorCount" 8))
            def nw:string (to_string n)
            if (n <= 1) {
                nw = (PresI18n.t("black and white"))
            }
            this.trSlider(cs "colorCount" (PresI18n.t("Colors")) 1 48 1 1 nw)
            if (n <= 1) {
                def th:int (trSet.intOf("threshold" 128))
                def tw:string (to_string th)
                if (th < 0) {
                    tw = (PresI18n.t("automatic"))
                }
                this.trSlider(cs "threshold" (PresI18n.t("Threshold")) -1 255 1 1 tw)
            }
            def bgRow:EVGElement (this.field((PresI18n.t("Background"))))
            def bc:EVGElement (this.div("ce-chips"))
            def bgm:string (trSet.get("bgMode" "auto"))
            this.chip("tr-bg-keep" (PresI18n.t("Keep")) (bgm == "none") bc)
            this.chip("tr-bg-drop" (PresI18n.t("Remove")) (bgm != "none") bc)
            bgRow.addChild(bc)
            cs.addChild(bgRow)
            def grRow:EVGElement (this.field((PresI18n.t("Fill"))))
            def gc:EVGElement (this.div("ce-chips"))
            def grad:boolean ((trSet.get("gradientFill" "false")) == "true")
            this.chip("tr-grad-off" (PresI18n.t("Flat")) (grad == false) gc)
            this.chip("tr-grad-on" (PresI18n.t("Gradients")) grad gc)
            grRow.addChild(gc)
            cs.addChild(grRow)
        }
        if (trTab == "shapes") {
            def cl:EVGElement (this.section(pane (PresI18n.t("Clean-up"))))
            this.trSlider(cl "turdsize" (PresI18n.t("Drop specks (px)")) 0 40 1 1 "")
            this.trSlider(cl "minRegion" (PresI18n.t("Merge small areas (px)")) 0 400 2 1 "")
            this.trSlider(cl "smooth" (PresI18n.t("Smooth noise")) 0 4 1 1 "")
            def cu:EVGElement (this.section(pane (PresI18n.t("Curves"))))
            this.trSlider(cu "alphamax" (PresI18n.t("Round corners")) 0 134 1 100 "")
            this.trSlider(cu "opttolerance" (PresI18n.t("Simplify curves")) 0 200 5 100 "")
            def de:EVGElement (this.section(pane (PresI18n.t("Detail"))))
            this.trSlider(de "maxSide" (PresI18n.t("Traced at (px)")) 200 2000 100 1 "")
            de.addChild((this.text("ce-doc" (PresI18n.t("The longer side the picture is traced at. More is finer and slower; the SVG is drawn at the picture's own size either way.")))))
        }
        if ((trTab == "use") && ((strlen trTarget) > 0)) {
            def ua:EVGElement (this.section(pane (PresI18n.t("Save"))))
            ua.addChild((this.text("ce-doc" ((PresI18n.t("Saved over ")) + trTarget + (PresI18n.t(", where the slides already use it."))))))
        }
        if ((trTab == "use") && ((strlen trTarget) == 0)) {
            def us:EVGElement (this.section(pane (PresI18n.t("Save"))))
            def uc:EVGElement (this.div("ce-chips"))
            this.chip("tr-rep-on" ((PresI18n.t("Use it where the picture is used")) + " (" + (to_string trUses) + ")") trReplace uc)
            this.chip("tr-rep-off" (PresI18n.t("Only add it to the files")) (trReplace == false) uc)
            us.addChild(uc)
            def base:string trFile
            def dot:int (lastIndexOf base ".")
            if (dot > 0) {
                base = (substring base 0 dot)
            }
            us.addChild((this.text("ce-doc" ((PresI18n.t("Saved as ")) + base + ".svg. " + (PresI18n.t("The original stays in the files, so Ctrl+Z or the picture's name brings it back."))))))
        }

        def bottom:EVGElement (this.div("ce-foot"))
        this.button("tr-cancel" (PresI18n.t("Cancel")) "outline" bottom)
        this.button("tr-reset" (PresI18n.t("Reset")) "ghost" bottom)
        bottom.addChild((this.div("ce-grow")))
        this.button("tr-save" (PresI18n.t("Save as SVG")) "primary" bottom)
        root.addChild(bottom)
    }

    fn traceChanged:void () {
        trDirty = true
        changed = true
        this.rebuild()
    }

    fn traceAct:boolean (tid:string) {
        if ((indexOf tid "tr-pre-") == 0) {
            trSet.usePreset((substring tid 7 (strlen tid)))
            this.traceChanged()
            return true
        }
        if (tid == "tr-show-traced") {
            trShow = "traced"
            this.rebuild()
            return true
        }
        if (tid == "tr-show-original") {
            trShow = "original"
            this.rebuild()
            return true
        }
        if (tid == "tr-bg-keep") {
            trSet.set("bgMode" "none")
            this.traceChanged()
            return true
        }
        if (tid == "tr-bg-drop") {
            trSet.set("bgMode" "auto")
            this.traceChanged()
            return true
        }
        if (tid == "tr-grad-off") {
            trSet.set("gradientFill" "false")
            this.traceChanged()
            return true
        }
        if (tid == "tr-grad-on") {
            trSet.set("gradientFill" "true")
            this.traceChanged()
            return true
        }
        if (tid == "tr-rep-on") {
            trReplace = true
            this.rebuild()
            return true
        }
        if (tid == "tr-rep-off") {
            trReplace = false
            this.rebuild()
            return true
        }
        if (tid == "tr-reset") {
            trSet.usePreset(trSet.preset)
            this.traceChanged()
            return true
        }
        if (tid == "tr-cancel") {
            wantsClose = true
            return true
        }
        if (tid == "tr-save") {
            wantsTraceSave = true
            wantsClose = true
            return true
        }
        return false
    }

    ; --- a new presentation --------------------------------------------------------
    ; File → Duplicate: the copy's name, and Duplicate or Cancel.
    fn dupDeckBody:void (root:EVGElement) {
        if (ndAsk == "name") {
            this.askNameBody(root)
            return
        }
        if (ndAsk == "room") {
            this.roomBody(root)
            return
        }
        def pane:EVGElement (this.div("ce-pane"))
        def sec:EVGElement (this.section(pane (PresI18n.t("The copy"))))
        def nr:EVGElement (this.field((PresI18n.t("Name"))))
        this.inputWith("nd-name" (PresI18n.t("Name")) ndName (PresI18n.t("Write a name…")) "ce-wide" nr)
        sec.addChild(nr)
        sec.addChild((this.text("ce-doc" (PresI18n.t("The copy gets the slides, theme and files of this presentation. The name becomes its first slide's heading.")))))
        root.addChild(pane)

        def bottom:EVGElement (this.div("ce-foot"))
        this.button("nd-cancel" (PresI18n.t("Cancel")) "outline" bottom)
        bottom.addChild((this.div("ce-grow")))
        this.button("nd-create" (PresI18n.t("Duplicate")) "primary" bottom)
        root.addChild(bottom)
    }

    ; A room: one whole piece of work (a task, a ticket, a user story). Its
    ; name and description; a room that is there can be archived (read only,
    ; out of the list, found by search) or deleted (its presentations go to
    ; General).
    fn roomBody:void (root:EVGElement) {
        def pane:EVGElement (this.div("ce-pane"))
        def sec:EVGElement (this.section(pane (PresI18n.t("Room"))))
        def nr:EVGElement (this.field((PresI18n.t("Name"))))
        this.inputWith("nd-name" (PresI18n.t("Name")) ndName (PresI18n.t("e.g. PROJ-123 Checkout retry")) "ce-wide" nr)
        sec.addChild(nr)
        def dr:EVGElement (this.field((PresI18n.t("Description"))))
        this.inputWith("nd-desc" (PresI18n.t("Description")) ndDesc (PresI18n.t("What the work is, a link to the ticket…")) "ce-wide" dr)
        sec.addChild(dr)
        sec.addChild((this.text("ce-doc" (PresI18n.t("A room holds one whole piece of work: a task, a Jira ticket, a user story. Its presentations are listed under it.")))))
        if ((strlen rmId) > 0) {
            def sec2:EVGElement (this.section(pane (PresI18n.t("Archive or delete"))))
            def row:EVGElement (this.div("ce-chips"))
            if (rmState == "archived") {
                this.button("rm-unarchive" (PresI18n.t("Restore from archive")) "outline" row)
            } {
                this.button("rm-archive" (PresI18n.t("Archive")) "outline" row)
            }
            this.button("rm-delete" (PresI18n.t("Delete room…")) "danger" row)
            sec2.addChild(row)
            sec2.addChild((this.text("ce-doc" (PresI18n.t("An archived room is out of the list and read only; search still finds it. Deleting a room moves its presentations to General; none of them is deleted.")))))
        }
        root.addChild(pane)

        def bottom:EVGElement (this.div("ce-foot"))
        this.button("nd-cancel" (PresI18n.t("Cancel")) "outline" bottom)
        bottom.addChild((this.div("ce-grow")))
        def ok:string (PresI18n.t("Create"))
        if ((strlen rmId) > 0) {
            ok = (PresI18n.t("Save"))
        }
        this.button("nd-create" ok "primary" bottom)
        root.addChild(bottom)
    }

    ; Editing together: one's name, as the others see it by the caret and in
    ; the chat, and Save or Cancel.
    fn askNameBody:void (root:EVGElement) {
        def pane:EVGElement (this.div("ce-pane"))
        def sec:EVGElement (this.section(pane (PresI18n.t("Editing together"))))
        def nr:EVGElement (this.field((PresI18n.t("Name"))))
        this.inputWith("nd-name" (PresI18n.t("Name")) ndName (PresI18n.t("Write a name…")) "ce-wide" nr)
        sec.addChild(nr)
        sec.addChild((this.text("ce-doc" (PresI18n.t("The others editing this presentation see this name by your cursor and in the chat.")))))
        root.addChild(pane)

        def bottom:EVGElement (this.div("ce-foot"))
        this.button("nd-cancel" (PresI18n.t("Cancel")) "outline" bottom)
        bottom.addChild((this.div("ce-grow")))
        this.button("nd-create" (PresI18n.t("Save")) "primary" bottom)
        root.addChild(bottom)
    }

    fn newDeckBody:void (root:EVGElement) {
        if ndDup {
            this.dupDeckBody(root)
            return
        }
        def t0 (new TabsCtl())
        tabs = t0
        tabs.tid = "nd-tabs"
        tabs.name = (PresI18n.t("New presentation"))
        tabs.addItem("name" (PresI18n.t("Name")) "" false)
        tabs.addItem("theme" (PresI18n.t("Theme")) "" false)
        tabs.addItem("data" (PresI18n.t("Data sources")) "" false)
        tabs.value = ndTab
        tabs.build()
        UiTree.addClass((unwrap tabs.rootEl) "ce-tabs")
        this.put(tabs root)

        def pane:EVGElement (this.div("ce-pane"))
        if (ndTab == "name") {
            def sec:EVGElement (this.section(pane (PresI18n.t("Presentation"))))
            def nr:EVGElement (this.field((PresI18n.t("Name"))))
            this.inputWith("nd-name" (PresI18n.t("Name")) ndName (PresI18n.t("Write a name…")) "ce-wide" nr)
            sec.addChild(nr)
            sec.addChild((this.text("ce-doc" (PresI18n.t("The name becomes the first slide's heading. You can change it later in the Markdown.")))))
        }
        if (ndTab == "theme") {
            def sec2:EVGElement (this.section(pane (PresI18n.t("Theme"))))
            def chips:EVGElement (this.div("ce-chips"))
            def rows:[string] (strsplit ndRows (strfromcode 10))
            def i:int 0
            while (i < (array_length rows)) {
                def row:string (itemAt rows i)
                def cells:[string] (strsplit row (strfromcode 9))
                if ((array_length cells) >= 2) {
                    def v:string (itemAt cells 0)
                    this.chip(("nd-theme-" + v) (itemAt cells 1) (v == ndTheme) chips)
                }
                i = (i + 1)
            }
            sec2.addChild(chips)
            sec2.addChild((this.text("ce-doc" (PresI18n.t("The theme sets the colours, fonts and layout of every slide. The Theme menu changes it later.")))))
        }
        if (ndTab == "data") {
            def sec3:EVGElement (this.section(pane (PresI18n.t("Start with"))))
            def dc:EVGElement (this.div("ce-chips"))
            this.chip("nd-data-none" (PresI18n.t("No data")) (ndData == "none") dc)
            this.chip("nd-data-sample" (PresI18n.t("A sample chart")) (ndData == "sample") dc)
            this.chip("nd-data-file" (PresI18n.t("A data file (CSV, XLSX)")) (ndData == "file") dc)
            sec3.addChild(dc)
            def why:string (PresI18n.t("Charts and tables can read data you add later in the Files tab, or a Google Sheet or CSV link pasted into the Markdown."))
            if (ndData == "sample") {
                why = (PresI18n.t("A slide with a bar chart and its table, ready to edit in the chart settings."))
            }
            if (ndData == "file") {
                why = (PresI18n.t("After Create you pick a file from your computer, and choose what to make of it."))
            }
            sec3.addChild((this.text("ce-doc" why)))
        }
        root.addChild(pane)

        def bottom:EVGElement (this.div("ce-foot"))
        this.button("nd-cancel" (PresI18n.t("Cancel")) "outline" bottom)
        bottom.addChild((this.div("ce-grow")))
        this.button("nd-create" (PresI18n.t("Create")) "primary" bottom)
        root.addChild(bottom)
    }

    ; --- the document's settings --------------------------------------------------
    ; 0 the header, 1 the footer: the edge the tab shows
    fn dsEdge:int () {
        if (dsTab == "footer") {
            return 1
        }
        return 0
    }

    sfn fileName:string (path:string) {
        def i:int ((strlen path) - 1)
        while (i >= 0) {
            if ((charAt path i) == 47) {
                return (substring path (i + 1) (strlen path))
            }
            i = (i - 1)
        }
        return path
    }

    ; `12pt` as 12; "" (the layout's own size) as 0
    sfn sizeOf:int (v:string) {
        def t:string (trim v)
        def n:int (strlen t)
        if ((n > 2) && ((substring t (n - 2) n) == "pt")) {
            t = (substring t 0 (n - 2))
        }
        if ((n > 2) && ((substring t (n - 2) n) == "px")) {
            t = (substring t 0 (n - 2))
        }
        def d:double (?? (str2double t) 0.0)
        return (to_int (d + 0.5))
    }

    fn docSetBody:void (root:EVGElement) {
        def t0 (new TabsCtl())
        tabs = t0
        tabs.tid = "ds-tabs"
        tabs.name = (PresI18n.t("Document settings"))
        tabs.addItem("deck" (PresI18n.t("Presentation")) "" false)
        tabs.addItem("header" (PresI18n.t("Header")) "" false)
        tabs.addItem("footer" (PresI18n.t("Footer")) "" false)
        tabs.addItem("bg" (PresI18n.t("Background")) "" false)
        tabs.value = dsTab
        tabs.build()
        UiTree.addClass((unwrap tabs.rootEl) "ce-tabs")
        this.put(tabs root)

        def pane:EVGElement (this.div("ce-pane"))
        if (dsTab == "bg") {
            this.docSetBg(pane)
        }
        if (dsTab == "deck") {
            def sec:EVGElement (this.section(pane (PresI18n.t("Presentation"))))
            def nr:EVGElement (this.field((PresI18n.t("Title"))))
            this.inputWith("ds-title" (PresI18n.t("Title")) ds.title (PresI18n.t("Write a title…")) "ce-wide" nr)
            sec.addChild(nr)
            sec.addChild((this.text("ce-doc" (PresI18n.t("{title} in a header or footer, and the name of an exported file.")))))
            def sec2:EVGElement (this.section(pane (PresI18n.t("Transition"))))
            def tc:EVGElement (this.div("ce-chips"))
            def kinds:[string] (strsplit "fade,slide,zoom,none" ",")
            def names:[string] (strsplit ((PresI18n.t("Fade")) + "," + (PresI18n.t("Slide")) + "," + (PresI18n.t("Zoom")) + "," + (PresI18n.t("None"))) ",")
            def cur:string ds.transition
            if ((strlen cur) == 0) {
                cur = "fade"
            }
            def k:int 0
            while (k < (array_length kinds)) {
                this.chip(("ds-tr-" + (itemAt kinds k)) (itemAt names k) ((itemAt kinds k) == cur) tc)
                k = (k + 1)
            }
            sec2.addChild(tc)
            sec2.addChild((this.text("ce-doc" (PresI18n.t("For every slide; a slide's own heading can say otherwise: ## Title {transition=zoom}.")))))
            sec2.addChild((this.text("ce-doc" (PresI18n.t("One slide without it: {header=off} or {footer=off} on its heading.")))))
            def sec3:EVGElement (this.section(pane (PresI18n.t("Style"))))
            def cr:EVGElement (this.field((PresI18n.t("Charts"))))
            def cv:[string] (strsplit ",flat,forge,neon,glass,mermaid,jurassic,cartoon,romantic" ",")
            def cn:[string] (strsplit ((PresI18n.t("From theme")) + "," + (PresI18n.t("Flat")) + "," + (PresI18n.t("Forge")) + "," + (PresI18n.t("Neon")) + "," + (PresI18n.t("Glass")) + "," + (PresI18n.t("Mermaid")) + "," + (PresI18n.t("Jurassic")) + "," + (PresI18n.t("Cartoon")) + "," + (PresI18n.t("Romantic"))) ",")
            this.dropdown("ds-cs" (PresI18n.t("Charts")) ds.chartStyle cv cn cr)
            sec3.addChild(cr)
            def fr:EVGElement (this.field((PresI18n.t("Diagrams"))))
            def fv:[string] (strsplit ",sketch,mermaid,jurassic,cartoon,romantic" ",")
            def fnm:[string] (strsplit ((PresI18n.t("From theme")) + "," + (PresI18n.t("Sketch")) + "," + (PresI18n.t("Mermaid")) + "," + (PresI18n.t("Jurassic")) + "," + (PresI18n.t("Cartoon")) + "," + (PresI18n.t("Romantic"))) ",")
            this.dropdown("ds-fs" (PresI18n.t("Diagrams")) ds.diagramStyle fv fnm fr)
            sec3.addChild(fr)
            sec3.addChild((this.text("ce-doc" (PresI18n.t("For charts and diagrams that choose none; a chart's own Style on slide or a diagram's {style=…} goes over it.")))))
            if (((array_length dsRoomIds) > 0) || ((strlen dsRoomNote) > 0)) {
                def sec4:EVGElement (this.section(pane (PresI18n.t("Room"))))
                if ((strlen dsRoomNote) > 0) {
                    sec4.addChild((this.text("ce-doc" dsRoomNote)))
                } {
                    def rr:EVGElement (this.field((PresI18n.t("Room"))))
                    this.dropdown("ds-room" (PresI18n.t("Room")) dsRoom dsRoomIds dsRoomNames rr)
                    sec4.addChild(rr)
                    sec4.addChild((this.text("ce-doc" (PresI18n.t("The presentation's home room. Choosing another moves it there, as dragging it onto a room in the left rail does.")))))
                }
            }
        } {
            if (dsTab != "bg") {
                this.edgePane(pane (this.dsEdge()))
            }
        }
        root.addChild(pane)

        def bottom:EVGElement (this.div("ce-foot"))
        bottom.addChild((this.text("ce-doc" (PresI18n.t("Changes show on the slides right away; Ctrl+Z undoes them all.")))))
        bottom.addChild((this.div("ce-grow")))
        this.button("ds-done" (PresI18n.t("Done")) "primary" bottom)
        root.addChild(bottom)
    }

    fn edgePane:void (pane:EVGElement e:int) {
        def sec:EVGElement (this.section(pane (PresI18n.t("Text"))))
        def labels:[string] (strsplit ((PresI18n.t("Left")) + "," + (PresI18n.t("Center")) + "," + (PresI18n.t("Right"))) ",")
        def i:int 0
        while (i < 3) {
            def r:EVGElement (this.field((itemAt labels i)))
            def n:int ((e * 3) + i)
            ; the placeholders show what the keys fill in
            def ph:string ""
            if (i == 0) {
                ph = "{title}"
            }
            if (i == 2) {
                ph = "{page} / {pages}"
            }
            this.inputWith(("ds-t-" + (to_string n)) (itemAt labels i) (itemAt ds.texts n) ph "ce-wide" r)
            sec.addChild(r)
            i = (i + 1)
        }
        def qr:EVGElement (this.div("ce-row"))
        this.button("ds-pagenum" (PresI18n.t("Page number on the right")) "outline" qr)
        sec.addChild(qr)

        def lg:EVGElement (this.section(pane (PresI18n.t("Logo"))))
        if ((array_length dsPics) == 0) {
            lg.addChild((this.text("ce-doc" (PresI18n.t("Add a picture to the presentation first (paste it, or drop it on the Files tab), then pick it here.")))))
        } {
            def pc:EVGElement (this.div("ce-chips"))
            this.chip("ds-logo-none" (PresI18n.t("No logo")) ((strlen (itemAt ds.logo e)) == 0) pc)
            def p:int 0
            while (p < (array_length dsPics)) {
                def path:string (itemAt dsPics p)
                this.chip(("ds-logo-" + (to_string p)) (PresChartEditor.fileName(path)) (path == (itemAt ds.logo e)) pc)
                p = (p + 1)
            }
            lg.addChild(pc)
            if ((strlen (itemAt ds.logo e)) > 0) {
                def ac:EVGElement (this.field((PresI18n.t("Place"))))
                def at:EVGElement (this.div("ce-chips"))
                def j:int 0
                while (j < 3) {
                    this.chip(("ds-at-" + (to_string j)) (itemAt labels j) ((itemAt ds.logoAt e) == j) at)
                    j = (j + 1)
                }
                ac.addChild(at)
                lg.addChild(ac)
            }
        }

        ; the switches, the colours and the size in one section, so the
        ; window fits a laptop's screen without scrolling
        def lk:EVGElement (this.section(pane (PresI18n.t("Look"))))
        def sw:EVGElement (this.div("ce-chips ce-switches"))
        sw.addChild((this.text("ce-flabel" (PresI18n.t("Slides")))))
        this.switchOf("ds-first" (PresI18n.t("On the first slide")) ((itemAt ds.skipFirst e) == false) sw)
        this.switchOf("ds-last" (PresI18n.t("On the last slide")) ((itemAt ds.skipLast e) == false) sw)
        lk.addChild(sw)
        def cr:EVGElement (this.div("ce-chips"))
        cr.addChild((this.text("ce-flabel" (PresI18n.t("Text color")))))
        this.chip("ds-color-theme" (PresI18n.t("From theme")) ((strlen (itemAt ds.color e)) == 0) cr)
        this.chip("ds-pick-color" (PresI18n.t("Custom color")) ((strlen (itemAt ds.color e)) > 0) cr)
        if ((strlen (itemAt ds.color e)) > 0) {
            cr.addChild((this.swatch((itemAt ds.color e))))
        }
        lk.addChild(cr)
        def br:EVGElement (this.div("ce-chips"))
        br.addChild((this.text("ce-flabel" (PresI18n.t("Band")))))
        this.chip("ds-band-none" (PresI18n.t("No band")) ((strlen (itemAt ds.band e)) == 0) br)
        this.chip("ds-pick-band" (PresI18n.t("Color band")) ((strlen (itemAt ds.band e)) > 0) br)
        if ((strlen (itemAt ds.band e)) > 0) {
            br.addChild((this.swatch((itemAt ds.band e))))
        }
        lk.addChild(br)
        def zr:EVGElement (this.field((PresI18n.t("Size"))))
        def sz:int (PresChartEditor.sizeOf((itemAt ds.size e)))
        this.slider("ds-size" (PresI18n.t("Size")) sz 0 40 1 zr)
        def zl:string ((to_string sz) + " pt")
        if (sz <= 0) {
            zl = (PresI18n.t("default"))
        }
        zr.addChild((this.text("ce-value" zl)))
        lk.addChild(zr)
    }

    ; The Background tab: every slide's picture, from the deck's pictures,
    ; edited or vectorized where it is.
    fn docSetBg:void (pane:EVGElement) {
        def sec:EVGElement (this.section(pane (PresI18n.t("Background image"))))
        if ((array_length dsPics) == 0) {
            sec.addChild((this.text("ce-doc" (PresI18n.t("Add a picture to the presentation first (paste it, or drop it on the Files tab), then pick it here.")))))
        } {
            def pc:EVGElement (this.div("ce-chips"))
            this.chip("ds-bg-none" (PresI18n.t("None")) ((strlen dsBg) == 0) pc)
            def p:int 0
            while (p < (array_length dsPics)) {
                def path:string (itemAt dsPics p)
                this.chip(("ds-bg-" + (to_string p)) (PresChartEditor.fileName(path)) (path == dsBg) pc)
                p = (p + 1)
            }
            sec.addChild(pc)
        }
        if ((strlen dsBg) > 0) {
            def er:EVGElement (this.div("ce-row"))
            def low:string (to_lowercase dsBg)
            def vector:boolean ((endsWith low ".svg") || (endsWith low ".svgz"))
            if (vector == false) {
                this.button("ds-bg-edit" (PresI18n.t("Edit image…")) "outline" er)
                this.button("ds-bg-trace" (PresI18n.t("Vectorize…")) "outline" er)
            }
            sec.addChild(er)
            if vector {
                sec.addChild((this.text("ce-doc" (PresI18n.t("A vector picture: sharp at any size.")))))
            } {
                sec.addChild((this.text("ce-doc" (PresI18n.t("Vectorize… turns a blurry or small picture into an SVG that stays sharp on any screen.")))))
            }
        }
        sec.addChild((this.text("ce-doc" (PresI18n.t("Behind every slide: background-image in the theme's page rule. A slide's own bg= in its heading goes over it.")))))
    }

    fn docSetAct:boolean (tid:string) {
        if (tid == "ds-bg-none") {
            dsBg = ""
            dsBgAct = "none"
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ds-bg-edit") {
            dsBgAct = "edit"
            changed = true
            wantsClose = true
            return true
        }
        if (tid == "ds-bg-trace") {
            dsBgAct = "trace"
            changed = true
            wantsClose = true
            return true
        }
        if ((indexOf tid "ds-bg-") == 0) {
            def bp:int (?? (str2int (substring tid 6 (strlen tid))) -1)
            if ((bp >= 0) && (bp < (array_length dsPics))) {
                dsBg = (itemAt dsPics bp)
                dsBgAct = ("set:" + dsBg)
                changed = true
            }
            this.rebuild()
            return true
        }
        def e:int (this.dsEdge())
        if (tid == "ds-done") {
            wantsClose = true
            return true
        }
        if ((indexOf tid "ds-room-") == 0) {
            def to:string (substring tid 8 (strlen tid))
            if (((strlen to) > 0) && (to != dsRoom)) {
                dsRoom = to
                dsRoomAct = to
            }
            return true
        }
        if ((indexOf tid "ds-cs-") == 0) {
            ds.chartStyle = (substring tid 6 (strlen tid))
            changed = true
            return true
        }
        if ((indexOf tid "ds-fs-") == 0) {
            ds.diagramStyle = (substring tid 6 (strlen tid))
            changed = true
            return true
        }
        if ((indexOf tid "ds-tr-") == 0) {
            def v:string (substring tid 6 (strlen tid))
            if (v == "fade") {
                v = ""
            }
            ds.transition = v
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ds-pagenum") {
            def n:int ((e * 3) + 2)
            def was:string (trim (itemAt ds.texts n))
            if ((indexOf was "{page}") < 0) {
                if ((strlen was) > 0) {
                    set ds.texts n (was + " · {page} / {pages}")
                } {
                    set ds.texts n "{page} / {pages}"
                }
                changed = true
            }
            this.rebuild()
            return true
        }
        if (tid == "ds-logo-none") {
            set ds.logo e ""
            changed = true
            this.rebuild()
            return true
        }
        if ((indexOf tid "ds-logo-") == 0) {
            def p:int (?? (str2int (substring tid 8 (strlen tid))) -1)
            if ((p >= 0) && (p < (array_length dsPics))) {
                set ds.logo e (itemAt dsPics p)
                changed = true
            }
            this.rebuild()
            return true
        }
        if ((indexOf tid "ds-at-") == 0) {
            def a:int (?? (str2int (substring tid 6 (strlen tid))) 2)
            set ds.logoAt e a
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ds-first") {
            set ds.skipFirst e ((itemAt ds.skipFirst e) == false)
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ds-last") {
            set ds.skipLast e ((itemAt ds.skipLast e) == false)
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ds-color-theme") {
            set ds.color e ""
            if (pickFor == "ds-color") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ds-band-none") {
            set ds.band e ""
            if (pickFor == "ds-band") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ds-pick-color") {
            this.openPicker("ds-color" (itemAt ds.color e))
            return true
        }
        if (tid == "ds-pick-band") {
            this.openPicker("ds-band" (itemAt ds.band e))
            return true
        }
        return false
    }

    ; --- a question before deleting ----------------------------------------------
    fn confirmBody:void (root:EVGElement) {
        def pane:EVGElement (this.div("ce-pane"))
        if ((strlen cfOk) == 0) {
            ; the first line as the heading, the rest under it
            def lines:[string] (strsplit cfText (strfromcode 10))
            def i:int 0
            while (i < (array_length lines)) {
                def cls:string "ce-doc"
                if (i == 0) {
                    cls = "ce-about"
                }
                pane.addChild((this.copyable(("ce-t-line" + (to_string i)) cls (itemAt lines i))))
                i = (i + 1)
            }
            root.addChild(pane)
            def foot:EVGElement (this.div("ce-foot"))
            foot.addChild((this.div("ce-grow")))
            this.button("cf-close" (PresI18n.t("OK")) "primary" foot)
            root.addChild(foot)
            return
        }
        pane.addChild((this.copyable("ce-t-confirm" "ce-doc" cfText)))
        root.addChild(pane)
        def bottom:EVGElement (this.div("ce-foot"))
        this.button("cf-cancel" (PresI18n.t("Cancel")) "outline" bottom)
        bottom.addChild((this.div("ce-grow")))
        if ((strlen cfAlt) > 0) {
            this.button("cf-alt" cfAlt "outline" bottom)
            this.button("cf-ok" cfOk "primary" bottom)
        } {
            this.button("cf-ok" cfOk "danger" bottom)
        }
        root.addChild(bottom)
    }

    fn confirmAct:boolean (tid:string) {
        if ((tid == "cf-cancel") || (tid == "cf-close")) {
            wantsClose = true
            return true
        }
        if (tid == "cf-ok") {
            wantsConfirm = true
            wantsClose = true
            return true
        }
        if (tid == "cf-alt") {
            wantsAlt = true
            wantsClose = true
            return true
        }
        return false
    }

    fn newDeckAct:boolean (tid:string) {
        if ((indexOf tid "nd-theme-") == 0) {
            ndTheme = (substring tid 9 (strlen tid))
            this.rebuild()
            return true
        }
        if ((indexOf tid "nd-data-") == 0) {
            ndData = (substring tid 8 (strlen tid))
            this.rebuild()
            return true
        }
        if (tid == "nd-cancel") {
            wantsClose = true
            return true
        }
        if (tid == "nd-create") {
            rmAct = ""
            wantsCreate = true
            wantsClose = true
            return true
        }
        if (((tid == "rm-archive") || (tid == "rm-unarchive")) || (tid == "rm-delete")) {
            rmAct = (substring tid 3 (strlen tid))
            wantsCreate = true
            wantsClose = true
            return true
        }
        return false
    }

    fn shapeAspect:double (k:string) {
        if (k == "slide") {
            return slideAspect
        }
        if (k == "4:3") {
            return (4.0 / 3.0)
        }
        if (k == "1:1") {
            return 1.0
        }
        return 0.0
    }

    fn pasteAct:boolean (tid:string) {
        if ((indexOf tid "pe-shape-") == 0) {
            pasteShape = (substring tid 9 (strlen tid))
            crop.setAspect((this.shapeAspect(pasteShape)))
            this.rebuild()
            return true
        }
        if (tid == "pe-reset") {
            pasteShape = "free"
            crop.setAspect(0.0)
            crop.reset()
            this.rebuild()
            return true
        }
        if ((indexOf tid "pe-to-") == 0) {
            pasteTo = (substring tid 6 (strlen tid))
            ; a background covers the slide: cut to the slide's shape, unless a
            ; shape was already picked
            if (((indexOf pasteTo "bg-") == 0) && (pasteShape == "free")) {
                pasteShape = "slide"
                crop.setAspect(slideAspect)
            }
            focusTid = ""
            this.rebuild()
            return true
        }
        if (tid == "pe-cancel") {
            wantsClose = true
            return true
        }
        if (tid == "pe-add") {
            wantsPlace = true
            wantsClose = true
            return true
        }
        if (tid == "pe-add-trace") {
            wantsPlace = true
            pasteTrace = true
            wantsClose = true
            return true
        }
        return false
    }

    fn imageAct:boolean (tid:string) {
        if (tid == "ie-natural") {
            img.width = ""
            img.height = ""
            changed = true
            this.rebuild()
            return true
        }
        if ((indexOf tid "ie-align-") == 0) {
            img.align = (substring tid 9 (strlen tid))
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ie-bg-slide") {
            wantsBg = "slide"
            wantsClose = true
            return true
        }
        if (tid == "ie-bg-all") {
            wantsBg = "all"
            wantsClose = true
            return true
        }
        if (tid == "ie-remove") {
            wantsRemove = true
            wantsClose = true
            return true
        }
        return false
    }

    fn sizeW:int () {
        if (model.width > 0) {
            return model.width
        }
        return 640
    }

    fn sizeH:int () {
        if (model.height > 0) {
            return model.height
        }
        return 300
    }

    fn chartTab:void (pane:EVGElement) {
        ; the size first: it is what a slide asks of a chart most
        def size:EVGElement (this.section(pane (PresI18n.t("Size"))))
        def wr:EVGElement (this.field((PresI18n.t("Width"))))
        this.slider("ce-width" (PresI18n.t("Width")) (this.sizeW()) 200 960 10 wr)
        ; a size the chart does not state is the slide's: the slider's 640 is
        ; only where the handle starts, not what is drawn
        def wl:string ((to_string (this.sizeW())) + " px")
        if (model.width <= 0) {
            wl = (PresI18n.t("from slide"))
        }
        wr.addChild((this.text("ce-value" wl)))
        size.addChild(wr)
        def hr:EVGElement (this.field((PresI18n.t("Height"))))
        this.slider("ce-height" (PresI18n.t("Height")) (this.sizeH()) 120 600 10 hr)
        def hl:string ((to_string (this.sizeH())) + " px")
        if (model.height <= 0) {
            hl = (PresI18n.t("from slide"))
        }
        hr.addChild((this.text("ce-value" hl)))
        size.addChild(hr)
        if ((model.width <= 0) && (model.height <= 0)) {
            size.addChild((this.text("ce-doc" (PresI18n.t("The chart now takes its size from the slide; the sliders set a custom size.")))))
        } {
            def ar:EVGElement (this.div("ce-row"))
            this.button("ce-autosize" (PresI18n.t("Size from slide")) "outline" ar)
            size.addChild(ar)
        }

        if model.lookOnly {
            ; the kind is the specification's own: the table that would
            ; choose another is not there
            def words0:EVGElement (this.section(pane (PresI18n.t("Title and legend"))))
            def tl0:EVGElement (this.field((PresI18n.t("Title"))))
            this.input("ce-titlein" (PresI18n.t("Title")) model.title "ce-wide" tl0)
            words0.addChild(tl0)
            this.switchOf("ce-legend" (PresI18n.t("Show legend")) model.legend words0)
            return
        }
        def kind:EVGElement (this.section(pane (PresI18n.t("Type"))))
        def kinds:EVGElement (this.div("ce-chips"))
        def k:int 1
        while (k <= 20) {
            def b:ButtonCtl (this.chip(("ce-kind-" + (to_string k)) (PresChartModel.kindLabel(k)) (k == model.kind) kinds))
            if ((k != model.kind) && ((model.suits(k)) == false)) {
                b.disabled = true
                b.build()
                this.dressButton(b)
                UiTree.addClass((unwrap b.rootEl) "ce-chip")
            }
            k = (k + 1)
        }
        kind.addChild(kinds)
        if ((model.suits(model.kind)) == false) {
            kind.addChild((this.text("ce-warn" ((PresChartModel.kindLabel(model.kind)) + (PresI18n.t(" needs ")) + (PresChartModel.kindNeeds(model.kind)) + "."))))
        }

        def words:EVGElement (this.section(pane (PresI18n.t("Title and legend"))))
        def tl:EVGElement (this.field((PresI18n.t("Title"))))
        this.input("ce-titlein" (PresI18n.t("Title")) model.title "ce-wide" tl)
        words.addChild(tl)
        this.switchOf("ce-legend" (PresI18n.t("Show legend")) model.legend words)
    }

    fn looksTab:void (pane:EVGElement) {
        def col:EVGElement (this.section(pane (PresI18n.t("Colors"))))
        def cols:EVGElement (this.div("ce-chips"))
        def sv:[string]
        def sn:[string]
        push sv ""
        push sn (PresI18n.t("From theme"))
        def names:[string] (strsplit (PresChartModel.schemes()) " ")
        def s:int 0
        while (s < (array_length names)) {
            push sv (itemAt names s)
            push sn (itemAt names s)
            s = (s + 1)
        }
        def scheme:string model.scheme
        if ((strlen model.color) > 0) {
            ; a colour of its own: the list says so, and choosing a scheme
            ; or the theme's colours lets it go
            push sv "custom"
            push sn (PresI18n.t("Custom color"))
            scheme = "custom"
        }
        this.dropdown("ce-scheme" (PresI18n.t("Colors")) scheme sv sn cols)
        this.chip("ce-pick-color" (PresI18n.t("Custom color")) ((strlen model.color) > 0) cols)
        if ((strlen model.color) > 0) {
            cols.addChild((this.swatch(model.color)))
        }
        col.addChild(cols)

        def tx:EVGElement (this.section(pane (PresI18n.t("Text color"))))
        def tr:EVGElement (this.div("ce-chips"))
        this.chip("ce-text-theme" (PresI18n.t("From theme")) ((strlen model.textColor) == 0) tr)
        this.chip("ce-pick-text" (PresI18n.t("Custom color")) ((strlen model.textColor) > 0) tr)
        if ((strlen model.textColor) > 0) {
            tr.addChild((this.swatch(model.textColor)))
        }
        tx.addChild(tr)

        def st:EVGElement (this.section(pane (PresI18n.t("Style on slide"))))
        def ef:EVGElement (this.div("ce-chips"))
        ; the stage's own dressings, then the looks the diagrams have
        ; (RangerFlow's FlowLook)
        def effects:[string] (strsplit ",flat,forge,neon,glass,mermaid,jurassic,cartoon,romantic" ",")
        def effectNames:[string] (strsplit ((PresI18n.t("Document default")) + "," + (PresI18n.t("Flat")) + "," + (PresI18n.t("Forge")) + "," + (PresI18n.t("Neon")) + "," + (PresI18n.t("Glass")) + "," + (PresI18n.t("Mermaid")) + "," + (PresI18n.t("Jurassic")) + "," + (PresI18n.t("Cartoon")) + "," + (PresI18n.t("Romantic"))) ",")
        this.dropdown("ce-effect" (PresI18n.t("Style on slide")) model.effect effects effectNames ef)
        st.addChild(ef)
        def sw:EVGElement (this.div("ce-row ce-switches"))
        this.switchOf("ce-glow" (PresI18n.t("Glow")) model.glow sw)
        this.switchOf("ce-shadow" (PresI18n.t("Shadow")) model.shadow sw)
        this.switchOf("ce-gradient" (PresI18n.t("Gradient")) model.gradient sw)
        st.addChild(sw)
        if ((model.kind >= 6) && (model.kind <= 9)) {
            def wr:EVGElement (this.field((PresI18n.t("Line width"))))
            this.slider("ce-stroke" (PresI18n.t("Line width")) (to_int model.strokeWidth) 0 10 1 wr)
            def label:string ((to_string (to_int model.strokeWidth)) + " px")
            if (model.strokeWidth <= 0.0) {
                label = (PresI18n.t("default"))
            }
            wr.addChild((this.text("ce-value" label)))
            st.addChild(wr)
            def pr:EVGElement (this.div("ce-row ce-switches"))
            this.switchOf("ce-points" (PresI18n.t("Points")) model.points pr)
            st.addChild(pr)
        }
    }

    ; The picker: a card of its own beside the window (on its left when
    ; there is no room on the right), so the window keeps its height.
    fn pickerCard:EVGElement () {
        picker.inline = true
        def card:EVGElement (this.div("ce-pickcard"))
        card.id = "ce-pickcard"
        def head:EVGElement (this.div("ce-pickhead"))
        def what:string (PresI18n.t("Chart color"))
        if ((pickFor == "text") || (pickFor == "ds-color")) {
            what = (PresI18n.t("Text color"))
        }
        if (pickFor == "ds-band") {
            what = (PresI18n.t("Band color"))
        }
        head.addChild((this.text("ce-picktitle" what)))
        head.addChild((this.div("ce-grow")))
        this.button("ce-pick-done" (PresI18n.t("Done")) "primary" head)
        card.addChild(head)
        card.addChild((cp.panel(picker)))
        push host.ctls picker
        def px:double ((x + 560.0) + 12.0)
        if ((px + 280.0) > w) {
            px = ((x - 280.0) - 12.0)
        }
        if (px < 0.0) {
            px = (w - 280.0)
        }
        UiTree.surface(card "free" "start")
        card.overlayX = px
        card.overlayY = (y + 44.0)
        return card
    }

    fn dataTab:void (pane:EVGElement) {
        if model.lookOnly {
            pane.addChild((this.copyable("ce-t-why" "ce-doc" model.why)))
            if model.dataLive {
                def live:EVGElement (this.field((PresI18n.t("Data source"))))
                live.addChild((this.copyable("ce-t-url" "ce-value" model.dataFile)))
                pane.addChild(live)
                pane.addChild((this.text("ce-doc" (PresI18n.t("The data is fetched from this address each time the presentation opens. While presenting, R (or ⟳) fetches it again. PDF and PPTX keep the data as it was when exported.")))))
            }
            if (((strlen model.dataFile) > 0) && (model.dataLive == false)) {
                def src:EVGElement (this.field((PresI18n.t("File"))))
                src.addChild((this.copyable("ce-t-file" "ce-value" model.dataFile)))
                pane.addChild(src)
                pane.addChild((this.text("ce-doc" (PresI18n.t("The data is in a file of the presentation: edit it on the Files tab. The chart redraws when the file changes.")))))
            }
            if ((strlen model.dataFile) == 0) {
                pane.addChild((this.text("ce-doc" (PresI18n.t("The data and how it is processed are in the chart's JSON on the Markdown tab.")))))
            }
            def row:EVGElement (this.div("ce-row"))
            if (((strlen model.dataFile) > 0) && (model.dataLive == false)) {
                this.button("ce-openfile" (PresI18n.t("Open file")) "primary" row)
            }
            this.button("ce-fresh" (PresI18n.t("Replace with sample table")) "outline" row)
            pane.addChild(row)
            return
        }
        pane.addChild((this.text("ce-doc" (PresI18n.t("First column: categories. Other columns: series.")))))
        def grid:EVGElement (this.div("ce-grid"))
        def hr:EVGElement (this.div("ce-gridrow ce-gridhead"))
        def c:int 0
        while (c < (model.cols())) {
            this.input(("ce-h-" + (to_string c)) (PresI18n.t("Column")) (itemAt model.header c) "ce-cell ce-head" hr)
            c = (c + 1)
        }
        this.button("ce-addcol" (PresI18n.t("+ Series")) "ghost" hr)
        grid.addChild(hr)
        def r:int 0
        while (r < (model.rows())) {
            def row:EVGElement (this.div("ce-gridrow"))
            def cc:int 0
            while (cc < (model.cols())) {
                def cls:string "ce-cell"
                if (cc == 0) {
                    cls = "ce-cell ce-cat"
                }
                this.input(("ce-c-" + (to_string r) + "-" + (to_string cc)) (PresI18n.t("Cell")) (model.cell(r cc)) cls row)
                cc = (cc + 1)
            }
            def x0:ButtonCtl (this.button(("ce-delrow-" + (to_string r)) "×" "ghost" row))
            UiTree.addClass((unwrap x0.rootEl) "ce-x")
            grid.addChild(row)
            r = (r + 1)
        }
        pane.addChild(grid)
        def foot:EVGElement (this.div("ce-row"))
        this.button("ce-addrow" (PresI18n.t("+ Row")) "outline" foot)
        if ((model.cols()) > 2) {
            this.button("ce-delcol" (PresI18n.t("− Last series")) "outline" foot)
        }
        pane.addChild(foot)
    }

    ; --- a diagram ----------------------------------------------------------------
    ; The rows of a long list shown: eight from `listPage` on.
    fn pageOf:int (count:int) {
        def pages:int (idiv (count + 7) 8)
        if (pages < 1) {
            pages = 1
        }
        if (listPage >= pages) {
            listPage = (pages - 1)
        }
        if (listPage < 0) {
            listPage = 0
        }
        return pages
    }

    ; ‹ 1 / 3 › under a list longer than a page
    fn pager:void (parent:EVGElement pages:int) {
        if (pages <= 1) {
            return
        }
        def b0:ButtonCtl (this.button("bk-prev" "‹" "outline" parent))
        UiTree.addClass((unwrap b0.rootEl) "ce-x")
        parent.addChild((this.text("ce-doc" ((to_string (listPage + 1)) + " / " + (to_string pages)))))
        def b1:ButtonCtl (this.button("bk-next" "›" "outline" parent))
        UiTree.addClass((unwrap b1.rootEl) "ce-x")
    }

    ; The shapes the window offers, "open close name" each.
    sfn shapeList:[string] () {
        ; i18n: "Box" "Rounded" "Pill" "Diamond" "Circle" "Database" "Hexagon" "Subroutine"
        return (strsplit "[ ] Box,( ) Rounded,([ ]) Pill,{ } Diamond,(( )) Circle,[( )] Database,{{ }} Hexagon,[[ ]] Subroutine" ",")
    }

    fn diagramBody:void (root:EVGElement) {
        if flow.editable {
            def t0 (new TabsCtl())
            tabs = t0
            tabs.tid = "de-tabs"
            tabs.name = (PresI18n.t("Diagram"))
            tabs.addItem("diagram" (PresI18n.t("Diagram")) "" false)
            tabs.addItem("boxes" (PresI18n.t("Boxes")) "" false)
            tabs.addItem("links" (PresI18n.t("Links")) "" false)
            tabs.value = deTab
            tabs.build()
            UiTree.addClass((unwrap tabs.rootEl) "ce-tabs")
            this.put(tabs root)
        } {
            deTab = "diagram"
        }
        def pane:EVGElement (this.div("ce-pane"))
        root.addChild(pane)
        if (deTab == "boxes") {
            this.boxesTab(pane)
        }
        if (deTab == "links") {
            this.linksTab(pane)
        }
        if (deTab == "diagram") {
            this.diagramTab(pane)
        }
        this.blockFoot(root)
    }

    fn diagramTab:void (pane:EVGElement) {
        def lk:EVGElement (this.section(pane (PresI18n.t("Look"))))
        def chips:EVGElement (this.div("ce-chips"))
        def look:string (flow.look())
        this.chip("de-look-holo" (PresI18n.t("Holo")) (look == "holo") chips)
        this.chip("de-look-sketch" (PresI18n.t("Sketch")) (look == "sketch") chips)
        this.chip("de-look-mermaid" (PresI18n.t("Mermaid")) (look == "mermaid") chips)
        this.chip("de-look-jurassic" (PresI18n.t("Jurassic")) (look == "jurassic") chips)
        this.chip("de-look-cartoon" (PresI18n.t("Cartoon")) (look == "cartoon") chips)
        this.chip("de-look-romantic" (PresI18n.t("Romantic")) (look == "romantic") chips)
        this.chip("de-look-classic" (PresI18n.t("Classic")) (look == "classic") chips)
        lk.addChild(chips)
        if (look == "classic") {
            lk.addChild((this.text("ce-doc" (PresI18n.t("Classic is drawn still, in the slide's colours: no tour, no moving dot.")))))
        }
        if flow.editable {
            def dr:EVGElement (this.section(pane (PresI18n.t("Direction"))))
            def dc:EVGElement (this.div("ce-chips"))
            def d:string flow.dir
            if ((d == "TB") || (d == "")) {
                d = "TD"
            }
            this.chip("de-dir-LR" (PresI18n.t("Left to right")) (d == "LR") dc)
            this.chip("de-dir-TD" (PresI18n.t("Top to bottom")) (d == "TD") dc)
            this.chip("de-dir-RL" (PresI18n.t("Right to left")) (d == "RL") dc)
            this.chip("de-dir-BT" (PresI18n.t("Bottom to top")) (d == "BT") dc)
            dr.addChild(dc)
        }
        def op:EVGElement (this.section(pane (PresI18n.t("On the slide"))))
        this.switchOf("de-f-layout" (PresI18n.t("Keep the direction as written")) (flow.flag("layout")) op)
        if (look != "classic") {
            this.switchOf("de-f-tour" (PresI18n.t("Tour starts with the slide")) (flow.flag("tour")) op)
            this.switchOf("de-f-ball" (PresI18n.t("Moving dot along the links")) (flow.flag("ball")) op)
            this.switchOf("de-f-choose" (PresI18n.t("Ask at branches during the tour")) (flow.flag("choose")) op)
        }
        if (flow.editable == false) {
            pane.addChild((this.text("ce-doc" ((PresI18n.t("Its boxes and links are written in ")) + (flow.notationName()) + (PresI18n.t(": edit them as text in the Markdown."))))))
        }
    }

    fn boxesTab:void (pane:EVGElement) {
        def list:[PresFlowNode] (flow.liveNodes())
        def pages:int (this.pageOf((array_length list)))
        def grid0:EVGElement (this.div("ce-grid"))
        def i:int (listPage * 8)
        def end:int (i + 8)
        while ((i < end) && (i < (array_length list))) {
            def nd:PresFlowNode (itemAt list i)
            def row:EVGElement (this.div("ce-gridrow"))
            def lc:string "ce-flowlabel"
            if (nd.id == selNode) {
                lc = "ce-flowlabel ce-sel"
            }
            this.inputWith(("de-n-" + nd.id) (PresI18n.t("Box")) nd.label nd.id lc row)
            def x0:ButtonCtl (this.button(("de-deln-" + nd.id) "×" "ghost" row))
            UiTree.addClass((unwrap x0.rootEl) "ce-x")
            grid0.addChild(row)
            i = (i + 1)
        }
        pane.addChild(grid0)
        def foot:EVGElement (this.div("ce-row"))
        this.button("de-addnode" (PresI18n.t("+ Box")) "outline" foot)
        this.pager(foot pages)
        pane.addChild(foot)
        def k:int (flow.nodeIndex(selNode))
        if (k < 0) {
            pane.addChild((this.text("ce-doc" (PresI18n.t("Click a box's words to change its shape.")))))
            return
        }
        def sel:PresFlowNode (itemAt flow.nodes k)
        def sh:EVGElement (this.section(pane ((PresI18n.t("Shape of ")) + "“" + sel.label + "”")))
        def chips:EVGElement (this.div("ce-chips"))
        def shapes:[string] (PresChartEditor.shapeList())
        def s:int 0
        while (s < (array_length shapes)) {
            def parts:[string] (strsplit (itemAt shapes s) " ")
            def on:boolean (((itemAt parts 0) == sel.open) && ((itemAt parts 1) == sel.close))
            this.chip(("de-shape-" + (to_string s)) (PresI18n.t((itemAt parts 2))) on chips)
            s = (s + 1)
        }
        sh.addChild(chips)
    }

    fn linksTab:void (pane:EVGElement) {
        def list:[int] (flow.liveEdges())
        def pages:int (this.pageOf((array_length list)))
        def grid0:EVGElement (this.div("ce-grid"))
        def i:int (listPage * 8)
        def end:int (i + 8)
        while ((i < end) && (i < (array_length list))) {
            def ei:int (itemAt list i)
            def e:PresFlowEdge (itemAt flow.edges ei)
            def row:EVGElement (this.div("ce-gridrow"))
            def arrow:string " — "
            if (PresFlowModel.hasArrow(e.op)) {
                arrow = " → "
            }
            row.addChild((this.text("ce-flowends" ((flow.labelOf(e.from)) + arrow + (flow.labelOf(e.to))))))
            def lc:string "ce-flowedge"
            if (ei == selEdge) {
                lc = "ce-flowedge ce-sel"
            }
            this.inputWith(("de-e-" + (to_string ei)) (PresI18n.t("Words on the link")) e.label (PresI18n.t("words")) lc row)
            def x0:ButtonCtl (this.button(("de-dele-" + (to_string ei)) "×" "ghost" row))
            UiTree.addClass((unwrap x0.rootEl) "ce-x")
            grid0.addChild(row)
            i = (i + 1)
        }
        pane.addChild(grid0)
        def pr:EVGElement (this.div("ce-row"))
        this.pager(pr pages)
        pane.addChild(pr)
        if ((selEdge >= 0) && (selEdge < (array_length flow.edges))) {
            def se:PresFlowEdge (itemAt flow.edges selEdge)
            if (se.dead == false) {
                def ln:EVGElement (this.section(pane ((PresI18n.t("Line of ")) + (flow.labelOf(se.from)) + " → " + (flow.labelOf(se.to)))))
                def chips:EVGElement (this.div("ce-chips"))
                def kind:string (PresFlowModel.lineOf(se.op))
                this.chip("de-line-solid" (PresI18n.t("Solid")) (kind == "solid") chips)
                this.chip("de-line-dotted" (PresI18n.t("Dotted")) (kind == "dotted") chips)
                this.chip("de-line-thick" (PresI18n.t("Thick")) (kind == "thick") chips)
                this.button("de-reverse" (PresI18n.t("Reverse")) "outline" chips)
                ln.addChild(chips)
                this.switchOf("de-arrow" (PresI18n.t("Arrow head")) (PresFlowModel.hasArrow(se.op)) ln)
            }
        } {
            pane.addChild((this.text("ce-doc" (PresI18n.t("Click a link's words to change its line.")))))
        }
        def add:EVGElement (this.section(pane (PresI18n.t("New link"))))
        def ar:EVGElement (this.div("ce-row"))
        this.inputWith("de-from" (PresI18n.t("From")) linkFrom (PresI18n.t("from box")) "ce-cell ce-cat" ar)
        this.inputWith("de-to" (PresI18n.t("To")) linkTo (PresI18n.t("to box")) "ce-cell ce-cat" ar)
        this.inputWith("de-elabel" (PresI18n.t("Words on the link")) linkLabel (PresI18n.t("words")) "ce-cell" ar)
        this.button("de-addedge" (PresI18n.t("Add")) "primary" ar)
        add.addChild(ar)
        add.addChild((this.text("ce-doc" (PresI18n.t("Type a box's words (or its id); a name no box has makes a new box.")))))
    }

    ; Edit as text, the note and Done: the diagram's and the table's
    fn blockFoot:void (root:EVGElement) {
        def bottom:EVGElement (this.div("ce-foot"))
        this.button("bk-text" (PresI18n.t("Edit as text")) "outline" bottom)
        def note:string (PresI18n.t("Changes show on the slide right away."))
        if ((strlen message) > 0) {
            note = message
        }
        bottom.addChild((this.copyable("ce-t-msg" "ce-doc" note)))
        bottom.addChild((this.div("ce-grow")))
        this.button("ce-done" (PresI18n.t("Done")) "primary" bottom)
        root.addChild(bottom)
    }

    ; A press on a field that has buttons of its own under the list: true when
    ; what they are for changed.
    fn selectFor:boolean (tid:string) {
        if ((mode == "diagram") && ((indexOf tid "de-n-") == 0)) {
            def id:string (substring tid 5 (strlen tid))
            if (id != selNode) {
                selNode = id
                return true
            }
        }
        if ((mode == "diagram") && ((indexOf tid "de-e-") == 0)) {
            def ei:int (?? (str2int (substring tid 5 (strlen tid))) -1)
            if (ei != selEdge) {
                selEdge = ei
                return true
            }
        }
        if ((mode == "grid") && ((indexOf tid "ge-") == 0)) {
            def parts:[string] (strsplit tid "-")
            def c:int (?? (str2int (itemAt parts ((array_length parts) - 1))) -1)
            if ((c >= 0) && (c != selCol)) {
                selCol = c
                return true
            }
        }
        return false
    }

    fn diagramAct:boolean (tid:string) {
        if (this.listAct(tid)) {
            return true
        }
        if ((indexOf tid "de-look-") == 0) {
            flow.setLook((substring tid 8 (strlen tid)))
            changed = true
            this.rebuild()
            return true
        }
        if ((indexOf tid "de-dir-") == 0) {
            ; a direction chosen is the one drawn, not the one that draws largest
            flow.setDir((substring tid 7 (strlen tid)))
            flow.setFlag("layout" true)
            changed = true
            this.rebuild()
            return true
        }
        if ((indexOf tid "de-f-") == 0) {
            def key:string (substring tid 5 (strlen tid))
            flow.setFlag(key ((flow.flag(key)) == false))
            changed = true
            this.rebuild()
            return true
        }
        if ((indexOf tid "de-shape-") == 0) {
            def s:int (?? (str2int (substring tid 9 (strlen tid))) -1)
            def shapes:[string] (PresChartEditor.shapeList())
            if ((s >= 0) && (s < (array_length shapes))) {
                def parts:[string] (strsplit (itemAt shapes s) " ")
                flow.setShape(selNode (itemAt parts 0) (itemAt parts 1))
                changed = true
            }
            this.rebuild()
            return true
        }
        if ((indexOf tid "de-deln-") == 0) {
            def id:string (substring tid 8 (strlen tid))
            flow.removeNode(id)
            if (id == selNode) {
                selNode = ""
            }
            focusTid = ""
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "de-addnode") {
            def nid:string (flow.addNode((PresI18n.t("New box"))))
            selNode = nid
            this.pageOf((array_length (flow.liveNodes())))
            listPage = (idiv ((array_length (flow.liveNodes())) - 1) 8)
            focusTid = ("de-n-" + nid)
            changed = true
            this.rebuild()
            this.selectAllInField()
            return true
        }
        if ((indexOf tid "de-dele-") == 0) {
            def ei:int (?? (str2int (substring tid 8 (strlen tid))) -1)
            if ((ei >= 0) && (ei < (array_length flow.edges))) {
                flow.removeEdge(ei)
                if (ei == selEdge) {
                    selEdge = -1
                }
                changed = true
            }
            focusTid = ""
            this.rebuild()
            return true
        }
        if ((indexOf tid "de-line-") == 0) {
            if (selEdge >= 0) {
                flow.setEdgeLine(selEdge (substring tid 8 (strlen tid)))
                changed = true
            }
            this.rebuild()
            return true
        }
        if (tid == "de-arrow") {
            if (selEdge >= 0) {
                def se:PresFlowEdge (itemAt flow.edges selEdge)
                flow.setEdgeArrow(selEdge ((PresFlowModel.hasArrow(se.op)) == false))
                changed = true
            }
            this.rebuild()
            return true
        }
        if (tid == "de-reverse") {
            if (selEdge >= 0) {
                flow.reverseEdge(selEdge)
                changed = true
            }
            this.rebuild()
            return true
        }
        if (tid == "de-addedge") {
            this.addLink()
            return true
        }
        return false
    }

    ; The new link's fields made into a link (and its boxes, when new).
    fn addLink:void () {
        if (((strlen (trim linkFrom)) == 0) || ((strlen (trim linkTo)) == 0)) {
            message = (PresI18n.t("Type the box the link starts from and the box it goes to."))
            this.rebuild()
            return
        }
        def a:string (flow.findOrAdd(linkFrom))
        def b:string (flow.findOrAdd(linkTo))
        selEdge = (flow.addEdge(a b (trim linkLabel)))
        linkFrom = ""
        linkTo = ""
        linkLabel = ""
        focusTid = ""
        def n:int (array_length (flow.liveEdges()))
        listPage = (idiv (n - 1) 8)
        changed = true
        this.rebuild()
    }

    ; the pager and Edit as text, for both
    fn listAct:boolean (tid:string) {
        if (tid == "bk-prev") {
            listPage = (listPage - 1)
            focusTid = ""
            this.rebuild()
            return true
        }
        if (tid == "bk-next") {
            listPage = (listPage + 1)
            focusTid = ""
            this.rebuild()
            return true
        }
        if (tid == "bk-text") {
            wantsText = true
            wantsClose = true
            return true
        }
        return false
    }

    ; A field of the diagram or the table into its model.
    fn takeBlock:void (tid:string v:string) {
        if ((indexOf tid "de-n-") == 0) {
            flow.setLabel((substring tid 5 (strlen tid)) v)
            changed = true
            return
        }
        if ((indexOf tid "de-e-") == 0) {
            def ei:int (?? (str2int (substring tid 5 (strlen tid))) -1)
            if ((ei >= 0) && (ei < (array_length flow.edges))) {
                flow.setEdgeLabel(ei v)
                changed = true
            }
            return
        }
        if (tid == "de-from") {
            linkFrom = v
            return
        }
        if (tid == "de-to") {
            linkTo = v
            return
        }
        if (tid == "de-elabel") {
            linkLabel = v
            return
        }
        if ((indexOf tid "ge-h-") == 0) {
            grid.setCell(-1 (?? (str2int (substring tid 5 (strlen tid))) -1) v)
            changed = true
            return
        }
        if ((indexOf tid "ge-c-") == 0) {
            def parts:[string] (strsplit (substring tid 5 (strlen tid)) "-")
            if ((array_length parts) == 2) {
                grid.setCell((?? (str2int (itemAt parts 0)) -1) (?? (str2int (itemAt parts 1)) -1) v)
                changed = true
            }
            return
        }
        if ((indexOf tid "gf-") == 0) {
            grid.setOption((substring tid 3 (strlen tid)) (trim v))
            changed = true
        }
    }

    ; --- a table ------------------------------------------------------------------
    fn gridBody:void (root:EVGElement) {
        def pane:EVGElement (this.div("ce-pane"))
        root.addChild(pane)
        if (grid.kind == "file") {
            this.fileTableBody(pane)
            this.blockFoot(root)
            return
        }
        def cols:int (grid.cols())
        def cls:string "ce-cell"
        if (cols > 5) {
            cls = "ce-cell ce-cell-s"
        }
        def tbl:EVGElement (this.div("ce-grid"))
        def hr:EVGElement (this.div("ce-gridrow ce-gridhead"))
        def c:int 0
        while (c < cols) {
            this.input(("ge-h-" + (to_string c)) (PresI18n.t("Column")) (grid.cell(-1 c)) (cls + " ce-head") hr)
            c = (c + 1)
        }
        tbl.addChild(hr)
        def pages:int (this.pageOf((grid.rowCount())))
        def r:int (listPage * 8)
        def end:int (r + 8)
        while ((r < end) && (r < (grid.rowCount()))) {
            def row:EVGElement (this.div("ce-gridrow"))
            def cc:int 0
            while (cc < cols) {
                this.input(("ge-c-" + (to_string r) + "-" + (to_string cc)) (PresI18n.t("Cell")) (grid.cell(r cc)) cls row)
                cc = (cc + 1)
            }
            def x0:ButtonCtl (this.button(("ge-delrow-" + (to_string r)) "×" "ghost" row))
            UiTree.addClass((unwrap x0.rootEl) "ce-x")
            tbl.addChild(row)
            r = (r + 1)
        }
        pane.addChild(tbl)
        def foot:EVGElement (this.div("ce-row"))
        this.button("ge-addrow" (PresI18n.t("+ Row")) "outline" foot)
        this.button("ge-addcol" (PresI18n.t("+ Column")) "outline" foot)
        this.pager(foot pages)
        pane.addChild(foot)
        if (selCol >= cols) {
            selCol = (cols - 1)
        }
        def name:string (grid.cell(-1 selCol))
        if ((strlen name) == 0) {
            name = (to_string (selCol + 1))
        }
        def al:EVGElement (this.section(pane ((PresI18n.t("Column ")) + "“" + name + "”")))
        def chips:EVGElement (this.div("ce-chips"))
        def a:string (itemAt grid.aligns selCol)
        this.chip("ge-align-" (PresI18n.t("From theme")) ((strlen a) == 0) chips)
        this.chip("ge-align-left" (PresI18n.t("Left")) (a == "left") chips)
        this.chip("ge-align-center" (PresI18n.t("Center")) (a == "center") chips)
        this.chip("ge-align-right" (PresI18n.t("Right")) (a == "right") chips)
        al.addChild(chips)
        def mv:EVGElement (this.div("ce-row"))
        this.button("ge-colleft" (PresI18n.t("Move left")) "outline" mv)
        this.button("ge-colright" (PresI18n.t("Move right")) "outline" mv)
        if (cols > 1) {
            this.button("ge-delcol" (PresI18n.t("Remove column")) "outline" mv)
        }
        al.addChild(mv)
        al.addChild((this.text("ce-doc" (PresI18n.t("Click a cell to choose its column.")))))
    }

    fn fileTableBody:void (pane:EVGElement) {
        def src:EVGElement (this.field((PresI18n.t("File"))))
        src.addChild((this.copyable("ge-t-file" "ce-value" grid.file)))
        pane.addChild(src)
        def opts:EVGElement (this.section(pane (PresI18n.t("On the slide"))))
        def r0:EVGElement (this.field((PresI18n.t("Rows per page"))))
        this.inputWith("gf-rows" (PresI18n.t("Rows per page")) (grid.option("rows")) "8" "ce-cell" r0)
        opts.addChild(r0)
        def r1:EVGElement (this.field((PresI18n.t("Columns"))))
        this.inputWith("gf-columns" (PresI18n.t("Columns")) (grid.option("columns")) (PresI18n.t("all")) "ce-wide" r1)
        opts.addChild(r1)
        def r2:EVGElement (this.field((PresI18n.t("Page in exports"))))
        this.inputWith("gf-page" (PresI18n.t("Page in exports")) (grid.option("page")) "1" "ce-cell" r2)
        opts.addChild(r2)
        if (grid.live()) {
            def r3:EVGElement (this.field((PresI18n.t("Sheet"))))
            this.inputWith("gf-sheet" (PresI18n.t("Sheet")) (grid.option("sheet")) (PresI18n.t("first")) "ce-wide" r3)
            opts.addChild(r3)
        }
        opts.addChild((this.text("ce-doc" (PresI18n.t("Columns by their header, separated by commas. The cells are in the file: edit it on the Files tab.")))))
        def row:EVGElement (this.div("ce-row"))
        this.button("ge-openfile" (PresI18n.t("Open file")) "outline" row)
        pane.addChild(row)
    }

    fn gridAct:boolean (tid:string) {
        if (this.listAct(tid)) {
            return true
        }
        if (tid == "ge-openfile") {
            wantsFile = grid.file
            wantsClose = true
            return true
        }
        if (tid == "ge-addrow") {
            grid.addRow()
            selCol = 0
            listPage = (idiv ((grid.rowCount()) - 1) 8)
            focusTid = ("ge-c-" + (to_string ((grid.rowCount()) - 1)) + "-0")
            changed = true
            this.rebuild()
            return true
        }
        if (tid == "ge-addcol") {
            grid.addCol((PresI18n.t("Column")))
            selCol = ((grid.cols()) - 1)
            focusTid = ("ge-h-" + (to_string selCol))
            changed = true
            this.rebuild()
            this.selectAllInField()
            return true
        }
        if (tid == "ge-delcol") {
            grid.removeCol(selCol)
            focusTid = ""
            changed = true
            this.rebuild()
            return true
        }
        if ((tid == "ge-colleft") || (tid == "ge-colright")) {
            def to:int (selCol - 1)
            if (tid == "ge-colright") {
                to = (selCol + 1)
            }
            if (grid.moveCol(selCol to)) {
                selCol = to
                changed = true
            }
            focusTid = ""
            this.rebuild()
            return true
        }
        if ((indexOf tid "ge-delrow-") == 0) {
            grid.removeRow((?? (str2int (substring tid 10 (strlen tid))) -1))
            focusTid = ""
            changed = true
            this.rebuild()
            return true
        }
        if ((indexOf tid "ge-align-") == 0) {
            grid.setAlign(selCol (substring tid 9 (strlen tid)))
            changed = true
            this.rebuild()
            return true
        }
        return false
    }

    ; --- drawing ------------------------------------------------------------------
    fn page:EVGElement () {
        def r:EVGElement (unwrap host.root)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h false)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def eng:EVGTextEngine (lay.getTextEngine())
        cp.eng = eng
        lay.layout(pg)
        ; the window held to the page measures its title bar, and the body's
        ; bound follows
        if (host.settle()) {
            lay.layout(pg)
        }
        ; a field focused below the fold (Tab) is scrolled into sight
        if (host.focusId != revealed) {
            revealed = host.focusId
            def fe@(optional):EVGElement (host.findEl(pg host.focusId))
            if (((strlen host.focusId) > 0) && (!null? fe)) {
                def f:EVGElement (unwrap fe)
                if (win.revealBody(f.calculatedY (f.calculatedY + f.calculatedHeight))) {
                    lay.layout(pg)
                }
            }
        }
        ; the fields draw their caret and selection on what was laid out
        host.placeText(eng)
        if ((strlen pickFor) > 0) {
            cp.placeThumbs(pg picker)
        }
        host.lastPage = pg
        return pg
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.page())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; --- input --------------------------------------------------------------------
    fn inputFor@(optional):InputCtl (tid:string) {
        def found@(optional):InputCtl
        def i:int 0
        while (i < (array_length inputs)) {
            def c:InputCtl (itemAt inputs i)
            if (c.tid == tid) {
                found = c
            }
            i = (i + 1)
        }
        return found
    }

    fn focusInput:void (tid:string) {
        def prev@(optional):InputCtl (this.inputFor(focusTid))
        if (!null? prev) {
            def pc:InputCtl (unwrap prev)
            pc.focused = false
            pc.pointerUp()
            pc.build()
        }
        cp.leaveField(picker)
        focusTid = tid
        def next@(optional):InputCtl (this.inputFor(tid))
        if (!null? next) {
            def nc:InputCtl (unwrap next)
            nc.focused = true
            nc.moveTo((strlen nc.value) false)
            nc.build()
            host.focus(tid)
        }
        rev = (rev + 1)
    }

    sfn isSlider:boolean (tid:string) {
        if ((indexOf tid "ae-s-") == 0) {
            return true
        }
        if ((indexOf tid "tr-s-") == 0) {
            return true
        }
        if (tid == "ds-size") {
            return true
        }
        return (((((indexOf tid "ce-width") == 0) || ((indexOf tid "ce-height") == 0)) || ((indexOf tid "ce-stroke") == 0)) || ((tid == "ie-width") || (tid == "ie-height")))
    }

    ; A press in app coordinates. What it did is in the model (and `changed`),
    ; or in `wantsClose` / `wantsFresh` for the app to act on.
    ; `clicks` is the page's count (2 a double click, 3 a triple) and `shift`
    ; extends a field's selection.
    fn press:void (px:double py:double clicks:int shift:boolean) {
        if ((this.has(px py)) == false) {
            return
        }
        if (null? host.lastPage) {
            this.page()
        }
        if ((touch && (tapping == false)) && (this.pansAt(px py))) {
            win.beginPan(px py clicks shift)
            return
        }
        def tid:string (host.hitTest(px py))
        ; a press anywhere but in a text lets its selection go
        host.dropSelections(tid)
        if ((strlen tid) == 0) {
            return
        }
        if (tid == (win.closeTid())) {
            wantsClose = true
            return
        }
        if (win.isHandle(tid)) {
            win.press(tid)
            dragX = px
            dragY = py
            rev = (rev + 1)
            return
        }
        ; the part of a control that was hit carries its own id: the control's
        ; is the root's
        def ctlTid:string tid
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            ctlTid = owner.tid
        }
        if (this.pressSelect(ctlTid tid)) {
            return
        }
        ; the colour picker's parts
        if (((strlen pickFor) > 0) && (ctlTid == picker.tid)) {
            if ((strlen focusTid) > 0) {
                this.focusInput("")
            }
            def what:string (cp.press((unwrap host.lastPage) picker tid px py clicks shift))
            if (((what == "sv") || (what == "hue")) || (what == "alpha")) {
                dragPart = what
                this.takeColour((picker.hex()))
            }
            ; a press in one of its fields: a drag from there selects
            if ((what == "field") && ((strlen cp.focused) > 0)) {
                dragPart = "field"
            }
            if (what == "changed") {
                this.takeColour((picker.hex()))
            }
            this.rebuild()
            return
        }
        cp.leaveField(picker)
        ; the crop: a handle or the frame, measured against its rectangle
        if ((this.cropping()) && (ctlTid == crop.tid)) {
            if ((strlen focusTid) > 0) {
                this.focusInput("")
            }
            def f:string (crop.pressAt(tid (this.cropFx(px)) (this.cropFy(py))))
            if ((strlen f) > 0) {
                host.focus(f)
            }
            rev = (rev + 1)
            return
        }
        ; a slider: pressed and dragged through its host
        if (PresChartEditor.isSlider(ctlTid)) {
            host.pressAt(px py)
            keep.restore()
            sliding = true
            this.takeSliders()
            rev = (rev + 1)
            return
        }
        if ((mode == "trace") && (ctlTid == tabs.tid)) {
            host.click(tid)
            keep.restore()
            if (tabs.value != trTab) {
                trTab = tabs.value
                focusTid = ""
                this.rebuild()
            }
            return
        }
        if ((mode == "docset") && (ctlTid == tabs.tid)) {
            host.click(tid)
            keep.restore()
            if (tabs.value != dsTab) {
                dsTab = tabs.value
                focusTid = ""
                pickFor = ""
                this.rebuild()
            }
            return
        }
        if ((mode == "diagram") && (ctlTid == tabs.tid)) {
            host.click(tid)
            keep.restore()
            if (tabs.value != deTab) {
                deTab = tabs.value
                listPage = 0
                focusTid = ""
                this.rebuild()
            }
            return
        }
        if ((mode == "newdeck") && (ctlTid == tabs.tid)) {
            host.click(tid)
            keep.restore()
            if (tabs.value != ndTab) {
                ndTab = tabs.value
                focusTid = ""
                if (ndTab == "name") {
                    focusTid = "nd-name"
                }
                this.rebuild()
            }
            return
        }
        if (ctlTid == tabs.tid) {
            host.click(tid)
            keep.restore()
            if (tabs.value != tab) {
                tab = tabs.value
                focusTid = ""
                pickFor = ""
                this.rebuild()
            }
            return
        }
        ; a text that can be copied: a drag selects, a double click a word,
        ; a triple click the paragraph
        def asText@(optional):TextCtl (this.textFor(ctlTid))
        if (!null? asText) {
            if ((strlen focusTid) > 0) {
                this.focusInput("")
            }
            if (host.textPressAt(tid px py clicks shift)) {
                selecting = ctlTid
            }
            rev = (rev + 1)
            return
        }
        def asInput@(optional):InputCtl (this.inputFor(ctlTid))
        if (!null? asInput) {
            def ic:InputCtl (unwrap asInput)
            if (ic.isClearHit(tid)) {
                if (focusTid != ctlTid) {
                    this.focusInput(ctlTid)
                }
                ic.clearValue()
                keep.restore()
                this.take()
                return
            }
            if (focusTid != ctlTid) {
                ; a box's, a link's or a column's field: the buttons under
                ; the list are for it now
                if (this.selectFor(ctlTid)) {
                    focusTid = ctlTid
                    this.rebuild()
                }
                this.focusInput(ctlTid)
            }
            ; the caret where the press landed, a word or all of it; a drag
            ; from there selects (InputCtl)
            host.textPress(tid px clicks shift)
            selecting = ctlTid
            rev = (rev + 1)
            return
        }
        this.act(ctlTid)
    }

    ; A drag over the field being selected: its caret follows the pointer,
    ; the anchor stays where the press was.
    fn selectTo:void (px:double py:double) {
        if (!null? (this.textFor(selecting))) {
            host.textDragToAt(px py)
            rev = (rev + 1)
            return
        }
        def maybe@(optional):InputCtl (this.inputFor(selecting))
        if (null? maybe) {
            selecting = ""
            return
        }
        def c:InputCtl (unwrap maybe)
        c.textPointerDrag(px)
        rev = (rev + 1)
    }

    ; Ctrl+A in a field: all of its text.
    fn selectAllInField:void () {
        if ((strlen cp.focused) > 0) {
            cp.selectAll(picker)
            rev = (rev + 1)
            return
        }
        def maybe@(optional):InputCtl (this.inputFor(focusTid))
        if (null? maybe) {
            return
        }
        def c:InputCtl (unwrap maybe)
        c.selectAll()
        rev = (rev + 1)
    }

    fn sliderValue:int (tid:string dflt:int) {
        def i:int 0
        while (i < (array_length sliders)) {
            def sc:SliderCtl (itemAt sliders i)
            if (sc.tid == tid) {
                return sc.value
            }
            i = (i + 1)
        }
        return dflt
    }

    ; The sliders' values into the model.
    fn takeSliders:void () {
        if (mode == "docset") {
            def e:int (this.dsEdge())
            def was:int (PresChartEditor.sizeOf((itemAt ds.size e)))
            def v:int (this.sliderValue("ds-size" was))
            if (v != was) {
                if (v <= 0) {
                    set ds.size e ""
                } {
                    set ds.size e ((to_string v) + "pt")
                }
                changed = true
            }
            return
        }
        if (mode == "trace") {
            this.trTake("colorCount" 1)
            this.trTake("threshold" 1)
            this.trTake("turdsize" 1)
            this.trTake("minRegion" 1)
            this.trTake("smooth" 1)
            this.trTake("alphamax" 100)
            this.trTake("opttolerance" 100)
            this.trTake("maxSide" 1)
            return
        }
        if (mode == "adjust") {
            def b:int (this.sliderValue("ae-s-bright" adjBright))
            def c:int (this.sliderValue("ae-s-contrast" adjContrast))
            def s:int (this.sliderValue("ae-s-sat" adjSat))
            def t:int (this.sliderValue("ae-s-temp" adjTemp))
            def g:int (this.sliderValue("ae-s-tint" adjTint))
            if ((((b != adjBright) || (c != adjContrast)) || ((s != adjSat) || (t != adjTemp))) || (g != adjTint)) {
                adjBright = b
                adjContrast = c
                adjSat = s
                adjTemp = t
                adjTint = g
                adjDirty = true
                changed = true
            }
            return
        }
        if (mode == "image") {
            def wp:int (PresImageModel.percent(img.width))
            def wv:int (this.sliderValue("ie-width" -1))
            if ((wv > 0) && ((wv != wp) && ((wv != 100) || ((strlen img.width) > 0)))) {
                img.width = ((to_string wv) + "%")
                changed = true
            }
            def hp:int (PresImageModel.percent(img.height))
            def hv:int (this.sliderValue("ie-height" -1))
            if ((hv >= 0) && (hv != hp)) {
                if (hv == 0) {
                    img.height = ""
                } {
                    img.height = ((to_string hv) + "%")
                }
                changed = true
            }
            return
        }
        if (tab == "kaavio") {
            def sw:int (this.sliderValue("ce-width" (this.sizeW())))
            def sh:int (this.sliderValue("ce-height" (this.sizeH())))
            ; each slider its own size: a height moved leaves a width the
            ; chart does not state to the slide (and the other way round)
            if (sw != (this.sizeW())) {
                model.width = sw
                changed = true
            }
            if (sh != (this.sizeH())) {
                model.height = sh
                changed = true
            }
        }
        if (tab == "ulkoasu") {
            def ss:int (this.sliderValue("ce-stroke" (to_int model.strokeWidth)))
            if ((to_double ss) != model.strokeWidth) {
                model.strokeWidth = (to_double ss)
                changed = true
            }
        }
    }

    ; A press or a drag in the picker's area or bars.
    fn pickAt:void (px:double py:double) {
        if (null? host.lastPage) {
            return
        }
        cp.dragAt((unwrap host.lastPage) picker dragPart px py)
        this.takeColour((picker.hex()))
        this.rebuild()
        this.page()
    }

    fn takeColour:void (hex:string) {
        if (mode == "docset") {
            def e:int (this.dsEdge())
            if ((pickFor == "ds-color") && ((itemAt ds.color e) != hex)) {
                set ds.color e hex
                changed = true
            }
            if ((pickFor == "ds-band") && ((itemAt ds.band e) != hex)) {
                set ds.band e hex
                changed = true
            }
            return
        }
        if (pickFor == "text") {
            if (model.textColor != hex) {
                model.textColor = hex
                changed = true
            }
        } {
            if (model.color != hex) {
                model.color = hex
                model.scheme = ""
                changed = true
            }
        }
    }

    fn openPicker:void (what:string hex:string) {
        pickFor = what
        focusTid = ""
        def start:string hex
        if ((strlen start) == 0) {
            start = "#f97316"
            if ((what == "text") || (what == "ds-color")) {
                start = "#e7eaff"
            }
            if (what == "ds-band") {
                start = "#1e1b4b"
            }
        }
        def fresh (new ColorPickerCtl())
        picker = fresh
        picker.setup("ce-cp" (PresI18n.t("Color")) start (what == "color"))
        picker.inline = true
        def presets:[string] (strsplit "#ef4444,#f97316,#eab308,#22c55e,#06b6d4,#3b82f6,#8b5cf6,#ec4899" ",")
        def i:int 0
        while (i < (array_length presets)) {
            push picker.swatches (itemAt presets i)
            i = (i + 1)
        }
        picker.syncFields()
        this.takeColour((picker.hex()))
        this.rebuild()
    }

    fn act:void (tid:string) {
        message = ""
        if ((mode == "image") && (this.imageAct(tid))) {
            return
        }
        if ((mode == "paste") && (this.pasteAct(tid))) {
            return
        }
        if ((mode == "adjust") && (this.adjustAct(tid))) {
            return
        }
        if ((mode == "trace") && (this.traceAct(tid))) {
            return
        }
        if ((mode == "newdeck") && (this.newDeckAct(tid))) {
            return
        }
        if ((mode == "docset") && (this.docSetAct(tid))) {
            return
        }
        if ((mode == "confirm") && (this.confirmAct(tid))) {
            return
        }
        if ((mode == "diagram") && (this.diagramAct(tid))) {
            return
        }
        if ((mode == "grid") && (this.gridAct(tid))) {
            return
        }
        if (tid == "ce-done") {
            wantsClose = true
            return
        }
        if (tid == "ce-fresh") {
            wantsFresh = true
            return
        }
        if (tid == "ce-openfile") {
            wantsFile = model.dataFile
            wantsClose = true
            return
        }
        if (tid == "ce-autosize") {
            model.width = 0
            model.height = 0
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-kind-") == 0) {
            def k:int (?? (str2int (substring tid 8 (strlen tid))) 0)
            if ((k > 0) && ((k == model.kind) || (model.suits(k)))) {
                model.kind = k
                changed = true
            } {
                message = ((PresChartModel.kindLabel(k)) + (PresI18n.t(" needs ")) + (PresChartModel.kindNeeds(k)) + ".")
            }
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-scheme-") == 0) {
            model.scheme = (substring tid 10 (strlen tid))
            model.color = ""
            if (pickFor == "color") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-pick-color") {
            this.openPicker("color" model.color)
            return
        }
        if (tid == "ce-pick-text") {
            this.openPicker("text" model.textColor)
            return
        }
        if (tid == "ce-pick-done") {
            cp.leaveField(picker)
            pickFor = ""
            this.rebuild()
            return
        }
        if (tid == "ce-text-theme") {
            model.textColor = ""
            if (pickFor == "text") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-effect-") == 0) {
            model.effect = (substring tid 10 (strlen tid))
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-legend") {
            model.legend = (model.legend == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-points") {
            model.points = (model.points == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-glow") {
            model.glow = (model.glow == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-shadow") {
            model.shadow = (model.shadow == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-gradient") {
            model.gradient = (model.gradient == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-addrow") {
            model.addRow()
            focusTid = ("ce-c-" + (to_string ((model.rows()) - 1)) + "-0")
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-addcol") {
            model.addCol(("Sarja " + (to_string (model.cols()))))
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-delcol") {
            model.removeCol(((model.cols()) - 1))
            focusTid = ""
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-delrow-") == 0) {
            model.removeRow((?? (str2int (substring tid 10 (strlen tid))) -1))
            focusTid = ""
            changed = true
            this.rebuild()
            return
        }
    }

    ; The focused field's text into the model.
    fn take:void () {
        def maybe@(optional):InputCtl (this.inputFor(focusTid))
        if (null? maybe) {
            return
        }
        def c:InputCtl (unwrap maybe)
        def v:string c.value
        if (focusTid == "ce-titlein") {
            model.title = v
        }
        if (focusTid == "ie-alt") {
            img.alt = v
        }
        if (focusTid == "pe-alt") {
            pasteAlt = v
        }
        if (focusTid == "nd-name") {
            ndName = v
        }
        if (focusTid == "nd-desc") {
            ndDesc = v
        }
        if (focusTid == "ds-title") {
            ds.title = v
        }
        if ((indexOf focusTid "ds-t-") == 0) {
            def n:int (?? (str2int (substring focusTid 5 (strlen focusTid))) -1)
            if ((n >= 0) && (n < 6)) {
                set ds.texts n v
            }
        }
        if ((mode == "diagram") || (mode == "grid")) {
            this.takeBlock(focusTid v)
            rev = (rev + 1)
            return
        }
        if ((indexOf focusTid "ce-h-") == 0) {
            model.setHeader((?? (str2int (substring focusTid 5 (strlen focusTid))) -1) v)
        }
        if ((indexOf focusTid "ce-c-") == 0) {
            def parts:[string] (strsplit (substring focusTid 5 (strlen focusTid)) "-")
            if ((array_length parts) == 2) {
                model.setCell((?? (str2int (itemAt parts 0)) -1) (?? (str2int (itemAt parts 1)) -1) v)
            }
        }
        changed = true
        rev = (rev + 1)
    }

    fn type:void (s:string) {
        ; one line: the field gets the text whole, so an emoji's two halves
        ; arrive together
        def line:string ""
        def i:int 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            if ((ch != (strfromcode 10)) && (ch != (strfromcode 13))) {
                line = (line + ch)
            }
            i = (i + 1)
        }
        if ((strlen line) > 0) {
            if ((strlen cp.focused) > 0) {
                cp.type(picker line)
            } {
                if ((strlen focusTid) > 0) {
                    host.type(line)
                    keep.restore()
                }
            }
        }
        if ((strlen cp.focused) > 0) {
            this.takeColour((picker.hex()))
            this.rebuild()
            return
        }
        if ((strlen focusTid) > 0) {
            this.take()
        }
    }

    ; The fields in reading order, for Tab and Enter.
    fn nextField:string (from:string back:boolean) {
        def i:int 0
        def at:int -1
        while (i < (array_length inputs)) {
            def ci:InputCtl (itemAt inputs i)
            if (ci.tid == from) {
                at = i
            }
            i = (i + 1)
        }
        def n:int (array_length inputs)
        if (n == 0) {
            return ""
        }
        def j:int (at + 1)
        if back {
            j = (at - 1)
        }
        if (j < 0) {
            j = (n - 1)
        }
        if (j >= n) {
            j = 0
        }
        def cj:InputCtl (itemAt inputs j)
        return cj.tid
    }

    sfn kitKey:string (name:string) {
        if (name == "left") { return "ArrowLeft" }
        if (name == "right") { return "ArrowRight" }
        if (name == "up") { return "ArrowUp" }
        if (name == "down") { return "ArrowDown" }
        if (name == "home") { return "Home" }
        if (name == "end") { return "End" }
        if (name == "backspace") { return "Backspace" }
        if (name == "delete") { return "Delete" }
        if (name == "enter") { return "Enter" }
        if (name == "escape") { return "Escape" }
        return ""
    }

    ; A key by the app's names. True when the editor used it.
    fn key:boolean (name:string shift:boolean ctrl:boolean) {
        ; a field of the picker
        if ((strlen cp.focused) > 0) {
            if (name == "escape") {
                cp.leaveField(picker)
                this.rebuild()
                return true
            }
            def k:string (PresChartEditor.kitKey(name))
            if ((strlen k) > 0) {
                cp.keyWith(picker k shift ctrl)
                this.takeColour((picker.hex()))
                this.rebuild()
            }
            return true
        }
        if (name == "escape") {
            wantsClose = true
            return true
        }
        ; a new presentation: Enter makes it
        if ((mode == "newdeck") && (name == "enter")) {
            rmAct = ""
            wantsCreate = true
            wantsClose = true
            return true
        }
        ; the picture on its way in (or edited): arrows move the crop, Enter
        ; adds (saves) it
        if ((this.cropping()) && ((strlen focusTid) == 0)) {
            if (name == "enter") {
                if (mode == "adjust") {
                    wantsSave = true
                } {
                    wantsPlace = true
                    pasteTrace = (pasteVector && (pasteTo == "slide"))
                }
                wantsClose = true
                return true
            }
            def ak:string (PresChartEditor.kitKey(name))
            if ((((ak == "ArrowLeft") || (ak == "ArrowRight")) || (ak == "ArrowUp")) || (ak == "ArrowDown")) {
                crop.keyDownWith((crop.boxTid()) ak shift ctrl)
                rev = (rev + 1)
                return true
            }
        }
        if ((name == "tab") || (name == "enter")) {
            if ((strlen focusTid) > 0) {
                this.focusInput((this.nextField(focusTid shift)))
            }
            return true
        }
        if ((strlen focusTid) == 0) {
            return true
        }
        def kit:string (PresChartEditor.kitKey(name))
        if (((strlen kit) > 0) && ((kit != "ArrowUp") && (kit != "ArrowDown"))) {
            host.keyWith(kit shift ctrl)
            keep.restore()
            if ((name == "backspace") || (name == "delete")) {
                this.take()
            }
            rev = (rev + 1)
        }
        return true
    }

    sfn cropCursor:string (part:string) {
        if (part == "move") {
            return "move"
        }
        if ((part == "nw") || (part == "se")) {
            return "nwse-resize"
        }
        if ((part == "ne") || (part == "sw")) {
            return "nesw-resize"
        }
        if ((part == "n") || (part == "s")) {
            return "ns-resize"
        }
        if ((part == "e") || (part == "w")) {
            return "ew-resize"
        }
        return "default"
    }

    fn cursorAt:string (px:double py:double) {
        if ((this.has(px py)) == false) {
            return ""
        }
        if (null? host.lastPage) {
            return "default"
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return "default"
        }
        if (win.isHandle(tid)) {
            return "move"
        }
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            if ((this.cropping()) && (owner.tid == crop.tid)) {
                return (PresChartEditor.cropCursor((crop.partOf(tid))))
            }
            if (owner.tid == picker.tid) {
                def part:string (picker.partOf(tid))
                if ((part == "f0") || ((part == "f1") || ((part == "f2") || (part == "f3")))) {
                    return "text"
                }
                if (part == "sv") {
                    return "crosshair"
                }
                return "pointer"
            }
            def asInput@(optional):InputCtl (this.inputFor(owner.tid))
            if (!null? asInput) {
                return "text"
            }
            if (!null? (this.textFor(owner.tid))) {
                return "text"
            }
        }
        return "pointer"
    }
}
