        def names:[string] (strsplit (PresChartModel.schemes()) " ")
        def s:int 0
        while (s < (array_length names)) {
            def nm:string (itemAt names s)
            this.chip(("ce-scheme-" + nm) nm (nm == model.scheme) cols)
            s = (s + 1)
        }
        col.addChild(cols)

        def tx:EVGElement (this.section(pane (PresI18n.t("Text color"))))
        def tr:EVGElement (this.div("ce-chips"))
        this.chip("ce-text-theme" (PresI18n.t("From theme")) ((strlen model.textColor) == 0) tr)
        this.chip("ce-pick-text" (PresI18n.t("Custom color")) ((strlen model.textColor) > 0) tr)
        if ((strlen model.textColor) > 0) {
            tr.addChild((this.swatch(model.textColor)))
        }
        tx.addChild(tr)

        def st:EVGElement (this.section(pane (PresI18n.t("Style on slide"))))
        def ef:EVGElement (this.div("ce-chips"))
        def effects:[string] (strsplit ",flat,forge,neon,glass" ",")
        def effectNames:[string] (strsplit ((PresI18n.t("From theme")) + "," + (PresI18n.t("Flat")) + "," + (PresI18n.t("Forge")) + "," + (PresI18n.t("Neon")) + "," + (PresI18n.t("Glass"))) ",")
        def e:int 0
        while (e < (array_length effects)) {
            this.chip(("ce-effect-" + (itemAt effects e)) (itemAt effectNames e) ((itemAt effects e) == model.effect) ef)
            e = (e + 1)
        }
        st.addChild(ef)
        def sw:EVGElement (this.div("ce-row ce-switches"))
        this.switchOf("ce-glow" (PresI18n.t("Glow")) model.glow sw)
        this.switchOf("ce-shadow" (PresI18n.t("Shadow")) model.shadow sw)
        this.switchOf("ce-gradient" (PresI18n.t("Gradient")) model.gradient sw)
        st.addChild(sw)
        if ((model.kind >= 6) && (model.kind <= 9)) {
            def wr:EVGElement (this.field((PresI18n.t("Line width"))))
            this.slider("ce-stroke" (PresI18n.t("Line width")) (to_int model.strokeWidth) 0 10 1 wr)
            def label:string ((to_string (to_int model.strokeWidth)) + " px")
            if (model.strokeWidth <= 0.0) {
                label = (PresI18n.t("default"))
            }
            wr.addChild((this.text("ce-value" label)))
            st.addChild(wr)
            def pr:EVGElement (this.div("ce-row ce-switches"))
            this.switchOf("ce-points" (PresI18n.t("Points")) model.points pr)
            st.addChild(pr)
        }
    }

    ; The picker: a card of its own beside the window (on its left when
    ; there is no room on the right), so the window keeps its height.
    fn pickerCard:EVGElement () {
        picker.inline = true
        def card:EVGElement (this.div("ce-pickcard"))
        card.id = "ce-pickcard"
        def head:EVGElement (this.div("ce-pickhead"))
        def what:string (PresI18n.t("Chart color"))
        if ((pickFor == "text") || (pickFor == "ds-color")) {
            what = (PresI18n.t("Text color"))
        }
        if (pickFor == "ds-band") {
            what = (PresI18n.t("Band color"))
        }
        head.addChild((this.text("ce-picktitle" what)))
        head.addChild((this.div("ce-grow")))
        this.button("ce-pick-done" (PresI18n.t("Done")) "primary" head)
        card.addChild(head)
        card.addChild((cp.panel(picker)))
        push host.ctls picker
        def px:double ((x + 560.0) + 12.0)
        if ((px + 280.0) > w) {
            px = ((x - 280.0) - 12.0)
        }
        if (px < 0.0) {
            px = (w - 280.0)
        }
        UiTree.surface(card "free" "start")
        card.overlayX = px
        card.overlayY = (y + 44.0)
        return card
    }

    fn dataTab:void (pane:EVGElement) {
        if model.lookOnly {
            pane.addChild((this.text("ce-doc" model.why)))
            if model.dataLive {
                def live:EVGElement (this.field((PresI18n.t("Data source"))))
                live.addChild((this.text("ce-value" model.dataFile)))
                pane.addChild(live)
                pane.addChild((this.text("ce-doc" (PresI18n.t("The data is fetched from this address each time the presentation opens. While presenting, R (or ⟳) fetches it again. PDF and PPTX keep the data as it was when exported.")))))
            }
            if (((strlen model.dataFile) > 0) && (model.dataLive == false)) {
                def src:EVGElement (this.field((PresI18n.t("File"))))
                src.addChild((this.text("ce-value" model.dataFile)))
                pane.addChild(src)
                pane.addChild((this.text("ce-doc" (PresI18n.t("The data is in a file of the presentation: edit it on the Files tab. The chart redraws when the file changes.")))))
            }
            if ((strlen model.dataFile) == 0) {
                pane.addChild((this.text("ce-doc" (PresI18n.t("The data and how it is processed are in the chart's JSON on the Markdown tab.")))))
            }
            def row:EVGElement (this.div("ce-row"))
            if (((strlen model.dataFile) > 0) && (model.dataLive == false)) {
                this.button("ce-openfile" (PresI18n.t("Open file")) "primary" row)
            }
            this.button("ce-fresh" (PresI18n.t("Replace with sample table")) "outline" row)
            pane.addChild(row)
            return
        }
        pane.addChild((this.text("ce-doc" (PresI18n.t("First column: categories. Other columns: series.")))))
        def grid:EVGElement (this.div("ce-grid"))
        def hr:EVGElement (this.div("ce-gridrow ce-gridhead"))
        def c:int 0
        while (c < (model.cols())) {
            this.input(("ce-h-" + (to_string c)) (PresI18n.t("Column")) (itemAt model.header c) "ce-cell ce-head" hr)
            c = (c + 1)
        }
        this.button("ce-addcol" (PresI18n.t("+ Series")) "ghost" hr)
        grid.addChild(hr)
        def r:int 0
        while (r < (model.rows())) {
            def row:EVGElement (this.div("ce-gridrow"))
            def cc:int 0
            while (cc < (model.cols())) {
                def cls:string "ce-cell"
                if (cc == 0) {
                    cls = "ce-cell ce-cat"
                }
                this.input(("ce-c-" + (to_string r) + "-" + (to_string cc)) (PresI18n.t("Cell")) (model.cell(r cc)) cls row)
                cc = (cc + 1)
            }
            def x0:ButtonCtl (this.button(("ce-delrow-" + (to_string r)) "×" "ghost" row))
            UiTree.addClass((unwrap x0.rootEl) "ce-x")
            grid.addChild(row)
            r = (r + 1)
        }
        pane.addChild(grid)
        def foot:EVGElement (this.div("ce-row"))
        this.button("ce-addrow" (PresI18n.t("+ Row")) "outline" foot)
        if ((model.cols()) > 2) {
            this.button("ce-delcol" (PresI18n.t("− Last series")) "outline" foot)
        }
        pane.addChild(foot)
    }

    ; --- drawing ------------------------------------------------------------------
    fn page:EVGElement () {
        def r:EVGElement (unwrap host.root)
        def s:EVGStyleSheet (unwrap host.sheet)
        s.setViewport(w h false)
        host.markStates(r)
        s.applyTree(r host.theme)
        def pg (EVGElement.createDiv())
        pg.id = "page"
        pg.width = (EVGUnit.px(w))
        pg.height = (EVGUnit.px(h))
        pg.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        ; the focused field's caret where its caret is, not after the text
        def eng:EVGTextEngine (lay.getTextEngine())
        cp.eng = eng
        def i:int 0
        while (i < (array_length inputs)) {
            def c:InputCtl (itemAt inputs i)
            def car:EVGElement (unwrap c.caretEl)
            if (c.tid == focusTid) {
                c.ensureCaretVisible(eng)
                def box:EVGElement (unwrap c.rootEl)
                box.position = "relative"
                ; absolute children are placed from the box's content edge,
                ; where the text starts: the caret is the text's own width in
                car.position = "absolute"
                car.left = (EVGUnit.px(((c.caretXAt(eng c.caret)) - c.scrollX)))
                car.top = (EVGUnit.px(6.0))
                if (c.hasSelection()) {
                    def sx:double (c.caretXAt(eng (c.selStart())))
                    def ex:double (c.caretXAt(eng (c.selEnd())))
                    def band:EVGElement (this.div("ce-selband"))
                    band.position = "absolute"
                    band.left = (EVGUnit.px((sx - c.scrollX)))
                    band.width = (EVGUnit.px((ex - sx)))
                    band.top = (EVGUnit.px(6.0))
                    ; under the text, so first
                    def kids:[EVGElement]
                    def k:int 0
                    while (k < (box.getChildCount())) {
                        push kids (box.getChild(k))
                        k = (k + 1)
                    }
                    UiTree.clearChildren(box)
                    box.addChild(band)
                    def j:int 0
                    while (j < (array_length kids)) {
                        box.addChild((itemAt kids j))
                        j = (j + 1)
                    }
                }
            } {
                car.width = (EVGUnit.px(0.0))
            }
            i = (i + 1)
        }
        lay.layout(pg)
        if ((strlen pickFor) > 0) {
            cp.placeThumbs(pg picker)
        }
        host.lastPage = pg
        return pg
    }

    fn displayList:EVGDisplayList () {
        def pg:EVGElement (this.page())
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(pg)
        return dl
    }

    ; --- input --------------------------------------------------------------------
    fn inputFor@(optional):InputCtl (tid:string) {
        def found@(optional):InputCtl
        def i:int 0
        while (i < (array_length inputs)) {
            def c:InputCtl (itemAt inputs i)
            if (c.tid == tid) {
                found = c
            }
            i = (i + 1)
        }
        return found
    }

    fn focusInput:void (tid:string) {
        def prev@(optional):InputCtl (this.inputFor(focusTid))
        if (!null? prev) {
            def pc:InputCtl (unwrap prev)
            UiTree.removeClass((unwrap pc.rootEl) "ce-focus")
        }
        cp.leaveField(picker)
        focusTid = tid
        def next@(optional):InputCtl (this.inputFor(tid))
        if (!null? next) {
            def nc:InputCtl (unwrap next)
            UiTree.addClass((unwrap nc.rootEl) "ce-focus")
            nc.moveTo((strlen nc.value) false)
            host.focus(tid)
        }
        rev = (rev + 1)
    }

    sfn isSlider:boolean (tid:string) {
        if ((indexOf tid "ae-s-") == 0) {
            return true
        }
        if (tid == "ds-size") {
            return true
        }
        return (((((indexOf tid "ce-width") == 0) || ((indexOf tid "ce-height") == 0)) || ((indexOf tid "ce-stroke") == 0)) || ((tid == "ie-width") || (tid == "ie-height")))
    }

    ; A press in app coordinates. What it did is in the model (and `changed`),
    ; or in `wantsClose` / `wantsFresh` for the app to act on.
    fn press:void (px:double py:double) {
        if ((this.has(px py)) == false) {
            return
        }
        if (null? host.lastPage) {
            this.page()
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return
        }
        if (tid == (win.closeTid())) {
            wantsClose = true
            return
        }
        if (win.isHandle(tid)) {
            win.press(tid)
            dragX = px
            dragY = py
            rev = (rev + 1)
            return
        }
        ; the part of a control that was hit carries its own id: the control's
        ; is the root's
        def ctlTid:string tid
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            ctlTid = owner.tid
        }
        ; the colour picker's parts
        if (((strlen pickFor) > 0) && (ctlTid == picker.tid)) {
            if ((strlen focusTid) > 0) {
                this.focusInput("")
            }
            def what:string (cp.press((unwrap host.lastPage) picker tid px py))
            if (((what == "sv") || (what == "hue")) || (what == "alpha")) {
                dragPart = what
                this.takeColour((picker.hex()))
            }
            if (what == "changed") {
                this.takeColour((picker.hex()))
            }
            this.rebuild()
            return
        }
        cp.leaveField(picker)
        ; the crop: a handle or the frame, measured against its rectangle
        if ((this.cropping()) && (ctlTid == crop.tid)) {
            if ((strlen focusTid) > 0) {
                this.focusInput("")
            }
            def f:string (crop.pressAt(tid (this.cropFx(px)) (this.cropFy(py))))
            if ((strlen f) > 0) {
                host.focus(f)
            }
            rev = (rev + 1)
            return
        }
        ; a slider: pressed and dragged through its host
        if (PresChartEditor.isSlider(ctlTid)) {
            host.pressAt(px py)
            keep.restore()
            sliding = true
            this.takeSliders()
            rev = (rev + 1)
            return
        }
        if ((mode == "docset") && (ctlTid == tabs.tid)) {
            host.click(tid)
            keep.restore()
            if (tabs.value != dsTab) {
                dsTab = tabs.value
                focusTid = ""
                pickFor = ""
                this.rebuild()
            }
            return
        }
        if ((mode == "newdeck") && (ctlTid == tabs.tid)) {
            host.click(tid)
            keep.restore()
            if (tabs.value != ndTab) {
                ndTab = tabs.value
                focusTid = ""
                if (ndTab == "name") {
                    focusTid = "nd-name"
                }
                this.rebuild()
            }
            return
        }
        if (ctlTid == tabs.tid) {
            host.click(tid)
            keep.restore()
            if (tabs.value != tab) {
                tab = tabs.value
                focusTid = ""
                pickFor = ""
                this.rebuild()
            }
            return
        }
        def asInput@(optional):InputCtl (this.inputFor(ctlTid))
        if (!null? asInput) {
            def ic:InputCtl (unwrap asInput)
            if (ic.isClearHit(tid)) {
                if (focusTid != ctlTid) {
                    this.focusInput(ctlTid)
                }
                ic.clearValue()
                keep.restore()
                this.take()
                return
            }
            if (focusTid != ctlTid) {
                this.focusInput(ctlTid)
            }
            ; the caret where the press landed; a drag from there selects
            ic.placeCaret((this.indexIn(ic px)) false)
            selecting = ctlTid
            rev = (rev + 1)
            return
        }
        this.act(ctlTid)
    }

    ; The text engine the page lays out with, for measuring a field's run.
    fn engine:EVGTextEngine () {
        def lay (new EVGLayout())
        if (!null? measurer) {
            lay.setMeasurer((unwrap measurer))
        }
        return (lay.getTextEngine())
    }

    ; Which character of a field `px` (app coordinates) is at, measured on
    ; the box as last laid out.
    fn indexIn:int (c:InputCtl px:double) {
        def box:EVGElement (unwrap c.rootEl)
        return (InputCtl.indexAtPageX((this.engine()) c box px))
    }

    ; A drag over the field being selected: its caret follows the pointer,
    ; the anchor stays where the press was.
    fn selectTo:void (px:double) {
        def maybe@(optional):InputCtl (this.inputFor(selecting))
        if (null? maybe) {
            selecting = ""
            return
        }
        def c:InputCtl (unwrap maybe)
        c.placeCaret((this.indexIn(c px)) true)
        rev = (rev + 1)
    }

    ; Ctrl+A in a field: all of its text.
    fn selectAllInField:void () {
        def maybe@(optional):InputCtl (this.inputFor(focusTid))
        if (null? maybe) {
            return
        }
        def c:InputCtl (unwrap maybe)
        c.selectAll()
        rev = (rev + 1)
    }

    fn sliderValue:int (tid:string dflt:int) {
        def i:int 0
        while (i < (array_length sliders)) {
            def sc:SliderCtl (itemAt sliders i)
            if (sc.tid == tid) {
                return sc.value
            }
            i = (i + 1)
        }
        return dflt
    }

    ; The sliders' values into the model.
    fn takeSliders:void () {
        if (mode == "docset") {
            def e:int (this.dsEdge())
            def was:int (PresChartEditor.sizeOf((itemAt ds.size e)))
            def v:int (this.sliderValue("ds-size" was))
            if (v != was) {
                if (v <= 0) {
                    set ds.size e ""
                } {
                    set ds.size e ((to_string v) + "pt")
                }
                changed = true
            }
            return
        }
        if (mode == "adjust") {
            def b:int (this.sliderValue("ae-s-bright" adjBright))
            def c:int (this.sliderValue("ae-s-contrast" adjContrast))
            def s:int (this.sliderValue("ae-s-sat" adjSat))
            def t:int (this.sliderValue("ae-s-temp" adjTemp))
            def g:int (this.sliderValue("ae-s-tint" adjTint))
            if ((((b != adjBright) || (c != adjContrast)) || ((s != adjSat) || (t != adjTemp))) || (g != adjTint)) {
                adjBright = b
                adjContrast = c
                adjSat = s
                adjTemp = t
                adjTint = g
                adjDirty = true
                changed = true
            }
            return
        }
        if (mode == "image") {
            def wp:int (PresImageModel.percent(img.width))
            def wv:int (this.sliderValue("ie-width" -1))
            if ((wv > 0) && ((wv != wp) && ((wv != 100) || ((strlen img.width) > 0)))) {
                img.width = ((to_string wv) + "%")
                changed = true
            }
            def hp:int (PresImageModel.percent(img.height))
            def hv:int (this.sliderValue("ie-height" -1))
            if ((hv >= 0) && (hv != hp)) {
                if (hv == 0) {
                    img.height = ""
                } {
                    img.height = ((to_string hv) + "%")
                }
                changed = true
            }
            return
        }
        if (tab == "kaavio") {
            def sw:int (this.sliderValue("ce-width" (this.sizeW())))
            def sh:int (this.sliderValue("ce-height" (this.sizeH())))
            if ((sw != (this.sizeW())) || (sh != (this.sizeH()))) {
                model.width = sw
                model.height = sh
                changed = true
            }
        }
        if (tab == "ulkoasu") {
            def ss:int (this.sliderValue("ce-stroke" (to_int model.strokeWidth)))
            if ((to_double ss) != model.strokeWidth) {
                model.strokeWidth = (to_double ss)
                changed = true
            }
        }
    }

    ; A press or a drag in the picker's area or bars.
    fn pickAt:void (px:double py:double) {
        if (null? host.lastPage) {
            return
        }
        cp.dragAt((unwrap host.lastPage) picker dragPart px py)
        this.takeColour((picker.hex()))
        this.rebuild()
        this.page()
    }

    fn takeColour:void (hex:string) {
        if (mode == "docset") {
            def e:int (this.dsEdge())
            if ((pickFor == "ds-color") && ((itemAt ds.color e) != hex)) {
                set ds.color e hex
                changed = true
            }
            if ((pickFor == "ds-band") && ((itemAt ds.band e) != hex)) {
                set ds.band e hex
                changed = true
            }
            return
        }
        if (pickFor == "text") {
            if (model.textColor != hex) {
                model.textColor = hex
                changed = true
            }
        } {
            if (model.color != hex) {
                model.color = hex
                model.scheme = ""
                changed = true
            }
        }
    }

    fn openPicker:void (what:string hex:string) {
        pickFor = what
        focusTid = ""
        def start:string hex
        if ((strlen start) == 0) {
            start = "#f97316"
            if ((what == "text") || (what == "ds-color")) {
                start = "#e7eaff"
            }
            if (what == "ds-band") {
                start = "#1e1b4b"
            }
        }
        def fresh (new ColorPickerCtl())
        picker = fresh
        picker.setup("ce-cp" (PresI18n.t("Color")) start (what == "color"))
        picker.inline = true
        picker.hexBoxW = 150.0
        picker.numBoxW = 30.0
        def presets:[string] (strsplit "#ef4444,#f97316,#eab308,#22c55e,#06b6d4,#3b82f6,#8b5cf6,#ec4899" ",")
        def i:int 0
        while (i < (array_length presets)) {
            push picker.swatches (itemAt presets i)
            i = (i + 1)
        }
        picker.syncFields()
        this.takeColour((picker.hex()))
        this.rebuild()
    }

    fn act:void (tid:string) {
        message = ""
        if ((mode == "image") && (this.imageAct(tid))) {
            return
        }
        if ((mode == "paste") && (this.pasteAct(tid))) {
            return
        }
        if ((mode == "adjust") && (this.adjustAct(tid))) {
            return
        }
        if ((mode == "newdeck") && (this.newDeckAct(tid))) {
            return
        }
        if ((mode == "docset") && (this.docSetAct(tid))) {
            return
        }
        if ((mode == "confirm") && (this.confirmAct(tid))) {
            return
        }
        if (tid == "ce-done") {
            wantsClose = true
            return
        }
        if (tid == "ce-fresh") {
            wantsFresh = true
            return
        }
        if (tid == "ce-openfile") {
            wantsFile = model.dataFile
            wantsClose = true
            return
        }
        if (tid == "ce-autosize") {
            model.width = 0
            model.height = 0
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-kind-") == 0) {
            def k:int (?? (str2int (substring tid 8 (strlen tid))) 0)
            if ((k > 0) && ((k == model.kind) || (model.suits(k)))) {
                model.kind = k
                changed = true
            } {
                message = ((PresChartModel.kindLabel(k)) + (PresI18n.t(" needs ")) + (PresChartModel.kindNeeds(k)) + ".")
            }
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-scheme-") == 0) {
            model.scheme = (substring tid 10 (strlen tid))
            model.color = ""
            if (pickFor == "color") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-pick-color") {
            this.openPicker("color" model.color)
            return
        }
        if (tid == "ce-pick-text") {
            this.openPicker("text" model.textColor)
            return
        }
        if (tid == "ce-pick-done") {
            cp.leaveField(picker)
            pickFor = ""
            this.rebuild()
            return
        }
        if (tid == "ce-text-theme") {
            model.textColor = ""
            if (pickFor == "text") {
                pickFor = ""
            }
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-effect-") == 0) {
            model.effect = (substring tid 10 (strlen tid))
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-legend") {
            model.legend = (model.legend == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-points") {
            model.points = (model.points == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-glow") {
            model.glow = (model.glow == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-shadow") {
            model.shadow = (model.shadow == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-gradient") {
            model.gradient = (model.gradient == false)
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-addrow") {
            model.addRow()
            focusTid = ("ce-c-" + (to_string ((model.rows()) - 1)) + "-0")
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-addcol") {
            model.addCol(("Sarja " + (to_string (model.cols()))))
            changed = true
            this.rebuild()
            return
        }
        if (tid == "ce-delcol") {
            model.removeCol(((model.cols()) - 1))
            focusTid = ""
            changed = true
            this.rebuild()
            return
        }
        if ((indexOf tid "ce-delrow-") == 0) {
            model.removeRow((?? (str2int (substring tid 10 (strlen tid))) -1))
            focusTid = ""
            changed = true
            this.rebuild()
            return
        }
    }

    ; The focused field's text into the model.
    fn take:void () {
        def maybe@(optional):InputCtl (this.inputFor(focusTid))
        if (null? maybe) {
            return
        }
        def c:InputCtl (unwrap maybe)
        def v:string c.value
        if (focusTid == "ce-titlein") {
            model.title = v
        }
        if (focusTid == "ie-alt") {
            img.alt = v
        }
        if (focusTid == "pe-alt") {
            pasteAlt = v
        }
        if (focusTid == "nd-name") {
            ndName = v
        }
        if (focusTid == "ds-title") {
            ds.title = v
        }
        if ((indexOf focusTid "ds-t-") == 0) {
            def n:int (?? (str2int (substring focusTid 5 (strlen focusTid))) -1)
            if ((n >= 0) && (n < 6)) {
                set ds.texts n v
            }
        }
        if ((indexOf focusTid "ce-h-") == 0) {
            model.setHeader((?? (str2int (substring focusTid 5 (strlen focusTid))) -1) v)
        }
        if ((indexOf focusTid "ce-c-") == 0) {
            def parts:[string] (strsplit (substring focusTid 5 (strlen focusTid)) "-")
            if ((array_length parts) == 2) {
                model.setCell((?? (str2int (itemAt parts 0)) -1) (?? (str2int (itemAt parts 1)) -1) v)
            }
        }
        changed = true
        rev = (rev + 1)
    }

    fn type:void (s:string) {
        def i:int 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            if ((ch != (strfromcode 10)) && (ch != (strfromcode 13))) {
                if ((strlen cp.focused) > 0) {
                    cp.type(picker ch)
                } {
                    if ((strlen focusTid) > 0) {
                        host.type(ch)
                        keep.restore()
                    }
                }
            }
            i = (i + 1)
        }
        if ((strlen cp.focused) > 0) {
            this.takeColour((picker.hex()))
            this.rebuild()
            return
        }
        if ((strlen focusTid) > 0) {
            this.take()
        }
    }

    ; The fields in reading order, for Tab and Enter.
    fn nextField:string (from:string back:boolean) {
        def i:int 0
        def at:int -1
        while (i < (array_length inputs)) {
            def ci:InputCtl (itemAt inputs i)
            if (ci.tid == from) {
                at = i
            }
            i = (i + 1)
        }
        def n:int (array_length inputs)
        if (n == 0) {
            return ""
        }
        def j:int (at + 1)
        if back {
            j = (at - 1)
        }
        if (j < 0) {
            j = (n - 1)
        }
        if (j >= n) {
            j = 0
        }
        def cj:InputCtl (itemAt inputs j)
        return cj.tid
    }

    sfn kitKey:string (name:string) {
        if (name == "left") { return "ArrowLeft" }
        if (name == "right") { return "ArrowRight" }
        if (name == "up") { return "ArrowUp" }
        if (name == "down") { return "ArrowDown" }
        if (name == "home") { return "Home" }
        if (name == "end") { return "End" }
        if (name == "backspace") { return "Backspace" }
        if (name == "delete") { return "Delete" }
        if (name == "enter") { return "Enter" }
        if (name == "escape") { return "Escape" }
        return ""
    }

    ; A key by the app's names. True when the editor used it.
    fn key:boolean (name:string shift:boolean ctrl:boolean) {
        ; a field of the picker
        if ((strlen cp.focused) > 0) {
            if (name == "escape") {
                cp.leaveField(picker)
                this.rebuild()
                return true
            }
            def k:string (PresChartEditor.kitKey(name))
            if ((strlen k) > 0) {
                cp.keyWith(picker k shift ctrl)
                this.takeColour((picker.hex()))
                this.rebuild()
            }
            return true
        }
        if (name == "escape") {
            wantsClose = true
            return true
        }
        ; a new presentation: Enter makes it
        if ((mode == "newdeck") && (name == "enter")) {
            wantsCreate = true
            wantsClose = true
            return true
        }
        ; the picture on its way in (or edited): arrows move the crop, Enter
        ; adds (saves) it
        if ((this.cropping()) && ((strlen focusTid) == 0)) {
            if (name == "enter") {
                if (mode == "adjust") {
                    wantsSave = true
                } {
                    wantsPlace = true
                }
                wantsClose = true
                return true
            }
            def ak:string (PresChartEditor.kitKey(name))
            if ((((ak == "ArrowLeft") || (ak == "ArrowRight")) || (ak == "ArrowUp")) || (ak == "ArrowDown")) {
                crop.keyDownWith((crop.boxTid()) ak shift ctrl)
                rev = (rev + 1)
                return true
            }
        }
        if ((name == "tab") || (name == "enter")) {
            if ((strlen focusTid) > 0) {
                this.focusInput((this.nextField(focusTid shift)))
            }
            return true
        }
        if ((strlen focusTid) == 0) {
            return true
        }
        def kit:string (PresChartEditor.kitKey(name))
        if (((strlen kit) > 0) && ((kit != "ArrowUp") && (kit != "ArrowDown"))) {
            host.keyWith(kit shift ctrl)
            keep.restore()
            if ((name == "backspace") || (name == "delete")) {
                this.take()
            }
            rev = (rev + 1)
        }
        return true
    }

    sfn cropCursor:string (part:string) {
        if (part == "move") {
            return "move"
        }
        if ((part == "nw") || (part == "se")) {
            return "nwse-resize"
        }
        if ((part == "ne") || (part == "sw")) {
            return "nesw-resize"
        }
        if ((part == "n") || (part == "s")) {
            return "ns-resize"
        }
        if ((part == "e") || (part == "w")) {
            return "ew-resize"
        }
        return "default"
    }

    fn cursorAt:string (px:double py:double) {
        if ((this.has(px py)) == false) {
            return ""
        }
        if (null? host.lastPage) {
            return "default"
        }
        def tid:string (host.hitTest(px py))
        if ((strlen tid) == 0) {
            return "default"
        }
        if (win.isHandle(tid)) {
            return "move"
        }
        def maybe@(optional):UiCtl (host.ctlFor(tid))
        if (!null? maybe) {
            def owner:UiCtl (unwrap maybe)
            if ((this.cropping()) && (owner.tid == crop.tid)) {
                return (PresChartEditor.cropCursor((crop.partOf(tid))))
            }
            if (owner.tid == picker.tid) {
                def part:string (picker.partOf(tid))
                if ((part == "f0") || ((part == "f1") || ((part == "f2") || (part == "f3")))) {
                    return "text"
                }
                if (part == "sv") {
                    return "crosshair"
                }
                return "pointer"
            }
            def asInput@(optional):InputCtl (this.inputFor(owner.tid))
            if (!null? asInput) {
                return "text"
            }
        }
        return "pointer"
    }
}
