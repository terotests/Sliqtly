; SPDX-License-Identifier: AGPL-3.0-or-later
; ============================================================================
; PresSmartArt — a SmartArt diagram on a slide, from a file in the deck
; ============================================================================
;
; ````markdown
; ![The release process](media/release.xml){width=80% layout=process1 colors=colorful1}
; ````
;
; The file is a SmartArt data model (`dgm:dataModel`), or a whole PowerPoint
; diagram as one Flat OPC file (data, layout, style, colours, drawing:
; SaWhole), kept like a picture.
; The Markdown module never learns what it is: it lays the reference out as a
; picture box, at the natural size the file was registered with (16:9,
; SaFile), and `{width}`, `{height}` and `{align}` work as they do for any
; picture. This module draws the diagram into that box, with RangerPPTX's
; layout engine (gallery/pptx/smartart), in the theme's colours:
;
;   accent1 … accent6   the theme's `figure { colors: … }`, in order, round
;                       again when there are fewer than six
;   lt1 / dk1           the page's paper and the document's ink
;
; The text is measured with the deck's own fonts (the TTF measurer the
; slide's text is laid out with), in the theme's figure font or the body
; font, and drawn in that family, so it is set at the size that fits. Before
; any font is loaded (a headless test) the engine's average-width guess is
; used.
;
; `layout=`, `colors=` and `style=` under the reference override what the
; file names. A diagram that cannot be drawn, or has nothing to draw, says
; why in its place, the way a diagram fence does.
;
; A slide is not PowerPoint's fixed frame: a row of steps that would be a
; thin strip wraps into rows of three or more when that makes it clearly
; larger (SaOptions.wrap), and a diagram with nothing beside it and no
; `{width}` / `{height}` of its own is laid out across the whole content
; width (PresDeck.smartArtSpan), not only the 16:9 box its picture fitted.
; Text that would not stand out from what it is drawn on — a pale list
; column on a dark theme, a label beside an arrow on the slide itself — is
; set in the paper or the ink, whichever reads (SaRender.keepReadable), and
; on a dark theme a quick style's shadows are cast in the ink, where black
; would not show (SaRender.shadowsOn).
;
; The same drawing goes to the stage and to the PDF (both through
; PresDeck.slideList). The PowerPoint export (PresApp.stillSmartArt) gets the
; engine's group, which carries the data it was laid out from: RangerPPTX's
; writer saves it as SmartArt PowerPoint can edit and lay out again, with
; this drawing as its drawing part for every other reader.
; ============================================================================

Import "../pptx/smartart/SaRender.rgr"
Import "../pptx/smartart/SaFile.rgr"
Import "../pptx/smartart/SaWhole.rgr"
Import "../markdown/web/markdown_web.rgr"

; Laid-out diagrams by what they were laid out for: the slides are rebuilt
; on every edit, and a diagram whose file, box and options did not change is
; not laid out again.
class PresSmartArtCache {
    def keys:[string]
    def results:[SaResult]

    fn get@(optional):SaResult (key:string) {
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == key) {
                def hit@(optional):SaResult (itemAt results i)
                return hit
            }
            i = (i + 1)
        }
        def none@(optional):SaResult
        return none
    }

    fn put:void (key:string r:SaResult) {
        if ((array_length keys) >= 64) {
            def k2:[string]
            def r2:[SaResult]
            keys = k2
            results = r2
        }
        push keys key
        push results r
    }
}

class PresSmartArtUse {
    ; the file, as the picture store names it
    def path:string ""
    ; the block the reference is in
    def srcStart:int -1
    def layout:string ""
    def colors:string ""
    def style:string ""
    ; the reference gives its own `{width}` or `{height}`: drawn in its box
    def sized:boolean false
}

class PresSmartArt {

    ; The palette of a figure style: its colours as the accents, its paper
    ; and ink as light 1 and dark 1.
    sfn palette:SaPalette (st:MdFigureStyle) {
        def p (new SaPalette())
        def n:int (array_length st.colors)
        def i:int 1
        while (i <= 6) {
            if (n > 0) {
                PresSmartArt.setHex(p ("accent" + (to_string i)) (itemAt st.colors ((i - 1) % n)))
            }
            i = (i + 1)
        }
        PresSmartArt.setHex(p "lt1" st.paper)
        PresSmartArt.setHex(p "lt2" st.paper)
        PresSmartArt.setHex(p "dk1" st.ink)
        PresSmartArt.setHex(p "dk2" st.ink)
        return p
    }

    ; only a #RRGGBB colour; a name the theme used is left to the default
    sfn setHex:void (p:SaPalette name:string c:string) {
        def t:string (trim c)
        if ((indexOf t "#") == 0) {
            t = (substring t 1 (strlen t))
        }
        if ((strlen t) == 3) {
            t = ((substring t 0 1) + (substring t 0 1) + (substring t 1 2) + (substring t 1 2) + (substring t 2 3) + (substring t 2 3))
        }
        if ((strlen t) != 6) {
            return
        }
        def i:int 0
        while (i < 6) {
            def ch:int (charAt (to_lowercase t) i)
            def digit:boolean ((ch >= 48) && (ch <= 57))
            def hexLetter:boolean ((ch >= 97) && (ch <= 102))
            if ((digit || hexLetter) == false) {
                return
            }
            i = (i + 1)
        }
        p.set(name t)
    }

    sfn paletteKey:string (st:MdFigureStyle) {
        def out:string (st.paper + "/" + st.ink)
        def i:int 0
        while (i < (array_length st.colors)) {
            out = (out + "/" + (itemAt st.colors i))
            i = (i + 1)
        }
        return out
    }

    ; The diagram laid out for a box of w × h (layout units are points), its
    ; text measured with `m`.
    sfn layoutFor:SaResult (u:PresSmartArtUse xml:string w:double h:double m:SaMeasure) {
        def o (new SaOptions())
        o.layout = u.layout
        o.colors = u.colors
        o.style = u.style
        o.measure = m
        o.wrap = true
        ; the data alone, or a whole PowerPoint diagram (SaWhole)
        return (SaWhole.layout(xml o w h))
    }

    ; The family a diagram's text is set in: the theme's figure font, else
    ; the document's body font.
    sfn familyOf:string (md:MarkdownWeb st:MdFigureStyle) {
        if ((strlen st.font) > 0) {
            return st.font
        }
        def ed:MarkdownEdit md.edit
        def lay:MdLayout ed.layout
        def style:MdStyle lay.style
        return style.bodyFamily
    }

    ; What the text is measured with: the deck's own fonts once they are
    ; loaded (the editor's and the MCP server's TTF measurer, the one the
    ; slide's text is laid out with), else the engine's guess.
    sfn measureOf:SaMeasure (md:MarkdownWeb st:MdFigureStyle) {
        def tm@(optional):TTFTextMeasurer md.measurer
        if (null? tm) {
            return (new SaMeasure())
        }
        return (SaMeasure.over((unwrap tm) (PresSmartArt.familyOf(md st))))
    }

    ; Drawn into `out` at the box, or the reason it was not, in the box.
    sfn paint:void (out:EVGDisplayList u:PresSmartArtUse md:MarkdownWeb st:MdFigureStyle cache:PresSmartArtCache x:double y:double w:double h:double) {
        def r:SaResult (PresSmartArt.laidOut(u md st cache w h))
        def why:string (PresSmartArt.reasonOf(r))
        if ((strlen why) > 0) {
            PresSmartArt.refusal(out ("SmartArt " + u.path + ": " + why) st x y w h)
            return
        }
        SaRender.drawWith(out r.shape x y r.measure)
    }

    ; Why nothing is drawn, or "": the engine's refusal, or what it said
    ; about a diagram that came out empty.
    sfn reasonOf:string (r:SaResult) {
        if (r.ok == false) {
            return r.error
        }
        if ((array_length r.shape.children) > 0) {
            return ""
        }
        if ((array_length r.warnings) > 0) {
            return (itemAt r.warnings 0)
        }
        return "there is nothing in it to draw"
    }

    ; the diagram for a box of w × h, its colours the theme's
    sfn laidOut:SaResult (u:PresSmartArtUse md:MarkdownWeb st:MdFigureStyle cache:PresSmartArtCache w:double h:double) {
        def ed:MarkdownEdit md.edit
        def store:Vfs ed.imageStore
        def bytes:buffer (store.read(u.path))
        def xml:string (SaFile.textOf(bytes))
        def m:SaMeasure (PresSmartArt.measureOf(md st))
        def measuredBy:string "guess"
        if m.hasHost {
            ; a face loaded later replaces the measurer: lay out again
            measuredBy = (m.family + "/" + (to_string md.faceCount))
        }
        def key:string (xml + "|" + (to_string w) + "|" + (to_string h) + "|" + u.layout + "|" + u.colors + "|" + u.style + "|" + (PresSmartArt.paletteKey(st)) + "|" + measuredBy)
        def had@(optional):SaResult (cache.get(key))
        if (!null? had) {
            return (unwrap had)
        }
        def r:SaResult (PresSmartArt.layoutFor(u xml w h m))
        if r.ok {
            def pal:SaPalette (PresSmartArt.palette(st))
            SaRender.resolveAll(r.shape pal)
            SaRender.keepReadable(r.shape pal (pal.hexOf("lt1")))
            SaRender.shadowsOn(r.shape pal (pal.hexOf("lt1")))
        }
        cache.put(key r)
        return r
    }

    ; the reason, in the box: a faint red ground, the text in the document's
    ; own ink so it reads on any theme
    sfn refusal:void (out:EVGDisplayList msg:string st:MdFigureStyle x:double y:double w:double h:double) {
        out.addRect(x y w h (EVGColor.rgba(200 60 60 0.08)))
        out.addText(msg (x + 8.0) (y + 20.0) 12.0 (EVGColor.parse(st.ink)) st.font false false (w - 16.0) 16.0)
    }
}
