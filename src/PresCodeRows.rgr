; ============================================================================
; PresCodeRows.rgr — the rows the code viewer shows, in each of its modes
; ============================================================================
;
; A file under code/ is its NEW text (the lines brought in, PresCodeFiles)
; and, when the change is known, a unified diff. From the two the viewer
; shows one of four things, each laid out here as rows:
;
;   now      the new text: kept lines, a gap row where lines were not
;            brought in ("⋯ lines 13–49 not in the deck"), added lines marked
;   before   the old text, rebuilt from the diff: the same lines and the
;            removed ones, by their old numbers
;   diff     one column, both: removed lines (red) before the lines that
;            took their place, added lines (green), a header row per hunk
;   split    two columns side by side, old left and new right; a block of
;            removed lines faces the added lines that replaced it, row by
;            row, and the shorter side is filled with empty rows
;
; A row knows its old and new line numbers (0: it has none), so the gutter
; shows the file's own numbers, not 1..N (ScriptEditor.setLineNumbers).
;
; Comments are kept on lines of the NEW version (Tero 2026-10-10): what a
; link to the head commit shows. `lineAt` turns a pressed row into that
; line: a kept or added line is itself; a removed line is the new line its
; removal sits before (the line that took its place, or that followed it;
; at the end of the file, the last line); a gap, header or filler row is no
; line. `rowOf` goes back: the row a comment's line is shown on in a mode.
; ============================================================================

Import "PresCodeFiles.rgr"
Import "../rangerdiff/src/RdPatch.rgr"

class PresCodeRow {
    ; "same", "add", "del", "gap", "hunk", "fill"
    def kind:string ""
    def old:int 0
    def new:int 0
    def text:string ""
    ; a gap: the lines not shown (new numbers; old ones in `before`)
    def gapFrom:int 0
    def gapTo:int 0
    ; a removed line: the new line a comment on it goes to
    def at:int 0
    ; the hunk it belongs to (0-based), -1 none
    def hunk:int -1

    fn canComment:boolean () {
        return ((kind == "same") || ((kind == "add") || (kind == "del")))
    }
}

class PresCodeRows {
    def file:PresCodeFile (new PresCodeFile())
    ; the kept new text's lines and their numbers in the file
    def lines:[string]
    def numbers:[int]
    def hasDiff:boolean false
    def patch:RdPatchFile (new RdPatchFile())
    ; what was wrong with the diff, "" = nothing
    def problem:string ""
    ; the one-column change: every row, in order
    def all:[PresCodeRow]

    ; Lays out a file: its kept text and its diff ("" = no change known).
    sfn make:PresCodeRows (f:PresCodeFile text:string diff:string) {
        def r (new PresCodeRows())
        r.file = f
        def ls:[string] (strsplit text "\n")
        if ((strlen text) == 0) {
            def none:[string]
            ls = none
        }
        r.lines = ls
        def i:int 0
        while (i < (array_length ls)) {
            push r.numbers (f.lineOf(i))
            i = (i + 1)
        }
        if ((strlen (trim diff)) > 0) {
            def pf:RdPatchFile (RdPatch.parse(diff))
            if (pf.ok()) {
                r.patch = pf
                r.hasDiff = true
            } {
                r.problem = (pf.error())
            }
        }
        r.build()
        return r
    }

    sfn row:PresCodeRow (kind:string old:int new:int text:string) {
        def w (new PresCodeRow())
        w.kind = kind
        w.old = old
        w.new = new
        w.text = text
        return w
    }

    sfn gapText:string (from:int to:int) {
        if (from == to) {
            return ("⋯ line " + (to_string from) + " not in the deck")
        }
        return ("⋯ lines " + (to_string from) + "–" + (to_string to) + " not in the deck")
    }

    ; The old number of new line `n`: inside a hunk from its lines, else
    ; shifted by the hunks above it.
    fn oldOf:int (n:int) {
        if (hasDiff == false) {
            return n
        }
        return (RdPatch.newToOld(patch n))
    }

    ; The hunk new line `n` is in, -1 none.
    fn hunkOfNew:int (n:int) {
        if (hasDiff == false) {
            return -1
        }
        def i:int 0
        while (i < (array_length patch.hunks)) {
            def h:RdPatchHunk (itemAt patch.hunks i)
            for h.lines l:RdPatchLine j {
                if ((l.newLine == n) && (n > 0)) {
                    return i
                }
            }
            i = (i + 1)
        }
        return -1
    }

    fn isAdded:boolean (n:int) {
        if (hasDiff == false) {
            return false
        }
        for patch.hunks h:RdPatchHunk i {
            for h.lines l:RdPatchLine j {
                if ((l.newLine == n) && (l.kind == "add")) {
                    return true
                }
            }
        }
        return false
    }

    fn hunkHeader:string (h:RdPatchHunk) {
        def s:string ("@@ −" + (to_string (h.oldFirst())) + "," + (to_string h.oldLen) + " +" + (to_string (h.newFirst())) + "," + (to_string h.newLen) + " @@")
        if ((strlen (trim h.section)) > 0) {
            s = (s + " " + (trim h.section))
        }
        return s
    }

    ; The one-column change. Removed lines come right before the new line
    ; that follows them in their hunk (`at`); ones at a hunk's end go before
    ; the line after the hunk, or after the last line at the file's end.
    fn build:void () {
        def out:[PresCodeRow]
        ; removed lines by the new line they stand before
        def delAt:[int]
        def delRows:[PresCodeRow]
        def lastNew:int 0
        if ((array_length numbers) > 0) {
            lastNew = (itemAt numbers ((array_length numbers) - 1))
        }
        if (file.lines > lastNew) {
            lastNew = file.lines
        }
        if hasDiff {
            def hi:int 0
            while (hi < (array_length patch.hunks)) {
                def h:RdPatchHunk (itemAt patch.hunks hi)
                def pending:[PresCodeRow]
                for h.lines l:RdPatchLine j {
                    if (l.kind == "del") {
                        def d:PresCodeRow (PresCodeRows.row("del" l.oldLine 0 l.text))
                        d.hunk = hi
                        push pending d
                    } {
                        for pending p:PresCodeRow k {
                            p.at = l.newLine
                            push delAt l.newLine
                            push delRows p
                        }
                        def none:[PresCodeRow]
                        pending = none
                    }
                }
                ; left over at the hunk's end: before the line after it
                def after:int ((h.newFirst()) + h.newLen)
                if (h.newLen == 0) {
                    after = ((h.newFirst()) + 1)
                    if (h.newStart == 0) {
                        after = 1
                    }
                }
                for pending p2:PresCodeRow k2 {
                    p2.at = after
                    push delAt after
                    push delRows p2
                }
                hi = (hi + 1)
            }
        }
        def prev:int 0
        def lastHunk:int -1
        def i:int 0
        def n:int (array_length numbers)
        while (i < n) {
            def num:int (itemAt numbers i)
            if (num > (prev + 1)) {
                def g:PresCodeRow (PresCodeRows.row("gap" 0 0 (PresCodeRows.gapText((prev + 1) (num - 1)))))
                g.gapFrom = (prev + 1)
                g.gapTo = (num - 1)
                push out g
            }
            ; the hunk this line or the lines removed before it belong to
            def hk:int (this.hunkOfNew(num))
            def dk:int 0
            while (dk < (array_length delAt)) {
                if ((itemAt delAt dk) == num) {
                    def dr0:PresCodeRow (itemAt delRows dk)
                    hk = dr0.hunk
                }
                dk = (dk + 1)
            }
            if ((hk >= 0) && (hk != lastHunk)) {
                def hh:RdPatchHunk (itemAt patch.hunks hk)
                def hr:PresCodeRow (PresCodeRows.row("hunk" 0 0 (this.hunkHeader(hh))))
                hr.hunk = hk
                push out hr
                lastHunk = hk
            }
            def d2:int 0
            while (d2 < (array_length delAt)) {
                if ((itemAt delAt d2) == num) {
                    push out (itemAt delRows d2)
                }
                d2 = (d2 + 1)
            }
            def kind:string "same"
            def oldN:int (this.oldOf(num))
            if (this.isAdded(num)) {
                kind = "add"
                oldN = 0
            }
            def w:PresCodeRow (PresCodeRows.row(kind oldN num (itemAt lines i)))
            w.hunk = (this.hunkOfNew(num))
            push out w
            prev = num
            i = (i + 1)
        }
        ; removed lines after the last line of the file
        if (n > 0) {
            def endAt:int ((itemAt numbers (n - 1)) + 1)
            def d3:int 0
            def any:boolean false
            while (d3 < (array_length delAt)) {
                if ((itemAt delAt d3) >= endAt) {
                    def dr:PresCodeRow (itemAt delRows d3)
                    if (((itemAt numbers (n - 1)) >= lastNew) || (file.whole())) {
                        if ((any == false) && (dr.hunk != lastHunk)) {
                            def hh2:RdPatchHunk (itemAt patch.hunks dr.hunk)
                            def hr2:PresCodeRow (PresCodeRows.row("hunk" 0 0 (this.hunkHeader(hh2))))
                            hr2.hunk = dr.hunk
                            push out hr2
                            lastHunk = dr.hunk
                        }
                        dr.at = (itemAt numbers (n - 1))
                        push out dr
                        any = true
                    }
                }
                d3 = (d3 + 1)
            }
            def lastKept:int (itemAt numbers (n - 1))
            if ((file.lines > lastKept) && ((file.whole()) == false)) {
                def g2:PresCodeRow (PresCodeRows.row("gap" 0 0 (PresCodeRows.gapText((lastKept + 1) file.lines))))
                g2.gapFrom = (lastKept + 1)
                g2.gapTo = file.lines
                push out g2
            }
        }
        all = out
    }

    ; --- the modes -------------------------------------------------------------

    sfn isMode:boolean (m:string) {
        return ((m == "now") || ((m == "before") || ((m == "diff") || (m == "split"))))
    }

    ; The mode a link asks for, or the one that fits: the change when there
    ; is one, else the file. `before`/`diff`/`split` without a change: now.
    fn modeFor:string (asked:string) {
        if (hasDiff == false) {
            return "now"
        }
        if (PresCodeRows.isMode(asked)) {
            return asked
        }
        return "diff"
    }

    ; The rows of one column: `now`, `before` or `diff`. In `split` the
    ; rows of the right (new) column; `left()` has the other.
    fn rows:[PresCodeRow] (mode:string) {
        if (mode == "split") {
            return (this.right())
        }
        def out:[PresCodeRow]
        if (mode == "diff") {
            return all
        }
        if (mode == "now") {
            for all w:PresCodeRow i {
                if ((w.kind == "same") || ((w.kind == "add") || (w.kind == "gap"))) {
                    push out w
                }
            }
            return out
        }
        ; before: same and removed lines, gaps by their old numbers
        def prevOld:int 0
        for all w2:PresCodeRow j {
            if ((w2.kind == "same") || (w2.kind == "del")) {
                if (w2.old > (prevOld + 1)) {
                    def g:PresCodeRow (PresCodeRows.row("gap" 0 0 (PresCodeRows.gapText((prevOld + 1) (w2.old - 1)))))
                    g.gapFrom = (prevOld + 1)
                    g.gapTo = (w2.old - 1)
                    push out g
                }
                push out w2
                prevOld = w2.old
            }
        }
        return out
    }

    ; Side by side: old on the left, new on the right, the same length. A
    ; run of removed lines and the run of added lines after it face each
    ; other row by row; the shorter is filled.
    fn pairs:[PresCodeRow] (leftSide:boolean) {
        def lout:[PresCodeRow]
        def rout:[PresCodeRow]
        def i:int 0
        def n:int (array_length all)
        while (i < n) {
            def w:PresCodeRow (itemAt all i)
            if ((w.kind == "del") || (w.kind == "add")) {
                def dels:[PresCodeRow]
                def adds:[PresCodeRow]
                while ((i < n) && ((PresCodeRows.kindAt(all i)) == "del")) {
                    push dels (itemAt all i)
                    i = (i + 1)
                }
                while ((i < n) && ((PresCodeRows.kindAt(all i)) == "add")) {
                    push adds (itemAt all i)
                    i = (i + 1)
                }
                def m:int (array_length dels)
                if ((array_length adds) > m) {
                    m = (array_length adds)
                }
                def k:int 0
                while (k < m) {
                    if (k < (array_length dels)) {
                        push lout (itemAt dels k)
                    } {
                        push lout (PresCodeRows.row("fill" 0 0 ""))
                    }
                    if (k < (array_length adds)) {
                        push rout (itemAt adds k)
                    } {
                        def f:PresCodeRow (PresCodeRows.row("fill" 0 0 ""))
                        ; a filler facing removed lines: a comment there
                        ; still means where they were taken out
                        def dd:PresCodeRow (itemAt dels k)
                        f.at = dd.at
                        push rout f
                    }
                    k = (k + 1)
                }
            } {
                push lout w
                push rout w
                i = (i + 1)
            }
        }
        if leftSide {
            return lout
        }
        return rout
    }

    sfn kindAt:string (rows:[PresCodeRow] i:int) {
        if ((i < 0) || (i >= (array_length rows))) {
            return ""
        }
        def w:PresCodeRow (itemAt rows i)
        return w.kind
    }

    fn left:[PresCodeRow] () {
        return (this.pairs(true))
    }

    fn right:[PresCodeRow] () {
        return (this.pairs(false))
    }

    ; --- what the editor is given ------------------------------------------

    sfn texts:[string] (rows:[PresCodeRow]) {
        def out:[string]
        for rows w:PresCodeRow i {
            push out w.text
        }
        return out
    }

    sfn text:string (rows:[PresCodeRow]) {
        return (join (PresCodeRows.texts(rows)) "\n")
    }

    ; The number a row's gutter shows: new numbers, or old ones in `before`
    ; and in split's left column.
    sfn newNumbers:[int] (rows:[PresCodeRow]) {
        def out:[int]
        for rows w:PresCodeRow i {
            if ((w.kind == "same") || (w.kind == "add")) {
                push out w.new
            } {
                push out 0
            }
        }
        return out
    }

    sfn oldNumbers:[int] (rows:[PresCodeRow]) {
        def out:[int]
        for rows w:PresCodeRow i {
            if ((w.kind == "same") || (w.kind == "del")) {
                push out w.old
            } {
                push out 0
            }
        }
        return out
    }

    ; ScriptEditor.setLineMarks: 1 added, 2 removed, 0 the rest
    sfn marks:[int] (rows:[PresCodeRow]) {
        def out:[int]
        for rows w:PresCodeRow i {
            if (w.kind == "add") {
                push out 1
            } {
                if (w.kind == "del") {
                    push out 2
                } {
                    push out 0
                }
            }
        }
        return out
    }

    ; --- comments: always on the new version's lines ----------------------

    ; The new line a press on row `i` comments, 0 when it comments nothing
    ; (a gap, a header, a filler that faces nothing).
    sfn lineAt:int (rows:[PresCodeRow] i:int) {
        if ((i < 0) || (i >= (array_length rows))) {
            return 0
        }
        def w:PresCodeRow (itemAt rows i)
        if ((w.kind == "same") || (w.kind == "add")) {
            return w.new
        }
        if ((w.kind == "del") || (w.kind == "fill")) {
            return w.at
        }
        return 0
    }

    ; The old lines a press on row `i` stands on when they are removed ones
    ; ([old, old]); empty otherwise.
    sfn removedAt:[int] (rows:[PresCodeRow] i:int) {
        def out:[int]
        if ((i >= 0) && (i < (array_length rows))) {
            def w:PresCodeRow (itemAt rows i)
            if (w.kind == "del") {
                push out w.old
                push out w.old
            }
        }
        return out
    }

    ; The row new line `line` is shown on in these rows, -1 when none is:
    ; the row of that line; in `before` (no new numbers) the row of its old
    ; counterpart, else the first removed line that stood before it.
    sfn rowOf:int (rows:[PresCodeRow] line:int oldLine:int) {
        def i:int 0
        while (i < (array_length rows)) {
            def w:PresCodeRow (itemAt rows i)
            if (((w.kind == "same") || (w.kind == "add")) && (w.new == line)) {
                return i
            }
            i = (i + 1)
        }
        if (oldLine > 0) {
            def j:int 0
            while (j < (array_length rows)) {
                def w2:PresCodeRow (itemAt rows j)
                if ((w2.kind == "same") && (w2.old == oldLine)) {
                    return j
                }
                j = (j + 1)
            }
        }
        def k:int 0
        while (k < (array_length rows)) {
            def w3:PresCodeRow (itemAt rows k)
            if ((w3.kind == "del") && (w3.at == line)) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; The row for a comment on new line `line` in a mode's rows.
    fn rowFor:int (rows:[PresCodeRow] line:int) {
        return (PresCodeRows.rowOf(rows line (this.oldOf(line))))
    }

    ; The first row of hunk `h` (1-based, as a link's #hunk2), -1 none.
    sfn hunkRow:int (rows:[PresCodeRow] h:int) {
        def i:int 0
        while (i < (array_length rows)) {
            def w:PresCodeRow (itemAt rows i)
            if ((w.hunk == (h - 1)) && (w.kind != "gap")) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; The rows where a change starts (a header, or the first changed row
    ; after a same one): `n` / `N` jump between them.
    sfn changeStarts:[int] (rows:[PresCodeRow]) {
        def out:[int]
        def inChange:boolean false
        def i:int 0
        while (i < (array_length rows)) {
            def w:PresCodeRow (itemAt rows i)
            def ch:boolean ((w.kind == "add") || ((w.kind == "del") || (w.kind == "fill")))
            if (ch && (inChange == false)) {
                push out i
            }
            inChange = ch
            i = (i + 1)
        }
        return out
    }
}
