# Sliqtly settings for the Homebrew service. After a change:
#   brew services restart sliqtly
# Lines are KEY=value; a line starting with # is off.

# The port to listen on.
PORT=8080

# Who can connect: local (this Mac only, the default), wired (also
# computers on a wired network, never Wi-Fi) or network (every interface).
SLIQTLY_LISTEN=local

# Other computers' address ranges let in with wired or network,
# e.g. 192.168.1.0/24; empty: any.
#SLIQTLY_ALLOW=

# The address in the links the server gives, e.g. http://my-mac.local:8080.
# Empty: the address each request came in on.
#SLIQTLY_URL=

# When set, /mcp needs "Authorization: Bearer <token>".
#SLIQTLY_TOKEN=

# Where presentations and backups are kept. Empty: Homebrew's var folder
# (sliqtly and sliqtly-backup under $(brew --prefix)/var).
#SLIQTLY_DATA=
#SLIQTLY_BACKUP=
