# Sliqtly server settings, read by sliqtly.service. After a change:
#   sudo systemctl restart sliqtly

# Where decks are kept. systemd makes this folder for the service.
SLIQTLY_DATA=/var/lib/sliqtly

# The port to listen on.
PORT=8080

# Who can connect: network (every interface, the package's default),
# wired (this computer and computers on a wired network) or local (this
# computer only, e.g. behind a reverse proxy on the same machine).
#SLIQTLY_LISTEN=network

# Other computers' address ranges let in, e.g. 10.20.0.0/16; empty: any.
#SLIQTLY_ALLOW=

# The address people and links use, e.g. https://sliqtly.example.com or
# http://server-name:8080. Empty: http://localhost:<port>.
SLIQTLY_URL=

# When set, /mcp needs "Authorization: Bearer <token>".
SLIQTLY_TOKEN=

# The owner of the decks kept here.
SLIQTLY_USER=local
