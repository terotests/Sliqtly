# Sliqtly server settings, read by the Sliqtly service when it starts.
# Lines are KEY=value; a line starting with # is off. After a change, in a
# Command Prompt or PowerShell run as administrator:
#   sliqtly-server service restart
# The installer keeps this file on an upgrade and when Sliqtly is removed.

# Where decks are kept. Empty: data in this folder
# (C:\ProgramData\Sliqtly\data).
#SLIQTLY_DATA=

# Backups: an incremental backup of the decks every SLIQTLY_BACKUP_EVERY
# into this folder. Best on another disk, e.g. D:\SliqtlyBackup. Check and
# restore with
#   sliqtly-server backup list|verify|restore -repo <folder>
# Unset: backup in this folder (C:\ProgramData\Sliqtly\backup).
# Empty (SLIQTLY_BACKUP=): no backups.
#SLIQTLY_BACKUP=
#SLIQTLY_BACKUP_EVERY=24h
#SLIQTLY_BACKUP_KEEP=last=3,daily=14,weekly=8

# The port to listen on. The installer lets it in through Windows Firewall
# on domain and private networks (not public ones).
PORT=8080

# Who can connect: network (every interface, the service's default),
# wired (this computer and computers on a wired network, never Wi-Fi) or
# local (this computer only, e.g. behind a reverse proxy on the same
# machine).
#SLIQTLY_LISTEN=network

# Other computers' address ranges let in, e.g. 10.20.0.0/16; empty: any.
#SLIQTLY_ALLOW=

# The address people and links use, e.g. https://sliqtly.example.com or
# http://server-name:8080. Empty: the address each request came in on.
#SLIQTLY_URL=

# The access token. Every request needs it when other computers can
# connect (SLIQTLY_LISTEN network or wired) or when it is set: agents send
# "Authorization: Bearer <token>", a browser opens http://<server>:8080/?token=<token>
# once. Empty with network or wired: the server makes its own, kept in
# the data folder's access-token (C:\ProgramData\Sliqtly\data\access-token)
# and written in the log (C:\ProgramData\Sliqtly\log\sliqtly.log); only
# administrators can read them.
#SLIQTLY_TOKEN=

# Folders the MCP tools may read pictures and data files from by path
# (create_presentation / update_presentation `path`), comma separated,
# e.g. D:\Photos. Nothing outside them is read. Anyone who can use /mcp can
# read the pictures and data files in them. The service runs as its own
# account (NT SERVICE\Sliqtly): give it read access to a folder with
#   icacls D:\Photos /grant "NT SERVICE\Sliqtly:(OI)(CI)RX"
# Empty: none.
#SLIQTLY_IMPORT_DIRS=

# The most megabytes one picture or data file may have: sent by an agent,
# read from an import folder, or added in the editor or a room. Default 50.
#SLIQTLY_MAX_FILE_MB=50

# The largest design file (Figma .fig) the Files rail and add_shared_file
# take, in MB. Reading a file in uses memory well beyond its size.
#SLIQTLY_SHARED_MAX=512

# The owner of the decks kept here.
SLIQTLY_USER=local
