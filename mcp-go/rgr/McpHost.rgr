; =============================================================================
; McpHost — what the server needs that Ranger's Go target does not have
; =============================================================================
; The server itself is Ranger (Mcp.rgr, Tools.rgr, OAuth.rgr, Store.rgr,
; Deck.rgr, App.rgr). These operators are the thin wrapper around the rest:
; Firestore, Cloud Storage, Firebase Auth, outbound HTTP, SHA-256, random ids,
; deflate and the clock, implemented by the Go type McpHost in ../host.go.
;
; Values cross as strings: documents as JSON text, numbers as int. A Go error
; is kept on the host and read with host_error, so the Ranger code decides
; what the caller is told.
;
; One McpHost per request; what lasts between requests (the clients, the rate
; limiter, the theme cache) lives behind it in Go.
; =============================================================================

systemclass McpHost {
    go "*McpHost"
}

operators {
    ; --- the request and the configuration

    ; the body as a JSON object: JSON as sent (non-ASCII unescaped), a form
    ; as an object of strings; "" when a JSON body does not parse
    host_body_json _:string (h:McpHost) {
        templates {
            go ( (e 1) ".BodyJSON()" )
        }
    }
    host_remote_ip _:string (h:McpHost) {
        templates {
            go ( (e 1) ".RemoteIP()" )
        }
    }
    host_tls _:boolean (h:McpHost) {
        templates {
            go ( (e 1) ".TLS()" )
        }
    }
    host_base_url _:string (h:McpHost) {
        templates {
            go ( (e 1) ".BaseURL()" )
        }
    }
    host_trust_host _:boolean (h:McpHost) {
        templates {
            go ( (e 1) ".TrustHost()" )
        }
    }
    ; "cloud" (Firestore and Storage) or "link" (nothing kept)
    host_store_kind _:string (h:McpHost) {
        templates {
            go ( (e 1) ".StoreKind()" )
        }
    }
    host_oauth _:boolean (h:McpHost) {
        templates {
            go ( (e 1) ".OAuthOn()" )
        }
    }
    ; the user every caller is on a server of one's own (decks in a folder,
    ; no sign-in); "" elsewhere
    host_local_user _:string (h:McpHost) {
        templates {
            go ( (e 1) ".LocalUser()" )
        }
    }
    ; the form a presentation's name must have (names.go), in words; ""
    ; when any name will do
    host_name_rule _:string (h:McpHost) {
        templates {
            go ( (e 1) ".NameRule()" )
        }
    }
    ; "" for a name of that form, else why it is not
    host_check_name _:string (h:McpHost name:string) {
        templates {
            go ( (e 1) ".CheckName(" (e 2) ")" )
        }
    }
    ; the name's key (ABC-1234), "" when it has none
    host_name_key _:string (h:McpHost name:string) {
        templates {
            go ( (e 1) ".NameKey(" (e 2) ")" )
        }
    }
    host_asset _:string (h:McpHost name:string) {
        templates {
            go ( (e 1) ".Asset(" (e 2) ")" )
        }
    }
    host_log _:void (h:McpHost msg:string) {
        templates {
            go ( (e 1) ".Log(" (e 2) ")" nl )
        }
    }
    ; the first Go error of this request, "" while there is none
    host_error _:string (h:McpHost) {
        templates {
            go ( (e 1) ".Err()" )
        }
    }
    ; forgets it, for a failure the request goes on without
    host_clear_error _:void (h:McpHost) {
        templates {
            go ( (e 1) ".ClearErr()" nl )
        }
    }

    ; --- Firestore: documents as JSON; {"$serverTime":true} writes the server
    ; time, timestamps read back as milliseconds

    host_get_doc _:string (h:McpHost col:string id:string) {
        templates {
            go ( (e 1) ".GetDoc(" (e 2) ", " (e 3) ")" )
        }
    }
    host_set_doc _:void (h:McpHost col:string id:string json:string) {
        templates {
            go ( (e 1) ".SetDoc(" (e 2) ", " (e 3) ", " (e 4) ")" nl )
        }
    }
    host_update_doc _:void (h:McpHost col:string id:string json:string) {
        templates {
            go ( (e 1) ".UpdateDoc(" (e 2) ", " (e 3) ", " (e 4) ")" nl )
        }
    }
    host_delete_doc _:void (h:McpHost col:string id:string) {
        templates {
            go ( (e 1) ".DeleteDoc(" (e 2) ", " (e 3) ")" nl )
        }
    }
    ; writes the document only when there is none: "" when it was written,
    ; the one already there (JSON) when not
    host_create_doc _:string (h:McpHost col:string id:string json:string) {
        templates {
            go ( (e 1) ".CreateDoc(" (e 2) ", " (e 3) ", " (e 4) ")" )
        }
    }
    ; the update only when the document's string field `field` is `want`
    ; (a missing field or document reads as ""; a missing document is
    ; written whole): "" when written, "changed" when the field was not
    ; `want`; the read and the write are one transaction
    host_update_if _:string (h:McpHost col:string id:string field:string want:string json:string) {
        templates {
            go ( (e 1) ".UpdateDocIf(" (e 2) ", " (e 3) ", " (e 4) ", " (e 5) ", " (e 6) ")" )
        }
    }
    ; adds the numbers of a JSON object (nested objects for nested fields)
    ; to the document's, creating what is missing (FieldValue.increment)
    host_increment_doc _:void (h:McpHost col:string id:string json:string) {
        templates {
            go ( (e 1) ".IncrementDoc(" (e 2) ", " (e 3) ", " (e 4) ")" nl )
        }
    }
    ; [{"id": …, …fields}] of the documents whose field equals value
    host_query_eq _:string (h:McpHost col:string field:string value:string) {
        templates {
            go ( (e 1) ".QueryEq(" (e 2) ", " (e 3) ", " (e 4) ")" )
        }
    }

    ; --- pictures: the bytes stay in Go, Ranger holds a handle

    ; {"handle":n,"size":n}; size 0 when it does not decode
    host_image_base64 _:string (h:McpHost data:string) {
        templates {
            go ( (e 1) ".ImageFromBase64(" (e 2) ")" )
        }
    }
    ; {"handle","size","status","type","length","error"}: a GET on a public
    ; address only, at most limit bytes kept
    host_image_url _:string (h:McpHost url:string limit:int) {
        templates {
            go ( (e 1) ".ImageFromURL(" (e 2) ", " (e 3) ")" )
        }
    }
    ; why the PNG, JPEG, GIF or WebP in the handle does not decode; "" when
    ; it does
    host_image_error _:string (h:McpHost handle:int) {
        templates {
            go ( (e 1) ".ImageError(" (e 2) ")" )
        }
    }
    ; the picture in the handle as the contrast check samples it: width,
    ; height, then 48 x 48 RGBA values; empty when it does not decode
    host_image_grid _:[int] (h:McpHost handle:int) {
        templates {
            go ( (e 1) ".ImageGrid(" (e 2) ")" )
        }
    }
    ; a face the editor lays slides out with ("Open Sans-Bold"), as the
    ; TTF's bytes; empty when there is no such face
    host_font _:buffer (h:McpHost name:string) {
        templates {
            go ( (e 1) ".Font(" (e 2) ")" )
        }
    }
    ; why the SVG in data does not draw (svgraster.go); "" when it draws
    host_svg_error _:string (h:McpHost data:buffer) {
        templates {
            go ( (e 1) ".SvgError(" (e 2) ")" )
        }
    }
    ; --- slides as pictures (render.go)

    ; a picture the display lists name (/media/<name>), for the painter
    host_render_pic _:void (h:McpHost name:string data:buffer) {
        templates {
            go ( (e 1) ".RenderPic(" (e 2) ", " (e 3) ")" nl )
        }
    }
    ; one slide's display list (EVGDisplayList.toJson) painted `width`
    ; pixels wide: base64 JPEG, "" when it could not be drawn
    host_render _:string (h:McpHost list:string w:double ht:double width:int) {
        templates {
            go ( (e 1) ".Render(" (e 2) ", " (e 3) ", " (e 4) ", " (e 5) ")" )
        }
    }
    ; every slide as a numbered thumbnail, `cols` across, `width` pixels in
    ; all: base64 JPEG
    host_render_grid _:string (h:McpHost lists:[string] w:double ht:double cols:int width:int) {
        templates {
            go ( (e 1) ".RenderGrid(" (e 2) ", " (e 3) ", " (e 4) ", " (e 5) ", " (e 6) ")" )
        }
    }
    host_image_bytes _:buffer (h:McpHost handle:int) {
        templates {
            go ( (e 1) ".Bytes(" (e 2) ")" )
        }
    }
    ; Storage object `path` with the handle's bytes and a download token
    host_upload _:void (h:McpHost handle:int path:string contentType:string token:string) {
        templates {
            go ( (e 1) ".Upload(" (e 2) ", " (e 3) ", " (e 4) ", " (e 5) ")" nl )
        }
    }
    ; --- data files: the bytes stay in Go too

    ; {"handle":n,"size":n} of a deck's Storage object shares/<id>/<path>;
    ; a missing object is a host error
    host_file_bytes _:string (h:McpHost id:string path:string) {
        templates {
            go ( (e 1) ".FileBytes(" (e 2) ", " (e 3) ")" )
        }
    }
    ; text kept as bytes, for an upload: its handle
    host_keep_text _:int (h:McpHost text:string) {
        templates {
            go ( (e 1) ".KeepText(" (e 2) ")" )
        }
    }
    ; bytes made here (an export), for an upload: their handle
    host_keep_bytes _:int (h:McpHost data:buffer) {
        templates {
            go ( (e 1) ".KeepBytes(" (e 2) ")" )
        }
    }
    ; the workbook in the handle as the editor reads it: PresData.xlsxSheets,
    ; compiled on its own (rgr/PresDataGo.rgr → presdata/), since the
    ; workbook reader and the deck model cannot share one compile
    host_xlsx_sheets _:string (h:McpHost handle:int) {
        templates {
            go ( (e 1) ".XlsxSheets(" (e 2) ")" )
        }
    }
    ; a workbook of values from [{name, rows: [[string|number|null]]}] (JSON),
    ; kept as bytes: {"handle":n,"size":n} (../xlsxwrite.go)
    host_xlsx_write _:string (h:McpHost sheets:string) {
        templates {
            go ( (e 1) ".XlsxWrite(" (e 2) ")" )
        }
    }
    ; the handle's bytes as text
    host_text _:string (h:McpHost handle:int) {
        templates {
            go ( (e 1) ".Text(" (e 2) ")" )
        }
    }
    ; a number with `digits` significant digits, written as JavaScript's
    ; String(+n.toPrecision(digits)) writes it
    host_precision _:string (h:McpHost n:string digits:int) {
        templates {
            go ( (e 1) ".Precision(" (e 2) ", " (e 3) ")" )
        }
    }
    host_bucket _:string (h:McpHost) {
        templates {
            go ( (e 1) ".Bucket()" )
        }
    }
    ; where the page reads a kept file (shares/{id}/{path}): Storage's
    ; download URL with the token, or the server's own /files/ on a folder
    host_file_url _:string (h:McpHost name:string token:string) {
        templates {
            go ( (e 1) ".FileURL(" (e 2) ", " (e 3) ")" )
        }
    }

    ; --- the network

    ; the theme's sheet from the site, cached per instance; "" on failure
    host_theme_css _:string (h:McpHost theme:string) {
        templates {
            go ( (e 1) ".ThemeCSS(" (e 2) ")" )
        }
    }
    ; the site's Firebase config (public) as JSON, cached per instance; ""
    ; when it cannot be read, which is no error
    host_web_config _:string (h:McpHost) {
        templates {
            go ( (e 1) ".WebConfig()" )
        }
    }
    ; {"status":n,"body":"…"} of a GET on a public address; status 0 on failure
    host_fetch_text _:string (h:McpHost url:string accept:string limit:int) {
        templates {
            go ( (e 1) ".FetchText(" (e 2) ", " (e 3) ", " (e 4) ")" )
        }
    }
    ; {"uid","name","email"} of a valid Firebase ID token, "" otherwise
    host_verify_id_token _:string (h:McpHost token:string) {
        templates {
            go ( (e 1) ".VerifyIDToken(" (e 2) ")" )
        }
    }

    ; --- small things

    host_sha256_hex _:string (h:McpHost s:string) {
        templates {
            go ( (e 1) ".SHA256Hex(" (e 2) ")" )
        }
    }
    host_sha256_b64url _:string (h:McpHost s:string) {
        templates {
            go ( (e 1) ".SHA256B64URL(" (e 2) ")" )
        }
    }
    ; n characters of a-z, A-Z, 0-9
    host_short_id _:string (h:McpHost n:int) {
        templates {
            go ( (e 1) ".ShortID(" (e 2) ")" )
        }
    }
    host_uuid _:string (h:McpHost) {
        templates {
            go ( (e 1) ".UUID()" )
        }
    }
    ; deflate-raw + base64url, the editor's packText()
    host_pack_text _:string (h:McpHost s:string) {
        templates {
            go ( (e 1) ".PackText(" (e 2) ")" )
        }
    }
    host_now_ms _:int (h:McpHost) {
        templates {
            go ( (e 1) ".NowMS()" )
        }
    }
    ; "" or why the caller is refused (sliding window per instance)
    host_rate_limit _:string (h:McpHost who:string) {
        templates {
            go ( (e 1) ".RateLimit(" (e 2) ")" )
        }
    }
    ; "" or why a visit beacon from this address is not counted (sliding
    ; window per instance)
    host_hit_limit _:string (h:McpHost who:string) {
        templates {
            go ( (e 1) ".HitLimit(" (e 2) ")" )
        }
    }
    ; a value the instance keeps between requests ("" when it has none)
    host_cache_get _:string (h:McpHost key:string) {
        templates {
            go ( (e 1) ".CacheGet(" (e 2) ")" )
        }
    }
    host_cache_put _:void (h:McpHost key:string value:string) {
        templates {
            go ( (e 1) ".CachePut(" (e 2) ", " (e 3) ")" nl )
        }
    }
    ; encodeURIComponent
    host_uri_encode _:string (h:McpHost s:string) {
        templates {
            go ( (e 1) ".URIEncode(" (e 2) ")" )
        }
    }
    ; {"scheme","host","hostname","port","path","query":{…},"hash"}, "" when
    ; it is not an absolute URL
    host_parse_url _:string (h:McpHost url:string) {
        templates {
            go ( (e 1) ".ParseURL(" (e 2) ")" )
        }
    }
    ; url with the params of a JSON object set in its query (URL.searchParams.set)
    host_url_set _:string (h:McpHost url:string params:string) {
        templates {
            go ( (e 1) ".URLSet(" (e 2) ", " (e 3) ")" )
        }
    }
    ; milliseconds as 2006-01-02T15:04:05.000Z
    host_iso_time _:string (h:McpHost ms:int) {
        templates {
            go ( (e 1) ".ISOTime(" (e 2) ")" )
        }
    }

    ; --- what Lang.rgr's HttpRequest operators leave out

    ; the Host the request was sent to (Go keeps it out of the headers)
    http_request_host _:string (req:HttpRequest) {
        templates {
            go ( (e 1) ".Host" )
        }
    }
    ; the query string as a JSON object of its first values
    http_query_json _:string (req:HttpRequest) {
        templates {
            go ( "queryJSON(" (e 1) ")" )
        }
    }
}
