; SPDX-License-Identifier: AGPL-3.0-or-later

; The tools (mcp/src/server.js): Markdown (+ a theme, CSS and pictures) into
; a presentation at sliqtly.com, and its link back.
;
; Tools: sliqtly_guide, create_presentation, update_presentation,
; bind_chart_data, get_presentation, list_files, read_file,
; list_presentations. create/update also name a UI
; resource (MCP Apps, and the same template for ChatGPT) that shows the deck
; inline in the chat.

Import "McpHost.rgr"
Import "Json.rgr"
Import "Deck.rgr"
Import "Check.rgr"
Import "Charts.rgr"
Import "Store.rgr"
Import "Files.rgr"

; who is asking, for one request
class Caller {
    def signedIn:boolean false
    def uid:string ""
    def name:string ""
    ; resource metadata URL when sign-in is on, "" otherwise
    def signIn:string ""
    ; the rate limit key: "uid:…" or the address
    def who:string ""
}

; the stored deck a caller may change, or why not
class Editable {
    def fail:string ""
    def cur:MfJ (new MfJ)
    def mine:boolean false
    def key:string ""
}

class CheckPics {
    def pics:[CheckPic]
    def data:[buffer]
    def types:[string]
}

class Tools {
    ; named by its contents, as in mcp/: a client that kept an older preview
    ; by its URI asks for this one anew
    sfn previewUri:string (host:McpHost) {
        def h:string (host_sha256_hex host (host_asset host "preview.html"))
        return ("ui://sliqtly/preview-" + (substring h 0 10) + ".html")
    }
    sfn APP_MIME:string () {
        return "text/html;profile=mcp-app"
    }

    ; the site's domains, the configured one first
    sfn frames:[string] (base:string) {
        def out:[string]
        push out base
        if (base != "https://sliqtly.com") {
            push out "https://sliqtly.com"
        }
        if (base != "https://sliqtly.web.app") {
            push out "https://sliqtly.web.app"
        }
        return out
    }

    ; Sign-in is optional (ChatGPT reads this to offer both)
    sfn either:MfJ () {
        def a:MfJ (MfJ.newArr())
        def n:MfJ (MfJ.newObj())
        n.putStr("type" "noauth")
        a.add(n)
        a.add((Tools.oauthScheme()))
        return a
    }
    sfn oauthScheme:MfJ () {
        def o:MfJ (MfJ.newObj())
        o.putStr("type" "oauth2")
        o.put("scopes" (J.strs(([] _:string ("decks")))))
        return o
    }

    sfn uiMeta:MfJ (host:McpHost) {
        def m:MfJ (MfJ.newObj())
        m.put("securitySchemes" (Tools.either()))
        def ui:MfJ (MfJ.newObj())
        ui.putStr("resourceUri" (Tools.previewUri(host)))
        m.put("ui" ui)
        m.putStr("ui/resourceUri" (Tools.previewUri(host)))
        m.putStr("openai/outputTemplate" (Tools.previewUri(host)))
        m.putBool("openai/widgetAccessible" false)
        return m
    }

    ; --- input schemas, as the Node server's zod gives them

    sfn prop:MfJ (type:string desc:string) {
        def p:MfJ (MfJ.newObj())
        p.putStr("type" type)
        if ((strlen desc) > 0) {
            p.putStr("description" desc)
        }
        return p
    }

    sfn schema:MfJ (props:MfJ required:[string]) {
        def s:MfJ (MfJ.newObj())
        s.putStr("type" "object")
        s.put("properties" props)
        if ((array_length required) > 0) {
            s.put("required" (J.strs(required)))
        }
        s.putBool("additionalProperties" false)
        s.putStr("$schema" "http://json-schema.org/draft-07/schema#")
        return s
    }

    sfn deckFields:void (p:MfJ) {
        def theme:MfJ (Tools.prop("string" "Theme: aurora (default), nebula, carbon, ember, midnight (dark); corporate, editorial (light)"))
        theme.put("enum" (J.strs((Deck.THEMES()))))
        p.put("theme" theme)
        p.put("css" (Tools.prop("string" "CSS rules added on top of the theme (selectors: page, document, h1, h2, p, list, li, code, table, chart, diagram, .lead …). See sliqtly_guide.")))
        def mode:MfJ (Tools.prop("string" "extend (default): css is added after the theme's rules. replace: css is the whole stylesheet."))
        mode.put("enum" (J.strs(([] _:string ("extend" "replace")))))
        p.put("css_mode" mode)
        def ip:MfJ (MfJ.newObj())
        ip.put("name" (Tools.prop("string" "File name the Markdown uses as media/<name>, e.g. \"team.jpg\" → ![](media/team.jpg)")))
        ip.put("url" (Tools.prop("string" "A public https URL of the picture")))
        ip.put("data_base64" (Tools.prop("string" "The picture's bytes as base64 (instead of url)")))
        ip.put("mime_type" (Tools.prop("string" "image/png, image/jpeg, image/gif, image/webp or image/svg+xml; inferred from the name when left out")))
        def item:MfJ (MfJ.newObj())
        item.putStr("type" "object")
        item.put("properties" ip)
        item.put("required" (J.strs(([] _:string ("name")))))
        def images:MfJ (Tools.prop("array" "Pictures the Markdown refers to as media/<name>. Needs sign-in."))
        images.put("items" item)
        p.put("images" images)
        def fp:MfJ (MfJ.newObj())
        fp.put("name" (Tools.prop("string" "File name, kept as data/<name>: \"sales.xlsx\", \"sales.csv\", \"sales.json\"")))
        fp.put("text" (Tools.prop("string" "The file's text (CSV, TSV, JSON or plain text)")))
        fp.put("data_base64" (Tools.prop("string" "The file's bytes as base64 (an .xlsx workbook)")))
        fp.put("url" (Tools.prop("string" "A public https URL of the file")))
        def fitem:MfJ (MfJ.newObj())
        fitem.putStr("type" "object")
        fitem.put("properties" fp)
        fitem.put("required" (J.strs(([] _:string ("name")))))
        def files:MfJ (Tools.prop("array" "Data files kept with the deck under data/: .xlsx workbooks, .csv, .tsv, .json, .txt (10 MB each); needs sign-in. A chart or ```table reads data/<name>.csv; a workbook's sheets are read as data/<book>-<Sheet>.csv (data/<book>.csv for a one-sheet book); see sliqtly_guide."))
        files.put("items" fitem)
        p.put("files" files)
    }

    sfn annotations:MfJ (readOnly:boolean destructive:int idempotent:boolean openWorld:boolean) {
        def a:MfJ (MfJ.newObj())
        a.putBool("readOnlyHint" readOnly)
        if (destructive == 0) {
            a.putBool("destructiveHint" false)
        }
        if (destructive == 1) {
            a.putBool("destructiveHint" true)
        }
        if (idempotent || (readOnly == false)) {
            a.putBool("idempotentHint" idempotent)
        }
        a.putBool("openWorldHint" openWorld)
        return a
    }

    sfn tool:MfJ (name:string title:string desc:string schema:MfJ ann:MfJ meta:MfJ) {
        def t:MfJ (MfJ.newObj())
        t.putStr("name" name)
        t.putStr("title" title)
        t.putStr("description" desc)
        t.put("inputSchema" schema)
        t.put("annotations" ann)
        t.put("_meta" meta)
        return t
    }

    sfn list:MfJ (host:McpHost) {
        def none:[string]
        def eitherMeta:MfJ (MfJ.newObj())
        eitherMeta.put("securitySchemes" (Tools.either()))
        def tools:MfJ (MfJ.newArr())
        tools.add((Tools.tool("sliqtly_guide" "Sliqtly syntax guide" "How to write a Sliqtly deck: slide structure, build animations, effects, pictures, charts (Vega-Lite), diagrams (Mermaid, Graphviz), math, themes and the CSS selectors. Read before the first create_presentation." (Tools.schema((MfJ.newObj()) none)) (Tools.annotations(true -1 false false)) eitherMeta)))

        def cp:MfJ (MfJ.newObj())
        def title:MfJ (Tools.prop("string" "The presentation's name"))
        title.putInt("maxLength" 200)
        cp.put("title" title)
        cp.put("markdown" (Tools.prop("string" "The whole deck as Sliqtly Markdown")))
        Tools.deckFields(cp)
        tools.add((Tools.tool("create_presentation" "Create a presentation" "Create a Sliqtly slide presentation from Markdown (# title slide, ## per slide), an optional theme, extra CSS, pictures and data files (.xlsx, .csv, .json) its charts and tables read. Returns a link that opens the presentation and a link to edit a copy in the Sliqtly editor." (Tools.schema(cp ([] _:string ("title" "markdown")))) (Tools.annotations(false 0 false true)) (Tools.uiMeta(host)))))

        def up:MfJ (MfJ.newObj())
        up.put("deck_id" (Tools.prop("string" "deck_id from create_presentation")))
        up.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        def title2:MfJ (Tools.prop("string" ""))
        title2.putInt("maxLength" 200)
        up.put("title" title2)
        up.put("markdown" (Tools.prop("string" "The whole deck as Sliqtly Markdown")))
        Tools.deckFields(up)
        tools.add((Tools.tool("update_presentation" "Update a presentation" "Change a presentation made with create_presentation, keeping its link. Send only what changes: markdown replaces the whole text; images and files are added (or replace ones of the same name)." (Tools.schema(up ([] _:string ("deck_id")))) (Tools.annotations(false 1 true true)) (Tools.uiMeta(host)))))

        def bp:MfJ (MfJ.newObj())
        bp.put("deck_id" (Tools.prop("string" "deck_id from create_presentation")))
        bp.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        def num:MfJ (MfJ.newObj())
        num.putStr("type" "integer")
        num.putInt("minimum" 1)
        def chartOf:MfJ (MfJ.newArr())
        chartOf.add(num)
        def chartName:MfJ (MfJ.newObj())
        chartName.putStr("type" "string")
        chartOf.add(chartName)
        def chart:MfJ (MfJ.newObj())
        chart.put("anyOf" chartOf)
        chart.putStr("description" "Which chart: its number among the deck's vega-lite charts (1 = first), or the title of the slide it is on")
        bp.put("chart" chart)
        def gs:MfJ (MfJ.newObj())
        gs.put("google_sheets" (Tools.prop("string" "The sheet's id or link")))
        gs.put("sheet" (Tools.prop("string" "Tab name, e.g. Monthly")))
        gs.put("range" (Tools.prop("string" "Cells, e.g. \"A:B\" or \"Monthly!A:B\"")))
        def srcOf:MfJ (MfJ.newArr())
        srcOf.add((Tools.prop("string" "https URL of a CSV or JSON file, a Google Sheets link (…/spreadsheets/d/<id>/edit#gid=0), or sheet://<id>/<Sheet>!A:B")))
        srcOf.add((Tools.schema(gs ([] _:string ("google_sheets")))))
        def src:MfJ (MfJ.newObj())
        src.put("anyOf" srcOf)
        src.putStr("description" "Where the chart's data comes from")
        bp.put("source" src)
        tools.add((Tools.tool("bind_chart_data" "Connect a chart to live data" "Point one ```vega-lite chart of a presentation at live data: a CSV or JSON URL, or a Google Sheet shared as \"Anyone with the link\". The data is read when the deck opens; the rest of the chart's spec stays. Keeps the presentation's link." (Tools.schema(bp ([] _:string ("deck_id" "chart" "source")))) (Tools.annotations(false 1 true true)) (Tools.uiMeta(host)))))

        def gp:MfJ (MfJ.newObj())
        gp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        tools.add((Tools.tool("get_presentation" "Read a presentation" "Read a Sliqtly presentation's Markdown, theme, CSS, pictures and files (with what is in its .xlsx workbooks) by its deck_id (the id in https://sliqtly.com/s/<id>), to revise it." (Tools.schema(gp ([] _:string ("deck_id")))) (Tools.annotations(true -1 false false)) eitherMeta)))

        def lp:MfJ (MfJ.newObj())
        lp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        tools.add((Tools.tool("list_files" "List a presentation's files" "List the files a Sliqtly presentation keeps — pictures (media/), data (data/), chart specs (charts/) and workbooks (.xlsx) — by its deck_id. For each workbook: its sheets, their columns and row counts, and the CSV name a ```table, ```sheet or vega-lite chart reads a sheet by (the editor derives those CSVs from the workbook; they are not separate files). read_file gives the values." (Tools.schema(lp ([] _:string ("deck_id")))) (Tools.annotations(true -1 false false)) eitherMeta)))

        def rp:MfJ (MfJ.newObj())
        rp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        rp.put("path" (Tools.prop("string" "The file's path from list_files, e.g. data/sales.xlsx or data/sales-Q1.csv")))
        rp.put("sheet" (Tools.prop("string" "A workbook's sheet name; the first sheet when left out")))
        def off:MfJ (Tools.prop("integer" "First data row to return (0 = the row under the header)"))
        off.putInt("minimum" 0)
        rp.put("offset" off)
        def lim:MfJ (Tools.prop("integer" "How many data rows (default 200, at most 2000)"))
        lim.putInt("minimum" 1)
        lim.putInt("maximum" 2000)
        rp.put("limit" lim)
        tools.add((Tools.tool("read_file" "Read a presentation's data file" "Read the values in one of a Sliqtly presentation's data files by its deck_id and path: a workbook's sheet (path data/x.xlsx with sheet, or the sheet's CSV name from list_files such as data/x-Sheet.csv), a CSV or TSV (as rows), or a JSON or text file. Rows come up to `limit` at a time from `offset`." (Tools.schema(rp ([] _:string ("deck_id" "path")))) (Tools.annotations(true -1 false false)) eitherMeta)))

        def wp:MfJ (MfJ.newObj())
        wp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        wp.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        wp.put("path" (Tools.prop("string" "The workbook's path, e.g. data/budget.xlsx")))
        def cell:MfJ (MfJ.newObj())
        cell.put("type" (J.strs(([] _:string ("string" "number" "null")))))
        def row:MfJ (Tools.prop("array" ""))
        row.put("items" cell)
        def rowsP:MfJ (Tools.prop("array" "Rows of cell values, header row first"))
        rowsP.put("items" row)
        def sp:MfJ (MfJ.newObj())
        sp.put("name" (Tools.prop("string" "Sheet name (at most 31 characters, none of \\ / : * ? [ ])")))
        sp.put("rows" rowsP)
        sp.put("csv" (Tools.prop("string" "The sheet as CSV text instead of rows")))
        def sitem:MfJ (MfJ.newObj())
        sitem.putStr("type" "object")
        sitem.put("properties" sp)
        sitem.put("required" (J.strs(([] _:string ("name")))))
        def sheetsP:MfJ (Tools.prop("array" "The workbook's sheets in order"))
        sheetsP.put("items" sitem)
        sheetsP.putInt("minItems" 1)
        sheetsP.putInt("maxItems" 20)
        wp.put("sheets" sheetsP)
        tools.add((Tools.tool("write_workbook" "Write a presentation's workbook" "Write a whole .xlsx workbook into a presentation made with create_presentation (or the signed-in owner's own), replacing the file of the same name: tidy or reorganize a workbook read with read_file, or add a new one. Give every sheet in full, as rows (the first row is the header) or as CSV text. Values only: formatting, formulas and column widths are not kept. Needs sign-in." (Tools.schema(wp ([] _:string ("deck_id" "path" "sheets")))) (Tools.annotations(false 1 true false)) eitherMeta)))

        def listMeta:MfJ (MfJ.newObj())
        def only:MfJ (MfJ.newArr())
        only.add((Tools.oauthScheme()))
        listMeta.put("securitySchemes" only)
        tools.add((Tools.tool("list_presentations" "List my presentations" "List the signed-in user's own Sliqtly presentations (newest first) with their links and deck_ids. Needs sign-in." (Tools.schema((MfJ.newObj()) none)) (Tools.annotations(true -1 false false)) listMeta)))
        return tools
    }

    ; --- the preview resource

    sfn csp:MfJ (base:string) {
        def frames:[string] (Tools.frames(base))
        ; the preview runs Sliqtly's viewer itself (preview.html): its scripts
        ; and fonts from the site and Firebase's CDN, the share from Firestore,
        ; the pictures from Storage
        def resources:[string] (Tools.frames(base))
        push resources "https://www.gstatic.com"
        def connects:[string] (Tools.frames(base))
        push connects "https://firestore.googleapis.com"
        push connects "https://firebasestorage.googleapis.com"
        def c:MfJ (MfJ.newObj())
        c.put("frameDomains" (J.strs(frames)))
        c.put("resourceDomains" (J.strs(resources)))
        c.put("connectDomains" (J.strs(connects)))
        return c
    }

    sfn uiCsp:MfJ (base:string) {
        def ui:MfJ (MfJ.newObj())
        ui.put("csp" (Tools.csp(base)))
        ui.putBool("prefersBorder" false)
        return ui
    }

    sfn resources:MfJ (host:McpHost base:string) {
        def r:MfJ (MfJ.newObj())
        r.putStr("uri" (Tools.previewUri(host)))
        r.putStr("name" "preview")
        r.putStr("title" "Sliqtly presentation")
        r.putStr("description" "Shows the presentation inline")
        r.putStr("mimeType" (Tools.APP_MIME()))
        def meta:MfJ (MfJ.newObj())
        meta.put("ui" (Tools.uiCsp(base)))
        r.put("_meta" meta)
        def a:MfJ (MfJ.newArr())
        a.add(r)
        return a
    }

    ; the contents of a resource, or a null value for an unknown uri
    sfn read:MfJ (host:McpHost uri:string) {
        ; a client that took the tool list before the preview changed still
        ; asks for the older name: it gets the current preview
        if (((startsWith uri "ui://sliqtly/preview-") == false) || ((endsWith uri ".html") == false)) {
            return (new MfJ)
        }
        def base:string (host_base_url host)
        def c:MfJ (MfJ.newObj())
        c.putStr("uri" uri)
        c.putStr("mimeType" (Tools.APP_MIME()))
        c.putStr("text" (host_asset host "preview.html"))
        def meta:MfJ (MfJ.newObj())
        meta.put("ui" (Tools.uiCsp(base)))
        def csp:MfJ (Tools.csp(base))
        def w:MfJ (MfJ.newObj())
        w.put("connect_domains" (csp.field("connectDomains")))
        w.put("resource_domains" (csp.field("resourceDomains")))
        w.put("frame_domains" (csp.field("frameDomains")))
        meta.put("openai/widgetCSP" w)
        meta.putStr("openai/widgetDescription" "The Sliqtly presentation, playable inline.")
        meta.putBool("openai/widgetPrefersBorder" true)
        c.put("_meta" meta)
        def contents:MfJ (MfJ.newArr())
        contents.add(c)
        def out:MfJ (MfJ.newObj())
        out.put("contents" contents)
        return out
    }

    ; --- results

    sfn text:MfJ (s:string) {
        def c:MfJ (MfJ.newObj())
        c.putStr("type" "text")
        c.putStr("text" s)
        def a:MfJ (MfJ.newArr())
        a.add(c)
        return a
    }

    sfn fail:MfJ (message:string) {
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text(message)))
        r.putBool("isError" true)
        return r
    }

    ; Pictures and files are stored only for a signed-in user: anyone could
    ; otherwise keep any bytes at a public address.
    sfn needsSignIn:MfJ (caller:Caller what:string) {
        def r:MfJ (Tools.fail(("Storing " + what + " needs sign-in. Connect Sliqtly with sign-in (Google), or leave them out: without sign-in a presentation is text only.")))
        if ((strlen caller.signIn) > 0) {
            def meta:MfJ (MfJ.newObj())
            meta.put("mcp/www_authenticate" (J.strs(([] _:string (("Bearer resource_metadata=\"" + caller.signIn + "\", error=\"insufficient_scope\", error_description=\"Sign in to Sliqtly to store pictures and files\""))))))
            r.put("_meta" meta)
        }
        return r
    }

    ; "pictures", "data files" or "" for what a call would store
    sfn uploads:string (a:MfJ) {
        if ((array_length (a.list("images"))) > 0) {
            return "pictures"
        }
        if ((array_length (a.list("files"))) > 0) {
            return "data files"
        }
        return ""
    }

    sfn links:void (out:MfJ base:string id:string) {
        out.putStr("share_url" (base + "/s/" + id))
        out.putStr("edit_url" (base + "/s/" + id + "?edit"))
    }

    sfn result:MfJ (host:McpHost caller:Caller out:MfJ verb:string) {
        def lines:[string]
        push lines (verb + ": \"" + (out.str_("title")) + "\" (" + (out.str_("slides")) + " slides, theme " + (out.str_("theme")) + ").")
        push lines ("Presentation: " + (out.str_("share_url")))
        push lines ("Open in the editor: " + (out.str_("edit_url")))
        if caller.signedIn {
            def who:string caller.name
            if ((strlen who) == 0) {
                who = "the signed-in user"
            }
            push lines ("Saved in the Sliqtly account of " + who + ".")
        } {
            if (out.has("deck_id")) {
                push lines "Not signed in: the presentation is deleted 30 days after its last change. Sign in to keep it, or to add pictures and files."
            }
        }
        if (out.has("deck_id")) {
            push lines ("deck_id: " + (out.str_("deck_id")))
        }
        if (out.has("edit_key")) {
            push lines ("edit_key: " + (out.str_("edit_key")) + " (needed for update_presentation; do not show it to others)")
        }
        for (J.strList((out.field("warnings")))) w:string i {
            push lines ("Note: " + w)
        }
        push lines "Give the user the presentation link."
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((join lines "\n"))))
        r.put("structuredContent" out)
        def meta:MfJ (Tools.uiMeta(host))
        ; the preview reads a stored deck from Firestore with the site's config
        if (out.has("deck_id")) {
            def cfg:MfJ (J.parse((host_web_config host)))
            if (cfg.isObj()) {
                meta.put("sliqtly/firebase" cfg)
            }
        }
        r.put("_meta" meta)
        return r
    }

    ; --- the checks zod makes on the Node server; "" when the arguments hold

    sfn checkArgs:string (a:MfJ required:[string]) {
        if ((a.kind != 5) && (a.kind != 0)) {
            return "Invalid arguments: expected an object."
        }
        for required r:string i {
            if ((a.field(r)).kind != 3) {
                return ("Invalid arguments: " + r + " is required.")
            }
        }
        for ([] _:string ("title" "markdown" "theme" "css" "css_mode" "deck_id" "edit_key" "path" "sheet")) k:string j {
            def v:MfJ (a.field(k))
            if ((v.kind != 0) && (v.kind != 3)) {
                return ("Invalid arguments: " + k + " is a string.")
            }
        }
        def title:MfJ (a.field("title"))
        if ((title.kind == 3) && ((Tools.chars(title.str)) > 200)) {
            return "Invalid arguments: title is longer than 200 characters."
        }
        def theme:MfJ (a.field("theme"))
        if ((theme.kind == 3) && ((Deck.inList((Deck.THEMES()) theme.str)) == false)) {
            return ("Invalid arguments: theme is one of " + (join (Deck.THEMES()) ", ") + ".")
        }
        def mode:MfJ (a.field("css_mode"))
        if ((mode.kind == 3) && ((mode.str != "extend") && (mode.str != "replace"))) {
            return "Invalid arguments: css_mode is extend or replace."
        }
        def chart:MfJ (a.field("chart"))
        if (chart.kind == 2) {
            if ((chart.num < 1.0) || (chart.num != (to_double (to_int chart.num)))) {
                return "Invalid arguments: chart is a whole number from 1."
            }
        }
        if ((chart.kind != 0) && ((chart.kind != 2) && (chart.kind != 3))) {
            return "Invalid arguments: chart is a number or a slide title."
        }
        def source:MfJ (a.field("source"))
        if (source.isObj()) {
            if ((source.field("google_sheets")).kind != 3) {
                return "Invalid arguments: source.google_sheets is required."
            }
            for ([] _:string ("sheet" "range")) sk:string sj {
                def sv:MfJ (source.field(sk))
                if ((sv.kind != 0) && (sv.kind != 3)) {
                    return ("Invalid arguments: source." + sk + " is a string.")
                }
            }
        } {
            if ((source.kind != 0) && (source.kind != 3)) {
                return "Invalid arguments: source is a URL or { google_sheets }."
            }
        }
        for ([] _:string ("offset" "limit")) nk:string nj {
            def nv:MfJ (a.field(nk))
            if (nv.kind != 0) {
                if ((nv.kind != 2) || (nv.num != (to_double (to_int nv.num)))) {
                    return ("Invalid arguments: " + nk + " is a whole number.")
                }
            }
        }
        def offv:MfJ (a.field("offset"))
        if ((offv.kind == 2) && (offv.num < 0.0)) {
            return "Invalid arguments: offset is 0 or more."
        }
        def limv:MfJ (a.field("limit"))
        if ((limv.kind == 2) && ((limv.num < 1.0) || (limv.num > 2000.0))) {
            return "Invalid arguments: limit is from 1 to 2000."
        }
        def dfiles:MfJ (a.field("files"))
        if ((dfiles.kind != 0) && (dfiles.kind != 4)) {
            return "Invalid arguments: files is a list."
        }
        for dfiles.arr df:MfJ k3 {
            if ((df.isObj()) == false) {
                return "Invalid arguments: every file is an object."
            }
            if ((df.field("name")).kind != 3) {
                return "Invalid arguments: every file needs a name."
            }
            for ([] _:string ("text" "url" "data_base64")) ff:string fm {
                def ffv:MfJ (df.field(ff))
                if ((ffv.kind != 0) && (ffv.kind != 3)) {
                    return ("Invalid arguments: file " + ff + " is a string.")
                }
            }
        }
        def images:MfJ (a.field("images"))
        if ((images.kind != 0) && (images.kind != 4)) {
            return "Invalid arguments: images is a list."
        }
        for images.arr img:MfJ k2 {
            if ((img.isObj()) == false) {
                return "Invalid arguments: every image is an object."
            }
            if ((img.field("name")).kind != 3) {
                return "Invalid arguments: every image needs a name."
            }
            for ([] _:string ("url" "data_base64" "mime_type")) f:string m {
                def fv:MfJ (img.field(f))
                if ((fv.kind != 0) && (fv.kind != 3)) {
                    return ("Invalid arguments: image " + f + " is a string.")
                }
            }
        }
        return ""
    }

    ; characters, not bytes: UTF-8 lead bytes
    sfn chars:int (s:string) {
        def n:int (strlen s)
        def count:int 0
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            if ((c < 128) || (c >= 192)) {
                count = (count + 1)
            }
            i = (i + 1)
        }
        return count
    }

    sfn has:boolean (a:MfJ key:string) {
        return ((a.field(key)).kind == 3)
    }

    ; --- the stylesheet stored with the deck: hasCss false keeps the theme

    sfn sheet:Sheet (host:McpHost theme:string a:MfJ mode:string) {
        def s (new Sheet)
        def css:string (a.str_("css"))
        if (((Tools.has(a "css")) == false) || ((strlen (trim css)) == 0)) {
            if (mode == "replace") {
                s.hasCss = true
            }
            return s
        }
        if ((strlen css) > (Deck.MAX_CSS())) {
            s.err = "css is larger than 100 KB."
            return s
        }
        s.hasCss = true
        if (mode == "replace") {
            s.css = css
            return s
        }
        def base:string (host_theme_css host theme)
        if ((strlen (host_error host)) > 0) {
            s.fatal = (host_error host)
            return s
        }
        s.css = (base + "\n/* --- added for this deck --- */\n" + css + "\n")
        return s
    }

    ; the deck as the player reads it, with the sheet it is shown with: its
    ; own, or the theme's (fetched once); with neither, the outline's count
    ; the slide backgrounds (bg=media/<name>) for the contrast check: from
    ; this call's pictures, else from the deck's stored ones (deckId)
    sfn backgrounds:CheckPics (host:McpHost md:string imgs:[Img] deckId:string) {
        def out (new CheckPics)
        def names:[string]
        def from:int 0
        while true {
            def rest:string (substring md from (strlen md))
            def at:int (indexOf rest "bg=media/")
            if (at < 0) {
                break
            }
            def start:int ((from + at) + 9)
            def e:int start
            while ((e < (strlen md)) && (Tools.nameChar((charAt md e)))) {
                e = (e + 1)
            }
            def name:string (substring md start e)
            if (((strlen name) > 0) && ((indexOf names name) < 0)) {
                push names name
            }
            from = e
        }
        for names name:string ni {
            if (ni >= 10) {
                break
            }
            def handle:int 0
            def type:string ""
            for imgs im:Img ii {
                if ((im.name == name) && ((strlen im.path) == 0)) {
                    handle = im.handle
                    type = im.type
                }
            }
            if ((handle == 0) && ((strlen deckId) > 0)) {
                def got:MfJ (J.parse((host_file_bytes host deckId ("media/" + name))))
                if ((strlen (host_error host)) > 0) {
                    host_clear_error host
                } {
                    handle = (got.int_("handle" 0))
                }
            }
            if (handle == 0) {
                continue
            }
            def pic (new CheckPic)
            pic.name = ("/media/" + name)
            def grid:[int] (host_image_grid host handle)
            if ((array_length grid) > 2) {
                pic.w = (itemAt grid 0)
                pic.h = (itemAt grid 1)
                def k:int 2
                while (k < (array_length grid)) {
                    push pic.grid (itemAt grid k)
                    k = (k + 1)
                }
            }
            if ((strlen type) == 0) {
                type = "image/png"
            }
            push out.pics pic
            push out.data (host_image_bytes host handle)
            push out.types type
        }
        return out
    }

    sfn nameChar:boolean (ch:int) {
        if ((((ch >= 48) && (ch <= 57)) || ((ch >= 65) && (ch <= 90))) || ((ch >= 97) && (ch <= 122))) {
            return true
        }
        return (((ch == 46) || (ch == 45)) || (ch == 95))
    }

    sfn checkDeck:Checked (host:McpHost md:string theme:string hasCss:boolean css:string bgs:CheckPics) {
        def sheet:string css
        if (hasCss == false) {
            sheet = (host_theme_css host theme)
            if ((strlen (host_error host)) > 0) {
                host_log host ("theme for the checks: " + (host_error host))
                host_clear_error host
                sheet = ""
            }
        }
        def c:Checked (Check.deck(md sheet bgs.pics bgs.data bgs.types))
        for (Charts.typeWarnings(md)) tw:string ti {
            push c.warnings tw
        }
        if (c.laidOut == false) {
            c.slides = (array_length ((Deck.outline(md)).titles))
        }
        return c
    }

    ; --- the calls; a null value for an unknown tool

    sfn call:MfJ (host:McpHost caller:Caller name:string args:MfJ) {
        if (name == "sliqtly_guide") {
            def g:MfJ (MfJ.newObj())
            g.put("content" (Tools.text((host_asset host "guide.md"))))
            return g
        }
        if ((((name == "create_presentation") || (name == "update_presentation")) || (name == "bind_chart_data")) || (name == "write_workbook")) {
            def why:string (host_rate_limit host caller.who)
            if ((strlen why) > 0) {
                return (Tools.fail(why))
            }
        }
        def r:MfJ (new MfJ)
        if (name == "create_presentation") {
            r = (Tools.create(host caller args))
        }
        if (name == "update_presentation") {
            r = (Tools.update(host caller args))
        }
        if (name == "bind_chart_data") {
            r = (Tools.bindChart(host caller args))
        }
        if (name == "get_presentation") {
            r = (Tools.get(host caller args))
        }
        if (name == "list_files") {
            r = (Tools.listFiles(host caller args))
        }
        if (name == "read_file") {
            r = (Tools.readFile(host caller args))
        }
        if (name == "write_workbook") {
            r = (Tools.writeWorkbook(host caller args))
        }
        if (name == "list_presentations") {
            r = (Tools.listMine(host caller))
        }
        if (r.kind == 0) {
            return r
        }
        ; a storage or network failure that the tool did not turn into an answer
        def err:string (host_error host)
        if (((strlen err) > 0) && ((r.bool_("isError" false)) == false)) {
            host_log host (name + " failed: " + err)
            return (Tools.fail(("Sliqtly could not " + (Tools.verb(name)) + ": " + err)))
        }
        return r
    }

    sfn verb:string (name:string) {
        def u:int (indexOf name "_")
        if (u < 0) {
            return name
        }
        return ((substring name 0 u) + " " + (substring name (u + 1) (strlen name)))
    }

    sfn failed:MfJ (host:McpHost name:string err:string) {
        host_log host (name + " failed: " + err)
        return (Tools.fail(("Sliqtly could not " + (Tools.verb(name)) + ": " + err)))
    }

    sfn create:MfJ (host:McpHost caller:Caller a:MfJ) {
        def bad:string (Tools.checkArgs(a ([] _:string ("title" "markdown"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        def up:string (Tools.uploads(a))
        if (((caller.signedIn == false) && ((host_store_kind host) != "link")) && ((strlen up) > 0)) {
            return (Tools.needsSignIn(caller up))
        }
        def md:string (a.str_("markdown"))
        def theme:string "aurora"
        if (Tools.has(a "theme")) {
            theme = (a.str_("theme"))
        }
        def mode:string "extend"
        if (Tools.has(a "css_mode")) {
            mode = (a.str_("css_mode"))
        }
        if ((strlen md) > (Deck.MAX_MD())) {
            return (Tools.fail("markdown is larger than 300 KB."))
        }
        if ((strlen (trim md)) == 0) {
            return (Tools.fail("markdown is empty."))
        }
        def sh:Sheet (Tools.sheet(host theme a mode))
        if ((strlen sh.err) > 0) {
            return (Tools.fail(sh.err))
        }
        if ((strlen sh.fatal) > 0) {
            return (Tools.failed(host "create_presentation" sh.fatal))
        }
        def loaded:Loaded (Deck.loadImages(host (a.list("images"))))
        if ((strlen loaded.err) > 0) {
            return (Tools.fail(loaded.err))
        }
        def data:Loaded (Files.loadData(host (a.list("files"))))
        if ((strlen data.err) > 0) {
            return (Tools.fail(data.err))
        }
        def names:[string]
        for loaded.imgs im:Img i {
            push names im.name
        }
        def none:[string]
        def ws:[string] (Deck.warnings(md names none))
        def ck:Checked (Tools.checkDeck(host md theme sh.hasCss sh.css (Tools.backgrounds(host md loaded.imgs ""))))
        for ck.warnings cw:string ci {
            push ws cw
        }
        def out:MfJ (MfJ.newObj())
        out.putStr("title" (a.str_("title")))
        out.putStr("theme" theme)
        out.putInt("slides" ck.slides)
        def base:string (host_base_url host)
        if ((host_store_kind host) == "link") {
            if ((array_length loaded.imgs) > 0) {
                push ws "Pictures are not stored on this server (no cloud storage configured); the slides show without them."
            }
            if ((array_length data.imgs) > 0) {
                push ws "Data files are not stored on this server (no cloud storage configured)."
            }
            out.put("warnings" (J.strs(ws)))
            def q:string ("md=" + (host_pack_text host md))
            q = (q + "&theme=" + (host_uri_encode host theme))
            if sh.hasCss {
                q = (q + "&css=" + (host_pack_text host sh.css))
            }
            out.putStr("share_url" (base + "/#" + q + "&mode=show"))
            out.putStr("edit_url" (base + "/#" + q))
            return (Tools.result(host caller out "Created"))
        }
        out.put("warnings" (J.strs(ws)))
        def owner:string "mcp"
        if caller.signedIn {
            owner = caller.uid
        }
        def kept:[Img]
        for loaded.imgs li:Img lk {
            push kept li
        }
        for data.imgs di:Img dk {
            push kept di
        }
        def made:Created (Store.create(host (a.str_("title")) md theme sh.hasCss sh.css kept owner))
        if ((strlen made.err) > 0) {
            return (Tools.failed(host "create_presentation" made.err))
        }
        Tools.links(out base made.id)
        out.putStr("deck_id" made.id)
        out.putStr("edit_key" made.key)
        return (Tools.withData(host (Tools.result(host caller out "Created")) data.imgs))
    }

    sfn update:MfJ (host:McpHost caller:Caller a:MfJ) {
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured): call create_presentation again with the whole deck."))
        }
        def bad:string (Tools.checkArgs(a ([] _:string ("deck_id"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        def up:string (Tools.uploads(a))
        if ((caller.signedIn == false) && ((strlen up) > 0)) {
            return (Tools.needsSignIn(caller up))
        }
        if ((Tools.has(a "markdown")) && ((strlen (a.str_("markdown"))) > (Deck.MAX_MD()))) {
            return (Tools.fail("markdown is larger than 300 KB."))
        }
        def id:string (a.str_("deck_id"))
        def ed:Editable (Tools.editable(host caller id (a.str_("edit_key"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "update_presentation" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def cur:MfJ ed.cur
        def mine:boolean ed.mine
        def key:string ed.key
        def th:string "aurora"
        if (Tools.has(a "theme")) {
            th = (a.str_("theme"))
        } {
            if ((cur.field("theme")).kind == 3) {
                th = (cur.str_("theme"))
            }
        }
        def p (new DeckPatch)
        ; a new theme with no new css drops the old theme's sheet
        if (Tools.has(a "css")) {
            def mode:string "extend"
            if (Tools.has(a "css_mode")) {
                mode = (a.str_("css_mode"))
            }
            def sh:Sheet (Tools.sheet(host th a mode))
            if ((strlen sh.err) > 0) {
                return (Tools.fail(sh.err))
            }
            if ((strlen sh.fatal) > 0) {
                return (Tools.failed(host "update_presentation" sh.fatal))
            }
            if sh.hasCss {
                p.cssMode = 1
                p.css = sh.css
            } {
                p.cssMode = 2
            }
        } {
            if ((Tools.has(a "theme")) && ((a.str_("theme")) != (cur.str_("theme")))) {
                p.cssMode = 2
            }
        }
        if (Tools.has(a "title")) {
            p.hasName = true
            p.name = (a.str_("title"))
        }
        if (Tools.has(a "markdown")) {
            p.hasMd = true
            p.md = (a.str_("markdown"))
        }
        if (Tools.has(a "theme")) {
            p.hasTheme = true
            p.theme = (a.str_("theme"))
        }
        def loaded:Loaded (Deck.loadImages(host (a.list("images"))))
        if ((strlen loaded.err) > 0) {
            return (Tools.fail(loaded.err))
        }
        def data:Loaded (Files.loadData(host (a.list("files"))))
        if ((strlen data.err) > 0) {
            return (Tools.fail(data.err))
        }
        def kept:[Img]
        for loaded.imgs li:Img lk {
            push kept li
        }
        for data.imgs di:Img dk {
            push kept di
        }
        def saved:MfJ (Store.update(host id (mine == false) key p kept))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "update_presentation" (host_error host)))
        }
        return (Tools.withData(host (Tools.updated(host caller id saved "")) data.imgs))
    }

    ; the stored deck, if this caller may change it (a host error stops it too)
    sfn editable:Editable (host:McpHost caller:Caller id:string key:string) {
        def ed (new Editable)
        ed.key = key
        def cur:MfJ (Store.get(host id))
        if ((strlen (host_error host)) > 0) {
            return ed
        }
        def mine:boolean (((cur.isObj()) && caller.signedIn) && ((cur.str_("owner")) == caller.uid))
        if (((cur.isObj()) == false) || (((cur.str_("source")) != "mcp") && (mine == false))) {
            ed.fail = ("No presentation " + id + " that this server can change.")
            return ed
        }
        if ((mine == false) && ((strlen key) == 0)) {
            ed.fail = "edit_key is needed: the presentation is not this signed-in user's own."
            return ed
        }
        ed.cur = cur
        ed.mine = mine
        return ed
    }

    ; the answer to a change; note goes on its own line after the rest
    sfn updated:MfJ (host:McpHost caller:Caller id:string saved:MfJ note:string) {
        if ((saved.isObj()) == false) {
            return (Tools.fail("The edit_key does not match this presentation."))
        }
        def stored:[string]
        for (saved.list("files")) f:MfJ i {
            def path:string (f.str_("path"))
            if (startsWith path "media/") {
                path = (substring path 6 (strlen path))
            }
            push stored path
        }
        def md:string (saved.str_("md"))
        def none:[string]
        def ws:[string]
        for (Deck.warnings(md none stored)) w:string j {
            if ((startsWith w "Image") == false) {
                push ws w
            }
        }
        def savedCss:MfJ (saved.field("css"))
        def noImgs:[Img]
        def ck:Checked (Tools.checkDeck(host md (saved.str_("theme")) (savedCss.kind == 3) (saved.str_("css")) (Tools.backgrounds(host md noImgs id))))
        for ck.warnings cw:string ci {
            push ws cw
        }
        def out:MfJ (MfJ.newObj())
        out.put("title" (saved.field("name")))
        out.put("theme" (saved.field("theme")))
        out.putInt("slides" ck.slides)
        out.put("warnings" (J.strs(ws)))
        Tools.links(out (host_base_url host) id)
        out.putStr("deck_id" id)
        def r:MfJ (Tools.result(host caller out "Updated"))
        if ((strlen note) > 0) {
            def c0:MfJ (itemAt (r.list("content")) 0)
            c0.putStr("text" ((c0.str_("text")) + "\n" + note))
        }
        return r
    }

    ; a whole workbook of values in place of data/<name>.xlsx
    sfn writeWorkbook:MfJ (host:McpHost caller:Caller a:MfJ) {
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured): call create_presentation again with the whole deck."))
        }
        def bad:string (Tools.checkArgs(a ([] _:string ("deck_id" "path"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        if (caller.signedIn == false) {
            return (Tools.needsSignIn(caller "workbooks"))
        }
        def bare:string (trim (a.str_("path")))
        while (startsWith bare "/") {
            bare = (substring bare 1 (strlen bare))
        }
        if (startsWith bare "data/") {
            bare = (substring bare 5 (strlen bare))
        }
        def name:string (Deck.cleanName(bare))
        if (((strlen name) == 0) || ((Files.isXlsx(name)) == false)) {
            return (Tools.fail("path is the workbook's name under data/, ending in .xlsx (e.g. data/budget.xlsx)."))
        }
        def given:MfJ (a.field("sheets"))
        if ((given.kind != 4) || (((array_length given.arr) < 1) || ((array_length given.arr) > 20))) {
            return (Tools.fail("Invalid arguments: sheets is a list of 1 to 20 sheets."))
        }
        def seen:[string]
        def book:MfJ (MfJ.newArr())
        for given.arr s:MfJ i {
            if ((s.isObj()) == false) {
                return (Tools.fail("Invalid arguments: every sheet is an object."))
            }
            if ((s.field("name")).kind != 3) {
                return (Tools.fail("Invalid arguments: every sheet needs a name."))
            }
            def sn:string (s.str_("name"))
            def why:string (Files.badSheetName(sn))
            if ((strlen why) > 0) {
                return (Tools.fail((why + ".")))
            }
            if (Deck.inList(seen (to_lowercase sn))) {
                return (Tools.fail(("Two sheets are named \"" + sn + "\".")))
            }
            push seen (to_lowercase sn)
            def rows:MfJ (s.field("rows"))
            def csv:MfJ (s.field("csv"))
            if ((rows.kind == 4) == (csv.kind == 3)) {
                return (Tools.fail(("Sheet \"" + sn + "\": give rows or csv.")))
            }
            def out:MfJ (MfJ.newArr())
            if (rows.kind == 4) {
                for rows.arr r:MfJ j {
                    if (r.kind != 4) {
                        return (Tools.fail(("Sheet \"" + sn + "\": every row is a list of values.")))
                    }
                    for r.arr v:MfJ k {
                        if (((v.kind != 0) && (v.kind != 2)) && (v.kind != 3)) {
                            return (Tools.fail(("Sheet \"" + sn + "\": a cell is a string, a number or null.")))
                        }
                    }
                }
                out = rows
            } {
                for (Files.parseCsv(csv.str 44)) cr:SheetRow j2 {
                    out.add((J.strs(cr.cells)))
                }
            }
            def o:MfJ (MfJ.newObj())
            o.putStr("name" sn)
            o.put("rows" out)
            book.add(o)
        }
        def made:MfJ (J.parse((host_xlsx_write host (JOut.text(book)))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "write_workbook" (host_error host)))
        }
        if ((made.int_("size" 0)) > (Files.MAX_DATA())) {
            return (Tools.fail("The workbook would be larger than 10 MB."))
        }
        def id:string (a.str_("deck_id"))
        def ed:Editable (Tools.editable(host caller id (a.str_("edit_key"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "write_workbook" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def im (new Img)
        im.name = name
        im.path = ("data/" + name)
        im.type = (Files.XLSX_MIME())
        im.handle = (made.int_("handle" 0))
        im.size = (made.int_("size" 0))
        def kept:[Img]
        push kept im
        def saved:MfJ (Store.update(host id (ed.mine == false) ed.key (new DeckPatch) kept))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "write_workbook" (host_error host)))
        }
        def note:string "Formatting and formulas are not kept. Renamed or removed sheets change the CSV names the deck reads; check the deck's charts and tables still name them."
        return (Tools.withData(host (Tools.updated(host caller id saved note)) kept))
    }

    sfn bindChart:MfJ (host:McpHost caller:Caller a:MfJ) {
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured): call create_presentation again with the whole deck."))
        }
        def bad:string (Tools.checkArgs(a ([] _:string ("deck_id"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        def chart:MfJ (a.field("chart"))
        if (chart.kind == 0) {
            return (Tools.fail("Invalid arguments: chart is required."))
        }
        def source:MfJ (a.field("source"))
        if (source.kind == 0) {
            return (Tools.fail("Invalid arguments: source is required."))
        }
        def id:string (a.str_("deck_id"))
        def ed:Editable (Tools.editable(host caller id (a.str_("edit_key"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "bind_chart_data" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def bound:Bound (Charts.bind((ed.cur.str_("md")) chart source))
        if ((strlen bound.err) > 0) {
            return (Tools.fail(bound.err))
        }
        if ((strlen bound.md) > (Deck.MAX_MD())) {
            return (Tools.fail("markdown would be larger than 300 KB."))
        }
        def p (new DeckPatch)
        p.hasMd = true
        p.md = bound.md
        def noImgs:[Img]
        def saved:MfJ (Store.update(host id (ed.mine == false) ed.key p noImgs))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "bind_chart_data" (host_error host)))
        }
        def on:string ""
        if ((strlen bound.title) > 0) {
            on = (" (on \"" + bound.title + "\")")
        }
        def note:string ("Chart " + bound.index + on + " now reads " + (JOut.text((bound.spec.field("data")))) + ". PDF and PPTX exports are snapshots of the data when exported.")
        def r:MfJ (Tools.updated(host caller id saved note))
        def sc:MfJ (r.field("structuredContent"))
        if (sc.isObj()) {
            sc.putInt("chart" bound.index)
            sc.put("spec" bound.spec)
        }
        return r
    }

    sfn get:MfJ (host:McpHost caller:Caller a:MfJ) {
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured)."))
        }
        def bad:string (Tools.checkArgs(a ([] _:string ("deck_id"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        def id:string (a.str_("deck_id"))
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            return (Tools.fail("deck_id is the 10-character id in the share link."))
        }
        def d:MfJ (Store.get(host id))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "get_presentation" (host_error host)))
        }
        if ((d.isObj()) == false) {
            return (Tools.fail(("No presentation " + id + ".")))
        }
        def images:MfJ (MfJ.newArr())
        def names:[string]
        for (d.list("files")) f:MfJ i {
            def n:string (f.str_("path"))
            if ((Files.isPicture(n)) == false) {
                continue
            }
            n = (substring n 6 (strlen n))
            push names n
            def im:MfJ (MfJ.newObj())
            im.putStr("name" n)
            im.put("type" (f.field("type")))
            im.put("size" (f.field("size")))
            images.add(im)
        }
        def css:MfJ (d.field("css"))
        def hasCss:boolean (css.kind == 3)
        def out:MfJ (MfJ.newObj())
        out.putStr("title" (d.str_("name")))
        out.putStr("theme" (d.str_("theme")))
        out.putStr("markdown" (d.str_("md")))
        if hasCss {
            out.put("css" css)
        } {
            out.put("css" (new MfJ))
        }
        out.put("images" images)
        def files:MfJ (Tools.filesOf(host id d))
        out.put("files" files)
        Tools.links(out (host_base_url host) id)
        def themeName:string (d.str_("theme"))
        if ((strlen themeName) == 0) {
            themeName = "(document's own)"
        }
        def pics:string (join names ", ")
        if ((strlen pics) == 0) {
            pics = "none"
        }
        def parts:[string]
        push parts ("\"" + (out.str_("title")) + "\", theme " + themeName + ", " + (to_string (array_length names)) + " pictures: " + pics + ".")
        def others:MfJ (MfJ.newArr())
        for files.arr of:MfJ oi {
            if ((of.str_("kind")) != "picture") {
                others.add(of)
            }
        }
        if ((others.count()) > 0) {
            push parts ("Files:\n" + (Tools.filesText(others)))
        }
        if hasCss {
            push parts "It has its own stylesheet (css below)."
        }
        push parts "```markdown"
        def md:string (d.str_("md"))
        if ((strlen md) > 0) {
            push parts md
        }
        push parts "```"
        if hasCss {
            push parts ("```css\n" + css.str + "\n```")
        }
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((join parts "\n"))))
        r.put("structuredContent" out)
        return r
    }

    ; --- data files

    ; the kept data files, and the names a deck reads each one (or each
    ; sheet of a workbook) by
    sfn withData:MfJ (host:McpHost out:MfJ data:[Img]) {
        if ((array_length data) == 0) {
            return out
        }
        def lines:[string]
        push lines "Data files kept:"
        def kept:MfJ (MfJ.newArr())
        for data f:Img i {
            def k:MfJ (MfJ.newObj())
            k.putStr("path" f.path)
            if (Files.isXlsx(f.path)) {
                def info:MfJ (Files.info((Files.tables(host f.handle f.path))))
                k.put("sheets" info)
                def parts:[string]
                for info.arr o:MfJ j {
                    def cols:[string]
                    for (J.strList((o.field("columns")))) c:string ci {
                        push cols (JOut.text((J.s(c))))
                    }
                    push parts ("sheet " + (JOut.text((J.s((o.str_("name")))))) + " (" + (to_string (o.int_("rows" 0))) + " rows; columns " + (join cols ", ") + ") read as " + (o.str_("csv")))
                }
                def said:string (join parts "; ")
                if ((strlen said) == 0) {
                    said = "no sheet has values"
                }
                push lines ("- " + f.path + ": " + said)
            } {
                push lines ("- " + f.path)
            }
            kept.add(k)
        }
        def content:MfJ (out.field("content"))
        if ((content.count()) > 0) {
            def c0:MfJ (content.item(0))
            c0.putStr("text" ((c0.str_("text")) + "\n" + (join lines "\n")))
        }
        def sc:MfJ (out.field("structuredContent"))
        if (sc.isObj()) {
            sc.put("files" kept)
        }
        return out
    }

    ; every file a deck keeps, and what is in its workbooks
    sfn filesOf:MfJ (host:McpHost id:string d:MfJ) {
        def out:MfJ (MfJ.newArr())
        for (d.list("files")) f:MfJ i {
            def path:string (f.str_("path"))
            def o:MfJ (MfJ.newObj())
            o.putStr("path" path)
            o.putStr("kind" (Files.kindOf(path)))
            o.putStr("type" (f.str_("type")))
            o.putInt("size" (f.int_("size" 0)))
            if (Files.isXlsx(path)) {
                if ((f.int_("size" 0)) > (Files.MAX_READ())) {
                    o.putStr("note" "too large to read here")
                } {
                    def got:MfJ (J.parse((host_file_bytes host id path)))
                    def err:string (host_error host)
                    if ((strlen err) > 0) {
                        host_clear_error host
                        o.putStr("note" ("could not read the workbook: " + err))
                    } {
                        def ts:Tables (Files.tables(host (got.int_("handle" 0)) path))
                        if ((strlen ts.err) > 0) {
                            o.putStr("note" ("could not read the workbook: " + ts.err))
                        } {
                            o.put("sheets" (Files.info(ts)))
                        }
                    }
                }
            }
            out.add(o)
        }
        return out
    }

    sfn filesText:string (files:MfJ) {
        if ((files.count()) == 0) {
            return "No files."
        }
        def lines:[string]
        def data:boolean false
        for files.arr f:MfJ i {
            if ((f.str_("kind")) != "picture") {
                data = true
            }
        }
        if data {
            push lines "read_file reads the values of a data file or a workbook's sheet."
        }
        for files.arr f2:MfJ j {
            def note:string ""
            if ((strlen (f2.str_("note"))) > 0) {
                note = (" — " + (f2.str_("note")))
            }
            push lines ("- " + (f2.str_("path")) + " (" + (f2.str_("kind")) + ", " + (to_string (f2.int_("size" 0))) + " bytes)" + note)
            for (f2.list("sheets")) sh:MfJ k {
                push lines ("  - " + (Files.sheetLine(sh)))
            }
        }
        return (join lines "\n")
    }

    ; the stored deck for list_files and read_file, or why not
    sfn readable:MfJ (host:McpHost a:MfJ required:[string]) {
        def r:MfJ (MfJ.newObj())
        if ((host_store_kind host) == "link") {
            r.put("fail" (Tools.fail("This server keeps no decks (no cloud storage configured).")))
            return r
        }
        def bad:string (Tools.checkArgs(a required))
        if ((strlen bad) > 0) {
            r.put("fail" (Tools.fail(bad)))
            return r
        }
        def id:string (a.str_("deck_id"))
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            r.put("fail" (Tools.fail("deck_id is the 10-character id in the share link.")))
            return r
        }
        def d:MfJ (Store.get(host id))
        if ((strlen (host_error host)) > 0) {
            return r
        }
        if ((d.isObj()) == false) {
            r.put("fail" (Tools.fail(("No presentation " + id + "."))))
            return r
        }
        r.put("deck" d)
        return r
    }

    sfn listFiles:MfJ (host:McpHost caller:Caller a:MfJ) {
        def got:MfJ (Tools.readable(host a ([] _:string ("deck_id"))))
        if ((got.field("fail")).isObj()) {
            return (got.field("fail"))
        }
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "list_files" (host_error host)))
        }
        def files:MfJ (Tools.filesOf(host (a.str_("deck_id")) (got.field("deck"))))
        def sc:MfJ (MfJ.newObj())
        sc.put("files" files)
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((Tools.filesText(files)))))
        r.put("structuredContent" sc)
        return r
    }

    ; the values of one of a deck's files: a workbook's sheet (by the
    ; workbook's path, or the CSV name the deck reads the sheet by) or a CSV,
    ; TSV, JSON or text file; rows a window at a time
    sfn readFile:MfJ (host:McpHost caller:Caller a:MfJ) {
        def got:MfJ (Tools.readable(host a ([] _:string ("deck_id" "path"))))
        if ((got.field("fail")).isObj()) {
            return (got.field("fail"))
        }
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "read_file" (host_error host)))
        }
        def id:string (a.str_("deck_id"))
        def d:MfJ (got.field("deck"))
        def want:string (trim (a.str_("path")))
        while (startsWith want "/") {
            want = (substring want 1 (strlen want))
        }
        def sheetName:string (a.str_("sheet"))
        def hasSheet:boolean ((a.field("sheet")).kind == 3)
        def offset:int (a.int_("offset" 0))
        def limit:int (a.int_("limit" 200))
        def files:[MfJ] (d.list("files"))
        def found:MfJ (new MfJ)
        for files f:MfJ i {
            if (((f.str_("path")) == want) && ((found.isObj()) == false)) {
                found = f
            }
        }
        def isBook:boolean false
        def ts (new Tables)
        if (found.isObj()) {
            if (Files.isXlsx((found.str_("path")))) {
                isBook = true
                ts = (Tools.bookTables(host id found))
            }
        } {
            ; a sheet's CSV name: data/<book>-<Sheet>.csv or data/<book>.csv
            for files w:MfJ j {
                def wp:string (w.str_("path"))
                if (((found.isObj()) == false) && (Files.isXlsx(wp))) {
                    def base:string (substring wp 0 ((strlen wp) - 5))
                    if ((want == (base + ".csv")) || (startsWith want (base + "-"))) {
                        def all:Tables (Tools.bookTables(host id w))
                        for all.list t:DataTable k {
                            if ((t.csv == want) && ((found.isObj()) == false)) {
                                found = w
                                isBook = true
                                ts = all
                                sheetName = t.name
                                hasSheet = true
                            }
                        }
                    }
                }
            }
        }
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "read_file" (host_error host)))
        }
        if ((found.isObj()) == false) {
            def have:[string]
            for files h:MfJ m {
                if ((Files.isPicture((h.str_("path")))) == false) {
                    push have (h.str_("path"))
                }
            }
            def tail:string " It keeps no data files."
            if ((array_length have) > 0) {
                tail = (" Its files: " + (join have ", ") + ".")
            }
            return (Tools.fail(("No file " + want + " in presentation " + id + "." + tail)))
        }
        def path:string (found.str_("path"))
        if (Files.isPicture(path)) {
            return (Tools.fail((path + " is a picture.")))
        }
        if ((found.int_("size" 0)) > (Files.MAX_READ())) {
            return (Tools.fail((path + " is too large to read here.")))
        }
        def columns:[string]
        def rows:[SheetRow]
        def sheet:MfJ (new MfJ)
        def note:string ""
        if isBook {
            if ((strlen ts.err) > 0) {
                return (Tools.fail((path + ": could not read the workbook: " + ts.err)))
            }
            if ((array_length ts.list) == 0) {
                return (Tools.fail((path + ": no sheet has values.")))
            }
            def pick:int -1
            if hasSheet {
                def low:string (to_lowercase (trim sheetName))
                def si:int 0
                while (si < (array_length ts.list)) {
                    def tt:DataTable (itemAt ts.list si)
                    if (((to_lowercase tt.name) == low) && (pick < 0)) {
                        pick = si
                    }
                    si = (si + 1)
                }
            } {
                pick = 0
            }
            if (pick < 0) {
                def names:[string]
                for ts.list tn:DataTable n {
                    push names (JOut.text((J.s(tn.name))))
                }
                return (Tools.fail((path + " has no sheet \"" + sheetName + "\". Its sheets: " + (join names ", ") + ".")))
            }
            def chosen:DataTable (itemAt ts.list pick)
            sheet = (MfJ.newObj())
            sheet.putStr("name" chosen.name)
            sheet.putStr("csv" chosen.csv)
            columns = chosen.columns
            rows = chosen.rows
            if ((array_length ts.list) > 1) {
                def others:[string]
                for ts.list to:DataTable q {
                    if (to.name != chosen.name) {
                        push others (JOut.text((J.s(to.name))))
                    }
                }
                note = ("Other sheets: " + (join others ", ") + " (read with sheet). ")
            }
            note = (note + "Dates are written as the workbook shows them.")
        } {
            def gotBytes:MfJ (J.parse((host_file_bytes host id path)))
            if ((strlen (host_error host)) > 0) {
                return (Tools.failed(host "read_file" (host_error host)))
            }
            def text:string (host_text host (gotBytes.int_("handle" 0)))
            def low2:string (to_lowercase path)
            if ((endsWith low2 ".csv") || (endsWith low2 ".tsv")) {
                def sep:int 44
                if (endsWith low2 ".tsv") {
                    sep = 9
                }
                def all2:[SheetRow] (Files.parseCsv(text sep))
                def first:boolean true
                for all2 r:SheetRow ri {
                    if ((Files.filled(r)) > 0) {
                        if first {
                            columns = r.cells
                            first = false
                        } {
                            push rows r
                        }
                    }
                }
            } {
                ; JSON, a chart spec, text: as it is, cut at 200 KB
                def cut:boolean ((strlen text) > 204800)
                def shown:string text
                if cut {
                    shown = (substring text 0 204800)
                }
                def lead:string (path + " (" + (to_string (strlen text)) + " characters")
                if cut {
                    lead = (lead + ", first 200 KB")
                }
                def sc2:MfJ (MfJ.newObj())
                sc2.putStr("path" path)
                sc2.putStr("text" shown)
                sc2.putBool("truncated" cut)
                def r2:MfJ (MfJ.newObj())
                r2.put("content" (Tools.text((lead + "):\n" + shown))))
                r2.put("structuredContent" sc2)
                return r2
            }
        }
        def total:int (array_length rows)
        def window:[SheetRow]
        def rowsJ:MfJ (MfJ.newArr())
        def at:int offset
        while ((at < total) && (at < (offset + limit))) {
            def src:SheetRow (itemAt rows at)
            def wr (new SheetRow)
            for src.cells v:string vi {
                push wr.cells v
            }
            while ((array_length wr.cells) < (array_length columns)) {
                push wr.cells ""
            }
            push window wr
            rowsJ.add((J.strs(wr.cells)))
            at = (at + 1)
        }
        def shownCount:int (array_length window)
        def next:int -1
        if ((offset + shownCount) < total) {
            next = (offset + shownCount)
        }
        def colsQ:[string]
        for columns c:string cq {
            push colsQ (JOut.text((J.s(c))))
        }
        def lead2:string path
        if (sheet.isObj()) {
            lead2 = (lead2 + " sheet " + (JOut.text((J.s((sheet.str_("name")))))) + " (read in the deck as " + (sheet.str_("csv")) + ")")
        }
        def lines:[string]
        push lines (lead2 + ": " + (to_string total) + " data rows, columns " + (join colsQ ", ") + ".")
        def from:int 0
        if (shownCount > 0) {
            from = (offset + 1)
        }
        def range:string ("Rows " + (to_string from) + "–" + (to_string (offset + shownCount)) + " of " + (to_string total))
        if (next >= 0) {
            range = (range + "; next: offset " + (to_string next))
        }
        push lines (range + ".")
        if ((strlen note) > 0) {
            push lines (trim note)
        }
        def head (new SheetRow)
        head.cells = columns
        def all3:[SheetRow]
        push all3 head
        for window wr2:SheetRow wi {
            push all3 wr2
        }
        push lines "```csv"
        push lines (Files.toCsv(all3))
        push lines "```"
        def sc3:MfJ (MfJ.newObj())
        sc3.putStr("path" path)
        sc3.put("sheet" sheet)
        sc3.put("columns" (J.strs(columns)))
        sc3.put("rows" rowsJ)
        sc3.putInt("total_rows" total)
        sc3.putInt("offset" offset)
        if (next >= 0) {
            sc3.putInt("next_offset" next)
        } {
            sc3.put("next_offset" (new MfJ))
        }
        def r3:MfJ (MfJ.newObj())
        r3.put("content" (Tools.text((join lines "\n"))))
        r3.put("structuredContent" sc3)
        return r3
    }

    ; a kept workbook's sheets; a Storage error is left on the host
    sfn bookTables:Tables (host:McpHost id:string f:MfJ) {
        def ts (new Tables)
        if ((f.int_("size" 0)) > (Files.MAX_READ())) {
            ts.err = "too large to read here"
            return ts
        }
        def got:MfJ (J.parse((host_file_bytes host id (f.str_("path")))))
        if ((strlen (host_error host)) > 0) {
            return ts
        }
        return (Files.tables(host (got.int_("handle" 0)) (f.str_("path"))))
    }

    sfn listMine:MfJ (host:McpHost caller:Caller) {
        if (caller.signedIn == false) {
            def r:MfJ (Tools.fail("Listing presentations needs sign-in. Connect Sliqtly with sign-in (Google) to keep presentations in your own account."))
            if ((strlen caller.signIn) > 0) {
                def meta:MfJ (MfJ.newObj())
                meta.put("mcp/www_authenticate" (J.strs(([] _:string (("Bearer resource_metadata=\"" + caller.signIn + "\", error=\"insufficient_scope\", error_description=\"Sign in to Sliqtly to list your presentations\""))))))
                r.put("_meta" meta)
            }
            return r
        }
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured)."))
        }
        def docs:[MfJ] (Store.list(host caller.uid))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "list_presentations" (host_error host)))
        }
        def base:string (host_base_url host)
        def decks:MfJ (MfJ.newArr())
        def lines:[string]
        for docs d:MfJ i {
            def id:string (d.str_("id"))
            def deck:MfJ (MfJ.newObj())
            deck.putStr("deck_id" id)
            deck.putStr("title" (d.str_("name")))
            deck.putStr("theme" (d.str_("theme")))
            def t:double (Store.stamp(d))
            if (t > 0.0) {
                deck.putStr("updated" (host_iso_time host (to_int t)))
            } {
                deck.put("updated" (new MfJ))
            }
            Tools.links(deck base id)
            decks.add(deck)
            def title:string (d.str_("name"))
            if ((strlen title) == 0) {
                title = "(untitled)"
            }
            push lines ("- " + title + " (" + id + "): " + (deck.str_("share_url")))
        }
        def txt:string (join lines "\n")
        if ((array_length lines) == 0) {
            txt = "No presentations yet."
        }
        def sc:MfJ (MfJ.newObj())
        sc.put("presentations" decks)
        def r2:MfJ (MfJ.newObj())
        r2.put("content" (Tools.text(txt)))
        r2.put("structuredContent" sc)
        return r2
    }
}

; the deck's stylesheet: hasCss false stores none; err is the model's
; mistake, fatal the site's
class Sheet {
    def hasCss:boolean false
    def css:string ""
    def err:string ""
    def fatal:string ""
}
