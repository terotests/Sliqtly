; SPDX-License-Identifier: AGPL-3.0-or-later

; The tools (mcp/src/server.js): Markdown (+ a theme, CSS and pictures) into
; a presentation at sliqtly.com, and its link back.
;
; Tools: sliqtly_guide, create_presentation, update_presentation,
; bind_chart_data, get_presentation, list_files, read_file,
; list_presentations, list_comments, add_comment, resolve_comment,
; begin_work, end_work (two assistants on one deck: Work.rgr). create/update also name a UI
; resource (MCP Apps, and the same template for ChatGPT) that shows the deck
; inline in the chat.

Import "McpHost.rgr"
Import "McpJson.rgr"
Import "Deck.rgr"
Import "Check.rgr"
Import "Charts.rgr"
Import "Store.rgr"
Import "Files.rgr"
Import "WorkStore.rgr"
Import "SvgCheck.rgr"
Import "Edits.rgr"
Import "../presentation/PresReview.rgr"

; who is asking, for one request
class Caller {
    def signedIn:boolean false
    def uid:string ""
    def name:string ""
    ; resource metadata URL when sign-in is on, "" otherwise
    def signIn:string ""
    ; the rate limit key: "uid:…" or the address
    def who:string ""
}

; the stored deck a caller may change, or why not
class Editable {
    def fail:string ""
    def cur:MfJ (new MfJ)
    def mine:boolean false
    def key:string ""
}

class CheckPics {
    def pics:[CheckPic]
    def data:[buffer]
    def types:[string]
}

class Tools {
    ; named by its contents, as in mcp/: a client that kept an older preview
    ; by its URI asks for this one anew
    sfn previewUri:string (host:McpHost) {
        def h:string (host_sha256_hex host (host_asset host "preview.html"))
        return ("ui://sliqtly/preview-" + (substring h 0 10) + ".html")
    }
    sfn APP_MIME:string () {
        return "text/html;profile=mcp-app"
    }

    ; the site's domains, the configured one first
    sfn frames:[string] (base:string) {
        def out:[string]
        push out base
        if (base != "https://sliqtly.com") {
            push out "https://sliqtly.com"
        }
        if (base != "https://sliqtly.web.app") {
            push out "https://sliqtly.web.app"
        }
        return out
    }

    ; Sign-in is optional (ChatGPT reads this to offer both)
    sfn either:MfJ () {
        def a:MfJ (MfJ.newArr())
        def n:MfJ (MfJ.newObj())
        n.putStr("type" "noauth")
        a.add(n)
        a.add((Tools.oauthScheme()))
        return a
    }
    sfn oauthScheme:MfJ () {
        def o:MfJ (MfJ.newObj())
        o.putStr("type" "oauth2")
        o.put("scopes" (J.strs(([] _:string ("decks")))))
        return o
    }

    sfn uiMeta:MfJ (host:McpHost) {
        def m:MfJ (MfJ.newObj())
        m.put("securitySchemes" (Tools.either()))
        def ui:MfJ (MfJ.newObj())
        ui.putStr("resourceUri" (Tools.previewUri(host)))
        m.put("ui" ui)
        m.putStr("ui/resourceUri" (Tools.previewUri(host)))
        m.putStr("openai/outputTemplate" (Tools.previewUri(host)))
        m.putBool("openai/widgetAccessible" false)
        return m
    }

    ; --- input schemas, as the Node server's zod gives them

    sfn prop:MfJ (type:string desc:string) {
        def p:MfJ (MfJ.newObj())
        p.putStr("type" type)
        if ((strlen desc) > 0) {
            p.putStr("description" desc)
        }
        return p
    }

    sfn schema:MfJ (props:MfJ required:[string]) {
        def s:MfJ (MfJ.newObj())
        s.putStr("type" "object")
        s.put("properties" props)
        if ((array_length required) > 0) {
            s.put("required" (J.strs(required)))
        }
        s.putBool("additionalProperties" false)
        s.putStr("$schema" "http://json-schema.org/draft-07/schema#")
        return s
    }

    sfn deckFields:void (p:MfJ) {
        def theme:MfJ (Tools.prop("string" "Theme: aurora (default), nebula, carbon, ember, midnight (dark); corporate, editorial (light)"))
        theme.put("enum" (J.strs((Deck.THEMES()))))
        p.put("theme" theme)
        p.put("css" (Tools.prop("string" "CSS rules added on top of the theme (selectors: page, document, h1, h2, p, list, li, code, table, chart, diagram, .lead …). See sliqtly_guide.")))
        def mode:MfJ (Tools.prop("string" "extend (default): css is added after the theme's rules. replace: css is the whole stylesheet."))
        mode.put("enum" (J.strs(([] _:string ("extend" "replace")))))
        p.put("css_mode" mode)
        def ip:MfJ (MfJ.newObj())
        ip.put("name" (Tools.prop("string" "File name the Markdown uses as media/<name>, e.g. \"team.jpg\" → ![](media/team.jpg)")))
        ip.put("url" (Tools.prop("string" "A public https URL of the picture")))
        ip.put("data_base64" (Tools.prop("string" "The picture's bytes as base64 (instead of url)")))
        ip.put("text" (Tools.prop("string" "An SVG's source as it is (instead of url or data_base64): readable and fixable, no base64. Name it .svg.")))
        ip.put("mime_type" (Tools.prop("string" "image/png, image/jpeg, image/gif, image/webp or image/svg+xml, or a SmartArt diagram (a dgm:dataModel, name it .xml); inferred from the name when left out")))
        def item:MfJ (MfJ.newObj())
        item.putStr("type" "object")
        item.put("properties" ip)
        item.put("required" (J.strs(([] _:string ("name")))))
        def images:MfJ (Tools.prop("array" "Pictures the Markdown refers to as media/<name>. Needs sign-in."))
        images.put("items" item)
        p.put("images" images)
        def fp:MfJ (MfJ.newObj())
        fp.put("name" (Tools.prop("string" "File name, kept as data/<name>: \"sales.xlsx\", \"sales.csv\", \"sales.json\"")))
        fp.put("text" (Tools.prop("string" "The file's text (CSV, TSV, JSON or plain text)")))
        fp.put("data_base64" (Tools.prop("string" "The file's bytes as base64 (an .xlsx workbook)")))
        fp.put("url" (Tools.prop("string" "A public https URL of the file")))
        def fitem:MfJ (MfJ.newObj())
        fitem.putStr("type" "object")
        fitem.put("properties" fp)
        fitem.put("required" (J.strs(([] _:string ("name")))))
        def files:MfJ (Tools.prop("array" "Data files kept with the deck under data/: .xlsx workbooks, .csv, .tsv, .json, .txt (10 MB each); needs sign-in. A chart or ```table reads data/<name>.csv; a workbook's sheets are read as data/<book>-<Sheet>.csv (data/<book>.csv for a one-sheet book); see sliqtly_guide."))
        files.put("items" fitem)
        p.put("files" files)
    }

    sfn annotations:MfJ (readOnly:boolean destructive:int idempotent:boolean openWorld:boolean) {
        def a:MfJ (MfJ.newObj())
        a.putBool("readOnlyHint" readOnly)
        if (destructive == 0) {
            a.putBool("destructiveHint" false)
        }
        if (destructive == 1) {
            a.putBool("destructiveHint" true)
        }
        if (idempotent || (readOnly == false)) {
            a.putBool("idempotentHint" idempotent)
        }
        a.putBool("openWorldHint" openWorld)
        return a
    }

    sfn tool:MfJ (name:string title:string desc:string schema:MfJ ann:MfJ meta:MfJ) {
        def t:MfJ (MfJ.newObj())
        t.putStr("name" name)
        t.putStr("title" title)
        t.putStr("description" desc)
        t.put("inputSchema" schema)
        t.put("annotations" ann)
        t.put("_meta" meta)
        return t
    }

    sfn list:MfJ (host:McpHost) {
        def none:[string]
        def eitherMeta:MfJ (MfJ.newObj())
        eitherMeta.put("securitySchemes" (Tools.either()))
        def tools:MfJ (MfJ.newArr())
        tools.add((Tools.tool("sliqtly_guide" "Sliqtly syntax guide" "How to write a Sliqtly deck: slide structure, build animations, effects, pictures, charts (Vega-Lite), diagrams (Mermaid, Graphviz), math, themes and the CSS selectors. Read before the first create_presentation." (Tools.schema((MfJ.newObj()) none)) (Tools.annotations(true -1 false false)) eitherMeta)))

        def cp:MfJ (MfJ.newObj())
        def title:MfJ (Tools.prop("string" (Tools.withNameRule(host "The presentation's name."))))
        title.putInt("maxLength" 200)
        cp.put("title" title)
        cp.put("markdown" (Tools.prop("string" "The whole deck as Sliqtly Markdown")))
        Tools.deckFields(cp)
        tools.add((Tools.tool("create_presentation" "Create a presentation" (Tools.withNameRule(host "Create a Sliqtly slide presentation from Markdown (# title slide, ## per slide), an optional theme, extra CSS, pictures and data files (.xlsx, .csv, .json) its charts and tables read. Returns a link that opens the presentation and a link to edit a copy in the Sliqtly editor.")) (Tools.schema(cp ([] _:string ("title" "markdown")))) (Tools.annotations(false 0 false true)) (Tools.uiMeta(host)))))

        def up:MfJ (MfJ.newObj())
        up.put("deck_id" (Tools.prop("string" "deck_id from create_presentation")))
        up.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        def title2:MfJ (Tools.prop("string" (Tools.withNameRule(host "A new name for the presentation; leave out to keep it."))))
        title2.putInt("maxLength" 200)
        up.put("title" title2)
        up.put("markdown" (Tools.prop("string" "The whole deck as Sliqtly Markdown. For a small change send edits instead.")))
        def ep:MfJ (MfJ.newObj())
        ep.put("find" (Tools.prop("string" "Text to change, exactly as it is in the deck (spaces and line breaks too); it must be there once, or give all: true")))
        ep.put("replace" (Tools.prop("string" "What find becomes (\"\" removes it)")))
        ep.put("all" (Tools.prop("boolean" "Change every place find is, not just one")))
        def sn:MfJ (Tools.prop("integer" "Slide to replace or delete, numbered as in render_overview and the layout report (1 = first)"))
        sn.putInt("minimum" 1)
        ep.put("slide" sn)
        ep.put("slide_title" (Tools.prop("string" "Slide to replace or delete by its title (instead of slide)")))
        def an:MfJ (Tools.prop("integer" "Add the markdown's slides after this slide (0 = before the first)"))
        an.putInt("minimum" 0)
        ep.put("after_slide" an)
        ep.put("markdown" (Tools.prop("string" "With slide/slide_title: the slide's whole new Markdown from its heading (\"\" deletes the slide). With after_slide: the new slides.")))
        def eitem:MfJ (MfJ.newObj())
        eitem.putStr("type" "object")
        eitem.put("properties" ep)
        def edits:MfJ (Tools.prop("array" "Changes to the deck's Markdown instead of sending all of it: each edit is find + replace, slide (or slide_title) + markdown, or after_slide + markdown. Slide numbers and find refer to the deck as it is before these edits; two edits may not touch the same text. Not with markdown."))
        edits.put("items" eitem)
        up.put("edits" edits)
        up.put("base_version" (Tools.prop("string" "The version your markdown started from (from get_presentation, begin_work or your last update). When the deck changed since, the changes are merged; a change to the same lines is refused. Needed with markdown when another assistant is working on the deck; edits are made on the deck as it is and need none.")))
        up.put("work_id" (Tools.prop("string" "Your work_id from begin_work; renews your claim")))
        Tools.deckFields(up)
        tools.add((Tools.tool("update_presentation" "Update a presentation" "Change a presentation made with create_presentation, keeping its link. Send only what changes: edits change parts of the text (a phrase, one slide, new slides), markdown replaces the whole text; images and files are added (or replace ones of the same name). With markdown send base_version, so edits saved meanwhile by someone else are merged rather than overwritten." (Tools.schema(up ([] _:string ("deck_id")))) (Tools.annotations(false 1 true true)) (Tools.uiMeta(host)))))

        def bp:MfJ (MfJ.newObj())
        bp.put("deck_id" (Tools.prop("string" "deck_id from create_presentation")))
        bp.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        def num:MfJ (MfJ.newObj())
        num.putStr("type" "integer")
        num.putInt("minimum" 1)
        def chartOf:MfJ (MfJ.newArr())
        chartOf.add(num)
        def chartName:MfJ (MfJ.newObj())
        chartName.putStr("type" "string")
        chartOf.add(chartName)
        def chart:MfJ (MfJ.newObj())
        chart.put("anyOf" chartOf)
        chart.putStr("description" "Which chart: its number among the deck's vega-lite charts (1 = first), or the title of the slide it is on")
        bp.put("chart" chart)
        def gs:MfJ (MfJ.newObj())
        gs.put("google_sheets" (Tools.prop("string" "The sheet's id or link")))
        gs.put("sheet" (Tools.prop("string" "Tab name, e.g. Monthly")))
        gs.put("range" (Tools.prop("string" "Cells, e.g. \"A:B\" or \"Monthly!A:B\"")))
        def srcOf:MfJ (MfJ.newArr())
        srcOf.add((Tools.prop("string" "https URL of a CSV or JSON file, a Google Sheets link (…/spreadsheets/d/<id>/edit#gid=0), or sheet://<id>/<Sheet>!A:B")))
        srcOf.add((Tools.schema(gs ([] _:string ("google_sheets")))))
        def src:MfJ (MfJ.newObj())
        src.put("anyOf" srcOf)
        src.putStr("description" "Where the chart's data comes from")
        bp.put("source" src)
        tools.add((Tools.tool("bind_chart_data" "Connect a chart to live data" "Point one ```vega-lite chart of a presentation at live data: a CSV or JSON URL, or a Google Sheet shared as \"Anyone with the link\". The data is read when the deck opens; the rest of the chart's spec stays. Keeps the presentation's link." (Tools.schema(bp ([] _:string ("deck_id" "chart" "source")))) (Tools.annotations(false 1 true true)) (Tools.uiMeta(host)))))

        def gp:MfJ (MfJ.newObj())
        gp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        tools.add((Tools.tool("get_presentation" "Read a presentation" "Read a Sliqtly presentation's Markdown, theme, CSS, pictures and files (with what is in its .xlsx workbooks) by its deck_id (the id in https://sliqtly.com/s/<id>), to revise it." (Tools.schema(gp ([] _:string ("deck_id")))) (Tools.annotations(true -1 false false)) eitherMeta)))

        def rsp:MfJ (MfJ.newObj())
        rsp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        def snum:MfJ (MfJ.newObj())
        snum.putStr("type" "integer")
        snum.putInt("minimum" 1)
        def slideOf:MfJ (MfJ.newArr())
        slideOf.add(snum)
        def sname:MfJ (MfJ.newObj())
        sname.putStr("type" "string")
        slideOf.add(sname)
        def slideP:MfJ (MfJ.newObj())
        slideP.put("anyOf" slideOf)
        slideP.putStr("description" "Which slide: its number (1 = first) or its title")
        rsp.put("slide" slideP)
        tools.add((Tools.tool("render_slide" "Look at a slide" "A picture of one slide of a Sliqtly presentation (JPEG, 960×540 for a 16:9 slide) as the player draws it at the end of its animations, with the slide's layout report. Use it when the layout report on create/update looks suspect (small text, overlaps, empty space, crowded chart labels) and to check charts, diagrams and tables, whose look the report only measures." (Tools.schema(rsp ([] _:string ("deck_id" "slide")))) (Tools.annotations(true -1 true false)) eitherMeta)))

        def rop:MfJ (MfJ.newObj())
        rop.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        tools.add((Tools.tool("render_overview" "Look at all slides" "Every slide of a Sliqtly presentation as a numbered thumbnail in one picture (JPEG), with a line per slide from the layout report. One call checks the whole deck; ask render_slide for a closer look at a slide. Look once before saying a presentation is done." (Tools.schema(rop ([] _:string ("deck_id")))) (Tools.annotations(true -1 true false)) eitherMeta)))

        def xp:MfJ (MfJ.newObj())
        xp.put("deck_id" (Tools.prop("string" "deck_id of the presentation (the id in https://sliqtly.com/s/<id>)")))
        def fmt:MfJ (Tools.prop("string" "pdf or pptx (PowerPoint)"))
        fmt.put("enum" (J.strs(([] _:string ("pdf" "pptx")))))
        xp.put("format" fmt)
        def xn:MfJ (MfJ.newObj())
        xn.putStr("type" "integer")
        xn.putInt("minimum" 1)
        def xs:MfJ (Tools.prop("array" "Only these slides (numbers as in render_overview); all when left out"))
        xs.put("items" xn)
        xp.put("slides" xs)
        tools.add((Tools.tool("export_presentation" "Export a presentation" "A Sliqtly presentation as a PDF or a PowerPoint (.pptx) file, by its deck_id: a download link to give the user, kept until the next export of the same format. Slides as the player shows them at the end of their animations; the PPTX keeps text editable, with build steps, notes and transitions. Effects (fx=) are not drawn; the editor's File → Export draws them." (Tools.schema(xp ([] _:string ("deck_id" "format")))) (Tools.annotations(false 0 true false)) eitherMeta)))

        def lp:MfJ (MfJ.newObj())
        lp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        tools.add((Tools.tool("list_files" "List a presentation's files" "List the files a Sliqtly presentation keeps — pictures (media/), data (data/), chart specs (charts/) and workbooks (.xlsx) — by its deck_id. For each workbook: its sheets, their columns and row counts, and the CSV name a ```table, ```sheet or vega-lite chart reads a sheet by (the editor derives those CSVs from the workbook; they are not separate files). read_file gives the values." (Tools.schema(lp ([] _:string ("deck_id")))) (Tools.annotations(true -1 false false)) eitherMeta)))

        def rp:MfJ (MfJ.newObj())
        rp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        rp.put("path" (Tools.prop("string" "The file's path from list_files, e.g. data/sales.xlsx or data/sales-Q1.csv")))
        rp.put("sheet" (Tools.prop("string" "A workbook's sheet name; the first sheet when left out")))
        def off:MfJ (Tools.prop("integer" "First data row to return (0 = the row under the header)"))
        off.putInt("minimum" 0)
        rp.put("offset" off)
        def lim:MfJ (Tools.prop("integer" "How many data rows (default 200, at most 2000)"))
        lim.putInt("minimum" 1)
        lim.putInt("maximum" 2000)
        rp.put("limit" lim)
        tools.add((Tools.tool("read_file" "Read a presentation's data file" "Read the values in one of a Sliqtly presentation's data files by its deck_id and path: a workbook's sheet (path data/x.xlsx with sheet, or the sheet's CSV name from list_files such as data/x-Sheet.csv), a CSV or TSV (as rows), or a JSON or text file. Rows come up to `limit` at a time from `offset`." (Tools.schema(rp ([] _:string ("deck_id" "path")))) (Tools.annotations(true -1 false false)) eitherMeta)))

        def lcp:MfJ (MfJ.newObj())
        lcp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        lcp.put("include_resolved" (Tools.prop("boolean" "Also list resolved (closed) threads; default true")))
        tools.add((Tools.tool("list_comments" "Read review comments" "The review comments people left on a Sliqtly presentation's slides in review mode: each thread with its id, slide number and title, where on the slide it is pinned, whether it is resolved, and its messages in order. Answer them with add_comment; close one that is dealt with with resolve_comment." (Tools.schema(lcp ([] _:string ("deck_id")))) (Tools.annotations(true -1 false false)) eitherMeta)))

        def acp:MfJ (MfJ.newObj())
        acp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        acp.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        acp.put("text" (Tools.prop("string" "The message")))
        acp.put("thread_id" (Tools.prop("string" "Answer this thread (an id from list_comments); leave out to start a new comment on a slide")))
        def slideP:MfJ (Tools.prop("integer" "A new comment's slide number, 1 = the first slide"))
        slideP.putInt("minimum" 1)
        acp.put("slide" slideP)
        acp.put("slide_title" (Tools.prop("string" "A new comment's slide by its title, instead of slide")))
        def xP:MfJ (Tools.prop("number" "Where on the slide the comment is pinned, 0 = left edge, 1 = right edge (default near the top right)"))
        xP.putInt("minimum" 0)
        xP.putInt("maximum" 1)
        acp.put("x" xP)
        def yP:MfJ (Tools.prop("number" "0 = top edge, 1 = bottom edge"))
        yP.putInt("minimum" 0)
        yP.putInt("maximum" 1)
        acp.put("y" yP)
        acp.put("author" (Tools.prop("string" "The name shown on the message (default \"AI assistant\")")))
        tools.add((Tools.tool("add_comment" "Add a review comment" "Add a review comment to a Sliqtly presentation: a new comment pinned on a slide (slide or slide_title, optionally x and y), or an answer in a thread from list_comments (thread_id). A resolved thread is opened again by an answer. People see it in the editor's review mode." (Tools.schema(acp ([] _:string ("deck_id" "text")))) (Tools.annotations(false 0 false false)) eitherMeta)))

        def rcp:MfJ (MfJ.newObj())
        rcp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        rcp.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        rcp.put("thread_id" (Tools.prop("string" "The thread's id from list_comments")))
        rcp.put("resolved" (Tools.prop("boolean" "true (default) marks it resolved; false opens it again")))
        rcp.put("text" (Tools.prop("string" "A last message in the thread first, e.g. what was changed")))
        rcp.put("author" (Tools.prop("string" "The name shown on that message (default \"AI assistant\")")))
        tools.add((Tools.tool("resolve_comment" "Resolve a review comment" "Mark a review comment thread of a Sliqtly presentation resolved once it is dealt with (or open it again with resolved false). A resolved thread stays on the slide, dimmed; only people delete threads." (Tools.schema(rcp ([] _:string ("deck_id" "thread_id")))) (Tools.annotations(false 0 true false)) eitherMeta)))

        def wp:MfJ (MfJ.newObj())
        wp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        wp.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        wp.put("path" (Tools.prop("string" "The workbook's path, e.g. data/budget.xlsx")))
        def plain:MfJ (MfJ.newObj())
        plain.put("type" (J.strs(([] _:string ("string" "number" "null")))))
        def fp2:MfJ (MfJ.newObj())
        fp2.put("f" (Tools.prop("string" "Excel formula, e.g. \"=SUM(C2:C13)\"")))
        def fv:MfJ (MfJ.newObj())
        fv.put("type" (J.strs(([] _:string ("string" "number")))))
        fv.putStr("description" "The value the formula gives, so Sliqtly can show it (Excel recalculates on opening)")
        fp2.put("v" fv)
        def formula:MfJ (MfJ.newObj())
        formula.putStr("type" "object")
        formula.put("properties" fp2)
        formula.put("required" (J.strs(([] _:string ("f")))))
        def kinds:MfJ (MfJ.newArr())
        kinds.add(plain)
        kinds.add(formula)
        def cell:MfJ (MfJ.newObj())
        cell.put("anyOf" kinds)
        def row:MfJ (Tools.prop("array" ""))
        row.put("items" cell)
        def rowsP:MfJ (Tools.prop("array" "Rows of cells, header row first: a string, a number, null, or { f, v } for a formula"))
        rowsP.put("items" row)
        def sp:MfJ (MfJ.newObj())
        sp.put("name" (Tools.prop("string" "Sheet name (at most 31 characters, none of \\ / : * ? [ ])")))
        sp.put("rows" rowsP)
        sp.put("csv" (Tools.prop("string" "The sheet as CSV text instead of rows")))
        def sitem:MfJ (MfJ.newObj())
        sitem.putStr("type" "object")
        sitem.put("properties" sp)
        sitem.put("required" (J.strs(([] _:string ("name")))))
        def sheetsP:MfJ (Tools.prop("array" "The workbook's sheets in order"))
        sheetsP.put("items" sitem)
        sheetsP.putInt("minItems" 1)
        sheetsP.putInt("maxItems" 20)
        wp.put("sheets" sheetsP)
        tools.add((Tools.tool("write_workbook" "Write a presentation's workbook" "Write a whole .xlsx workbook into a presentation made with create_presentation (or the signed-in owner's own), replacing the file of the same name: tidy or reorganize a workbook read with read_file, or add a new one. Give every sheet in full, as rows (the first row is the header) or as CSV text; a cell may be a formula { f: \"=SUM(C2:C13)\", v: 1234.5 }. Use this rather than sending an .xlsx as base64, which gets corrupted when long. Formatting, colours, filters and column widths are not kept. Needs sign-in." (Tools.schema(wp ([] _:string ("deck_id" "path" "sheets")))) (Tools.annotations(false 1 true false)) eitherMeta)))

        def listMeta:MfJ (MfJ.newObj())
        def only:MfJ (MfJ.newArr())
        only.add((Tools.oauthScheme()))
        listMeta.put("securitySchemes" only)
        def bwp:MfJ (MfJ.newObj())
        bwp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        bwp.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        bwp.put("agent" (Tools.prop("string" "Who you are, as other assistants and the user will read it, e.g. \"Claude (budget chat)\"")))
        def wnum:MfJ (MfJ.newObj())
        wnum.putStr("type" "integer")
        wnum.putInt("minimum" 1)
        def wslideOf:MfJ (MfJ.newArr())
        wslideOf.add(wnum)
        def wname:MfJ (MfJ.newObj())
        wname.putStr("type" "string")
        wslideOf.add(wname)
        def wslide:MfJ (MfJ.newObj())
        wslide.put("anyOf" wslideOf)
        def wslides:MfJ (Tools.prop("array" "The slides you will change, by number (1 = first) or title; leave out for the whole deck"))
        wslides.put("items" wslide)
        bwp.put("slides" wslides)
        bwp.put("note" (Tools.prop("string" "What you are about to do, in a few words")))
        def mins:MfJ (Tools.prop("integer" "How long the claim lasts unless renewed (default 15, at most 120); each update_presentation with work_id renews it"))
        mins.putInt("minimum" 1)
        mins.putInt("maximum" (WorkStore.MAX_MINUTES()))
        bwp.put("minutes" mins)
        bwp.put("work_id" (Tools.prop("string" "Your work_id from an earlier begin_work, to change or renew your claim")))
        bwp.put("force" (Tools.prop("boolean" "Take the slides even though another assistant holds some of them; only when the user wants both to work on them")))
        tools.add((Tools.tool("begin_work" "Start work on a presentation" "Before changing a Sliqtly presentation, say which slides you will work on, so another assistant editing the same deck at the same time knows. Returns your work_id, the deck's version (base_version for update_presentation) and the other assistants' claims. When another assistant holds some of those slides, nothing is claimed and you hear who holds them and why: take other slides, or ask the user whether to wait for it. Call end_work when you are done." (Tools.schema(bwp ([] _:string ("deck_id")))) (Tools.annotations(false 0 false false)) eitherMeta)))

        def ewp:MfJ (MfJ.newObj())
        ewp.put("deck_id" (Tools.prop("string" "The id in the share link /s/<id>")))
        ewp.put("edit_key" (Tools.prop("string" "edit_key from create_presentation; not needed when signed in as the presentation's owner")))
        ewp.put("work_id" (Tools.prop("string" "Your work_id from begin_work")))
        tools.add((Tools.tool("end_work" "Finish work on a presentation" "Release the slides claimed with begin_work, once your changes are saved (or given up), so other assistants may work on them." (Tools.schema(ewp ([] _:string ("deck_id" "work_id")))) (Tools.annotations(false 0 true false)) eitherMeta)))

        tools.add((Tools.tool("list_presentations" "List my presentations" "List the signed-in user's own Sliqtly presentations (newest first) with their links and deck_ids. Needs sign-in." (Tools.schema((MfJ.newObj()) none)) (Tools.annotations(true -1 false false)) listMeta)))
        return tools
    }

    ; --- the preview resource

    sfn csp:MfJ (base:string) {
        def frames:[string] (Tools.frames(base))
        ; the preview runs Sliqtly's viewer itself (preview.html): its scripts
        ; and fonts from the site and Firebase's CDN, the share from Firestore,
        ; the pictures from Storage
        def resources:[string] (Tools.frames(base))
        push resources "https://www.gstatic.com"
        def connects:[string] (Tools.frames(base))
        push connects "https://www.gstatic.com"
        push connects "https://firestore.googleapis.com"
        push connects "https://firebasestorage.googleapis.com"
        def c:MfJ (MfJ.newObj())
        c.put("frameDomains" (J.strs(frames)))
        c.put("resourceDomains" (J.strs(resources)))
        c.put("connectDomains" (J.strs(connects)))
        return c
    }

    sfn uiCsp:MfJ (base:string) {
        def ui:MfJ (MfJ.newObj())
        ui.put("csp" (Tools.csp(base)))
        ui.putBool("prefersBorder" false)
        return ui
    }

    sfn resources:MfJ (host:McpHost base:string) {
        def r:MfJ (MfJ.newObj())
        r.putStr("uri" (Tools.previewUri(host)))
        r.putStr("name" "preview")
        r.putStr("title" "Sliqtly presentation")
        r.putStr("description" "Shows the presentation inline")
        r.putStr("mimeType" (Tools.APP_MIME()))
        def meta:MfJ (MfJ.newObj())
        meta.put("ui" (Tools.uiCsp(base)))
        r.put("_meta" meta)
        def a:MfJ (MfJ.newArr())
        a.add(r)
        return a
    }

    ; the contents of a resource, or a null value for an unknown uri
    sfn read:MfJ (host:McpHost uri:string) {
        ; a client that took the tool list before the preview changed still
        ; asks for the older name: it gets the current preview
        if (((startsWith uri "ui://sliqtly/preview-") == false) || ((endsWith uri ".html") == false)) {
            return (new MfJ)
        }
        def base:string (host_base_url host)
        def c:MfJ (MfJ.newObj())
        c.putStr("uri" uri)
        c.putStr("mimeType" (Tools.APP_MIME()))
        c.putStr("text" (host_asset host "preview.html"))
        def meta:MfJ (MfJ.newObj())
        meta.put("ui" (Tools.uiCsp(base)))
        def csp:MfJ (Tools.csp(base))
        def w:MfJ (MfJ.newObj())
        w.put("connect_domains" (csp.field("connectDomains")))
        w.put("resource_domains" (csp.field("resourceDomains")))
        w.put("frame_domains" (csp.field("frameDomains")))
        meta.put("openai/widgetCSP" w)
        meta.putStr("openai/widgetDescription" "The Sliqtly presentation, playable inline.")
        meta.putBool("openai/widgetPrefersBorder" true)
        c.put("_meta" meta)
        def contents:MfJ (MfJ.newArr())
        contents.add(c)
        def out:MfJ (MfJ.newObj())
        out.put("contents" contents)
        return out
    }

    ; --- results

    sfn text:MfJ (s:string) {
        def c:MfJ (MfJ.newObj())
        c.putStr("type" "text")
        c.putStr("text" s)
        def a:MfJ (MfJ.newArr())
        a.add(c)
        return a
    }

    sfn fail:MfJ (message:string) {
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text(message)))
        r.putBool("isError" true)
        return r
    }

    ; Pictures and files are stored only for a signed-in user: anyone could
    ; otherwise keep any bytes at a public address.
    sfn needsSignIn:MfJ (caller:Caller what:string) {
        def r:MfJ (Tools.fail(("Storing " + what + " needs sign-in. Connect Sliqtly with sign-in (Google), or leave them out: without sign-in a presentation is text only.")))
        if ((strlen caller.signIn) > 0) {
            def meta:MfJ (MfJ.newObj())
            meta.put("mcp/www_authenticate" (J.strs(([] _:string (("Bearer resource_metadata=\"" + caller.signIn + "\", error=\"insufficient_scope\", error_description=\"Sign in to Sliqtly to store pictures and files\""))))))
            r.put("_meta" meta)
        }
        return r
    }

    ; "pictures", "data files" or "" for what a call would store
    sfn uploads:string (a:MfJ) {
        if ((array_length (a.list("images"))) > 0) {
            return "pictures"
        }
        if ((array_length (a.list("files"))) > 0) {
            return "data files"
        }
        return ""
    }

    sfn links:void (out:MfJ base:string id:string) {
        out.putStr("share_url" (base + "/s/" + id))
        out.putStr("edit_url" (base + "/s/" + id + "?edit"))
    }

    sfn result:MfJ (host:McpHost caller:Caller out:MfJ verb:string) {
        def lines:[string]
        push lines (verb + ": \"" + (out.str_("title")) + "\" (" + (out.str_("slides")) + " slides, theme " + (out.str_("theme")) + ").")
        push lines ("Presentation: " + (out.str_("share_url")))
        push lines ("Open in the editor: " + (out.str_("edit_url")))
        if caller.signedIn {
            def who:string caller.name
            if ((strlen who) == 0) {
                who = "the signed-in user"
            }
            push lines ("Saved in the Sliqtly account of " + who + ".")
        } {
            if (out.has("deck_id")) {
                push lines "Not signed in: the presentation is deleted 30 days after its last change. Sign in to keep it, or to add pictures and files."
            }
        }
        if (out.has("deck_id")) {
            push lines ("deck_id: " + (out.str_("deck_id")))
        }
        if (out.has("edit_key")) {
            push lines ("edit_key: " + (out.str_("edit_key")) + " (needed for update_presentation; do not show it to others)")
        }
        for (J.strList((out.field("warnings")))) w:string i {
            push lines ("Note: " + w)
        }
        def lay:string (Tools.layoutText((out.field("layout")) true))
        if ((strlen lay) > 0) {
            push lines lay
        }
        def svgs:string (Tools.svgText((out.field("pictures"))))
        if ((strlen svgs) > 0) {
            push lines svgs
        }
        push lines "Give the user the presentation link."
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((join lines "\n"))))
        r.put("structuredContent" out)
        def meta:MfJ (Tools.uiMeta(host))
        ; the preview reads a stored deck from Firestore with the site's config
        if (out.has("deck_id")) {
            def cfg:MfJ (J.parse((host_web_config host)))
            if (cfg.isObj()) {
                meta.put("sliqtly/firebase" cfg)
            }
        }
        r.put("_meta" meta)
        return r
    }

    ; --- the layout report

    ; each SVG picture the deck names, read by SvgCheck: what it is, whether
    ; a slide has it as its background (on a slide w × h), and what will go
    ; wrong in the player; [{"name","line","flags"}]
    sfn svgPictures:MfJ (host:McpHost md:string bgs:CheckPics w:double h:double) {
        def a:MfJ (MfJ.newArr())
        for bgs.pics p:CheckPic i {
            def type:string (itemAt bgs.types i)
            if (((endsWith (to_lowercase p.name) ".svg") == false) && (type != "image/svg+xml")) {
                continue
            }
            def data:buffer (itemAt bgs.data i)
            def name:string (substring p.name 1 (strlen p.name))
            def bg:boolean (((indexOf md ("bg=" + name)) >= 0) || ((indexOf md ("bg=\"" + name)) >= 0))
            def o:SvgOut (SvgCheck.report((SvgCheck.read((buffer_to_string data))) name bg w h (host_svg_error host data)))
            def e:MfJ (MfJ.newObj())
            e.putStr("name" name)
            e.putStr("line" o.line)
            e.put("flags" (J.strs(o.flags)))
            a.add(e)
        }
        return a
    }

    ; the SVG pictures as the text a model reads
    sfn svgText:string (pics:MfJ) {
        if ((pics.count()) == 0) {
            return ""
        }
        def lines:[string]
        push lines "SVG pictures (render_slide and render_overview draw them; the player draws each once to a PNG):"
        for pics.arr e:MfJ i {
            push lines ("- " + (e.str_("line")))
            for (J.strList((e.field("flags")))) f:string j {
                push lines ("  ⚠ " + f)
            }
        }
        return (join lines "\n")
    }

    sfn layoutJson:MfJ (outs:[RSlideOut]) {
        def a:MfJ (MfJ.newArr())
        for outs o:RSlideOut i {
            def e:MfJ (MfJ.newObj())
            e.putInt("slide" (o.index + 1))
            e.putStr("title" o.title)
            e.putInt("fill_percent" (floor ((o.fill * 100.0) + 0.5)))
            e.putInt("min_text_px" (floor (o.minPx + 0.5)))
            e.put("lines" (J.strs(o.lines)))
            e.put("flags" (J.strs(o.flags)))
            a.add(e)
        }
        return a
    }

    ; the report as the text a model reads: every slide's lines, what looks
    ; wrong marked ⚠, and when to look at a picture of it
    sfn layoutText:string (lay:MfJ hint:boolean) {
        if ((lay.count()) == 0) {
            return ""
        }
        def lines:[string]
        def flagged:[string]
        for lay.arr e:MfJ i {
            for (J.strList((e.field("lines")))) l:string j {
                push lines l
            }
            def fs:[string] (J.strList((e.field("flags"))))
            for fs f:string k {
                push lines ("  ⚠ " + f)
            }
            if ((array_length fs) > 0) {
                push flagged (to_string (e.int_("slide" 0)))
            }
        }
        def head:string "Layout (px of a 1920×1080 screen; x,y from the slide's top-left corner):"
        def tail:string "Nothing in the layout looks wrong. Before saying the presentation is done, look at it once with render_overview."
        if ((array_length flagged) > 0) {
            tail = ("Look at slides " + (join flagged ", ") + " with render_slide (or all with render_overview) before saying the presentation is done.")
        }
        if (hint == false) {
            return (head + "\n" + (join lines "\n"))
        }
        return (head + "\n" + (join lines "\n") + "\n" + tail)
    }

    ; --- the checks zod makes on the Node server; "" when the arguments hold

    sfn checkArgs:string (a:MfJ required:[string]) {
        if ((a.kind != 5) && (a.kind != 0)) {
            return "Invalid arguments: expected an object."
        }
        for required r:string i {
            if ((a.field(r)).kind != 3) {
                return ("Invalid arguments: " + r + " is required.")
            }
        }
        for ([] _:string ("title" "markdown" "theme" "css" "css_mode" "deck_id" "edit_key" "path" "sheet")) k:string j {
            def v:MfJ (a.field(k))
            if ((v.kind != 0) && (v.kind != 3)) {
                return ("Invalid arguments: " + k + " is a string.")
            }
        }
        def title:MfJ (a.field("title"))
        if ((title.kind == 3) && ((Tools.chars(title.str)) > 200)) {
            return "Invalid arguments: title is longer than 200 characters."
        }
        def theme:MfJ (a.field("theme"))
        if ((theme.kind == 3) && ((Deck.inList((Deck.THEMES()) theme.str)) == false)) {
            return ("Invalid arguments: theme is one of " + (join (Deck.THEMES()) ", ") + ".")
        }
        def mode:MfJ (a.field("css_mode"))
        if ((mode.kind == 3) && ((mode.str != "extend") && (mode.str != "replace"))) {
            return "Invalid arguments: css_mode is extend or replace."
        }
        def chart:MfJ (a.field("chart"))
        if (chart.kind == 2) {
            if ((chart.num < 1.0) || (chart.num != (to_double (to_int chart.num)))) {
                return "Invalid arguments: chart is a whole number from 1."
            }
        }
        if ((chart.kind != 0) && ((chart.kind != 2) && (chart.kind != 3))) {
            return "Invalid arguments: chart is a number or a slide title."
        }
        def source:MfJ (a.field("source"))
        if (source.isObj()) {
            if ((source.field("google_sheets")).kind != 3) {
                return "Invalid arguments: source.google_sheets is required."
            }
            for ([] _:string ("sheet" "range")) sk:string sj {
                def sv:MfJ (source.field(sk))
                if ((sv.kind != 0) && (sv.kind != 3)) {
                    return ("Invalid arguments: source." + sk + " is a string.")
                }
            }
        } {
            if ((source.kind != 0) && (source.kind != 3)) {
                return "Invalid arguments: source is a URL or { google_sheets }."
            }
        }
        for ([] _:string ("offset" "limit")) nk:string nj {
            def nv:MfJ (a.field(nk))
            if (nv.kind != 0) {
                if ((nv.kind != 2) || (nv.num != (to_double (to_int nv.num)))) {
                    return ("Invalid arguments: " + nk + " is a whole number.")
                }
            }
        }
        def offv:MfJ (a.field("offset"))
        if ((offv.kind == 2) && (offv.num < 0.0)) {
            return "Invalid arguments: offset is 0 or more."
        }
        def limv:MfJ (a.field("limit"))
        if ((limv.kind == 2) && ((limv.num < 1.0) || (limv.num > 2000.0))) {
            return "Invalid arguments: limit is from 1 to 2000."
        }
        def dfiles:MfJ (a.field("files"))
        if ((dfiles.kind != 0) && (dfiles.kind != 4)) {
            return "Invalid arguments: files is a list."
        }
        for dfiles.arr df:MfJ k3 {
            if ((df.isObj()) == false) {
                return "Invalid arguments: every file is an object."
            }
            if ((df.field("name")).kind != 3) {
                return "Invalid arguments: every file needs a name."
            }
            for ([] _:string ("text" "url" "data_base64")) ff:string fm {
                def ffv:MfJ (df.field(ff))
                if ((ffv.kind != 0) && (ffv.kind != 3)) {
                    return ("Invalid arguments: file " + ff + " is a string.")
                }
            }
        }
        def images:MfJ (a.field("images"))
        if ((images.kind != 0) && (images.kind != 4)) {
            return "Invalid arguments: images is a list."
        }
        for images.arr img:MfJ k2 {
            if ((img.isObj()) == false) {
                return "Invalid arguments: every image is an object."
            }
            if ((img.field("name")).kind != 3) {
                return "Invalid arguments: every image needs a name."
            }
            for ([] _:string ("url" "data_base64" "mime_type")) f:string m {
                def fv:MfJ (img.field(f))
                if ((fv.kind != 0) && (fv.kind != 3)) {
                    return ("Invalid arguments: image " + f + " is a string.")
                }
            }
        }
        return ""
    }

    ; characters, not bytes: UTF-8 lead bytes
    sfn chars:int (s:string) {
        def n:int (strlen s)
        def count:int 0
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            if ((c < 128) || (c >= 192)) {
                count = (count + 1)
            }
            i = (i + 1)
        }
        return count
    }

    sfn has:boolean (a:MfJ key:string) {
        return ((a.field(key)).kind == 3)
    }

    ; --- the stylesheet stored with the deck: hasCss false keeps the theme

    sfn sheet:Sheet (host:McpHost theme:string a:MfJ mode:string) {
        def s (new Sheet)
        def css:string (a.str_("css"))
        if (((Tools.has(a "css")) == false) || ((strlen (trim css)) == 0)) {
            if (mode == "replace") {
                s.hasCss = true
            }
            return s
        }
        if ((strlen css) > (Deck.MAX_CSS())) {
            s.err = "css is larger than 100 KB."
            return s
        }
        s.hasCss = true
        if (mode == "replace") {
            s.css = css
            return s
        }
        def base:string (host_theme_css host theme)
        if ((strlen (host_error host)) > 0) {
            s.fatal = (host_error host)
            return s
        }
        s.css = (base + "\n/* --- added for this deck --- */\n" + css + "\n")
        return s
    }

    ; the deck as the player reads it, with the sheet it is shown with: its
    ; own, or the theme's (fetched once); with neither, the outline's count
    ; the pictures the deck names (media/<name>), for the layout and the
    ; contrast check of its backgrounds: from
    ; this call's pictures, else from the deck's stored ones (deckId)
    sfn backgrounds:CheckPics (host:McpHost md:string imgs:[Img] deckId:string) {
        def out (new CheckPics)
        def names:[string]
        def from:int 0
        while true {
            def rest:string (substring md from (strlen md))
            def at:int (indexOf rest "media/")
            if (at < 0) {
                break
            }
            def start:int ((from + at) + 6)
            def e:int start
            while ((e < (strlen md)) && (Tools.nameChar((charAt md e)))) {
                e = (e + 1)
            }
            def name:string (substring md start e)
            if (((strlen name) > 0) && ((indexOf names name) < 0)) {
                push names name
            }
            from = e
        }
        for names name:string ni {
            if (ni >= 30) {
                break
            }
            def handle:int 0
            def type:string ""
            for imgs im:Img ii {
                if ((im.name == name) && ((strlen im.path) == 0)) {
                    handle = im.handle
                    type = im.type
                }
            }
            if ((handle == 0) && ((strlen deckId) > 0)) {
                def got:MfJ (J.parse((host_file_bytes host deckId ("media/" + name))))
                if ((strlen (host_error host)) > 0) {
                    host_clear_error host
                } {
                    handle = (got.int_("handle" 0))
                }
            }
            if (handle == 0) {
                continue
            }
            def pic (new CheckPic)
            pic.name = ("/media/" + name)
            ; width, height and the sampled grid; an SVG: its size alone
            def grid:[int] (host_image_grid host handle)
            if ((array_length grid) >= 2) {
                pic.w = (itemAt grid 0)
                pic.h = (itemAt grid 1)
                def k:int 2
                while (k < (array_length grid)) {
                    push pic.grid (itemAt grid k)
                    k = (k + 1)
                }
            }
            ; a file read back from the deck comes without its type: a raster
            ; is told by its bytes; a SmartArt file (.xml) has to be named one,
            ; or it is taken for a broken picture and drawn as nothing
            if ((strlen type) == 0) {
                type = "image/png"
                if (endsWith (to_lowercase name) ".xml") {
                    type = "application/xml"
                }
            }
            push out.pics pic
            push out.data (host_image_bytes host handle)
            push out.types type
        }
        return out
    }

    sfn nameChar:boolean (ch:int) {
        if ((((ch >= 48) && (ch <= 57)) || ((ch >= 65) && (ch <= 90))) || ((ch >= 97) && (ch <= 122))) {
            return true
        }
        return (((ch == 46) || (ch == 45)) || (ch == 95))
    }

    sfn checkDeck:Checked (host:McpHost md:string theme:string hasCss:boolean css:string bgs:CheckPics files:[Img] deckId:string stored:[string]) {
        def din (new DeckIn)
        din.files = files
        din.deckId = deckId
        din.stored = stored
        return (Tools.checkWith(host md theme hasCss css bgs din))
    }

    sfn checkWith:Checked (host:McpHost md:string theme:string hasCss:boolean css:string bgs:CheckPics din:DeckIn) {
        def sheet:string css
        if (hasCss == false) {
            sheet = (host_theme_css host theme)
            if ((strlen (host_error host)) > 0) {
                host_log host ("theme for the checks: " + (host_error host))
                host_clear_error host
                sheet = ""
            }
        }
        din.md = md
        din.css = sheet
        din.pics = bgs.pics
        din.data = bgs.data
        din.types = bgs.types
        def c:Checked (Check.run(host din))
        for (Charts.typeWarnings(md)) tw:string ti {
            push c.warnings tw
        }
        if (c.laidOut == false) {
            c.slides = (array_length ((Deck.outline(md)).titles))
        }
        return c
    }

    ; --- the calls; a null value for an unknown tool

    sfn call:MfJ (host:McpHost caller:Caller name:string args:MfJ) {
        if (name == "sliqtly_guide") {
            def g:MfJ (MfJ.newObj())
            def guide:string (host_asset host "guide.md")
            def rule:string (host_name_rule host)
            if ((strlen rule) > 0) {
                guide = (guide + "\n\n## Naming presentations on this server\n\n" + rule + " create_presentation and update_presentation refuse a title that does not follow it. list_presentations gives each presentation's key apart from its name.\n")
            }
            g.put("content" (Tools.text(guide)))
            return g
        }
        def writes:boolean ((((name == "create_presentation") || (name == "update_presentation")) || (name == "bind_chart_data")) || (name == "write_workbook"))
        if (writes || ((((name == "add_comment") || (name == "resolve_comment")) || (name == "begin_work")) || (name == "end_work"))) {
            def why:string (host_rate_limit host caller.who)
            if ((strlen why) > 0) {
                return (Tools.fail(why))
            }
        }
        def r:MfJ (new MfJ)
        if (name == "create_presentation") {
            r = (Tools.create(host caller args))
        }
        if (name == "update_presentation") {
            r = (Tools.update(host caller args))
        }
        if (name == "bind_chart_data") {
            r = (Tools.bindChart(host caller args))
        }
        if (name == "get_presentation") {
            r = (Tools.get(host caller args))
        }
        if (name == "list_files") {
            r = (Tools.listFiles(host caller args))
        }
        if (name == "render_slide") {
            r = (Tools.render(host args false))
        }
        if (name == "render_overview") {
            r = (Tools.render(host args true))
        }
        if (name == "read_file") {
            r = (Tools.readFile(host caller args))
        }
        if (name == "export_presentation") {
            r = (Tools.exportDeck(host args))
        }
        if (name == "write_workbook") {
            r = (Tools.writeWorkbook(host caller args))
        }
        if (name == "list_presentations") {
            r = (Tools.listMine(host caller))
        }
        if (name == "list_comments") {
            r = (Tools.listComments(host caller args))
        }
        if (name == "add_comment") {
            r = (Tools.addComment(host caller args))
        }
        if (name == "resolve_comment") {
            r = (Tools.resolveComment(host caller args))
        }
        if (name == "begin_work") {
            r = (Tools.beginWork(host caller args))
        }
        if (name == "end_work") {
            r = (Tools.endWork(host caller args))
        }
        if (r.kind == 0) {
            return r
        }
        ; a storage or network failure that the tool did not turn into an answer
        def err:string (host_error host)
        if (((strlen err) > 0) && ((r.bool_("isError" false)) == false)) {
            host_log host (name + " failed: " + err)
            return (Tools.fail(("Sliqtly could not " + (Tools.verb(name)) + ": " + err)))
        }
        return r
    }

    sfn verb:string (name:string) {
        def u:int (indexOf name "_")
        if (u < 0) {
            return name
        }
        return ((substring name 0 u) + " " + (substring name (u + 1) (strlen name)))
    }

    ; text, and the server's naming rule after it when it has one
    sfn withNameRule:string (host:McpHost text:string) {
        def rule:string (host_name_rule host)
        if ((strlen rule) == 0) {
            return text
        }
        return (text + " Naming rule on this server: " + rule)
    }

    sfn failed:MfJ (host:McpHost name:string err:string) {
        host_log host (name + " failed: " + err)
        return (Tools.fail(("Sliqtly could not " + (Tools.verb(name)) + ": " + err)))
    }

    sfn create:MfJ (host:McpHost caller:Caller a:MfJ) {
        def bad:string (Tools.checkArgs(a ([] _:string ("title" "markdown"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        def badName:string (host_check_name host (a.str_("title")))
        if ((strlen badName) > 0) {
            return (Tools.fail(("Not created: " + badName + " Call create_presentation again with such a title.")))
        }
        def up:string (Tools.uploads(a))
        if (((caller.signedIn == false) && ((host_store_kind host) != "link")) && ((strlen up) > 0)) {
            return (Tools.needsSignIn(caller up))
        }
        def md:string (a.str_("markdown"))
        def theme:string "aurora"
        if (Tools.has(a "theme")) {
            theme = (a.str_("theme"))
        }
        def mode:string "extend"
        if (Tools.has(a "css_mode")) {
            mode = (a.str_("css_mode"))
        }
        if ((strlen md) > (Deck.MAX_MD())) {
            return (Tools.fail("markdown is larger than 300 KB."))
        }
        if ((strlen (trim md)) == 0) {
            return (Tools.fail("markdown is empty."))
        }
        def sh:Sheet (Tools.sheet(host theme a mode))
        if ((strlen sh.err) > 0) {
            return (Tools.fail(sh.err))
        }
        if ((strlen sh.fatal) > 0) {
            return (Tools.failed(host "create_presentation" sh.fatal))
        }
        def loaded:Loaded (Deck.loadImages(host (a.list("images"))))
        if ((strlen loaded.err) > 0) {
            return (Tools.fail(loaded.err))
        }
        def data:Loaded (Files.loadData(host (a.list("files"))))
        if ((strlen data.err) > 0) {
            return (Tools.fail(data.err))
        }
        def names:[string]
        for loaded.imgs im:Img i {
            push names im.name
        }
        def none:[string]
        def ws:[string] (Deck.warnings(md names none))
        def none2:[string]
        def bgs:CheckPics (Tools.backgrounds(host md loaded.imgs ""))
        def ck:Checked (Tools.checkDeck(host md theme sh.hasCss sh.css bgs data.imgs "" none2))
        for ck.warnings cw:string ci {
            push ws cw
        }
        def out:MfJ (MfJ.newObj())
        out.put("layout" (Tools.layoutJson(ck.report)))
        out.put("pictures" (Tools.svgPictures(host md bgs ck.width ck.height)))
        out.putStr("title" (a.str_("title")))
        out.putStr("theme" theme)
        out.putInt("slides" ck.slides)
        def base:string (host_base_url host)
        if ((host_store_kind host) == "link") {
            if ((array_length loaded.imgs) > 0) {
                push ws "Pictures are not stored on this server (no cloud storage configured); the slides show without them."
            }
            if ((array_length data.imgs) > 0) {
                push ws "Data files are not stored on this server (no cloud storage configured)."
            }
            out.put("warnings" (J.strs(ws)))
            def q:string ("md=" + (host_pack_text host md))
            q = (q + "&theme=" + (host_uri_encode host theme))
            if sh.hasCss {
                q = (q + "&css=" + (host_pack_text host sh.css))
            }
            out.putStr("share_url" (base + "/#" + q + "&mode=show"))
            out.putStr("edit_url" (base + "/#" + q))
            return (Tools.result(host caller out "Created"))
        }
        out.put("warnings" (J.strs(ws)))
        def owner:string "mcp"
        if caller.signedIn {
            owner = caller.uid
        }
        def kept:[Img]
        for loaded.imgs li:Img lk {
            push kept li
        }
        for data.imgs di:Img dk {
            push kept di
        }
        def made:Created (Store.create(host (a.str_("title")) md theme sh.hasCss sh.css kept owner))
        if ((strlen made.err) > 0) {
            return (Tools.failed(host "create_presentation" made.err))
        }
        Tools.links(out base made.id)
        out.putStr("deck_id" made.id)
        out.putStr("edit_key" made.key)
        WorkStore.keep(host made.id md)
        if ((strlen (host_error host)) > 0) {
            host_log host ("create_presentation work board: " + (host_error host))
            host_clear_error host
        }
        def made2:MfJ (Tools.result(host caller out "Created"))
        def none:[WorkClaim]
        Tools.withWork(host made2 (WorkStore.version(host md)) none)
        return (Tools.withData(host made2 data.imgs))
    }

    sfn update:MfJ (host:McpHost caller:Caller a:MfJ) {
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured): call create_presentation again with the whole deck."))
        }
        def bad:string (Tools.checkArgs(a ([] _:string ("deck_id"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        if (Tools.has(a "title")) {
            def badName:string (host_check_name host (a.str_("title")))
            if ((strlen badName) > 0) {
                return (Tools.fail(("Not updated: " + badName + " Call update_presentation again with such a title, or without one to keep the name.")))
            }
        }
        def up:string (Tools.uploads(a))
        if ((caller.signedIn == false) && ((strlen up) > 0)) {
            return (Tools.needsSignIn(caller up))
        }
        if ((Tools.has(a "markdown")) && ((strlen (a.str_("markdown"))) > (Deck.MAX_MD()))) {
            return (Tools.fail("markdown is larger than 300 KB."))
        }
        def id:string (a.str_("deck_id"))
        def ed:Editable (Tools.editable(host caller id (a.str_("edit_key"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "update_presentation" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def cur:MfJ ed.cur
        def mine:boolean ed.mine
        def key:string ed.key
        def th:string "aurora"
        if (Tools.has(a "theme")) {
            th = (a.str_("theme"))
        } {
            if ((cur.field("theme")).kind == 3) {
                th = (cur.str_("theme"))
            }
        }
        def p (new DeckPatch)
        ; a new theme with no new css drops the old theme's sheet
        if (Tools.has(a "css")) {
            def mode:string "extend"
            if (Tools.has(a "css_mode")) {
                mode = (a.str_("css_mode"))
            }
            def sh:Sheet (Tools.sheet(host th a mode))
            if ((strlen sh.err) > 0) {
                return (Tools.fail(sh.err))
            }
            if ((strlen sh.fatal) > 0) {
                return (Tools.failed(host "update_presentation" sh.fatal))
            }
            if sh.hasCss {
                p.cssMode = 1
                p.css = sh.css
            } {
                p.cssMode = 2
            }
        } {
            if ((Tools.has(a "theme")) && ((a.str_("theme")) != (cur.str_("theme")))) {
                p.cssMode = 2
            }
        }
        if (Tools.has(a "title")) {
            p.hasName = true
            p.name = (a.str_("title"))
        }
        if (Tools.has(a "markdown")) {
            p.hasMd = true
            p.md = (a.str_("markdown"))
        }
        def editNote:string ""
        if ((a.field("edits")).kind != 0) {
            def eo:DeckEditsOut (Tools.applyEdits(host id cur a))
            if ((strlen eo.err) > 0) {
                return (Tools.fail(("Not updated: " + eo.err)))
            }
            if ((strlen eo.md) > (Deck.MAX_MD())) {
                return (Tools.fail("Not updated: with these edits the markdown is larger than 300 KB."))
            }
            p.hasMd = true
            p.md = eo.md
            editNote = (join eo.done "\n")
        }
        if (Tools.has(a "theme")) {
            p.hasTheme = true
            p.theme = (a.str_("theme"))
        }
        def loaded:Loaded (Deck.loadImages(host (a.list("images"))))
        if ((strlen loaded.err) > 0) {
            return (Tools.fail(loaded.err))
        }
        def data:Loaded (Files.loadData(host (a.list("files"))))
        if ((strlen data.err) > 0) {
            return (Tools.fail(data.err))
        }
        def kept:[Img]
        for loaded.imgs li:Img lk {
            push kept li
        }
        for data.imgs di:Img dk {
            push kept di
        }
        ; edits are made on the deck as it is now: they need no base version
        def ws:WorkSave (Tools.saveWork(host a id mine key cur p kept ((a.field("edits")).kind != 0)))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "update_presentation" (host_error host)))
        }
        if ((strlen ws.fail) > 0) {
            return (Tools.fail(ws.fail))
        }
        def notes:[string]
        for ([] _:string (editNote ws.note)) nt:string ni {
            if ((strlen nt) > 0) {
                push notes nt
            }
        }
        def r:MfJ (Tools.updated(host caller id ws.saved (join notes "\n")))
        Tools.withWork(host r ws.version ws.others)
        return (Tools.withData(host r data.imgs))
    }

    ; --- two assistants on one deck (Work.rgr, WorkStore.rgr)

    ; the sheet a stored deck is shown with: its own, or its theme's
    sfn sheetOf:string (host:McpHost d:MfJ) {
        if ((d.field("css")).kind == 3) {
            return (d.str_("css"))
        }
        def sheet:string (host_theme_css host (d.str_("theme")))
        if ((strlen (host_error host)) > 0) {
            host_log host ("theme for slide spans: " + (host_error host))
            host_clear_error host
            return ""
        }
        return sheet
    }

    ; the line each slide of md starts on
    sfn startsOf:[int] (host:McpHost md:string sheet:string) {
        return (WorkSpans.lineStarts(md (Check.slideStarts(host md sheet))))
    }

    ; "slide 3" / "slides 2, 3 and 5"
    sfn slidesText:string (nums:[int]) {
        if ((array_length nums) == 1) {
            return ("slide " + (WorkSpans.listText(nums)))
        }
        return ("slides " + (WorkSpans.listText(nums)))
    }

    ; the save of update_presentation: merged with what was saved since the
    ; edit's base version, never over a change it did not see. onCur: the
    ; Markdown was made from cur (edits), so cur is its base
    sfn saveWork:WorkSave (host:McpHost a:MfJ id:string mine:boolean key:string cur:MfJ p:DeckPatch kept:[Img] onCur:boolean) {
        def out (new WorkSave)
        def workId:string (trim (a.str_("work_id")))
        def baseV:string (trim (a.str_("base_version")))
        if onCur {
            baseV = ""
        }
        def board:WorkBoard (WorkStore.read(host id))
        if ((strlen (host_error host)) > 0) {
            return out
        }
        def others:[WorkClaim] (board.others(workId))
        def lead:[string]
        if (((strlen workId) > 0) && ((board.indexOf(workId)) < 0)) {
            push lead ("Your claim " + workId + " had ended or run out; call begin_work again if you go on working on this deck.")
        }
        def notes:[string]
        if (p.hasMd == false) {
            out.saved = (Store.update(host id (mine == false) key p kept))
        } {
            def edit:string p.md
            def done:boolean false
            def tries:int 0
            while ((done == false) && (tries < 3)) {
                tries = (tries + 1)
                notes = (WorkStore.noLines())
                p.md = edit
                def curMd:string (cur.str_("md"))
                def curV:string (WorkStore.version(host curMd))
                if ((((strlen baseV) == 0) && (onCur == false)) && ((array_length others) > 0)) {
                    def who:[string]
                    for others oc:WorkClaim oi {
                        push who (WorkStore.line(host oc))
                    }
                    out.fail = ("Not saved: another assistant is working on this presentation (" + (join who "; ") + "). Send base_version (from get_presentation, begin_work or your last update) so its changes are merged with yours instead of overwritten.")
                    return out
                }
                def touched:[int]
                if (((strlen baseV) > 0) && (baseV != curV)) {
                    def bt:WorkBase (WorkStore.baseText(host id baseV))
                    if ((strlen (host_error host)) > 0) {
                        return out
                    }
                    if (bt.found == false) {
                        out.fail = ("Not saved: the presentation has changed since version " + baseV + ", and that version is not kept here to merge with (not one this server handed out, or too old). Call get_presentation and make your change on the current text (version " + curV + ").")
                        return out
                    }
                    def starts:[int] (Tools.startsOf(host bt.md (Tools.sheetOf(host cur))))
                    def wm:WorkMerge (WorkMerge.run(bt.md curMd edit starts))
                    if ((wm.clean()) == false) {
                        def by:[string]
                        for (board.touching(workId wm.clash)) bc:WorkClaim bi {
                            push by (WorkStore.line(host bc))
                        }
                        def msg:string ("Not saved: since version " + baseV + " someone else changed the same lines on " + (Tools.slidesText(wm.clash)) + " (numbered as in that version)")
                        if ((array_length by) > 0) {
                            msg = (msg + "; " + (join by "; "))
                        }
                        out.fail = (msg + ". Nothing was written. Call get_presentation for the current text (version " + curV + "), make your change on it and update with that base_version, or ask the user which change to keep.")
                        return out
                    }
                    p.md = wm.text
                    touched = wm.mine
                    push notes ("Merged with the changes saved since version " + baseV + " (" + (Tools.slidesText(wm.theirs)) + ", numbered as in that version); read the deck again with get_presentation before changing those slides.")
                } {
                    if ((array_length others) > 0) {
                        def starts2:[int] (Tools.startsOf(host curMd (Tools.sheetOf(host cur))))
                        touched = (WorkMerge.edited(curMd edit starts2))
                    }
                }
                for (board.touching(workId touched)) tc:WorkClaim ti {
                    push notes ("You changed " + (Tools.slidesText(touched)) + " while " + (WorkStore.line(host tc)) + ". Tell the user, or leave those slides to it.")
                }
                def sv:Saved (Store.save(host id (mine == false) key p kept true curMd))
                if ((strlen (host_error host)) > 0) {
                    return out
                }
                if sv.changed {
                    ; saved by someone else between the read and the write:
                    ; merge with that too
                    cur = (Store.get(host id))
                    if ((strlen (host_error host)) > 0) {
                        return out
                    }
                    if ((strlen baseV) == 0) {
                        ; the edit was made on what was read: merge from it
                        WorkStore.keep(host id curMd)
                        if ((strlen (host_error host)) > 0) {
                            return out
                        }
                        baseV = curV
                    }
                } {
                    out.saved = sv.doc
                    done = true
                }
            }
            if (done == false) {
                out.fail = "Not saved: the presentation kept changing while this was saved. Call update_presentation again."
                return out
            }
        }
        if ((out.saved.isObj()) == false) {
            return out
        }
        def saved:MfJ out.saved
        def step (new WorkStep)
        step.base = (WorkStore.version(host (saved.str_("md"))))
        step.baseMd = (saved.str_("md"))
        if ((strlen workId) > 0) {
            step.renew = workId
            step.until = ((host_now_ms host) + (((WorkStore.MINUTES()) * 60) * 1000))
        }
        WorkStore.run(host id step)
        if ((strlen (host_error host)) > 0) {
            ; the deck is saved: a claim not renewed or a version not kept
            ; must not turn that into a failure
            host_log host ("update_presentation work board: " + (host_error host))
            host_clear_error host
        }
        out.version = step.base
        out.others = (step.board.others(workId))
        for notes n:string ni {
            push lead n
        }
        out.note = (join lead "\n")
        return out
    }

    ; the deck's version and the others' claims, on a create/update/get result
    sfn withWork:void (host:McpHost r:MfJ version:string others:[WorkClaim]) {
        def sc:MfJ (r.field("structuredContent"))
        if ((sc.isObj()) == false) {
            return
        }
        sc.putStr("version" version)
        sc.put("work" (WorkStore.claimsJson(host others)))
        def c0:MfJ (itemAt (r.list("content")) 0)
        def add:[string]
        push add ("Version: " + version + " (base_version for your next update_presentation).")
        for others c:WorkClaim i {
            push add ("Also working on this deck: " + (WorkStore.line(host c)) + ".")
        }
        c0.putStr("text" ((c0.str_("text")) + "\n" + (join add "\n")))
    }

    ; the slides a begin_work names, 1-based, with their titles; fail says
    ; which one is not there
    sfn claimSlides:WorkClaim (a:MfJ titles:[string]) {
        def c (new WorkClaim)
        for (a.list("slides")) v:MfJ i {
            def one:MfJ (MfJ.newObj())
            one.put("slide" v)
            def at:int (Tools.slideIndex(one titles))
            if (at < 0) {
                def said:string (JOut.text(v))
                c.note = ("No slide " + said + " in this presentation; it has " + (to_string (array_length titles)) + " slides: " + (Tools.titleList(titles)) + ".")
                return c
            }
            if ((c.hasSlide((at + 1))) == false) {
                push c.slides (at + 1)
                push c.titles (itemAt titles at)
            }
        }
        return c
    }

    ; "1 “Intro”, 2 “Budget”, …"
    sfn titleList:string (titles:[string]) {
        def parts:[string]
        for titles t:string i {
            push parts ((to_string (i + 1)) + " \"" + t + "\"")
        }
        return (join parts ", ")
    }

    sfn workEditable:Editable (host:McpHost caller:Caller a:MfJ required:[string]) {
        def ed (new Editable)
        if ((host_store_kind host) == "link") {
            ed.fail = "This server keeps no decks (no cloud storage configured)."
            return ed
        }
        def bad:string (Tools.checkArgs(a required))
        if ((strlen bad) == 0) {
            for ([] _:string ("work_id" "agent" "note")) k:string j {
                def v:MfJ (a.field(k))
                if (((v.kind != 0) && (v.kind != 3)) && ((strlen bad) == 0)) {
                    bad = ("Invalid arguments: " + k + " is a string.")
                }
            }
            def sl:MfJ (a.field("slides"))
            if (((sl.kind != 0) && (sl.kind != 4)) && ((strlen bad) == 0)) {
                bad = "Invalid arguments: slides is a list of slide numbers or titles."
            }
        }
        if ((strlen bad) > 0) {
            ed.fail = bad
            return ed
        }
        if (((Tools.chars((a.str_("note")))) > 300) || ((Tools.chars((a.str_("agent")))) > 80)) {
            ed.fail = "note is at most 300 characters and agent at most 80."
            return ed
        }
        return (Tools.editable(host caller (a.str_("deck_id")) (a.str_("edit_key"))))
    }

    sfn beginWork:MfJ (host:McpHost caller:Caller a:MfJ) {
        def ed:Editable (Tools.workEditable(host caller a ([] _:string ("deck_id"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "begin_work" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def id:string (a.str_("deck_id"))
        def mins:int (a.int_("minutes" (WorkStore.MINUTES())))
        if ((mins < 1) || (mins > (WorkStore.MAX_MINUTES()))) {
            return (Tools.fail(("minutes is 1 to " + (to_string (WorkStore.MAX_MINUTES())) + ".")))
        }
        def titles:[string] (Tools.reviewTitles(host id ed.cur))
        def c:WorkClaim (Tools.claimSlides(a titles))
        if ((strlen c.note) > 0) {
            return (Tools.fail(c.note))
        }
        c.id = (trim (a.str_("work_id")))
        if ((strlen c.id) == 0) {
            c.id = ("w" + (host_short_id host 10))
        }
        c.agent = (trim (a.str_("agent")))
        if ((strlen c.agent) == 0) {
            c.agent = "An assistant"
        }
        c.note = (trim (a.str_("note")))
        def now:int (host_now_ms host)
        c.started = now
        c.expires = (now + ((mins * 60) * 1000))
        def md:string (ed.cur.str_("md"))
        def step (new WorkStep)
        step.hasClaim = true
        step.claim = c
        step.force = (a.bool_("force" false))
        step.base = (WorkStore.version(host md))
        step.baseMd = md
        WorkStore.run(host id step)
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "begin_work" (host_error host)))
        }
        if step.failed {
            return (Tools.fail("Not claimed: the claims of this presentation kept changing; call begin_work again."))
        }
        def others:[WorkClaim] (step.board.others(c.id))
        def lines:[string]
        def sc:MfJ (MfJ.newObj())
        sc.putStr("deck_id" id)
        sc.putBool("claimed" step.taken)
        sc.putStr("version" step.base)
        sc.put("clashes" (WorkStore.claimsJson(host step.clashes)))
        sc.put("work" (WorkStore.claimsJson(host others)))
        sc.putInt("slides" (array_length titles))
        if step.taken {
            sc.putStr("work_id" c.id)
            sc.putStr("expires" (host_iso_time host c.expires))
            push lines ("Claimed " + (c.what()) + " of \"" + (ed.cur.str_("name")) + "\" for " + c.agent + " until " + (WorkStore.clock(host c.expires)) + ".")
            push lines ("work_id: " + c.id)
            push lines ("Version: " + step.base + ". Send base_version and work_id with update_presentation (each update renews the claim), and call end_work when done.")
            for step.clashes fc:WorkClaim fi {
                push lines ("Taken although " + (WorkStore.line(host fc)) + ": the edits are merged line by line, and a change both make to the same lines is refused.")
            }
            for others oc:WorkClaim oi {
                if ((WorkStore.hasClaim(step.clashes oc.id)) == false) {
                    push lines ("Also working on this deck: " + (WorkStore.line(host oc)) + ".")
                }
            }
        } {
            push lines ("Not claimed: " + (c.what()) + " of \"" + (ed.cur.str_("name")) + "\" overlaps another assistant's work.")
            for step.clashes cc:WorkClaim ci {
                push lines ("- " + (WorkStore.line(host cc)) + ".")
            }
            push lines "Work on other slides (begin_work again with them), or ask the user whether to wait until that assistant is done (its claim ends with end_work or when it runs out). Use force true only if the user wants both of you on the same slides."
        }
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((join lines "\n"))))
        r.put("structuredContent" sc)
        return r
    }

    sfn endWork:MfJ (host:McpHost caller:Caller a:MfJ) {
        def ed:Editable (Tools.workEditable(host caller a ([] _:string ("deck_id" "work_id"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "end_work" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def id:string (a.str_("deck_id"))
        def step (new WorkStep)
        step.end = (trim (a.str_("work_id")))
        WorkStore.run(host id step)
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "end_work" (host_error host)))
        }
        if step.failed {
            return (Tools.fail("Not ended: the claims of this presentation kept changing; call end_work again."))
        }
        def said:string ("Ended " + step.end + ": its slides are free for others.")
        if (step.ended == false) {
            said = ("No claim " + step.end + " on this presentation (it had ended or run out).")
        }
        def others:[WorkClaim] (step.board.others(step.end))
        def lines:[string]
        push lines said
        for others oc:WorkClaim oi {
            push lines ("Still working on this deck: " + (WorkStore.line(host oc)) + ".")
        }
        def sc:MfJ (MfJ.newObj())
        sc.putStr("deck_id" id)
        sc.putBool("ended" step.ended)
        sc.put("work" (WorkStore.claimsJson(host others)))
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((join lines "\n"))))
        r.put("structuredContent" sc)
        return r
    }

    ; the edits of update_presentation made on the stored deck's Markdown,
    ; its slides numbered as the stored theme and CSS lay them out
    sfn applyEdits:DeckEditsOut (host:McpHost id:string cur:MfJ a:MfJ) {
        def out (new DeckEditsOut)
        def list:MfJ (a.field("edits"))
        if ((list.isArr()) == false) {
            out.err = "edits is a list of edits."
            return out
        }
        if (Tools.has(a "markdown")) {
            out.err = "give markdown (the whole deck) or edits, not both."
            return out
        }
        def edits:[DeckEdit]
        def n:int 0
        for (a.list("edits")) ej:MfJ ei {
            n = (ei + 1)
            def lead:string ("Edit " + n + ": ")
            if ((ej.isObj()) == false) {
                out.err = (lead + "an edit is an object.")
                return out
            }
            for ([] _:string ("find" "replace" "slide_title" "markdown")) k:string kj {
                def v:MfJ (ej.field(k))
                if ((v.kind != 0) && (v.kind != 3)) {
                    out.err = (lead + k + " is a string.")
                    return out
                }
            }
            for ([] _:string ("slide" "after_slide")) nk:string nj {
                def nv:MfJ (ej.field(nk))
                if ((nv.kind != 0) && ((nv.kind != 2) || (nv.num != (to_double (to_int nv.num))))) {
                    out.err = (lead + nk + " is a whole number.")
                    return out
                }
            }
            def e (new DeckEdit)
            def ways:int 0
            if ((ej.field("find")).kind == 3) {
                ways = (ways + 1)
                e.kind = "text"
                e.find = (ej.str_("find"))
                if ((ej.field("replace")).kind != 3) {
                    out.err = (lead + "find needs replace (\"\" to remove the text).")
                    return out
                }
                e.replace = (ej.str_("replace"))
                e.all = (ej.bool_("all" false))
            }
            if (((ej.field("slide")).kind == 2) || ((ej.field("slide_title")).kind == 3)) {
                ways = (ways + 1)
                e.kind = "slide"
                e.slide = (ej.int_("slide" 0))
                e.title = (ej.str_("slide_title"))
            }
            if ((ej.field("after_slide")).kind == 2) {
                ways = (ways + 1)
                e.kind = "insert"
                e.after = (ej.int_("after_slide" 0))
            }
            if (ways != 1) {
                out.err = (lead + "an edit has find (and replace), or slide (or slide_title) and markdown, or after_slide and markdown.")
                return out
            }
            if ((e.kind != "text") && ((ej.field("markdown")).kind != 3)) {
                out.err = (lead + "markdown is needed (\"\" deletes a slide).")
                return out
            }
            e.markdown = (ej.str_("markdown"))
            push edits e
        }
        def md:string (cur.str_("md"))
        def starts:[int]
        def titles:[string]
        if (Tools.needsSlides(edits)) {
            def noImgs:[Img]
            def stored:[string]
            for (cur.list("files")) sf:MfJ sfi {
                push stored (sf.str_("path"))
            }
            def css:MfJ (cur.field("css"))
            def bgs:CheckPics (Tools.backgrounds(host md noImgs id))
            def ck:Checked (Tools.checkDeck(host md (cur.str_("theme")) (css.kind == 3) (cur.str_("css")) bgs noImgs id stored))
            starts = ck.starts
            titles = ck.titles
        }
        return (DeckEdits.apply(md edits starts titles))
    }

    sfn needsSlides:boolean (edits:[DeckEdit]) {
        for edits one:DeckEdit i {
            if (one.kind != "text") {
                return true
            }
        }
        return false
    }

    ; the stored deck, if this caller may change it (a host error stops it too)
    sfn editable:Editable (host:McpHost caller:Caller id:string key:string) {
        def ed (new Editable)
        ed.key = key
        def cur:MfJ (Store.get(host id))
        if ((strlen (host_error host)) > 0) {
            return ed
        }
        def mine:boolean (((cur.isObj()) && caller.signedIn) && ((cur.str_("owner")) == caller.uid))
        if ((cur.isObj()) == false) {
            ed.fail = ("No presentation " + id + " that this server can change.")
            return ed
        }
        ; someone's editor deck: say whose account is missing, so the
        ; assistant does not quietly save a copy the owner never sees
        if (((cur.str_("source")) != "mcp") && (mine == false)) {
            if caller.signedIn {
                ed.fail = ("Not saved: presentation " + id + " belongs to another Sliqtly account than the one this connector is signed in with (" + caller.name + "). Tell the user, and do not make a copy unasked. To edit it, the user reconnects the Sliqtly connector (disconnect, then connect) and picks the same Google account they use in the Sliqtly editor. A copy made with create_presentation is a separate presentation with its own link; it does not change " + id + ".")
            } {
                ed.fail = ("Not saved: presentation " + id + " belongs to a signed-in Sliqtly user and this connector is not signed in. Tell the user, and do not make a copy unasked. To edit it, the user connects the Sliqtly connector with the same Google account they use in the Sliqtly editor. A copy made with create_presentation is a separate presentation with its own link; it does not change " + id + ".")
            }
            return ed
        }
        if ((mine == false) && ((strlen key) == 0)) {
            ed.fail = "edit_key is needed: the presentation is not this signed-in user's own."
            return ed
        }
        ed.cur = cur
        ed.mine = mine
        return ed
    }

    ; the answer to a change; note goes on its own line after the rest
    sfn updated:MfJ (host:McpHost caller:Caller id:string saved:MfJ note:string) {
        if ((saved.isObj()) == false) {
            return (Tools.fail("The edit_key does not match this presentation."))
        }
        def stored:[string]
        for (saved.list("files")) f:MfJ i {
            def path:string (f.str_("path"))
            if (startsWith path "media/") {
                path = (substring path 6 (strlen path))
            }
            push stored path
        }
        def md:string (saved.str_("md"))
        def none:[string]
        def ws:[string]
        for (Deck.warnings(md none stored)) w:string j {
            if ((startsWith w "Image") == false) {
                push ws w
            }
        }
        def savedCss:MfJ (saved.field("css"))
        def noImgs:[Img]
        def storedPaths:[string]
        for (saved.list("files")) sf:MfJ sfi {
            push storedPaths (sf.str_("path"))
        }
        def bgs:CheckPics (Tools.backgrounds(host md noImgs id))
        def ck:Checked (Tools.checkDeck(host md (saved.str_("theme")) (savedCss.kind == 3) (saved.str_("css")) bgs noImgs id storedPaths))
        for ck.warnings cw:string ci {
            push ws cw
        }
        def out:MfJ (MfJ.newObj())
        out.put("layout" (Tools.layoutJson(ck.report)))
        out.put("pictures" (Tools.svgPictures(host md bgs ck.width ck.height)))
        out.put("title" (saved.field("name")))
        out.put("theme" (saved.field("theme")))
        out.putInt("slides" ck.slides)
        out.put("warnings" (J.strs(ws)))
        Tools.links(out (host_base_url host) id)
        out.putStr("deck_id" id)
        def r:MfJ (Tools.result(host caller out "Updated"))
        if ((strlen note) > 0) {
            def c0:MfJ (itemAt (r.list("content")) 0)
            c0.putStr("text" ((c0.str_("text")) + "\n" + note))
        }
        return r
    }

    ; a whole workbook of values in place of data/<name>.xlsx
    sfn writeWorkbook:MfJ (host:McpHost caller:Caller a:MfJ) {
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured): call create_presentation again with the whole deck."))
        }
        def bad:string (Tools.checkArgs(a ([] _:string ("deck_id" "path"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        if (caller.signedIn == false) {
            return (Tools.needsSignIn(caller "workbooks"))
        }
        def bare:string (trim (a.str_("path")))
        while (startsWith bare "/") {
            bare = (substring bare 1 (strlen bare))
        }
        if (startsWith bare "data/") {
            bare = (substring bare 5 (strlen bare))
        }
        def name:string (Deck.cleanName(bare))
        if (((strlen name) == 0) || ((Files.isXlsx(name)) == false)) {
            return (Tools.fail("path is the workbook's name under data/, ending in .xlsx (e.g. data/budget.xlsx)."))
        }
        def given:MfJ (a.field("sheets"))
        if ((given.kind != 4) || (((array_length given.arr) < 1) || ((array_length given.arr) > 20))) {
            return (Tools.fail("Invalid arguments: sheets is a list of 1 to 20 sheets."))
        }
        def seen:[string]
        def book:MfJ (MfJ.newArr())
        for given.arr s:MfJ i {
            if ((s.isObj()) == false) {
                return (Tools.fail("Invalid arguments: every sheet is an object."))
            }
            if ((s.field("name")).kind != 3) {
                return (Tools.fail("Invalid arguments: every sheet needs a name."))
            }
            def sn:string (s.str_("name"))
            def why:string (Files.badSheetName(sn))
            if ((strlen why) > 0) {
                return (Tools.fail((why + ".")))
            }
            if (Deck.inList(seen (to_lowercase sn))) {
                return (Tools.fail(("Two sheets are named \"" + sn + "\".")))
            }
            push seen (to_lowercase sn)
            def rows:MfJ (s.field("rows"))
            def csv:MfJ (s.field("csv"))
            if ((rows.kind == 4) == (csv.kind == 3)) {
                return (Tools.fail(("Sheet \"" + sn + "\": give rows or csv.")))
            }
            def out:MfJ (MfJ.newArr())
            if (rows.kind == 4) {
                for rows.arr r:MfJ j {
                    if (r.kind != 4) {
                        return (Tools.fail(("Sheet \"" + sn + "\": every row is a list of values.")))
                    }
                    for r.arr v:MfJ k {
                        def isFormula:boolean false
                        if (v.isObj()) {
                            def fvv:MfJ (v.field("v"))
                            isFormula = (((v.field("f")).kind == 3) && (((fvv.kind == 0) || (fvv.kind == 2)) || (fvv.kind == 3)))
                        }
                        if ((((v.kind != 0) && (v.kind != 2)) && (v.kind != 3)) && (isFormula == false)) {
                            return (Tools.fail(("Sheet \"" + sn + "\": a cell is a string, a number, null or { f, v } for a formula.")))
                        }
                    }
                }
                out = rows
            } {
                for (Files.parseCsv(csv.str 44)) cr:SheetRow j2 {
                    out.add((J.strs(cr.cells)))
                }
            }
            def o:MfJ (MfJ.newObj())
            o.putStr("name" sn)
            o.put("rows" out)
            book.add(o)
        }
        def made:MfJ (J.parse((host_xlsx_write host (JOut.text(book)))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "write_workbook" (host_error host)))
        }
        if ((made.int_("size" 0)) > (Files.MAX_DATA())) {
            return (Tools.fail("The workbook would be larger than 10 MB."))
        }
        def id:string (a.str_("deck_id"))
        def ed:Editable (Tools.editable(host caller id (a.str_("edit_key"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "write_workbook" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def im (new Img)
        im.name = name
        im.path = ("data/" + name)
        im.type = (Files.XLSX_MIME())
        im.handle = (made.int_("handle" 0))
        im.size = (made.int_("size" 0))
        def kept:[Img]
        push kept im
        def saved:MfJ (Store.update(host id (ed.mine == false) ed.key (new DeckPatch) kept))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "write_workbook" (host_error host)))
        }
        def note:string "Formatting is not kept. Renamed or removed sheets change the CSV names the deck reads; check the deck's charts and tables still name them."
        return (Tools.withData(host (Tools.updated(host caller id saved note)) kept))
    }

    sfn bindChart:MfJ (host:McpHost caller:Caller a:MfJ) {
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured): call create_presentation again with the whole deck."))
        }
        def bad:string (Tools.checkArgs(a ([] _:string ("deck_id"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        def chart:MfJ (a.field("chart"))
        if (chart.kind == 0) {
            return (Tools.fail("Invalid arguments: chart is required."))
        }
        def source:MfJ (a.field("source"))
        if (source.kind == 0) {
            return (Tools.fail("Invalid arguments: source is required."))
        }
        def id:string (a.str_("deck_id"))
        def ed:Editable (Tools.editable(host caller id (a.str_("edit_key"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "bind_chart_data" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def bound:Bound (Charts.bind((ed.cur.str_("md")) chart source))
        if ((strlen bound.err) > 0) {
            return (Tools.fail(bound.err))
        }
        if ((strlen bound.md) > (Deck.MAX_MD())) {
            return (Tools.fail("markdown would be larger than 300 KB."))
        }
        def p (new DeckPatch)
        p.hasMd = true
        p.md = bound.md
        def noImgs:[Img]
        def saved:MfJ (Store.update(host id (ed.mine == false) ed.key p noImgs))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "bind_chart_data" (host_error host)))
        }
        def on:string ""
        if ((strlen bound.title) > 0) {
            on = (" (on \"" + bound.title + "\")")
        }
        def note:string ("Chart " + bound.index + on + " now reads " + (JOut.text((bound.spec.field("data")))) + ". PDF and PPTX exports are snapshots of the data when exported.")
        def r:MfJ (Tools.updated(host caller id saved note))
        def sc:MfJ (r.field("structuredContent"))
        if (sc.isObj()) {
            sc.putInt("chart" bound.index)
            sc.put("spec" bound.spec)
        }
        return r
    }

    sfn get:MfJ (host:McpHost caller:Caller a:MfJ) {
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured)."))
        }
        def bad:string (Tools.checkArgs(a ([] _:string ("deck_id"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        def id:string (a.str_("deck_id"))
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            return (Tools.fail("deck_id is the 10-character id in the share link."))
        }
        def d:MfJ (Store.get(host id))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "get_presentation" (host_error host)))
        }
        if ((d.isObj()) == false) {
            return (Tools.fail(("No presentation " + id + ".")))
        }
        def images:MfJ (MfJ.newArr())
        def names:[string]
        for (d.list("files")) f:MfJ i {
            def n:string (f.str_("path"))
            if ((Files.isPicture(n)) == false) {
                continue
            }
            n = (substring n 6 (strlen n))
            push names n
            def im:MfJ (MfJ.newObj())
            im.putStr("name" n)
            im.put("type" (f.field("type")))
            im.put("size" (f.field("size")))
            images.add(im)
        }
        def css:MfJ (d.field("css"))
        def hasCss:boolean (css.kind == 3)
        def out:MfJ (MfJ.newObj())
        out.putStr("title" (d.str_("name")))
        out.putStr("theme" (d.str_("theme")))
        out.putStr("markdown" (d.str_("md")))
        if hasCss {
            out.put("css" css)
        } {
            out.put("css" (new MfJ))
        }
        out.put("images" images)
        def files:MfJ (Tools.filesOf(host id d))
        out.put("files" files)
        Tools.links(out (host_base_url host) id)
        def themeName:string (d.str_("theme"))
        if ((strlen themeName) == 0) {
            themeName = "(document's own)"
        }
        def pics:string (join names ", ")
        if ((strlen pics) == 0) {
            pics = "none"
        }
        def parts:[string]
        push parts ("\"" + (out.str_("title")) + "\", theme " + themeName + ", " + (to_string (array_length names)) + " pictures: " + pics + ".")
        def others:MfJ (MfJ.newArr())
        for files.arr of:MfJ oi {
            if ((of.str_("kind")) != "picture") {
                others.add(of)
            }
        }
        if ((others.count()) > 0) {
            push parts ("Files:\n" + (Tools.filesText(others)))
        }
        if hasCss {
            push parts "It has its own stylesheet (css below)."
        }
        push parts "```markdown"
        def md:string (d.str_("md"))
        if ((strlen md) > 0) {
            push parts md
        }
        push parts "```"
        if hasCss {
            push parts ("```css\n" + css.str + "\n```")
        }
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((join parts "\n"))))
        r.put("structuredContent" out)
        ; the version read is kept, to merge an edit made on it
        def step (new WorkStep)
        step.base = (WorkStore.version(host md))
        step.baseMd = md
        WorkStore.run(host id step)
        if ((strlen (host_error host)) > 0) {
            host_log host ("get_presentation work board: " + (host_error host))
            host_clear_error host
        }
        def none:[WorkClaim]
        def others:[WorkClaim] (step.board.others(""))
        if step.failed {
            others = none
        }
        Tools.withWork(host r step.base others)
        return r
    }

    ; --- slides as pictures

    sfn image:MfJ (b64:string) {
        def c:MfJ (MfJ.newObj())
        c.putStr("type" "image")
        c.putStr("data" b64)
        c.putStr("mimeType" "image/jpeg")
        return c
    }

    ; the slide a `slide` argument names: a number from 1, or a title; -1
    ; when there is no such slide
    sfn slideIndex:int (a:MfJ titles:[string]) {
        def v:MfJ (a.field("slide"))
        if (v.kind == 2) {
            def n:int ((a.int_("slide" 0)) - 1)
            if ((n >= 0) && (n < (array_length titles))) {
                return n
            }
            return -1
        }
        if (v.kind == 3) {
            def want:string (to_lowercase (trim v.str))
            def num:int (?? (str2int want) 0)
            if ((num >= 1) && (num <= (array_length titles))) {
                return (num - 1)
            }
            for titles t:string i {
                if ((to_lowercase (trim t)) == want) {
                    return i
                }
            }
            for titles t2:string i2 {
                if (((strlen want) > 0) && ((indexOf (to_lowercase t2) want) >= 0)) {
                    return i2
                }
            }
        }
        return -1
    }

    ; export_presentation: the file made by the editor's own export
    ; (src/PresExport.rgr), kept in Storage beside the deck as
    ; exports/<name>.<format>
    sfn exportDeck:MfJ (host:McpHost a:MfJ) {
        def tool:string "export_presentation"
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured): open the presentation's link and use File → Export there."))
        }
        def bad:string (Tools.checkArgs(a ([] _:string ("deck_id" "format"))))
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        def format:string (a.str_("format"))
        if ((format != "pdf") && (format != "pptx")) {
            return (Tools.fail("Invalid arguments: format is pdf or pptx."))
        }
        def id:string (a.str_("deck_id"))
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            return (Tools.fail("deck_id is the 10-character id in the share link."))
        }
        def d:MfJ (Store.get(host id))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host tool (host_error host)))
        }
        if ((d.isObj()) == false) {
            return (Tools.fail(("No presentation " + id + ".")))
        }
        def md:string (d.str_("md"))
        def stored:[string]
        for (d.list("files")) f:MfJ fi {
            push stored (f.str_("path"))
        }
        def noImgs:[Img]
        def bgs:CheckPics (Tools.backgrounds(host md noImgs id))
        def din (new DeckIn)
        din.deckId = id
        din.stored = stored
        din.live = true
        din.export = format
        def css:MfJ (d.field("css"))
        def wanted:MfJ (a.field("slides"))
        def picked:[string]
        if (wanted.kind != 0) {
            if ((wanted.isArr()) == false) {
                return (Tools.fail("Invalid arguments: slides is a list of slide numbers."))
            }
            for (a.list("slides")) sv:MfJ si {
                if ((sv.kind != 2) || ((sv.num < 1.0) || (sv.num != (to_double (to_int sv.num))))) {
                    return (Tools.fail("Invalid arguments: slides is a list of slide numbers from 1."))
                }
                def sn:int (to_int sv.num)
                if (((Tools.hasInt(din.only (sn - 1))) == false)) {
                    push din.only (sn - 1)
                    push picked (to_string sn)
                }
            }
        }
        def ck:Checked (Tools.checkWith(host md (d.str_("theme")) (css.kind == 3) (d.str_("css")) bgs din))
        if (ck.laidOut == false) {
            return (Tools.failed(host tool "the theme could not be read"))
        }
        for din.only o:int oi {
            if (o >= ck.slides) {
                return (Tools.fail(("No slide " + (o + 1) + ": the presentation has " + ck.slides + " slides.")))
            }
        }
        def bytes:buffer ck.file
        if ((buffer_length bytes) == 0) {
            return (Tools.failed(host tool "the file could not be made"))
        }
        def name:string (Tools.fileName((d.str_("name"))))
        if ((array_length picked) > 0) {
            name = (name + " (slides " + (join picked ", ") + ")")
        }
        def path:string ("exports/" + name + "." + format)
        def type:string "application/pdf"
        if (format == "pptx") {
            type = "application/vnd.openxmlformats-officedocument.presentationml.presentation"
        }
        def full:string ("shares/" + id + "/" + path)
        def token:string (host_uuid host)
        host_upload host (host_keep_bytes host bytes) full type token
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host tool (host_error host)))
        }
        def url:string (host_file_url host full token)
        def count:int ck.slides
        if ((array_length din.only) > 0) {
            count = (array_length din.only)
        }
        def size:int (buffer_length bytes)
        def kb:int (to_int (((to_double size) / 1024.0) + 0.5))
        def what:string "PDF"
        if (format == "pptx") {
            what = "PowerPoint file"
        }
        def out:MfJ (MfJ.newObj())
        out.putStr("deck_id" id)
        out.putStr("format" format)
        out.putStr("name" (name + "." + format))
        out.putStr("url" url)
        out.putInt("slides" count)
        out.putInt("bytes" size)
        def r:MfJ (MfJ.newObj())
        def content:MfJ (MfJ.newArr())
        def t:MfJ (MfJ.newObj())
        t.putStr("type" "text")
        t.putStr("text" (what + " of \"" + (d.str_("name")) + "\" (" + count + " slides, " + kb + " KB): " + url + "\nGive the user this link; it is replaced by the next " + format + " export of this presentation."))
        content.add(t)
        r.put("content" content)
        r.put("structuredContent" out)
        return r
    }

    sfn hasInt:boolean (list:[int] n:int) {
        for list x:int i {
            if (x == n) {
                return true
            }
        }
        return false
    }

    ; a file name from a deck's name: what a file system takes, "presentation"
    ; when nothing is left
    sfn fileName:string (name:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen name)
        while (i < n) {
            def c:int (charAt name i)
            def keep:boolean true
            if ((c < 32) || ((c == 47) || ((c == 92) || ((c == 58) || ((c == 42) || ((c == 63) || ((c == 34) || ((c == 60) || ((c == 62) || ((c == 124) || (c == 35))))))))))) {
                keep = false
            }
            if keep {
                out = (out + (substring name i (i + 1)))
            } {
                out = (out + "-")
            }
            i = (i + 1)
        }
        out = (trim out)
        if ((strlen out) > 80) {
            out = (substring out 0 80)
        }
        if ((strlen out) == 0) {
            return "presentation"
        }
        return out
    }

    sfn render:MfJ (host:McpHost a:MfJ all:boolean) {
        def tool:string "render_slide"
        if all {
            tool = "render_overview"
        }
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured)."))
        }
        def need:[string]
        push need "deck_id"
        if (all == false) {
            push need "slide"
        }
        def bad:string ""
        if ((a.kind != 5) && (a.kind != 0)) {
            bad = "Invalid arguments: expected an object."
        }
        for need nk:string ni {
            if (((strlen bad) == 0) && ((a.field(nk)).kind == 0)) {
                bad = ("Invalid arguments: " + nk + " is required.")
            }
        }
        if ((strlen bad) > 0) {
            return (Tools.fail(bad))
        }
        def id:string (a.str_("deck_id"))
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            return (Tools.fail("deck_id is the 10-character id in the share link."))
        }
        def d:MfJ (Store.get(host id))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host tool (host_error host)))
        }
        if ((d.isObj()) == false) {
            return (Tools.fail(("No presentation " + id + ".")))
        }
        def md:string (d.str_("md"))
        def stored:[string]
        for (d.list("files")) f:MfJ fi {
            push stored (f.str_("path"))
        }
        def noImgs:[Img]
        def bgs:CheckPics (Tools.backgrounds(host md noImgs id))
        def din (new DeckIn)
        din.deckId = id
        din.stored = stored
        din.live = true
        din.lists = true
        def css:MfJ (d.field("css"))
        def ck:Checked (Tools.checkWith(host md (d.str_("theme")) (css.kind == 3) (d.str_("css")) bgs din))
        if ((array_length ck.lists) == 0) {
            return (Tools.fail("The presentation has no slides to draw (or its theme could not be read)."))
        }
        for bgs.pics p:CheckPic pi {
            host_render_pic host p.name (itemAt bgs.data pi)
        }
        def titles:[string]
        for ck.report o:RSlideOut oi {
            push titles o.title
        }
        def content:MfJ (MfJ.newArr())
        def lines:[string]
        if all {
            def n:int (array_length ck.lists)
            def lists:[string]
            def shown:int n
            if (shown > 40) {
                shown = 40
            }
            def li:int 0
            while (li < shown) {
                push lists (itemAt ck.lists li)
                li = (li + 1)
            }
            def cols:int 5
            if (shown <= 4) {
                cols = 2
            } {
                if (shown <= 9) {
                    cols = 3
                } {
                    if (shown <= 16) {
                        cols = 4
                    }
                }
            }
            def b64:string (host_render_grid host lists ck.width ck.height cols 1600)
            if ((strlen b64) == 0) {
                return (Tools.fail("The slides could not be drawn."))
            }
            content.add((Tools.image(b64)))
            push lines ("\"" + (d.str_("name")) + "\": " + (to_string n) + " slides, numbered in the picture's corners.")
            if (n > shown) {
                push lines ("Only the first " + (to_string shown) + " are shown; render_slide draws any of them.")
            }
            for ck.report o2:RSlideOut o2i {
                push lines (itemAt o2.lines 0)
                for o2.flags f2:string f2i {
                    push lines ("  ⚠ " + f2)
                }
            }
        } {
            def at:int (Tools.slideIndex(a titles))
            if (at < 0) {
                return (Tools.fail(("No slide " + (JOut.text((a.field("slide")))) + ": the presentation has " + (to_string (array_length titles)) + " slides.")))
            }
            def b64s:string (host_render host (itemAt ck.lists at) ck.width ck.height 960)
            if ((strlen b64s) == 0) {
                return (Tools.fail("The slide could not be drawn."))
            }
            content.add((Tools.image(b64s)))
            def one:[RSlideOut]
            push one (itemAt ck.report at)
            push lines (Tools.layoutText((Tools.layoutJson(one)) false))
        }
        def svgs:string (Tools.svgText((Tools.svgPictures(host md bgs ck.width ck.height))))
        if ((strlen svgs) > 0) {
            push lines svgs
        }
        push lines "Drawn as the player shows each slide at the end of its animations. Effects (fx=) and picture corners are not drawn here; SVG pictures are."
        def tc:MfJ (MfJ.newObj())
        tc.putStr("type" "text")
        tc.putStr("text" (join lines "\n"))
        content.add(tc)
        def r:MfJ (MfJ.newObj())
        r.put("content" content)
        return r
    }

    ; --- data files

    ; the kept data files, and the names a deck reads each one (or each
    ; sheet of a workbook) by
    sfn withData:MfJ (host:McpHost out:MfJ data:[Img]) {
        if ((array_length data) == 0) {
            return out
        }
        def lines:[string]
        push lines "Data files kept:"
        def kept:MfJ (MfJ.newArr())
        for data f:Img i {
            def k:MfJ (MfJ.newObj())
            k.putStr("path" f.path)
            if (Files.isXlsx(f.path)) {
                def info:MfJ (Files.info((Files.tables(host f.handle f.path))))
                k.put("sheets" info)
                def parts:[string]
                for info.arr o:MfJ j {
                    def cols:[string]
                    for (J.strList((o.field("columns")))) c:string ci {
                        push cols (JOut.text((J.s(c))))
                    }
                    push parts ("sheet " + (JOut.text((J.s((o.str_("name")))))) + " (" + (to_string (o.int_("rows" 0))) + " rows; columns " + (join cols ", ") + ") read as " + (o.str_("csv")))
                }
                def said:string (join parts "; ")
                if ((strlen said) == 0) {
                    said = "no sheet has values"
                }
                push lines ("- " + f.path + ": " + said)
            } {
                push lines ("- " + f.path)
            }
            kept.add(k)
        }
        def content:MfJ (out.field("content"))
        if ((content.count()) > 0) {
            def c0:MfJ (content.item(0))
            c0.putStr("text" ((c0.str_("text")) + "\n" + (join lines "\n")))
        }
        def sc:MfJ (out.field("structuredContent"))
        if (sc.isObj()) {
            sc.put("files" kept)
        }
        return out
    }

    ; every file a deck keeps, and what is in its workbooks
    sfn filesOf:MfJ (host:McpHost id:string d:MfJ) {
        def out:MfJ (MfJ.newArr())
        for (d.list("files")) f:MfJ i {
            def path:string (f.str_("path"))
            def o:MfJ (MfJ.newObj())
            o.putStr("path" path)
            o.putStr("kind" (Files.kindOf(path)))
            o.putStr("type" (f.str_("type")))
            o.putInt("size" (f.int_("size" 0)))
            if (Files.isXlsx(path)) {
                if ((f.int_("size" 0)) > (Files.MAX_READ())) {
                    o.putStr("note" "too large to read here")
                } {
                    def got:MfJ (J.parse((host_file_bytes host id path)))
                    def err:string (host_error host)
                    if ((strlen err) > 0) {
                        host_clear_error host
                        o.putStr("note" ("could not read the workbook: " + err))
                    } {
                        def ts:Tables (Files.tables(host (got.int_("handle" 0)) path))
                        if ((strlen ts.err) > 0) {
                            o.putStr("note" ("could not read the workbook: " + ts.err))
                        } {
                            o.put("sheets" (Files.info(ts)))
                        }
                    }
                }
            }
            out.add(o)
        }
        return out
    }

    sfn filesText:string (files:MfJ) {
        if ((files.count()) == 0) {
            return "No files."
        }
        def lines:[string]
        def data:boolean false
        for files.arr f:MfJ i {
            if ((f.str_("kind")) != "picture") {
                data = true
            }
        }
        if data {
            push lines "read_file reads the values of a data file or a workbook's sheet."
        }
        for files.arr f2:MfJ j {
            def note:string ""
            if ((strlen (f2.str_("note"))) > 0) {
                note = (" — " + (f2.str_("note")))
            }
            push lines ("- " + (f2.str_("path")) + " (" + (f2.str_("kind")) + ", " + (to_string (f2.int_("size" 0))) + " bytes)" + note)
            for (f2.list("sheets")) sh:MfJ k {
                push lines ("  - " + (Files.sheetLine(sh)))
            }
        }
        return (join lines "\n")
    }

    ; the stored deck for list_files and read_file, or why not
    sfn readable:MfJ (host:McpHost a:MfJ required:[string]) {
        def r:MfJ (MfJ.newObj())
        if ((host_store_kind host) == "link") {
            r.put("fail" (Tools.fail("This server keeps no decks (no cloud storage configured).")))
            return r
        }
        def bad:string (Tools.checkArgs(a required))
        if ((strlen bad) > 0) {
            r.put("fail" (Tools.fail(bad)))
            return r
        }
        def id:string (a.str_("deck_id"))
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            r.put("fail" (Tools.fail("deck_id is the 10-character id in the share link.")))
            return r
        }
        def d:MfJ (Store.get(host id))
        if ((strlen (host_error host)) > 0) {
            return r
        }
        if ((d.isObj()) == false) {
            r.put("fail" (Tools.fail(("No presentation " + id + "."))))
            return r
        }
        r.put("deck" d)
        return r
    }

    sfn listFiles:MfJ (host:McpHost caller:Caller a:MfJ) {
        def got:MfJ (Tools.readable(host a ([] _:string ("deck_id"))))
        if ((got.field("fail")).isObj()) {
            return (got.field("fail"))
        }
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "list_files" (host_error host)))
        }
        def files:MfJ (Tools.filesOf(host (a.str_("deck_id")) (got.field("deck"))))
        def sc:MfJ (MfJ.newObj())
        sc.put("files" files)
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((Tools.filesText(files)))))
        r.put("structuredContent" sc)
        return r
    }

    ; the values of one of a deck's files: a workbook's sheet (by the
    ; workbook's path, or the CSV name the deck reads the sheet by) or a CSV,
    ; TSV, JSON or text file; rows a window at a time
    sfn readFile:MfJ (host:McpHost caller:Caller a:MfJ) {
        def got:MfJ (Tools.readable(host a ([] _:string ("deck_id" "path"))))
        if ((got.field("fail")).isObj()) {
            return (got.field("fail"))
        }
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "read_file" (host_error host)))
        }
        def id:string (a.str_("deck_id"))
        def d:MfJ (got.field("deck"))
        def want:string (trim (a.str_("path")))
        while (startsWith want "/") {
            want = (substring want 1 (strlen want))
        }
        def sheetName:string (a.str_("sheet"))
        def hasSheet:boolean ((a.field("sheet")).kind == 3)
        def offset:int (a.int_("offset" 0))
        def limit:int (a.int_("limit" 200))
        def files:[MfJ] (d.list("files"))
        def found:MfJ (new MfJ)
        for files f:MfJ i {
            if (((f.str_("path")) == want) && ((found.isObj()) == false)) {
                found = f
            }
        }
        def isBook:boolean false
        def ts (new Tables)
        if (found.isObj()) {
            if (Files.isXlsx((found.str_("path")))) {
                isBook = true
                ts = (Tools.bookTables(host id found))
            }
        } {
            ; a sheet's CSV name: data/<book>-<Sheet>.csv or data/<book>.csv
            for files w:MfJ j {
                def wp:string (w.str_("path"))
                if (((found.isObj()) == false) && (Files.isXlsx(wp))) {
                    def base:string (substring wp 0 ((strlen wp) - 5))
                    if ((want == (base + ".csv")) || (startsWith want (base + "-"))) {
                        def all:Tables (Tools.bookTables(host id w))
                        for all.list t:DataTable k {
                            if ((Files.readsAs(t want)) && ((found.isObj()) == false)) {
                                found = w
                                isBook = true
                                ts = all
                                sheetName = t.name
                                hasSheet = true
                            }
                        }
                    }
                }
            }
        }
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "read_file" (host_error host)))
        }
        if ((found.isObj()) == false) {
            def have:[string]
            for files h:MfJ m {
                if ((Files.isPicture((h.str_("path")))) == false) {
                    push have (h.str_("path"))
                }
            }
            def tail:string " It keeps no data files."
            if ((array_length have) > 0) {
                tail = (" Its files: " + (join have ", ") + ".")
            }
            return (Tools.fail(("No file " + want + " in presentation " + id + "." + tail)))
        }
        def path:string (found.str_("path"))
        if (Files.isPicture(path)) {
            return (Tools.fail((path + " is a picture.")))
        }
        if ((found.int_("size" 0)) > (Files.MAX_READ())) {
            return (Tools.fail((path + " is too large to read here.")))
        }
        def columns:[string]
        def rows:[SheetRow]
        def sheet:MfJ (new MfJ)
        def note:string ""
        if isBook {
            if ((strlen ts.err) > 0) {
                return (Tools.fail((path + ": could not read the workbook: " + ts.err)))
            }
            if ((array_length ts.list) == 0) {
                return (Tools.fail((path + ": no sheet has values.")))
            }
            def pick:int -1
            if hasSheet {
                def low:string (to_lowercase (trim sheetName))
                def si:int 0
                while (si < (array_length ts.list)) {
                    def tt:DataTable (itemAt ts.list si)
                    if (((to_lowercase tt.name) == low) && (pick < 0)) {
                        pick = si
                    }
                    si = (si + 1)
                }
            } {
                pick = 0
            }
            if (pick < 0) {
                def names:[string]
                for ts.list tn:DataTable n {
                    push names (JOut.text((J.s(tn.name))))
                }
                return (Tools.fail((path + " has no sheet \"" + sheetName + "\". Its sheets: " + (join names ", ") + ".")))
            }
            def chosen:DataTable (itemAt ts.list pick)
            sheet = (MfJ.newObj())
            sheet.putStr("name" chosen.name)
            sheet.putStr("csv" chosen.csv)
            columns = chosen.columns
            rows = chosen.rows
            if ((array_length ts.list) > 1) {
                def others:[string]
                for ts.list to:DataTable q {
                    if (to.name != chosen.name) {
                        push others (JOut.text((J.s(to.name))))
                    }
                }
                note = ("Other sheets: " + (join others ", ") + " (read with sheet). ")
            }
            note = (note + "Dates are written as the workbook shows them.")
        } {
            def gotBytes:MfJ (J.parse((host_file_bytes host id path)))
            if ((strlen (host_error host)) > 0) {
                return (Tools.failed(host "read_file" (host_error host)))
            }
            def text:string (host_text host (gotBytes.int_("handle" 0)))
            def low2:string (to_lowercase path)
            if ((endsWith low2 ".csv") || (endsWith low2 ".tsv")) {
                def sep:int 44
                if (endsWith low2 ".tsv") {
                    sep = 9
                }
                def all2:[SheetRow] (Files.parseCsv(text sep))
                def first:boolean true
                for all2 r:SheetRow ri {
                    if ((Files.filled(r)) > 0) {
                        if first {
                            columns = r.cells
                            first = false
                        } {
                            push rows r
                        }
                    }
                }
            } {
                ; JSON, a chart spec, text: as it is, cut at 200 KB
                def cut:boolean ((strlen text) > 204800)
                def shown:string text
                if cut {
                    shown = (substring text 0 204800)
                }
                def lead:string (path + " (" + (to_string (strlen text)) + " characters")
                if cut {
                    lead = (lead + ", first 200 KB")
                }
                def sc2:MfJ (MfJ.newObj())
                sc2.putStr("path" path)
                sc2.putStr("text" shown)
                sc2.putBool("truncated" cut)
                def r2:MfJ (MfJ.newObj())
                r2.put("content" (Tools.text((lead + "):\n" + shown))))
                r2.put("structuredContent" sc2)
                return r2
            }
        }
        def total:int (array_length rows)
        def window:[SheetRow]
        def rowsJ:MfJ (MfJ.newArr())
        def at:int offset
        while ((at < total) && (at < (offset + limit))) {
            def src:SheetRow (itemAt rows at)
            def wr (new SheetRow)
            for src.cells v:string vi {
                push wr.cells v
            }
            while ((array_length wr.cells) < (array_length columns)) {
                push wr.cells ""
            }
            push window wr
            rowsJ.add((J.strs(wr.cells)))
            at = (at + 1)
        }
        def shownCount:int (array_length window)
        def next:int -1
        if ((offset + shownCount) < total) {
            next = (offset + shownCount)
        }
        def colsQ:[string]
        for columns c:string cq {
            push colsQ (JOut.text((J.s(c))))
        }
        def lead2:string path
        if (sheet.isObj()) {
            lead2 = (lead2 + " sheet " + (JOut.text((J.s((sheet.str_("name")))))) + " (read in the deck as " + (sheet.str_("csv")) + ")")
        }
        def lines:[string]
        push lines (lead2 + ": " + (to_string total) + " data rows, columns " + (join colsQ ", ") + ".")
        def from:int 0
        if (shownCount > 0) {
            from = (offset + 1)
        }
        def range:string ("Rows " + (to_string from) + "–" + (to_string (offset + shownCount)) + " of " + (to_string total))
        if (next >= 0) {
            range = (range + "; next: offset " + (to_string next))
        }
        push lines (range + ".")
        if ((strlen note) > 0) {
            push lines (trim note)
        }
        def head (new SheetRow)
        head.cells = columns
        def all3:[SheetRow]
        push all3 head
        for window wr2:SheetRow wi {
            push all3 wr2
        }
        push lines "```csv"
        push lines (Files.toCsv(all3))
        push lines "```"
        def sc3:MfJ (MfJ.newObj())
        sc3.putStr("path" path)
        sc3.put("sheet" sheet)
        sc3.put("columns" (J.strs(columns)))
        sc3.put("rows" rowsJ)
        sc3.putInt("total_rows" total)
        sc3.putInt("offset" offset)
        if (next >= 0) {
            sc3.putInt("next_offset" next)
        } {
            sc3.put("next_offset" (new MfJ))
        }
        def r3:MfJ (MfJ.newObj())
        r3.put("content" (Tools.text((join lines "\n"))))
        r3.put("structuredContent" sc3)
        return r3
    }

    ; a kept workbook's sheets; a Storage error is left on the host
    sfn bookTables:Tables (host:McpHost id:string f:MfJ) {
        def ts (new Tables)
        if ((f.int_("size" 0)) > (Files.MAX_READ())) {
            ts.err = "too large to read here"
            return ts
        }
        def got:MfJ (J.parse((host_file_bytes host id (f.str_("path")))))
        if ((strlen (host_error host)) > 0) {
            return ts
        }
        return (Files.tables(host (got.int_("handle" 0)) (f.str_("path"))))
    }

    ; --- review comments: the editor's review/comments.json (src/PresReview.rgr)

    ; the colour an assistant's messages are shown with
    sfn AI_COLOR:string () {
        return "#c4b5fd"
    }

    ; the deck's comments as kept; a Storage error is left on the host
    sfn reviewOf:PresReview (host:McpHost id:string d:MfJ) {
        for (d.list("files")) f:MfJ i {
            if ((f.str_("path")) == (PresReview.PATH())) {
                def got:MfJ (J.parse((host_file_bytes host id (f.str_("path")))))
                if ((strlen (host_error host)) > 0) {
                    return (new PresReview())
                }
                return (PresReview.parse((host_text host (got.int_("handle" 0)))))
            }
        }
        return (new PresReview())
    }

    ; the slides' titles as the player numbers them (a slide that runs over
    ; goes on in untitled slides); none when the theme could not be read
    sfn reviewTitles:[string] (host:McpHost id:string d:MfJ) {
        def md:string (d.str_("md"))
        def stored:[string]
        for (d.list("files")) f:MfJ fi {
            push stored (f.str_("path"))
        }
        def noImgs:[Img]
        def bgs:CheckPics (Tools.backgrounds(host md noImgs id))
        def din (new DeckIn)
        din.deckId = id
        din.stored = stored
        def css:MfJ (d.field("css"))
        def ck:Checked (Tools.checkWith(host md (d.str_("theme")) (css.kind == 3) (d.str_("css")) bgs din))
        host_clear_error host
        return ck.titles
    }

    sfn slideLabel:string (t:PresReviewThread) {
        def s:string ("slide " + (to_string (t.slide + 1)))
        if ((strlen t.title) > 0) {
            s = (s + " \"" + t.title + "\"")
        }
        return s
    }

    sfn threadJson:MfJ (host:McpHost t:PresReviewThread) {
        def o:MfJ (MfJ.newObj())
        o.putStr("thread_id" t.id)
        o.putInt("slide" (t.slide + 1))
        o.putStr("slide_title" t.title)
        o.putNum("x" (PresReview.round4(t.x)))
        o.putNum("y" (PresReview.round4(t.y)))
        o.putBool("resolved" t.closed)
        if ((t.dia >= 0) && ((strlen t.node) > 0)) {
            o.putStr("diagram_node" t.node)
        }
        def ms:MfJ (MfJ.newArr())
        for t.msgs m:PresReviewMsg i {
            def mo:MfJ (MfJ.newObj())
            mo.putStr("author" m.name)
            mo.putStr("text" m.text)
            mo.putStr("at" (host_iso_time host (to_int m.at)))
            ms.add(mo)
        }
        o.put("messages" ms)
        return o
    }

    sfn threadText:string (host:McpHost t:PresReviewThread) {
        def state:string "open"
        if t.closed {
            state = "resolved"
        }
        def lines:[string]
        def onNode:string ""
        if ((t.dia >= 0) && ((strlen t.node) > 0)) {
            onNode = (", on the diagram's node " + t.node)
        }
        push lines ("Thread " + t.id + " (" + state + ") on " + (Tools.slideLabel(t)) + onNode + ", pinned at x " + (to_string (PresReview.round4(t.x))) + ", y " + (to_string (PresReview.round4(t.y))) + ":")
        for t.msgs m:PresReviewMsg i {
            def who:string m.name
            if ((strlen who) == 0) {
                who = "Someone"
            }
            push lines ("  " + who + " (" + (host_iso_time host (to_int m.at)) + "): " + m.text)
        }
        return (join lines "\n")
    }

    sfn listComments:MfJ (host:McpHost caller:Caller a:MfJ) {
        def got:MfJ (Tools.readable(host a ([] _:string ("deck_id"))))
        if ((got.field("fail")).isObj()) {
            return (got.field("fail"))
        }
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "list_comments" (host_error host)))
        }
        def id:string (a.str_("deck_id"))
        def d:MfJ (got.field("deck"))
        def rv:PresReview (Tools.reviewOf(host id d))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "list_comments" (host_error host)))
        }
        def withClosed:boolean (a.bool_("include_resolved" true))
        if ((rv.count()) > 0) {
            rv.place((Tools.reviewTitles(host id d)))
        }
        ; slide by slide, each slide's threads in the order they were started
        def last:int -1
        for rv.threads t0:PresReviewThread i0 {
            if (t0.slide > last) {
                last = t0.slide
            }
        }
        def list:MfJ (MfJ.newArr())
        def lines:[string]
        def s:int 0
        while (s <= last) {
            for (rv.onSlide(s)) t:PresReviewThread i {
                if (t.closed && (withClosed == false)) {
                    continue
                }
                list.add((Tools.threadJson(host t)))
                push lines (Tools.threadText(host t))
            }
            s = (s + 1)
        }
        def open:int (rv.openCount())
        def lead:string ("\"" + (d.str_("name")) + "\": " + (to_string (rv.count())) + " review comment threads, " + (to_string open) + " open.")
        if ((rv.count()) == 0) {
            lead = ("\"" + (d.str_("name")) + "\" has no review comments.")
        }
        if ((withClosed == false) && ((rv.count()) > open)) {
            lead = (lead + " Resolved ones are left out.")
        }
        def all:[string]
        push all lead
        for lines ln:string li {
            push all ln
        }
        def sc:MfJ (MfJ.newObj())
        sc.putStr("deck_id" id)
        sc.putInt("open" open)
        sc.put("threads" list)
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((join all "\n\n"))))
        r.put("structuredContent" sc)
        return r
    }

    ; the deck a comment changes, or why not (in fail)
    sfn reviewEditable:Editable (host:McpHost caller:Caller a:MfJ required:[string]) {
        def ed (new Editable)
        if ((host_store_kind host) == "link") {
            ed.fail = "This server keeps no decks (no cloud storage configured)."
            return ed
        }
        def bad:string (Tools.checkArgs(a required))
        if ((strlen bad) == 0) {
            for ([] _:string ("thread_id" "text" "author" "slide_title")) k:string j {
                def v:MfJ (a.field(k))
                if (((v.kind != 0) && (v.kind != 3)) && ((strlen bad) == 0)) {
                    bad = ("Invalid arguments: " + k + " is a string.")
                }
            }
        }
        if ((strlen bad) > 0) {
            ed.fail = bad
            return ed
        }
        def txt:string (trim (a.str_("text")))
        if ((Tools.chars(txt)) > 4000) {
            ed.fail = "text is longer than 4000 characters."
            return ed
        }
        if ((Tools.chars((trim (a.str_("author"))))) > 60) {
            ed.fail = "author is longer than 60 characters."
            return ed
        }
        return (Tools.editable(host caller (a.str_("deck_id")) (a.str_("edit_key"))))
    }

    sfn reviewAuthor:string (a:MfJ) {
        def n:string (trim (a.str_("author")))
        if ((strlen n) == 0) {
            return "AI assistant"
        }
        return n
    }

    ; the comments back into the deck: the deck as saved, a null value when
    ; the key does not match
    sfn keepReview:MfJ (host:McpHost id:string ed:Editable rv:PresReview) {
        def text:string (rv.toJson())
        def im (new Img)
        im.name = "comments.json"
        im.path = (PresReview.PATH())
        im.type = "application/json"
        im.handle = (host_keep_text host text)
        im.size = (strlen text)
        def kept:[Img]
        push kept im
        return (Store.update(host id (ed.mine == false) ed.key (new DeckPatch) kept))
    }

    sfn reviewAnswer:MfJ (host:McpHost id:string t:PresReviewThread said:string) {
        def sc:MfJ (MfJ.newObj())
        sc.putStr("deck_id" id)
        sc.put("thread" (Tools.threadJson(host t)))
        def r:MfJ (MfJ.newObj())
        r.put("content" (Tools.text((said + " People see it in the editor's review mode."))))
        r.put("structuredContent" sc)
        return r
    }

    sfn noThread:MfJ (rv:PresReview tid:string) {
        if (rv.isGone(tid)) {
            return (Tools.fail(("Thread " + tid + " was deleted.")))
        }
        return (Tools.fail(("No comment thread " + tid + " in this presentation; list_comments gives the ids.")))
    }

    sfn addComment:MfJ (host:McpHost caller:Caller a:MfJ) {
        def ed:Editable (Tools.reviewEditable(host caller a ([] _:string ("deck_id" "text"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "add_comment" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def text:string (trim (a.str_("text")))
        if ((strlen text) == 0) {
            return (Tools.fail("Invalid arguments: text is empty."))
        }
        def id:string (a.str_("deck_id"))
        def rv:PresReview (Tools.reviewOf(host id ed.cur))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "add_comment" (host_error host)))
        }
        def now:double (to_double (host_now_ms host))
        def m:PresReviewMsg (PresReview.msg(("ai" + (host_short_id host 12)) "ai" (Tools.reviewAuthor(a)) (Tools.AI_COLOR()) text now))
        def tid:string (trim (a.str_("thread_id")))
        def said:string ""
        if ((strlen tid) > 0) {
            if ((rv.has(tid)) == false) {
                return (Tools.noThread(rv tid))
            }
            def reopened:boolean (rv.setClosed(tid false "ai" now))
            rv.reply(tid m)
            said = ("Answered thread " + tid + ".")
            if reopened {
                said = ("Answered thread " + tid + " and opened it again (it was resolved).")
            }
        } {
            def titles:[string] (Tools.reviewTitles(host id ed.cur))
            def n:int (array_length titles)
            def slide:int -1
            def sv:MfJ (a.field("slide"))
            if (sv.kind == 2) {
                slide = ((a.int_("slide" 0)) - 1)
                if ((slide < 0) || ((n > 0) && (slide >= n))) {
                    return (Tools.fail(("slide is a number from 1 to " + (to_string n) + ".")))
                }
            } {
                def want:string (to_lowercase (trim (a.str_("slide_title"))))
                if ((strlen want) == 0) {
                    return (Tools.fail("Say where the comment goes: slide (a number) or slide_title, or thread_id to answer a thread."))
                }
                def j:int 0
                while ((j < n) && (slide < 0)) {
                    if ((to_lowercase (trim (itemAt titles j))) == want) {
                        slide = j
                    }
                    j = (j + 1)
                }
                if (slide < 0) {
                    def named:[string]
                    for titles tt:string ti {
                        if ((strlen tt) > 0) {
                            push named ((to_string (ti + 1)) + " \"" + tt + "\"")
                        }
                    }
                    return (Tools.fail(("No slide is titled \"" + (a.str_("slide_title")) + "\". The slides: " + (join named ", ") + ".")))
                }
            }
            ; by default down the right edge, under the slide's other comments
            def x:double (a.num_("x" 0.9))
            def y:double (a.num_("y" (0.1 + (0.09 * (to_double (array_length (rv.onSlide(slide))))))))
            def title:string ""
            if (slide < n) {
                title = (itemAt titles slide)
            }
            tid = ("ai" + (host_short_id host 12))
            if ((rv.start(tid slide title x y m)) == false) {
                return (Tools.fail("The comment could not be added."))
            }
            def t0:PresReviewThread (unwrap (rv.find(tid)))
            said = ("Comment added on " + (Tools.slideLabel(t0)) + " (thread " + tid + ").")
        }
        def saved:MfJ (Tools.keepReview(host id ed rv))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "add_comment" (host_error host)))
        }
        if ((saved.isObj()) == false) {
            return (Tools.fail("The edit_key does not match this presentation."))
        }
        return (Tools.reviewAnswer(host id (unwrap (rv.find(tid))) said))
    }

    sfn resolveComment:MfJ (host:McpHost caller:Caller a:MfJ) {
        def ed:Editable (Tools.reviewEditable(host caller a ([] _:string ("deck_id" "thread_id"))))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "resolve_comment" (host_error host)))
        }
        if ((strlen ed.fail) > 0) {
            return (Tools.fail(ed.fail))
        }
        def id:string (a.str_("deck_id"))
        def rv:PresReview (Tools.reviewOf(host id ed.cur))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "resolve_comment" (host_error host)))
        }
        def tid:string (trim (a.str_("thread_id")))
        if ((rv.has(tid)) == false) {
            return (Tools.noThread(rv tid))
        }
        def closing:boolean (a.bool_("resolved" true))
        def now:double (to_double (host_now_ms host))
        def text:string (trim (a.str_("text")))
        def wrote:boolean false
        if ((strlen text) > 0) {
            ; a closed thread takes no message: open it for the last word
            rv.setClosed(tid false "ai" now)
            wrote = (rv.reply(tid (PresReview.msg(("ai" + (host_short_id host 12)) "ai" (Tools.reviewAuthor(a)) (Tools.AI_COLOR()) text now))))
        }
        def changed:boolean (rv.setClosed(tid closing "ai" now))
        def said:string ""
        if closing {
            said = ("Thread " + tid + " is resolved.")
            if ((changed == false) && (wrote == false)) {
                said = ("Thread " + tid + " was already resolved.")
            }
        } {
            said = ("Thread " + tid + " is open again.")
            if ((changed == false) && (wrote == false)) {
                said = ("Thread " + tid + " was already open.")
            }
        }
        if (changed || wrote) {
            def saved:MfJ (Tools.keepReview(host id ed rv))
            if ((strlen (host_error host)) > 0) {
                return (Tools.failed(host "resolve_comment" (host_error host)))
            }
            if ((saved.isObj()) == false) {
                return (Tools.fail("The edit_key does not match this presentation."))
            }
        }
        return (Tools.reviewAnswer(host id (unwrap (rv.find(tid))) said))
    }

    sfn listMine:MfJ (host:McpHost caller:Caller) {
        if (caller.signedIn == false) {
            def r:MfJ (Tools.fail("Listing presentations needs sign-in. Connect Sliqtly with sign-in (Google) to keep presentations in your own account."))
            if ((strlen caller.signIn) > 0) {
                def meta:MfJ (MfJ.newObj())
                meta.put("mcp/www_authenticate" (J.strs(([] _:string (("Bearer resource_metadata=\"" + caller.signIn + "\", error=\"insufficient_scope\", error_description=\"Sign in to Sliqtly to list your presentations\""))))))
                r.put("_meta" meta)
            }
            return r
        }
        if ((host_store_kind host) == "link") {
            return (Tools.fail("This server keeps no decks (no cloud storage configured)."))
        }
        def docs:[MfJ] (Store.list(host caller.uid))
        if ((strlen (host_error host)) > 0) {
            return (Tools.failed(host "list_presentations" (host_error host)))
        }
        def base:string (host_base_url host)
        def decks:MfJ (MfJ.newArr())
        def lines:[string]
        for docs d:MfJ i {
            def id:string (d.str_("id"))
            def deck:MfJ (MfJ.newObj())
            deck.putStr("deck_id" id)
            deck.putStr("title" (d.str_("name")))
            ; the key part of the name (ABC-1234) when the server has a
            ; naming rule, to search and index by
            def nameKey:string (host_name_key host (d.str_("name")))
            if ((strlen nameKey) > 0) {
                deck.putStr("key" nameKey)
            }
            deck.putStr("theme" (d.str_("theme")))
            def t:double (Store.stamp(d))
            if (t > 0.0) {
                deck.putStr("updated" (host_iso_time host (to_int t)))
            } {
                deck.put("updated" (new MfJ))
            }
            Tools.links(deck base id)
            decks.add(deck)
            def title:string (d.str_("name"))
            if ((strlen title) == 0) {
                title = "(untitled)"
            }
            push lines ("- " + title + " (" + id + "): " + (deck.str_("share_url")))
        }
        def txt:string (join lines "\n")
        if ((array_length lines) == 0) {
            txt = "No presentations yet."
        }
        def sc:MfJ (MfJ.newObj())
        sc.put("presentations" decks)
        def r2:MfJ (MfJ.newObj())
        r2.put("content" (Tools.text(txt)))
        r2.put("structuredContent" sc)
        return r2
    }
}

; update_presentation's save: why not, or the deck as saved, its version,
; the others' claims and what to tell about the merge
class WorkSave {
    def fail:string ""
    def note:string ""
    def saved:MfJ (new MfJ)
    def version:string ""
    def others:[WorkClaim]
}

; the deck's stylesheet: hasCss false stores none; err is the model's
; mistake, fatal the site's
class Sheet {
    def hasCss:boolean false
    def css:string ""
    def err:string ""
    def fatal:string ""
}
