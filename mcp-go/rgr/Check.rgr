; SPDX-License-Identifier: AGPL-3.0-or-later

; The deck read by the editor's own model (src/PresDeck.rgr, linked into
; Ranger as gallery/presentation): the slides as the player lays them out,
; and the charts and diagrams it could not draw, so a model hears about them
; before anyone opens the link.

Import "McpHost.rgr"
Import "Guide.rgr"
Import "../presentation/PresDeck.rgr"
Import "Contrast.rgr"
Import "Files.rgr"
Import "Layout.rgr"
Import "../presentation/PresExport.rgr"
Import "../presentation/Pres3DStill.rgr"
Import "../presentation/Pres3DGltf.rgr"
Import "pkg:image/PNGEncoder.rgr"

; what a deck is checked with
; A 3-D world drawn without a GPU (Check.drawWorlds): RGBA from the top.
class CheckWorldPic {
    def src:string ""
    def rgba:buffer (buffer_alloc 0)
    def w:int 0
    def h:int 0
}

class DeckIn {
    def md:string ""
    def css:string ""
    ; the pictures the deck names, as /media/<name>, with their bytes and
    ; types; a picture's grid is what the contrast check samples
    def pics:[CheckPic]
    def data:[buffer]
    def types:[string]
    ; this call's data files (path data/<name>, bytes behind the handle)
    def files:[Img]
    ; the stored deck whose files a chart may read, and their paths
    def deckId:string ""
    def stored:[string]
    ; charts read https data too (a live CSV, a Google Sheet)
    def live:boolean false
    ; keep each slide's display list as JSON, for drawing it
    def lists:boolean false
    ; with lists: slide `fxAt` (0 = first) with its own effects' clock at
    ; `fxTime` seconds into it (PresDeck.fxClockAt); -1: the end state
    def fxAt:int -1
    def fxTime:double -1.0
    ; with lists: slide `fxAt` also drawn at each of these seconds into it
    ; (its effects' clock and its script at that moment): Checked.strip
    def strip:[double]
    ; …or this many times, evenly from 0 to where the slide ends
    ; (`export-frame`, else its length, at most 20 s)
    def stripCount:int 0
    ; "pdf", "pptx", "docx" or "html": the deck exported as that file (Checked.file), only
    ; the slides in `only` (0 = first) when it is not empty
    def export:string ""
    def only:[int]
    ; the slide whose entities a slide's script finds (Checked.sceneJson):
    ; the tool's arguments, their `slide` a number from 1 or a title; none
    ; when it has no `slide`. `sceneSel`: a selector tried on it
    def sceneOf:MfJ (new MfJ)
    def sceneSel:string ""
}

class Checked {
    ; the theme's sheet was there: without it the slide count is not the
    ; player's (the sheet says which headings start a slide)
    def laidOut:boolean false
    def slides:int 0
    ; each slide's title, as the player numbers them
    def titles:[string]
    ; where each slide starts in the Markdown (-1: it drew nothing)
    def starts:[int]
    ; the heading level that starts a slide (`deck { split-level }`)
    def splitLevel:int 2
    def warnings:[string]
    ; the layout report, slide by slide
    def report:[RSlideOut]
    ; the presentation's own data from its front matter (`jira: ACME-400`),
    ; as `jira=ACME-400 owner=Tero`; "" when it has none
    def deckData:string ""
    ; with DeckIn.lists: each slide's display list as JSON
    def lists:[string]
    ; with DeckIn.lists: the deck's own effects as register code, for the
    ; painter (FxLang.programsJson, mcp-go/fxvm.go)
    def fxPrograms:string "[]"
    def width:double 960.0
    def height:double 540.0
    ; with DeckIn.export: the file
    def file:buffer (buffer_from_string "")
    ; export "gltf": the world written (slide number, program) and how many
    ; worlds the slides asked for have
    def gltfFrom:string ""
    def gltfSrc:string ""
    def gltfWorlds:int 0
    def gltfNotes:[string]
    ; with DeckIn.scene: that slide's entities (PresScene.toJson), their
    ; outline, and the ids DeckIn.sceneSel finds (or why it is no selector)
    def scene:int -1
    def sceneJson:string ""
    def sceneLines:[string]
    def sceneFound:[string]
    def sceneSelError:string ""
    ; where that slide's script ends ({p, a}, as it gave it), "" for none
    def sceneFinal:string ""
    ; with DeckIn.strip: slide fxAt's display list at each of those times
    def strip:[string]
    def stripTimes:[double]
    ; the strip's slide's script file, "" for none
    def stripScript:string ""
}

class Check {
    ; pics: the slide backgrounds (bg=media/<name>) as /media/<name>, with
    ; their pixels for the contrast check; data is each one's bytes
    ; the faces the editor lays slides out with (web/main.js FACES, and the
    ; emoji face it adds when one is typed)
    sfn FACES:[string] () {
        return ([] _:string ("Open Sans" "Open Sans-Bold" "Open Sans-Italic" "Open Sans-BoldItalic" "Noto Sans" "Noto Sans-Bold" "Noto Emoji-Regular" "Gloria Hallelujah" "Fjalla One" "Josefin Sans-Bold" "Droid Serif" "Droid Serif-Bold" "Droid Serif-Italic" "Droid Serif-BoldItalic" "Lato" "Lato-Bold" "Lato-Italic" "Lato-BoldItalic"))
    }

    ; a file a chart reads, as text: this call's files, the deck's stored
    ; ones, a workbook's sheet by its CSV name, or (live) an https address;
    ; "" when there is none
    sfn dataText:string (host:McpHost din:DeckIn url:string) {
        def u:string (MdVegaRender.bareUrl(url))
        while (startsWith u "/") {
            u = (substring u 1 (strlen u))
        }
        if (startsWith u "https://") {
            if (din.live == false) {
                return ""
            }
            def got:MfJ (J.parse((host_fetch_text host u "text/csv, application/json, text/plain, */*" (Files.MAX_READ()))))
            if ((got.int_("status" 0)) == 200) {
                return (got.str_("body"))
            }
            return ""
        }
        for din.files f:Img fi {
            if (f.path == u) {
                return (host_text host f.handle)
            }
        }
        if ((strlen din.deckId) > 0) {
            if ((indexOf din.stored u) >= 0) {
                def got2:MfJ (J.parse((host_file_bytes host din.deckId u)))
                if ((strlen (host_error host)) > 0) {
                    host_clear_error host
                    return ""
                }
                return (host_text host (got2.int_("handle" 0)))
            }
        }
        ; a sheet of a workbook: data/<book>-<Sheet>.csv or data/<book>.csv
        def books:[string]
        def handles:[int]
        for din.files bf:Img bi {
            if (Files.isXlsx(bf.path)) {
                push books bf.path
                push handles bf.handle
            }
        }
        for din.stored sp:string si {
            if ((Files.isXlsx(sp)) && ((indexOf books sp) < 0)) {
                push books sp
                push handles 0
            }
        }
        for books bp:string bk {
            def base:string (substring bp 0 ((strlen bp) - 5))
            if ((u != (base + ".csv")) && ((startsWith u (base + "-")) == false)) {
                continue
            }
            def hd:int (itemAt handles bk)
            if (hd == 0) {
                def got3:MfJ (J.parse((host_file_bytes host din.deckId bp)))
                if ((strlen (host_error host)) > 0) {
                    host_clear_error host
                    continue
                }
                hd = (got3.int_("handle" 0))
            }
            def ts:Tables (Files.tables(host hd bp))
            for ts.list t:DataTable ti {
                if (Files.readsAs(t u)) {
                    def rows:[SheetRow]
                    def head (new SheetRow)
                    head.cells = t.columns
                    push rows head
                    for t.rows r:SheetRow ri {
                        push rows r
                    }
                    return (Files.toCsv(rows))
                }
            }
        }
        return ""
    }

    ; the files the charts read, handed over as the page hands them (twice:
    ; a chart kept in a file names its data only once the file is read)
    ; what the deck names that it does not have comes back, told to the deck
    ; too, so its tables say so in place of waiting for the file
    sfn chartData:[string] (host:McpHost din:DeckIn d:PresDeck) {
        def missing:[string]
        def tried:[string]
        def round:int 0
        while (round < 2) {
            def wanted:[string] (strsplit (d.chartDataWanted()) (strfromcode 10))
            for wanted w:string wi {
                def u:string (trim w)
                if (((strlen u) == 0) || ((indexOf tried u) >= 0)) {
                    continue
                }
                push tried u
                def body:string (Check.dataText(host din u))
                if ((strlen body) > 0) {
                    d.setChartData(u body)
                } {
                    ; a live address is read only where it is allowed; a
                    ; file of the deck that is not there is a mistake
                    if (((startsWith u "https://") == false) && ((startsWith u "http://") == false)) {
                        push missing u
                    }
                }
            }
            round = (round + 1)
        }
        for missing m:string mi {
            d.setChartDataMissing(m)
        }
        return missing
    }

    ; where each slide starts in md (its first source offset, -1 when it
    ; drew nothing), laid out as run lays it out, without the checks: what
    ; Work.rgr numbers merged edits and claims by
    sfn slideStarts:[int] (host:McpHost md:string css:string) {
        def d (new PresDeck)
        d.artAllowed = ((host_store_kind host) == "cloud")
        for (Check.FACES()) face:string fi {
            def fb:buffer (host_font host face)
            if ((buffer_length fb) > 0) {
                d.md.attachFont(face fb)
            }
        }
        if ((strlen css) > 0) {
            def own:string (d.useFonts(css))
            d.setTheme(own)
            d.md.setStyleSheet(own)
        }
        d.setText(md)
        def out:[int]
        def i:int 0
        while (i < (d.slideCount())) {
            def s:PresSlide (d.slideAt(i))
            push out s.srcStart
            i = (i + 1)
        }
        return out
    }

    ; The deck laid out as the player lays it out: the editor's faces, the
    ; theme's sheet, the pictures and the files its charts read. What could
    ; not be read goes to c.warnings.
    ; an SVG by its type or name, or (a file read back from the deck comes
    ; without its type, Tools.backgrounds) by its first bytes
    sfn isSvg:boolean (name:string type:string data:buffer) {
        if ((type == "image/svg+xml") || (endsWith (to_lowercase name) ".svg")) {
            return true
        }
        def n:int (buffer_length data)
        if (n > 256) {
            n = 256
        }
        def head:string (to_lowercase (buffer_to_string (buffer_slice data 0 n)))
        return ((indexOf head "<svg") >= 0)
    }

    ; the slide a `slide` argument names: a number from 1, or a title; -1
    ; when there is no such slide
    sfn slideIndex:int (a:MfJ titles:[string]) {
        def v:MfJ (a.field("slide"))
        if (v.kind == 2) {
            def n:int ((a.int_("slide" 0)) - 1)
            if ((n >= 0) && (n < (array_length titles))) {
                return n
            }
            return -1
        }
        if (v.kind == 3) {
            def want:string (to_lowercase (trim v.str))
            def num:int (?? (str2int want) 0)
            if ((num >= 1) && (num <= (array_length titles))) {
                return (num - 1)
            }
            for titles t:string i {
                if ((to_lowercase (trim t)) == want) {
                    return i
                }
            }
            for titles t2:string i2 {
                if (((strlen want) > 0) && ((indexOf (to_lowercase t2) want) >= 0)) {
                    return i2
                }
            }
        }
        return -1
    }

    ; Each slide's script run where it ends (__scriptFinal in CErXes,
    ; host_script_run): its frame kept as the slide's final state. One that
    ; does not run is said; without an engine the slides show the Markdown.
    sfn scriptFinals:void (host:McpHost din:DeckIn d:PresDeck c:Checked) {
        for (d.scriptKeys()) key:string ki {
            def pg:int (d.scriptPage(key))
            def s:PresSlide (d.slideAt(pg))
            def text:string (Check.dataText(host din s.script))
            if ((strlen text) == 0) {
                continue
            }
            def arg:string (Check.withTree((d.scriptTree(key)) (d.scriptFinalArgs(key))))
            def out:string (host_script_run host text "__scriptFinal" arg)
            if (out == "-") {
                continue
            }
            if (startsWith out "!") {
                push c.warnings (Guide.see(("Slide " + (to_string (pg + 1)) + ": script " + s.script + " does not run: " + (substring out 1 (strlen out))) "scripts"))
                continue
            }
            d.setScriptFinal(key out)
            def ro@(optional):PresScriptRun (d.scriptRun(key))
            if (!null? ro) {
                def off:int (PresScriptCheck.addsOutside(ro.final d.pageW d.pageH))
                if (off > 0) {
                    push c.warnings (Guide.see(("Slide " + (to_string (pg + 1)) + ": script " + s.script + ": " + (to_string off) + " shape(s) it adds are off the slide, which is " + (to_string (to_int (d.pageW + 0.5))) + " × " + (to_string (to_int (d.pageH + 0.5))) + " (presentation.activeSlide.width / height)") "scripts"))
                }
            }
        }
    }

    ; Slide i's script `t` seconds in (__scriptAt), drawn until
    ; d.clearScriptAt(): its build step then, its ticks run that long.
    sfn scriptAt:void (host:McpHost din:DeckIn d:PresDeck i:int t:double) {
        def key:string (d.scriptKeyOf(i))
        if ((strlen key) == 0) {
            return
        }
        def s:PresSlide (d.slideAt(i))
        def text:string (Check.dataText(host din s.script))
        if ((strlen text) == 0) {
            return
        }
        def o:JVal (JVal.mkObj())
        def step:int 0
        def k:int 1
        while (k <= s.steps) {
            if ((PresTimeline.stepTime(s k)) <= t) {
                step = k
            }
            k = (k + 1)
        }
        o.setInt("steps" step)
        o.setNum("time" t)
        def out:string (host_script_run host text "__scriptAt" (Check.withTree((d.scriptTree(key)) o)))
        if (((out != "-") && ((startsWith out "!") == false)) && ((strlen out) > 0)) {
            d.setScriptAt(key out)
        }
    }

    ; `args` (an object) with "tree" set to the JSON text `tree`
    sfn withTree:string (tree:string args:JVal) {
        def a:string (args.toJson())
        if ((strlen tree) == 0) {
            return a
        }
        if (a == "{}") {
            return ("{\"tree\":" + tree + "}")
        }
        return ("{\"tree\":" + tree + "," + (substring a 1 (strlen a)))
    }

    ; whether `file` is named by a slide's {script=…}
    sfn isScript:boolean (d:PresDeck file:string) {
        def i:int 0
        while (i < (d.slideCount())) {
            def s:PresSlide (d.slideAt(i))
            if ((MdVegaRender.resolveUrl(s.script)) == (MdVegaRender.resolveUrl(file))) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn baseName:string (path:string) {
        def at:int (lastIndexOf path "/")
        if (at < 0) {
            return path
        }
        return (substring path (at + 1) (strlen path))
    }

    sfn prepare:PresDeck (host:McpHost din:DeckIn c:Checked) {
        def d (new PresDeck)
        ; a cloud share opens with the PRO line art drawn
        ; (web/main.js liveAllowed: liveFromShare)
        d.artAllowed = ((host_store_kind host) == "cloud")
        for (Check.FACES()) face:string fi {
            def fb:buffer (host_font host face)
            if ((buffer_length fb) > 0) {
                if (d.md.attachFont(face fb)) {
                    set d.haveFaces face true
                }
            }
        }
        if ((strlen din.css) > 0) {
            def own2:string (d.useFonts(din.css))
            d.setTheme(own2)
            d.md.setStyleSheet(own2)
            c.laidOut = true
            if ((strlen d.fontNote) > 0) {
                push c.warnings (Guide.see(d.fontNote "css"))
            }
            ; every line of the sheet the slides do not use, and why
            d.lintCss(din.css)
            for d.cssNotes cn:string cni {
                push c.warnings (Guide.see(cn "css"))
            }
        }
        for din.pics pic:CheckPic pi {
            def data:buffer (itemAt din.data pi)
            ; an export gets an SVG picture as the editor's page hands it over
            ; (web/main.js addPicture): its PNG for the stage and the PDF's
            ; pixels, and the SVG itself with a small PNG for the vectors the
            ; PDF and the PPTX keep. The PDF and PPTX writers read PNG and JPEG
            ; only, so the SVG's own bytes were a picture left out.
            if (((strlen din.export) > 0) && (Check.isSvg(pic.name (itemAt din.types pi) data))) {
                def png:buffer (host_svg_png host data 2560)
                if ((buffer_length png) > 0) {
                    d.addImage(pic.name png "image/png" pic.w pic.h)
                    d.addSvgPicture(pic.name (buffer_to_string data) data (host_svg_png host data 800))
                    continue
                }
            }
            d.addImage(pic.name data (itemAt din.types pi) pic.w pic.h)
        }
        d.setText(din.md)
        for (Check.chartData(host din d)) gone:string gi {
            def lg:string (to_lowercase gone)
            ; a program's stylesheet beside it is optional
            if ((endsWith lg ".tsx.css") || (endsWith lg ".jsx.css")) {
                continue
            }
            if (((endsWith lg ".tsx") || (endsWith lg ".jsx")) && (Check.isScript(d gone))) {
                push c.warnings (Guide.see((gone + " is a slide's script ({script=" + gone + "}) but the presentation has no such file: send it with files, { \"name\": \"" + (Check.baseName(gone)) + "\", \"text\": \"…\" }.") "scripts"))
                continue
            }
            if ((endsWith lg ".tsx") || (endsWith lg ".jsx")) {
                push c.warnings (Guide.see((gone + " is the program of an app block but the presentation has no such file: send it with files, { \"name\": \"" + gone + "\", \"text\": \"…\" }.") "apps"))
                continue
            }
            push c.warnings (Guide.see((gone + " is read by a chart or table but the presentation has no such file. list_files lists the names its files are read by; add the file with files.") "data"))
        }
        return d
    }

    ; The 3-D worlds of the programs on slide `li` (its list `listJson`)
    ; drawn here (src/Pres3DStill.rgr) and handed to the painter by the
    ; names the list gives them, as the page draws them (web/three3d.js): in
    ; a room made of the slide's own picture, 96 x 54 as the page's.
    sfn worlds:void (host:McpHost din:DeckIn d:PresDeck li:int listJson:string c:Checked) {
        for (Check.drawWorlds(host din d li listJson c 960.0 1024.0)) wp:CheckWorldPic wpi {
            host_render_rgba host wp.src wp.rgba wp.w wp.h
        }
    }

    ; An export's 3-D worlds (PDF, PPTX, Word, web page): each drawn as on
    ; the page and kept as a PNG picture of the deck by its name, which the
    ; slide's list shows (PresPlayView.paintWorlds), so the file has the
    ; world, its see-through pixels kept. Given to the painter too, for the
    ; pictures the Word and web page exports take of the slides.
    sfn worldPictures:void (host:McpHost din:DeckIn d:PresDeck c:Checked) {
        def li:int 0
        while (li < (d.slideCount())) {
            def ws:PresSlide (d.slideAt(li))
            if ((((array_length din.only) == 0) || (PresExport.has(din.only li))) && ((array_length ws.plays) > 0)) {
                def groups:[int]
                d.still = true
                def listJson:string ((d.slideList(li groups 0.0)).toJson())
                d.still = false
                for (Check.drawWorlds(host din d li listJson c 1600.0 1600.0)) wp:CheckWorldPic wpi {
                    def png:buffer (Check.pngOf(wp.rgba wp.w wp.h))
                    d.addImage(wp.src png "image/png" wp.w wp.h)
                    host_render_rgba host wp.src wp.rgba wp.w wp.h
                }
            }
            li = (li + 1)
        }
    }

    ; RGBA pixels from the top as a PNG with its alpha.
    sfn pngOf:buffer (rgba:buffer w:int h:int) {
        def rb (new RasterBuffer())
        rb.width = w
        rb.height = h
        rb.pixels = rgba
        def enc (new PNGEncoder())
        enc.output = (new GrowableBuffer())
        enc.writeSignature()
        enc.writeIHDRColor(w h 6)
        enc.writeIDATRgba(rb)
        enc.writeIEND()
        return (enc.output.toBuffer())
    }

    ; The worlds of slide `li` drawn: `perSlide` pixels across a slide,
    ; at most `most` a side.
    sfn drawWorlds:[CheckWorldPic] (host:McpHost din:DeckIn d:PresDeck li:int listJson:string c:Checked perSlide:double most:double) {
        def out:[CheckWorldPic]
        def l:MdLayout (d.layout())
        def room:buffer (buffer_alloc 0)
        def roomDone:boolean false
        for (d.playUses()) pu:PresPlayUse pui {
            if (pu.page != li) {
                continue
            }
            def pv@(optional):PresPlayView (d.playView(pu.key))
            def bi:int (d.embedBox(pu.page pu.source))
            if ((null? pv) || (bi < 0)) {
                continue
            }
            def view:PresPlayView (unwrap pv)
            def b:MdBox (itemAt l.boxes bi)
            view.slideW = c.width
            view.slideH = c.height
            def got:JVal (view.scenesIn(b.x b.y b.w b.h))
            def si:int 0
            while (si < (got.len())) {
                if (roomDone == false) {
                    room = (host_render_room host listJson c.width c.height 96 54)
                    roomDone = true
                }
                def sc:JVal (got.at(si))
                ; the picture the slide's list shows (PresPlayView.paintWorlds):
                ; the whole slide, or the element's box when it clips
                def bx:double (sc.numOr("x" 0.0))
                def by:double (sc.numOr("y" 0.0))
                def bw:double (sc.numOr("w" 0.0))
                def bh:double (sc.numOr("h" 0.0))
                def rx:double 0.0
                def ry:double 0.0
                def rw:double c.width
                def rh:double c.height
                if (sc.boolOr("clip" false)) {
                    rx = bx
                    ry = by
                    rw = bw
                    rh = bh
                }
                ; as many pixels as the picture gets (`perSlide` a slide
                ; wide), at most `most` a side, both sides by one factor
                def k:double (perSlide / c.width)
                def big:double (rw * k)
                if ((rh * k) > big) {
                    big = (rh * k)
                }
                if (big > most) {
                    k = ((k * most) / big)
                }
                def iw:int (to_int ((rw * k) + 0.5))
                def ih:int (to_int ((rh * k) + 0.5))
                if (((iw > 0) && (ih > 0)) && ((bw > 0.0) && (bh > 0.0))) {
                    def st:Pres3DStill (new Pres3DStill())
                    if ((buffer_length room) == ((96 * 54) * 4)) {
                        st.setSlide(room 96 54)
                    }
                    def sjson:string ((sc.get("scene")).toJson())
                    Check.sceneFiles(host din sjson st.world.files)
                    def wp:CheckWorldPic (new CheckWorldPic())
                    wp.src = (sc.strOr("src" ""))
                    wp.rgba = (st.drawIn(sjson iw ih ((bx - rx) * k) ((by - ry) * k) (bw * k) (bh * k)))
                    wp.w = iw
                    wp.h = ih
                    push out wp
                }
                si = (si + 1)
            }
        }
        return out
    }

    ; The deck's .gltf files a world's <SliqGltf src> names, given to it
    ; ("" for one the deck does not have, which the world then says).
    sfn sceneFiles:void (host:McpHost din:DeckIn json:string files:P3Files) {
        def t:Pres3DTree (Pres3DTree.readWith(json files))
        for t.missing name:string ni {
            files.setFile(name (Check.dataText(host din name)))
        }
    }

    sfn run:Checked (host:McpHost din:DeckIn) {
        def md:string din.md
        def pics:[CheckPic] din.pics
        def c (new Checked)
        def d:PresDeck (Check.prepare(host din c))
        c.width = d.pageW
        c.height = d.pageH
        c.slides = (d.slideCount())
        def lay:MdLayout (d.layout())
        c.splitLevel = lay.splitLevel
        def ti:int 0
        while (ti < c.slides) {
            def ts:PresSlide (d.slideAt(ti))
            push c.titles ts.title
            push c.starts ts.srcStart
            ti = (ti + 1)
        }
        ; each program of an app block tried in the engine the page runs it
        ; in: one that does not run says why here, not as a blank box
        for (d.playUses()) pu:PresPlayUse pui {
            def ptext:string (Check.dataText(host din pu.spec.src))
            if ((strlen ptext) == 0) {
                continue
            }
            ; the slides drawn here (render_slide, render_overview) show the
            ; program's picture as the page does, its first frames' tree; so
            ; does the glTF export, which writes its world
            ; a PDF, PPTX, Word or web page export too: the program's picture
            ; and its 3-D worlds, not the fence's plate (Check.worldPictures)
            def drawn:boolean ((din.lists && ((strlen din.export) == 0)) || ((strlen din.export) > 0))
            def why:string ""
            def ptree:string ""
            if drawn {
                def ran:MfJ (J.parse((host_app_run host ptext pu.spec.width pu.spec.height)))
                why = (ran.str_("why"))
                ptree = (ran.str_("tree"))
            } {
                why = (host_app_check host ptext pu.spec.width pu.spec.height)
            }
            if (((strlen why) > 0) && (why != "-")) {
                push c.warnings (Guide.see(("Slide " + (to_string (pu.page + 1)) + ": " + pu.spec.src + " does not run: " + why) "apps"))
            }
            ; its stylesheet's rules the layout does not take
            def ptcss:string (Check.dataText(host din pu.spec.css))
            if ((strlen ptree) > 0) {
                def pv@(optional):PresPlayView (d.playView(pu.key))
                if (!null? pv) {
                    def view:PresPlayView (unwrap pv)
                    if ((strlen ptcss) > 0) {
                        view.setCss(ptcss)
                    }
                    view.setTree(ptree)
                }
            }
            if ((strlen ptcss) > 0) {
                def psheet:EVGStyleSheet (new EVGStyleSheet())
                psheet.parse(ptcss)
                for psheet.errors perr:string pei {
                    push c.warnings (Guide.see(("Slide " + (to_string (pu.page + 1)) + ": " + pu.spec.css + ": " + perr) "apps"))
                }
            }
        }
        ; each slide's script run to where it ends, in the engine the page
        ; runs it in: what the PDF, the PPTX and the pictures show
        Check.scriptFinals(host din d c)
        ; a slide that runs over goes on in untitled slides after it
        def i:int 0
        while (i < c.slides) {
            def s:PresSlide (d.slideAt(i))
            def j:int (i + 1)
            while ((j < c.slides) && ((strlen ((d.slideAt(j)).title)) == 0)) {
                j = (j + 1)
            }
            if ((c.laidOut && (j > (i + 1))) && ((strlen s.title) > 0)) {
                def more:int (j - (i + 1))
                def what:string "slide"
                if (more > 1) {
                    what = "slides"
                }
                push c.warnings (Guide.see(("Slide \"" + s.title + "\" does not fit and goes on over " + more + " more " + what + ": shorten it or split it with a ## heading.") "layout"))
            }
            i = j
        }
        def l:MdLayout (d.layout())
        for l.embeds.entries e:MdEmbedEntry k {
            def where:string ""
            def at:int (indexOf md e.source)
            if (at >= 0) {
                def page:int (d.pageOfOffset(at))
                if ((page >= 0) && (page < c.slides)) {
                    def t:string ((d.slideAt(page)).title)
                    if ((strlen t) > 0) {
                        where = (" on slide \"" + t + "\"")
                    } {
                        where = (" on slide " + (page + 1))
                    }
                    ; a page that holds several sections: the block's own
                    def under:string (Check.headingBefore(md at))
                    if (((strlen under) > 0) && (under != t)) {
                        where = (where + ", under \"" + under + "\"")
                    }
                }
            }
            if e.ok {
                ; drawn, but with a field its data does not have: an empty
                ; frame where the bars should be
                for e.warnings w:string wi {
                    push c.warnings (Guide.see(("The " + e.kind + " block" + where + ": " + w + ".") (Guide.topicOfKind(e.kind))))
                }
                continue
            }
            def why:string e.note
            if ((strlen why) == 0) {
                why = "it could not be drawn"
            }
            push c.warnings (Guide.see(("The " + e.kind + " block" + where + " is not shown: " + why + ".") (Guide.topicOfKind(e.kind))))
        }
        for (d.smartArtNotes()) note:string ni {
            push c.warnings (Guide.see(note "smartart"))
        }
        for (d.chartStyleNotes()) csn:string csi {
            push c.warnings (Guide.see(csn "charts"))
        }
        ; a heading key one character from one Sliqtly knows: kept as the
        ; slide's own data, which is not what `{transtion=fade}` meant
        c.deckData = (d.deckMeta().asText())
        for (d.slideMetaWarnings()) smw:string smi {
            push c.warnings (Guide.see(smw "layout"))
        }
        ; the deck's own effects (```fx, the theme's @effect) that did not
        ; compile: the slide that names one draws none
        for (d.fxNotes()) fxn:string fxi {
            push c.warnings (Guide.see(fxn "effects"))
        }
        def fxCost:string (d.fx.costText())
        if ((strlen fxCost) > 0) {
            push c.warnings fxCost
        }
        for (d.htmlNotes()) hn:string hi {
            push c.warnings (Guide.see(hn "text"))
        }
        if c.laidOut {
            Check.ownEffects(host c d pics)
            Check.contrast(c d l pics md)
            def noStills:[int]
            d.fxStills = noStills
            d.still = true
            for (Layout.slides(d md)) rs:RSlide ri {
                push c.report (Report.slide(rs))
            }
            if din.lists {
                c.fxPrograms = (d.fx.programsJson())
                if (din.fxTime >= 0.0) {
                    PresTimeline.planAll(d)
                }
                if (((din.fxTime >= 0.0) || ((array_length din.strip) > 0)) || (din.stripCount > 0)) {
                    PresTimeline.planAll(d)
                }
                def li:int 0
                while (li < c.slides) {
                    def groups:[int]
                    def timed:boolean ((li == din.fxAt) && (din.fxTime >= 0.0))
                    if timed {
                        d.fxClockAt = din.fxTime
                        Check.scriptAt(host din d li din.fxTime)
                    }
                    def sl:EVGDisplayList (d.slideList(li groups 0.0))
                    d.fxClockAt = -1.0
                    d.clearScriptAt()
                    def slj:string (sl.toJson())
                    push c.lists slj
                    Check.worlds(host din d li slj c)
                    li = (li + 1)
                }
                if ((din.fxAt >= 0) && (din.fxAt < c.slides)) {
                    c.stripTimes = din.strip
                    def stripSlide:PresSlide (d.slideAt(din.fxAt))
                    c.stripScript = stripSlide.script
                    if (((array_length c.stripTimes) == 0) && (din.stripCount > 0)) {
                        PresTimeline.planAll(d)
                        def ss:PresSlide (d.slideAt(din.fxAt))
                        def secs:double ss.duration
                        if (ss.exportFrame >= 0.0) {
                            secs = ss.exportFrame
                        }
                        if (secs > 20.0) {
                            secs = 20.0
                        }
                        def sn:int din.stripCount
                        def sk:int 0
                        while (sk < sn) {
                            if (sn == 1) {
                                push c.stripTimes secs
                            } {
                                push c.stripTimes (((to_double sk) * secs) / (to_double (sn - 1)))
                            }
                            sk = (sk + 1)
                        }
                    }
                    for c.stripTimes st:double sti {
                        def sg:[int]
                        d.fxClockAt = st
                        Check.scriptAt(host din d din.fxAt st)
                        def sdl:EVGDisplayList (d.slideList(din.fxAt sg 0.0))
                        d.fxClockAt = -1.0
                        d.clearScriptAt()
                        push c.strip (sdl.toJson())
                    }
                }
            }
            d.still = false
            ; a selector in a slide's script that finds nothing on its slide
            ; (a missing file is said above)
            for (d.scriptNotes()) sn:string sni {
                if ((indexOf sn ": no file ") < 0) {
                    push c.warnings (Guide.see(sn "scripts"))
                }
            }
            if ((din.sceneOf.field("slide")).kind != 0) {
                c.scene = (Check.slideIndex(din.sceneOf c.titles))
            }
            if (c.scene >= 0) {
                def sc:PresScene (d.sceneOfSlide(c.scene))
                c.sceneJson = (sc.toJson())
                def sk:string (d.scriptKeyOf(c.scene))
                if ((strlen sk) > 0) {
                    def sro@(optional):PresScriptRun (d.scriptRun(sk))
                    if (!null? sro) {
                        def srun:PresScriptRun (unwrap sro)
                        c.sceneFinal = srun.finalJson
                    }
                }
                c.sceneLines = (sc.outline(false))
                if ((strlen din.sceneSel) > 0) {
                    def ps:PresSel (PresSel.parse(din.sceneSel))
                    c.sceneSelError = ps.error
                    if ((strlen ps.error) == 0) {
                        for (ps.find(sc.ents 0)) fat:int fai {
                            def fe:PresEnt (sc.at(fat))
                            push c.sceneFound fe.id
                        }
                    }
                }
            }
            ; a deck with `@media print` rules: what the printing house would
            ; say about the pages it gets (PrintReport)
            if (d.hasPrint()) {
                d.setMedia("print")
                for (PrintReport.notes((Layout.printPages(d)))) pn:string pni {
                    push c.warnings (Guide.see(pn "export"))
                }
                d.setMedia("screen")
            }
        }
        if ((strlen din.export) > 0) {
            if (din.export != "gltf") {
                Check.worldPictures(host din d c)
            }
            def ex (new PresExport())
            ex.deck = d
            ex.only = din.only
            if (din.export == "pdf") {
                c.file = (ex.pdf())
            }
            if (din.export == "pptx") {
                Check.bgStills(host din ex d)
                c.file = (ex.pptx())
            }
            if (din.export == "docx") {
                Check.shots(host ex d)
                c.file = (ex.docx())
            }
            if (din.export == "html") {
                Check.shots(host ex d)
                c.file = (PptxWriter.utf8((ex.html())))
            }
            if (din.export == "gltf") {
                Check.gltf(host d din c)
            }
        }
        return c
    }

    ; export "gltf": the first 3-D world of the slides asked for (a
    ; program's <scene3d> at its first frames, as render_slide draws it)
    ; as a glTF 2.0 file (src/Pres3DGltf.rgr)
    sfn gltf:void (host:McpHost d:PresDeck din:DeckIn c:Checked) {
        def l:MdLayout (d.layout())
        def li:int 0
        while (li < c.slides) {
            if (((array_length din.only) == 0) || (PresExport.has(din.only li))) {
                def groups:[int]
                d.slideList(li groups 0.0)
                for (d.playUses()) pu:PresPlayUse pui {
                    if (pu.page != li) {
                        continue
                    }
                    def pv@(optional):PresPlayView (d.playView(pu.key))
                    def bi:int (d.embedBox(pu.page pu.source))
                    if ((null? pv) || (bi < 0)) {
                        continue
                    }
                    def view:PresPlayView (unwrap pv)
                    def b:MdBox (itemAt l.boxes bi)
                    def got:JVal (view.scenesIn(b.x b.y b.w b.h))
                    def si:int 0
                    while (si < (got.len())) {
                        def sc:JVal (got.at(si))
                        if (((strlen c.gltfFrom) == 0) && ((sc.numOr("h" 0.0)) > 0.0)) {
                            def g:Pres3DGltf (new Pres3DGltf())
                            def gjson:string ((sc.get("scene")).toJson())
                            Check.sceneFiles(host din gjson g.world.files)
                            def text:string (g.build(gjson ((sc.numOr("w" 0.0)) / (sc.numOr("h" 0.0)))))
                            if ((strlen text) > 0) {
                                c.file = (PptxWriter.utf8(text))
                                c.gltfFrom = ("slide " + (to_string (li + 1)))
                                c.gltfSrc = pu.spec.src
                                if ((strlen g.error) > 0) {
                                    push c.gltfNotes g.error
                                }
                            }
                        }
                        c.gltfWorlds = (c.gltfWorlds + 1)
                        si = (si + 1)
                    }
                }
            }
            li = (li + 1)
        }
    }

    ; A slide's own picture (`bg=`) for the PPTX: the slide's background
    ; drawn as the stage cuts and dims it, as web/main.js renderFxStills
    ; draws it in the editor (PresApp.bgSlidesJson: slides with no effect),
    ; and PresExport.pptx makes it the slide's background picture.
    sfn bgStills:void (host:McpHost din:DeckIn ex:PresExport d:PresDeck) {
        for din.pics pic:CheckPic pi {
            host_render_pic host pic.name (itemAt din.data pi)
        }
        d.still = true
        def i:int 0
        while (i < (d.slideCount())) {
            def s:PresSlide (d.slideAt(i))
            def wanted:boolean (((array_length din.only) == 0) || (PresExport.has(din.only i)))
            if ((wanted && ((strlen s.bg) > 0)) && ((strlen s.fx) == 0)) {
                def jpeg:buffer (host_render_still host ((d.fxOnlyList(i)).toJson()) d.pageW d.pageH 1600)
                if ((buffer_length jpeg) > 0) {
                    push ex.stillIdx i
                    push ex.stillRgba (buffer_alloc 0)
                    push ex.stillW 0
                    push ex.stillH 0
                    push ex.stillJpeg jpeg
                }
            }
            i = (i + 1)
        }
        d.still = false
    }

    ; The Word and web page exports' pictures of what only the stage draws
    ; (diagrams, charts, SmartArt; PresDocx): each block's rectangle of its
    ; slide at rest, drawn here as the editor draws it in WebGL.
    sfn shots:void (host:McpHost ex:PresExport d:PresDeck) {
        ex.docxShots()
        ; the deck's own effects drawn in the pictures too, at their still
        host_render_fx host (d.fx.programsJson()) -1.0
        for ex.word.shots s:PresDocxShot si {
            def dl:EVGDisplayList (ex.word.shotList(d s.key))
            ; sharp enough for a page-wide picture
            def px:int (to_int ((s.w * 2.0) + 0.5))
            if (px > 1400) {
                px = 1400
            }
            def png:buffer (host_render_crop host (dl.toJson()) d.pageW d.pageH s.x s.y s.w s.h px)
            if ((buffer_length png) > 0) {
                ex.word.setShot(s.key png px (to_int ((((to_double px) * s.h) / s.w) + 0.5)))
            }
        }
        host_render_fx host "" -1.0
    }

    ; per command of the slide list just drawn: true for text struck through
    ; (`~~…~~`, `<s>`, `<del>`) and the "[alt]" standing in for a picture
    ; with no bytes, which the layout draws muted on purpose
    sfn struck:[boolean] (d:PresDeck l:MdLayout n:int) {
        def out:[boolean]
        def owner:[int] d.boxOfCmd
        def i:int 0
        while (i < n) {
            def q:boolean false
            if (i < (array_length owner)) {
                def ob:int (itemAt owner i)
                if ((ob >= 0) && (ob < (array_length l.boxes))) {
                    def b:MdBox (itemAt l.boxes ob)
                    q = (b.strike || b.quiet)
                }
            }
            push out q
            i = (i + 1)
        }
        return out
    }

    ; which commands a chart or a diagram drew (its box is an embed)
    sfn inDrawing:[boolean] (d:PresDeck l:MdLayout n:int) {
        def out:[boolean]
        def owner:[int] d.boxOfCmd
        def i:int 0
        while (i < n) {
            def q:boolean false
            if (i < (array_length owner)) {
                def ob:int (itemAt owner i)
                if ((ob >= 0) && (ob < (array_length l.boxes))) {
                    def b:MdBox (itemAt l.boxes ob)
                    q = (b.kind == 3)
                }
            }
            push out q
            i = (i + 1)
        }
        return out
    }

    ; text that does not stand out from what it is drawn over, slide by
    ; slide, as the editor's painter judges it
    ; A text command's box is its slot (a centred letter's is the width of
    ; the disc it sits on, from where the letter starts); the judge samples
    ; what is under the letters, so each run gets the width its face draws
    ; it (as Layout.rgr measures runs), from where it starts.
    sfn toInk:void (list:EVGDisplayList l:MdLayout) {
        for list.cmds c:EVGDrawCmd ci {
            if ((c.kind == 3) && ((strlen (trim c.text)) > 0)) {
                def mw:EVGTextMetrics (l.engine.measureRunSpaced(c.text c.fontFamily c.fontSize c.letterSpacing))
                if ((mw.width > 0.0) && (mw.width < c.w)) {
                    c.w = mw.width
                }
            }
        }
    }

    ; Each run that is a drawing's own text gets the heading it is under,
    ; when the slide has more than one (an editorial page holds several
    ; sections, and the slide's title is only the first).
    sfn sections:void (low:[LowRun] rs:RSlide) {
        def ys:[double]
        def names:[string]
        for rs.blocks b:RBlock bi {
            if (b.kind == "heading") {
                def t:string ""
                for b.runs r:RRun ri {
                    if ((strlen t) > 0) {
                        t = (t + " ")
                    }
                    t = (t + (trim r.text))
                }
                push ys b.y
                push names t
            }
        }
        if ((array_length names) < 2) {
            return
        }
        for low lr:LowRun li {
            if lr.inDrawing {
                def k:int 0
                while (k < (array_length ys)) {
                    if ((itemAt ys k) <= (lr.y + 0.5)) {
                        lr.section = (itemAt names k)
                    }
                    k = (k + 1)
                }
            }
        }
    }

    ; The heading a place in the source is under: the last heading line
    ; before `at`, fenced code skipped. "" when there is none.
    sfn headingBefore:string (md:string at:int) {
        def lines:[string] (strsplit (substring md 0 at) "\n")
        def fence:boolean false
        def found:string ""
        for lines ln:string i {
            def t:string (trim ln)
            if ((startsWith t "```") || (startsWith t "~~~")) {
                fence = (! fence)
                continue
            }
            if ((fence == false) && (startsWith t "#")) {
                def k:int 0
                while ((k < (strlen t)) && ((charAt t k) == 35)) {
                    k = (k + 1)
                }
                if ((k <= 6) && ((k < (strlen t)) && ((charAt t k) == 32))) {
                    def h:string (trim (substring t k (strlen t)))
                    ; the heading's attributes, `{bg=…}`, are not its name
                    def brace:int (indexOf h " {")
                    if (brace > 0) {
                        h = (trim (substring h 0 brace))
                    }
                    found = h
                }
            }
        }
        return found
    }

    ; The deck's own effects as a reader sees them (mcp-go/fxvm.go): a slide
    ; whose own effect is under its text gets that effect's still as the
    ; picture the contrast check samples (PresDeck.fxStills, cleared after
    ; the check); an effect that flashes more than 3 times a second over a
    ; large part of the slide, and a backdrop or filter that lets the slide
    ; through, are said. Effects on blocks (`{fx=…}`) are in the slide's
    ; list with the slide's own.
    sfn ownEffects:void (host:McpHost c:Checked d:PresDeck pics:[CheckPic]) {
        if ((array_length d.fx.effects) == 0) {
            return
        }
        host_render_fx host (d.fx.programsJson()) -1.0
        d.still = true
        def i:int 0
        while (i < c.slides) {
            def s:PresSlide (d.slideAt(i))
            def groups:[int]
            def sl:string ((d.slideList(i groups 0.0)).toJson())
            for (host_fx_notes host sl d.pageW d.pageH) note:string ni {
                ; "the effect … flashes" is the slide's; "The backdrop
                ; effect …" the effect's, said once
                def w:string (Guide.see(note "effects"))
                if ((indexOf note "the ") == 0) {
                    w = (Guide.see(("Slide " + (to_string (i + 1)) + ": " + note) "effects"))
                }
                if ((Check.hasLine(c.warnings w)) == false) {
                    push c.warnings w
                }
            }
            def own@(optional):FxEffect (d.ownEffect(s.fx))
            if (!null? own) {
                def e:FxEffect (unwrap own)
                if (e.layer == "source") {
                    def g:[int] (host_fx_grid host ((d.fxOnlyList(i)).toJson()) d.pageW d.pageH)
                    if ((array_length g) > 2) {
                        def pic (new CheckPic())
                        pic.name = (PresDeck.fxStillPath(i))
                        pic.w = (itemAt g 0)
                        pic.h = (itemAt g 1)
                        def k:int 2
                        while (k < (array_length g)) {
                            push pic.grid (itemAt g k)
                            k = (k + 1)
                        }
                        push pics pic
                        push d.fxStills i
                    }
                }
            }
            i = (i + 1)
        }
        d.still = false
        def rep:string (host_fx_report host)
        if ((strlen rep) > 0) {
            for (strsplit rep "\n") rl:string rli {
                push c.warnings (Guide.see(rl "effects"))
            }
        }
        host_render_fx host "" -1.0
    }

    sfn hasLine:boolean (lines:[string] s:string) {
        for lines l:string li {
            if (l == s) {
                return true
            }
        }
        return false
    }

    sfn contrast:void (c:Checked d:PresDeck l:MdLayout pics:[CheckPic] md:string) {
        d.still = true
        def skip:[string]
        for l.embeds.entries e:MdEmbedEntry k {
            if (e.ok == false) {
                push skip e.note
                ; the slide shows the note under its kind (MdLayout's stand-in)
                push skip ("⚠ " + e.kind + ": " + e.note)
            }
        }
        def i:int 0
        while (i < c.slides) {
            def groups:[int]
            def list:EVGDisplayList (d.slideList(i groups 0.0))
            Check.toInk(list l)
            def quiet:[boolean] (Check.struck(d l (array_length list.cmds)))
            def drawn:[boolean] (Check.inDrawing(d l (array_length list.cmds)))
            def low:[LowRun] (Contrast.lowRuns(list pics "" -1.0 skip quiet drawn))
            if ((array_length low) > 0) {
                Check.sections(low (Layout.slide(d md i)))
                def s:PresSlide (d.slideAt(i))
                def bgSrc:string ""
                def hasBg:boolean false
                if (((strlen s.bg) > 0) && l.haveImages) {
                    bgSrc = (l.images.resolve(s.bg l.docDir))
                    for pics p:CheckPic pk {
                        if ((p.name == bgSrc) && ((array_length p.grid) > 0)) {
                            hasBg = true
                        }
                    }
                }
                ; the least dim, in steps of 0.05, that makes every run read
                def dimFix:double -1.0
                if hasBg {
                    def step:int ((floor (s.bgDim * 20.0)) + 1)
                    while ((step <= 18) && (dimFix < 0.0)) {
                        def dim:double ((to_double step) / 20.0)
                        if ((array_length (Contrast.lowRuns(list pics bgSrc dim skip quiet drawn))) == 0) {
                            dimFix = dim
                        }
                        step = (step + 1)
                    }
                }
                for (Contrast.notes(s.title i low hasBg dimFix)) cn:string cni {
                    push c.warnings (Guide.see(cn "layout"))
                }
            }
            i = (i + 1)
        }
        d.still = false
    }
}
