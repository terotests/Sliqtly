; The deck read by the editor's own model (src/PresDeck.rgr, linked into
; Ranger as gallery/presentation): the slides as the player lays them out,
; and the charts and diagrams it could not draw, so a model hears about them
; before anyone opens the link.

Import "McpHost.rgr"
Import "../presentation/PresDeck.rgr"
Import "Contrast.rgr"
Import "Files.rgr"
Import "Layout.rgr"
Import "../presentation/PresExport.rgr"

; what a deck is checked with
class DeckIn {
    def md:string ""
    def css:string ""
    ; the pictures the deck names, as /media/<name>, with their bytes and
    ; types; a picture's grid is what the contrast check samples
    def pics:[CheckPic]
    def data:[buffer]
    def types:[string]
    ; this call's data files (path data/<name>, bytes behind the handle)
    def files:[Img]
    ; the stored deck whose files a chart may read, and their paths
    def deckId:string ""
    def stored:[string]
    ; charts read https data too (a live CSV, a Google Sheet)
    def live:boolean false
    ; keep each slide's display list as JSON, for drawing it
    def lists:boolean false
    ; "pdf", "pptx", "docx" or "html": the deck exported as that file (Checked.file), only
    ; the slides in `only` (0 = first) when it is not empty
    def export:string ""
    def only:[int]
}

class Checked {
    ; the theme's sheet was there: without it the slide count is not the
    ; player's (the sheet says which headings start a slide)
    def laidOut:boolean false
    def slides:int 0
    ; each slide's title, as the player numbers them
    def titles:[string]
    ; where each slide starts in the Markdown (-1: it drew nothing)
    def starts:[int]
    ; the heading level that starts a slide (`deck { split-level }`)
    def splitLevel:int 2
    def warnings:[string]
    ; the layout report, slide by slide
    def report:[RSlideOut]
    ; with DeckIn.lists: each slide's display list as JSON
    def lists:[string]
    def width:double 960.0
    def height:double 540.0
    ; with DeckIn.export: the file
    def file:buffer (buffer_from_string "")
}

class Check {
    ; pics: the slide backgrounds (bg=media/<name>) as /media/<name>, with
    ; their pixels for the contrast check; data is each one's bytes
    ; the faces the editor lays slides out with (web/main.js FACES, and the
    ; emoji face it adds when one is typed)
    sfn FACES:[string] () {
        return ([] _:string ("Open Sans" "Open Sans-Bold" "Open Sans-Italic" "Open Sans-BoldItalic" "Noto Sans" "Noto Sans-Bold" "Noto Emoji-Regular" "Gloria Hallelujah" "Fjalla One" "Josefin Sans-Bold" "Droid Serif" "Droid Serif-Bold" "Droid Serif-Italic" "Droid Serif-BoldItalic" "Lato" "Lato-Bold" "Lato-Italic" "Lato-BoldItalic"))
    }

    ; a file a chart reads, as text: this call's files, the deck's stored
    ; ones, a workbook's sheet by its CSV name, or (live) an https address;
    ; "" when there is none
    sfn dataText:string (host:McpHost din:DeckIn url:string) {
        def u:string (MdVegaRender.bareUrl(url))
        while (startsWith u "/") {
            u = (substring u 1 (strlen u))
        }
        if (startsWith u "https://") {
            if (din.live == false) {
                return ""
            }
            def got:MfJ (J.parse((host_fetch_text host u "text/csv, application/json, text/plain, */*" (Files.MAX_READ()))))
            if ((got.int_("status" 0)) == 200) {
                return (got.str_("body"))
            }
            return ""
        }
        for din.files f:Img fi {
            if (f.path == u) {
                return (host_text host f.handle)
            }
        }
        if ((strlen din.deckId) > 0) {
            if ((indexOf din.stored u) >= 0) {
                def got2:MfJ (J.parse((host_file_bytes host din.deckId u)))
                if ((strlen (host_error host)) > 0) {
                    host_clear_error host
                    return ""
                }
                return (host_text host (got2.int_("handle" 0)))
            }
        }
        ; a sheet of a workbook: data/<book>-<Sheet>.csv or data/<book>.csv
        def books:[string]
        def handles:[int]
        for din.files bf:Img bi {
            if (Files.isXlsx(bf.path)) {
                push books bf.path
                push handles bf.handle
            }
        }
        for din.stored sp:string si {
            if ((Files.isXlsx(sp)) && ((indexOf books sp) < 0)) {
                push books sp
                push handles 0
            }
        }
        for books bp:string bk {
            def base:string (substring bp 0 ((strlen bp) - 5))
            if ((u != (base + ".csv")) && ((startsWith u (base + "-")) == false)) {
                continue
            }
            def hd:int (itemAt handles bk)
            if (hd == 0) {
                def got3:MfJ (J.parse((host_file_bytes host din.deckId bp)))
                if ((strlen (host_error host)) > 0) {
                    host_clear_error host
                    continue
                }
                hd = (got3.int_("handle" 0))
            }
            def ts:Tables (Files.tables(host hd bp))
            for ts.list t:DataTable ti {
                if (Files.readsAs(t u)) {
                    def rows:[SheetRow]
                    def head (new SheetRow)
                    head.cells = t.columns
                    push rows head
                    for t.rows r:SheetRow ri {
                        push rows r
                    }
                    return (Files.toCsv(rows))
                }
            }
        }
        return ""
    }

    ; the files the charts read, handed over as the page hands them (twice:
    ; a chart kept in a file names its data only once the file is read)
    ; what the deck names that it does not have comes back, told to the deck
    ; too, so its tables say so in place of waiting for the file
    sfn chartData:[string] (host:McpHost din:DeckIn d:PresDeck) {
        def missing:[string]
        def tried:[string]
        def round:int 0
        while (round < 2) {
            def wanted:[string] (strsplit (d.chartDataWanted()) (strfromcode 10))
            for wanted w:string wi {
                def u:string (trim w)
                if (((strlen u) == 0) || ((indexOf tried u) >= 0)) {
                    continue
                }
                push tried u
                def body:string (Check.dataText(host din u))
                if ((strlen body) > 0) {
                    d.setChartData(u body)
                } {
                    ; a live address is read only where it is allowed; a
                    ; file of the deck that is not there is a mistake
                    if (((startsWith u "https://") == false) && ((startsWith u "http://") == false)) {
                        push missing u
                    }
                }
            }
            round = (round + 1)
        }
        for missing m:string mi {
            d.setChartDataMissing(m)
        }
        return missing
    }

    ; where each slide starts in md (its first source offset, -1 when it
    ; drew nothing), laid out as run lays it out, without the checks: what
    ; Work.rgr numbers merged edits and claims by
    sfn slideStarts:[int] (host:McpHost md:string css:string) {
        def d (new PresDeck)
        d.artAllowed = ((host_store_kind host) == "cloud")
        for (Check.FACES()) face:string fi {
            def fb:buffer (host_font host face)
            if ((buffer_length fb) > 0) {
                d.md.attachFont(face fb)
            }
        }
        if ((strlen css) > 0) {
            def own:string (d.useFonts(css))
            d.setTheme(own)
            d.md.setStyleSheet(own)
        }
        d.setText(md)
        def out:[int]
        def i:int 0
        while (i < (d.slideCount())) {
            def s:PresSlide (d.slideAt(i))
            push out s.srcStart
            i = (i + 1)
        }
        return out
    }

    ; The deck laid out as the player lays it out: the editor's faces, the
    ; theme's sheet, the pictures and the files its charts read. What could
    ; not be read goes to c.warnings.
    ; an SVG by its type or name, or (a file read back from the deck comes
    ; without its type, Tools.backgrounds) by its first bytes
    sfn isSvg:boolean (name:string type:string data:buffer) {
        if ((type == "image/svg+xml") || (endsWith (to_lowercase name) ".svg")) {
            return true
        }
        def n:int (buffer_length data)
        if (n > 256) {
            n = 256
        }
        def head:string (to_lowercase (buffer_to_string (buffer_slice data 0 n)))
        return ((indexOf head "<svg") >= 0)
    }

    sfn prepare:PresDeck (host:McpHost din:DeckIn c:Checked) {
        def d (new PresDeck)
        ; a cloud share opens with the PRO line art drawn
        ; (web/main.js liveAllowed: liveFromShare)
        d.artAllowed = ((host_store_kind host) == "cloud")
        for (Check.FACES()) face:string fi {
            def fb:buffer (host_font host face)
            if ((buffer_length fb) > 0) {
                if (d.md.attachFont(face fb)) {
                    set d.haveFaces face true
                }
            }
        }
        if ((strlen din.css) > 0) {
            def own2:string (d.useFonts(din.css))
            d.setTheme(own2)
            d.md.setStyleSheet(own2)
            c.laidOut = true
            if ((strlen d.fontNote) > 0) {
                push c.warnings d.fontNote
            }
            ; every line of the sheet the slides do not use, and why
            d.lintCss(din.css)
            for d.cssNotes cn:string cni {
                push c.warnings cn
            }
        }
        for din.pics pic:CheckPic pi {
            def data:buffer (itemAt din.data pi)
            ; an export gets an SVG picture as the editor's page hands it over
            ; (web/main.js addPicture): its PNG for the stage and the PDF's
            ; pixels, and the SVG itself with a small PNG for the vectors the
            ; PDF and the PPTX keep. The PDF and PPTX writers read PNG and JPEG
            ; only, so the SVG's own bytes were a picture left out.
            if (((strlen din.export) > 0) && (Check.isSvg(pic.name (itemAt din.types pi) data))) {
                def png:buffer (host_svg_png host data 2560)
                if ((buffer_length png) > 0) {
                    d.addImage(pic.name png "image/png" pic.w pic.h)
                    d.addSvgPicture(pic.name (buffer_to_string data) data (host_svg_png host data 800))
                    continue
                }
            }
            d.addImage(pic.name data (itemAt din.types pi) pic.w pic.h)
        }
        d.setText(din.md)
        for (Check.chartData(host din d)) gone:string gi {
            push c.warnings (gone + " is read by a chart or table but the presentation has no such file. list_files lists the names its files are read by; add the file with files.")
        }
        return d
    }

    sfn run:Checked (host:McpHost din:DeckIn) {
        def md:string din.md
        def pics:[CheckPic] din.pics
        def c (new Checked)
        def d:PresDeck (Check.prepare(host din c))
        c.width = d.pageW
        c.height = d.pageH
        c.slides = (d.slideCount())
        def lay:MdLayout (d.layout())
        c.splitLevel = lay.splitLevel
        def ti:int 0
        while (ti < c.slides) {
            def ts:PresSlide (d.slideAt(ti))
            push c.titles ts.title
            push c.starts ts.srcStart
            ti = (ti + 1)
        }
        ; a slide that runs over goes on in untitled slides after it
        def i:int 0
        while (i < c.slides) {
            def s:PresSlide (d.slideAt(i))
            def j:int (i + 1)
            while ((j < c.slides) && ((strlen ((d.slideAt(j)).title)) == 0)) {
                j = (j + 1)
            }
            if ((c.laidOut && (j > (i + 1))) && ((strlen s.title) > 0)) {
                def more:int (j - (i + 1))
                def what:string "slide"
                if (more > 1) {
                    what = "slides"
                }
                push c.warnings ("Slide \"" + s.title + "\" does not fit and goes on over " + more + " more " + what + ": shorten it or split it with a ## heading.")
            }
            i = j
        }
        def l:MdLayout (d.layout())
        for l.embeds.entries e:MdEmbedEntry k {
            def where:string ""
            def at:int (indexOf md e.source)
            if (at >= 0) {
                def page:int (d.pageOfOffset(at))
                if ((page >= 0) && (page < c.slides)) {
                    def t:string ((d.slideAt(page)).title)
                    if ((strlen t) > 0) {
                        where = (" on slide \"" + t + "\"")
                    } {
                        where = (" on slide " + (page + 1))
                    }
                }
            }
            if e.ok {
                ; drawn, but with a field its data does not have: an empty
                ; frame where the bars should be
                for e.warnings w:string wi {
                    push c.warnings ("The " + e.kind + " block" + where + ": " + w + ".")
                }
                continue
            }
            def why:string e.note
            if ((strlen why) == 0) {
                why = "it could not be drawn"
            }
            push c.warnings ("The " + e.kind + " block" + where + " is not shown: " + why + ".")
        }
        for (d.smartArtNotes()) note:string ni {
            push c.warnings note
        }
        for (d.chartStyleNotes()) csn:string csi {
            push c.warnings csn
        }
        for (d.htmlNotes()) hn:string hi {
            push c.warnings hn
        }
        if c.laidOut {
            Check.contrast(c d l pics)
            d.still = true
            for (Layout.slides(d md)) rs:RSlide ri {
                push c.report (Report.slide(rs))
            }
            if din.lists {
                def li:int 0
                while (li < c.slides) {
                    def groups:[int]
                    def sl:EVGDisplayList (d.slideList(li groups 0.0))
                    push c.lists (sl.toJson())
                    li = (li + 1)
                }
            }
            d.still = false
            ; a deck with `@media print` rules: what the printing house would
            ; say about the pages it gets (PrintReport)
            if (d.hasPrint()) {
                d.setMedia("print")
                for (PrintReport.notes((Layout.printPages(d)))) pn:string pni {
                    push c.warnings pn
                }
                d.setMedia("screen")
            }
        }
        if ((strlen din.export) > 0) {
            def ex (new PresExport())
            ex.deck = d
            ex.only = din.only
            if (din.export == "pdf") {
                c.file = (ex.pdf())
            }
            if (din.export == "pptx") {
                Check.bgStills(host din ex d)
                c.file = (ex.pptx())
            }
            if (din.export == "docx") {
                Check.shots(host ex d)
                c.file = (ex.docx())
            }
            if (din.export == "html") {
                Check.shots(host ex d)
                c.file = (PptxWriter.utf8((ex.html())))
            }
        }
        return c
    }

    ; A slide's own picture (`bg=`) for the PPTX: the slide's background
    ; drawn as the stage cuts and dims it, as web/main.js renderFxStills
    ; draws it in the editor (PresApp.bgSlidesJson: slides with no effect),
    ; and PresExport.pptx makes it the slide's background picture.
    sfn bgStills:void (host:McpHost din:DeckIn ex:PresExport d:PresDeck) {
        for din.pics pic:CheckPic pi {
            host_render_pic host pic.name (itemAt din.data pi)
        }
        d.still = true
        def i:int 0
        while (i < (d.slideCount())) {
            def s:PresSlide (d.slideAt(i))
            def wanted:boolean (((array_length din.only) == 0) || (PresExport.has(din.only i)))
            if ((wanted && ((strlen s.bg) > 0)) && ((strlen s.fx) == 0)) {
                def jpeg:buffer (host_render_still host ((d.fxOnlyList(i)).toJson()) d.pageW d.pageH 1600)
                if ((buffer_length jpeg) > 0) {
                    push ex.stillIdx i
                    push ex.stillRgba (buffer_alloc 0)
                    push ex.stillW 0
                    push ex.stillH 0
                    push ex.stillJpeg jpeg
                }
            }
            i = (i + 1)
        }
        d.still = false
    }

    ; The Word and web page exports' pictures of what only the stage draws
    ; (diagrams, charts, SmartArt; PresDocx): each block's rectangle of its
    ; slide at rest, drawn here as the editor draws it in WebGL.
    sfn shots:void (host:McpHost ex:PresExport d:PresDeck) {
        ex.docxShots()
        for ex.word.shots s:PresDocxShot si {
            def dl:EVGDisplayList (ex.word.shotList(d s.key))
            ; sharp enough for a page-wide picture
            def px:int (to_int ((s.w * 2.0) + 0.5))
            if (px > 1400) {
                px = 1400
            }
            def png:buffer (host_render_crop host (dl.toJson()) d.pageW d.pageH s.x s.y s.w s.h px)
            if ((buffer_length png) > 0) {
                ex.word.setShot(s.key png px (to_int ((((to_double px) * s.h) / s.w) + 0.5)))
            }
        }
    }

    ; per command of the slide list just drawn: true for text struck through
    ; (`~~…~~`, `<s>`, `<del>`) and the "[alt]" standing in for a picture
    ; with no bytes, which the layout draws muted on purpose
    sfn struck:[boolean] (d:PresDeck l:MdLayout n:int) {
        def out:[boolean]
        def owner:[int] d.boxOfCmd
        def i:int 0
        while (i < n) {
            def q:boolean false
            if (i < (array_length owner)) {
                def ob:int (itemAt owner i)
                if ((ob >= 0) && (ob < (array_length l.boxes))) {
                    def b:MdBox (itemAt l.boxes ob)
                    q = (b.strike || b.quiet)
                }
            }
            push out q
            i = (i + 1)
        }
        return out
    }

    ; which commands a chart or a diagram drew (its box is an embed)
    sfn inDrawing:[boolean] (d:PresDeck l:MdLayout n:int) {
        def out:[boolean]
        def owner:[int] d.boxOfCmd
        def i:int 0
        while (i < n) {
            def q:boolean false
            if (i < (array_length owner)) {
                def ob:int (itemAt owner i)
                if ((ob >= 0) && (ob < (array_length l.boxes))) {
                    def b:MdBox (itemAt l.boxes ob)
                    q = (b.kind == 3)
                }
            }
            push out q
            i = (i + 1)
        }
        return out
    }

    ; text that does not stand out from what it is drawn over, slide by
    ; slide, as the editor's painter judges it
    ; A text command's box is its slot (a centred letter's is the width of
    ; the disc it sits on, from where the letter starts); the judge samples
    ; what is under the letters, so each run gets the width its face draws
    ; it (as Layout.rgr measures runs), from where it starts.
    sfn toInk:void (list:EVGDisplayList l:MdLayout) {
        for list.cmds c:EVGDrawCmd ci {
            if ((c.kind == 3) && ((strlen (trim c.text)) > 0)) {
                def mw:EVGTextMetrics (l.engine.measureRunSpaced(c.text c.fontFamily c.fontSize c.letterSpacing))
                if ((mw.width > 0.0) && (mw.width < c.w)) {
                    c.w = mw.width
                }
            }
        }
    }

    sfn contrast:void (c:Checked d:PresDeck l:MdLayout pics:[CheckPic]) {
        d.still = true
        def skip:[string]
        for l.embeds.entries e:MdEmbedEntry k {
            if (e.ok == false) {
                push skip e.note
                ; the slide shows the note under its kind (MdLayout's stand-in)
                push skip ("⚠ " + e.kind + ": " + e.note)
            }
        }
        def i:int 0
        while (i < c.slides) {
            def groups:[int]
            def list:EVGDisplayList (d.slideList(i groups 0.0))
            Check.toInk(list l)
            def quiet:[boolean] (Check.struck(d l (array_length list.cmds)))
            def drawn:[boolean] (Check.inDrawing(d l (array_length list.cmds)))
            def low:[LowRun] (Contrast.lowRuns(list pics "" -1.0 skip quiet drawn))
            if ((array_length low) > 0) {
                def s:PresSlide (d.slideAt(i))
                def bgSrc:string ""
                def hasBg:boolean false
                if (((strlen s.bg) > 0) && l.haveImages) {
                    bgSrc = (l.images.resolve(s.bg l.docDir))
                    for pics p:CheckPic pk {
                        if ((p.name == bgSrc) && ((array_length p.grid) > 0)) {
                            hasBg = true
                        }
                    }
                }
                ; the least dim, in steps of 0.05, that makes every run read
                def dimFix:double -1.0
                if hasBg {
                    def step:int ((floor (s.bgDim * 20.0)) + 1)
                    while ((step <= 18) && (dimFix < 0.0)) {
                        def dim:double ((to_double step) / 20.0)
                        if ((array_length (Contrast.lowRuns(list pics bgSrc dim skip quiet drawn))) == 0) {
                            dimFix = dim
                        }
                        step = (step + 1)
                    }
                }
                for (Contrast.notes(s.title i low hasBg dimFix)) cn:string cni {
                    push c.warnings cn
                }
            }
            i = (i + 1)
        }
        d.still = false
    }
}
