; Where a deck is kept (mcp/src/store.js).
;
; The same share the editor's Share button makes (web/sliqtly.js):
; shares/{id} in Firestore, its pictures in Storage under shares/{id}/media/…,
; so /s/{id} opens it with no change to the page.
;
; The id locates a deck; it grants nothing. A signed-in user's deck is
; changed by its owner only. A deck made without sign-in is changed only by
; the conversation that made it. Two 256-bit random values hold it, each
; kept only as mcp_sessions/{its sha256}: the connection's Mcp-Session-Id
; (until DELETE /mcp), and the session_key create_presentation hands the
; conversation, which it sends back as a tool argument. Clients reconnect
; with a new Mcp-Session-Id (Cursor between turns), so the key is what
; carries the hold across connections. Either lapses a day after its last
; change.
;
; Without cloud storage ("link") nothing is kept: the deck travels in the link.

Import "McpHost.rgr"
Import "McpJson.rgr"
Import "Deck.rgr"

; What one caller may keep (Tero 2026-10-06: an open test, so that one
; script cannot run up the bill). The daily counts of changes and of
; drawings are the host's (host.go dailyQuota, dailyRenders). A server of
; one's own has none of these.
class Limits {
    ; decks one session without sign-in holds; a signed-in user's decks
    sfn ANON_DECKS:int () {
        return 3
    }
    sfn USER_DECKS:int () {
        return 50
    }
    ; slides in one deck
    sfn ANON_SLIDES:int () {
        return 20
    }
    sfn USER_SLIDES:int () {
        return 100
    }
    ; all of one deck's pictures and files together (bytes)
    sfn DECK_BYTES:int () {
        return ((200 * 1024) * 1024)
    }
    ; days a deck made without sign-in is kept after its last change
    sfn ANON_DAYS:int () {
        return 7
    }
    sfn slides:int (signedIn:boolean) {
        if signedIn {
            return (Limits.USER_SLIDES())
        }
        return (Limits.ANON_SLIDES())
    }
}

class Created {
    def id:string ""
    def err:string ""
}

; what update_presentation changes; css: 0 leave, 1 set to cssText, 2 clear
class DeckPatch {
    def hasName:boolean false
    def name:string ""
    def hasMd:boolean false
    def md:string ""
    def hasTheme:boolean false
    def theme:string ""
    def cssMode:int 0
    def css:string ""
    def hasVisibility:boolean false
    def visibility:string ""
}

; a save: the deck as saved (null when the id or key did not match), or
; changed when the guarded Markdown was no longer the one read
class Saved {
    def doc:MfJ (new MfJ)
    def changed:boolean false
}

class Store {
    sfn serverTime:MfJ () {
        def t:MfJ (MfJ.newObj())
        t.putBool("$serverTime" true)
        return t
    }

    ; a deck nobody signed in for is deleted 7 days after its last change
    ; (Firestore's TTL policy on `expires`: firestore.indexes.json)
    sfn anonExpires:MfJ (host:McpHost) {
        return (J.timeAt(((host_now_ms host) + ((((Limits.ANON_DAYS()) * 24) * 60) * 60) * 1000)))
    }

    sfn validId:boolean (id:string) {
        def n:int (strlen id)
        if ((n < 1) || (n > 64)) {
            return false
        }
        return (Deck.allAlnum(id))
    }

    ; Who sees a deck (`visibility` on shares/{id}, firestore.rules and
    ; storage.rules read the same field): "private" only its owner (and an
    ; edit key's holder, here), "link" anyone with its id. A share without
    ; the field is "link": every share made before it existed.
    sfn isPrivate:boolean (doc:MfJ) {
        return ((doc.str_("visibility")) == "private")
    }

    ; whether this caller may read the deck: a "link" deck anyone, a
    ; private one only its owner signed in
    sfn readableBy:boolean (doc:MfJ signedIn:boolean uid:string) {
        if ((Store.isPrivate(doc)) == false) {
            return true
        }
        return ((signedIn && ((strlen uid) > 0)) && ((doc.str_("owner")) == uid))
    }

    ; --- MCP sessions: what a session without sign-in may change

    ; a session unused this long is over (ms)
    sfn SESSION_MS:int () {
        return (((24 * 60) * 60) * 1000)
    }


    ; the session's record id: the hash of its id (sid as the client sends
    ; it), "" for none
    sfn sessionKey:string (host:McpHost sid:string) {
        def n:int (strlen sid)
        if ((n < 32) || (n > 128)) {
            return ""
        }
        return (host_sha256_hex host sid)
    }

    ; whether the session (its key) holds deck id; a storage error is left on
    ; the host
    sfn sessionHolds:boolean (host:McpHost key:string id:string) {
        if ((strlen key) == 0) {
            return false
        }
        def d:MfJ (J.parse((host_get_doc host "mcp_sessions" key)))
        if ((d.isObj()) == false) {
            return false
        }
        if ((d.int_("exp" 0)) <= (host_now_ms host)) {
            return false
        }
        return (Deck.inList((J.strList((d.field("decks")))) id))
    }

    ; the session holds deck id from now on, for a day after its last use
    ; (renewed by each change it makes); false when it holds as many as it
    ; may
    sfn sessionGrant:boolean (host:McpHost key:string id:string) {
        if ((strlen key) == 0) {
            return false
        }
        def d:MfJ (J.parse((host_get_doc host "mcp_sessions" key)))
        def ids:[string]
        if ((d.isObj()) && ((d.int_("exp" 0)) > (host_now_ms host))) {
            ids = (J.strList((d.field("decks"))))
        }
        if ((Deck.inList(ids id)) == false) {
            if ((array_length ids) >= (Limits.ANON_DECKS())) {
                return false
            }
            push ids id
        }
        def exp:int ((host_now_ms host) + (Store.SESSION_MS()))
        def doc:MfJ (MfJ.newObj())
        doc.put("decks" (J.strs(ids)))
        doc.putInt("exp" exp)
        doc.put("expires" (J.timeAt(exp)))
        host_set_doc host "mcp_sessions" key (JOut.text(doc))
        return ((strlen (host_error host)) == 0)
    }

    ; how many decks the session holds now
    sfn sessionCount:int (host:McpHost key:string) {
        if ((strlen key) == 0) {
            return 0
        }
        def d:MfJ (J.parse((host_get_doc host "mcp_sessions" key)))
        if (((d.isObj()) == false) || ((d.int_("exp" 0)) <= (host_now_ms host))) {
            return 0
        }
        return (array_length (J.strList((d.field("decks")))))
    }

    ; the session no longer holds deck id (deleted)
    sfn sessionDrop:void (host:McpHost key:string id:string) {
        if ((strlen key) == 0) {
            return
        }
        def d:MfJ (J.parse((host_get_doc host "mcp_sessions" key)))
        if ((d.isObj()) == false) {
            return
        }
        def ids:[string]
        for (J.strList((d.field("decks")))) x:string xi {
            if (x != id) {
                push ids x
            }
        }
        d.put("decks" (J.strs(ids)))
        host_set_doc host "mcp_sessions" key (JOut.text(d))
    }

    ; deck id gone for good: its record first, so nothing points at files
    ; that are gone (files a failed removal leaves are named by nothing),
    ; then its pictures, data files and exports, and the work board
    sfn remove:void (host:McpHost id:string) {
        host_delete_doc host "shares" id
        if ((strlen (host_error host)) > 0) {
            return
        }
        host_delete_doc host "mcp_work" id
        host_clear_error host
        host_remove_files host ("shares/" + id + "/")
    }

    ; the session is over: what it held goes with it
    sfn sessionEnd:void (host:McpHost key:string) {
        if ((strlen key) > 0) {
            host_delete_doc host "mcp_sessions" key
        }
    }

    ; owner: the signed-in user's uid, or "mcp"; css "" with hasCss false
    ; stores null; visibility "private" or "link" (an "mcp" deck has no
    ; owner to keep it for: always "link")
    ; room: the deck's home room, "" for the server's own (General)
    sfn create:Created (host:McpHost name:string md:string theme:string hasCss:boolean css:string imgs:[Img] owner:string visibility:string room:string) {
        def out (new Created)
        def id:string (host_short_id host 10)
        def files:MfJ (Store.upload(host id imgs))
        def e2:string (host_error host)
        if ((strlen e2) > 0) {
            out.err = e2
            return out
        }
        def doc:MfJ (MfJ.newObj())
        doc.putStr("name" name)
        doc.putStr("md" md)
        doc.putStr("theme" theme)
        if hasCss {
            doc.putStr("css" css)
        } {
            doc.put("css" (new MfJ))
        }
        doc.putStr("owner" owner)
        if ((owner != "mcp") && (visibility == "private")) {
            doc.putStr("visibility" "private")
        } {
            doc.putStr("visibility" "link")
        }
        doc.putStr("deck" "mcp")
        doc.putStr("source" "mcp")
        doc.put("files" files)
        doc.put("created" (Store.serverTime()))
        if ((strlen room) > 0) {
            doc.putStr("room" room)
        }
        if (owner == "mcp") {
            doc.put("expires" (Store.anonExpires(host)))
        }
        host_set_doc host "shares" id (JOut.text(doc))
        def e3:string (host_error host)
        if ((strlen e3) > 0) {
            out.err = e3
            return out
        }
        out.id = id
        return out
    }

    ; the deck as saved, or a null value when there is none by that id; the
    ; caller has checked that it may change it (Tools.editable). A storage
    ; error is left on the host.
    sfn update:MfJ (host:McpHost id:string p:DeckPatch imgs:[Img]) {
        def s:Saved (Store.save(host id p imgs false ""))
        return s.doc
    }

    ; update, and with guard only while the deck's Markdown is still `want`
    ; (read and write in one transaction): changed when it was not, and
    ; nothing written
    sfn save:Saved (host:McpHost id:string p:DeckPatch imgs:[Img] guard:boolean want:string) {
        def out (new Saved)
        if ((Store.validId(id)) == false) {
            return out
        }
        def cur:MfJ (J.parse((host_get_doc host "shares" id)))
        if ((cur.isObj()) == false) {
            return out
        }
        def added:MfJ (Store.upload(host id imgs))
        if ((strlen (host_error host)) > 0) {
            return out
        }
        def files:MfJ (MfJ.newArr())
        for (cur.list("files")) f:MfJ i {
            def path:string (f.str_("path"))
            def replaced:boolean false
            for added.arr a:MfJ j {
                if ((a.str_("path")) == path) {
                    replaced = true
                }
            }
            if (replaced == false) {
                files.add(f)
            }
        }
        for added.arr a2:MfJ k {
            files.add(a2)
        }
        def patch:MfJ (MfJ.newObj())
        patch.put("files" files)
        patch.put("updated" (Store.serverTime()))
        ; a deck from before "created" was kept gets the earliest time known
        ; of it: its last change so far
        if ((cur.num_("created" 0.0)) == 0.0) {
            def was:double (Store.stamp(cur))
            if (was > 0.0) {
                patch.put("created" (J.timeAt((to_int was))))
            } {
                patch.put("created" (Store.serverTime()))
            }
        }
        if p.hasName {
            patch.putStr("name" p.name)
        }
        if p.hasMd {
            patch.putStr("md" p.md)
        }
        if p.hasTheme {
            patch.putStr("theme" p.theme)
        }
        if (p.cssMode == 1) {
            patch.putStr("css" p.css)
        }
        if (p.cssMode == 2) {
            patch.put("css" (new MfJ))
        }
        if p.hasVisibility {
            patch.putStr("visibility" p.visibility)
        }
        if ((cur.str_("owner")) == "mcp") {
            patch.put("expires" (Store.anonExpires(host)))
        }
        if guard {
            def r:string (host_update_if host "shares" id "md" want (JOut.text(patch)))
            if ((strlen (host_error host)) > 0) {
                return out
            }
            if (r == "changed") {
                out.changed = true
                return out
            }
        } {
            host_update_doc host "shares" id (JOut.text(patch))
            if ((strlen (host_error host)) > 0) {
                return out
            }
        }
        for patch.ks pk:string m {
            cur.put(pk (patch.field(pk)))
        }
        out.doc = cur
        return out
    }

    sfn get:MfJ (host:McpHost id:string) {
        if ((Store.validId(id)) == false) {
            return (new MfJ)
        }
        return (J.parse((host_get_doc host "shares" id)))
    }

    ; the user's shares, newest first, at most 50
    sfn list:[MfJ] (host:McpHost uid:string) {
        def all:MfJ (J.parse((host_query_eq host "shares" "owner" uid)))
        def docs:[MfJ]
        for all.arr d:MfJ i {
            push docs d
        }
        ; newest first: insertion sort on updated, else created
        def n:int (array_length docs)
        def a:int 1
        while (a < n) {
            def cur:MfJ (itemAt docs a)
            def t:double (Store.stamp(cur))
            def b:int (a - 1)
            def going:boolean true
            while ((b >= 0) && going) {
                def prev:MfJ (itemAt docs b)
                if ((Store.stamp(prev)) < t) {
                    set docs (b + 1) prev
                    b = (b - 1)
                } {
                    going = false
                }
            }
            set docs (b + 1) cur
            a = (a + 1)
        }
        def out:[MfJ]
        for docs d2:MfJ j {
            if (j < 50) {
                push out d2
            }
        }
        return out
    }

    ; when the deck was made, in ms: "created", or for a deck from before
    ; that was kept, the earliest time known (its last change); 0 unknown
    sfn createdAt:double (d:MfJ) {
        def c:double (d.num_("created" 0.0))
        if (c != 0.0) {
            return c
        }
        return (d.num_("updated" 0.0))
    }

    sfn stamp:double (d:MfJ) {
        def u:double (d.num_("updated" 0.0))
        if (u != 0.0) {
            return u
        }
        return (d.num_("created" 0.0))
    }

    sfn upload:MfJ (host:McpHost id:string imgs:[Img]) {
        def out:MfJ (MfJ.newArr())
        for imgs img:Img i {
            def path:string ("media/" + img.name)
            if ((strlen img.path) > 0) {
                path = img.path
            }
            def name:string ("shares/" + id + "/" + path)
            ; the token is what getDownloadURL() hands the editor for its own uploads
            def token:string (host_uuid host)
            host_upload host img.handle name img.type token
            if ((strlen (host_error host)) > 0) {
                return out
            }
            def f:MfJ (MfJ.newObj())
            f.putStr("path" path)
            f.putStr("type" img.type)
            f.putInt("size" img.size)
            f.putStr("url" (host_file_url host name token))
            out.add(f)
        }
        return out
    }
}
