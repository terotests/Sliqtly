; =============================================================================
; A shared presentation for the public viewer: GET /api/view/<id>
; [?slides=<keys>]. The deck is laid out here, with the editor's own model
; (Check.prepare, as render_slide lays it out), and each slide goes to the
; page as its display list at rest. The page (web/view.js) only paints
; the lists, so the site ships a painter and no Markdown, layout or chart
; code.
;
;   { "deck": { "name", "width", "height", "slides",
;               "files": [{ "path", "type", "url" }], "plays": [View.plays] },
;     "lists": [ <EVGDisplayList.toJson>, … ],
;     "effects": [ <FxLang.json: the deck's own effects> ] }
;
; `files` are the deck's stored files a list draws (pictures, by the
; "/media/<name>" a command's src names). `slides`: a view of only those
; sections (PresPick keys, the link the editor's picked slides share).
; =============================================================================

Import "McpHost.rgr"
Import "McpJson.rgr"
Import "Tools.rgr"
Import "../presentation/PresPick.rgr"

class View {
    ; whether the viewer may show doc to uid ("" for nobody signed in)
    sfn shows:boolean (doc:MfJ uid:string) {
        if ((doc.str_("visibility")) != "private") {
            return true
        }
        return (((strlen uid) > 0) && ((doc.str_("owner")) == uid))
    }

    ; the answer's body, or "" when there is no such presentation
    ; uid: who signed in on the page ("" for nobody), the only one a
    ; private deck is shown to when it is theirs
    sfn json:string (host:McpHost id:string keys:string uid:string) {
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            return ""
        }
        def sh:Shown (Store.shown(host id))
        def doc:MfJ sh.doc
        if ((strlen (host_error host)) > 0) {
            host_log host ("view " + id + ": " + (host_error host))
            host_clear_error host
            return ""
        }
        if ((doc.isObj()) == false) {
            return ""
        }
        ; a private deck is its owner's only: "not found" to anyone else,
        ; like a missing one
        if ((sh.link == false) && ((View.shows(doc uid)) == false)) {
            return ""
        }
        def md:string (doc.str_("md"))
        def stored:[string]
        for (doc.list("files")) f:MfJ fi {
            push stored (f.str_("path"))
        }
        def noImgs:[Img]
        def bgs:CheckPics (Tools.backgrounds(host md noImgs sh.id))
        def din (new DeckIn)
        din.deckId = sh.id
        din.stored = stored
        din.live = true
        din.md = md
        def css:MfJ (doc.field("css"))
        din.css = (Tools.sheetFor(host (doc.str_("theme")) (css.kind == 3) (doc.str_("css"))))
        din.pics = bgs.pics
        din.data = bgs.data
        din.types = bgs.types
        def c (new Checked)
        def d:PresDeck (Check.prepare(host din c))
        if ((strlen keys) > 0) {
            ; the sections the link names and nothing else: laid out once
            ; more from their own text, as the player shows such a link
            def l:MdLayout (d.layout())
            din.md = (PresPick.viewText(md l.splitLevel keys))
            if ((strlen din.md) == 0) {
                ; renamed or deleted since: said, and nothing of the rest shown
                ; (web/main.js slidesOf)
                din.md = "# These slides are no longer in the presentation.\n"
            }
            d = (Check.prepare(host din (new Checked)))
        }
        ; at rest: every build step shown, charts grown (render_slide's state)
        d.still = true
        ; a program's box is left empty: the page runs it and paints its
        ; plate until it has a picture (web/viewplay.js)
        d.platesOff = true
        def lists:[string]
        def n:int (d.slideCount())
        def i:int 0
        while (i < n) {
            def groups:[int]
            push lists ((d.slideList(i groups 0.0)).toJson())
            i = (i + 1)
        }
        def all:string (join lists ",")
        def files:MfJ (MfJ.newArr())
        for (doc.list("files")) f2:MfJ f2i {
            def path:string (f2.str_("path"))
            def url:string (f2.str_("url"))
            if (((strlen path) == 0) || ((strlen url) == 0)) {
                continue
            }
            if ((indexOf all ("\"/" + path + "\"")) < 0) {
                continue
            }
            def o:MfJ (MfJ.newObj())
            o.putStr("path" path)
            o.putStr("type" (f2.str_("type")))
            o.putStr("url" url)
            files.add(o)
        }
        def deck:MfJ (MfJ.newObj())
        deck.putStr("name" (doc.str_("name")))
        deck.putNum("width" d.pageW)
        deck.putNum("height" d.pageH)
        deck.putInt("slides" n)
        deck.put("files" files)
        ; `mode: book`: the pages that face each other, [left, right] with
        ; -1 for none, and how the book is drawn (PresBook)
        def book:MdBook (d.book())
        if (book.isBook()) {
            def bj:MfJ (MfJ.newObj())
            bj.putStr("render" book.render)
            def spreads:MfJ (MfJ.newArr())
            def sc:int (book.spreadCount(n))
            def si:int 0
            while (si < sc) {
                def pair:MfJ (MfJ.newArr())
                pair.add((MfJ.ofInt((book.leftOf(si n)))))
                pair.add((MfJ.ofInt((book.rightOf(si n)))))
                spreads.add(pair)
                si = (si + 1)
            }
            bj.put("spreads" spreads)
            deck.put("book" bj)
        }
        deck.put("plays" (View.plays(host din d)))
        ; the deck's own effects (```fx, the theme's @effect) as shader
        ; text the deck's compiler wrote (FxLang), for the page to register
        return ("{\"deck\":" + (JOut.text(deck)) + ",\"lists\":[" + all + "],\"effects\":" + (d.effectsJson()) + "}")
    }

    ; The programs on the slides (```app), which the page runs itself
    ; (web/view.js with web/apps.js): where each one's box is on its slide,
    ; its size and grants, and its source and stylesheet as text.
    ;   [{ "key", "slide", "src", "css", "w", "h", "allow": […],
    ;      "box": [x, y, w, h], "text", "cssText" }]
    sfn plays:MfJ (host:McpHost din:DeckIn d:PresDeck) {
        def out:MfJ (MfJ.newArr())
        def all:[PresPlayUse] (d.playUses())
        def l:MdLayout (d.layout())
        for all u:PresPlayUse ui {
            def bi:int (d.embedBox(u.page u.source))
            if (bi < 0) {
                continue
            }
            def b:MdBox (itemAt l.boxes bi)
            def o:MfJ (MfJ.newObj())
            o.putStr("key" u.key)
            o.putInt("slide" u.page)
            o.putStr("src" u.spec.src)
            o.putStr("css" u.spec.css)
            o.putNum("w" u.spec.width)
            o.putNum("h" u.spec.height)
            def al:MfJ (MfJ.newArr())
            for u.spec.allow a:string ai {
                al.add((MfJ.ofStr(a)))
            }
            o.put("allow" al)
            def bx:MfJ (MfJ.newArr())
            bx.add((MfJ.ofNum(b.x)))
            bx.add((MfJ.ofNum(b.y)))
            bx.add((MfJ.ofNum(b.w)))
            bx.add((MfJ.ofNum(b.h)))
            o.put("box" bx)
            o.putStr("text" (Check.dataText(host din u.spec.src)))
            o.putStr("cssText" (Check.dataText(host din u.spec.css)))
            out.add(o)
        }
        return out
    }
}

; =============================================================================
; The viewer's downloads: GET /api/export/<id>/<format>[?slides=<keys>],
; format pdf, pptx or md. Whoever may view the deck may download it: a
; deck shared by link, a private one by its owner signed in on the page. PDF and PPTX are the editor's own
; export (as export_presentation makes them, slides at the end of their
; animations); md is the deck's text without Sliqtly's styling (PlainMd).
; Nothing is stored: the file goes straight to the browser.
; =============================================================================

class ViewFile {
    ; 200, 400 (no such format), 404 (no such shared presentation) or 500
    def status:int 404
    def why:string ""
    def name:string ""
    def type:string ""
    def bytes:buffer (buffer_from_string "")
}

class ViewExport {
    sfn file:ViewFile (host:McpHost id:string format:string keys:string uid:string) {
        def out (new ViewFile)
        if (((format != "pdf") && (format != "pptx")) && (format != "md")) {
            out.status = 400
            out.why = "The format is pdf, pptx or md."
            return out
        }
        out.why = "This shared presentation was not found."
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            return out
        }
        def sh:Shown (Store.shown(host id))
        def doc:MfJ sh.doc
        if ((strlen (host_error host)) > 0) {
            host_log host ("export " + id + ": " + (host_error host))
            host_clear_error host
            return out
        }
        if ((doc.isObj()) == false) {
            return out
        }
        ; as /api/view: a private deck only for its owner
        if ((sh.link == false) && ((View.shows(doc uid)) == false)) {
            return out
        }
        def md:string (doc.str_("md"))
        def stored:[string]
        for (doc.list("files")) f:MfJ fi {
            push stored (f.str_("path"))
        }
        def noImgs:[Img]
        def bgs:CheckPics (Tools.backgrounds(host md noImgs sh.id))
        def css:MfJ (doc.field("css"))
        def theme:string (doc.str_("theme"))
        def hasCss:boolean (css.kind == 3)
        def sheet:string (doc.str_("css"))
        if ((strlen keys) > 0) {
            ; the view link's sections only, as /api/view shows them
            def pin (new DeckIn)
            pin.deckId = sh.id
            pin.stored = stored
            pin.live = true
            pin.md = md
            pin.css = (Tools.sheetFor(host theme hasCss sheet))
            pin.pics = bgs.pics
            pin.data = bgs.data
            pin.types = bgs.types
            def d:PresDeck (Check.prepare(host pin (new Checked)))
            def l:MdLayout (d.layout())
            md = (PresPick.viewText(md l.splitLevel keys))
            if ((strlen md) == 0) {
                md = "# These slides are no longer in the presentation.\n"
            }
        }
        def name:string (Tools.fileName((doc.str_("name"))))
        if (format == "md") {
            out.status = 200
            out.why = ""
            out.name = (name + ".md")
            out.type = "text/markdown; charset=utf-8"
            out.bytes = (buffer_from_string (PlainMd.text(md)))
            return out
        }
        def din (new DeckIn)
        din.deckId = sh.id
        din.stored = stored
        din.live = true
        din.export = format
        def ck:Checked (Tools.checkWith(host md theme hasCss sheet bgs din))
        if ((ck.laidOut == false) || ((buffer_length ck.file) == 0)) {
            out.status = 500
            out.why = "The file could not be made."
            return out
        }
        out.status = 200
        out.why = ""
        out.name = (name + "." + format)
        out.type = "application/pdf"
        if (format == "pptx") {
            out.type = "application/vnd.openxmlformats-officedocument.presentationml.presentation"
        }
        out.bytes = ck.file
        return out
    }
}

; =============================================================================
; A deck's Markdown without Sliqtly's styling, for any Markdown reader:
; attribute blocks ({.lead}, {#id}, {art=waves}, {.build anim=rise}) go,
; on a line of their own or at the end of one, and the front matter keeps
; only the title. Code blocks and math stay as they are; so do speaker
; notes (::: notes), which are text. The theme's CSS is never in the text.
; =============================================================================

class PlainMd {
    sfn text:string (md:string) {
        def lines:[string] (strsplit md "\n")
        def out:[string]
        def n:int (array_length lines)
        def i:int 0
        ; front matter: --- on the first line to the next ---
        if ((n > 0) && ((trim (itemAt lines 0)) == "---")) {
            def j:int 1
            def title:string ""
            while ((j < n) && ((trim (itemAt lines j)) != "---")) {
                def fl:string (itemAt lines j)
                if ((indexOf fl "title:") == 0) {
                    title = fl
                }
                j = (j + 1)
            }
            if (j < n) {
                if ((strlen title) > 0) {
                    push out "---"
                    push out title
                    push out "---"
                }
                i = (j + 1)
            }
        }
        def fence:string ""
        while (i < n) {
            def line:string (itemAt lines i)
            i = (i + 1)
            def t:string (trim line)
            def f:string (Deck.fenceOf(line))
            if ((strlen fence) > 0) {
                push out line
                if (((strlen f) > 0) && (((charAt f 0) == (charAt fence 0)) && ((strlen f) >= (strlen fence)))) {
                    fence = ""
                }
                continue
            }
            if ((strlen f) > 0) {
                fence = f
                push out line
                continue
            }
            if (PlainMd.isAttrs(t)) {
                continue
            }
            push out (PlainMd.dropTrailing(line))
        }
        return (join out "\n")
    }

    ; a line's text without the attribute block it ends with
    sfn dropTrailing:string (line:string) {
        def r:string (trim line)
        if (((strlen r) < 3) || ((lastIndexOf r "}") != ((strlen r) - 1))) {
            return line
        }
        def at:int (lastIndexOf r "{")
        if (at < 1) {
            return line
        }
        if (PlainMd.isAttrs((substring r at (strlen r))) == false) {
            return line
        }
        ; {…} after a space; inline math ($x^{2}$) never reads as attributes
        def before:string (substring r 0 at)
        if (((lastIndexOf before " ") != ((strlen before) - 1)) && ((lastIndexOf before "]") != ((strlen before) - 1))) {
            return line
        }
        def lead:int (indexOf line r)
        return ((substring line 0 lead) + (trim before))
    }

    ; "{.a #b key=value …}": every word a class, an id or key=value
    sfn isAttrs:boolean (t:string) {
        def n:int (strlen t)
        if (((n < 3) || ((indexOf t "{") != 0)) || ((lastIndexOf t "}") != (n - 1))) {
            return false
        }
        def inner:string (trim (substring t 1 (n - 1)))
        if (((strlen inner) == 0) || ((indexOf inner "{") >= 0)) {
            return false
        }
        for (strsplit inner " ") w:string wi {
            if ((strlen w) == 0) {
                continue
            }
            if (PlainMd.isAttr(w) == false) {
                return false
            }
        }
        return true
    }

    sfn isAttr:boolean (w:string) {
        def c:int (charAt w 0)
        if ((c == 46) || (c == 35)) {
            ; .class or #id
            return (PlainMd.isName((substring w 1 (strlen w))))
        }
        def eq:int (indexOf w "=")
        if (eq < 1) {
            return false
        }
        return (PlainMd.isName((substring w 0 eq)))
    }

    ; letters first, then letters, digits, - and _
    sfn isName:boolean (s:string) {
        def n:int (strlen s)
        if (n == 0) {
            return false
        }
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            def letter:boolean (((c >= 97) && (c <= 122)) || ((c >= 65) && (c <= 90)))
            def other:boolean ((((c >= 48) && (c <= 57)) || (c == 45)) || (c == 95))
            if ((letter == false) && ((i == 0) || (other == false))) {
                return false
            }
            i = (i + 1)
        }
        return true
    }
}

; =============================================================================
; A shared link's preview card (Slack, Teams, iMessage, LinkedIn …): what
; GET /s/<id> writes into the page's head for a reader that runs no script
; (og:title, og:description, og:image), and the picture GET /api/card/<id>.jpg
; draws: the first slide at rest. Only a deck shared by link has a card; a
; private one keeps the site's own title and has no picture, so its name and
; slides reach nobody without the owner's sign-in.
; =============================================================================

class LinkCard {
    ; the deck when everyone with the link may see it, else an empty MfJ
    sfn shown:Shown (host:McpHost id:string) {
        def none (new Shown)
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            return none
        }
        def sh:Shown (Store.shown(host id))
        if ((strlen (host_error host)) > 0) {
            host_log host ("card " + id + ": " + (host_error host))
            host_clear_error host
            return none
        }
        if ((sh.doc.isObj()) == false) {
            return none
        }
        if ((sh.link == false) && ((View.shows(sh.doc "")) == false)) {
            return none
        }
        return sh
    }

    ; what changes when the deck does: the picture's address carries it, so
    ; a card read again after an edit draws the new first slide
    sfn stamp:string (doc:MfJ) {
        def t:double (doc.num_("updated" 0.0))
        if (t <= 0.0) {
            t = (doc.num_("created" 0.0))
        }
        return (to_string (to_int t))
    }

    ; { "title", "text", "stamp", "keys", "slide", "slides", "list" }, or ""
    ; when the deck has no card. A link to one slide (/s/<id>?slide=<n>,
    ; 1-based, of the ?slides= view when the link has one) is laid out and
    ; carries that slide's display list, whose words the page's head takes
    ; (linkcard.go); the deck's link carries the deck's first words.
    sfn json:string (host:McpHost id:string keys:string slide:int) {
        def sh:Shown (LinkCard.shown(host id))
        def doc:MfJ sh.doc
        if ((doc.isObj()) == false) {
            return ""
        }
        def md:string (doc.str_("md"))
        def title:string (trim (doc.str_("name")))
        if ((strlen title) == 0) {
            title = (LinkCard.firstHeading(md))
        }
        def o:MfJ (MfJ.newObj())
        o.putStr("title" title)
        o.putStr("text" (LinkCard.summary(md title)))
        o.putStr("stamp" (LinkCard.stamp(doc)))
        def k:string (LinkCard.keysOf(keys))
        o.putStr("keys" k)
        if (slide > 0) {
            def d:PresDeck (LinkCard.deckOf(host doc sh.id k))
            def n:int (d.slideCount())
            if (n > 0) {
                def at:int (LinkCard.indexOf(slide n))
                def groups:[int]
                o.putInt("slide" (at + 1))
                o.putInt("slides" n)
                o.putStr("list" ((d.slideList(at groups 0.0)).toJson()))
            }
        }
        return (JOut.text(o))
    }

    ; slide (1-based) as an index of n slides: past the end is the last
    sfn indexOf:int (slide:int n:int) {
        def at:int (slide - 1)
        if (at >= n) {
            at = (n - 1)
        }
        if (at < 0) {
            at = 0
        }
        return at
    }

    ; the ?slides= keys (PresPick section keys) as given, when they are
    ; only such keys; else none, so a card's address carries nothing else
    sfn keysOf:string (keys:string) {
        if ((strlen keys) > 300) {
            return ""
        }
        def i:int 0
        while (i < (strlen keys)) {
            def c:int (charAt keys i)
            def ok:boolean ((((c >= 48) && (c <= 57)) || ((c >= 97) && (c <= 122))) || ((c >= 65) && (c <= 90)))
            if ((((c == 45) || (c == 95)) || ((c == 126) || (c == 44))) || (c == 46)) {
                ok = true
            }
            if (ok == false) {
                return ""
            }
            i = (i + 1)
        }
        return keys
    }

    ; the deck laid out at rest as the viewer shows it: all of it, or the
    ; sections keys names (View.json)
    sfn deckOf:PresDeck (host:McpHost doc:MfJ id:string keys:string) {
        def md:string (doc.str_("md"))
        def stored:[string]
        for (doc.list("files")) f:MfJ fi {
            push stored (f.str_("path"))
        }
        def noImgs:[Img]
        def bgs:CheckPics (Tools.backgrounds(host md noImgs id))
        def din (new DeckIn)
        din.deckId = id
        din.stored = stored
        din.live = true
        din.md = md
        def css:MfJ (doc.field("css"))
        din.css = (Tools.sheetFor(host (doc.str_("theme")) (css.kind == 3) (doc.str_("css"))))
        din.pics = bgs.pics
        din.data = bgs.data
        din.types = bgs.types
        def d:PresDeck (Check.prepare(host din (new Checked)))
        if ((strlen keys) > 0) {
            def l:MdLayout (d.layout())
            din.md = (PresPick.viewText(md l.splitLevel keys))
            if ((strlen din.md) == 0) {
                din.md = "# These slides are no longer in the presentation.\n"
            }
            d = (Check.prepare(host din (new Checked)))
        }
        d.still = true
        for bgs.pics p:CheckPic pi {
            host_render_pic host p.name (itemAt bgs.data pi)
        }
        return d
    }

    sfn firstHeading:string (md:string) {
        for (strsplit (PlainMd.text(md)) "\n") line:string li {
            def t:string (trim line)
            if ((indexOf t "#") == 0) {
                return (LinkCard.inline((LinkCard.dropMarks(t "#"))))
            }
        }
        return ""
    }

    ; the deck's first words of prose, headings other than the title too,
    ; as one line: list marks, emphasis and link targets taken out. Code,
    ; tables, pictures, notes and the front matter are not text a reader
    ; of the card wants. A few hundred bytes; the page cuts it to length.
    sfn summary:string (md:string title:string) {
        def lines:[string] (strsplit (PlainMd.text(md)) "\n")
        def out:[string]
        def size:int 0
        def fence:string ""
        def front:boolean false
        def notes:boolean false
        for lines line:string li {
            def t:string (trim line)
            def f:string (Deck.fenceOf(line))
            if ((strlen fence) > 0) {
                if (((strlen f) > 0) && (((charAt f 0) == (charAt fence 0)) && ((strlen f) >= (strlen fence)))) {
                    fence = ""
                }
                continue
            }
            if ((strlen f) > 0) {
                fence = f
                continue
            }
            if ((li == 0) && (t == "---")) {
                front = true
                continue
            }
            if front {
                if (t == "---") {
                    front = false
                }
                continue
            }
            if ((indexOf t ":::") == 0) {
                notes = ((indexOf t "notes") > 0)
                continue
            }
            if notes {
                continue
            }
            if (((strlen t) == 0) || (LinkCard.skipped(t))) {
                continue
            }
            def text:string (LinkCard.inline((LinkCard.dropMarks(t "#"))))
            if (((strlen text) == 0) || (text == title)) {
                continue
            }
            push out text
            size = (size + (strlen text))
            if (size >= 400) {
                return (join out " · ")
            }
        }
        return (join out " · ")
    }

    ; a line that is no prose: a rule, a table row, a picture, HTML, a
    ; slide's attribute block
    sfn skipped:boolean (t:string) {
        if (((t == "---") || (t == "***")) || (t == "___")) {
            return true
        }
        if ((((indexOf t "|") == 0) || ((indexOf t "![") == 0)) || ((indexOf t "<") == 0)) {
            return true
        }
        return ((indexOf t "{") == 0)
    }

    ; t without the run of `mark` it starts with and the space after it,
    ; and without a list's or a quote's mark
    sfn dropMarks:string (t:string mark:string) {
        def s:string t
        while ((indexOf s mark) == 0) {
            s = (substring s 1 (strlen s))
        }
        s = (trim s)
        def again:boolean true
        while again {
            again = false
            if ((((indexOf s "- ") == 0) || ((indexOf s "* ") == 0)) || (((indexOf s "+ ") == 0) || ((indexOf s "> ") == 0))) {
                s = (trim (substring s 2 (strlen s)))
                again = true
            }
        }
        def dot:int (indexOf s ". ")
        if ((dot > 0) && (dot <= 3)) {
            if (LinkCard.digits((substring s 0 dot))) {
                s = (trim (substring s (dot + 2) (strlen s)))
            }
        }
        return s
    }

    sfn digits:boolean (s:string) {
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if ((c < 48) || (c > 57)) {
                return false
            }
            i = (i + 1)
        }
        return ((strlen s) > 0)
    }

    ; inline Markdown as its text: [words](address) → words, ![..](..)
    ; dropped, the marks * _ ` ~ taken out
    sfn inline:string (t:string) {
        def out:string ""
        def n:int (strlen t)
        def i:int 0
        while (i < n) {
            def c:int (charAt t i)
            if ((c == 33) && ((i + 1) < n)) {
                if ((charAt t (i + 1)) == 91) {
                    def close:int (LinkCard.linkEnd(t (i + 1)))
                    if (close > 0) {
                        i = close
                        continue
                    }
                }
            }
            if (c == 91) {
                def mid:int (indexOfFrom t "](" i)
                def close2:int (LinkCard.linkEnd(t i))
                if ((mid > i) && (close2 > 0)) {
                    out = (out + (substring t (i + 1) mid))
                    i = close2
                    continue
                }
            }
            if ((((c == 42) || (c == 95)) || (c == 96)) || (c == 126)) {
                i = (i + 1)
                continue
            }
            out = (out + (substring t i (i + 1)))
            i = (i + 1)
        }
        return (trim out)
    }

    ; past the ")" that ends a link opened by "[" at `at`, or -1
    sfn linkEnd:int (t:string at:int) {
        def mid:int (indexOfFrom t "](" at)
        if (mid < 0) {
            return -1
        }
        def close:int (indexOfFrom t ")" mid)
        if (close < 0) {
            return -1
        }
        return (close + 1)
    }

    ; a slide at rest (1-based, of the keys' view when there are keys; the
    ; first when slide is 0) as JPEG `width` pixels wide; empty when the
    ; deck has no card or no slide could be drawn
    sfn image:buffer (host:McpHost id:string keys:string slide:int width:int) {
        def none:buffer (buffer_from_string "")
        def sh:Shown (LinkCard.shown(host id))
        def doc:MfJ sh.doc
        if ((doc.isObj()) == false) {
            return none
        }
        def d:PresDeck (LinkCard.deckOf(host doc sh.id (LinkCard.keysOf(keys))))
        def n:int (d.slideCount())
        if (n == 0) {
            return none
        }
        def groups:[int]
        def list:string ((d.slideList((LinkCard.indexOf(slide n)) groups 0.0)).toJson())
        return (host_render_still host list d.pageW d.pageH width)
    }
}
