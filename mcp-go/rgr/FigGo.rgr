; DesignViewer (the Figma reader) on its own, compiled by gen.mjs to the Go
; package figdv. It is a compile of its own like PresDataGo.rgr: it brings
; its own copy of EVG and the zip/zstd readers, and the server only ever
; hands it bytes and takes strings back.
;
; Two jobs, at two different times:
;
;   open + index + cut    once, when a .fig is put in the shared files: the
;                         whole file is read, and what is kept is the index
;                         and one EVG document per screen (sharedfiles.go)
;   view                  whenever a screen or a part is drawn: one screen's
;                         cut is laid out and walked into a display list for
;                         render.go to paint; the file is not opened
;   vary*                 a variation of a file (sharedvariation.go): the
;                         original's bytes and the variation's JSON in, the
;                         file it makes, an edited variation, the layers to
;                         aim an edit at, or one view as a file of its own out
;   blank                 a new file from nothing: one empty page, which a
;                         variation then adds layers to (FigBuild)
;
; Everything is static so Go outside the package can call it
; (FigGo_static_open, …): Ranger's methods come out unexported.

Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGTreeJson.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "../designviewer/src/FigParser.rgr"
Import "../designviewer/src/convert/FigToScene.rgr"
Import "../designviewer/src/index/FigIndex.rgr"
Import "../designviewer/src/index/FigCut.rgr"
Import "../designviewer/src/edit/FigVariation.rgr"

class FigGoDoc {
    def ok:boolean false
    def err:string ""
    def doc:FigDoc (new FigDoc())
    def index:FigIndex (new FigIndex())
    def cutter@(optional):FigCutter

    Constructor () {
    }
}

class FigGo {
    sfn open:FigGoDoc (bytes:buffer name:string) {
        def d (new FigGoDoc())
        def p (new FigParser())
        def doc:FigDoc (p.parseBytes(bytes name))
        if (doc.ok == false) {
            d.err = doc.err
            if ((strlen d.err) == 0) {
                d.err = "not a Figma file"
            }
            return d
        }
        def conv (new FigToScene())
        def scene:SceneDocument (conv.convertDoc(doc))
        d.doc = doc
        d.index = (FigIndex.build(doc scene))
        d.cutter = (new FigCutter(scene))
        d.ok = true
        return d
    }

    sfn ok:boolean (d:FigGoDoc) {
        return d.ok
    }

    sfn err:string (d:FigGoDoc) {
        return d.err
    }

    sfn indexJson:string (d:FigGoDoc) {
        return (d.index.toJson())
    }

    sfn screenIds:[string] (d:FigGoDoc) {
        def out:[string]
        def i:int 0
        while (i < (array_length d.index.screens)) {
            def s:FigIndexScreen (itemAt d.index.screens i)
            push out s.id
            i = (i + 1)
        }
        return out
    }

    ; One screen as an EVG document, or "" when the file has no such layer.
    ; Layer `id` cut out once (FigCutter): its JSON and its pictures are
    ; read from that one cut, as cutting a screen is most of reading a file.
    sfn cutOf:FigCut (d:FigGoDoc id:string) {
        if (null? d.cutter) {
            return (new FigCut())
        }
        def cutter:FigCutter (unwrap d.cutter)
        return (cutter.cut(id))
    }

    ; The cut's JSON, "" when the layer could not be cut.
    sfn cutJson:string (c:FigCut) {
        if (c.ok == false) {
            return ""
        }
        return c.json
    }

    ; The pictures the cut paints, by the names of the file's images/.
    sfn cutImages:[string] (c:FigCut) {
        return c.images
    }

    ; The cut of layer `id` as JSON (cutOf + cutJson).
    sfn cut:string (d:FigGoDoc id:string) {
        return (FigGo.cutJson((FigGo.cutOf(d id))))
    }

    sfn imageBytes:buffer (d:FigGoDoc name:string) {
        def i:int 0
        while (i < (array_length d.doc.images)) {
            def im:FigImage (itemAt d.doc.images i)
            if (im.name == name) {
                return im.bytes
            }
            i = (i + 1)
        }
        return (buffer_alloc 0)
    }

    ; A cut laid out, as the display list render.go paints, after one line
    ; "x y w h W H": the box of layer `id` in it (the whole cut when `id` is
    ; "" or the cut's own top layer) and the size of the cut. "" when the
    ; document does not read or has no such layer.
    sfn view:string (cutJson:string id:string) {
        def ro@(optional):EVGElement (EVGTreeJson.fromText(cutJson))
        if (null? ro) {
            return ""
        }
        def root:EVGElement (unwrap ro)
        ; The cut's root says its size in pixels; the page only has to be
        ; big enough not to matter.
        def layout (new EVGLayout())
        layout.setPageSize(16384.0 16384.0)
        layout.layout(root)
        def cw:double root.calculatedWidth
        def ch:double root.calculatedHeight
        if ((cw <= 0.0) || (ch <= 0.0)) {
            return ""
        }
        def bx:double 0.0
        def by:double 0.0
        def bw:double cw
        def bh:double ch
        if ((strlen id) > 0) {
            def eo@(optional):EVGElement (FigGo.findId(root id))
            if (null? eo) {
                return ""
            }
            def el:EVGElement (unwrap eo)
            if ((array_length root.children) > 0) {
                def top:EVGElement (itemAt root.children 0)
                if (top.id != id) {
                    bx = el.calculatedX
                    by = el.calculatedY
                    bw = el.calculatedWidth
                    bh = el.calculatedHeight
                }
            }
        }
        def list (new EVGDisplayList())
        list.setTextEngine((layout.getTextEngine()))
        list.build(root)
        def head:string ((FigIndex.num(bx)) + " " + (FigIndex.num(by)) + " " + (FigIndex.num(bw)) + " " + (FigIndex.num(bh)))
        head = (head + " " + (FigIndex.num(cw)) + " " + (FigIndex.num(ch)))
        return (head + "\n" + (list.toJson()))
    }

    sfn findId@(optional):EVGElement (el:EVGElement id:string) {
        def r@(optional):EVGElement
        if (el.id == id) {
            r = el
            return r
        }
        def i:int 0
        while (i < (array_length el.children)) {
            def hit@(optional):EVGElement (FigGo.findId((itemAt el.children i) id))
            if (!null? hit) {
                return hit
            }
            i = (i + 1)
        }
        return r
    }
}

; What a vary* call gives back. One class for all of them, read through
; FigGo's accessors as Go outside the package cannot read its fields.
class FigGoVary {
    def ok:boolean false
    def err:string ""
    def bytes:buffer (buffer_alloc 0)
    def text:string ""
    def summary:string ""
    def errors:[string]
    def created:[string]

    Constructor () {
    }
}

class FigGoEdit {
    ; The original with variation `delta` applied, or the reason it could
    ; not open. Nodes the variation names and the file lacks are noted.
    sfn applied:FigEditDoc (bytes:buffer name:string delta:string out:FigGoVary) {
        def d:FigEditDoc (FigEditDoc.open(bytes name))
        if (d.ok == false) {
            out.err = d.err
            return d
        }
        def v:FigVariation (FigVariation.parse(delta))
        v.applyTo(d)
        def i:int 0
        while (i < (array_length v.errors)) {
            push out.errors (itemAt v.errors i)
            i = (i + 1)
        }
        out.summary = (v.summary())
        return d
    }

    ; A new, empty file: a document with one page called `page`. A file
    ; made here is a variation of this one.
    sfn blank:buffer (name:string page:string) {
        return (FigBuild.blank(name page))
    }

    ; The file the variation makes.
    sfn file:FigGoVary (bytes:buffer name:string delta:string) {
        def out (new FigGoVary())
        def d:FigEditDoc (FigGoEdit.applied(bytes name delta out))
        if (d.ok == false) {
            return out
        }
        out.bytes = (d.toFig())
        out.ok = true
        return out
    }

    ; `ops` (a JSON list of edits) made to the variation → its new JSON in
    ; text, what it changes in summary, refused ops in errors, the guids of
    ; copies made in created.
    sfn edit:FigGoVary (bytes:buffer name:string delta:string ops:string) {
        def out (new FigGoVary())
        def p (new KiwiJson())
        def list:KiwiValue (p.read(ops))
        if ((p.ok == false) || ((list.isArray()) == false)) {
            out.err = ("edits must be a JSON list: " + p.err)
            return out
        }
        def base:FigEditDoc (FigEditDoc.open(bytes name))
        if (base.ok == false) {
            out.err = base.err
            return out
        }
        def work:FigEditDoc (FigEditDoc.open(bytes name))
        def v:FigVariation (FigVariation.parse(delta))
        v.applyTo(work)
        def stale:int (array_length v.errors)
        v.edit(base work list)
        def i:int stale
        while (i < (array_length v.errors)) {
            push out.errors (itemAt v.errors i)
            i = (i + 1)
        }
        out.created = v.created
        out.text = (v.toJson())
        out.summary = (v.summary())
        out.ok = true
        return out
    }

    ; The layers under `node` in the variation (the whole page list for
    ; ""), or with `raw` that one node's own fields.
    sfn layers:FigGoVary (bytes:buffer name:string delta:string node:string depth:int raw:boolean) {
        def out (new FigGoVary())
        def d:FigEditDoc (FigGoEdit.applied(bytes name delta out))
        if (d.ok == false) {
            return out
        }
        def id:string node
        if ((strlen id) == 0) {
            id = "0:0"
            def all:[string] (d.allIds())
            def i:int 0
            while (i < (array_length all)) {
                if ((d.typeOf((itemAt all i))) == "DOCUMENT") {
                    id = (itemAt all i)
                }
                i = (i + 1)
            }
        }
        if ((d.exists(id)) == false) {
            out.err = ("no layer " + id + " in this file")
            return out
        }
        if raw {
            out.text = (d.nodeJson(id))
        } {
            out.text = (d.layersJson(id depth 400))
        }
        out.ok = true
        return out
    }

    ; Layer `node` of the variation as a file of its own.
    sfn extract:FigGoVary (bytes:buffer name:string delta:string node:string) {
        def out (new FigGoVary())
        def d:FigEditDoc (FigGoEdit.applied(bytes name delta out))
        if (d.ok == false) {
            return out
        }
        def why:string (d.extract(node))
        if ((strlen why) > 0) {
            out.err = why
            return out
        }
        out.bytes = (d.toFigTrimmed())
        out.ok = true
        return out
    }

    sfn ok:boolean (v:FigGoVary) {
        return v.ok
    }

    sfn err:string (v:FigGoVary) {
        return v.err
    }

    sfn bytes:buffer (v:FigGoVary) {
        return v.bytes
    }

    sfn text:string (v:FigGoVary) {
        return v.text
    }

    sfn summary:string (v:FigGoVary) {
        return v.summary
    }

    sfn errors:[string] (v:FigGoVary) {
        return v.errors
    }

    sfn created:[string] (v:FigGoVary) {
        return v.created
    }
}
