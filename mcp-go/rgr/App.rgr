; =============================================================================
; The Sliqtly MCP server: /mcp, with sign-in the OAuth endpoints, and the
; site's visit beacon /api/hit. Compiled to Go; ../host.go hands every request to App.serve with
; an McpHost for it.
;
; Streamable HTTP, stateless. A browser opening /mcp is sent to the
; instructions page. Sign-in is optional: see OAuth.rgr.
; =============================================================================

Import "McpHost.rgr"
Import "McpJson.rgr"
Import "OAuth.rgr"
Import "Tools.rgr"
Import "Mcp.rgr"
Import "Stats.rgr"
Import "View.rgr"
; questionnaires: what forms.go asks the model
Import "Forms.rgr"
; a deck's words for the Rooms search (searchapi.go)
Import "../markdown/src/MdSearchText.rgr"

class App {
    sfn cors:void (res:HttpResponse) {
        http_set_header res "Access-Control-Allow-Origin" "*"
        http_set_header res "Access-Control-Allow-Headers" "content-type, mcp-session-id, mcp-protocol-version, authorization, last-event-id"
        http_set_header res "Access-Control-Expose-Headers" "mcp-session-id, mcp-protocol-version, www-authenticate"
        http_set_header res "Access-Control-Allow-Methods" "GET, POST, DELETE, OPTIONS"
    }

    sfn sendJson:void (res:HttpResponse status:int body:string) {
        http_set_header res "Content-Type" "application/json; charset=utf-8"
        http_set_status res status
        http_send res body
    }

    sfn redirect:void (res:HttpResponse url:string) {
        http_set_header res "Location" url
        http_set_status res 302
    }

    sfn send:void (res:HttpResponse out:HttpOut) {
        if ((strlen out.redirect) > 0) {
            App.redirect(res out.redirect)
            return
        }
        if ((strlen out.text) > 0) {
            http_set_header res "Content-Type" "text/plain; charset=utf-8"
            http_set_status res out.status
            http_send res out.text
            return
        }
        if out.noStore {
            http_set_header res "Cache-Control" "no-store"
        }
        App.sendJson(res out.status (JOut.text(out.json)))
    }

    ; The site's own addresses: the OAuth issuer and the resource follow the
    ; one the client used, so both domains work.
    sfn originOf:string (host:McpHost req:HttpRequest) {
        def base:string (host_base_url host)
        def h:string (http_get_header req "X-Forwarded-Host")
        if ((strlen h) == 0) {
            h = (http_get_header req "Host")
        }
        if ((strlen h) == 0) {
            h = (http_request_host req)
        }
        def comma:int (indexOf h ",")
        if (comma >= 0) {
            h = (substring h 0 comma)
        }
        h = (trim h)
        def https:string ("https://" + h)
        if (((https == "https://sliqtly.com") || (https == "https://sliqtly.web.app")) || (https == base)) {
            return https
        }
        if ((host_trust_host host) && ((strlen h) > 0)) {
            if (host_tls host) {
                return ("https://" + h)
            }
            return ("http://" + h)
        }
        return base
    }

    ; the caller's address: X-Forwarded-For read from the right past our
    ; own proxies (clientip.go); its first value is the client's own text
    sfn clientIp:string (host:McpHost req:HttpRequest) {
        return (host_client_ip host)
    }

    ; The page's visit beacon (web/main.js countVisit, Stats.rgr): counted
    ; only when it comes from the site itself. Always 204, so the page learns
    ; nothing; the answer waits for the write.
    ; the public viewer's deck (View.rgr): the same for everyone who has the
    ; link, so a minute in the CDN's cache (Hosting keeps a rewrite's answer
    ; by its Cache-Control) spares the layout for the next reader
    sfn serveView:void (host:McpHost req:HttpRequest res:HttpResponse id:string) {
        def q:MfJ (J.parse((http_query_json req)))
        def uid:string (App.pageUser(host req))
        def body:string (View.json(host id (q.str_("slides")) uid))
        if ((strlen body) == 0) {
            http_set_header res "Cache-Control" "no-store"
            App.sendJson(res 404 "{\"error\":\"This shared presentation was not found.\"}")
            return
        }
        ; shown to a signed-in page: maybe a private deck, never cached
        if ((strlen uid) > 0) {
            http_set_header res "Cache-Control" "private, no-store"
        } {
            http_set_header res "Cache-Control" "public, max-age=30, s-maxage=60"
        }
        App.sendJson(res 200 body)
    }

    ; GET /api/view/<id>/pic?path=<path>&v=<stamp>: a picture of the deck
    ; made for the viewer's screen (ViewPictures), kept by the CDN for good
    ; under its stamp
    sfn servePicture:void (host:McpHost req:HttpRequest res:HttpResponse id:string what:string) {
        def q:MfJ (J.parse((http_query_json req)))
        def p:ViewPic (new ViewPic)
        if (what == "pic") {
            p = (ViewPictures.picture(host id (q.str_("path")) (q.str_("v"))))
        }
        if (p.status == 302) {
            http_set_header res "Cache-Control" "public, max-age=0, s-maxage=60"
            App.redirect(res p.url)
            return
        }
        if (p.status != 200) {
            http_set_header res "Cache-Control" "no-store"
            App.sendJson(res 404 "{\"error\":\"This picture was not found.\"}")
            return
        }
        http_set_header res "Content-Type" p.type
        http_set_header res "Cache-Control" "public, max-age=31536000, s-maxage=31536000, immutable"
        http_set_header res "X-Content-Type-Options" "nosniff"
        http_set_status res 200
        http_send_buffer res p.bytes
    }

    ; GET /s/<id>[?slide=<n>][&slides=<keys>]: the viewer's page (Hosting's
    ; index.html) with the deck's link card in its head (LinkCard), the
    ; slide's own with ?slide=, for the previews chat apps draw
    ; without running the page. A private or missing deck gets the page as
    ; it is. Without the page (the site did not answer) the reader goes to
    ; the same viewer by #share=<id>.
    sfn servePage:void (host:McpHost req:HttpRequest res:HttpResponse rest:string) {
        def id:string rest
        if ((lastIndexOf id "/") == ((strlen id) - 1)) {
            id = (substring id 0 ((strlen id) - 1))
        }
        if ((((strlen id) < 6) || ((strlen id) > 32)) || ((Deck.allAlnum(id)) == false)) {
            http_set_header res "Content-Type" "text/plain; charset=utf-8"
            http_set_status res 404
            http_send res "Not found"
            return
        }
        def q:MfJ (J.parse((http_query_json req)))
        def card:string (LinkCard.json(host id (q.str_("slides")) (App.slideOf(q))))
        def page:string (host_viewer_page host id card)
        if ((strlen page) == 0) {
            http_set_header res "Cache-Control" "no-store"
            App.redirect(res ("/#share=" + id))
            return
        }
        ; the page is the same for every reader; a minute in the CDN
        http_set_header res "Cache-Control" "public, max-age=0, s-maxage=60"
        http_set_header res "Content-Type" "text/html; charset=utf-8"
        http_set_status res 200
        http_send res page
    }

    ; ?slide=<n>: a link to one slide, 1-based; 0 for none (or not a number)
    sfn slideOf:int (q:MfJ) {
        def n:int (?? (str2int (trim (q.str_("slide")))) 0)
        if ((n < 1) || (n > 9999)) {
            return 0
        }
        return n
    }

    ; GET /api/card/<id>.jpg?v=<stamp>[&slide=<n>][&slides=<keys>]: the
    ; card's picture, the first slide or the one the link names.
    ; Drawn once per change of the deck (the stamp in its address; another
    ; stamp is sent to the current one), kept per instance and a day in the
    ; CDN, so a link pasted in many chats is not drawn again for each.
    sfn serveCard:void (host:McpHost req:HttpRequest res:HttpResponse rest:string) {
        def id:string rest
        if ((indexOf id ".jpg") == ((strlen id) - 4)) {
            id = (substring id 0 ((strlen id) - 4))
        }
        def doc:MfJ (LinkCard.shown(host id)).doc
        if ((doc.isObj()) == false) {
            http_set_header res "Cache-Control" "no-store"
            App.sendJson(res 404 "{\"error\":\"This shared presentation was not found.\"}")
            return
        }
        def stamp:string (LinkCard.stamp(doc))
        def q:MfJ (J.parse((http_query_json req)))
        def keys:string (LinkCard.keysOf((q.str_("slides"))))
        def slide:int (App.slideOf(q))
        def more:string ""
        if (slide > 1) {
            more = ("&slide=" + (to_string slide))
        }
        if ((strlen keys) > 0) {
            more = (more + "&slides=" + keys)
        }
        if ((q.str_("v")) != stamp) {
            http_set_header res "Cache-Control" "public, max-age=0, s-maxage=60"
            App.redirect(res ("/api/card/" + id + ".jpg?v=" + stamp + more))
            return
        }
        def key:string (id + "-" + stamp + more)
        def jpg:buffer (host_card_get host key)
        if ((buffer_length jpg) == 0) {
            if ((host_card_slot host) == false) {
                http_set_header res "Cache-Control" "no-store"
                http_set_header res "Retry-After" "5"
                App.sendJson(res 503 "{\"error\":\"Busy drawing; try again in a moment.\"}")
                return
            }
            jpg = (LinkCard.image(host id keys slide 1200))
            host_render_done host "card"
            if ((buffer_length jpg) == 0) {
                http_set_header res "Cache-Control" "no-store"
                App.sendJson(res 404 "{\"error\":\"This presentation has no slide to show.\"}")
                return
            }
            host_card_put host key jpg
        }
        http_set_header res "Cache-Control" "public, max-age=86400, s-maxage=86400, immutable"
        http_set_header res "Content-Type" "image/jpeg"
        http_set_header res "X-Content-Type-Options" "nosniff"
        http_set_status res 200
        http_send_buffer res jpg
    }

    ; the Google account signed in on the viewer page: a Firebase ID token
    ; as "Authorization: Bearer <token>", verified; "" without one
    sfn pageUser:string (host:McpHost req:HttpRequest) {
        def h:string (http_get_header req "Authorization")
        if ((indexOf h "Bearer ") != 0) {
            return ""
        }
        def token:string (trim (substring h 7 (strlen h)))
        if ((strlen token) == 0) {
            return ""
        }
        def who:MfJ (J.parse((host_verify_id_token host token)))
        return (who.str_("uid"))
    }

    ; GET /api/export/<id>/<format>: the viewer's download (ViewExport).
    ; Drawing a file costs as a render does: counted per address, two at once.
    sfn serveExport:void (host:McpHost req:HttpRequest res:HttpResponse rest:string) {
        def slash:int (indexOf rest "/")
        def id:string rest
        def format:string ""
        if (slash > 0) {
            id = (substring rest 0 slash)
            format = (substring rest (slash + 1) (strlen rest))
        }
        http_set_header res "Cache-Control" "no-store"
        def ip:string (App.clientIp(host req))
        def draws:boolean ((format == "pdf") || (format == "pptx"))
        if draws {
            def why:string (host_render_limit host ip ip)
            if ((strlen why) > 0) {
                App.sendJson(res 429 (JOut.text((App.errorObj(why)))))
                return
            }
        }
        def q:MfJ (J.parse((http_query_json req)))
        def f:ViewFile (ViewExport.file(host id format (q.str_("slides")) (App.pageUser(host req))))
        if draws {
            host_render_done host ip
        }
        if (f.status != 200) {
            App.sendJson(res f.status (JOut.text((App.errorObj(f.why)))))
            return
        }
        http_set_header res "Content-Type" f.type
        http_set_header res "Content-Disposition" (host_attachment host f.name)
        http_set_header res "X-Content-Type-Options" "nosniff"
        http_set_status res 200
        http_send_buffer res f.bytes
    }

    sfn errorObj:MfJ (why:string) {
        def o:MfJ (MfJ.newObj())
        o.putStr("error" why)
        return o
    }

    sfn serveHit:void (host:McpHost req:HttpRequest res:HttpResponse) {
        def body:string (host_body_json host)
        def origin:string (http_get_header req "Origin")
        def base:string (host_base_url host)
        def ours:boolean (((origin == "https://sliqtly.com") || (origin == "https://sliqtly.web.app")) || (origin == base))
        if ((host_trust_host host) && ((strlen origin) > 0)) {
            ours = true
        }
        if ((host_store_kind host) != "cloud") {
            ours = false
        }
        if ours {
            def ip:string (App.clientIp(host req))
            if ((strlen (host_hit_limit host ip)) == 0) {
                def counted:boolean (Stats.hit(host ip (http_get_header req "User-Agent") (J.parse(body))))
                if ((strlen (host_error host)) > 0) {
                    host_log host ("hit failed: " + (host_error host))
                }
            }
        }
        http_set_status res 204
    }

    sfn rpcError:string (code:int message:string) {
        return (JOut.text((Mcp.error((new MfJ) code message))))
    }

    sfn serve:void (host:McpHost req:HttpRequest res:HttpResponse) {
        App.cors(res)
        def method:string (http_get_method req)
        def path:string (http_get_path req)
        if (method == "OPTIONS") {
            http_set_status res 204
            return
        }
        if (host_oauth host) {
            if (App.serveOAuth(host req res method path)) {
                return
            }
        }
        if (path == "/mcp") {
            App.serveMcp(host req res method)
            return
        }
        if ((path == "/api/hit") && (method == "POST")) {
            App.serveHit(host req res)
            return
        }
        if (((method == "GET") || (method == "HEAD")) && ((indexOf path "/api/view/") == 0)) {
            def rest:string (substring path 10 (strlen path))
            def slash:int (indexOf rest "/")
            if (slash > 0) {
                App.servePicture(host req res (substring rest 0 slash) (substring rest (slash + 1) (strlen rest)))
                return
            }
            App.serveView(host req res rest)
            return
        }
        if (((method == "GET") || (method == "HEAD")) && ((indexOf path "/s/") == 0)) {
            App.servePage(host req res (substring path 3 (strlen path)))
            return
        }
        if (((method == "GET") || (method == "HEAD")) && ((indexOf path "/api/card/") == 0)) {
            App.serveCard(host req res (substring path 10 (strlen path)))
            return
        }
        if (((method == "GET") || (method == "HEAD")) && ((indexOf path "/api/export/") == 0)) {
            App.serveExport(host req res (substring path 12 (strlen path)))
            return
        }
        http_set_header res "Content-Type" "text/plain; charset=utf-8"
        http_set_status res 404
        http_send res ("Cannot " + method + " " + path)
    }

    ; true when the path was an OAuth one
    sfn serveOAuth:boolean (host:McpHost req:HttpRequest res:HttpResponse method:string path:string) {
        if (method == "GET") {
            if ((path == "/.well-known/oauth-protected-resource") || (path == "/.well-known/oauth-protected-resource/mcp")) {
                App.sendJson(res 200 (JOut.text((OAuth.resourceMetadata((App.originOf(host req)))))))
                return true
            }
            if ((path == "/.well-known/oauth-authorization-server") || (path == "/.well-known/openid-configuration")) {
                App.sendJson(res 200 (JOut.text((OAuth.metadata((App.originOf(host req)))))))
                return true
            }
            if (path == "/oauth/authorize") {
                def q:MfJ (J.parse((http_query_json req)))
                App.send(res (OAuth.authorize(host q (App.originOf(host req)))))
                return true
            }
            return false
        }
        if (method != "POST") {
            return false
        }
        if (((path != "/oauth/register") && (path != "/oauth/approve")) && (path != "/oauth/token")) {
            return false
        }
        def body:MfJ (J.parse((host_body_json host)))
        if ((body.isObj()) == false) {
            body = (MfJ.newObj())
        }
        if (path == "/oauth/register") {
            App.send(res (OAuth.register(host body)))
        }
        if (path == "/oauth/approve") {
            App.send(res (OAuth.approve(host body)))
        }
        if (path == "/oauth/token") {
            App.send(res (OAuth.token(host body)))
        }
        return true
    }

    sfn serveMcp:void (host:McpHost req:HttpRequest res:HttpResponse method:string) {
        def accept:string (http_get_header req "Accept")
        if ((method == "GET") && ((indexOf accept "text/event-stream") < 0)) {
            App.redirect(res ((host_base_url host) + "/connect.html"))
            return
        }
        def sid:string (http_get_header req "Mcp-Session-Id")
        if (method == "DELETE") {
            ; the client ends its session: what it held (decks made without
            ; sign-in) can no longer be changed
            Store.sessionEnd(host (Store.sessionKey(host sid)))
            if ((strlen (host_error host)) > 0) {
                host_log host ("session end failed: " + (host_error host))
            }
            http_set_status res 204
            return
        }
        if (method != "POST") {
            http_set_header res "Allow" "POST, DELETE"
            App.sendJson(res 405 (App.rpcError(-32000 "Method not allowed: POST, or DELETE to end the session.")))
            return
        }
        ; no token: anonymous; a token that does not hold: 401, so the client
        ; refreshes it or signs in again
        def caller (new Caller)
        if (host_oauth host) {
            def origin:string (App.originOf(host req))
            def w:Who (OAuth.who(host (http_get_header req "Authorization")))
            if (w.state == 3) {
                host_log host ("token check failed: " + (host_error host))
                App.sendJson(res 500 (App.rpcError(-32603 "Internal error")))
                return
            }
            if (w.state == 2) {
                http_set_header res "WWW-Authenticate" ("Bearer error=\"invalid_token\", resource_metadata=\"" + origin + "/.well-known/oauth-protected-resource/mcp\"")
                App.sendJson(res 401 (App.rpcError(-32001 "The sign-in has expired.")))
                return
            }
            if (w.state == 1) {
                caller.signedIn = true
                caller.uid = w.uid
                caller.name = w.name
            }
            caller.signIn = (origin + "/.well-known/oauth-protected-resource/mcp")
        }
        def local:string (host_local_user host)
        if ((strlen local) > 0) {
            caller.signedIn = true
            caller.uid = local
            caller.name = local
        }
        caller.who = (App.clientIp(host req))
        caller.ip = caller.who
        if caller.signedIn {
            caller.who = ("uid:" + caller.uid)
        }
        ; the session: a new one (256 random bits) when the client brings
        ; none; it comes back in Mcp-Session-Id, never in a URL. Only its
        ; hash is kept, with what it may change (Store.rgr).
        if ((strlen sid) == 0) {
            sid = (host_short_id host 44)
            http_set_header res "Mcp-Session-Id" sid
        }
        caller.session = (Store.sessionKey(host sid))
        ; what the transport asks of a client
        if (((indexOf accept "application/json") < 0) || ((indexOf accept "text/event-stream") < 0)) {
            App.sendJson(res 406 (App.rpcError(-32000 "Not Acceptable: Client must accept both application/json and text/event-stream")))
            return
        }
        if ((indexOf (to_lowercase (http_get_header req "Content-Type")) "application/json") < 0) {
            App.sendJson(res 415 (App.rpcError(-32000 "Unsupported Media Type: Content-Type must be application/json")))
            return
        }
        def pv:string (http_get_header req "Mcp-Protocol-Version")
        if (((strlen pv) > 0) && ((Deck.inList((Mcp.VERSIONS()) pv)) == false)) {
            App.sendJson(res 400 (App.rpcError(-32000 ("Bad Request: Unsupported protocol version: " + pv))))
            return
        }
        def reply:McpReply (Mcp.post(host caller (host_body_json host)))
        if (reply.status == 202) {
            http_set_status res 202
            return
        }
        App.sendJson(res reply.status reply.body)
    }
}
