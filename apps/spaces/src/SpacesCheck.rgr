; SPDX-License-Identifier: AGPL-3.0-or-later
; Node checks for the Spaces model: `npm run check` in apps/spaces.

Import "SpacesModel.rgr"
Import "SpacesVocab.rgr"
Import "SpacesAssist.rgr"
Import "SpacesRemote.rgr"
Import "SpacesTypes.rgr"
Import "SpacesBudget.rgr"
Import "../evgui/src/UiDate.rgr"

class SpacesCheck {
    def passes:int 0
    def fails:int 0

    fn ok:void (cond:boolean what:string) {
        if cond {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("FAIL " + what)
        }
    }

    fn eq:void (got:string want:string what:string) {
        if (got == want) {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("FAIL " + what + ": got [" + got + "] want [" + want + "]")
        }
    }

    fn eqi:void (got:int want:int what:string) {
        this.eq((to_string got) (to_string want) what)
    }

    sfn days:string (list:[int]) {
        def parts:[string]
        def i:int 0
        while (i < (array_length list)) {
            push parts (UiDate.isoOfDays((itemAt list i)))
            i = (i + 1)
        }
        return (join parts " ")
    }

    sfn titles:string (list:[SpOccur]) {
        def parts:[string]
        def i:int 0
        while (i < (array_length list)) {
            def o:SpOccur (itemAt list i)
            push parts o.title
            i = (i + 1)
        }
        return (join parts ",")
    }

    fn rules:void () {
        def s (new SpSpace())
        ; Monday 19 October 2026
        def mon:int (UiDate.toDays(2026 10 19))
        this.eqi((UiDate.weekday(mon)) 1 "19.10.2026 is a Monday")
        this.eqi((SpSpace.mondayOf((mon + 6))) mon "Sunday's Monday")
        this.eqi((SpSpace.mondayOf(mon)) mon "Monday's Monday")

        def once:SpEvent (s.addEvent("Once" (mon + 2) 600 660 ""))
        this.eq((SpacesCheck.days((s.daysOf(once mon (mon + 6))))) "2026-10-21" "a single event")
        this.eq((SpacesCheck.days((s.daysOf(once (mon + 3) (mon + 6))))) "" "outside the range")

        def span:SpEvent (s.addAllDay("Trip" (mon - 1) (mon + 1) ""))
        this.eq((SpacesCheck.days((s.daysOf(span mon (mon + 6))))) "2026-10-18" "an all-day span that started before the range")

        def daily:SpEvent (s.addEvent("Daily" mon 480 490 ""))
        daily.rule.freq = "daily"
        daily.rule.interval = 2
        daily.rule.count = 3
        this.eq((SpacesCheck.days((s.daysOf(daily mon (mon + 13))))) "2026-10-19 2026-10-21 2026-10-23" "daily, every other day, three times")

        def wk:SpEvent (s.addEvent("Practice" (mon + 1) 1050 1140 ""))
        wk.rule.freq = "weekly"
        wk.rule.byDay = ([] _:int ( 2 4 ))
        push wk.exdates (mon + 8)
        this.eq((SpacesCheck.days((s.daysOf(wk mon (mon + 13))))) "2026-10-20 2026-10-22 2026-10-29" "weekly Tue+Thu, one skipped")

        def fort:SpEvent (s.addEvent("Fortnight" (mon - 7) 600 630 ""))
        fort.rule.freq = "weekly"
        fort.rule.interval = 2
        this.eq((SpacesCheck.days((s.daysOf(fort mon (mon + 21))))) "2026-10-26 2026-11-09" "every other Monday from the week before")

        def until:SpEvent (s.addEvent("Until" mon 600 630 ""))
        until.rule.freq = "weekly"
        until.rule.until = (mon + 7)
        this.eq((SpacesCheck.days((s.daysOf(until mon (mon + 30))))) "2026-10-19 2026-10-26" "weekly until a day, inclusive")

        def m31:SpEvent (s.addEvent("Month end" (UiDate.toDays(2026 8 31)) 600 630 ""))
        m31.rule.freq = "monthly"
        this.eq((SpacesCheck.days((s.daysOf(m31 (UiDate.toDays(2026 9 1)) (UiDate.toDays(2027 1 31)))))) "2026-10-31 2026-12-31 2027-01-31" "monthly on the 31st skips short months")

        def cnt:SpEvent (s.addEvent("Counted" (mon - 14) 600 630 ""))
        cnt.rule.freq = "weekly"
        cnt.rule.count = 3
        this.eq((SpacesCheck.days((s.daysOf(cnt mon (mon + 30))))) "2026-10-19" "COUNT counts from the first, not the range")
    }

    fn order:void () {
        def s (new SpSpace())
        def mon:int (UiDate.toDays(2026 10 19))
        s.addEvent("Late" mon 900 960 "")
        s.addEvent("early" mon 480 500 "")
        s.addAllDay("All day" mon mon "")
        s.addEvent("Tomorrow" (mon + 1) 400 420 "")
        s.addEvent("Also early" mon 480 500 "")
        this.eq((SpacesCheck.titles((s.occurrences(mon (mon + 1))))) "All day,Also early,early,Late,Tomorrow" "sorted: day, all-day, start, title")
        def wk:SpEvent (s.addEvent("Rep" mon 600 630 ""))
        wk.rule.freq = "daily"
        def occ:[SpOccur] (s.occurrences((mon + 1) (mon + 1)))
        def found:string ""
        def i:int 0
        while (i < (array_length occ)) {
            def o:SpOccur (itemAt occ i)
            if (o.title == "Rep") {
                found = o.id
            }
            i = (i + 1)
        }
        this.eq(found (wk.id + "@" + (to_string (mon + 1))) "an occurrence of a repeating event is id@day")
    }

    fn summary:void () {
        def s (new SpSpace())
        ; Wednesday 21 October 2026
        def wed:int (UiDate.toDays(2026 10 21))
        s.addEvent("Today" wed 600 660 "")
        s.addEvent("Friday" (wed + 2) 600 660 "")
        s.addEvent("Next Monday" (wed + 5) 600 660 "")
        s.addEvent("Next Sunday" (wed + 11) 600 660 "")
        s.addEvent("Too far" (wed + 12) 600 660 "")
        s.addEvent("Yesterday" (wed - 1) 600 660 "")
        s.addDeadline("Due Thursday" (wed + 1) "")
        def late:SpDeadline (s.addDeadline("Was due" (wed - 2) ""))
        def done:SpDeadline (s.addDeadline("Done" (wed + 1) ""))
        done.done = true
        def r:[SpRange] (s.summary(wed))
        this.eqi((array_length r) 3 "three sections")
        def r0:SpRange (itemAt r 0)
        def r1:SpRange (itemAt r 1)
        def r2:SpRange (itemAt r 2)
        this.eq((SpacesCheck.titles(r0.items)) "Today" "today")
        this.eq((SpacesCheck.titles(r1.items)) "Friday" "rest of this week")
        this.eqi((array_length r1.deadlines) 1 "a deadline this week, the done one left out")
        this.eq((SpacesCheck.titles(r2.items)) "Next Monday,Next Sunday" "next week, Monday to Sunday")
        this.eqi((array_length (s.overdue(wed))) 1 "one overdue")
        def od:SpDeadline (itemAt (s.overdue(wed)) 0)
        this.eq(od.title late.title "the overdue one")
        def sun:SpRange (itemAt (s.summary((wed + 4))) 1)
        this.ok(((sun.isEmpty()) && (sun.to < sun.from)) "on a Sunday the rest of the week is empty")
    }

    fn sheets:void () {
        def tsv:string "Päivä\tAika\tMitä\tKuka\n20.10.2026\t17.15\tKyyti\tMia\n21.10.\t9.00-10.30\tPalaveri\tleo\nei päivää\t\tOhitetaan\t\n"
        def sh:SpSheet (SpSheet.parse("" "Vuorot" tsv))
        this.eqi((array_length sh.cols) 4 "tab-separated: four columns")
        this.eqi((sh.rowCount()) 3 "three rows")
        this.eq((sh.cell(1 2)) "Palaveri" "a cell")
        def s (new SpSpace())
        s.today = (UiDate.toDays(2026 10 19))
        s.addResource("mia" "Mia" "rose")
        s.addResource("leo" "Leo" "blue")
        s.addSheet(sh)
        def ev:[SpEvent] (s.sheetEvents(sh))
        this.eqi((array_length ev) 2 "rows with a date become events")
        def a:SpEvent (itemAt ev 0)
        this.eq((UiDate.isoOfDays(a.day)) "2026-10-20" "d.m.yyyy")
        this.eqi(a.startMin 1035 "17.15")
        this.eqi(a.endMin 1095 "an hour when no end is given")
        this.eq(a.resource "mia" "who, by name")
        def b:SpEvent (itemAt ev 1)
        this.eq((UiDate.isoOfDays(b.day)) "2026-10-21" "d.m. in the space's year")
        this.eqi(b.endMin 630 "a range of times")
        this.eq(b.resource "leo" "who, any case")
        this.eq(b.source sh.id "the sheet it came from")
        this.eqi((array_length (s.occurrences(s.today (s.today + 6)))) 2 "sheet rows in the occurrences")

        def csv:string "Date;Title;Who\n2026-10-22;\"Kick-off; part 1\";Mia\r\n"
        def c:SpSheet (SpSheet.parse("c" "Fi CSV" csv))
        this.eqi((array_length c.cols) 3 "semicolons when the first line has more of them")
        this.eq((c.cell(0 1)) "Kick-off; part 1" "a quoted cell keeps its separator")
        this.eq((c.cell(0 2)) "Mia" "CRLF dropped")
        def q:SpSheet (SpSheet.parse("q" "Quoted" "a,b\n\"x, \"\"y\"\"\",\"two\nlines\"\n"))
        this.eq((q.cell(0 0)) "x, \"y\"" "doubled quotes")
        this.eq((q.cell(0 1)) "two\nlines" "a line break inside quotes")
        this.eq((q.toCsv()) "a,b\n\"x, \"\"y\"\"\",\"two\nlines\"\n" "CSV out round-trips")
        def nodate:SpSheet (SpSheet.parse("n" "Items" "Name,Count\nTent,1\n"))
        this.eqi((array_length (s.sheetEvents(nodate))) 0 "a sheet without a date column gives no events")
        this.eqi((SpText.minuteOf("24")) 1440 "24 is midnight")
        this.eqi((SpText.minuteOf("9:75")) -1 "a bad minute")
        this.eqi((SpText.dayOf("31.2.2026" 2026)) -1 "a day the month has not")
        this.eq((UiDate.isoOfDays((SpText.dayOf("10/22/2026" 2026)))) "2026-10-22" "m/d/yyyy")
    }

    fn moves:void () {
        def s (new SpSpace())
        def mon:int (UiDate.toDays(2026 10 19))
        def one:SpEvent (s.addEvent("One" mon 600 660 ""))
        this.ok((s.moveOccurrence(one.id (mon + 1) 720 750)) "a single event moves")
        this.ok((((one.day == (mon + 1)) && (one.startMin == 720)) && (one.endMin == 750)) "to the new day and time")
        def rep:SpEvent (s.addEvent("Rep" mon 540 600 "x"))
        rep.rule.freq = "weekly"
        def before:int (array_length s.events)
        this.ok((s.moveOccurrence((rep.id + "@" + (to_string (mon + 7))) (mon + 8) 600 660)) "one day of a repeating event moves")
        this.eq((SpacesCheck.days((s.daysOf(rep mon (mon + 14))))) "2026-10-19 2026-11-02" "that day is skipped")
        this.eqi((array_length s.events) (before + 1) "and is an event of its own")
        def made:SpEvent (itemAt s.events before)
        this.ok(((made.day == (mon + 8)) && ((made.title == "Rep") && (made.resource == "x"))) "with the same title and resource")
        this.ok(((s.moveOccurrence("s1-r1" mon 600 660)) == false) "a sheet row is the sheet's")
    }

    fn seeds:void () {
        def today:int (UiDate.toDays(2026 10 21))
        def packs:[string] (SpWords.packs())
        def i:int 0
        while (i < (array_length packs)) {
            def pack:string (itemAt packs i)
            def langs:[string] (SpWords.langs())
            def k:int 0
            while (k < (array_length langs)) {
                def lang:string (itemAt langs k)
                def s:SpSpace (SpSeed.build(pack lang today))
                def r:[SpRange] (s.summary(today))
                def tag:string (pack + "/" + lang)
                def r0:SpRange (itemAt r 0)
                def r1:SpRange (itemAt r 1)
                def r2:SpRange (itemAt r 2)
                this.ok(((array_length r0.items) > 0) (tag + ": something today"))
                this.ok(((array_length r1.items) > 0) (tag + ": something later this week"))
                this.ok(((array_length r2.items) > 0) (tag + ": something next week"))
                this.ok(((array_length (s.overdue(today))) > 0) (tag + ": something overdue"))
                this.ok(((array_length (s.sheetEvents((itemAt s.sheets 0)))) == 3) (tag + ": every sheet row has a date"))
                def withWho:int 0
                def ev:[SpEvent] (s.sheetEvents((itemAt s.sheets 0)))
                def j:int 0
                while (j < (array_length ev)) {
                    def e:SpEvent (itemAt ev j)
                    if ((strlen e.resource) > 0) {
                        withWho = (withWho + 1)
                    }
                    j = (j + 1)
                }
                this.eqi(withWho 3 (tag + ": every sheet row names a resource of the space"))
                this.ok(((strlen (SpWords.noun(lang pack "resources"))) > 0) (tag + ": the pack names its resources"))
                k = (k + 1)
            }
            i = (i + 1)
        }
        ; on a Sunday the rest of the week is empty, and that is fine
        def sun:SpSpace (SpSeed.build("demo" "fi" (today + 4)))
        def sunToday:SpRange (itemAt (sun.summary((today + 4))) 0)
        this.ok(((array_length sunToday.items) > 0) "Sunday: still something today")
    }

    fn assist:void () {
        def wed:int (UiDate.toDays(2026 10 21))
        def s:SpSpace (SpSeed.build("family" "fi" wed))
        this.eq((SpAssist.answer(s "fi" wed "qToday")) "- 14.00–14.30 Hammaslääkäri (Aino · Vie: Juho)\n- 16.00–16.45 Pianotunti (Aino · Hakee: Mia)" "today, in Finnish, with the ward and who looks after it")
        def late:string (SpAssist.answer(s "fi" wed "qLate"))
        this.ok(((indexOf late "Palauta kirjaston kirjat") >= 0) "overdue")
        def week:string (SpAssist.weekSummary(s "fi" wed))
        this.ok(((indexOf week "# Viikkokooste ma 19.10.–su 25.10.") == 0) "the week summary's title")
        this.ok(((indexOf week "- Eero: 3") >= 0) "load per resource")
        this.ok(((indexOf week "Kuskausvuorot") < 0) "a sheet's name is not an event title")
        this.ok(((indexOf week "Treenikyyti") >= 0) "sheet rows are in the summary")
        def plan:string (SpAssist.plan(s "en" wed))
        this.ok(((indexOf plan "# Plan for next week Mon Oct 26–Sun Nov 1") == 0) "the plan's title")
        def planFi:string (SpAssist.plan(s "fi" wed))
        this.ok(((indexOf planFi "- [ ] Allekirjoita lupalappu") >= 0) "next week's deadline is a task")
        this.ok(((indexOf planFi "## Muistettavaa") >= 0) "the pack's word for deadlines")
        this.eq((SpWords.clock("en" 545)) "9:05" "an English clock")
    }


    fn words:void () {
        this.eq((SpWords.noun("fi" "demo" "resources")) "Vastuukohteet" "demo wards, fi")
        this.eq((SpWords.noun("en" "demo" "resource")) "Ward" "a demo ward, en")
        this.eq((SpWords.noun("fi" "family" "resources")) "Hoidettavat" "family wards, fi")
        this.eq((SpWords.noun("en" "business" "resources")) "Clients and equipment" "business wards, en")
        this.eq((SpWords.noun("fi" "sports" "resources")) "Pelaajat ja kalusto" "sports wards, fi")
        this.eq((SpWords.noun("fi" "family" "responsibility")) "Hoitovuoro" "family responsibility")
        this.eq((SpWords.noun("en" "sports" "responsibility")) "Coach in charge" "sports responsibility")
        def w (new SpWho())
        w.name = "Aino"
        w.role = "vie"
        this.eq((w.text()) "Vie: Aino" "a responsibility as the summary shows it")
        w.role = ""
        this.eq((w.text()) "Aino" "no role: the name alone")
    }

    fn rrules:void () {
        def r (new SpRule())
        this.ok((r.parse("FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,WE;UNTIL=20261231;COUNT=5")) "an RRULE reads")
        this.eq(r.freq "weekly" "FREQ")
        this.eqi(r.interval 2 "INTERVAL")
        this.eq((SpacesCheck.ints(r.byDay)) "1,3" "BYDAY")
        this.eq((UiDate.isoOfDays(r.until)) "2026-12-31" "UNTIL")
        this.eqi(r.count 5 "COUNT")
        this.eq((r.toText()) "FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,WE;UNTIL=20261231;COUNT=5" "and back")
        def r2 (new SpRule())
        this.ok((r2.parse("RRULE:FREQ=MONTHLY;UNTIL=20270115T225959Z;X-NAME=1")) "with a prefix, a time and a part it does not know")
        this.eq((r2.toText()) "FREQ=MONTHLY;UNTIL=20270115" "what it keeps")
        def r3 (new SpRule())
        this.ok(((r3.parse("FREQ=YEARLY")) == false) "a FREQ it does not know")
        this.eq((r3.toText()) "" "is no rule")
        this.eq((SpSpace.timeText(545)) "09:05" "a time for the server")
        this.eq((SpSpace.timeText(-1)) "" "no time")
    }

    sfn ints:string (list:[int]) {
        def parts:[string]
        def i:int 0
        while (i < (array_length list)) {
            push parts (to_string (itemAt list i))
            i = (i + 1)
        }
        return (join parts ",")
    }

    sfn spaceJson:string () {
        return "{\"space\":{\"space_id\":\"sp1\",\"name\":\"Kotiväki\",\"vocab\":\"family\",\"lang\":\"fi\",\"role\":\"member\",\"members\":[{\"uid\":\"u1\",\"name\":\"Mia\",\"email\":\"mia@example.com\",\"role\":\"owner\"},{\"uid\":\"u2\",\"name\":\"Juho\",\"email\":\"juho@example.com\",\"role\":\"member\"}],\"invites\":[\"leena@example.com\"],\"wards\":[{\"id\":\"w1\",\"name\":\"Aino\",\"color\":\"rose\"},{\"id\":\"w2\",\"name\":\"Nappi\",\"color\":\"\"}]},\"events\":[{\"event_id\":\"ev1\",\"title\":\"Uinti\",\"date\":\"2026-10-05\",\"start\":\"17:00\",\"end\":\"17:45\",\"ward\":\"w1\",\"rrule\":\"FREQ=WEEKLY;BYDAY=MO,WE\",\"exdates\":[\"2026-10-21\"],\"who\":[{\"name\":\"Juho\",\"role\":\"vie\"}]},{\"event_id\":\"ev2\",\"title\":\"Mökki\",\"date\":\"2026-10-23\",\"end_date\":\"2026-10-25\",\"important\":true,\"notes\":\"Avaimet\",\"source\":\"ics\",\"ext_id\":\"x-9\"},{\"event_id\":\"bad\",\"title\":\"Ei päivää\",\"date\":\"\"}]}"
    }

    fn remote:void () {
        def s (new SpSpace())
        s.today = (UiDate.toDays(2026 10 21))
        s.addEvent("Left over" s.today 600 660 "")
        this.ok((SpRemote.readSpace(s (SpacesCheck.spaceJson()))) "a space from the server reads")
        this.eq(s.name "Kotiväki" "its name")
        this.eq(s.vocab "family" "its words")
        this.eq(s.remoteId "sp1" "its id")
        this.eq(s.myRole "member" "the viewer's role")
        this.eqi((array_length s.members) 2 "the members")
        this.eqi((array_length s.invites) 1 "the invites")
        this.eqi((array_length s.resources) 2 "the wards")
        def nappi:SpResource (itemAt s.resources 1)
        this.eq(nappi.color "emerald" "a ward with no colour takes the next of the palette")
        this.eqi((array_length s.events) 2 "the events, the one without a date left out, what was there before gone")
        def swim:SpEvent (itemAt s.events 0)
        this.eq(swim.remoteId "ev1" "the server's id")
        this.ok(((swim.startMin == 1020) && (swim.endMin == 1065)) "HH:MM into minutes")
        this.eq((SpacesCheck.days((s.daysOf(swim (s.today - 2) (s.today + 6))))) "2026-10-19 2026-10-26" "the rule and its exdate")
        this.eq((SpWho.listText(swim.who)) "Vie: Juho" "who")
        def cabin:SpEvent (itemAt s.events 1)
        this.ok(((cabin.allDay()) && ((cabin.endDay - cabin.day) == 2)) "an all-day event over three days")
        this.ok((cabin.important && ((cabin.notes == "Avaimet") && ((cabin.origin == "ics") && (cabin.extId == "x-9")))) "important, notes and where it came from")
        this.eqi((array_length (s.dirtyEvents())) 0 "nothing loaded is dirty")
        def occ:[SpOccur] (s.occurrences((s.today + 5) (s.today + 5)))
        this.eq((s.aboutOf((itemAt occ 0))) "Aino · Vie: Juho" "an occurrence's ward and who")

        ; written back as it was read
        def body:string (SpRemote.saveBody("sp1" swim))
        this.eq(body "{\"title\":\"Uinti\",\"date\":\"2026-10-05\",\"start\":\"17:00\",\"end\":\"17:45\",\"ward\":\"w1\",\"rrule\":\"FREQ=WEEKLY;BYDAY=MO,WE\",\"exdates\":[\"2026-10-21\"],\"who\":[{\"name\":\"Juho\",\"role\":\"vie\"}],\"space_id\":\"sp1\",\"event_id\":\"ev1\"}" "save_event's body")
        this.eq((SpRemote.saveBody("sp1" cabin)) "{\"title\":\"Mökki\",\"date\":\"2026-10-23\",\"end_date\":\"2026-10-25\",\"notes\":\"Avaimet\",\"important\":true,\"source\":\"ics\",\"ext_id\":\"x-9\",\"space_id\":\"sp1\",\"event_id\":\"ev2\"}" "an all-day event's body")

        ; the calendar's changes are dirty
        this.ok((s.moveOccurrence(cabin.id (s.today + 3) -1 -1)) "a single event moves")
        this.ok((cabin.dirty && (cabin.rev == 1)) "and is dirty")
        def before:int (array_length s.events)
        this.ok((s.moveOccurrence((swim.id + "@" + (to_string (s.today + 5))) (s.today + 6) 1080 1125)) "one day of a series moves")
        this.ok(swim.dirty "the series is dirty (its new exdate)")
        def one:SpEvent (itemAt s.events before)
        this.ok((one.dirty && ((strlen one.remoteId) == 0)) "the day is a new event, dirty and not on the server")
        this.eq((SpWho.listText(one.who)) "Vie: Juho" "it keeps who")
        this.eqi((array_length (s.dirtyEvents())) 3 "three to save")
        this.ok(((indexOf (SpRemote.saveBody("sp1" swim)) "\"exdates\":[\"2026-10-21\",\"2026-10-26\"]") > 0) "the series is saved with both exdates")

        ; a Space alone changes the people, not the events
        def meta:VlJson (SpRemote.parse("{\"space_id\":\"sp1\",\"name\":\"Uusi nimi\",\"role\":\"owner\",\"members\":[{\"uid\":\"u1\",\"name\":\"Mia\",\"email\":\"mia@example.com\",\"role\":\"owner\"}],\"invites\":[]}"))
        SpRemote.readMeta(s meta)
        this.ok((((s.name == "Uusi nimi") && (s.myRole == "owner")) && (((array_length s.members) == 1) && ((array_length s.invites) == 0))) "a Space updates the name and the people")
        this.eqi((array_length s.events) (before + 1) "and keeps the events")

        def acc:SpAccount (SpRemote.account("{\"me\":{\"uid\":\"u1\",\"name\":\"Mia\",\"email\":\"mia@example.com\"},\"spaces\":[{\"space_id\":\"sp1\",\"name\":\"Kotiväki\",\"vocab\":\"family\",\"lang\":\"fi\",\"role\":\"owner\"}]}"))
        this.ok(((acc.uid == "u1") && ((array_length acc.spaces) == 1)) "list_spaces reads")
        def bad:SpAccount (SpRemote.account("not json"))
        this.eqi((array_length bad.spaces) 0 "an answer that does not read is no spaces")

        ; the demo data a space on a server keeps
        def seed:SpSpace (SpSeed.build("family" "fi" s.today))
        def evs:[SpEvent] (SpSeed.serverEvents(seed))
        this.eqi((array_length evs) ((array_length seed.events) + (array_length seed.deadlines)) "events and deadlines")
        def last:SpEvent (itemAt evs ((array_length evs) - 1))
        this.ok(((last.allDay()) && last.important) "a deadline is an important all-day event")
        this.ok(((indexOf (SpRemote.importBody("sp1" evs)) "\"rrule\":\"FREQ=WEEKLY;BYDAY=TU,TH\"") > 0) "import_events carries the rules")
    }

    ; --- typed entries -----------------------------------------------------------------

    fn types:void () {
        def ts:SpTypes (SpTypes.builtin())
        this.ok(((array_length ts.types) >= 10) "the built-in schema reads")
        def inv@(optional):SpType (ts.find("invitation"))
        this.ok((!null? inv) "a party invitation")
        if (!null? inv) {
            def t:SpType inv
            this.eq(t.kind "event" "is on the calendar")
            this.eq((t.name.text("fi")) "Juhlakutsu" "its Finnish name")
            this.ok(t.hasCost "it has a cost")
            this.eq((t.cost.text("en")) "Gift" "named for what it is")
            def rsvp@(optional):SpField (t.field("rsvp"))
            this.ok((!null? rsvp) "its fields")
            if (!null? rsvp) {
                def f:SpField rsvp
                this.eqi((array_length f.options) 3 "a choice's options")
                this.eq((f.optionLabel("fi" "not_going")) "Ei mennä" "an option's label")
                this.ok((f.picked()) "a choice is picked, not typed")
            }
        }
        this.eq((ts.kindOf("renewal")) "deadline" "a renewal is a deadline")
        this.eq((ts.kindOf("item")) "record" "a thing is a record")
        this.eq((ts.kindOf("")) "event" "no type is an event")
        this.eq((ts.kindOf("nonesuch")) "event" "an unknown type is an event")
        def fam:[SpType] (ts.forPack("family"))
        def biz:[SpType] (ts.forPack("business"))
        def demo:[SpType] (ts.forPack("demo"))
        def legacy:int 0
        def li:int 0
        while (li < (array_length ts.types)) {
            def lty:SpType (itemAt ts.types li)
            if (lty.legacy || ((strlen lty.page) > 0)) {
                legacy = (legacy + 1)
            }
            li = (li + 1)
        }
        this.ok((legacy > 0) "older types are kept as legacy")
        this.eqi((array_length demo) ((array_length ts.types) - legacy) "the demo pack offers every type but the legacy ones and those of a page of their own")
        def qt@(optional):SpType (ts.find("question"))
        this.ok((!null? qt) "a question is a type")
        if (!null? qt) {
            def qq:SpType qt
            this.eq(qq.page "questions" "questions show on their own page, not in the Add menu or the lists")
        }
        def famIds:string ""
        def fi:int 0
        while (fi < (array_length fam)) {
            def ft:SpType (itemAt fam fi)
            famIds = (famIds + " " + ft.id)
            fi = (fi + 1)
        }
        this.ok((((indexOf famIds " birthday_invitation") >= 0) && ((indexOf famIds " invitation") < 0)) "family offers the new invitation, not the old")
        def bi@(optional):SpType (ts.find("birthday_invitation"))
        if (!null? bi) {
            def b:SpType bi
            this.eq(b.group "event" "a type's group")
            this.eq((b.name.text("fi")) "Syntymäpäiväkutsu" "its Finnish name")
        }
        this.ok(((array_length biz) < (array_length fam)) "a pack offers its own types")
        def bizHasCare:boolean false
        def i:int 0
        while (i < (array_length biz)) {
            def bt:SpType (itemAt biz i)
            if (bt.id == "care_shift") {
                bizHasCare = true
            }
            i = (i + 1)
        }
        this.ok((bizHasCare == false) "business has no care shifts")
        def listed:[SpType] (ts.listedFor("family"))
        this.ok(((array_length listed) > 2) "lists for records and deadlines")
        def j:int 0
        def allListed:boolean true
        while (j < (array_length listed)) {
            def lt:SpType (itemAt listed j)
            if ((lt.listed()) == false) {
                allListed = false
            }
            j = (j + 1)
        }
        this.ok(allListed "and no events among them")
        def badTypes:SpTypes (SpTypes.parse("not json"))
        this.eqi((array_length badTypes.types) 0 "an answer that does not read is no types")

        ; what is typed into a field
        def err:[string]
        this.eq((SpTypes.normalize("money" "12,50 €" 2026 err)) "12.5" "money with a comma")
        this.eq((SpTypes.normalize("number" "3" 2026 err)) "3" "a number")
        this.eq((SpTypes.normalize("date" "24.12." 2026 err)) "2026-12-24" "a Finnish date in the year")
        this.eq((SpTypes.normalize("date" "2027-01-05" 2026 err)) "2027-01-05" "an ISO date")
        this.eq((SpTypes.normalize("time" "9.30" 2026 err)) "09:30" "a time")
        this.eq((SpTypes.normalize("text" "  hello  " 2026 err)) "hello" "text, trimmed")
        this.eq((SpTypes.normalize("bool" "yes" 2026 err)) "true" "a switch")
        this.eq((SpTypes.normalize("text" "   " 2026 err)) "" "an empty field")
        this.eqi((array_length err) 0 "all of those read")
        SpTypes.normalize("date" "31.2.2026" 2026 err)
        SpTypes.normalize("number" "lots" 2026 err)
        SpTypes.normalize("months" "0" 2026 err)
        SpTypes.normalize("email" "nobody" 2026 err)
        this.eqi((array_length err) 4 "a bad date, number, interval and email do not")
        this.eq((SpTypes.money("fi" 1234.5)) "1234,50 €" "euros in Finnish")
        this.eq((SpTypes.money("en" 20.0)) "€20" "whole euros in English")
        def who:[SpWho] (SpWho.parseList("Takes: Mia, Picks up: Juho, Leena"))
        this.eqi((array_length who) 3 "who looks after it, read back")
        def who1:SpWho (itemAt who 1)
        this.eq(who1.role "picks up" "a role")
        this.eq((SpWho.listText(who)) "Takes: Mia, Picks up: Juho, Leena" "and written the same")
    }

    fn timetable:void () {
        ; what is typed as times per weekday
        def err:[string]
        this.eq((SpTypes.normalize("weektimes" "ma 8.15-13, ti 9-14.15" 2026 err)) "MO 08:15-13:00; TU 09:00-14:15" "a timetable in Finnish")
        def w1:SpWeek (SpWeek.read("Mon, Wed 8:00-12:00; Tue 9–14"))
        this.eq((w1.toText()) "MO 08:00-12:00; TU 09:00-14:00; WE 08:00-12:00" "days without a time take the next one")
        def w2:SpWeek (SpWeek.read("ma–to klo 8.15–14\npe 8-12"))
        this.eq((w2.shown("fi")) "ma 8.15–14.00; ti 8.15–14.00; ke 8.15–14.00; to 8.15–14.00; pe 8.00–12.00" "a range of days, shown in Finnish")
        def w3:SpWeek (SpWeek.read((w2.shown("fi"))))
        this.eq((w3.toText()) (w2.toText()) "and read back")
        def w4:SpWeek (SpWeek.read((w2.shown("en"))))
        this.eq((w4.toText()) (w2.toText()) "in English too")
        def bad1:SpWeek (SpWeek.read("ma 8-12, ma 9-13"))
        this.ok((bad1.ok == false) "a day twice")
        def bad2:SpWeek (SpWeek.read("ma 12-8"))
        this.ok((bad2.ok == false) "an end before the start")
        def bad3:SpWeek (SpWeek.read("ma, ke"))
        this.ok((bad3.ok == false) "days without a time")
        def bad4:SpWeek (SpWeek.read("xx 8-12"))
        this.ok((bad4.ok == false) "not a weekday")

        ; Leo's school days, each at its own times, skipping his autumn
        ; holiday but not Aino's, nor a training day the school is open
        def s (new SpSpace())
        s.types = (SpTypes.builtin())
        def mon:int (UiDate.toDays(2026 10 19))
        def sch:SpEvent (s.addEvent("Koulu" (mon - 70) -1 -1 "leo"))
        sch.typeId = "school_timetable"
        sch.setField("times" "MO 08:15-13:00; TU 09:00-14:15; FR 08:00-12:00" "string")
        sch.rule.freq = "weekly"
        sch.rule.until = (mon + 200)
        def hol:SpEvent (s.addAllDay("Syysloma" (mon + 7) (mon + 11) "leo"))
        hol.typeId = "school_exception_day"
        def other:SpEvent (s.addAllDay("Ainon loma" mon (mon + 4) "aino"))
        other.typeId = "school_exception_day"
        def open:SpEvent (s.addAllDay("Koulutuspäivä" (mon + 1) (mon + 1) ""))
        open.typeId = "school_exception_day"
        open.setField("school_open" "true" "bool")
        def occ:[SpOccur] (s.occurrences(mon (mon + 20)))
        def got:[string]
        def i:int 0
        while (i < (array_length occ)) {
            def o:SpOccur (itemAt occ i)
            if (o.title == "Koulu") {
                push got ((UiDate.isoOfDays(o.day)) + " " + (SpSpace.timeText(o.startMin)) + "-" + (SpSpace.timeText(o.endMin)))
            }
            i = (i + 1)
        }
        this.eq((join got ", ") "2026-10-19 08:15-13:00, 2026-10-20 09:00-14:15, 2026-10-23 08:00-12:00, 2026-11-02 08:15-13:00, 2026-11-03 09:00-14:15, 2026-11-06 08:00-12:00" "each day its own times, the holiday week skipped")
    }

    fn entries:void () {
        def s (new SpSpace())
        s.types = (SpTypes.builtin())
        s.today = (UiDate.toDays(2026 10 21))
        def party:SpEvent (s.addEvent("Synttärit" (s.today + 3) 780 900 ""))
        party.typeId = "invitation"
        party.setField("rsvp" "going" "string")
        party.setField("gift_bought" "true" "bool")
        this.eq((party.fieldText("rsvp")) "going" "a field")
        this.ok((party.fieldOn("gift_bought")) "a switch")
        party.setField("rsvp" "not_going" "string")
        this.eqi((array_length party.values) 2 "set again, one value")
        party.setField("gift_bought" "" "bool")
        this.eqi((array_length party.values) 1 "an empty value removes it")
        this.eq((join party.dropped ",") "gift_bought" "and the server is told")
        party.setField("gift_bought" "false" "bool")
        this.eqi((array_length party.dropped) 0 "set again, it is no longer removed")

        def thing:SpEvent (s.addEvent("Luistimet" -1 -1 -1 ""))
        thing.typeId = "item"
        def kept:SpEvent (s.addEvent("Pyörä" (s.today + 1) -1 -1 ""))
        kept.typeId = "item"
        def occ:[SpOccur] (s.occurrences(s.today (s.today + 7)))
        def onCal:boolean false
        def i:int 0
        while (i < (array_length occ)) {
            def o:SpOccur (itemAt occ i)
            if ((o.title == "Luistimet") || (o.title == "Pyörä")) {
                onCal = true
            }
            i = (i + 1)
        }
        this.ok((onCal == false) "records are on no calendar, dated or not")
        this.ok(((array_length occ) == 1) "the invitation is")
        def occ0:SpOccur (itemAt occ 0)
        this.eq(occ0.typeId "invitation" "with its type")
        def items:[SpEvent] (s.entriesOf("item"))
        this.eqi((array_length items) 2 "a type's entries")
        def item0:SpEvent (itemAt items 0)
        this.eq(item0.title "Pyörä" "dated ones first")
        kept.setField("state" "repair" "choice")
        def repairs:[SpEvent] (s.entriesOf("repair"))
        this.eqi((array_length repairs) 1 "a thing that needs repair is a repair too")
        this.eqi((array_length (s.entriesOf("item"))) 2 "and still a thing")
        this.eqi((array_length (s.entriesOf("need"))) 0 "a thing not missing is no need")

        ; links: both ends here at once, sent with the first's save
        kept.remoteId = "r-bike"
        def fix:SpEvent (s.addEvent("Pyöräkorjaamo" (s.today + 3) -1 -1 ""))
        fix.typeId = "contact"
        fix.remoteId = "r-fix"
        s.link(fix kept true)
        this.ok((kept.linked("r-fix")) "the thing knows its repairer")
        this.eqi((array_length (s.linksOf(fix))) 1 "and the repairer its thing")
        this.ok(((indexOf (SpRemote.saveBody("sp1" fix)) "\"links\":[\"r-bike\"]") > 0) "the link is sent")
        fix.saved(fix.rev)
        this.eqi((indexOf (SpRemote.saveBody("sp1" fix)) "links") -1 "once")
        s.link(fix kept false)
        this.eqi((array_length kept.links) 0 "unlinked both ways")
        this.ok(((indexOf (SpRemote.saveBody("sp1" fix)) "\"unlink\":[\"r-bike\"]") > 0) "the unlink is sent")

        ; deadlines and their reminders
        def pass:SpEvent (s.addAllDay("Passi" (s.today + 20) (s.today + 20) ""))
        pass.typeId = "renewal"
        def ins:SpEvent (s.addAllDay("Kotivakuutus" (s.today + 40) (s.today + 40) ""))
        ins.typeId = "renewal"
        ins.setField("remind_days" "60" "number")
        def alarm:SpEvent (s.addAllDay("Palovaroitin" (s.today - 2) (s.today - 2) ""))
        alarm.typeId = "renewal"
        def far:SpEvent (s.addAllDay("Henkilökortti" (s.today + 90) (s.today + 90) ""))
        far.typeId = "renewal"
        this.eq((pass.dueState(s.today)) "due" "inside 30 days it is due")
        this.eq((ins.dueState(s.today)) "due" "remind_days moves the reminder")
        this.eq((alarm.dueState(s.today)) "late" "past its day it is late")
        this.eq((far.dueState(s.today)) "" "far off it is neither")
        far.remindFrom = (s.today - 1)
        this.eq((far.dueState(s.today)) "due" "the server's remind_from is kept")
        ; a travel card far off but low on trips is due now
        def card:SpEvent (s.addAllDay("Sarjalippu" (s.today + 120) (s.today + 120) ""))
        card.typeId = "travel_card"
        card.setField("trips_left" "5" "number")
        this.eq((s.dueOf(card s.today)) "" "enough trips")
        card.setField("trips_left" "2" "number")
        this.eq((s.dueOf(card s.today)) "due" "two trips left: due")
        card.setField("low_trips" "1" "number")
        this.eq((s.dueOf(card s.today)) "" "its own limit")
        card.setField("trips_left" "1" "number")
        def due:[SpEvent] (s.dueEntries(s.today))
        this.eqi((array_length due) 5 "the due and late deadlines, the card low on trips")
        def due0:SpEvent (itemAt due 0)
        this.eq(due0.title "Palovaroitin" "the earliest first")

        ; taking out and putting back
        def n:int (array_length s.events)
        def gone@(optional):SpEvent (s.removeEvent(party.id))
        this.ok((!null? gone) "an event is taken out")
        this.eqi((array_length s.events) (n - 1) "and is gone")
        s.putBack(party)
        s.putBack(party)
        this.eqi((array_length s.events) n "and goes back once")
        def wk:SpEvent (s.addEvent("Uinti" (s.today - 7) 600 660 ""))
        wk.rule.freq = "weekly"
        this.eq((s.eventIdOf((wk.id + "@" + (to_string s.today)))) wk.id "an occurrence's event")
        this.eqi((SpSpace.occDayOf((wk.id + "@" + (to_string s.today)))) s.today "and its day")
        this.eq((s.eventIdOf("s1-r1")) "" "a sheet row is no event")
        this.ok((s.skipDay(wk.id s.today)) "one day of a series is skipped")
        this.ok((wk.skips(s.today)) "and is left out")
        this.ok((s.unskipDay(wk.id s.today)) "and put back")
        this.ok(((wk.skips(s.today)) == false) "in the series again")

        ; costs and payers
        def c (new SpCost())
        c.amount = 25.0
        c.payer = "Mia"
        party.setCost(c)
        this.eq((join (s.payers()) ",") "Mia" "the payers")
        party.clearCost()
        this.ok(((party.hasCost == false) && party.costDropped) "a cost removed is sent as removed")
        party.saved(party.rev)
        this.ok(((party.costDropped == false) && ((array_length party.dropped) == 0)) "until it is saved")
    }

    sfn entryJson:string () {
        return "{\"space\":{\"space_id\":\"sp1\",\"name\":\"Kotiväki\",\"vocab\":\"family\",\"lang\":\"fi\",\"role\":\"owner\",\"members\":[],\"invites\":[],\"wards\":[{\"id\":\"w1\",\"name\":\"Aino\",\"color\":\"rose\"}]},\"events\":[{\"event_id\":\"ev1\",\"title\":\"Eeron synttärit\",\"date\":\"2026-10-24\",\"start\":\"13:00\",\"end\":\"15:00\",\"ward\":\"w1\",\"type\":\"invitation\",\"fields\":{\"rsvp\":\"going\",\"gift_bought\":false,\"guests\":12},\"cost\":{\"amount\":20,\"payer\":\"Mia\",\"scope\":\"shared\",\"instalments\":1,\"first\":\"2026-10-20\",\"every_months\":1}},{\"event_id\":\"ev2\",\"title\":\"Luistimet\",\"date\":\"\",\"type\":\"item\",\"fields\":{\"state\":\"repair\"}},{\"event_id\":\"ev3\",\"title\":\"Passi\",\"date\":\"2026-12-01\",\"type\":\"renewal\",\"remind_from\":\"2026-11-01\"},{\"event_id\":\"ev4\",\"title\":\"Ei päivää\",\"date\":\"\",\"type\":\"invitation\"}]}"
    }

    fn entriesRemote:void () {
        def s (new SpSpace())
        s.types = (SpTypes.builtin())
        s.today = (UiDate.toDays(2026 10 21))
        this.ok((SpRemote.readSpace(s (SpacesCheck.entryJson()))) "a space with entries reads")
        this.eqi((array_length s.events) 3 "a record without a date is kept, an event without one is not")
        def party:SpEvent (itemAt s.events 0)
        this.eq(party.typeId "invitation" "its type")
        this.eq((party.fieldText("rsvp")) "going" "a text field")
        this.eq((party.fieldText("gift_bought")) "false" "a switch")
        this.eq((party.fieldText("guests")) "12" "a number")
        this.ok((party.hasCost && ((party.cost.amount == 20.0) && (party.cost.scope == "shared"))) "its cost")
        this.eq((UiDate.isoOfDays(party.cost.first)) "2026-10-20" "the first instalment's day")
        def thing:SpEvent (itemAt s.events 1)
        this.ok(((thing.dated()) == false) "an undated record")
        def pass:SpEvent (itemAt s.events 2)
        this.eq((UiDate.isoOfDays(pass.remindFrom)) "2026-11-01" "remind_from")
        this.ok(((party.dirty == false) && ((array_length party.dropped) == 0)) "nothing loaded is to save")

        party.setField("rsvp" "" "string")
        party.setField("gift_bought" "true" "bool")
        def body:string (SpRemote.saveBody("sp1" party))
        this.ok(((indexOf body "\"type\":\"invitation\"") > 0) "the type is saved")
        this.ok(((indexOf body "\"rsvp\":null") > 0) "a removed field is sent as null")
        this.ok(((indexOf body "\"gift_bought\":true") > 0) "a switch as a boolean")
        this.ok(((indexOf body "\"guests\":12") > 0) "a number as a number")
        this.ok(((indexOf body "\"cost\":{\"amount\":20,\"payer\":\"Mia\",\"scope\":\"shared\",\"instalments\":1,\"first\":\"2026-10-20\",\"every_months\":1}") > 0) ("the cost: " + body))
        party.clearCost()
        this.ok(((indexOf (SpRemote.saveBody("sp1" party)) "\"cost\":null") > 0) "a removed cost is sent as null")
        def tb:string (SpRemote.saveBody("sp1" thing))
        this.ok(((indexOf tb "\"date\":\"\"") > 0) "an undated record is saved without a date")
        this.eq((SpRemote.deleteBody("sp1" "ev2")) "{\"space_id\":\"sp1\",\"event_id\":\"ev2\"}" "delete_event")
        this.eq((SpRemote.budgetBody("sp1" "2026-10" "2027-03" "Mia")) "{\"space_id\":\"sp1\",\"from\":\"2026-10\",\"to\":\"2027-03\",\"person\":\"Mia\"}" "budget")
    }

    fn planned:void () {
        def s (new SpSpace())
        s.today = (UiDate.toDays(2026 10 21))
        def road:SpEvent (s.addEvent("Tien raivaus" (UiDate.toDays(2026 11 10)) -1 -1 ""))
        road.typeId = "deadline"
        road.setField("planned_days" "2026-11-03; 2026-10-31; 2026-11-03" "string")
        this.eq((SpacesCheck.days((s.plannedDays(road)))) "2026-10-31 2026-11-03" "planned days in order, once each")
        this.eq((SpacesCheck.titles((s.occurrences(s.today (s.today + 30))))) "Suunniteltu: Tien raivaus,Suunniteltu: Tien raivaus,Tien raivaus" "on the calendar on each planned day and its due day")
        road.setField("status" "done" "string")
        this.eqi((array_length (s.occurrences(s.today (s.today + 30)))) 1 "done: only its own day")
    }

    fn budget:void () {
        def s (new SpSpace())
        s.today = (UiDate.toDays(2026 10 21))
        def hobby:SpEvent (s.addEvent("Uintikausi" (UiDate.toDays(2026 9 1)) 1020 1065 ""))
        def fee (new SpCost())
        fee.amount = 100.0
        fee.payer = "Mia"
        fee.scope = "shared"
        fee.instalments = 3
        fee.first = (UiDate.toDays(2026 10 31))
        hobby.setCost(fee)
        def gift:SpEvent (s.addEvent("Lahja" (UiDate.toDays(2026 11 7)) -1 -1 ""))
        def g (new SpCost())
        g.amount = 15.5
        g.payer = "Juho"
        gift.setCost(g)
        def lines:[SpBudgetLine] (SpBudget.instalments(hobby s.today))
        this.eqi((array_length lines) 3 "three instalments")
        def ln0:SpBudgetLine (itemAt lines 0)
        def ln1:SpBudgetLine (itemAt lines 1)
        def ln2:SpBudgetLine (itemAt lines 2)
        this.eq(ln1.date "2026-11-30" "a month later, on the month's last day")
        this.eq(ln2.date "2026-12-31" "and the next")
        this.ok(((ln0.amount == 33.33) && (ln2.amount == 33.34)) "the last one takes the cents left over")
        def b:SpBudget (SpBudget.compute(s (SpBudget.monthOf("2026-10")) (SpBudget.monthOf("2026-12")) ""))
        this.eqi((array_length b.months) 3 "a month each")
        this.ok(((b.total > 115.49) && (b.total < 115.51)) "the total")
        this.ok(((b.shared > 99.99) && (b.shared < 100.01)) "the shared part")
        this.ok((((b.byPayer.of("Juho")) == 15.5) && ((b.byPayer.of("Mia")) > 99.99)) "by payer")
        def nov:SpBudgetMonth (itemAt b.months 1)
        this.eq(nov.month "2026-11" "November")
        this.eqi((array_length nov.lines) 2 "has an instalment and the gift")
        def mine:SpBudget (SpBudget.compute(s (SpBudget.monthOf("2026-10")) (SpBudget.monthOf("2026-12")) "Juho"))
        this.ok(((mine.total > 115.49) && (mine.total < 115.51)) "Juho's budget: his own gift and the family's hobby")
        def hers:SpBudget (SpBudget.compute(s (SpBudget.monthOf("2026-10")) (SpBudget.monthOf("2026-12")) "Mia"))
        this.ok(((hers.total > 99.99) && (hers.total < 100.01)) "Mia's: not Juho's own gift")
        ; the hobby's payment days are on the calendar, the first reminded of
        def all:[SpOccur] (s.occurrences(s.today (s.today + 45)))
        def pays:[SpOccur]
        def pi:int 0
        while (pi < (array_length all)) {
            def po:SpOccur (itemAt all pi)
            if po.derived {
                push pays po
            }
            pi = (pi + 1)
        }
        this.eqi((array_length pays) 2 "two payment days in the next six weeks")
        def p0:SpOccur (itemAt pays 0)
        this.ok(((p0.derived && (p0.important == false)) && (p0.title == "Maksu: Uintikausi 33.33 €")) ("the first, ten days ahead, not yet reminded of: " + p0.title))
        s.showPays = false
        this.eqi((array_length (s.occurrences(s.today (s.today + 45)))) 1 "hidden: the gift's own day is left")
        s.showPays = true
        def every:SpCost hobby.cost
        every.everyMonths = 2
        def two:[SpBudgetLine] (SpBudget.instalments(hobby s.today))
        def two1:SpBudgetLine (itemAt two 1)
        this.eq(two1.date "2026-12-31" "every other month")
        this.eq((UiDate.isoOfDays((SpBudget.addMonths((UiDate.toDays(2027 1 31)) 1)))) "2027-02-28" "a month after the 31st")

        def r:SpBudget (SpBudget.read("{\"from\":\"2026-10\",\"to\":\"2026-11\",\"total\":45.5,\"shared\":30,\"by_payer\":{\"Mia\":30,\"Juho\":15.5},\"months\":[{\"month\":\"2026-10\",\"total\":45.5,\"shared\":30,\"by_payer\":{\"Mia\":30,\"Juho\":15.5},\"lines\":[{\"event_id\":\"ev1\",\"title\":\"Uinti\",\"type\":\"hobby\",\"date\":\"2026-10-31\",\"amount\":30,\"payer\":\"Mia\",\"scope\":\"shared\",\"n\":1,\"of\":3}]},{\"month\":\"2026-11\",\"total\":0,\"shared\":0,\"by_payer\":{},\"lines\":[]}]}"))
        this.ok(((r.total == 45.5) && (r.shared == 30.0)) "the server's budget reads")
        this.eqi((array_length r.months) 2 "its months")
        def oct:SpBudgetMonth (itemAt r.months 0)
        def l0:SpBudgetLine (itemAt oct.lines 0)
        this.ok((((l0.n == 1) && (l0.of == 3)) && (l0.typeId == "hobby")) "its lines")
        this.eq((join r.byPayer.names ",") "Mia,Juho" "by payer, in order")
        def badBudget:SpBudget (SpBudget.read("nope"))
        this.eqi((array_length badBudget.months) 0 "an answer that does not read is empty")
    }

    sfn main:void () {
        def c (new SpacesCheck())
        c.rules()
        c.order()
        c.summary()
        c.sheets()
        c.moves()
        c.seeds()
        c.assist()
        c.words()
        c.rrules()
        c.remote()
        c.types()
        c.entries()
        c.timetable()
        c.entriesRemote()
        c.budget()
        c.planned()
        print ((to_string c.passes) + " passed, " + (to_string c.fails) + " failed")
        if (c.fails > 0) {
            print "CHECK FAILED"
        }
    }
