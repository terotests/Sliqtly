; =============================================================================
; SpacesRemote — a space kept on a server, as the JSON the server speaks
; =============================================================================
; The page talks to the server with POST <op> and a JSON object; this reads
; the answers into the model (through SpSpace.beginLoad and the calls after
; it) and writes the bodies the page sends. Nothing here does any I/O.
;
;   Space  {space_id, name, vocab, lang, role, members:[{uid,name,email,role}],
;           invites:[email], wards:[{id,name,color}]}
;   Event  {event_id, title, date, end_date?, start?, end?, ward?, place?,
;           notes?, color?, rrule?, exdates?:[date], who?:[{name,role}],
;           important?, source?, ext_id?, type?, fields?:{key: value},
;           cost?:{amount, payer, scope, instalments, first, every_months, remind_days},
;           remind_from?}
;   A record's date may be empty. On a save, `fields` is merged into what
;   the server has (a key set to null is removed) and `cost` replaces it
;   (null removes it).
; =============================================================================

Import "SpacesModel.rgr"
Import "../vela/src/VlJson.rgr"

; One space in the list the server keeps for the person signed in.
class SpSpaceInfo {
    def id:string ""
    def name:string ""
    def vocab:string "demo"
    def lang:string "fi"
    def role:string "member"
    Constructor () {
    }
}

; The person signed in and their spaces (list_spaces).
class SpAccount {
    def uid:string ""
    def name:string ""
    def email:string ""
    def spaces:[SpSpaceInfo]
    Constructor () {
    }

    fn find@(optional):SpSpaceInfo (id:string) {
        def found@(optional):SpSpaceInfo
        def i:int 0
        while (i < (array_length spaces)) {
            def s:SpSpaceInfo (itemAt spaces i)
            if (s.id == id) {
                found = s
            }
            i = (i + 1)
        }
        return found
    }

    ; a space in the list takes what the server last said of it
    fn put:SpSpaceInfo (info:SpSpaceInfo) {
        def i:int 0
        while (i < (array_length spaces)) {
            def s:SpSpaceInfo (itemAt spaces i)
            if (s.id == info.id) {
                set spaces i info
                return info
            }
            i = (i + 1)
        }
        push spaces info
        return info
    }
}

class SpRemote {

    ; The text as JSON; an object that is empty when it does not read.
    sfn parse:VlJson (text:string) {
        def p (new VlJsonParser())
        def v:VlJson (p.parse(text))
        if ((p.ok == false) || ((v.isObject()) == false)) {
            return (VlJson.objectValue())
        }
        return v
    }

    sfn str:VlJson (v:string) {
        return (VlJson.stringValue(v))
    }

    sfn info:SpSpaceInfo (o:VlJson) {
        def s (new SpSpaceInfo())
        s.id = (o.stringOr("space_id" ""))
        s.name = (o.stringOr("name" ""))
        s.vocab = (o.stringOr("vocab" "demo"))
        s.lang = (o.stringOr("lang" "fi"))
        s.role = (o.stringOr("role" "member"))
        return s
    }

    ; list_spaces: {me:{uid,name,email}, spaces:[Space]}
    sfn account:SpAccount (text:string) {
        def o:VlJson (SpRemote.parse(text))
        def a (new SpAccount())
        def me:VlJson (o.get("me"))
        if (me.isObject()) {
            a.uid = (me.stringOr("uid" ""))
            a.name = (me.stringOr("name" ""))
            a.email = (me.stringOr("email" ""))
        }
        def list:VlJson (o.get("spaces"))
        def i:int 0
        while (i < (list.count())) {
            def one:VlJson (list.at(i))
            if (one.isObject()) {
                push a.spaces (SpRemote.info(one))
            }
            i = (i + 1)
        }
        return a
    }

    ; What a Space object says about the space itself and its people, into
    ; `s`: the name, words, language, the viewer's role, members and invites.
    ; The wards and the events are left as they are.
    sfn readMeta:void (s:SpSpace o:VlJson) {
        s.remoteId = (o.stringOr("space_id" s.remoteId))
        s.name = (o.stringOr("name" s.name))
        s.vocab = (o.stringOr("vocab" s.vocab))
        s.lang = (o.stringOr("lang" s.lang))
        s.myRole = (o.stringOr("role" s.myRole))
        def m:[SpMember]
        s.members = m
        def iv:[string]
        s.invites = iv
        def ms:VlJson (o.get("members"))
        def i:int 0
        while (i < (ms.count())) {
            def one:VlJson (ms.at(i))
            s.loadMember((one.stringOr("uid" "")) (one.stringOr("name" "")) (one.stringOr("email" "")) (one.stringOr("role" "member")))
            i = (i + 1)
        }
        def ivs:VlJson (o.get("invites"))
        def k:int 0
        while (k < (ivs.count())) {
            def e:VlJson (ivs.at(k))
            if (e.isString()) {
                s.loadInvite(e.str)
            }
            k = (k + 1)
        }
    }

    ; get_space: {space: Space, events: [Event]}, the whole space. False when
    ; the answer has no space in it.
    sfn readSpace:boolean (s:SpSpace text:string) {
        def o:VlJson (SpRemote.parse(text))
        def sp:VlJson (o.get("space"))
        if ((sp.isObject()) == false) {
            return false
        }
        SpRemote.readWhole(s sp (o.get("events")))
        return true
    }

    ; A Space and its events into `s`, replacing what it held.
    sfn readWhole:void (s:SpSpace sp:VlJson events:VlJson) {
        s.beginLoad((sp.stringOr("name" "")) (sp.stringOr("vocab" "demo")))
        SpRemote.readMeta(s sp)
        def ws:VlJson (sp.get("wards"))
        def i:int 0
        while (i < (ws.count())) {
            def w:VlJson (ws.at(i))
            s.loadWard((w.stringOr("id" "")) (w.stringOr("name" "")) (w.stringOr("color" "")))
            i = (i + 1)
        }
        SpRemote.readPlaces(s sp)
        def k:int 0
        while (k < (events.count())) {
            SpRemote.readEvent(s (events.at(k)))
            k = (k + 1)
        }
    }

    ; The places of a Space object, the space's and each ward's, into `s`,
    ; replacing those it had.
    sfn readPlaces:void (s:SpSpace sp:VlJson) {
        def none:[SpPlace]
        s.places = none
        SpRemote.readPlaceList(s (sp.get("places")) "")
        def ws:VlJson (sp.get("wards"))
        def i:int 0
        while (i < (ws.count())) {
            def w:VlJson (ws.at(i))
            SpRemote.readPlaceList(s (w.get("places")) (w.stringOr("id" "")))
            i = (i + 1)
        }
    }

    sfn readPlaceList:void (s:SpSpace list:VlJson ward:string) {
        def k:int 0
        while (k < (list.count())) {
            def p:VlJson (list.at(k))
            def nm:string (p.stringOr("name" ""))
            if ((strlen nm) > 0) {
                s.addPlace(nm (p.doubleOr("lat" 0.0)) (p.doubleOr("lon" 0.0)) ward)
            }
            k = (k + 1)
        }
    }

    ; add_place with the town's coordinates, for the space or a ward.
    sfn placeBody:string (spaceId:string p:SpPlace) {
        def o:VlJson (VlJson.objectValue())
        o.setMember("space_id" (SpRemote.str(spaceId)))
        o.setMember("place" (SpRemote.str(p.name)))
        if ((strlen p.ward) > 0) {
            o.setMember("ward" (SpRemote.str(p.ward)))
        }
        o.setMember("lat" (VlJson.numberValue(p.lat)))
        o.setMember("lon" (VlJson.numberValue(p.lon)))
        return (SpRemote.write(o))
    }

    sfn readEvent:void (s:SpSpace o:VlJson) {
        def made@(optional):SpEvent
        def date:string (trim (o.stringOr("date" "")))
        if (((strlen date) == 0) && ((s.types.kindOf((o.stringOr("type" "")))) == "record")) {
            made = (s.loadUndated((o.stringOr("event_id" "")) (o.stringOr("title" "")) (o.stringOr("ward" "")) (o.stringOr("place" "")) (o.stringOr("color" "")) (o.stringOr("notes" "")) (o.boolOr("important" false))))
        } {
            made = (s.loadEvent((o.stringOr("event_id" "")) (o.stringOr("title" "")) (o.stringOr("date" "")) (o.stringOr("end_date" "")) (o.stringOr("start" "")) (o.stringOr("end" "")) (o.stringOr("ward" "")) (o.stringOr("place" "")) (o.stringOr("color" "")) (o.stringOr("notes" "")) (o.boolOr("important" false))))
        }
        if (null? made) {
            return
        }
        def e:SpEvent made
        e.origin = (o.stringOr("source" ""))
        e.extId = (o.stringOr("ext_id" ""))
        def rr:string (o.stringOr("rrule" ""))
        if ((strlen rr) > 0) {
            s.loadRule(e rr)
        }
        def ex:VlJson (o.get("exdates"))
        def i:int 0
        while (i < (ex.count())) {
            def d:VlJson (ex.at(i))
            if (d.isString()) {
                s.loadExdate(e d.str)
            }
            i = (i + 1)
        }
        def who:VlJson (o.get("who"))
        def k:int 0
        while (k < (who.count())) {
            def w:VlJson (who.at(k))
            if (w.isObject()) {
                e.addWho((w.stringOr("name" "")) (w.stringOr("role" "")))
            }
            k = (k + 1)
        }
        SpRemote.readEntry(s e o)
    }

    ; What an Event says of its type, fields, cost and reminder, into `e`.
    sfn readEntry:void (s:SpSpace e:SpEvent o:VlJson) {
        def t:string (o.stringOr("type" ""))
        if (t == "event") {
            t = ""
        }
        e.typeId = t
        def none:[SpValue]
        e.values = none
        def fs:VlJson (o.get("fields"))
        if (fs.isObject()) {
            def i:int 0
            while (i < (array_length fs.keys)) {
                def key:string (itemAt fs.keys i)
                def v:VlJson (fs.get(key))
                if (v.isBool()) {
                    e.setField(key (v.asString()) "bool")
                }
                if (v.isNumber()) {
                    e.setField(key (SpTypes.numText(v.num)) "number")
                }
                if (v.isString()) {
                    e.setField(key v.str "string")
                }
                ; a list: its items as one text, which the server splits
                ; again at the semicolons
                if (v.isArray()) {
                    def items:string ""
                    def j:int 0
                    while (j < (v.count())) {
                        def it:VlJson (v.at(j))
                        if (it.isString()) {
                            if ((strlen items) > 0) {
                                items = (items + "; ")
                            }
                            items = (items + it.str)
                        }
                        j = (j + 1)
                    }
                    e.setField(key items "string")
                }
                i = (i + 1)
            }
        }
        def nd:[string]
        e.dropped = nd
        def c:VlJson (o.get("cost"))
        e.hasCost = false
        e.costDropped = false
        if (c.isObject()) {
            def cost (new SpCost())
            cost.amount = (c.doubleOr("amount" 0.0))
            cost.payer = (c.stringOr("payer" ""))
            cost.scope = (c.stringOr("scope" "personal"))
            cost.instalments = (c.intOr("instalments" 1))
            cost.everyMonths = (c.intOr("every_months" 1))
            cost.first = (SpText.dayOf((c.stringOr("first" "")) (itemAt (SpSpace.ymdOf(s.today)) 0)))
            cost.remindDays = (c.intOr("remind_days" -1))
            e.setCost(cost)
        }
        e.remindFrom = (SpText.dayOf((o.stringOr("remind_from" "")) (itemAt (SpSpace.ymdOf(s.today)) 0)))
        SpRemote.readWatch(e (o.get("watch")))
    }

    ; An entry's deal watch and its finds, into `e`.
    sfn readWatch:void (e:SpEvent w:VlJson) {
        def nt:[string]
        def nu:[string]
        def ni:[string]
        e.findTitles = nt
        e.findUrls = nu
        e.findInfo = ni
        e.watched = (w.isObject())
        if ((w.isObject()) == false) {
            return
        }
        e.watchQuery = (w.stringOr("query" ""))
        e.watchOn = (w.boolOr("active" false))
        def fs:VlJson (w.get("finds"))
        if ((fs.isArray()) == false) {
            return
        }
        def i:int 0
        while (i < (fs.count())) {
            def f:VlJson (fs.at(i))
            def u:string (f.stringOr("url" ""))
            if ((SpRemote.starts(u "https://")) || (SpRemote.starts(u "http://"))) {
                push e.findTitles (f.stringOr("title" u))
                push e.findUrls u
                def parts:[string]
                def price:double (f.doubleOr("price" 0.0))
                if (price > 0.0) {
                    push parts ((SpTypes.numText(price)) + " €")
                }
                push parts (f.stringOr("source" ""))
                def found:string (f.stringOr("found" ""))
                if ((strlen found) == 10) {
                    push parts ((SpRemote.dayMonth(found)))
                }
                push e.findInfo (join parts " · ")
            }
            i = (i + 1)
        }
    }

    sfn starts:boolean (s:string p:string) {
        if ((strlen s) < (strlen p)) {
            return false
        }
        return ((substring s 0 (strlen p)) == p)
    }

    ; "2026-10-17" as "17.10."
    sfn dayMonth:string (d:string) {
        def dd:string (substring d 8 10)
        def mm:string (substring d 5 7)
        if (SpRemote.starts(dd "0")) {
            dd = (substring dd 1 2)
        }
        if (SpRemote.starts(mm "0")) {
            mm = (substring mm 1 2)
        }
        return (dd + "." + mm + ".")
    }

    ; --- what the page sends -----------------------------------------------------

    ; An event as the server takes it, without its id.
    sfn eventObj:VlJson (e:SpEvent) {
        def o:VlJson (VlJson.objectValue())
        o.setMember("title" (SpRemote.str(e.title)))
        if ((e.dated()) == false) {
            o.setMember("date" (SpRemote.str("")))
        } {
            o.setMember("date" (SpRemote.str((SpSpace.dateText(e.day)))))
        }
        if (e.endDay > e.day) {
            o.setMember("end_date" (SpRemote.str((SpSpace.dateText(e.endDay)))))
        }
        if ((e.allDay()) == false) {
            o.setMember("start" (SpRemote.str((SpSpace.timeText(e.startMin)))))
            o.setMember("end" (SpRemote.str((SpSpace.timeText(e.endMin)))))
        }
        if ((strlen e.resource) > 0) {
            o.setMember("ward" (SpRemote.str(e.resource)))
        }
        if ((strlen e.place) > 0) {
            o.setMember("place" (SpRemote.str(e.place)))
        }
        if ((strlen e.notes) > 0) {
            o.setMember("notes" (SpRemote.str(e.notes)))
        }
        if ((strlen e.color) > 0) {
            o.setMember("color" (SpRemote.str(e.color)))
        }
        def rr:string (e.rule.toText())
        if ((strlen rr) > 0) {
            o.setMember("rrule" (SpRemote.str(rr)))
        }
        if ((array_length e.exdates) > 0) {
            def ex:VlJson (VlJson.arrayValue())
            def i:int 0
            while (i < (array_length e.exdates)) {
                push ex.arr (SpRemote.str((SpSpace.dateText((itemAt e.exdates i)))))
                i = (i + 1)
            }
            o.setMember("exdates" ex)
        }
        if ((array_length e.who) > 0) {
            def ws:VlJson (VlJson.arrayValue())
            def k:int 0
            while (k < (array_length e.who)) {
                def w:SpWho (itemAt e.who k)
                def wo:VlJson (VlJson.objectValue())
                wo.setMember("name" (SpRemote.str(w.name)))
                wo.setMember("role" (SpRemote.str(w.role)))
                push ws.arr wo
                k = (k + 1)
            }
            o.setMember("who" ws)
        }
        if e.important {
            o.setMember("important" (VlJson.boolValue(true)))
        }
        if ((strlen e.origin) > 0) {
            o.setMember("source" (SpRemote.str(e.origin)))
        }
        if ((strlen e.extId) > 0) {
            o.setMember("ext_id" (SpRemote.str(e.extId)))
        }
        if ((strlen e.typeId) > 0) {
            o.setMember("type" (SpRemote.str(e.typeId)))
        }
        if (((array_length e.values) > 0) || ((array_length e.dropped) > 0)) {
            def fs:VlJson (VlJson.objectValue())
            def i2:int 0
            while (i2 < (array_length e.values)) {
                def v:SpValue (itemAt e.values i2)
                fs.setMember(v.key (SpRemote.valueJson(v)))
                i2 = (i2 + 1)
            }
            def d2:int 0
            while (d2 < (array_length e.dropped)) {
                fs.setMember((itemAt e.dropped d2) (VlJson.nullValue()))
                d2 = (d2 + 1)
            }
            o.setMember("fields" fs)
        }
        if e.hasCost {
            def c:SpCost e.cost
            def co:VlJson (VlJson.objectValue())
            co.setMember("amount" (VlJson.numberValue(c.amount)))
            co.setMember("payer" (SpRemote.str(c.payer)))
            co.setMember("scope" (SpRemote.str(c.scope)))
            co.setMember("instalments" (VlJson.intValue(c.instalments)))
            if (c.first >= 0) {
                co.setMember("first" (SpRemote.str((SpSpace.dateText(c.first)))))
            }
            co.setMember("every_months" (VlJson.intValue(c.everyMonths)))
            if (c.remindDays >= 0) {
                co.setMember("remind_days" (VlJson.intValue(c.remindDays)))
            }
            o.setMember("cost" co)
        } {
            if e.costDropped {
                o.setMember("cost" (VlJson.nullValue()))
            }
        }
        return o
    }

    ; A field's value as JSON keeps it.
    sfn valueJson:VlJson (v:SpValue) {
        if (v.kind == "bool") {
            return (VlJson.boolValue((v.text == "true")))
        }
        if (v.kind == "number") {
            def d@(optional):double (str2double v.text)
            if (!null? d) {
                return (VlJson.numberValue((unwrap d)))
            }
        }
        return (SpRemote.str(v.text))
    }

    sfn write:string (v:VlJson) {
        def w (new VlJsonWriter())
        return (w.write(v))
    }

    ; save_event: the space, the event's id ("" makes a new one) and its fields
    sfn saveBody:string (spaceId:string e:SpEvent) {
        def o:VlJson (SpRemote.eventObj(e))
        o.setMember("space_id" (SpRemote.str(spaceId)))
        o.setMember("event_id" (SpRemote.str(e.remoteId)))
        return (SpRemote.write(o))
    }

    ; delete_event
    sfn deleteBody:string (spaceId:string remoteId:string) {
        return (SpRemote.body(([] _:string ( "space_id" spaceId "event_id" remoteId ))))
    }

    ; budget: months "YYYY-MM", the whole group's ("") or one person's
    sfn budgetBody:string (spaceId:string from:string to:string payer:string) {
        def o:VlJson (VlJson.objectValue())
        o.setMember("space_id" (SpRemote.str(spaceId)))
        o.setMember("from" (SpRemote.str(from)))
        o.setMember("to" (SpRemote.str(to)))
        if ((strlen payer) > 0) {
            o.setMember("person" (SpRemote.str(payer)))
        }
        return (SpRemote.write(o))
    }

    ; import_events: many events at once, none with an id
    sfn importBody:string (spaceId:string events:[SpEvent]) {
        def o:VlJson (VlJson.objectValue())
        o.setMember("space_id" (SpRemote.str(spaceId)))
        def list:VlJson (VlJson.arrayValue())
        def i:int 0
        while (i < (array_length events)) {
            push list.arr (SpRemote.eventObj((itemAt events i)))
            i = (i + 1)
        }
        o.setMember("events" list)
        return (SpRemote.write(o))
    }

    ; A body of string fields: keys and values in turn.
    sfn body:string (pairs:[string]) {
        def o:VlJson (VlJson.objectValue())
        def i:int 0
        while ((i + 1) < (array_length pairs)) {
            o.setMember((itemAt pairs i) (SpRemote.str((itemAt pairs (i + 1)))))
            i = (i + 2)
        }
        return (SpRemote.write(o))
    }
}
