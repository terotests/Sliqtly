; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; SpacesModel — a shared space: its people or things, events, deadlines,
; sheets and documents, and what happens today, this week and next week
; =============================================================================
; Nothing here draws. The page (SpacesApp.rgr) and the checks
; (SpacesCheck.rgr) read the same answers.
;
; Days are whole days from 1970-01-01 (EVGUI UiDate), times minutes from
; midnight. A week starts on Monday.
;
; Repeating events carry a small RRULE: FREQ DAILY, WEEKLY or MONTHLY,
; INTERVAL, BYDAY (weekly), UNTIL (a day, inclusive) and COUNT, and skip the
; days in `exdates`. `occurrences(from to)` expands them into one SpOccur per
; day an event happens on, sorted by day, all-day first, then start time.
;
; A ward is what a space looks after: a child, a pet, a car, a client, a
; team (SpResource, named by the vocabulary pack). An event may name its ward
; and who is responsible for it, each with a role ("takes", "picks up").
;
; A space kept on a server is loaded with `beginLoad`, `loadWard`,
; `loadEvent` and the calls after it, from the server's own strings (dates
; "YYYY-MM-DD", times "HH:MM", an RRULE). What the calendar changes is marked
; `dirty` for the page to save, and `remoteId` is the server's id once it has.
;
; An entry has a type (SpacesTypes.rgr: a party invitation, a thing, a
; renewal …; "" is a plain event), the type's field values and maybe a cost
; that goes to a budget. A record (kept in a list) may have no date: its day
; is -1 and it is on no calendar.
;
; Sheets are tables of text. A sheet whose columns name a date (and maybe a
; time, a title and a resource) is a source of events: `sheetEvents` reads
; those rows, so a schedule kept as a spreadsheet shows up in the summary and
; the calendar beside the events made here. CSV and tab-separated text (what
; a spreadsheet puts on the clipboard) are read by `SpSheet.parse`.
; =============================================================================

Import "../evgui/src/UiDate.rgr"
Import "SpacesTypes.rgr"

class SpResource {
    def id:string ""
    def name:string ""
    def color:string "blue"
    Constructor () {
    }
}

; Who looks after an event, and how: "Mia" who "takes".
class SpWho {
    def name:string ""
    def role:string ""
    Constructor () {
    }

    ; "Takes: Mia", or the name alone
    fn text:string () {
        def r:string (trim role)
        if ((strlen r) == 0) {
            return name
        }
        return ((to_uppercase (substring r 0 1)) + (substring r 1 (strlen r)) + ": " + name)
    }

    ; "Takes: Mia, Picks up: Juho" (what `listText` writes) back into a
    ; list; a part without a colon is a name alone.
    sfn parseList:[SpWho] (text:string) {
        def out:[SpWho]
        def parts:[string] (strsplit text ",")
        def i:int 0
        while (i < (array_length parts)) {
            def part:string (trim (itemAt parts i))
            if ((strlen part) > 0) {
                def w (new SpWho())
                def at:int (indexOf part ":")
                if (at > 0) {
                    def r:string (trim (substring part 0 at))
                    w.role = ((to_lowercase (substring r 0 1)) + (substring r 1 (strlen r)))
                    w.name = (trim (substring part (at + 1) (strlen part)))
                } {
                    w.name = part
                }
                if ((strlen w.name) > 0) {
                    push out w
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn listText:string (list:[SpWho]) {
        def parts:[string]
        def i:int 0
        while (i < (array_length list)) {
            def w:SpWho (itemAt list i)
            push parts (w.text())
            i = (i + 1)
        }
        return (join parts ", ")
    }
}

; A member of a space kept on a server.
class SpMember {
    def uid:string ""
    def name:string ""
    def email:string ""
    ; "owner" or "member"
    def role:string "member"
    Constructor () {
    }
}

; One field value of an entry: its text and how JSON keeps it ("string",
; "number" or "bool").
class SpValue {
    def key:string ""
    def text:string ""
    def kind:string "string"
    Constructor () {
    }
}

; What an entry costs and who pays it. Personal is one payer's own budget;
; shared is the group's. Paid in `instalments` parts, the first on `first`
; (a day, -1: the entry's day) and then every `everyMonths` months.
class SpCost {
    def amount:double 0.0
    def payer:string ""
    def scope:string "personal"
    def instalments:int 1
    def first:int -1
    def everyMonths:int 1
    ; days before each payment day to remind of it (-1: not said, which is
    ; three for a cost in parts and none for one payment; 0: none)
    def remindDays:int -1
    Constructor () {
    }

    ; The days before each payment to remind of it, -1 for none.
    fn remindBefore:int () {
        if (remindDays > 0) {
            return remindDays
        }
        if ((remindDays < 0) && (instalments > 1)) {
            return 3
        }
        return -1
    }
}

class SpRule {
    ; "" (once), "daily", "weekly" or "monthly"
    def freq:string ""
    def interval:int 1
    ; weekdays for a weekly rule, 0 = Sunday … 6 = Saturday; empty = the
    ; event's own weekday
    def byDay:[int]
    ; the last day it may happen on (0 = no end)
    def until:int 0
    ; how many times it happens (0 = no limit)
    def count:int 0
    Constructor () {
    }

    sfn dayCodes:[string] () {
        return ([] _:string ( "SU" "MO" "TU" "WE" "TH" "FR" "SA" ))
    }

    ; An RRULE ("FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,WE;UNTIL=20261231;COUNT=5")
    ; into this rule. Parts it does not know are left out. False when there is
    ; no FREQ it knows.
    fn parse:boolean (text:string) {
        freq = ""
        interval = 1
        def none:[int]
        byDay = none
        until = 0
        count = 0
        def t:string (trim text)
        if ((indexOf (to_uppercase t) "RRULE:") == 0) {
            t = (substring t 6 (strlen t))
        }
        def parts:[string] (strsplit t ";")
        def i:int 0
        while (i < (array_length parts)) {
            def kv:string (trim (itemAt parts i))
            def eqAt:int (indexOf kv "=")
            if (eqAt > 0) {
                def k:string (to_uppercase (trim (substring kv 0 eqAt)))
                def v:string (to_uppercase (trim (substring kv (eqAt + 1) (strlen kv))))
                if (k == "FREQ") {
                    if (v == "DAILY") {
                        freq = "daily"
                    }
                    if (v == "WEEKLY") {
                        freq = "weekly"
                    }
                    if (v == "MONTHLY") {
                        freq = "monthly"
                    }
                }
                if (k == "INTERVAL") {
                    def n:int (SpText.number(v))
                    if (n > 0) {
                        interval = n
                    }
                }
                if (k == "COUNT") {
                    def c:int (SpText.number(v))
                    if (c > 0) {
                        count = c
                    }
                }
                if (k == "UNTIL") {
                    ; 20261231 or 20261231T235959Z: the date part
                    if ((strlen v) >= 8) {
                        def d:int (SpText.ymd((SpText.number((substring v 0 4))) (SpText.number((substring v 4 6))) (SpText.number((substring v 6 8)))))
                        if (d >= 0) {
                            until = d
                        }
                    }
                }
                if (k == "BYDAY") {
                    def codes:[string] (SpRule.dayCodes())
                    def ds:[string] (strsplit v ",")
                    def j:int 0
                    while (j < (array_length ds)) {
                        def code:string (trim (itemAt ds j))
                        def w:int 0
                        while (w < 7) {
                            if (code == (itemAt codes w)) {
                                push byDay w
                            }
                            w = (w + 1)
                        }
                        j = (j + 1)
                    }
                }
            }
            i = (i + 1)
        }
        return ((strlen freq) > 0)
    }

    ; The rule as an RRULE, "" for an event that happens once.
    fn toText:string () {
        if ((strlen freq) == 0) {
            return ""
        }
        def parts:[string]
        push parts ("FREQ=" + (to_uppercase freq))
        if (interval > 1) {
            push parts ("INTERVAL=" + (to_string interval))
        }
        if ((array_length byDay) > 0) {
            def codes:[string] (SpRule.dayCodes())
            def ds:[string]
            def i:int 0
            while (i < (array_length byDay)) {
                push ds (itemAt codes (itemAt byDay i))
                i = (i + 1)
            }
            push parts ("BYDAY=" + (join ds ","))
        }
        if (until > 0) {
            def iso:string (UiDate.isoOfDays(until))
            push parts ("UNTIL=" + (substring iso 0 4) + (substring iso 5 7) + (substring iso 8 10))
        }
        if (count > 0) {
            push parts ("COUNT=" + (to_string count))
        }
        return (join parts ";")
    }
}

class SpEvent {
    def id:string ""
    def title:string ""
    def day:int 0
    ; -1 for an all-day event
    def startMin:int -1
    def endMin:int -1
    ; the last day of an all-day event that spans days (inclusive)
    def endDay:int 0
    def resource:string ""
    def place:string ""
    def color:string ""
    def rule:SpRule (new SpRule())
    def exdates:[int]
    ; the sheet an event was read from, "" for one made here
    def source:string ""
    def notes:string ""
    ; who is responsible for it, and how
    def who:[SpWho]
    def important:boolean false
    ; on a server: its id there ("" until saved), where it was imported
    ; from and its id in that source
    def remoteId:string ""
    def origin:string ""
    def extId:string ""
    ; changed here and not saved yet; `rev` counts the changes, so a save
    ; answered after a newer change leaves the event dirty
    def dirty:boolean false
    def rev:int 0
    ; its type ("" is a plain event), the type's field values, and the keys
    ; removed here that the server still has (sent as null on the next save)
    def typeId:string ""
    def values:[SpValue]
    def dropped:[string]
    def hasCost:boolean false
    def cost:SpCost (new SpCost())
    ; a cost removed here that the server still has
    def costDropped:boolean false
    ; a deadline's first day to remind on, as the server said (-1: not said)
    def remindFrom:int -1
    Constructor () {
    }

    fn dated:boolean () {
        return (day >= 0)
    }

    fn value@(optional):SpValue (key:string) {
        def found@(optional):SpValue
        def i:int 0
        while (i < (array_length values)) {
            def v:SpValue (itemAt values i)
            if (v.key == key) {
                found = v
            }
            i = (i + 1)
        }
        return found
    }

    ; A field's value as text, "" when it has none.
    fn fieldText:string (key:string) {
        def v@(optional):SpValue (this.value(key))
        if (null? v) {
            return ""
        }
        def vv:SpValue v
        return vv.text
    }

    fn fieldOn:boolean (key:string) {
        return ((this.fieldText(key)) == "true")
    }

    ; A number field's value, or `dflt` when it has none.
    fn fieldNumber:double (key:string dflt:double) {
        def t:string (this.fieldText(key))
        if ((strlen t) == 0) {
            return dflt
        }
        def d@(optional):double (str2double t)
        if (null? d) {
            return dflt
        }
        return (unwrap d)
    }

    ; Set a field ("" removes it).
    fn setField:void (key:string text:string kind:string) {
        if ((strlen text) == 0) {
            this.clearField(key)
            return
        }
        def kept:[string]
        def i:int 0
        while (i < (array_length dropped)) {
            if ((itemAt dropped i) != key) {
                push kept (itemAt dropped i)
            }
            i = (i + 1)
        }
        dropped = kept
        def v@(optional):SpValue (this.value(key))
        if (!null? v) {
            def vv:SpValue v
            vv.text = text
            vv.kind = kind
            return
        }
        def nv (new SpValue())
        nv.key = key
        nv.text = text
        nv.kind = kind
        push values nv
    }

    fn clearField:void (key:string) {
        def kept:[SpValue]
        def had:boolean false
        def i:int 0
        while (i < (array_length values)) {
            def v:SpValue (itemAt values i)
            if (v.key == key) {
                had = true
            } {
                push kept v
            }
            i = (i + 1)
        }
        values = kept
        if had {
            push dropped key
        }
    }

    fn setCost:void (c:SpCost) {
        cost = c
        hasCost = true
        costDropped = false
    }

    fn clearCost:void () {
        if hasCost {
            costDropped = true
        }
        hasCost = false
        cost = (new SpCost())
    }

    ; The server has what was sent at change count `atRev`: what was removed
    ; is gone there too, unless it changed again since.
    fn saved:void (atRev:int) {
        if (rev == atRev) {
            dirty = false
            def none:[string]
            dropped = none
            costDropped = false
        }
    }

    ; A deadline's first day to remind on: what the server said, or
    ; `remind_days` (30 when not given) before its day.
    fn remindDay:int () {
        if (remindFrom >= 0) {
            return remindFrom
        }
        return (day - (to_int (this.fieldNumber("remind_days" 30.0))))
    }

    ; A deadline on `today`: "late" after its day, "due" from its remind day
    ; on, "" before that or without a day.
    fn dueState:string (today:int) {
        if (day < 0) {
            return ""
        }
        if (day < today) {
            return "late"
        }
        if ((this.remindDay()) <= today) {
            return "due"
        }
        return ""
    }

    fn touch:void () {
        dirty = true
        rev = (rev + 1)
    }

    fn addWho:SpWho (name:string role:string) {
        def w (new SpWho())
        w.name = name
        w.role = role
        push who w
        return w
    }

    fn allDay:boolean () {
        return (startMin < 0)
    }

    fn repeats:boolean () {
        return ((strlen rule.freq) > 0)
    }

    fn skips:boolean (d:int) {
        def i:int 0
        while (i < (array_length exdates)) {
            if ((itemAt exdates i) == d) {
                return true
            }
            i = (i + 1)
        }
        return false
    }
}

; One day an event happens on.
class SpOccur {
    def id:string ""
    def eventId:string ""
    def title:string ""
    def day:int 0
    def endDay:int 0
    def startMin:int -1
    def endMin:int -1
    def resource:string ""
    def place:string ""
    def color:string ""
    def source:string ""
    def repeats:boolean false
    def who:[SpWho]
    def important:boolean false
    def typeId:string ""
    ; a window to get something in or a payment day, not the entry's own
    def derived:boolean false
    Constructor () {
    }

    fn allDay:boolean () {
        return (startMin < 0)
    }

    ; before another in a day's list: all-day first, then by start, then title
    fn before:boolean (o:SpOccur) {
        if (day != o.day) {
            return (day < o.day)
        }
        if ((this.allDay()) != (o.allDay())) {
            return (this.allDay())
        }
        if (startMin != o.startMin) {
            return (startMin < o.startMin)
        }
        return ((SpText.compare(title o.title)) < 0)
    }
}

class SpDeadline {
    def id:string ""
    def title:string ""
    def day:int 0
    def resource:string ""
    def done:boolean false
    Constructor () {
    }
}

class SpDoc {
    def id:string ""
    def title:string ""
    ; Markdown
    def body:string ""
    def day:int 0
    Constructor () {
    }
}

class SpSheet {
    def id:string ""
    def name:string ""
    def cols:[string]
    ; row by row, `cols` cells each
    def cells:[string]
    Constructor () {
    }

    fn rowCount:int () {
        def n:int (array_length cols)
        if (n == 0) {
            return 0
        }
        return (idiv (array_length cells) n)
    }

    fn cell:string (r:int c:int) {
        def n:int (array_length cols)
        def i:int ((r * n) + c)
        if ((c < 0) || ((c >= n) || ((i < 0) || (i >= (array_length cells))))) {
            return ""
        }
        return (itemAt cells i)
    }

    fn addRow:void (row:[string]) {
        def c:int 0
        while (c < (array_length cols)) {
            if (c < (array_length row)) {
                push cells (itemAt row c)
            } {
                push cells ""
            }
            c = (c + 1)
        }
    }

    ; The first column whose heading is one of `names` (any case), or -1.
    fn colOf:int (names:[string]) {
        def c:int 0
        while (c < (array_length cols)) {
            def h:string (to_lowercase (trim (itemAt cols c)))
            def k:int 0
            while (k < (array_length names)) {
                if (h == (itemAt names k)) {
                    return c
                }
                k = (k + 1)
            }
            c = (c + 1)
        }
        return -1
    }

    ; CSV or tab-separated text into a sheet: the first row is the headings.
    ; A tab anywhere in the first line means tabs (a spreadsheet's clipboard);
    ; otherwise commas, or semicolons when the first line has more of those
    ; (a Finnish spreadsheet's CSV). Quotes as RFC 4180 has them.
    sfn parse:SpSheet (id:string name:string text:string) {
        def sh (new SpSheet())
        sh.id = id
        sh.name = name
        def rows:[string] (SpSheet.records(text))
        if ((array_length rows) == 0) {
            return sh
        }
        def first:string (itemAt rows 0)
        def sep:int 44
        if ((indexOf first "\t") >= 0) {
            sep = 9
        } {
            if ((SpText.countOf(first 59)) > (SpText.countOf(first 44))) {
                sep = 59
            }
        }
        def heads:[string] (SpSheet.fields(first sep))
        def i:int 0
        while (i < (array_length heads)) {
            push sh.cols (trim (itemAt heads i))
            i = (i + 1)
        }
        def r:int 1
        while (r < (array_length rows)) {
            def line:string (itemAt rows r)
            if ((strlen (trim line)) > 0) {
                sh.addRow((SpSheet.fields(line sep)))
            }
            r = (r + 1)
        }
        return sh
    }

    ; The records of the text: lines, except a line break inside quotes.
    sfn records:[string] (text:string) {
        def out:[string]
        def cur:string ""
        def quoted:boolean false
        def start:int 0
        def i:int 0
        def n:int (strlen text)
        while (i < n) {
            def c:int (charAt text i)
            if (c == 34) {
                quoted = (quoted == false)
            }
            if ((c == 10) && (quoted == false)) {
                cur = (substring text start i)
                if ((strlen cur) > 0) {
                    if ((charAt cur ((strlen cur) - 1)) == 13) {
                        cur = (substring cur 0 ((strlen cur) - 1))
                    }
                }
                push out cur
                start = (i + 1)
            }
            i = (i + 1)
        }
        if (start < n) {
            cur = (substring text start n)
            if ((charAt cur ((strlen cur) - 1)) == 13) {
                cur = (substring cur 0 ((strlen cur) - 1))
            }
            push out cur
        }
        return out
    }

    sfn fields:[string] (line:string sep:int) {
        def out:[string]
        def cur:string ""
        def quoted:boolean false
        def i:int 0
        def n:int (strlen line)
        while (i < n) {
            def c:int (charAt line i)
            if quoted {
                if (c == 34) {
                    if (((i + 1) < n) && ((charAt line (i + 1)) == 34)) {
                        cur = (cur + "\"")
                        i = (i + 1)
                    } {
                        quoted = false
                    }
                } {
                    cur = (cur + (substring line i (i + 1)))
                }
            } {
                if (c == 34) {
                    quoted = true
                } {
                    if (c == sep) {
                        push out cur
                        cur = ""
                    } {
                        cur = (cur + (substring line i (i + 1)))
                    }
                }
            }
            i = (i + 1)
        }
        push out cur
        return out
    }

    ; The sheet as CSV (commas, quotes where a cell needs them).
    fn toCsv:string () {
        def lines:[string]
        push lines (SpSheet.csvLine(cols))
        def r:int 0
        while (r < (this.rowCount())) {
            def row:[string]
            def c:int 0
            while (c < (array_length cols)) {
                push row (this.cell(r c))
                c = (c + 1)
            }
            push lines (SpSheet.csvLine(row))
            r = (r + 1)
        }
        return ((join lines "\n") + "\n")
    }

    sfn csvLine:string (row:[string]) {
        def parts:[string]
        def i:int 0
        while (i < (array_length row)) {
            def v:string (itemAt row i)
            if (((indexOf v ",") >= 0) || (((indexOf v "\"") >= 0) || ((indexOf v "\n") >= 0))) {
                push parts ("\"" + (SpText.doubleQuotes(v)) + "\"")
            } {
                push parts v
            }
            i = (i + 1)
        }
        return (join parts ",")
    }
}

; Small text helpers the model needs and the page shares.
class SpText {
    sfn countOf:int (s:string code:int) {
        def n:int 0
        def i:int 0
        while (i < (strlen s)) {
            if ((charAt s i) == code) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn doubleQuotes:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            if ((charAt s i) == 34) {
                out = (out + "\"\"")
            } {
                out = (out + (substring s i (i + 1)))
            }
            i = (i + 1)
        }
        return out
    }

    sfn compare:int (a:string b:string) {
        def la:string (to_lowercase a)
        def lb:string (to_lowercase b)
        if (la == lb) {
            return 0
        }
        def i:int 0
        while ((i < (strlen la)) && (i < (strlen lb))) {
            def ca:int (charAt la i)
            def cb:int (charAt lb i)
            if (ca != cb) {
                return (ca - cb)
            }
            i = (i + 1)
        }
        return ((strlen la) - (strlen lb))
    }

    ; digits only, or -1
    sfn number:int (s:string) {
        def t:string (trim s)
        if ((strlen t) == 0) {
            return -1
        }
        def v:int 0
        def i:int 0
        while (i < (strlen t)) {
            def c:int (charAt t i)
            if ((c < 48) || (c > 57)) {
                return -1
            }
            v = ((v * 10) + (c - 48))
            i = (i + 1)
        }
        return v
    }

    ; "2026-10-19", "19.10.2026", "19.10." (this year) or "10/19/2026" into a
    ; day, or -1.
    sfn dayOf:int (s:string year:int) {
        def t:string (trim s)
        if ((indexOf t "-") > 0) {
            def p:[string] (strsplit t "-")
            if ((array_length p) == 3) {
                return (SpText.ymd((SpText.number((itemAt p 0))) (SpText.number((itemAt p 1))) (SpText.number((itemAt p 2)))))
            }
            return -1
        }
        if ((indexOf t ".") > 0) {
            def q:[string] (strsplit t ".")
            if ((array_length q) >= 2) {
                def y:int year
                if ((array_length q) >= 3) {
                    if ((strlen (trim (itemAt q 2))) > 0) {
                        y = (SpText.number((itemAt q 2)))
                    }
                }
                return (SpText.ymd(y (SpText.number((itemAt q 1))) (SpText.number((itemAt q 0)))))
            }
            return -1
        }
        if ((indexOf t "/") > 0) {
            def r:[string] (strsplit t "/")
            if ((array_length r) == 3) {
                return (SpText.ymd((SpText.number((itemAt r 2))) (SpText.number((itemAt r 0))) (SpText.number((itemAt r 1)))))
            }
        }
        return -1
    }

    sfn ymd:int (y:int m:int d:int) {
        if ((y < 1970) || ((m < 1) || ((m > 12) || (d < 1)))) {
            return -1
        }
        if (d > (UiDate.daysInMonth(y m))) {
            return -1
        }
        return (UiDate.toDays(y m d))
    }

    ; "9", "9:30", "9.30", "09:30" into minutes, or -1.
    sfn minuteOf:int (s:string) {
        def t:string (trim s)
        if ((strlen t) == 0) {
            return -1
        }
        def at:int (indexOf t ":")
        if (at < 0) {
            at = (indexOf t ".")
        }
        if (at < 0) {
            def h0:int (SpText.number(t))
            if ((h0 < 0) || (h0 > 24)) {
                return -1
            }
            return (h0 * 60)
        }
        def h:int (SpText.number((substring t 0 at)))
        def m:int (SpText.number((substring t (at + 1) (strlen t))))
        if ((h < 0) || ((h > 24) || ((m < 0) || (m > 59)))) {
            return -1
        }
        return ((h * 60) + m)
    }
}

; What a stretch of days holds: the summary's sections.
class SpRange {
    def key:string ""
    def from:int 0
    ; inclusive
    def to:int 0
    def items:[SpOccur]
    def deadlines:[SpDeadline]
    Constructor () {
    }

    fn isEmpty:boolean () {
        return (((array_length items) == 0) && ((array_length deadlines) == 0))
    }
}

class SpSpace {
    def id:string "space"
    def name:string ""
    ; demo, family, business or sports (SpacesVocab)
    def vocab:string "demo"
    ; "fi" or "en"
    def lang:string ""
    ; kept on a server: its id there, the members and the invited emails,
    ; and whether the one viewing owns it
    def remoteId:string ""
    def members:[SpMember]
    def invites:[string]
    def myRole:string "owner"
    def resources:[SpResource]
    def events:[SpEvent]
    def deadlines:[SpDeadline]
    def sheets:[SpSheet]
    def docs:[SpDoc]
    def made:int 0
    ; the day the space calls today: a sheet's "19.10." is in its year
    def today:int 0
    ; the entry types (SpacesTypes.rgr): which types are kept in lists only
    def types:SpTypes (new SpTypes())
    ; the calendar shows the windows to get things in and the payment days
    ; of costs paid in parts (each can be hidden), titled in `wordsLang`
    def showGets:boolean true
    def showPays:boolean true
    def wordsLang:string "fi"
    Constructor () {
    }

    ; The day `months` months after `d`, on the same day of the month or the
    ; month's last day when it is shorter.
    sfn addMonths:int (d:int months:int) {
        def p:[int] (SpSpace.ymdOf(d))
        def idx:int ((((itemAt p 0) * 12) + ((itemAt p 1) - 1)) + months)
        def y:int (idiv idx 12)
        def m:int ((idx - (y * 12)) + 1)
        def dom:int (itemAt p 2)
        def last:int (UiDate.daysInMonth(y m))
        if (dom > last) {
            dom = last
        }
        return (UiDate.toDays(y m dom))
    }

    ; The days between which the entry's thing is got: its get_from and
    ; get_by, else its type's own (a missing thing by its day, a need by
    ; needed_by until bought); get_by alone is got in the two weeks before
    ; it, get_from alone by the entry's day. [from by], or none.
    fn getWindow:[int] (e:SpEvent) {
        def out:[int]
        def year:int (itemAt (SpSpace.ymdOf(today)) 0)
        def fromText:string (e.fieldText("get_from"))
        def byText:string (e.fieldText("get_by"))
        if (((strlen fromText) == 0) && ((strlen byText) == 0)) {
            def t@(optional):SpType (types.find(e.typeId))
            if (null? t) {
                return out
            }
            def tt:SpType t
            if ((strlen tt.getBy) == 0) {
                return out
            }
            if (((strlen tt.whenField) > 0) && ((e.fieldText(tt.whenField)) != tt.whenIs)) {
                return out
            }
            def k:int 0
            while (k < (array_length tt.doneFields)) {
                def dv:string (e.fieldText((itemAt tt.doneFields k)))
                def want:string (itemAt tt.doneIs k)
                if (((strlen dv) > 0) && (((strlen want) == 0) || (dv == want))) {
                    return out
                }
                k = (k + 1)
            }
            if (tt.getBy == "date") {
                if (e.dated()) {
                    byText = (UiDate.isoOfDays(e.day))
                }
            } {
                byText = (e.fieldText(tt.getBy))
            }
        }
        def from:int -1
        def by:int -1
        if ((strlen fromText) > 0) {
            from = (SpText.dayOf(fromText year))
        }
        if ((strlen byText) > 0) {
            by = (SpText.dayOf(byText year))
        }
        if ((by < 0) && (from >= 0)) {
            by = from
            if ((e.dated()) && (e.day > from)) {
                by = e.day
            }
        }
        if (by < 0) {
            return out
        }
        if ((from < 0) || (from > by)) {
            from = (by - 14)
        }
        push out from
        push out by
        return out
    }

    ; The payment days of the entry's cost when it is reminded of (a cost in
    ; parts, or one with remind_days): every part's day, in order.
    fn payDays:[int] (e:SpEvent) {
        def out:[int]
        if ((e.hasCost == false) || (e.cost.amount <= 0.0)) {
            return out
        }
        def c:SpCost e.cost
        if ((c.remindBefore()) < 0) {
            return out
        }
        def first:int c.first
        if (first < 0) {
            first = e.day
        }
        if (first < 0) {
            return out
        }
        def n:int c.instalments
        if (n < 1) {
            n = 1
        }
        def every:int c.everyMonths
        if (every < 1) {
            every = 1
        }
        def k:int 0
        while (k < n) {
            push out (SpSpace.addMonths(first (k * every)))
            k = (k + 1)
        }
        return out
    }

    ; What the calendar shows of an entry besides its own days: the window
    ; to get its thing in (important while it is open) and its payment days
    ; (important from their reminder on), from `from` to `to`. A closed
    ; entry (done, cancelled, archived) has none.
    fn derivedOf:[SpOccur] (e:SpEvent from:int to:int) {
        def out:[SpOccur]
        def st:string (e.fieldText("status"))
        if (((st == "done") || (st == "cancelled")) || (st == "archived")) {
            return out
        }
        def en:boolean (wordsLang == "en")
        if showGets {
            def w:[int] (this.getWindow(e))
            if ((array_length w) == 2) {
                def gf:int (itemAt w 0)
                def gb:int (itemAt w 1)
                if ((gb >= from) && (gf <= to)) {
                    def word:string "Hanki: "
                    if en {
                        word = "Get: "
                    }
                    def o:SpOccur (this.derivedOcc(e (e.id + "#get") (word + e.title) gf gb))
                    o.important = ((today >= gf) && (today <= gb))
                    push out o
                }
            }
        }
        if showPays {
            def days:[int] (this.payDays(e))
            def before:int (e.cost.remindBefore())
            def cents:int (to_int (((e.cost.amount * 100.0) / (to_double (array_length days))) + 0.5))
            def amount:string (SpTypes.numText(((to_double cents) / 100.0)))
            def k:int 0
            while (k < (array_length days)) {
                def d:int (itemAt days k)
                if ((d >= from) && (d <= to)) {
                    def word2:string "Maksu: "
                    if en {
                        word2 = "Payment: "
                    }
                    def p:SpOccur (this.derivedOcc(e (e.id + "#pay" + (to_string k)) (word2 + e.title + " " + amount + " €") d d))
                    p.important = ((today >= (d - before)) && (today <= d))
                    push out p
                }
                k = (k + 1)
            }
        }
        return out
    }

    ; An all-day occurrence of an entry that is not one of its own days: it
    ; opens the entry and is not moved on the calendar; it counts as
    ; repeating, so ticking it opens the entry rather than closing it.
    fn derivedOcc:SpOccur (e:SpEvent id:string title:string day:int endDay:int) {
        def o (new SpOccur())
        o.eventId = e.id
        o.id = id
        o.title = title
        o.day = day
        o.endDay = endDay
        o.resource = e.resource
        o.color = e.color
        if ((strlen o.color) == 0) {
            o.color = (this.resourceColor(e.resource))
        }
        o.repeats = true
        o.derived = true
        o.typeId = e.typeId
        return o
    }

    sfn ymdOf:[int] (d:int) {
        def p:[int] ([] _:int ( 0 0 0 ))
        UiDate.fromDays(d p)
        return p
    }

    ; --- making -----------------------------------------------------------------

    fn nextId:string (prefix:string) {
        made = (made + 1)
        return (prefix + (to_string made))
    }

    fn addResource:SpResource (id:string name:string color:string) {
        def r (new SpResource())
        r.id = id
        r.name = name
        r.color = color
        push resources r
        return r
    }

    fn addEvent:SpEvent (title:string day:int startMin:int endMin:int resource:string) {
        def e (new SpEvent())
        e.id = (this.nextId("e"))
        e.title = title
        e.day = day
        e.endDay = day
        e.startMin = startMin
        e.endMin = endMin
        e.resource = resource
        push events e
        return e
    }

    fn addAllDay:SpEvent (title:string day:int lastDay:int resource:string) {
        def e:SpEvent (this.addEvent(title day -1 -1 resource))
        e.endDay = lastDay
        return e
    }

    fn addDeadline:SpDeadline (title:string day:int resource:string) {
        def d (new SpDeadline())
        d.id = (this.nextId("d"))
        d.title = title
        d.day = day
        d.resource = resource
        push deadlines d
        return d
    }

    fn addDoc:SpDoc (title:string body:string day:int) {
        def d (new SpDoc())
        d.id = (this.nextId("doc"))
        d.title = title
        d.body = body
        d.day = day
        push docs d
        return d
    }

    fn addSheet:SpSheet (sh:SpSheet) {
        if ((strlen sh.id) == 0) {
            sh.id = (this.nextId("s"))
        }
        push sheets sh
        return sh
    }

    ; --- finding ----------------------------------------------------------------

    fn event@(optional):SpEvent (id:string) {
        def found@(optional):SpEvent
        def i:int 0
        while (i < (array_length events)) {
            def e:SpEvent (itemAt events i)
            if (e.id == id) {
                found = e
            }
            i = (i + 1)
        }
        return found
    }

    fn resourceName:string (id:string) {
        def i:int 0
        while (i < (array_length resources)) {
            def r:SpResource (itemAt resources i)
            if (r.id == id) {
                return r.name
            }
            i = (i + 1)
        }
        return ""
    }

    fn resourceColor:string (id:string) {
        def i:int 0
        while (i < (array_length resources)) {
            def r:SpResource (itemAt resources i)
            if (r.id == id) {
                return r.color
            }
            i = (i + 1)
        }
        return "blue"
    }

    ; An occurrence's ward and who looks after it: "Aino · Takes: Juho".
    fn aboutOf:string (o:SpOccur) {
        def parts:[string]
        def ward:string (this.resourceName(o.resource))
        if ((strlen ward) > 0) {
            push parts ward
        }
        def resp:string (SpWho.listText(o.who))
        if ((strlen resp) > 0) {
            push parts resp
        }
        return (join parts " · ")
    }

    ; the resource a cell names, by id or by name (any case), or ""
    fn resourceFor:string (text:string) {
        def t:string (to_lowercase (trim text))
        if ((strlen t) == 0) {
            return ""
        }
        def i:int 0
        while (i < (array_length resources)) {
            def r:SpResource (itemAt resources i)
            if (((to_lowercase r.id) == t) || ((to_lowercase r.name) == t)) {
                return r.id
            }
            i = (i + 1)
        }
        return ""
    }

    ; --- the days events happen on ------------------------------------------------

    ; Every day in [from, to] the event happens on, in order.
    fn daysOf:[int] (e:SpEvent from:int to:int) {
        def out:[int]
        if ((e.repeats()) == false) {
            ; an all-day span shows on the first day it overlaps
            def last:int e.day
            if ((e.allDay()) && (e.endDay > e.day)) {
                last = e.endDay
            }
            if ((last >= from) && (e.day <= to)) {
                push out e.day
            }
            return out
        }
        def rule:SpRule e.rule
        def step:int rule.interval
        if (step < 1) {
            step = 1
        }
        def stop:int to
        if ((rule.until > 0) && (rule.until < stop)) {
            stop = rule.until
        }
        def n:int 0
        if (rule.freq == "daily") {
            def d:int e.day
            while (d <= stop) {
                if ((rule.count > 0) && (n >= rule.count)) {
                    return out
                }
                n = (n + 1)
                if ((d >= from) && ((e.skips(d)) == false)) {
                    push out d
                }
                d = (d + step)
            }
            return out
        }
        if (rule.freq == "weekly") {
            def days:[int] rule.byDay
            def week:SpWeek (this.weekOf(e))
            if week.ok {
                days = (week.days())
            }
            if ((array_length days) == 0) {
                days = ([] _:int ( (UiDate.weekday(e.day)) ))
            }
            ; weeks counted from the Monday of the first one
            def mon0:int (SpSpace.mondayOf(e.day))
            def w:int 0
            while ((mon0 + (w * 7)) <= stop) {
                if ((w % step) == 0) {
                    def k:int 0
                    while (k < 7) {
                        def d2:int ((mon0 + (w * 7)) + k)
                        if ((d2 >= e.day) && ((d2 <= stop) && (SpSpace.hasDay(days (UiDate.weekday(d2)))))) {
                            if ((rule.count > 0) && (n >= rule.count)) {
                                return out
                            }
                            n = (n + 1)
                            if ((d2 >= from) && ((e.skips(d2)) == false)) {
                                push out d2
                            }
                        }
                        k = (k + 1)
                    }
                }
                w = (w + 1)
            }
            return out
        }
        if (rule.freq == "monthly") {
            def p:[int] ([] _:int ( 0 0 0 ))
            UiDate.fromDays(e.day p)
            def y:int (itemAt p 0)
            def m:int (itemAt p 1)
            def dom:int (itemAt p 2)
            def guard:int 0
            while (guard < 1200) {
                ; a month without that date (the 31st) is skipped, as RFC 5545 says
                if (dom <= (UiDate.daysInMonth(y m))) {
                    def d3:int (UiDate.toDays(y m dom))
                    if (d3 > stop) {
                        return out
                    }
                    if ((rule.count > 0) && (n >= rule.count)) {
                        return out
                    }
                    n = (n + 1)
                    if ((d3 >= from) && ((e.skips(d3)) == false)) {
                        push out d3
                    }
                } {
                    if ((UiDate.toDays(y m 1)) > stop) {
                        return out
                    }
                }
                m = (m + step)
                while (m > 12) {
                    m = (m - 12)
                    y = (y + 1)
                }
                guard = (guard + 1)
            }
        }
        return out
    }

    sfn hasDay:boolean (days:[int] wd:int) {
        def i:int 0
        while (i < (array_length days)) {
            if ((itemAt days i) == wd) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn mondayOf:int (d:int) {
        def w:int (UiDate.weekday(d))
        return (d - ((w + 6) % 7))
    }

    ; An event's times per weekday (its type's weektimes field); not `ok`
    ; when it has none.
    fn weekOf:SpWeek (e:SpEvent) {
        def t@(optional):SpType (types.find(e.typeId))
        if (null? t) {
            return (new SpWeek())
        }
        def tt:SpType t
        def i:int 0
        while (i < (array_length tt.fields)) {
            def f:SpField (itemAt tt.fields i)
            if (f.type == "weektimes") {
                def text:string (e.fieldText(f.key))
                if ((strlen text) > 0) {
                    return (SpWeek.read(text))
                }
            }
            i = (i + 1)
        }
        return (new SpWeek())
    }

    ; The days in [from, to] an event does not happen on because its type
    ; skips them: a school day on a holiday or an exception day of the same
    ; ward (or of no ward), unless that day says the school is open.
    fn skippedDays:[int] (e:SpEvent all:[SpEvent] from:int to:int) {
        def out:[int]
        def t@(optional):SpType (types.find(e.typeId))
        if (null? t) {
            return out
        }
        def tt:SpType t
        if ((array_length tt.skips) == 0) {
            return out
        }
        def i:int 0
        while (i < (array_length all)) {
            def x:SpEvent (itemAt all i)
            def hit:boolean false
            def k:int 0
            while (k < (array_length tt.skips)) {
                if ((itemAt tt.skips k) == x.typeId) {
                    hit = true
                }
                k = (k + 1)
            }
            if (((hit && (x.dated())) && (((strlen x.resource) == 0) || (x.resource == e.resource))) && ((x.fieldOn("school_open")) == false)) {
                def ds:[int] (this.daysOf(x from to))
                def j:int 0
                while (j < (array_length ds)) {
                    def first:int (itemAt ds j)
                    def last:int (first + (x.endDay - x.day))
                    if (last < first) {
                        last = first
                    }
                    def d:int first
                    while (d <= last) {
                        push out d
                        d = (d + 1)
                    }
                    j = (j + 1)
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; One SpOccur for every day in [from, to] each event happens on, sheet
    ; rows included, sorted. An event with times per weekday starts and ends
    ; at each day's own.
    fn occurrences:[SpOccur] (from:int to:int) {
        def out:[SpOccur]
        def all:[SpEvent] (this.allEvents())
        def i:int 0
        while (i < (array_length all)) {
            def e:SpEvent (itemAt all i)
            def days:[int] (this.daysOf(e from to))
            if (((e.dated()) == false) || ((types.kindOf(e.typeId)) == "record")) {
                def none:[int]
                days = none
            }
            def week:SpWeek (this.weekOf(e))
            def off:[int] (this.skippedDays(e all from to))
            def k:int 0
            while (k < (array_length days)) {
                def d:int (itemAt days k)
                if (SpSpace.hasDay(off d)) {
                    k = (k + 1)
                    continue
                }
                def o (new SpOccur())
                o.eventId = e.id
                o.id = e.id
                if (e.repeats()) {
                    o.id = (e.id + "@" + (to_string d))
                }
                o.title = e.title
                o.day = d
                o.endDay = (d + (e.endDay - e.day))
                if (o.endDay < d) {
                    o.endDay = d
                }
                o.startMin = e.startMin
                o.endMin = e.endMin
                if (week.ok && (week.on((UiDate.weekday(d))))) {
                    o.startMin = (itemAt week.starts (UiDate.weekday(d)))
                    o.endMin = (itemAt week.ends (UiDate.weekday(d)))
                    o.endDay = d
                }
                o.resource = e.resource
                o.place = e.place
                o.color = e.color
                if ((strlen o.color) == 0) {
                    o.color = (this.resourceColor(e.resource))
                }
                o.source = e.source
                o.repeats = (e.repeats())
                o.who = e.who
                o.important = e.important
                o.typeId = e.typeId
                SpSpace.insertSorted(out o)
                k = (k + 1)
            }
            def more:[SpOccur] (this.derivedOf(e from to))
            def m:int 0
            while (m < (array_length more)) {
                SpSpace.insertSorted(out (itemAt more m))
                m = (m + 1)
            }
            i = (i + 1)
        }
        return out
    }

    sfn insertSorted:void (list:[SpOccur] o:SpOccur) {
        push list o
        def i:int ((array_length list) - 1)
        while (i > 0) {
            def prev:SpOccur (itemAt list (i - 1))
            if (o.before(prev)) {
                set list i prev
                set list (i - 1) o
                i = (i - 1)
            } {
                return
            }
        }
    }

    ; the events made here, then the rows of every sheet that has dates
    fn allEvents:[SpEvent] () {
        def out:[SpEvent]
        def i:int 0
        while (i < (array_length events)) {
            push out (itemAt events i)
            i = (i + 1)
        }
        def s:int 0
        while (s < (array_length sheets)) {
            def rows:[SpEvent] (this.sheetEvents((itemAt sheets s)))
            def k:int 0
            while (k < (array_length rows)) {
                push out (itemAt rows k)
                k = (k + 1)
            }
            s = (s + 1)
        }
        return out
    }

    ; A sheet's rows as events, when it has a date column. Its columns are
    ; found by heading in English or Finnish: date/päivä/pvm, time/aika or
    ; start/alkaa + end/loppuu, title/what/mitä/otsikko/tapahtuma, and
    ; who/kuka/resource/resurssi. A row without a date that reads is left out.
    fn sheetEvents:[SpEvent] (sh:SpSheet) {
        def year:int (itemAt (SpSpace.ymdOf(today)) 0)
        def out:[SpEvent]
        def cDate:int (sh.colOf(([] _:string ( "date" "day" "päivä" "pvm" "päivämäärä" ))))
        if (cDate < 0) {
            return out
        }
        def cTime:int (sh.colOf(([] _:string ( "time" "aika" "klo" ))))
        def cStart:int (sh.colOf(([] _:string ( "start" "starts" "alkaa" "alku" ))))
        def cEnd:int (sh.colOf(([] _:string ( "end" "ends" "loppuu" "loppu" ))))
        def cTitle:int (sh.colOf(([] _:string ( "title" "what" "event" "mitä" "otsikko" "tapahtuma" "aihe" ))))
        def cWho:int (sh.colOf(([] _:string ( "who" "resource" "kuka" "resurssi" "vastuu" ))))
        def r:int 0
        while (r < (sh.rowCount())) {
            def d:int (SpText.dayOf((sh.cell(r cDate)) year))
            if (d >= 0) {
                def e (new SpEvent())
                e.id = (sh.id + "-r" + (to_string (r + 1)))
                e.source = sh.id
                e.day = d
                e.endDay = d
                e.title = sh.name
                if (cTitle >= 0) {
                    if ((strlen (trim (sh.cell(r cTitle)))) > 0) {
                        e.title = (trim (sh.cell(r cTitle)))
                    }
                }
                def s:int -1
                def en:int -1
                if (cTime >= 0) {
                    ; "9.00-10.30" or "9:00"
                    def tm:string (sh.cell(r cTime))
                    def dash:int (indexOf tm "-")
                    if (dash > 0) {
                        s = (SpText.minuteOf((substring tm 0 dash)))
                        en = (SpText.minuteOf((substring tm (dash + 1) (strlen tm))))
                    } {
                        s = (SpText.minuteOf(tm))
                    }
                }
                if (cStart >= 0) {
                    s = (SpText.minuteOf((sh.cell(r cStart))))
                }
                if (cEnd >= 0) {
                    en = (SpText.minuteOf((sh.cell(r cEnd))))
                }
                if ((s >= 0) && (en <= s)) {
                    en = (s + 60)
                }
                e.startMin = s
                e.endMin = en
                if (s < 0) {
                    e.endMin = -1
                }
                if (cWho >= 0) {
                    e.resource = (this.resourceFor((sh.cell(r cWho))))
                }
                push out e
            }
            r = (r + 1)
        }
        return out
    }

    ; --- the summary --------------------------------------------------------------

    ; Today; the rest of this week (tomorrow to Sunday, empty on a Sunday);
    ; and next week, Monday to Sunday.
    fn summary:[SpRange] (now:int) {
        def out:[SpRange]
        def mon:int (SpSpace.mondayOf(now))
        push out (this.range("today" now now))
        push out (this.range("week" (now + 1) (mon + 6)))
        push out (this.range("next" (mon + 7) (mon + 13)))
        return out
    }

    fn range:SpRange (key:string from:int to:int) {
        def r (new SpRange())
        r.key = key
        r.from = from
        r.to = to
        if (to < from) {
            return r
        }
        r.items = (this.occurrences(from to))
        def i:int 0
        while (i < (array_length deadlines)) {
            def d:SpDeadline (itemAt deadlines i)
            if (((d.day >= from) && (d.day <= to)) && (d.done == false)) {
                push r.deadlines d
            }
            i = (i + 1)
        }
        return r
    }

    ; deadlines before today that are not done
    fn overdue:[SpDeadline] (now:int) {
        def out:[SpDeadline]
        def i:int 0
        while (i < (array_length deadlines)) {
            def d:SpDeadline (itemAt deadlines i)
            if ((d.day < now) && (d.done == false)) {
                push out d
            }
            i = (i + 1)
        }
        return out
    }

    ; how many occurrences each resource has in [from, to], in resource order
    fn loadOf:[int] (from:int to:int) {
        def out:[int]
        def occ:[SpOccur] (this.occurrences(from to))
        def i:int 0
        while (i < (array_length resources)) {
            def r:SpResource (itemAt resources i)
            def n:int 0
            def k:int 0
            while (k < (array_length occ)) {
                if ((itemAt occ k).resource == r.id) {
                    n = (n + 1)
                }
                k = (k + 1)
            }
            push out n
            i = (i + 1)
        }
        return out
    }

    ; --- changes from the calendar ------------------------------------------------

    ; The calendar moved or resized an occurrence. A single event takes the
    ; new day and times; one day of a repeating event becomes an exception
    ; (EXDATE) and a single event of its own. A row from a sheet is the
    ; sheet's: it is not changed here, and false says so.
    fn moveOccurrence:boolean (occId:string day:int startMin:int endMin:int) {
        if ((indexOf occId "#") >= 0) {
            return false
        }
        def at:int (indexOf occId "@")
        def baseId:string occId
        def onDay:int -1
        if (at > 0) {
            baseId = (substring occId 0 at)
            onDay = (SpText.number((substring occId (at + 1) (strlen occId))))
        }
        def found@(optional):SpEvent (this.event(baseId))
        if (null? found) {
            return false
        }
        def e:SpEvent (unwrap found)
        if (onDay < 0) {
            def span:int (e.endDay - e.day)
            e.day = day
            e.endDay = (day + span)
            if ((e.allDay()) == false) {
                e.startMin = startMin
                e.endMin = endMin
            }
            e.touch()
            return true
        }
        push e.exdates onDay
        e.touch()
        def one:SpEvent (this.addEvent(e.title day e.startMin e.endMin e.resource))
        if ((e.allDay()) == false) {
            one.startMin = startMin
            one.endMin = endMin
        }
        one.endDay = (day + (e.endDay - e.day))
        one.place = e.place
        one.color = e.color
        one.notes = e.notes
        one.important = e.important
        one.typeId = e.typeId
        def iv:int 0
        while (iv < (array_length e.values)) {
            def v:SpValue (itemAt e.values iv)
            one.setField(v.key v.text v.kind)
            iv = (iv + 1)
        }
        def i:int 0
        while (i < (array_length e.who)) {
            def w:SpWho (itemAt e.who i)
            one.addWho(w.name w.role)
            i = (i + 1)
        }
        one.touch()
        return true
    }

    ; The events changed here and not saved yet.
    fn dirtyEvents:[SpEvent] () {
        def out:[SpEvent]
        def i:int 0
        while (i < (array_length events)) {
            def e:SpEvent (itemAt events i)
            if e.dirty {
                push out e
            }
            i = (i + 1)
        }
        return out
    }

    ; --- entries -------------------------------------------------------------------

    ; The event an occurrence id ("e3", or "e3@20500" for one day of a
    ; repeating event) is of, "" for a sheet's row or none.
    fn eventIdOf:string (occId:string) {
        def at:int (indexOf occId "@")
        def baseId:string occId
        if (at > 0) {
            baseId = (substring occId 0 at)
        }
        ; a window to get something in or a payment day: "e1#get", "e1#pay3"
        def hash:int (indexOf baseId "#")
        if (hash > 0) {
            baseId = (substring baseId 0 hash)
        }
        if (null? (this.event(baseId))) {
            return ""
        }
        return baseId
    }

    ; The day of a repeating event's occurrence id, or -1.
    sfn occDayOf:int (occId:string) {
        def at:int (indexOf occId "@")
        if (at <= 0) {
            return -1
        }
        return (SpText.number((substring occId (at + 1) (strlen occId))))
    }

    ; Take an event out of the space; null when there is none.
    fn removeEvent@(optional):SpEvent (id:string) {
        def found@(optional):SpEvent
        def kept:[SpEvent]
        def i:int 0
        while (i < (array_length events)) {
            def e:SpEvent (itemAt events i)
            if (e.id == id) {
                found = e
            } {
                push kept e
            }
            i = (i + 1)
        }
        events = kept
        return found
    }

    ; An event taken out goes back, as it was.
    fn putBack:void (e:SpEvent) {
        if (null? (this.event(e.id))) {
            push events e
        }
    }

    ; One day of a repeating event is left out of the series.
    fn skipDay:boolean (id:string d:int) {
        def found@(optional):SpEvent (this.event(id))
        if (null? found) {
            return false
        }
        def e:SpEvent found
        if (e.skips(d)) {
            return false
        }
        push e.exdates d
        e.touch()
        return true
    }

    ; …and back in.
    fn unskipDay:boolean (id:string d:int) {
        def found@(optional):SpEvent (this.event(id))
        if (null? found) {
            return false
        }
        def e:SpEvent found
        def kept:[int]
        def had:boolean false
        def i:int 0
        while (i < (array_length e.exdates)) {
            if ((itemAt e.exdates i) == d) {
                had = true
            } {
                push kept (itemAt e.exdates i)
            }
            i = (i + 1)
        }
        e.exdates = kept
        if had {
            e.touch()
        }
        return had
    }

    ; The entries of a type, dated ones first by day, then by title.
    fn entriesOf:[SpEvent] (typeId:string) {
        def out:[SpEvent]
        def i:int 0
        while (i < (array_length events)) {
            def e:SpEvent (itemAt events i)
            if (e.typeId == typeId) {
                push out e
                def k:int ((array_length out) - 1)
                while (k > 0) {
                    def prev:SpEvent (itemAt out (k - 1))
                    if (SpSpace.entryBefore(e prev)) {
                        set out k prev
                        set out (k - 1) e
                        k = (k - 1)
                    } {
                        k = 0
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn entryBefore:boolean (a:SpEvent b:SpEvent) {
        if ((a.dated()) != (b.dated())) {
            return (a.dated())
        }
        if (a.day != b.day) {
            return (a.day < b.day)
        }
        return ((SpText.compare(a.title b.title)) < 0)
    }

    ; Deadline entries due or late on `today` (their remind day reached),
    ; the earliest first.
    fn dueEntries:[SpEvent] (now:int) {
        def out:[SpEvent]
        def i:int 0
        while (i < (array_length events)) {
            def e:SpEvent (itemAt events i)
            if (((types.kindOf(e.typeId)) == "deadline") && ((strlen (e.dueState(now))) > 0)) {
                push out e
                def k:int ((array_length out) - 1)
                while (k > 0) {
                    def prev:SpEvent (itemAt out (k - 1))
                    if (e.day < prev.day) {
                        set out k prev
                        set out (k - 1) e
                        k = (k - 1)
                    } {
                        k = 0
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; The payers named in the space's costs and its members, each once.
    fn payers:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length members)) {
            def m:SpMember (itemAt members i)
            SpSpace.addOnce(out m.name)
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length events)) {
            def e:SpEvent (itemAt events k)
            if e.hasCost {
                SpSpace.addOnce(out e.cost.payer)
            }
            k = (k + 1)
        }
        return out
    }

    sfn addOnce:void (list:[string] v:string) {
        def t:string (trim v)
        if ((strlen t) == 0) {
            return
        }
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == t) {
                return
            }
            i = (i + 1)
        }
        push list t
    }

    fn eventByRemote@(optional):SpEvent (rid:string) {
        def found@(optional):SpEvent
        def i:int 0
        while (i < (array_length events)) {
            def e:SpEvent (itemAt events i)
            if (e.remoteId == rid) {
                found = e
            }
            i = (i + 1)
        }
        return found
    }

    ; --- loading a space kept on a server ------------------------------------------
    ; The page reads the server's answer and calls these in order: beginLoad,
    ; then loadWard for each ward, loadEvent for each event (each followed by
    ; its loadRule, loadExdate and loadWho), loadMember and loadInvite.
    ; Nothing loaded is dirty.

    fn beginLoad:void (spaceName:string vocabName:string) {
        name = spaceName
        vocab = vocabName
        def r:[SpResource]
        resources = r
        def e:[SpEvent]
        events = e
        def d:[SpDeadline]
        deadlines = d
        def m:[SpMember]
        members = m
        def iv:[string]
        invites = iv
    }

    fn loadWard:SpResource (wid:string wname:string color:string) {
        def c:string (SpSpace.pageColor(color))
        if ((strlen c) == 0) {
            ; none, or one the page has no class for: the next of its own
            c = (itemAt (SpSpace.palette()) ((array_length resources) % (array_length (SpSpace.palette()))))
        }
        return (this.addResource(wid wname c))
    }

    ; The colours the page draws (spaces.css .sp-c-*, EVGUI's board).
    sfn palette:[string] () {
        return ([] _:string ( "blue" "emerald" "violet" "amber" "rose" "cyan" "indigo" ))
    }

    ; A colour the server keeps, as one of the page's; "" when it has none
    ; (empty, or #rrggbb).
    sfn pageColor:string (c:string) {
        if ((indexOf (SpSpace.palette()) c) >= 0) {
            return c
        }
        if (c == "green") { return "emerald" }
        if (c == "teal") { return "cyan" }
        if ((c == "red") || (c == "pink")) { return "rose" }
        if (c == "purple") { return "violet" }
        if ((c == "yellow") || (c == "orange")) { return "amber" }
        if (c == "gray") { return "indigo" }
        return ""
    }

    ; One event: `date` and `endDate` "YYYY-MM-DD" (no end date: one day),
    ; `start` and `end` "HH:MM" (no start: all day). Null when the date does
    ; not read.
    fn loadEvent@(optional):SpEvent (rid:string title:string date:string endDate:string start:string end:string ward:string place:string color:string notes:string important:boolean) {
        def made@(optional):SpEvent
        def year:int (itemAt (SpSpace.ymdOf(today)) 0)
        def d:int (SpText.dayOf(date year))
        if (d < 0) {
            return made
        }
        def s:int (SpText.minuteOf(start))
        def en:int -1
        if (s >= 0) {
            en = (SpText.minuteOf(end))
            if (en <= s) {
                en = (s + 60)
            }
        }
        def e:SpEvent (this.addEvent(title d s en ward))
        def last:int (SpText.dayOf(endDate year))
        if (last > d) {
            e.endDay = last
        }
        e.remoteId = rid
        e.place = place
        e.color = (SpSpace.pageColor(color))
        e.notes = notes
        e.important = important
        made = e
        return made
    }

    ; A record with no date: kept in a list, on no calendar.
    fn loadUndated:SpEvent (rid:string title:string ward:string place:string color:string notes:string important:boolean) {
        def e:SpEvent (this.addEvent(title -1 -1 -1 ward))
        e.remoteId = rid
        e.place = place
        e.color = (SpSpace.pageColor(color))
        e.notes = notes
        e.important = important
        return e
    }

    fn loadRule:void (e:SpEvent rrule:string) {
        e.rule.parse(rrule)
    }

    fn loadExdate:void (e:SpEvent date:string) {
        def d:int (SpText.dayOf(date (itemAt (SpSpace.ymdOf(today)) 0)))
        if (d >= 0) {
            push e.exdates d
        }
    }

    fn loadMember:SpMember (uid:string mname:string email:string role:string) {
        def m (new SpMember())
        m.uid = uid
        m.name = mname
        m.email = email
        m.role = role
        push members m
        return m
    }

    fn loadInvite:void (email:string) {
        push invites email
    }

    ; How many events and deadlines name a ward.
    fn wardUses:int (id:string) {
        def n:int 0
        def k:int 0
        while (k < (array_length events)) {
            def e:SpEvent (itemAt events k)
            if (e.resource == id) {
                n = (n + 1)
            }
            k = (k + 1)
        }
        def j:int 0
        while (j < (array_length deadlines)) {
            def d:SpDeadline (itemAt deadlines j)
            if (d.resource == id) {
                n = (n + 1)
            }
            j = (j + 1)
        }
        return n
    }

    ; A ward goes; its events and deadlines stay, without a ward.
    fn removeWard:void (id:string) {
        def left:[SpResource]
        def i:int 0
        while (i < (array_length resources)) {
            def r:SpResource (itemAt resources i)
            if (r.id != id) {
                push left r
            }
            i = (i + 1)
        }
        resources = left
        this.renameWard(id "")
    }

    ; A ward takes the id the server gave it, and so do its events and
    ; deadlines.
    fn renameWard:void (from:string to:string) {
        def i:int 0
        while (i < (array_length resources)) {
            def r:SpResource (itemAt resources i)
            if (r.id == from) {
                r.id = to
            }
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length events)) {
            def e:SpEvent (itemAt events k)
            if (e.resource == from) {
                e.resource = to
            }
            k = (k + 1)
        }
        def j:int 0
        while (j < (array_length deadlines)) {
            def d:SpDeadline (itemAt deadlines j)
            if (d.resource == from) {
                d.resource = to
            }
            j = (j + 1)
        }
    }

    ; --- the server's strings ----------------------------------------------------

    sfn dateText:string (d:int) {
        return (UiDate.isoOfDays(d))
    }

    ; "09:30", "" for no time
    sfn timeText:string (m:int) {
        if (m < 0) {
            return ""
        }
        def h:int (idiv m 60)
        def mm:int (m - (h * 60))
        def hs:string (to_string h)
        if (h < 10) {
            hs = ("0" + hs)
        }
        def ms:string (to_string mm)
        if (mm < 10) {
            ms = ("0" + ms)
        }
        return (hs + ":" + ms)
    }
}
