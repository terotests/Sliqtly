    def askNew:boolean false
    def askEdit:string ""
    def askAiField:InputCtl (new InputCtl())
    def askAiAsked:int -1
    def askSel:string ""
    def answerField:InputCtl (new InputCtl())
    def askIds:[string]
    ; what the last question to the assistant was written for ("question":
    ; the Questions view; "" the assistant or the Add menu)
    def sentPurpose:string ""

    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    def transitions:EVGTransition (new EVGTransition())
    def layout@(optional):EVGLayout
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    def pageW:double 1200.0
    def pageH:double 900.0
    def builtW:double 0.0
    def lastX:double 0.0
    def lastY:double 0.0
    ; the page is as tall as what is on it, and at least the window
    def minH:double 600.0

    Constructor () {
    }

    ; =========================================================================
    ; set-up
    ; =========================================================================

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s
        if (today == 0) {
            this.useClock(2026 10 21 600 0)
        }
    }

    ; Today and now, from the host's clock. The checks keep Wednesday
    ; 21 October 2026 at 10:00.
    fn useClock:void (y:int m:int d:int minute:int offset:int) {
        today = (UiDate.toDays(y m d))
        nowMin = minute
        browserOff = offset
        this.load()
    }

    ; The minute moved on the same day: the clock on the summary follows.
    fn setNow:void (minute:int) {
        if (minute == nowMin) {
            return
        }
        nowMin = minute
        if ((tab == "home") && (editing == false)) {
            this.rebuild()
        }
    }

    ; The weather of a place from the host (Open-Meteo's numbers, rounded):
    ; now, today's high and low, the chance of rain and the WMO weather code.
    fn setWeather:void (place:string temp:int hi:int lo:int rain:int code:int) {
        def w@(optional):SpWeather (this.weatherOf(place))
        def one (new SpWeather())
        if (!null? w) {
            one = (unwrap w)
        } {
            one.place = place
            push wx one
        }
        one.temp = temp
        one.hi = hi
        one.lo = lo
        one.rain = rain
        one.code = code
        if ((tab == "home") && (editing == false)) {
            this.rebuild()
        }
    }

    ; The weather of a place by the hour (Open-Meteo's `hourly`, from
    ; today's midnight): {temperature_2m, precipitation_probability,
    ; weather_code}. `temp` and `code` are now's.
    fn setWeatherHours:void (place:string temp:int code:int hours:string) {
        def h:VlJson (SpRemote.parse(hours))
        def ts:VlJson (h.get("temperature_2m"))
        def rs:VlJson (h.get("precipitation_probability"))
        def cs:VlJson (h.get("weather_code"))
        def tl:[int]
        def rl:[int]
        def cl:[int]
        def i:int 0
        while (i < (ts.count())) {
            def tv:VlJson (ts.at(i))
            push tl (floor ((tv.asDouble()) + 0.5))
            def rv:VlJson (rs.at(i))
            push rl (floor ((rv.asDouble()) + 0.5))
            def cv:VlJson (cs.at(i))
            push cl (floor ((cv.asDouble()) + 0.5))
            i = (i + 1)
        }
        this.setWeather(place temp 0 0 0 code)
        def w@(optional):SpWeather (this.weatherOf(place))
        if (null? w) {
            return
        }
        def one:SpWeather (unwrap w)
        one.hourT = tl
        one.hourRain = rl
        one.hourCode = cl
        this.rebuild()
    }

    ; When the school day starts and ends on `day`, in hours: the earliest
    ; start and the latest end of the wards' school and daycare entries, or
    ; 8 and 15.
    fn schoolHours:[int] (day:int) {
        def first:int -1
        def last:int -1
        def occ:[SpOccur] (space.occurrences(day day))
        def i:int 0
        while (i < (array_length occ)) {
            def o:SpOccur (itemAt occ i)
            def school:boolean (((o.typeId == "school_timetable") || (o.typeId == "school")) || (o.typeId == "daycare_day"))
            if (school && (o.startMin >= 0)) {
                if ((first < 0) || (o.startMin < first)) {
                    first = o.startMin
                }
                def e:int (this.endOf(o))
                if (e > last) {
                    last = e
                }
            }
            i = (i + 1)
        }
        def sh:int 8
        def eh:int 15
        if (first >= 0) {
            sh = (idiv first 60)
        }
        if (last > 0) {
            eh = (idiv (last + 30) 60)
        }
        if (eh <= sh) {
            eh = (sh + 1)
        }
        if (eh > 23) {
            eh = 23
        }
        return ([] _:int ( sh eh ))
    }

    fn weatherOf@(optional):SpWeather (place:string) {
        def found@(optional):SpWeather
        def i:int 0
        while (i < (array_length wx)) {
            def w:SpWeather (itemAt wx i)
            if ((to_lowercase w.place) == (to_lowercase place)) {
                found = w
            }
            i = (i + 1)
        }
        return found
    }

    ; The places whose weather the host is to read: [{name, lat, lon}], each
    ; town once; Tampere when the space has none.
    fn weatherPlacesJson:string () {
        def list:VlJson (VlJson.arrayValue())
        def ps:[SpPlace] (space.weatherPlaces())
        def i:int 0
        while (i < (array_length ps)) {
            def p:SpPlace (itemAt ps i)
            def o:VlJson (VlJson.objectValue())
            o.setMember("name" (VlJson.stringValue(p.name)))
            o.setMember("lat" (VlJson.numberValue(p.lat)))
            o.setMember("lon" (VlJson.numberValue(p.lon)))
            push list.arr o
            i = (i + 1)
        }
        return (SpRemote.write(list))
    }

    ; The places of the summary that have weather, in the order they are kept.
    fn shownWeather:[SpWeather] () {
        def out:[SpWeather]
        def ps:[SpPlace] (space.weatherPlaces())
        def i:int 0
        while (i < (array_length ps)) {
            def p:SpPlace (itemAt ps i)
            def w@(optional):SpWeather (this.weatherOf(p.name))
            if (!null? w) {
                push out (unwrap w)
            }
            i = (i + 1)
        }
        return out
    }

    ; What the host found for `placeQuery`: Open-Meteo's geocoding answer,
    ; {results: [{name, latitude, longitude, admin1}]}.
    fn placesFound:void (text:string) {
        placeLooking = false
        def none:[SpPlace]
        found = none
        def rs:VlJson ((SpRemote.parse(text)).get("results"))
        def i:int 0
        while (i < (rs.count())) {
            def r:VlJson (rs.at(i))
            def p (new SpPlace())
            p.name = (r.stringOr("name" ""))
            p.lat = (r.doubleOr("latitude" 0.0))
            p.lon = (r.doubleOr("longitude" 0.0))
            p.detail = (r.stringOr("admin1" ""))
            if ((strlen p.name) > 0) {
                push found p
            }
            i = (i + 1)
        }
        if ((array_length found) == 0) {
            status = ((SpWords.pick(lang "No place in Finland is called " "Suomesta ei löytynyt paikkaa ")) + placeQuery)
        }
        this.rebuild()
    }

    ; A fresh space of the pack's demo data, in the page's language. On a
    ; server the space comes from there (`answer`); until it does it is empty.
    fn load:void () {
        if server {
            space = (new SpSpace())
            space.today = today
        } {
            space = (SpSeed.build(pack lang today))
        }
        space.types = types
        editing = false
        addOpen = false
        addAsked = -1
        sheetSel = ""
        docSel = ""
        def none:[string]
        asked = none
        def none2:[string]
        answers = none2
        def none3:[string]
        doneIds = none3
        def none4:[string]
        doneGone = none4
        def none5:[string]
        doneNotes = none5
        this.newBoard()
        this.rebuild()
    }

    fn newBoard:void () {
        def keepView:string "week"
        def keepCursor:int today
        if (board.today > 0) {
            keepView = board.view
            ; the day it showed, unless the clock moved (the host's clock
            ; replaces the one the page starts with)
            if (board.today == today) {
                keepCursor = board.cursor
            }
        }
        board = (new EcBoard())
        board.browserOff = browserOff
        board.begin("spc" false today nowMin)
        board.lang = lang
        board.weekStart = 1
        board.view = keepView
        board.startH = 7
        board.endH = 22
        ; the hours at full height: the page scrolls, not the grid
        board.fullHeight = true
        board.newTitle = (SpWords.noun(lang pack "event"))
        board.hasSettings = false
        ; Add (above the calendar) is how an entry is made; the bar has no New
        board.hasNew = false
        def i:int 0
        while (i < (array_length space.resources)) {
            def r:SpResource (itemAt space.resources i)
            push board.lanes (EcBoard.col(today r.id r.name r.color))
            i = (i + 1)
        }
        this.fillBoard()
        board.settle()
        board.cursor = keepCursor
    }

    ; =========================================================================
    ; the calendar card and the space
    ; =========================================================================

    ; The card's events: every occurrence from three months back to six ahead.
    fn fillBoard:void () {
        space.wordsLang = lang
        def keep:[CalEvent]
        board.model.events = keep
        def b:[string]
        boardIds = b
        def o:[string]
        occIds = o
        def d:[int]
        occDay = d
        def s:[int]
        occStart = s
        def e:[int]
        occEnd = e
        space.showGets = showGets
        space.showPays = showPays
        def occ:[SpOccur] (space.occurrences((today - 92) (today + 184)))
        space.showGets = true
        space.showPays = true
        ; 7:00-22:00, widened to the earliest and latest event
        def fromH:int 7
        def toH:int 22
        def i:int 0
        while (i < (array_length occ)) {
            def oc:SpOccur (itemAt occ i)
            def id:string ("o" + (to_string i))
            if ((oc.allDay()) == false) {
                def sh:int (idiv oc.startMin 60)
                def eh:int (idiv (oc.endMin + 59) 60)
                if (sh < fromH) {
                    fromH = sh
                }
                if (eh > toH) {
                    toH = eh
                }
            }
            if (oc.allDay()) {
                def ad:CalEvent (board.model.addAllDay(id oc.title oc.day oc.endDay))
                ad.color = oc.color
                ad.resource = oc.resource
            } {
                board.model.addEvent(id oc.title oc.day oc.startMin oc.endMin oc.resource oc.color)
            }
            push boardIds id
            push occIds oc.id
            push occDay oc.day
            push occStart oc.startMin
            push occEnd oc.endMin
            i = (i + 1)
        }
        if (fromH < 0) {
            fromH = 0
        }
        if (toH > 24) {
            toH = 24
        }
        board.startH = fromH
        board.endH = toH
    }

    ; What the card changed, written to the space: a moved or resized event,
    ; and a new one. True when anything was.
    fn syncBack:boolean () {
        def changed:boolean false
        def i:int 0
        while (i < (array_length board.model.events)) {
            def ce:CalEvent (itemAt board.model.events i)
            def k:int (this.boardIndex(ce.id))
            if (k >= 0) {
                def moved:boolean ((ce.startDay != (itemAt occDay k)) || ((ce.allDay == false) && ((ce.startMin != (itemAt occStart k)) || (ce.endMin != (itemAt occEnd k)))))
                if moved {
                    if (space.moveOccurrence((itemAt occIds k) ce.startDay ce.startMin ce.endMin)) {
                        status = (SpWords.pick(lang "Moved " "Siirretty ") + ce.title)
                    } {
                        status = (SpWords.pick(lang "Rows from a sheet are changed in the sheet" "Taulukon rivit muutetaan taulukossa"))
                        if ((indexOf (itemAt occIds k) "#") > 0) {
                            status = (SpWords.pick(lang "Change the days in the entry" "Muuta päivät merkinnästä"))
                        }
                    }
                    changed = true
                }
            } {
                ; made on the card
                if ce.allDay {
                    def ad:SpEvent (space.addAllDay(ce.title ce.startDay ce.endDay ce.resource))
                    ad.touch()
                } {
                    def ev:SpEvent (space.addEvent(ce.title ce.startDay ce.startMin ce.endMin ce.resource))
                    ev.touch()
                }
                status = (SpWords.pick(lang "Added " "Lisätty ") + ce.title)
                changed = true
            }
            i = (i + 1)
        }
        if changed {
            this.fillBoard()
            this.queueSaves()
        }
        return changed
    }

    fn boardIndex:int (id:string) {
        def i:int 0
        while (i < (array_length boardIds)) {
            if ((itemAt boardIds i) == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; =========================================================================
    ; the tree
    ; =========================================================================

    sfn tri:int (on:boolean) {
        if on {
            return (EVGA11yTri.yes())
        }
        return (EVGA11yTri.no())
    }

    sfn px:string (v:double) {
        return ((to_string (to_int v)) + "px")
    }

    sfn box:EVGElement (cls:string) {
        return (UiTree.div("" cls))
    }

    sfn tx:EVGElement (cls:string text:string) {
        return (UiTree.label("" cls text))
    }

    sfn btn:EVGElement (id:string cls:string label:string) {
        def el:EVGElement (UiTree.div(id cls))
        el.role = "button"
        el.a11yFocusable = true
        el.a11yLabel = label
        def t:EVGElement (UiTree.label("" (SpacesApp.txClasses(cls)) label))
        t.a11yHidden = true
        el.addChild(t)
        return el
    }

    ; a button's label takes each of the button's classes with "-tx":
    ; "sp-pill sp-pill-on" labels with "sp-pill-tx sp-pill-on-tx"
    sfn txClasses:string (cls:string) {
        def parts:[string] (UiTree.splitWs(cls))
        def out:[string]
        def i:int 0
        while (i < (array_length parts)) {
            push out ((itemAt parts i) + "-tx")
            i = (i + 1)
        }
        return (join out " ")
    }

    ; a choice button with a dot of its colour before the label
    sfn swatchBtn:EVGElement (id:string cls:string color:string label:string) {
        def el:EVGElement (UiTree.div(id cls))
        el.role = "button"
        el.a11yFocusable = true
        el.a11yLabel = label
        el.addChild((UiTree.div("" ("sp-optdot sp-c-" + color))))
        def t:EVGElement (UiTree.label("" (SpacesApp.txClasses(cls)) label))
        t.a11yHidden = true
        el.addChild(t)
        return el
    }

    sfn dot:EVGElement (color:string) {
        def d:EVGElement (UiTree.div("" ("sp-dot sp-c-" + color)))
        d.a11yHidden = true
        return d
    }

    fn narrow:boolean () {
        return (pageW < 760.0)
    }

    fn mainW:double () {
        if (this.narrow()) {
            return (pageW - 24.0)
        }
        return ((pageW - 220.0) - 48.0)
    }

    fn page:EVGElement () {
        builtW = pageW
        def none:[InputCtl]
        shown = none
        def shell:EVGElement (UiTree.div("sp-shell" "sp-shell"))
        shell.addChild((this.topBar()))
        if (phoneOpen && ((strlen space.feed) > 0)) {
            def pop:EVGElement (SpacesApp.box("sp-phonepop"))
            def pc:EVGElement (this.feedCard())
            pc.role = "dialog"
            def cr:EVGElement (SpacesApp.box("sp-formrow"))
            cr.addChild((SpacesApp.btn("sp-phone-close" "sp-action" (SpWords.pick(lang "Close" "Sulje")))))
            pc.addChild(cr)
            pop.addChild(pc)
            shell.addChild(pop)
        }
        def body:EVGElement (SpacesApp.box("sp-body"))
        if (this.narrow()) {
            body = (SpacesApp.box("sp-body sp-body-narrow"))
        }
        if (((this.narrow()) == false) || menuOpen) {
            body.addChild((this.nav()))
        }
        def main:EVGElement (UiTree.div("sp-main" "sp-main"))
        main.role = "main"
        UiTree.inline(main "width" (SpacesApp.px((this.mainW()))))
        if ((infoOpen && server) && ((strlen spaceId) > 0)) {
            main.addChild((this.infoCard()))
        }
        def noSpace:boolean (server && (((strlen spaceId) == 0) && (loading == false)))
        if ((tab == "spaces") || noSpace) {
            main.addChild((this.spacesView()))
        } {
            if editing {
                main.addChild((this.editorView()))
            } {
                if (tab == "members") {
                    main.addChild((this.membersView()))
                } {
                    main.addChild((this.tabView()))
                }
            }
        }
        body.addChild(main)
        shell.addChild(body)
        if ((strlen status) > 0) {
            def row:EVGElement (SpacesApp.box("sp-statusrow"))
            def st:EVGElement (UiTree.label("sp-status" "sp-status" status))
            st.role = "status"
            row.addChild(st)
            if ((strlen undoKind) > 0) {
                row.addChild((SpacesApp.btn("sp-undo" "sp-action" (SpWords.ui(lang "undo")))))
            }
            shell.addChild(row)
        }
        return shell
    }

    fn tabView:EVGElement () {
        if (tab == "calendar") {
            return (this.calendarView())
        }
        if (tab == "sheets") {
            return (this.sheetsView())
        }
        if (tab == "docs") {
            return (this.docsView())
        }
        if (tab == "assistant") {
            return (this.assistantView())
        }
        if (tab == "lists") {
            return (this.listsView())
        }
        if (tab == "budget") {
            return (this.budgetView())
        }
        if (tab == "questions") {
            return (this.questionsView())
        }
        return (this.homeView())
    }

    fn appName:string () {
        if server {
            return "Warden"
        }
        return "Spaces"
    }

    fn topBar:EVGElement () {
        def bar:EVGElement (SpacesApp.box("sp-top"))
        if (this.narrow()) {
            bar = (SpacesApp.box("sp-top sp-top-narrow"))
        }
        bar.role = "banner"
        if (this.narrow()) {
            bar.addChild((this.menuButton()))
        }
        def brand:EVGElement (SpacesApp.box("sp-brand"))
        def mark:EVGElement (SpacesApp.box("sp-mark"))
        mark.addChild((SpacesApp.tx("sp-mark-tx" (substring (this.appName()) 0 1))))
        brand.addChild(mark)
        brand.addChild((SpacesApp.tx("sp-brand-tx" (this.appName()))))
        bar.addChild(brand)
        if ((this.narrow()) == false) {
            def name:EVGElement (SpacesApp.tx("sp-spacename" space.name))
            bar.addChild(name)
        } {
            ; the menu is closed: the bar names the tab shown
            bar.addChild((SpacesApp.tx("sp-spacename" (SpWords.ui(lang tab)))))
        }
        bar.addChild((SpacesApp.box("sp-grow")))
        ; Warden (on a server) is the family calendar: its words are the family's
        ; and not offered for a change
        def wordsOn:boolean (server == false)
        if (((this.narrow()) == false) && wordsOn) {
            bar.addChild((SpacesApp.tx("sp-pills-label" (SpWords.ui(lang "words")))))
        }
        def packs:[string] (SpWords.packs())
        def pills:EVGElement (SpacesApp.box("sp-pills"))
        pills.role = "group"
        pills.a11yLabel = (SpWords.ui(lang "words"))
        def i:int 0
        while (i < (array_length packs)) {
            def pk:string (itemAt packs i)
            def cls:string "sp-pill"
            if (pk == pack) {
                cls = "sp-pill sp-pill-on"
            }
            def b:EVGElement (SpacesApp.btn(("sp-pack-" + pk) cls (SpWords.packName(lang pk))))
            b.a11yPressed = (SpacesApp.tri((pk == pack)))
            pills.addChild(b)
            i = (i + 1)
        }
        if wordsOn {
            bar.addChild(pills)
        }
        if ((strlen space.feed) > 0) {
            def phw:string (SpWords.pick(lang "Add to phone" "Liitä puhelimeen"))
            def phc:string "sp-action sp-phonebtn"
            if phoneOpen {
                phc = "sp-action sp-phonebtn sp-action-primary"
            }
            def phs:string ("📱 " + phw)
            if (this.narrow()) {
                phs = "📱"
            }
            def ph:EVGElement (SpacesApp.btn("sp-phone" phc phs))
            ph.a11yLabel = phw
            ph.a11yHasPopup = "dialog"
            ph.a11yExpanded = (SpacesApp.tri(phoneOpen))
            bar.addChild(ph)
        }
        ; the info screen: the latest presentation of the space
        if (server && ((strlen spaceId) > 0)) {
            def ic:string "sp-infobtn"
            if infoOpen {
                ic = "sp-infobtn sp-infobtn-on"
            }
            def ib:EVGElement (SpacesApp.btn("sp-info" ic "▶"))
            ib.a11yLabel = (SpWords.pick(lang "Info screen" "Info-näyttö"))
            ib.a11yExpanded = (SpacesApp.tri(infoOpen))
            bar.addChild(ib)
        }
        def lg:EVGElement (SpacesApp.box("sp-pills"))
        lg.role = "group"
        lg.a11yLabel = (SpWords.ui(lang "lang"))
        def langs:[string] (SpWords.langs())
        def k:int 0
        while (k < (array_length langs)) {
            def l:string (itemAt langs k)
            def lc:string "sp-pill"
            if (l == lang) {
                lc = "sp-pill sp-pill-on"
            }
            def lb:EVGElement (SpacesApp.btn(("sp-lang-" + l) lc (to_uppercase l)))
            lb.a11yPressed = (SpacesApp.tri((l == lang)))
            lg.addChild(lb)
            k = (k + 1)
        }
        bar.addChild(lg)
        return bar
    }

    ; three bars that open and close the navigation on a narrow page
    fn menuButton:EVGElement () {
        def cls:string "sp-menubtn"
        if menuOpen {
            cls = "sp-menubtn sp-menubtn-on"
        }
        def b:EVGElement (UiTree.div("sp-menu" cls))
        b.role = "button"
        b.a11yFocusable = true
        b.a11yLabel = (SpWords.ui(lang "menu"))
        b.a11yExpanded = (SpacesApp.tri(menuOpen))
        def i:int 0
        while (i < 3) {
            def bar:EVGElement (UiTree.div("" "sp-menubar"))
            bar.a11yHidden = true
            b.addChild(bar)
            i = (i + 1)
        }
        return b
    }

    fn tabNames:[string] () {
        if server {
            return ([] _:string ( "home" "questions" "calendar" "lists" "budget" "members" "spaces" "sheets" "docs" "assistant" ))
        }
        return ([] _:string ( "home" "calendar" "lists" "budget" "sheets" "docs" "assistant" ))
    }

    ; The host's address names the tab (#calendar); Back and Forward come
    ; here. False for a name that is no tab.
    fn goTab:boolean (name:string) {
        def tabs:[string] (this.tabNames())
        def i:int 0
        while (i < (array_length tabs)) {
            if ((itemAt tabs i) == name) {
                if (name != tab) {
                    this.press(("sp-nav-" + name))
                }
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn nav:EVGElement () {
        def nav:EVGElement (SpacesApp.box("sp-nav"))
        if (this.narrow()) {
            nav = (SpacesApp.box("sp-nav sp-nav-menu"))
        }
        nav.role = "navigation"
        def tabs:[string] (this.tabNames())
        def glyphs:[string] ([] _:string ( "◎" "▦" "☰" "€" "▤" "▧" "✦" ))
        if server {
            glyphs = ([] _:string ( "◎" "?" "▦" "☰" "€" "◈" "▣" "▤" "▧" "◉" "✦" ))
        }
        def i:int 0
        while (i < (array_length tabs)) {
            def t:string (itemAt tabs i)
            def cls:string "sp-navbtn"
            if (t == tab) {
                cls = "sp-navbtn sp-navbtn-on"
                if (this.narrow()) {
                    ; the open menu is drawn on the surface colour
                    cls = "sp-navbtn sp-navbtn-on sp-navbtn-menu-on"
                }
            }
            def label:string (SpWords.ui(lang t))
            def b:EVGElement (UiTree.div(("sp-nav-" + t) cls))
            b.role = "button"
            b.a11yFocusable = true
            b.a11yLabel = label
            b.a11yPressed = (SpacesApp.tri((t == tab)))
            def g:EVGElement (SpacesApp.tx("sp-navglyph" (itemAt glyphs i)))
            g.a11yHidden = true
            b.addChild(g)
            def tl:EVGElement (SpacesApp.tx("sp-navbtn-tx" label))
            tl.a11yHidden = true
            b.addChild(tl)
            if (t == "questions") {
                ; the questions waiting for the person's answer
                def waiting:int (this.askWaiting())
                if (waiting > 0) {
                    b.a11yLabel = (label + " " + (to_string waiting))
                    def badge:EVGElement (UiTree.div("" "sp-count"))
                    badge.a11yHidden = true
                    badge.addChild((SpacesApp.tx("sp-count-tx" (to_string waiting))))
                    b.addChild(badge)
                }
            }
            nav.addChild(b)
            i = (i + 1)
        }
        return nav
    }

    fn heading:EVGElement (title:string sub:string) {
        def h:EVGElement (UiTree.div("sp-head" "sp-head"))
        def t:EVGElement (SpacesApp.tx("sp-h1" title))
        t.role = "heading"
        h.addChild(t)
        if ((strlen sub) > 0) {
            h.addChild((SpacesApp.tx("sp-sub" sub)))
        }
        return h
    }

    ; --- the summary --------------------------------------------------------------
    ; A wall calendar: the clock, the date and the weather on top; then today
    ; as cards, this week day by day with what is coming after it, and what to
    ; remember with the Add button and the wards' colours.

    fn homeView:EVGElement () {
        def none:[int]
        itemDays = none
        def noAsks:[string]
        askIds = noAsks
        def noOccs:[string]
        itemOccs = noOccs
        def noTexts:[string]
        remindTexts = noTexts
        def noUrls:[string]
        linkUrls = noUrls
        def v:EVGElement (SpacesApp.box("sp-view"))
        v.addChild((this.dashHead()))
        v.addChild((this.homeTabs()))
        if ((server && (loading == false)) && (((array_length space.events) == 0) && ((array_length space.resources) == 0))) {
            v.addChild((this.emptyCard()))
        }
        if (homeTab == "week") {
            v.addChild((this.weekBoard()))
            return v
        }
        if (homeTab == "ahead") {
            v.addChild((this.aheadBoard()))
            return v
        }
        def gap:double 28.0
        def w1:double (this.mainW())
        def w2:double w1
        def w3:double w1
        def cols:EVGElement (SpacesApp.box("sp-cols sp-cols-narrow"))
        if ((this.narrow()) == false) {
            cols = (SpacesApp.box("sp-cols sp-dash"))
            def free:double ((this.mainW()) - (gap * 2.0))
            w1 = (free * 0.34)
            w2 = (free * 0.35)
            w3 = ((free - w1) - w2)
        }
        def c1:EVGElement (this.todayCol(w1))
        def c2:EVGElement (this.weekCol(w2))
        def c3:EVGElement (this.rememberCol(w3))
        UiTree.inline(c1 "width" (SpacesApp.px(w1)))
        UiTree.inline(c2 "width" (SpacesApp.px(w2)))
        UiTree.inline(c3 "width" (SpacesApp.px(w3)))
        cols.addChild(c1)
        cols.addChild(c2)
        cols.addChild(c3)
        v.addChild(cols)
        ; the Add menu is long: under the columns, the page's width
        if addOpen {
            v.addChild((this.addMenu()))
        }
        v.addChild((SpacesApp.tx("sp-hint" (SpWords.pick(lang "Tap a plan or a reminder to open it" "Napauta menoa tai muistutusta avataksesi sen")))))
        return v
    }

    ; The summary's pages: today, the week in columns and what is coming.
    fn homeTabs:EVGElement () {
        def bar:EVGElement (SpacesApp.box("sp-htabs"))
        bar.role = "tablist"
        bar.a11yLabel = (SpWords.ui(lang "home"))
        def keys:[string] ([] _:string ( "today" "week" "ahead" ))
        def names:[string] ([] _:string ( (SpWords.ui(lang "today")) (SpWords.pick(lang "Week" "Viikko")) (SpWords.pick(lang "Coming up" "Tulossa")) ))
        def i:int 0
        while (i < (array_length keys)) {
            def k:string (itemAt keys i)
            def cls:string "sp-htab"
            if (k == homeTab) {
                cls = "sp-htab sp-htab-on"
            }
            def b:EVGElement (SpacesApp.btn(("sp-htab-" + k) cls (itemAt names i)))
            b.role = "tab"
            b.a11ySelected = (SpacesApp.tri((k == homeTab)))
            bar.addChild(b)
            i = (i + 1)
        }
        return bar
    }

    ; Viikko: Monday to Sunday side by side, each day's plans with their
    ; times; today filled. On a phone the days are rows.
    fn weekBoard:EVGElement () {
        def cols:EVGElement (UiTree.div("sp-card-weekboard" "sp-wboard"))
        if (this.narrow()) {
            cols = (UiTree.div("sp-card-weekboard" "sp-wboard sp-wboard-narrow"))
        }
        cols.role = "region"
        cols.a11yLabel = (SpWords.pick(lang "Week" "Viikko"))
        def mon:int (SpSpace.mondayOf(today))
        def occ:[SpOccur] (space.occurrences(mon (mon + 6)))
        def gap:double 8.0
        def w:double (((this.mainW()) - (gap * 6.0)) / 7.0)
        if (this.narrow()) {
            w = (this.mainW())
        }
        def d:int mon
        while (d <= (mon + 6)) {
            def cls:string "sp-wcol"
            if (this.narrow()) {
                cls = "sp-wcol sp-wcol-narrow"
            }
            if (d == today) {
                cls = (cls + " sp-wcol-today")
            }
            def col:EVGElement (SpacesApp.box(cls))
            col.role = "listitem"
            col.a11yLabel = (SpWords.dayLabel(lang d))
            UiTree.inline(col "width" (SpacesApp.px(w)))
            def p:[int] (SpSpace.ymdOf(d))
            def hcls:string "sp-wcolday"
            if (d == today) {
                hcls = "sp-wcolday sp-wcolday-today"
            }
            def head:EVGElement (SpacesApp.btn(("sp-day-" + (to_string d)) hcls ((SpWords.wdShort(lang d)) + " " + (to_string (itemAt p 2)) + ".")))
            head.a11yLabel = ((SpWords.dayLabel(lang d)) + ": " + (SpWords.ui(lang "showCal")))
            col.addChild(head)
            def i:int 0
            while (i < (array_length occ)) {
                def o:SpOccur (itemAt occ i)
                if (o.day == d) {
                    col.addChild((this.weekItem(o (w - 20.0))))
                }
                i = (i + 1)
            }
            cols.addChild(col)
            d = (d + 1)
        }
        return cols
    }

    fn weekItem:EVGElement (o:SpOccur w:double) {
        def n:int (this.rowOf(o))
        def row:EVGElement (UiTree.div(("sp-item-" + (to_string n)) "sp-witem"))
        row.role = "button"
        row.a11yFocusable = true
        row.a11yLabel = ((SpWords.timeOf(lang o)) + " " + o.title)
        def dot:EVGElement (SpacesApp.box(("sp-wdot sp-c-" + (this.colorOf(o)))))
        dot.a11yHidden = true
        row.addChild(dot)
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        col.a11yHidden = true
        UiTree.inline(col "width" (SpacesApp.px((w - 22.0))))
        col.addChild((SpacesApp.tx("sp-wititle" o.title)))
        if ((o.allDay()) == false) {
            col.addChild((SpacesApp.tx("sp-witime" (SpWords.clock(lang o.startMin)))))
        }
        row.addChild(col)
        return row
    }

    ; Tulossa: the next plans that are not routine, with how many days away.
    fn aheadBoard:EVGElement () {
        def c:EVGElement (UiTree.div("sp-card-aheadboard" "sp-aboard"))
        c.role = "list"
        c.a11yLabel = (SpWords.pick(lang "Coming up" "Tulossa"))
        def all:[SpOccur] (space.occurrences((today + 1) (today + 90)))
        def shown:int 0
        def i:int 0
        while ((i < (array_length all)) && (shown < 10)) {
            def o:SpOccur (itemAt all i)
            def e@(optional):SpEvent (space.event(o.eventId))
            def open:boolean true
            if (!null? e) {
                open = ((SpacesApp.closed((unwrap e))) == false)
            }
            if (((o.repeats) == false) && open) {
                c.addChild((this.aheadBig(o)))
                shown = (shown + 1)
            }
            i = (i + 1)
        }
        if (shown == 0) {
            c.addChild((SpacesApp.tx("sp-empty" (SpWords.ui(lang "nothing")))))
        }
        return c
    }

    fn aheadBig:EVGElement (o:SpOccur) {
        def n:int (this.rowOf(o))
        def nw:string ""
        def fixed:double 420.0
        if (this.narrow()) {
            nw = "-narrow"
            fixed = 210.0
        }
        def row:EVGElement (UiTree.div(("sp-item-" + (to_string n)) ("sp-abig sp-abig" + nw)))
        row.role = "button"
        row.a11yFocusable = true
        def who:string (space.resourceName(o.resource))
        if ((strlen who) == 0) {
            who = (to_lowercase (SpWords.noun(lang pack "together")))
        }
        if ((strlen o.typeId) > 0) {
            who = (who + " · " + (to_lowercase (this.typeName(o.typeId))))
        }
        def away:string (this.awayText(o.day))
        row.a11yLabel = ((SpWords.dayLabel(lang o.day)) + (this.untilText(o)) + " " + o.title + ", " + who + ", " + away)
        def dl:EVGElement (this.dayStack(o ("sp-abday sp-abday" + nw) ("sp-abend sp-abend" + nw) ("sp-abdaycol sp-abdaycol" + nw)))
        dl.a11yHidden = true
        row.addChild(dl)
        def dot:EVGElement (SpacesApp.box(("sp-abdot sp-c-" + (this.colorOf(o)))))
        dot.a11yHidden = true
        row.addChild(dot)
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        col.a11yHidden = true
        UiTree.inline(col "width" (SpacesApp.px(((this.mainW()) - fixed))))
        col.addChild((SpacesApp.tx(("sp-abtitle sp-abtitle" + nw) o.title)))
        col.addChild((SpacesApp.tx(("sp-abwho sp-abwho" + nw) who)))
        row.addChild(col)
        def aw:EVGElement (SpacesApp.tx(("sp-abaway sp-abaway" + nw) away))
        aw.a11yHidden = true
        row.addChild(aw)
        return row
    }

    ; "huomenna", "3 pv" / "tomorrow", "in 3 days"
    fn awayText:string (day:int) {
        def n:int (day - today)
        if (n == 1) {
            return (SpWords.pick(lang "tomorrow" "huomenna"))
        }
        if (lang == "fi") {
            return ((to_string n) + " pv")
        }
        return ("in " + (to_string n) + " days")
    }

    ; The clock, the day and the week, and the weather when the host has it.
    fn dashHead:EVGElement () {
        def h:EVGElement (UiTree.div("sp-dashhead" "sp-dashhead"))
        if (this.narrow()) {
            h = (UiTree.div("sp-dashhead" "sp-dashhead sp-dashhead-narrow"))
        }
        h.role = "banner"
        def clock:EVGElement (SpacesApp.tx("sp-clock" (SpWords.clock(lang nowMin))))
        clock.a11yLabel = (SpWords.clock(lang nowMin))
        h.addChild(clock)
        def col:EVGElement (SpacesApp.box("sp-datecol"))
        def dt:EVGElement (SpacesApp.tx("sp-date" (SpWords.longDay(lang today))))
        dt.role = "heading"
        col.addChild(dt)
        def sub:string ((SpWords.pick(lang "week " "viikko ")) + (to_string (SpWords.weekNo(today))))
        if ((strlen space.name) > 0) {
            sub = (sub + " · " + space.name)
        }
        if loading {
            sub = (sub + " · " + (SpWords.ui(lang "loading")))
        }
        col.addChild((SpacesApp.tx("sp-datesub" sub)))
        h.addChild(col)
        h.addChild((SpacesApp.box("sp-grow")))
        if ((array_length (this.shownWeather())) > 0) {
            h.addChild((this.weatherCard()))
        }
        return h
    }

    ; The weather of one place; with more, the others' names to switch to.
    fn weatherCard:EVGElement () {
        def all:[SpWeather] (this.shownWeather())
        def w:SpWeather (itemAt all 0)
        def k:int 0
        while (k < (array_length all)) {
            def o:SpWeather (itemAt all k)
            if ((to_lowercase o.place) == (to_lowercase wxSel)) {
                w = o
            }
            k = (k + 1)
        }
        def c:EVGElement (UiTree.div("sp-wx" "sp-wx"))
        def t:string ((to_string w.temp) + "°")
        def whose:string (space.placeWards(w.place))
        def where:string w.place
        if ((strlen whose) > 0) {
            where = (w.place + " (" + whose + ")")
        }
        def l1:string (where + " · " + (SpWords.pick(lang "high " "ylin ")) + (to_string w.hi) + "° " + (SpWords.pick(lang "low " "alin ")) + (to_string w.lo) + "°")
        def l2:string ((SpWords.wxText(lang w.code)) + " · " + (SpWords.pick(lang "rain " "sade ")) + (to_string w.rain) + " %")
        def warn:string ""
        def icon:int w.code
        def nextIcon:string ""
        if ((array_length w.hourT) >= 24) {
            ; the school day: when it starts, midday and when it ends; the
            ; next one once today's is over
            def day:int today
            def off:int 0
            def sch:[int] (this.schoolHours(today))
            if (((idiv nowMin 60) >= (itemAt sch 1)) && ((array_length w.hourT) >= 48)) {
                day = (today + 1)
                off = 24
                sch = (this.schoolHours(day))
            }
            def sh:int (itemAt sch 0)
            def eh:int (itemAt sch 1)
            def slots:[int] ([] _:int ( sh ))
            if ((12 > sh) && (12 < eh)) {
                push slots 12
            }
            push slots eh
            def lo:int 999
            def hi:int -999
            def parts:[string]
            def k2:int 0
            while (k2 < (array_length slots)) {
                def hr:int (itemAt slots k2)
                def tv:int (itemAt w.hourT (off + hr))
                if (tv < lo) {
                    lo = tv
                }
                if (tv > hi) {
                    hi = tv
                }
                push parts ((SpWords.pick(lang "at " "klo ")) + (to_string hr) + " " + (to_string tv) + "°")
                k2 = (k2 + 1)
            }
            def rain:int 0
            def worst:int 0
            def hh:int sh
            while (hh <= eh) {
                def rv:int (itemAt w.hourRain (off + hh))
                if (rv > rain) {
                    rain = rv
                }
                def cv:int (itemAt w.hourCode (off + hh))
                if (cv > worst) {
                    worst = cv
                }
                hh = (hh + 1)
            }
            icon = worst
            def range:string ((to_string lo) + "°")
            if (hi != lo) {
                range = ((to_string lo) + "–" + (to_string hi) + "°")
            }
            if (off > 0) {
                range = (range + (SpWords.pick(lang " tomorrow" " huomenna")))
            }
            l1 = (where + " · " + range + " · " + (SpWords.wxText(lang worst)))
            l2 = ((join parts " · ") + " · " + (SpWords.pick(lang "rain " "sade ")) + (to_string rain) + " %")
            ; the next school day's range and its worst weather, in words
            def noff:int (off + 24)
            if ((array_length w.hourT) >= (noff + 24)) {
                def nsch:[int] (this.schoolHours((day + 1)))
                def nlo:int 999
                def nhi:int -999
                def nworst:int 0
                def nh2:int (itemAt nsch 0)
                while (nh2 <= (itemAt nsch 1)) {
                    def tv2:int (itemAt w.hourT (noff + nh2))
                    if (tv2 < nlo) {
                        nlo = tv2
                    }
                    if (tv2 > nhi) {
                        nhi = tv2
                    }
                    def cv2:int (itemAt w.hourCode (noff + nh2))
                    if (cv2 > nworst) {
                        nworst = cv2
                    }
                    nh2 = (nh2 + 1)
                }
                def deg:string (SpWords.pick(lang "°" " astetta"))
                if ((nlo == nhi) && ((nlo == 1) || (nlo == -1))) {
                    deg = (SpWords.pick(lang "°" " aste"))
                }
                def nrange:string ((to_string nlo) + deg)
                if (nhi != nlo) {
                    nrange = ((to_string nlo) + "–" + (to_string nhi) + deg)
                }
                def when:string (SpWords.pick(lang "Tomorrow" "Huomenna"))
                if (off > 0) {
                    when = (SpWords.pick(lang "Day after tomorrow" "Ylihuomenna"))
                }
                l2 = (when + ": " + nrange + ", " + (SpWords.wxText(lang nworst)))
                nextIcon = (SpWords.wxIcon(nworst))
            }
            ; frost before school: the roads may be slippery
            def cold:int 999
            def nh:int 0
            while (nh <= sh) {
                def nv:int (itemAt w.hourT (off + nh))
                if (nv < cold) {
                    cold = nv
                }
                nh = (nh + 1)
            }
            if (cold < 0) {
                warn = ((SpWords.pick(lang "Slippery roads: " "Liukas keli: ")) + (to_string cold) + (SpWords.pick(lang "° in the night" "° yöllä")))
            }
        }
        c.role = "region"
        def label:string ((SpWords.pick(lang "Weather" "Sää")) + ": " + t + ", " + l1 + ", " + l2)
        if ((strlen warn) > 0) {
            label = (label + ", " + warn)
        }
        c.a11yLabel = label
        def ic:EVGElement (SpacesApp.tx("sp-wxicon" (SpWords.wxIcon(icon))))
        ic.a11yHidden = true
        c.addChild(ic)
        def tt:EVGElement (SpacesApp.tx("sp-wxtemp" t))
        tt.a11yHidden = true
        c.addChild(tt)
        ; the lines are in the card's label; the switches are the tree's own
        def col:EVGElement (SpacesApp.box("sp-wxtext"))
        def t1:EVGElement (SpacesApp.tx("sp-wxline" l1))
        t1.a11yHidden = true
        col.addChild(t1)
        def t2:EVGElement (SpacesApp.tx("sp-wxline" l2))
        t2.a11yHidden = true
        if ((strlen nextIcon) > 0) {
            ; the next day with its symbol, small, after the words
            def row:EVGElement (SpacesApp.box("sp-wxnext"))
            row.addChild(t2)
            def ni:EVGElement (SpacesApp.tx("sp-wxicon-sm" nextIcon))
            ni.a11yHidden = true
            row.addChild(ni)
            col.addChild(row)
        } {
            col.addChild(t2)
        }
        if ((strlen warn) > 0) {
            def t3:EVGElement (SpacesApp.tx("sp-wxwarn" ("⚠ " + warn)))
            t3.a11yHidden = true
            col.addChild(t3)
        }
        c.addChild(col)
        if ((array_length all) > 1) {
            def pills:EVGElement (SpacesApp.box("sp-wxpills"))
            pills.role = "group"
            pills.a11yLabel = (SpWords.pick(lang "Places" "Paikkakunnat"))
            def i:int 0
            while (i < (array_length all)) {
                def o2:SpWeather (itemAt all i)
                def on:boolean (o2.place == w.place)
                def pc:string "sp-wxpill"
                if on {
                    pc = "sp-wxpill sp-wxpill-on"
                }
                def pb:EVGElement (SpacesApp.btn(("sp-wxplace-" + (to_string i)) pc o2.place))
                pb.a11yPressed = (SpacesApp.tri(on))
                pills.addChild(pb)
                i = (i + 1)
            }
            col.addChild(pills)
        }
        return c
    }

    fn card:EVGElement (id:string title:string) {
        def c:EVGElement (UiTree.div(("sp-card-" + id) "sp-card"))
        c.role = "region"
        c.a11yLabel = title
        def t:EVGElement (SpacesApp.tx("sp-cardtitle" title))
        t.role = "heading"
        c.addChild(t)
        return c
    }

    fn section:EVGElement (id:string title:string) {
        def c:EVGElement (UiTree.div(("sp-card-" + id) "sp-col"))
        c.role = "region"
        c.a11yLabel = title
        def t:EVGElement (SpacesApp.tx("sp-sect" title))
        t.role = "heading"
        c.addChild(t)
        return c
    }

    ; The colour an occurrence is drawn in: its own, its ward's, or the
    ; whole group's for one without a ward.
    fn colorOf:string (o:SpOccur) {
        if ((strlen o.resource) == 0) {
            def e@(optional):SpEvent (space.event(o.eventId))
            if (!null? e) {
                if ((strlen e.color) > 0) {
                    return e.color
                }
            }
            return (SpacesApp.groupColor((this.groupOfOcc(o))))
        }
        return o.color
    }

    ; The group of an occurrence's entry type ("event" when unknown).
    fn groupOfOcc:string (o:SpOccur) {
        def t@(optional):SpType (this.typeOf(o.typeId))
        if (null? t) {
            return "event"
        }
        def ty:SpType (unwrap t)
        if (SpacesApp.knownGroup(ty.group)) {
            return ty.group
        }
        return "event"
    }

    ; A plan for no one in particular takes its group's colour; plain
    ; events keep the whole group's.
    sfn groupColor:string (g:string) {
        if (g == "event") {
            return "all"
        }
        return ("g-" + g)
    }

    ; Remembers which day and occurrence the row `sp-item-<n>` is; returns n.
    fn rowOf:int (o:SpOccur) {
        def n:int (array_length itemDays)
        push itemDays o.day
        push itemOccs o.id
        return n
    }

    ; "Aino · Kallion koulu"
    fn wardPlace:string (o:SpOccur) {
        def parts:[string]
        def ward:string (space.resourceName(o.resource))
        if ((strlen ward) > 0) {
            push parts ward
        }
        if ((strlen o.place) > 0) {
            push parts o.place
        }
        if (((array_length parts) == 0) && ((strlen o.source) > 0)) {
            push parts ("▤ " + (this.sheetName(o.source)))
        }
        return (join parts " · ")
    }

    ; --- today ---

    fn todayCol:EVGElement (w:double) {
        def c:EVGElement (this.section("today" (SpWords.ui(lang "today"))))
        ; the first open question, the person's to answer first; the rest
        ; on the Questions view
        if server {
            def qs:[SpEvent] (this.askOpenList())
            if ((array_length qs) > 0) {
                c.addChild((this.askRow((itemAt qs 0) w)))
                if ((array_length qs) > 1) {
                    def more:EVGElement (SpacesApp.btn("sp-askmore" "sp-link" ((SpWords.pick(lang "See more questions" "Katso lisää kysymyksiä")) + " (" + (to_string ((array_length qs) - 1)) + ")")))
                    c.addChild(more)
                }
            }
        }
        def r:SpRange (space.range("today" today today))
        ; windows to get things in and payment days are under Remember
        def own:[SpOccur]
        def j:int 0
        while (j < (array_length r.items)) {
            def oj:SpOccur (itemAt r.items j)
            if (oj.derived == false) {
                push own oj
            }
            j = (j + 1)
        }
        r.items = own
        if ((array_length r.items) == 0) {
            c.addChild((SpacesApp.tx("sp-empty" (SpWords.pick(lang "Nothing planned today" "Ei menoja tänään")))))
            return c
        }
        ; the one going on or coming next is open with its details
        def nextAt:int -1
        def i:int 0
        while (i < (array_length r.items)) {
            def o:SpOccur (itemAt r.items i)
            if ((nextAt < 0) && (((o.allDay()) == false) && ((this.endOf(o)) > nowMin))) {
                nextAt = i
            }
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length r.items)) {
            c.addChild((this.todayCard((itemAt r.items k) (k == nextAt) w)))
            k = (k + 1)
        }
        return c
    }

    fn endOf:int (o:SpOccur) {
        if (o.endMin > o.startMin) {
            return o.endMin
        }
        return (o.startMin + 30)
    }

    fn todayCard:EVGElement (o:SpOccur now:boolean w:double) {
        def urls:[string]
        def n:int (this.rowOf(o))
        def past:boolean (((o.allDay()) == false) && ((this.endOf(o)) <= nowMin))
        def cls:string "sp-tcard"
        if now {
            cls = "sp-tcard sp-tcard-now"
        }
        if past {
            cls = "sp-tcard sp-tcard-past"
        }
        def row:EVGElement (UiTree.div(("sp-item-" + (to_string n)) cls))
        row.role = "button"
        row.a11yFocusable = true
        def about:string (this.wardPlace(o))
        def label:string ((SpWords.timeOf(lang o)) + " " + o.title)
        if ((strlen about) > 0) {
            label = (label + ", " + about)
        }
        if o.important {
            label = ((SpWords.ui(lang "important")) + ": " + label)
        }
        row.a11yLabel = label
        def bar:EVGElement (SpacesApp.box(("sp-tbar sp-c-" + (this.colorOf(o)))))
        bar.a11yHidden = true
        row.addChild(bar)
        def start:string (SpWords.ui(lang "allDay"))
        def tcls:string "sp-ttime sp-ttime-allday"
        if ((o.allDay()) == false) {
            start = (SpWords.clock(lang o.startMin))
            tcls = "sp-ttime"
        }
        def tm:EVGElement (SpacesApp.tx(tcls start))
        tm.a11yHidden = true
        row.addChild(tm)
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        col.a11yHidden = true
        def title:string o.title
        if o.important {
            title = ("★ " + title)
        }
        col.addChild((SpacesApp.tx("sp-ttitle" title)))
        if ((strlen about) > 0) {
            col.addChild((SpacesApp.tx("sp-tmeta" about)))
        }
        if now {
            def parts:[string]
            push parts (SpWords.timeOf(lang o))
            def resp:string (SpWho.listText(o.who))
            if ((strlen resp) > 0) {
                push parts resp
            }
            def e@(optional):SpEvent (space.event(o.eventId))
            if (!null? e) {
                ; a web address is shown as a link below the card, and a word
                ; too long to wrap is cut short
                def kept:[string]
                def words:[string] (strsplit (trim e.notes) " ")
                def k:int 0
                while (k < (array_length words)) {
                    def wd:string (itemAt words k)
                    if ((SpRemote.starts(wd "https://")) || (SpRemote.starts(wd "http://"))) {
                        push urls wd
                    } {
                        if ((strlen wd) > 36) {
                            wd = ((substring wd 0 34) + "…")
                        }
                        if ((strlen wd) > 0) {
                            push kept wd
                        }
                    }
                    k = (k + 1)
                }
                if ((array_length kept) > 0) {
                    push parts (join kept " ")
                }
            }
            col.addChild((SpacesApp.tx("sp-tdetail" (join parts " · "))))
        }
        UiTree.inline(col "width" (SpacesApp.px((w - 110.0))))
        row.addChild(col)
        if ((array_length urls) == 0) {
            return row
        }
        def box:EVGElement (SpacesApp.box("sp-tbox"))
        box.addChild(row)
        def links:EVGElement (SpacesApp.box("sp-tlinks"))
        def j:int 0
        while (j < (array_length urls)) {
            def u:string (itemAt urls j)
            def li:int (array_length linkUrls)
            push linkUrls u
            def host:string (SpacesApp.linkHost(u))
            def lb:EVGElement (SpacesApp.btn(("sp-turl-" + (to_string li)) "sp-chip sp-tlink" (host + " ↗")))
            lb.a11yLabel = ((SpWords.pick(lang "Open link: " "Avaa linkki: ")) + host)
            links.addChild(lb)
            j = (j + 1)
        }
        box.addChild(links)
        return box
    }

    ; "https://www.example.fi/a/b" → "example.fi"
    sfn linkHost:string (u:string) {
        def rest:string u
        def at:int (indexOf rest "://")
        if (at >= 0) {
            rest = (substring rest (at + 3) (strlen rest))
        }
        def slash:int (indexOf rest "/")
        if (slash > 0) {
            rest = (substring rest 0 slash)
        }
        if (SpRemote.starts(rest "www.")) {
            rest = (substring rest 4 (strlen rest))
        }
        if ((strlen rest) > 30) {
            rest = ((substring rest 0 28) + "…")
        }
        if ((strlen rest) == 0) {
            return "Linkki"
        }
        return rest
    }

    ; --- this week and what comes after ---

    fn weekCol:EVGElement (w:double) {
        def c:EVGElement (this.section("week" (SpWords.pick(lang "This week" "Tämä viikko"))))
        def mon:int (SpSpace.mondayOf(today))
        def occ:[SpOccur] (space.occurrences(mon (mon + 6)))
        def d:int mon
        while (d <= (mon + 6)) {
            def list:[SpOccur]
            def i:int 0
            while (i < (array_length occ)) {
                def o:SpOccur (itemAt occ i)
                if (o.day == d) {
                    push list o
                }
                i = (i + 1)
            }
            c.addChild((this.weekRow(d list w)))
            d = (d + 1)
        }
        def ahead:EVGElement (this.section("ahead" (SpWords.pick(lang "Coming up" "Tulossa"))))
        UiTree.inline(ahead "margin-top" "18px")
        def up:[SpOccur] (this.comingUp())
        if ((array_length up) == 0) {
            ahead.addChild((SpacesApp.tx("sp-empty" (SpWords.ui(lang "nothing")))))
        }
        def k:int 0
        while (k < (array_length up)) {
            ahead.addChild((this.aheadRow((itemAt up k) w)))
            k = (k + 1)
        }
        c.addChild(ahead)
        return c
    }

    ; One day of this week: its name and its plans as coloured chips, as many
    ; as fit and "+n" for the rest.
    fn weekRow:EVGElement (d:int list:[SpOccur] w:double) {
        def cls:string "sp-wrow"
        if (d == today) {
            cls = "sp-wrow sp-wrow-today"
        }
        if (d < today) {
            cls = "sp-wrow sp-wrow-past"
        }
        def row:EVGElement (UiTree.div("" cls))
        row.role = "listitem"
        def p:[int] (SpSpace.ymdOf(d))
        def dayName:string ((SpWords.wdShort(lang d)) + " " + (to_string (itemAt p 2)))
        row.a11yLabel = (SpWords.dayLabel(lang d))
        def dcls:string "sp-wday"
        if (d == today) {
            dcls = "sp-wday sp-wday-today"
        }
        def db:EVGElement (SpacesApp.btn(("sp-day-" + (to_string d)) dcls dayName))
        db.a11yLabel = ((SpWords.dayLabel(lang d)) + ": " + (SpWords.ui(lang "showCal")))
        row.addChild(db)
        def avail:double (w - 102.0)
        def chipW:double 128.0
        def fit:int (to_int ((avail + 6.0) / (chipW + 6.0)))
        def n:int (array_length list)
        if (n > fit) {
            fit = (to_int (((avail - 34.0) + 6.0) / (chipW + 6.0)))
        }
        if (fit < 1) {
            fit = 1
        }
        if (n <= fit) {
            if (n > 0) {
                chipW = (((avail + 6.0) / (to_double (SpacesApp.maxInt(n 2)))) - 6.0)
                if (chipW > 128.0) {
                    chipW = 128.0
                }
            }
        }
        def i:int 0
        while ((i < n) && (i < fit)) {
            def o:SpOccur (itemAt list i)
            def k:int (this.rowOf(o))
            def chip:EVGElement (SpacesApp.btn(("sp-item-" + (to_string k)) ("sp-evchip sp-c-" + (this.colorOf(o))) o.title))
            chip.a11yLabel = ((SpWords.timeOf(lang o)) + " " + o.title)
            UiTree.inline(chip "width" (SpacesApp.px(chipW)))
            row.addChild(chip)
            i = (i + 1)
        }
        if (n > fit) {
            def more:EVGElement (SpacesApp.tx("sp-more" ("+" + (to_string (n - fit)))))
            row.addChild(more)
        }
        return row
    }

    sfn maxInt:int (a:int b:int) {
        if (a > b) {
            return a
        }
        return b
    }

    ; One-off plans after today, the next five within two months; repeating
    ; ones are the week's routine, and reminders and deadlines are under
    ; Remember.
    fn comingUp:[SpOccur] () {
        def out:[SpOccur]
        def all:[SpOccur] (space.occurrences((today + 1) (today + 60)))
        def i:int 0
        while ((i < (array_length all)) && ((array_length out) < 5)) {
            def o:SpOccur (itemAt all i)
            if (((o.repeats) == false) && (((this.isReminder(o)) == false) && ((this.kindOf(o.typeId)) != "deadline"))) {
                push out o
            }
            i = (i + 1)
        }
        return out
    }

    fn aheadRow:EVGElement (o:SpOccur w:double) {
        def n:int (this.rowOf(o))
        def rcls:string "sp-arow"
        if (o.endDay > o.day) {
            rcls = "sp-arow sp-arow-span"
        }
        def row:EVGElement (UiTree.div(("sp-item-" + (to_string n)) rcls))
        row.role = "button"
        row.a11yFocusable = true
        row.a11yLabel = ((SpWords.dayLabel(lang o.day)) + (this.untilText(o)) + " " + o.title)
        def dcls:string "sp-adot"
        if (o.endDay > o.day) {
            dcls = "sp-adot sp-adot-span"
        }
        def dot:EVGElement (SpacesApp.box((dcls + " sp-c-" + (this.colorOf(o)))))
        dot.a11yHidden = true
        row.addChild(dot)
        def dl:EVGElement (this.dayStack(o "sp-aday" "sp-aend" "sp-adaycol"))
        dl.a11yHidden = true
        row.addChild(dl)
        def tt:EVGElement (SpacesApp.tx("sp-atitle" o.title))
        tt.a11yHidden = true
        UiTree.inline(tt "width" (SpacesApp.px((w - 140.0))))
        row.addChild(tt)
        return row
    }

    ; The first day in bold and, for a plan over several days, its last
    ; day under it: "pe 6.11." / "– 8.11.".
    fn dayStack:EVGElement (o:SpOccur dayCls:string endCls:string colCls:string) {
        def first:EVGElement (SpacesApp.tx(dayCls (SpWords.dayLabel(lang o.day))))
        if (o.endDay <= o.day) {
            return first
        }
        def c:EVGElement (SpacesApp.box(colCls))
        c.addChild(first)
        c.addChild((SpacesApp.tx(endCls ("– " + (SpWords.dateShort(lang o.endDay))))))
        return c
    }

    ; " – 8.11." for a plan over several days, else ""
    fn untilText:string (o:SpOccur) {
        if (o.endDay <= o.day) {
            return ""
        }
        return (" – " + (SpWords.dateShort(lang o.endDay)))
    }

    ; --- to remember ---

    ; An important all-day plan: how a reminder comes from the server.
    fn isReminder:boolean (o:SpOccur) {
        return (o.important && (o.allDay()))
    }

    fn rememberCol:EVGElement (w:double) {
        def c:EVGElement (this.section("late" (SpWords.pick(lang "Remember" "Muista"))))
        def shown:int 0
        ; deadlines not done, late ones first, up to four weeks ahead
        def dl:[SpDeadline]
        def i:int 0
        while (i < (array_length space.deadlines)) {
            def d:SpDeadline (itemAt space.deadlines i)
            if ((d.done == false) && (d.day <= (today + 28))) {
                push dl d
                def k:int ((array_length dl) - 1)
                while (k > 0) {
                    def prev:SpDeadline (itemAt dl (k - 1))
                    if (d.day < prev.day) {
                        set dl k prev
                        set dl (k - 1) d
                        k = (k - 1)
                    } {
                        k = 0
                    }
                }
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length dl)) {
            def d2:SpDeadline (itemAt dl j)
            c.addChild((this.remindRow(("sp-done-" + d2.id) true d2.title d2.day (space.resourceName(d2.resource)))))
            shown = (shown + 1)
            j = (j + 1)
        }
        ; deadline entries whose reminder is on, not yet done
        def due:[SpEvent] (space.dueEntries(today))
        def listed:[string]
        def m:int 0
        while (m < (array_length due)) {
            def e:SpEvent (itemAt due m)
            if ((SpacesApp.closed(e)) == false) {
                c.addChild((this.remindRow(("sp-tick-" + e.id) true e.title e.day (space.resourceName(e.resource)))))
                push listed e.id
                shown = (shown + 1)
            }
            m = (m + 1)
        }
        ; important all-day plans in the next four weeks: one-off ones are
        ; ticked off, a repeating one opens in the form
        def occ:[SpOccur] (space.occurrences(today (today + 28)))
        def q:int 0
        while (q < (array_length occ)) {
            def o:SpOccur (itemAt occ q)
            def oe@(optional):SpEvent (space.event(o.eventId))
            def open:boolean true
            if (!null? oe) {
                open = ((SpacesApp.closed((unwrap oe))) == false)
            }
            ; a deadline entry already listed above is not listed twice
            def li:int 0
            while (li < (array_length listed)) {
                if ((itemAt listed li) == o.eventId) {
                    open = false
                }
                li = (li + 1)
            }
            if ((this.isReminder(o)) && open) {
                if o.repeats {
                    def n:int (this.rowOf(o))
                    c.addChild((this.remindRow(("sp-item-" + (to_string n)) false o.title o.day (space.resourceName(o.resource)))))
                } {
                    c.addChild((this.remindRow(("sp-tick-" + o.eventId) true o.title o.day (space.resourceName(o.resource)))))
                }
                shown = (shown + 1)
            }
            q = (q + 1)
        }
        if (shown == 0) {
            c.addChild((SpacesApp.tx("sp-empty" (SpWords.pick(lang "Nothing to remember" "Ei muistettavaa")))))
        }
        def add:EVGElement (SpacesApp.btn("sp-add" "sp-addbig" ((SpWords.pick(lang "+ Add " "+ Lisää ")) + (to_lowercase (SpWords.noun(lang pack "event"))))))
        add.a11yExpanded = (SpacesApp.tri(addOpen))
        c.addChild(add)
        c.addChild((this.legend()))
        return c
    }

    ; An entry marked done, cancelled or archived (the common `status`).
    sfn closed:boolean (e:SpEvent) {
        def st:string (e.fieldText("status"))
        return (((st == "done") || (st == "cancelled")) || (st == "archived"))
    }

    ; A reminder: a box to tick (a deadline, or an entry whose status then
    ; becomes done) or a flag (a repeating plan, opened in the form), its
    ; title and when.
    ; Beside it a chip copies the title and when to the clipboard.
    fn remindRow:EVGElement (id:string tick:boolean title:string day:int ward:string) {
        def box:EVGElement (SpacesApp.box("sp-rbox"))
        def row:EVGElement (UiTree.div(id "sp-rcard"))
        row.role = "button"
        row.a11yFocusable = true
        def when:string (this.whenText(day))
        if ((strlen ward) > 0) {
            when = (when + " · " + ward)
        }
        if tick {
            row.a11yLabel = ((SpWords.pick(lang "Mark done: " "Merkitse tehdyksi: ")) + title + ", " + when)
            def box:EVGElement (SpacesApp.box("sp-check"))
            box.a11yHidden = true
            row.addChild(box)
        } {
            row.a11yLabel = (title + ", " + when)
            def fl:EVGElement (SpacesApp.tx("sp-rflag" "⚑"))
            fl.a11yHidden = true
            row.addChild(fl)
        }
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        col.a11yHidden = true
        col.addChild((SpacesApp.tx("sp-rtitle" title)))
        def wcls:string "sp-rwhen"
        if (day < today) {
            wcls = "sp-rwhen sp-rwhen-late"
        }
        col.addChild((SpacesApp.tx(wcls when)))
        row.addChild(col)
        box.addChild(row)
        def n:int (array_length remindTexts)
        push remindTexts (title + ", " + when)
        def cp:EVGElement (SpacesApp.btn(("sp-copy-r-" + (to_string n)) "sp-chip sp-rcopy" (SpWords.pick(lang "Copy" "Kopioi"))))
        cp.a11yLabel = ((SpWords.pick(lang "Copy: " "Kopioi: ")) + title)
        box.addChild(cp)
        return box
    }

    ; Omat asetukset: whether the space's summary comes by email every
    ; morning or on Monday mornings, and what that email would say from the
    ; space as it is now. Nothing is sent yet.
    ; The info screen: the assistant makes a short presentation of the
    ; space's day and the days ahead for a screen on the wall, by the button
    ; or every morning (wardeninfo.go); the top bar's button opens the latest.
    fn infoCard:EVGElement () {
        def c:EVGElement (this.card("info" (SpWords.pick(lang "Info screen" "Info-näyttö"))))
        c.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "The assistant makes a short presentation of today's plans, what to remember and the week, for a screen on the wall." "Avustaja tekee tämän päivän menoista, muistettavista ja viikosta lyhyen esityksen seinänäytölle.")))))
        if ((strlen space.infoUrl) > 0) {
            def when:string space.infoMade
            if ((strlen when) >= 16) {
                def d:int (SpText.dayOf((substring when 0 10) (itemAt (SpSpace.ymdOf(today)) 0)))
                when = ((SpWords.dayLabel(lang d)) + (SpWords.pick(lang " at " " klo ")) + (substring when 11 16))
            }
            if ((strlen space.infoBy) > 0) {
                when = (when + " · " + space.infoBy)
            }
            c.addChild((SpacesApp.tx("sp-meta" ((SpWords.pick(lang "Latest: " "Viimeisin: ")) + when))))
        } {
            c.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "None made yet." "Ei vielä tehty.")))))
        }
        def row:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
        if ((strlen space.infoUrl) > 0) {
            row.addChild((SpacesApp.btn("sp-info-open" "sp-action" (SpWords.pick(lang "Open the presentation" "Avaa esitys")))))
        }
        def mk:string (SpWords.pick(lang "Make it now" "Tee nyt"))
        if infoBusy {
            mk = (SpWords.pick(lang "Making…" "Tehdään…"))
        }
        def mb:EVGElement (SpacesApp.btn("sp-info-make" "sp-action sp-action-primary" mk))
        row.addChild(mb)
        row.addChild((this.showSwitch("sp-info-morning" (SpWords.pick(lang "Make it every morning" "Tee joka aamu")) space.infoMorning)))
        c.addChild(row)
        c.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "Anyone with the presentation's link can see it." "Esityksen näkee kuka tahansa, jolla on sen linkki.")))))
        return c
    }

    ; The info screen's buttons.
    fn pressInfo:boolean (target:string) {
        if (target == "sp-info") {
            infoOpen = (infoOpen == false)
            if (infoOpen && ((strlen space.infoUrl) > 0)) {
                action = ("open:" + space.infoUrl)
            }
            return true
        }
        if (target == "sp-info-open") {
            if ((strlen space.infoUrl) > 0) {
                action = ("open:" + space.infoUrl)
            }
            return true
        }
        if (target == "sp-info-make") {
            if (infoBusy || assistBusy) {
                return true
            }
            def o:VlJson (VlJson.objectValue())
            o.setMember("space_id" (SpRemote.str(spaceId)))
            o.setMember("purpose" (SpRemote.str("info_screen")))
            o.setMember("today" (SpRemote.str((SpSpace.dateText(today)))))
            this.queue("assist" (SpRemote.write(o)) "info")
            infoBusy = true
            status = (SpWords.pick(lang "The assistant is making the info screen…" "Avustaja tekee info-näyttöä…"))
            return true
        }
        if (target == "sp-info-morning") {
            space.infoMorning = (space.infoMorning == false)
            def o2:VlJson (VlJson.objectValue())
            o2.setMember("space_id" (SpRemote.str(spaceId)))
            o2.setMember("morning" (VlJson.boolValue(space.infoMorning)))
            this.queue("info_screen" (SpRemote.write(o2)) spaceId)
            return true
        }
        return false
    }

    fn summaryCard:EVGElement () {
        def c:EVGElement (this.card("summary" (SpWords.pick(lang "My settings: email summary" "Omat asetukset: sähköpostikooste"))))
        c.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "A summary of the space's plans and reminders by email, every morning or on Monday mornings. Only you get it; each member picks their own." "Tilan menot ja muistutukset koosteena sähköpostiin joka aamu tai maanantaiaamuisin. Kooste tulee vain sinulle; jokainen jäsen valitsee omansa.")))))
        def sw:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
        sw.addChild((this.showSwitch("sp-sum-off" (SpWords.pick(lang "No summary" "Ei koostetta")) (space.emailSummary == "off"))))
        sw.addChild((this.showSwitch("sp-sum-day" (SpWords.pick(lang "Every morning" "Joka aamu")) (space.emailSummary == "day"))))
        sw.addChild((this.showSwitch("sp-sum-week" (SpWords.pick(lang "Monday mornings" "Maanantaiaamuisin")) (space.emailSummary == "week"))))
        c.addChild(sw)
        def to:string account.email
        if ((strlen to) == 0) {
            to = (SpWords.pick(lang "your account's address" "tilisi osoitteeseen"))
        }
        c.addChild((SpacesApp.tx("sp-meta" ((SpWords.pick(lang "It would go to " "Kooste lähtisi osoitteeseen ")) + to + (SpWords.pick(lang ". Sending is not on yet: below is what the email would say now." ". Lähetys ei ole vielä käytössä: alla näet, mitä viesti nyt sanoisi."))))))
        def pv:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
        pv.addChild((this.showSwitch("sp-sumprev-day" (SpWords.pick(lang "Preview: a day" "Esikatselu: päivä")) (summaryShow == "day"))))
        pv.addChild((this.showSwitch("sp-sumprev-week" (SpWords.pick(lang "Preview: a week" "Esikatselu: viikko")) (summaryShow == "week"))))
        c.addChild(pv)
        c.addChild((this.summaryMail(summaryShow)))
        return c
    }

    ; The email: its subject, each day's plans with their times and wards,
    ; and the reminders that are due (late ones too).
    fn summaryMail:EVGElement (kind:string) {
        def m:EVGElement (UiTree.div("sp-card-mail" "sp-mail"))
        m.role = "region"
        def last:int today
        def subj:string ((SpWords.pick(lang "Today " "Tänään ")) + (SpWords.dayLabel(lang today)))
        if (kind == "week") {
            last = (today + 6)
            subj = ((SpWords.pick(lang "Your week " "Viikkosi ")) + (SpWords.dayLabel(lang today)) + "–" + (SpWords.dayLabel(lang last)))
        }
        m.a11yLabel = (SpWords.pick(lang "Email preview" "Sähköpostin esikatselu"))
        m.addChild((SpacesApp.tx("sp-mailhead" ((SpWords.pick(lang "From: Warden · To: " "Lähettäjä: Warden · Vastaanottaja: ")) + account.email))))
        m.addChild((SpacesApp.tx("sp-mailsubj" (space.name + ": " + subj))))
        def hello:string (SpWords.pick(lang "Hi" "Hei"))
        if ((strlen account.name) > 0) {
            hello = (hello + " " + account.name)
        }
        m.addChild((SpacesApp.tx("sp-mailline" (hello + ","))))
        m.addChild((SpacesApp.tx("sp-mailsect" (SpWords.pick(lang "Plans" "Menot")))))
        def occ:[SpOccur] (space.occurrences(today last))
        def n:int 0
        def d:int today
        while (d <= last) {
            def first:boolean true
            def i:int 0
            while (i < (array_length occ)) {
                def o:SpOccur (itemAt occ i)
                if (o.day == d) {
                    if (first && (kind == "week")) {
                        m.addChild((SpacesApp.tx("sp-mailday" (SpWords.dayLabel(lang d)))))
                    }
                    first = false
                    def line:string ((SpWords.timeOf(lang o)) + "  " + o.title)
                    def ward:string (space.resourceName(o.resource))
                    if ((strlen ward) > 0) {
                        line = (line + " · " + ward)
                    }
                    m.addChild((SpacesApp.tx("sp-mailline" line)))
                    n = (n + 1)
                }
                i = (i + 1)
            }
            d = (d + 1)
        }
        if (n == 0) {
            m.addChild((SpacesApp.tx("sp-mailline" (SpWords.pick(lang "No plans." "Ei menoja.")))))
        }
        m.addChild((SpacesApp.tx("sp-mailsect" (SpWords.pick(lang "Remember" "Muista")))))
        def r:int 0
        def j:int 0
        while (j < (array_length space.deadlines)) {
            def dl:SpDeadline (itemAt space.deadlines j)
            if ((dl.done == false) && (dl.day <= last)) {
                m.addChild((SpacesApp.tx("sp-mailline" (this.summaryRemind(dl.title dl.day dl.resource)))))
                r = (r + 1)
            }
            j = (j + 1)
        }
        def due:[SpEvent] (space.dueEntries(last))
        def k:int 0
        while (k < (array_length due)) {
            def e:SpEvent (itemAt due k)
            if ((SpacesApp.closed(e)) == false) {
                m.addChild((SpacesApp.tx("sp-mailline" (this.summaryRemind(e.title e.day e.resource)))))
                r = (r + 1)
            }
            k = (k + 1)
        }
        if (r == 0) {
            m.addChild((SpacesApp.tx("sp-mailline" (SpWords.pick(lang "Nothing due." "Ei erääntyviä.")))))
        }
        m.addChild((SpacesApp.tx("sp-mailfoot" (SpWords.pick(lang "Open Warden: sliqtly.com/apps/warden · Change or stop the summary on the Members page." "Avaa Warden: sliqtly.com/apps/warden · Muuta tai lopeta kooste Jäsenet-sivulla.")))))
        return m
    }

    ; "Laskun eräpäivä, ti 20.10. · Leevi"
    fn summaryRemind:string (title:string day:int ward:string) {
        def line:string (title + ", " + (this.whenText(day)))
        def wn:string (space.resourceName(ward))
        if ((strlen wn) > 0) {
            line = (line + " · " + wn)
        }
        return line
    }

    ; "tänään", "huomenna", "myöhässä · ma 12.10.", "ti 20.10."
    fn whenText:string (day:int) {
        if (day < today) {
            return ((to_lowercase (SpWords.ui(lang "late"))) + " · " + (SpWords.dayLabel(lang day)))
        }
        if (day == today) {
            return (SpWords.pick(lang "today" "tänään"))
        }
        if (day == (today + 1)) {
            return (SpWords.pick(lang "tomorrow" "huomenna"))
        }
        return (SpWords.dayLabel(lang day))
    }

    ; The wards' colours, and the whole group's.
    fn legend:EVGElement () {
        def c:EVGElement (SpacesApp.box("sp-legend"))
        c.role = "list"
        c.a11yLabel = (SpWords.noun(lang pack "resources"))
        def i:int 0
        while (i < (array_length space.resources)) {
            def r:SpResource (itemAt space.resources i)
            c.addChild((this.legendRow(r.color r.name)))
            i = (i + 1)
        }
        ; the groups of the plans for no one in particular in the next weeks
        def seen:[string]
        def occ:[SpOccur] (space.occurrences(today (today + 90)))
        def k:int 0
        while (k < (array_length occ)) {
            def o:SpOccur (itemAt occ k)
            if ((strlen o.resource) == 0) {
                def g:string (this.groupOfOcc(o))
                if ((g != "event") && ((this.hasStr(seen g)) == false)) {
                    push seen g
                }
            }
            k = (k + 1)
        }
        c.addChild((this.legendRow("all" (SpWords.noun(lang pack "together")))))
        def j:int 0
        while (j < (array_length seen)) {
            def g2:string (itemAt seen j)
            c.addChild((this.legendRow((SpacesApp.groupColor(g2)) (SpWords.groupName(lang g2)))))
            j = (j + 1)
        }
        return c
    }

    fn hasStr:boolean (list:[string] s:string) {
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == s) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn legendRow:EVGElement (color:string name:string) {
        def row:EVGElement (SpacesApp.box("sp-legrow"))
        row.role = "listitem"
        row.a11yLabel = name
        def d:EVGElement (SpacesApp.box(("sp-legdot sp-c-" + color)))
        d.a11yHidden = true
        row.addChild(d)
        def t:EVGElement (SpacesApp.tx("sp-legname" name))
        t.a11yHidden = true
        row.addChild(t)
        return row
    }

    fn sheetName:string (id:string) {
        def i:int 0
        while (i < (array_length space.sheets)) {
            def sh:SpSheet (itemAt space.sheets i)
            if (sh.id == id) {
                return sh.name
            }
            i = (i + 1)
        }
        return ""
    }

    ; An empty space on a server: where to start.
    fn emptyCard:EVGElement () {
        def c:EVGElement (UiTree.div("sp-card-empty" "sp-writecard"))
        if (this.narrow()) {
            c = (UiTree.div("sp-card-empty" "sp-writecard sp-writecard-narrow"))
        }
        c.role = "region"
        c.a11yLabel = (SpWords.ui(lang "seed"))
        c.addChild((SpacesApp.tx("sp-spark" "✦")))
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        col.addChild((SpacesApp.tx("sp-meta" (SpWords.ui(lang "empty")))))
        if (this.narrow()) {
            UiTree.inline(col "width" (SpacesApp.px(((this.mainW()) - 40.0))))
        }
        c.addChild(col)
        c.addChild((SpacesApp.box("sp-grow")))
        if (null? seed) {
            c.addChild((SpacesApp.btn("sp-seed" "sp-action sp-action-primary" (SpWords.ui(lang "seed")))))
        } {
            c.addChild((SpacesApp.tx("sp-meta" (SpWords.ui(lang "saving")))))
        }
        return c
    }

    ; --- members ----------------------------------------------------------------------

    fn initials:string (name:string) {
        def t:string (trim name)
        if ((strlen t) == 0) {
            return "?"
        }
        return (to_uppercase (substring t 0 1))
    }

    fn personRow:EVGElement (id:string name:string detail:string role:string removeId:string) {
        def row:EVGElement (UiTree.div(id "sp-person"))
        row.role = "listitem"
        row.a11yLabel = (name + ", " + detail)
        def av:EVGElement (SpacesApp.box("sp-avatar"))
        av.a11yHidden = true
        av.addChild((SpacesApp.tx("sp-avatar-tx" (this.initials(name)))))
        row.addChild(av)
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        def nm:EVGElement (SpacesApp.tx("sp-title" name))
        nm.a11yHidden = true
        col.addChild(nm)
        if ((strlen detail) > 0) {
            def dt:EVGElement (SpacesApp.tx("sp-meta" detail))
            dt.a11yHidden = true
            col.addChild(dt)
        }
        row.addChild(col)
        if ((strlen role) > 0) {
            def rl:EVGElement (SpacesApp.tx("sp-role" role))
            rl.a11yHidden = true
            row.addChild(rl)
        }
        if ((strlen removeId) > 0) {
            row.addChild((SpacesApp.btn(removeId "sp-action" (SpWords.ui(lang "remove")))))
        }
        return row
    }

    ; Who is in the space and who is invited; the owner invites and removes.
    fn membersView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        v.addChild((this.heading((SpWords.ui(lang "members")) space.name)))
        v.addChild((this.addBar()))
        def owner:boolean (space.myRole == "owner")
        def c:EVGElement (this.card("members" (SpWords.ui(lang "members"))))
        def i:int 0
        while (i < (array_length space.members)) {
            def m:SpMember (itemAt space.members i)
            def rm:string ""
            if (owner && ((m.uid != account.uid) && (m.role != "owner"))) {
                rm = ("sp-remove-" + (to_string i))
            }
            def nm:string m.name
            if ((strlen nm) == 0) {
                nm = m.email
            }
            c.addChild((this.personRow(("sp-member-" + (to_string i)) nm m.email (SpWords.ui(lang m.role)) rm)))
            i = (i + 1)
        }
        v.addChild(c)
        v.addChild((this.wardsCard(owner)))
        v.addChild((this.placesCard()))
        if (((array_length space.invites) > 0) || owner) {
            def iv:EVGElement (this.card("invites" (SpWords.ui(lang "invited"))))
            def k:int 0
            while (k < (array_length space.invites)) {
                def email:string (itemAt space.invites k)
                def rm2:string ""
                if owner {
                    rm2 = ("sp-uninvite-" + (to_string k))
                }
                iv.addChild((this.personRow(("sp-invitee-" + (to_string k)) email "" "" rm2)))
                k = (k + 1)
            }
            if owner {
                def form:EVGElement (SpacesApp.box("sp-formrow"))
                form.addChild((this.field(inviteField "sp-invite-email" (SpWords.ui(lang "email")) "name@example.com" "email")))
                form.addChild((SpacesApp.btn("sp-invite" "sp-action sp-action-primary" (SpWords.ui(lang "invite")))))
                iv.addChild(form)
            }
            v.addChild(iv)
        }
        if (((strlen space.feed) > 0) && (phoneOpen == false)) {
            v.addChild((this.feedCard()))
        }
        if server {
            v.addChild((this.summaryCard()))
        }
        if (owner && server) {
            v.addChild((this.backupsCard()))
        }
        return v
    }

    ; Subscribing to the space's calendar feed: on the members page and in
    ; the panel the top bar's phone button opens.
    fn feedCard:EVGElement () {
        def fc:EVGElement (this.card("feed" (SpWords.pick(lang "Calendar on your phone" "Kalenteri puhelimeen"))))
        fc.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "Subscribe and the space's events show in Apple's, Google's or Outlook's calendar, and change there when they change here. Apple's calendar also alerts of the reminders; Google's leaves the alerts out. Anyone with the address sees the events." "Tilaa, niin tilan menot näkyvät Applen, Googlen tai Outlookin kalenterissa ja muuttuvat siellä, kun ne muuttuvat täällä. Applen kalenteri myös hälyttää muistutuksista; Googlen kalenteri jättää hälytykset pois. Jokainen, jolla on osoite, näkee menot.")))))
        def sw:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
        sw.addChild((this.showSwitch("sp-feed-gets" (SpWords.ui(lang "showGets")) feedGets)))
        sw.addChild((this.showSwitch("sp-feed-pays" (SpWords.ui(lang "showPays")) feedPays)))
        sw.addChild((this.showSwitch("sp-feed-alarms" (SpWords.pick(lang "Alerts" "Hälytykset")) feedAlarms)))
        fc.addChild(sw)
        def fr:EVGElement (SpacesApp.box("sp-formrow"))
        fr.addChild((SpacesApp.btn("sp-feed-open" "sp-action sp-action-primary" (SpWords.pick(lang "Subscribe" "Tilaa kalenteriin")))))
        def sh:EVGElement (SpacesApp.btn("sp-feed-share" "sp-action" (SpWords.pick(lang "Share" "Jaa"))))
        sh.a11yExpanded = (SpacesApp.tri(feedShare))
        fr.addChild(sh)
        fc.addChild(fr)
        ; sharing copies the address in the form the receiver's calendar takes
        if feedShare {
            def so:EVGElement (SpacesApp.box("sp-formrow"))
            so.role = "group"
            so.a11yLabel = (SpWords.pick(lang "Share" "Jaa"))
            so.addChild((SpacesApp.btn("sp-feed-copy" "sp-opt" (SpWords.pick(lang "Copy iCal address" "Kopioi iCal-osoite")))))
            so.addChild((SpacesApp.btn("sp-feed-copyapple" "sp-opt" (SpWords.pick(lang "Copy Apple subscription link" "Kopioi Apple-tilauslinkki")))))
            fc.addChild(so)
            fc.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "iCal works in Google and Outlook; the Apple link opens the subscription straight in an iPhone's or Mac's calendar." "iCal-osoite käy Googleen ja Outlookiin; Apple-linkki avaa tilauksen suoraan iPhonen tai Macin kalenterissa.")))))
        }
        return fc
    }

    ; The wards; the owner removes one with a second press that says what
    ; happens to its events.
    fn wardsCard:EVGElement (owner:boolean) {
        def c:EVGElement (this.card("wards" (SpWords.noun(lang pack "resources"))))
        def i:int 0
        while (i < (array_length space.resources)) {
            def r:SpResource (itemAt space.resources i)
            def rm:string ""
            if (owner && (r.id != wardAsk)) {
                rm = ("sp-unward-" + (to_string i))
            }
            def n:int (space.wardUses(r.id))
            def detail:string ((to_string n) + (SpWords.pick(lang " entries" " merkintää")))
            def row:EVGElement (this.personRow(("sp-ward-" + (to_string i)) r.name detail "" rm))
            def dot:EVGElement (SpacesApp.box(("sp-legdot sp-c-" + r.color)))
            dot.a11yHidden = true
            row.addChild(dot)
            row.addChild((SpacesApp.btn(("sp-wardcolor-" + (to_string i)) "sp-action" (SpWords.pick(lang "Colour" "Väri")))))
            def ccls:string "sp-action"
            if (r.id == clothesOpen) {
                ccls = "sp-action sp-action-primary"
            }
            row.addChild((SpacesApp.btn(("sp-wardclothes-" + (to_string i)) ccls (SpWords.pick(lang "Clothes" "Vaatteet")))))
            c.addChild(row)
            if (r.id == clothesOpen) {
                c.addChild((this.clothesBox(r)))
            } {
                this.clothesSummary(c r)
            }
            if (r.id == wardAsk) {
                def ask:EVGElement (SpacesApp.box("sp-formrow"))
                ask.addChild((SpacesApp.tx("sp-meta" ((SpWords.pick(lang "Remove " "Poistetaanko ")) + r.name + (SpWords.pick(lang "? Its entries stay, without it." "? Merkinnät säilyvät ilman häntä.")))))))
                ask.addChild((SpacesApp.btn("sp-unward-yes" "sp-action sp-action-primary" (SpWords.ui(lang "remove")))))
                ask.addChild((SpacesApp.btn("sp-unward-no" "sp-action" (SpWords.ui(lang "cancel")))))
                c.addChild(ask)
            }
            i = (i + 1)
        }
        def form:EVGElement (SpacesApp.box("sp-formrow"))
        form.addChild((this.field(wardField "sp-ward-name" (SpWords.pick(lang "Name" "Nimi")) (SpWords.noun(lang pack "resource")) "text")))
        form.addChild((SpacesApp.btn("sp-addward" "sp-action sp-action-primary" (SpWords.ui(lang "addOne")))))
        c.addChild(form)
        return c
    }

    ; The towns the space and its wards usually are in, whose weather the
    ; summary shows: any member adds one (a town in Finland, looked up by
    ; the host) or removes one.
    fn placesCard:EVGElement () {
        def c:EVGElement (this.card("places" (SpWords.pick(lang "Places" "Paikkakunnat"))))
        if ((array_length space.places) == 0) {
            c.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "None yet: the summary shows the weather in Tampere." "Ei vielä yhtään: koonti näyttää Tampereen sään.")))))
        }
        def i:int 0
        while (i < (array_length space.places)) {
            def p:SpPlace (itemAt space.places i)
            def whose:string (space.resourceName(p.ward))
            if ((strlen p.ward) == 0) {
                whose = (SpWords.noun(lang pack "together"))
            }
            c.addChild((this.personRow(("sp-place-" + (to_string i)) p.name whose "" ("sp-unplace-" + (to_string i)))))
            i = (i + 1)
        }
        def form:EVGElement (SpacesApp.box("sp-formrow"))
        form.addChild((this.field(placeField "sp-place-name" (SpWords.pick(lang "Town" "Paikkakunta")) (SpWords.pick(lang "e.g. Kuopio" "esim. Kuopio")) "text")))
        def pills:EVGElement (SpacesApp.box("sp-pills"))
        pills.role = "group"
        pills.a11yLabel = (SpWords.pick(lang "Whose" "Kenen"))
        pills.addChild((this.placeForPill("sp-placefor-all" "" (SpWords.noun(lang pack "together")))))
        def k:int 0
        while (k < (array_length space.resources)) {
            def r:SpResource (itemAt space.resources k)
            pills.addChild((this.placeForPill(("sp-placefor-" + (to_string k)) r.id r.name)))
            k = (k + 1)
        }
        form.addChild(pills)
        def look:string (SpWords.pick(lang "Find" "Hae"))
        if placeLooking {
            look = (SpWords.pick(lang "Finding…" "Haetaan…"))
        }
        form.addChild((SpacesApp.btn("sp-place-find" "sp-action sp-action-primary" look)))
        c.addChild(form)
        if ((array_length found) > 0) {
            def res:EVGElement (SpacesApp.box("sp-placefound"))
            res.role = "group"
            res.a11yLabel = (SpWords.pick(lang "Pick the town" "Valitse paikkakunta"))
            def j:int 0
            while (j < (array_length found)) {
                def f:SpPlace (itemAt found j)
                def label:string f.name
                if ((strlen f.detail) > 0) {
                    label = (f.name + " · " + f.detail)
                }
                res.addChild((SpacesApp.btn(("sp-placepick-" + (to_string j)) "sp-action" label)))
                j = (j + 1)
            }
            c.addChild(res)
        }
        return c
    }

    ; The space's copies, for its owner: taken before a change, at most every
    ; two hours, and before the space is deleted. Neither an assistant nor
    ; the MCP server can remove or restore one: only this card restores.
    fn backupsCard:EVGElement () {
        def c:EVGElement (this.card("backups" (SpWords.pick(lang "Backups" "Varmuuskopiot"))))
        c.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "Warden copies the space and its entries before they change, at most every two hours. An assistant cannot remove or restore a copy; the owner restores one here, and what there is now is copied first." "Warden kopioi tilan merkintöineen ennen muutoksia, enintään kahden tunnin välein. Avustaja ei voi poistaa eikä palauttaa kopiota; omistaja palauttaa sen täältä, ja nykyinen tila kopioidaan ensin.")))))
        if (backupsShown == false) {
            c.addChild((SpacesApp.btn("sp-backups-show" "sp-action" (SpWords.pick(lang "Show backups" "Näytä varmuuskopiot")))))
            return c
        }
        if ((array_length backups) == 0) {
            c.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "No copies yet." "Ei vielä kopioita.")))))
        }
        def i:int 0
        while (i < (array_length backups)) {
            def b:SpBackup (itemAt backups i)
            this.backupRow(c b ("sp-backup-" + (to_string i)) ("sp-backuprestore-" + (to_string i)) (this.backupWhen(b.when)) (this.backupDetail(b)))
            i = (i + 1)
        }
        return c
    }

    ; The deleted spaces the caller owned, each with its newest copy.
    fn lostCard:EVGElement () {
        def c:EVGElement (this.card("lost" (SpWords.pick(lang "Deleted spaces" "Poistetut tilat"))))
        if (lostShown == false) {
            c.addChild((SpacesApp.btn("sp-lost-show" "sp-action" (SpWords.pick(lang "Show deleted spaces" "Näytä poistetut tilat")))))
            return c
        }
        if ((array_length lostSpaces) == 0) {
            c.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "No deleted spaces with a backup." "Ei poistettuja tiloja, joista olisi kopio.")))))
        }
        def i:int 0
        while (i < (array_length lostSpaces)) {
            def b:SpBackup (itemAt lostSpaces i)
            this.backupRow(c b ("sp-lost-" + (to_string i)) ("sp-lostrestore-" + (to_string i)) b.name ((this.backupWhen(b.when)) + " · " + (this.backupDetail(b))))
            i = (i + 1)
        }
        return c
    }

    fn backupRow:void (c:EVGElement b:SpBackup id:string restoreId:string title:string detail:string) {
        def row:EVGElement (this.personRow(id title detail "" ""))
        row.addChild((SpacesApp.btn(restoreId "sp-action" (SpWords.pick(lang "Restore" "Palauta")))))
        c.addChild(row)
        if (backupAsk == b.id) {
            def ask:EVGElement (SpacesApp.box("sp-formrow"))
            ask.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "Put the space back as it was then? Entries made since go away; what there is now is copied first." "Palautetaanko tila sellaiseksi kuin se silloin oli? Sen jälkeen tehdyt merkinnät poistuvat; nykyinen tila kopioidaan ensin.")))))
            ask.addChild((SpacesApp.btn("sp-backup-yes" "sp-action sp-action-primary" (SpWords.pick(lang "Restore" "Palauta")))))
            ask.addChild((SpacesApp.btn("sp-backup-no" "sp-action" (SpWords.ui(lang "cancel")))))
            c.addChild(ask)
        }
    }

    ; "2026-10-17 14:05" as the page's language writes it
    fn backupWhen:string (when:string) {
        if ((lang != "fi") || ((strlen when) < 16)) {
            return when
        }
        def y:string (substring when 0 4)
        def m@(optional):int (to_int (substring when 5 7))
        def d@(optional):int (to_int (substring when 8 10))
        if ((null? m) || (null? d)) {
            return when
        }
        return ((to_string (unwrap d)) + "." + (to_string (unwrap m)) + "." + y + " klo " + (substring when 11 13) + "." + (substring when 14 16))
    }

    fn backupDetail:string (b:SpBackup) {
        def why:string (SpWords.pick(lang "before a change" "ennen muutosta"))
        if (b.reason == "delete_event") {
            why = (SpWords.pick(lang "before a removal" "ennen poistoa"))
        }
        if (b.reason == "delete_space") {
            why = (SpWords.pick(lang "before the space was deleted" "ennen tilan poistoa"))
        }
        if (b.reason == "before_restore") {
            why = (SpWords.pick(lang "before a restore" "ennen palautusta"))
        }
        return ((to_string b.events) + (SpWords.pick(lang " entries · " " merkintää · ")) + why)
    }

    sfn readBackup:SpBackup (o:VlJson) {
        def b (new SpBackup())
        b.id = (o.stringOr("backup_id" ""))
        b.when = (o.stringOr("when" ""))
        b.reason = (o.stringOr("reason" ""))
        b.events = (o.intOr("events" 0))
        return b
    }

    ; A press about the backups: true when it was one.
    fn pressBackups:boolean (target:string) {
        if (target == "sp-backups-show") {
            backupsShown = true
            def none:[SpBackup]
            backups = none
            this.queue("list_backups" (SpRemote.body(([] _:string ( "space_id" spaceId )))) "space")
            return true
        }
        if (target == "sp-lost-show") {
            lostShown = true
            def none2:[SpBackup]
            lostSpaces = none2
            this.queue("list_backups" "{}" "lost")
            return true
        }
        if (target == "sp-backup-no") {
            backupAsk = ""
            return true
        }
        if (target == "sp-backup-yes") {
            if ((strlen backupAsk) > 0) {
                def where:string "space"
                def k:int 0
                while (k < (array_length lostSpaces)) {
                    def l:SpBackup (itemAt lostSpaces k)
                    if (l.id == backupAsk) {
                        where = "lost"
                    }
                    k = (k + 1)
                }
                this.queue("restore_backup" (SpRemote.body(([] _:string ( "backup_id" backupAsk )))) where)
                backupAsk = ""
                status = (SpWords.pick(lang "Restoring…" "Palautetaan…"))
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-backuprestore-")) {
            def n@(optional):int (to_int (substring target 17 (strlen target)))
            if (!null? n) {
                def i:int (unwrap n)
                if ((i >= 0) && (i < (array_length backups))) {
                    def b:SpBackup (itemAt backups i)
                    backupAsk = b.id
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-lostrestore-")) {
            def n2@(optional):int (to_int (substring target 15 (strlen target)))
            if (!null? n2) {
                def j:int (unwrap n2)
                if ((j >= 0) && (j < (array_length lostSpaces))) {
                    def b2:SpBackup (itemAt lostSpaces j)
                    backupAsk = b2.id
                }
            }
            return true
        }
        return false
    }

    ; list_backups' and restore_backup's answers
    fn backupsAnswered:void (c:SpCall o:VlJson) {
        if ((c.op == "list_backups") && (c.ref == "space")) {
            def none:[SpBackup]
            backups = none
            def l:VlJson (o.get("backups"))
            def i:int 0
            while (i < (l.count())) {
                push backups (SpacesApp.readBackup((l.at(i))))
                i = (i + 1)
            }
        }
        if ((c.op == "list_backups") && (c.ref == "lost")) {
            def none2:[SpBackup]
            lostSpaces = none2
            def ds:VlJson (o.get("deleted_spaces"))
            def k:int 0
            while (k < (ds.count())) {
                def d:VlJson (ds.at(k))
                def bl:VlJson (d.get("backups"))
                if ((bl.count()) > 0) {
                    def b:SpBackup (SpacesApp.readBackup((bl.at(0))))
                    b.space = (d.stringOr("space_id" ""))
                    b.name = (d.stringOr("name" ""))
                    push lostSpaces b
                }
                k = (k + 1)
            }
        }
        if (c.op == "restore_backup") {
            status = ((SpWords.pick(lang "Restored: " "Palautettu: ")) + (to_string (o.intOr("events" 0))) + (SpWords.pick(lang " entries" " merkintää")))
            backupsShown = false
            lostShown = false
            def rid:string (o.stringOr("space_id" ""))
            if (c.ref == "lost") {
                prefer = rid
                this.queue("list_spaces" "{}" "")
            } {
                this.openSpace(spaceId)
                tab = "members"
            }
        }
    }

    fn placeForPill:EVGElement (id:string ward:string label:string) {
        def on:boolean (ward == placeFor)
        def pc:string "sp-pill"
        if on {
            pc = "sp-pill sp-pill-on"
        }
        def b:EVGElement (SpacesApp.btn(id pc label))
        b.a11yPressed = (SpacesApp.tri(on))
        return b
    }

    ; A press about the places: true when it was one.
    fn pressPlaces:boolean (target:string) {
        if (target == "sp-place-find") {
            def q:string (trim placeField.value)
            if ((strlen q) == 0) {
                status = (SpWords.pick(lang "Write the town's name" "Kirjoita paikkakunnan nimi"))
                focused = "sp-place-name"
                return true
            }
            placeQuery = q
            placeLooking = true
            action = "places"
            return true
        }
        if (target == "sp-placefor-all") {
            placeFor = ""
            return true
        }
        if (UiTree.beginsWith(target "sp-placefor-")) {
            def n@(optional):int (to_int (substring target 12 (strlen target)))
            if (!null? n) {
                def k:int (unwrap n)
                if ((k >= 0) && (k < (array_length space.resources))) {
                    def r:SpResource (itemAt space.resources k)
                    placeFor = r.id
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-placepick-")) {
            def n2@(optional):int (to_int (substring target 13 (strlen target)))
            if (!null? n2) {
                def k2:int (unwrap n2)
                if ((k2 >= 0) && (k2 < (array_length found))) {
                    def f:SpPlace (itemAt found k2)
                    if ((space.placeAt(f.name placeFor)) >= 0) {
                        status = (f.name + (SpWords.pick(lang " is there already" " on jo listalla")))
                        return true
                    }
                    def p:SpPlace (space.addPlace(f.name f.lat f.lon placeFor))
                    if (server && ((strlen spaceId) > 0)) {
                        this.queue("add_place" (SpRemote.placeBody(spaceId p)) p.name)
                    }
                    def none:[SpPlace]
                    found = none
                    placeField.setValue("")
                    status = ((SpWords.pick(lang "Added " "Lisätty ")) + p.name)
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-unplace-")) {
            def n3@(optional):int (to_int (substring target 11 (strlen target)))
            if (!null? n3) {
                def k3:int (unwrap n3)
                if ((k3 >= 0) && (k3 < (array_length space.places))) {
                    def p3:SpPlace (itemAt space.places k3)
                    space.dropPlace(k3)
                    if (server && ((strlen spaceId) > 0)) {
                        def pairs:[string] ([] _:string ( "space_id" spaceId "place" p3.name ))
                        if ((strlen p3.ward) > 0) {
                            push pairs "ward"
                            push pairs p3.ward
                        }
                        this.queue("remove_place" (SpRemote.body(pairs)) p3.name)
                    }
                    status = ((SpWords.pick(lang "Removed " "Poistettu ")) + p3.name)
                }
            }
            return true
        }
        return false
    }

    ; A ward's sizes and what is missing, under its row, when it has any.
    fn clothesSummary:void (c:EVGElement r:SpResource) {
        def parts:[string]
        def i:int 0
        while (i < (array_length r.sizes)) {
            def z:SpSize (itemAt r.sizes i)
            push parts (z.text())
            i = (i + 1)
        }
        if ((array_length parts) > 0) {
            c.addChild((SpacesApp.tx("sp-meta sp-clothes-line" ((SpWords.pick(lang "Sizes: " "Koot: ")) + (join parts " · ")))))
        }
        def miss:string (r.missingText())
        if ((strlen miss) > 0) {
            c.addChild((SpacesApp.tx("sp-meta sp-clothes-line" ((SpWords.pick(lang "Missing: " "Puuttuu: ")) + miss))))
        }
    }

    ; A ward's clothing, open: its sizes now and next, and its clothing list
    ; (what it should have, how many it has), each row changed or removed
    ; here, and a row added at the end of each.
    fn clothesBox:EVGElement (r:SpResource) {
        def b:EVGElement (SpacesApp.box("sp-clothes"))
        b.addChild((SpacesApp.tx("sp-clothes-h" (SpWords.pick(lang "Sizes" "Vaatekoot")))))
        def i:int 0
        while (i < (array_length r.sizes)) {
            def z:SpSize (itemAt r.sizes i)
            def row:EVGElement (SpacesApp.box("sp-formrow sp-clothes-row"))
            row.addChild((SpacesApp.tx("sp-clothes-tx" (z.text()))))
            row.addChild((SpacesApp.btn(("sp-sizedel-" + (to_string i)) "sp-action" (SpWords.ui(lang "remove")))))
            b.addChild(row)
            i = (i + 1)
        }
        def sf:EVGElement (SpacesApp.box("sp-formrow"))
        sf.addChild((this.field(sizeWhat "sp-size-what" (SpWords.pick(lang "Clothing" "Vaate")) (SpWords.pick(lang "shoes" "kengät")) "text")))
        sf.addChild((this.field(sizeNow "sp-size-now" (SpWords.pick(lang "Size now" "Koko nyt")) "30" "text")))
        sf.addChild((this.field(sizeNext "sp-size-next" (SpWords.pick(lang "Next size" "Seuraava koko")) "31" "text")))
        sf.addChild((this.field(sizeBy "sp-size-by" (SpWords.pick(lang "Needed by" "Tarvitaan")) "2027-03" "text")))
        sf.addChild((SpacesApp.btn("sp-sizeadd" "sp-action sp-action-primary" (SpWords.ui(lang "addOne")))))
        b.addChild(sf)
        b.addChild((SpacesApp.tx("sp-clothes-h" (SpWords.pick(lang "Clothes needed" "Vaatetarpeet")))))
        def k:int 0
        while (k < (array_length r.clothes)) {
            def cl:SpCloth (itemAt r.clothes k)
            def t:string cl.item
            if ((strlen cl.size) > 0) {
                t = (t + " (" + cl.size + ")")
            }
            t = (t + "  " + (to_string cl.have) + "/" + (to_string cl.need))
            def n:int (cl.missing())
            def cls:string "sp-clothes-tx"
            if (n > 0) {
                t = (t + (SpWords.pick(lang " · missing " " · puuttuu ")) + (to_string n))
                cls = "sp-clothes-tx sp-clothes-miss"
            }
            def row2:EVGElement (SpacesApp.box("sp-formrow sp-clothes-row"))
            row2.addChild((SpacesApp.tx(cls t)))
            row2.addChild((SpacesApp.btn(("sp-clothless-" + (to_string k)) "sp-action" "−")))
            row2.addChild((SpacesApp.btn(("sp-clothmore-" + (to_string k)) "sp-action" "+")))
            row2.addChild((SpacesApp.btn(("sp-clothdel-" + (to_string k)) "sp-action" (SpWords.ui(lang "remove")))))
            b.addChild(row2)
            k = (k + 1)
        }
        def cf:EVGElement (SpacesApp.box("sp-formrow"))
        cf.addChild((this.field(clothItem "sp-cloth-item" (SpWords.pick(lang "Item" "Vaate")) (SpWords.pick(lang "winter boots" "talvikengät")) "text")))
        cf.addChild((this.field(clothSize "sp-cloth-size" (SpWords.pick(lang "Size" "Koko")) "31" "text")))
        cf.addChild((this.field(clothNeed "sp-cloth-need" (SpWords.pick(lang "How many" "Montako")) "1" "text")))
        cf.addChild((SpacesApp.btn("sp-clothadd" "sp-action sp-action-primary" (SpWords.ui(lang "addOne")))))
        b.addChild(cf)
        return b
    }

    ; The open ward's clothing to the server, whole.
    fn sendClothes:void (r:SpResource) {
        if ((server == false) || ((strlen spaceId) == 0)) {
            return
        }
        def ward:string r.id
        if (UiTree.beginsWith(r.id "wnew-")) {
            ward = r.name
        }
        this.queue("set_ward" (SpRemote.clothingBody(spaceId ward r)) r.id)
    }

    ; the ward whose clothing is open
    fn clothesWard@(optional):SpResource () {
        def found@(optional):SpResource
        def i:int 0
        while (i < (array_length space.resources)) {
            def r:SpResource (itemAt space.resources i)
            if (r.id == clothesOpen) {
                found = r
            }
            i = (i + 1)
        }
        return found
    }

    ; the number after a target's prefix, or -1
    sfn indexAfter:int (target:string prefix:string) {
        def n@(optional):int (to_int (substring target (strlen prefix) (strlen target)))
        if (null? n) {
            return -1
        }
        return (unwrap n)
    }

    ; A press on the clothing of the open ward; false when it is none.
    fn clothesClick:boolean (target:string) {
        if (UiTree.beginsWith(target "sp-wardclothes-")) {
            def k:int (SpacesApp.indexAfter(target "sp-wardclothes-"))
            if ((k >= 0) && (k < (array_length space.resources))) {
                def wr:SpResource (itemAt space.resources k)
                if (clothesOpen == wr.id) {
                    clothesOpen = ""
                } {
                    clothesOpen = wr.id
                }
            }
            return true
        }
        def opened@(optional):SpResource (this.clothesWard())
        if (null? opened) {
            return false
        }
        def r:SpResource opened
        if (target == "sp-sizeadd") {
            def what:string (trim sizeWhat.value)
            if ((strlen what) == 0) {
                status = (SpWords.pick(lang "Name the clothing, e.g. shoes" "Anna vaate, esim. kengät"))
                focused = "sp-size-what"
                return true
            }
            def by:string (trim sizeBy.value)
            if (((strlen by) > 0) && (((strlen by) < 7) || ((substring by 4 5) != "-"))) {
                status = (SpWords.pick(lang "Needed by is YYYY-MM" "Tarvitaan-kenttä on muotoa VVVV-KK"))
                focused = "sp-size-by"
                return true
            }
            def z (new SpSize())
            z.what = what
            z.size = (trim sizeNow.value)
            z.nextSize = (trim sizeNext.value)
            z.nextBy = by
            r.putSize(z)
            sizeWhat.setValue("")
            sizeNow.setValue("")
            sizeNext.setValue("")
            sizeBy.setValue("")
            this.sendClothes(r)
            status = ((SpWords.pick(lang "Saved " "Tallennettu ")) + (z.text()))
            return true
        }
        if (target == "sp-clothadd") {
            def item:string (trim clothItem.value)
            if ((strlen item) == 0) {
                status = (SpWords.pick(lang "Name the item" "Anna vaate"))
                focused = "sp-cloth-item"
                return true
            }
            def c (new SpCloth())
            c.item = item
            c.size = (trim clothSize.value)
            def nt:string (trim clothNeed.value)
            if ((strlen nt) > 0) {
                def nn@(optional):int (to_int nt)
                if ((null? nn) || ((unwrap nn) < 1) || ((unwrap nn) > 99)) {
                    status = (SpWords.pick(lang "How many is a number from 1 to 99" "Montako on luku 1–99"))
                    focused = "sp-cloth-need"
                    return true
                }
                c.need = (unwrap nn)
            }
            push r.clothes c
            clothItem.setValue("")
            clothSize.setValue("")
            clothNeed.setValue("")
            this.sendClothes(r)
            status = ((SpWords.pick(lang "Added " "Lisätty ")) + item)
            return true
        }
        if (UiTree.beginsWith(target "sp-sizedel-")) {
            def k2:int (SpacesApp.indexAfter(target "sp-sizedel-"))
            if ((k2 >= 0) && (k2 < (array_length r.sizes))) {
                r.dropSize(k2)
                this.sendClothes(r)
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-clothdel-")) {
            def k3:int (SpacesApp.indexAfter(target "sp-clothdel-"))
            if ((k3 >= 0) && (k3 < (array_length r.clothes))) {
                r.dropCloth(k3)
                this.sendClothes(r)
            }
            return true
        }
        if ((UiTree.beginsWith(target "sp-clothless-")) || (UiTree.beginsWith(target "sp-clothmore-"))) {
            ; the two prefixes are as long
            def k4:int (SpacesApp.indexAfter(target "sp-clothmore-"))
            if ((k4 >= 0) && (k4 < (array_length r.clothes))) {
                def cl:SpCloth (itemAt r.clothes k4)
                if (UiTree.beginsWith(target "sp-clothmore-")) {
                    if (cl.have < 99) {
                        cl.have = (cl.have + 1)
                    }
                } {
                    if (cl.have > 0) {
                        cl.have = (cl.have - 1)
                    }
                }
                this.sendClothes(r)
            }
            return true
        }
        return false
    }

    ; --- spaces -------------------------------------------------------------------------

    ; The spaces the person is in, and a new one.
    fn spacesView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        def sub:string account.email
        if loading {
            sub = (SpWords.ui(lang "loading"))
        }
        v.addChild((this.heading((SpWords.ui(lang "spaces")) sub)))
        def list:EVGElement (this.card("spaces" (SpWords.ui(lang "spaces"))))
        if (((array_length account.spaces) == 0) && (loading == false)) {
            list.addChild((SpacesApp.tx("sp-empty" (SpWords.ui(lang "noSpaces")))))
        }
        def i:int 0
        while (i < (array_length account.spaces)) {
            def info:SpSpaceInfo (itemAt account.spaces i)
            def on:boolean (info.id == spaceId)
            def cls:string "sp-spacerow"
            if on {
                cls = "sp-spacerow sp-spacerow-on"
            }
            def b:EVGElement (UiTree.div(("sp-open-" + info.id) cls))
            b.role = "button"
            b.a11yFocusable = true
            b.a11yLabel = info.name
            b.a11yPressed = (SpacesApp.tri(on))
            b.addChild((SpacesApp.dot("blue")))
            def col:EVGElement (SpacesApp.box("sp-itemtext"))
            def nm:EVGElement (SpacesApp.tx("sp-title" info.name))
            nm.a11yHidden = true
            col.addChild(nm)
            def mt:EVGElement (SpacesApp.tx("sp-meta" ((SpWords.packName(lang info.vocab)) + " · " + (SpWords.ui(lang info.role)))))
            mt.a11yHidden = true
            col.addChild(mt)
            b.addChild(col)
            list.addChild(b)
            i = (i + 1)
        }
        v.addChild(list)
        def nw:EVGElement (this.card("newspace" (SpWords.ui(lang "newSpace"))))
        def form:EVGElement (SpacesApp.box("sp-formrow"))
        form.addChild((this.field(nameField "sp-new-name" (SpWords.ui(lang "spaceName")) (SpWords.noun(lang newPack "space")) "text")))
        def pills:EVGElement (SpacesApp.box("sp-pills"))
        pills.role = "group"
        pills.a11yLabel = (SpWords.ui(lang "words"))
        def packs:[string] (SpWords.packs())
        def k:int 0
        while (k < (array_length packs)) {
            def pk:string (itemAt packs k)
            def pc:string "sp-pill"
            if (pk == newPack) {
                pc = "sp-pill sp-pill-on"
            }
            def pb:EVGElement (SpacesApp.btn(("sp-newpack-" + pk) pc (SpWords.packName(lang pk))))
            pb.a11yPressed = (SpacesApp.tri((pk == newPack)))
            pills.addChild(pb)
            k = (k + 1)
        }
        if (server == false) {
            form.addChild(pills)
        }
        form.addChild((SpacesApp.btn("sp-create" "sp-action sp-action-primary" (SpWords.ui(lang "create")))))
        nw.addChild(form)
        v.addChild(nw)
        if (server && (loading == false)) {
            v.addChild((this.lostCard()))
        }
        return v
    }

    ; --- text fields ----------------------------------------------------------------------

    ; An InputCtl on the page: built from its state, focused when the page's
    ; focus is on it, and placed after layout (`placeFields`).
    fn field:EVGElement (c:InputCtl tid:string label:string hint:string kind:string) {
        c.tid = tid
        c.name = label
        c.placeholder = hint
        c.kind = kind
        c.focused = (focused == tid)
        if (c.focused == false) {
            c.dragging = false
        }
        c.build()
        def fr:EVGElement (unwrap c.rootEl)
        fr.role = "textbox"
        fr.a11yLabel = label
        fr.a11yValue = c.value
        fr.a11yFocusable = true
        def view:EVGElement (unwrap c.viewEl)
        view.a11yHidden = true
        if (this.narrow()) {
            UiTree.inline(fr "width" (SpacesApp.px(((this.mainW()) - 40.0))))
        }
        push shown c
        return fr
    }

    fn fieldOf@(optional):InputCtl (id:string) {
        def found@(optional):InputCtl
        if ((strlen id) == 0) {
            return found
        }
        def i:int 0
        while (i < (array_length shown)) {
            def c:InputCtl (itemAt shown i)
            if (c.owns(id)) {
                found = c
            }
            i = (i + 1)
        }
        return found
    }

    fn placeFields:void (lay:EVGLayout) {
        def e:EVGTextEngine (lay.getTextEngine())
        def i:int 0
        while (i < (array_length shown)) {
            def c:InputCtl (itemAt shown i)
            c.placeText(e)
            i = (i + 1)
        }
    }

    ; The field the keyboard is in, or "".
    fn focusedField:string () {
        def f@(optional):InputCtl (this.fieldOf(focused))
        if (null? f) {
            return ""
        }
        return focused
    }

    ; A field's value, selection and box, for the host's text-input bridge.
    fn fieldStateJson:string (tid:string) {
        def f@(optional):InputCtl (this.fieldOf(tid))
        if (null? f) {
            return "null"
        }
        def c:InputCtl f
        this.laidOut()
        def o:VlJson (VlJson.objectValue())
        o.setMember("value" (VlJson.stringValue(c.value)))
        o.setMember("selStart" (VlJson.intValue((c.selStart()))))
        o.setMember("selEnd" (VlJson.intValue((c.selEnd()))))
        o.setMember("kind" (VlJson.stringValue(c.kind)))
        o.setMember("maxLength" (VlJson.intValue(c.maxLength)))
        o.setMember("readOnly" (VlJson.boolValue(c.readOnly)))
        o.setMember("multiline" (VlJson.boolValue(c.multiline)))
        def r:EVGElement (unwrap c.rootEl)
        def box:VlJson (VlJson.objectValue())
        box.setMember("x" (VlJson.numberValue(r.calculatedX)))
        box.setMember("y" (VlJson.numberValue(r.calculatedY)))
        box.setMember("w" (VlJson.numberValue(r.calculatedWidth)))
        box.setMember("h" (VlJson.numberValue(r.calculatedHeight)))
        o.setMember("box" box)
        return (SpRemote.write(o))
    }

    ; What the bridge's input now holds.
    fn applyEdit:boolean (tid:string v:string selStart:int selEnd:int) {
        def f@(optional):InputCtl (this.fieldOf(tid))
        if (null? f) {
            return false
        }
        def c:InputCtl f
        c.applyEdit(v selStart selEnd)
        this.rebuild()
        return true
    }

    ; Enter in a field presses its button.
    sfn submitOf:string (tid:string) {
        if (UiTree.beginsWith(tid "sp-ed-")) {
            return "sp-ed-save"
        }
        if (tid == "sp-invite-email") {
            return "sp-invite"
        }
        if (tid == "sp-place-name") {
            return "sp-place-find"
        }
        if (tid == "sp-new-name") {
            return "sp-create"
        }
        if (tid == "sp-ward-name") {
            return "sp-addward"
        }
        if (UiTree.beginsWith(tid "sp-size-")) {
            return "sp-sizeadd"
        }
        if (UiTree.beginsWith(tid "sp-cloth-")) {
            return "sp-clothadd"
        }
        if (tid == "sp-assist-text") {
            return "sp-assist-send"
        }
        if ((tid == "sp-own-title") || (tid == "sp-own-amount")) {
            return "sp-own-save"
        }
        if (tid == "sp-askai-text") {
            return "sp-askai-send"
        }
        if (tid == "sp-addsearch") {
            return "sp-addfirst"
        }
        return ""
    }

    ; --- the calendar ---------------------------------------------------------------

    fn calendarView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        v.addChild((this.heading((SpWords.ui(lang "calendar")) (SpWords.pick(lang "Drag to move, drag an empty slot to add. Double-click or Enter opens an event, Backspace deletes it." "Siirrä vetämällä, lisää vetämällä tyhjään kohtaan. Kaksoisnapsautus tai Enter avaa tapahtuman, askelpalautin poistaa sen.")))))
        v.addChild((this.addBar()))
        v.addChild((this.calShows()))
        board.cardW = (this.mainW())
        board.narrow = (this.narrow())
        board.focused = focused
        board.hovered = hovered
        v.addChild((board.card()))
        return v
    }

    ; What the calendar shows besides the entries' own days: the windows to
    ; get things in and the payment days, each a switch.
    fn calShows:EVGElement () {
        def row:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
        row.addChild((this.showSwitch("sp-cal-gets" (SpWords.ui(lang "showGets")) showGets)))
        row.addChild((this.showSwitch("sp-cal-pays" (SpWords.ui(lang "showPays")) showPays)))
        return row
    }

    fn showSwitch:EVGElement (id:string label:string on:boolean) {
        def cls:string "sp-tab"
        def mark:string "○ "
        if on {
            cls = "sp-tab sp-tab-on"
            mark = "✓ "
        }
        def b:EVGElement (SpacesApp.btn(id cls (mark + label)))
        b.a11yLabel = label
        b.a11yPressed = (SpacesApp.tri(on))
        return b
    }

    ; --- the sheets -----------------------------------------------------------------

    fn sheetsView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        v.addChild((this.heading((SpWords.ui(lang "sheets")) (SpWords.pick(lang "Rows with a date (and a time, a title, who) show in the summary and the calendar." "Rivit, joilla on päivä (ja aika, otsikko, kuka), näkyvät koonnissa ja kalenterissa.")))))
        v.addChild((this.addBar()))
        def bar:EVGElement (SpacesApp.box("sp-tabs"))
        if (this.narrow()) {
            bar = (SpacesApp.box("sp-tabs sp-wrap"))
        }
        bar.role = "tablist"
        def cur@(optional):SpSheet
        def i:int 0
        while (i < (array_length space.sheets)) {
            def sh:SpSheet (itemAt space.sheets i)
            if (((strlen sheetSel) == 0) && (i == 0)) {
                cur = sh
            }
            if (sh.id == sheetSel) {
                cur = sh
            }
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length space.sheets)) {
            def sh2:SpSheet (itemAt space.sheets k)
            def on:boolean false
            if (!null? cur) {
                on = ((unwrap cur).id == sh2.id)
            }
            def cls:string "sp-tab"
            if on {
                cls = "sp-tab sp-tab-on"
            }
            def tb:EVGElement (SpacesApp.btn(("sp-sheet-" + sh2.id) cls sh2.name))
            tb.role = "tab"
            tb.a11ySelected = (SpacesApp.tri(on))
            bar.addChild(tb)
            k = (k + 1)
        }
        if ((this.narrow()) == false) {
            bar.addChild((SpacesApp.box("sp-grow")))
        }
        bar.addChild((SpacesApp.btn("sp-import" "sp-action" (SpWords.ui(lang "import")))))
        if (!null? cur) {
            bar.addChild((SpacesApp.btn(("sp-export-" + (unwrap cur).id) "sp-action" (SpWords.ui(lang "exportCsv")))))
        }
        v.addChild(bar)
        if (null? cur) {
            v.addChild((SpacesApp.tx("sp-empty" (SpWords.pick(lang "No sheets yet" "Ei vielä taulukoita")))))
            return v
        }
        v.addChild((this.table((unwrap cur))))
        return v
    }

    fn table:EVGElement (sh:SpSheet) {
        def t:EVGElement (SpacesApp.box("sp-table"))
        t.role = "table"
        t.a11yLabel = sh.name
        def nc:int (array_length sh.cols)
        if (nc == 0) {
            return t
        }
        def w:double ((((this.mainW()) - 2.0) - 40.0) / (to_double nc))
        def events:[SpEvent] (space.sheetEvents(sh))
        def head:EVGElement (SpacesApp.box("sp-tr sp-thead"))
        head.role = "row"
        head.addChild((SpacesApp.box("sp-tdmark")))
        def c:int 0
        while (c < nc) {
            def cell:EVGElement (SpacesApp.tx("sp-th" (itemAt sh.cols c)))
            cell.role = "columnheader"
            UiTree.inline(cell "width" (SpacesApp.px(w)))
            head.addChild(cell)
            c = (c + 1)
        }
        t.addChild(head)
        def r:int 0
        while (r < (sh.rowCount())) {
            def row:EVGElement (SpacesApp.box("sp-tr"))
            if ((r % 2) == 1) {
                row = (SpacesApp.box("sp-tr sp-tr-alt"))
            }
            row.role = "row"
            def mark:string ""
            def rid:string (sh.id + "-r" + (to_string (r + 1)))
            def e:int 0
            while (e < (array_length events)) {
                def ev:SpEvent (itemAt events e)
                if (ev.id == rid) {
                    mark = "▦"
                }
                e = (e + 1)
            }
            def mk:EVGElement (SpacesApp.tx("sp-tdmark" mark))
            mk.a11yHidden = true
            row.addChild(mk)
            def c2:int 0
            while (c2 < nc) {
                def td:EVGElement (SpacesApp.tx("sp-td" (sh.cell(r c2))))
                td.role = "cell"
                UiTree.inline(td "width" (SpacesApp.px(w)))
                row.addChild(td)
                c2 = (c2 + 1)
            }
            t.addChild(row)
            r = (r + 1)
        }
        return t
    }

    ; --- documents --------------------------------------------------------------------

    fn docsView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        v.addChild((this.heading((SpWords.ui(lang "docs")) (SpWords.pick(lang "Summaries and plans the assistant wrote, and the space's own notes." "Avustajan kirjoittamat koosteet ja suunnitelmat sekä tilan omat muistiinpanot.")))))
        v.addChild((this.addBar()))
        def bar:EVGElement (SpacesApp.box("sp-tabs"))
        bar.addChild((SpacesApp.btn("sp-write-summary" "sp-action" (SpWords.ui(lang "newSummary")))))
        bar.addChild((SpacesApp.btn("sp-write-plan" "sp-action sp-action-primary" (SpWords.ui(lang "newPlan")))))
        v.addChild(bar)
        def split:EVGElement (SpacesApp.box("sp-split"))
        if (this.narrow()) {
            split = (SpacesApp.box("sp-split sp-cols-narrow"))
        }
        def list:EVGElement (SpacesApp.box("sp-doclist"))
        list.role = "list"
        def cur@(optional):SpDoc
        def n:int (array_length space.docs)
        def i:int (n - 1)
        while (i >= 0) {
            def d:SpDoc (itemAt space.docs i)
            if (((strlen docSel) == 0) && (i == (n - 1))) {
                cur = d
            }
            if (d.id == docSel) {
                cur = d
            }
            i = (i - 1)
        }
        def k:int (n - 1)
        while (k >= 0) {
            def d2:SpDoc (itemAt space.docs k)
            def on:boolean false
            if (!null? cur) {
                on = ((unwrap cur).id == d2.id)
            }
            def cls:string "sp-docitem"
            if on {
                cls = "sp-docitem sp-docitem-on"
            }
            def b:EVGElement (UiTree.div(("sp-doc-" + d2.id) cls))
            b.role = "button"
            b.a11yFocusable = true
            b.a11yLabel = d2.title
            b.a11yPressed = (SpacesApp.tri(on))
            b.addChild((SpacesApp.tx("sp-title" d2.title)))
            b.addChild((SpacesApp.tx("sp-meta" (SpWords.dayLabel(lang d2.day)))))
            list.addChild(b)
            k = (k - 1)
        }
        if (this.narrow()) {
            UiTree.inline(list "width" (SpacesApp.px((this.mainW()))))
        }
        split.addChild(list)
        if (null? cur) {
            split.addChild((SpacesApp.tx("sp-empty" (SpWords.ui(lang "noDocs")))))
        } {
            def docW:double (((this.mainW()) - 240.0) - 16.0)
            if (this.narrow()) {
                docW = (this.mainW())
            }
            def cd:SpDoc (unwrap cur)
            def body:EVGElement (this.markdown("sp-docbody" cd.body docW))
            split.addChild(body)
        }
        v.addChild(split)
        return v
    }

    ; Markdown drawn as the documents use it: headings, bullets, task boxes
    ; and paragraphs.
    fn markdown:EVGElement (id:string md:string w:double) {
        def doc:EVGElement (UiTree.div(id "sp-doc"))
        doc.role = "region"
        doc.a11yLabel = (SpWords.ui(lang "docs"))
        UiTree.inline(doc "width" (SpacesApp.px(w)))
        this.mdInto(doc md (w - 50.0) "sp-md-p")
        return doc
    }

    ; Markdown's lines into a box: headings, bullets, check boxes and
    ; paragraphs, with **bold** inside a line. `w` is the lines' width (-1:
    ; as wide as they are).
    fn mdInto:void (doc:EVGElement md:string w:double cls:string) {
        def lines:[string] (strsplit md "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def l:string (trim (itemAt lines i))
            def n:int (strlen l)
            if (n > 0) {
                if (UiTree.beginsWith(l "### ")) {
                    def h3:EVGElement (this.mdLine("sp-md-h2" (substring l 4 n) w))
                    h3.role = "heading"
                    doc.addChild(h3)
                } {
                    if (UiTree.beginsWith(l "## ")) {
                        def h2:EVGElement (this.mdLine("sp-md-h2" (substring l 3 n) w))
                        h2.role = "heading"
                        doc.addChild(h2)
                    } {
                        if (UiTree.beginsWith(l "# ")) {
                            def h1:EVGElement (this.mdLine("sp-md-h1" (substring l 2 n) w))
                            h1.role = "heading"
                            doc.addChild(h1)
                        } {
                            if (UiTree.beginsWith(l "- [ ] ")) {
                                doc.addChild((this.mdLine("sp-md-li" ("☐ " + (substring l 6 n)) w)))
                            } {
                                if ((UiTree.beginsWith(l "- ")) || (UiTree.beginsWith(l "* ")) || (UiTree.beginsWith(l "• "))) {
                                    doc.addChild((this.mdLine("sp-md-li" ("• " + (trim (substring l 2 n))) w)))
                                } {
                                    doc.addChild((this.mdLine(cls l w)))
                                }
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; One line: plain, it is one text; with **bold** in it, its words in a
    ; row that wraps, the bold ones bold.
    fn mdLine:EVGElement (cls:string text:string w:double) {
        def parts:[string] (strsplit text "**")
        def np:int (array_length parts)
        if ((np < 3) || ((np % 2) == 0)) {
            def t:EVGElement (SpacesApp.tx(cls text))
            if (w > 0.0) {
                UiTree.inline(t "width" (SpacesApp.px(w)))
            }
            return t
        }
        ; the words and whether each is bold; what follows a segment with
        ; no space between ("**Leo**:") goes on the word before it
        def words:[string]
        def bolds:[boolean]
        def lastSpace:boolean true
        def p:int 0
        while (p < np) {
            def seg:string (itemAt parts p)
            def bold:boolean ((p % 2) == 1)
            if ((strlen seg) > 0) {
                def ws:[string] (strsplit seg " ")
                def k:int 0
                while (k < (array_length ws)) {
                    def word:string (itemAt ws k)
                    if ((strlen word) > 0) {
                        def nw:int (array_length words)
                        if (((k == 0) && (lastSpace == false)) && (nw > 0)) {
                            set words (nw - 1) ((itemAt words (nw - 1)) + word)
                        } {
                            push words word
                            push bolds bold
                        }
                    }
                    k = (k + 1)
                }
                lastSpace = ((substring seg ((strlen seg) - 1) (strlen seg)) == " ")
            }
            p = (p + 1)
        }
        def row:EVGElement (SpacesApp.box((cls + " sp-md-words")))
        row.role = "text"
        row.a11yLabel = (join parts "")
        if (w > 0.0) {
            UiTree.inline(row "width" (SpacesApp.px(w)))
        }
        def i:int 0
        while (i < (array_length words)) {
            def c:string "sp-md-w"
            if (itemAt bolds i) {
                c = "sp-md-w sp-md-b"
            }
            def we:EVGElement (SpacesApp.tx(c (itemAt words i)))
            we.a11yHidden = true
            row.addChild(we)
            i = (i + 1)
        }
        return row
    }

    fn writeDoc:void (kind:string) {
        def body:string ""
        if (kind == "plan") {
            body = (SpAssist.plan(space lang today))
        } {
            body = (SpAssist.weekSummary(space lang today))
        }
        def lines:[string] (strsplit body "\n")
        def title:string (itemAt lines 0)
        if (UiTree.beginsWith(title "# ")) {
            title = (substring title 2 (strlen title))
        }
        def d:SpDoc (space.addDoc(title body today))
        docSel = d.id
        tab = "docs"
        status = (SpWords.pick(lang "Written: " "Kirjoitettu: ") + title)
    }

    ; --- the assistant ----------------------------------------------------------------

    fn assistantView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        def onServer:boolean (server && ((strlen spaceId) > 0))
        def sub:string (SpWords.ui(lang "local"))
        if onServer {
            sub = (SpWords.pick(lang "A conversation: tell it what to add or change, in your own words or as a picture. It asks when something is unclear and says when it cannot do something." "Keskustele avustajan kanssa: kerro omin sanoin tai kuvana, mitä lisätään tai muutetaan. Se kysyy, jos jokin jää epäselväksi, ja kertoo, jos ei osaa jotain."))
        }
        v.addChild((this.heading((SpWords.ui(lang "assistant")) sub)))
        if (onServer == false) {
            def qs:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
            qs.role = "group"
            qs.a11yLabel = (SpWords.ui(lang "ask"))
            def keys:[string] ([] _:string ( "qToday" "qWeek" "qNext" "qLate" "qPlan" ))
            def i:int 0
            while (i < (array_length keys)) {
                def k:string (itemAt keys i)
                qs.addChild((SpacesApp.btn(("sp-q-" + k) "sp-chip" (SpWords.ui(lang k)))))
                i = (i + 1)
            }
            v.addChild(qs)
        }
        def chat:EVGElement (UiTree.div("sp-chat" "sp-chat"))
        chat.role = "region"
        chat.a11yLabel = (SpWords.pick(lang "Conversation with the assistant" "Keskustelu avustajan kanssa"))
        def inner:double (this.chatInner())
        def log:EVGElement (SpacesApp.box("sp-chatlog"))
        log.role = "log"
        if (this.narrow()) {
            UiTree.inline(log "padding" "14px 12px")
        }
        def n:int (array_length asked)
        if (onServer && (n == 0)) {
            log.addChild((this.welcome(inner)))
        }
        def j:int 0
        while (j < n) {
            log.addChild((this.mineSaid(j inner)))
            log.addChild((this.aiSaid(j inner)))
            j = (j + 1)
        }
        if ((onServer == false) && (n == 0)) {
            log.addChild((SpacesApp.tx("sp-cardsub" (SpWords.ui(lang "ask")))))
        }
        chat.addChild(log)
        if onServer {
            def comp:EVGElement (SpacesApp.box("sp-composer"))
            if (this.narrow()) {
                UiTree.inline(comp "padding" "10px 12px")
            }
            comp.addChild((this.assistInput()))
            chat.addChild(comp)
        }
        v.addChild(chat)
        if onServer {
            def hrow:EVGElement (SpacesApp.box("sp-row"))
            def mark:string "▸ "
            if helpOpen {
                mark = "▾ "
            }
            def hb:EVGElement (SpacesApp.btn("sp-assist-help" "sp-link" (mark + (SpWords.pick(lang "What can the assistant do?" "Mitä avustaja osaa?")))))
            hb.a11yExpanded = (SpacesApp.tri(helpOpen))
            hrow.addChild(hb)
            v.addChild(hrow)
            if helpOpen {
                v.addChild((this.addHelp()))
            }
        }
        return v
    }

    ; The width inside the conversation's box.
    fn chatInner:double () {
        if (this.narrow()) {
            return ((this.mainW()) - 34.0)
        }
        return ((this.mainW()) - 50.0)
    }

    ; How wide a bubble may be, and the text inside it.
    fn bubbleW:double (inner:double) {
        if (this.narrow()) {
            return (inner - 16.0)
        }
        return (inner * 0.82)
    }

    ; The assistant's opening line and a few things to try, which fill the
    ; field when pressed.
    fn welcome:EVGElement (inner:double) {
        def col:EVGElement (SpacesApp.box("sp-msgcol"))
        col.addChild((SpacesApp.tx("sp-msgwho" (SpWords.pick(lang "Assistant" "Avustaja")))))
        def b:EVGElement (UiTree.div("sp-say-hello" "sp-say-ai"))
        b.role = "text"
        def bw:double (this.bubbleW(inner))
        UiTree.inline(b "width" (SpacesApp.px(bw)))
        this.mdInto(b (SpWords.pick(lang "Hi! Tell me what to add or change: an appointment, a hobby's place and time, something to get. You can paste a whole letter or add a picture of it. I ask if something is unclear." "Hei! Kerro, mitä lisätään tai muutetaan: menon, harrastuksen paikan ja ajan tai hankittavan asian. Voit liittää koko tiedotteen tai lisätä siitä kuvan. Kysyn, jos jokin jää epäselväksi.")) (bw - 30.0) "sp-md-p")
        col.addChild(b)
        def ex:EVGElement (SpacesApp.box("sp-examples"))
        ex.role = "group"
        ex.a11yLabel = (SpWords.pick(lang "Try for example" "Kokeile esimerkiksi"))
        ex.addChild((SpacesApp.tx("sp-msgwho" (SpWords.pick(lang "Try for example" "Kokeile esimerkiksi")))))
        def all:[string] (this.examples())
        def k:int 0
        while (k < (array_length all)) {
            ex.addChild((SpacesApp.btn(("sp-ex-" + (to_string k)) "sp-example" ("› " + (itemAt all k)))))
            k = (k + 1)
        }
        col.addChild(ex)
        return col
    }

    fn examples:[string] () {
        return ([] _:string (
            (SpWords.pick(lang "Gym class is at the school gym, now 18.15–19.15" "Jumppa onkin koulun salilla, uusi aika 18.15–19.15"))
            (SpWords.pick(lang "Add the time of the doctor's visit" "Lisää lääkärikäynnin kellonaika"))
            (SpWords.pick(lang "Add a wish to the shopping list" "Lisää hankintatoive listalle"))
            (SpWords.pick(lang "What do we have this week?" "Mitä meillä on tällä viikolla?"))
        ))
    }

    ; What the person said: on the right, under "You".
    fn mineSaid:EVGElement (j:int inner:double) {
        def row:EVGElement (SpacesApp.box("sp-msg sp-msg-me"))
        row.addChild((SpacesApp.box("sp-grow")))
        def col:EVGElement (SpacesApp.box("sp-msgcol sp-msgcol-me"))
        col.addChild((SpacesApp.tx("sp-msgwho" (SpWords.pick(lang "You" "Sinä")))))
        def qk:string (itemAt asked j)
        def qt:string (SpWords.ui(lang qk))
        if (UiTree.beginsWith(qk "@")) {
            qt = (SpacesApp.clip((substring qk 1 (strlen qk)) 1200))
        }
        def b:EVGElement (UiTree.div(("sp-said-" + (to_string j)) "sp-say-me"))
        b.role = "text"
        b.a11yLabel = qt
        def bw:double (this.bubbleW(inner))
        def tw:double -1.0
        if (SpacesApp.longText(qt)) {
            UiTree.inline(b "width" (SpacesApp.px(bw)))
            tw = (bw - 30.0)
        }
        def lines:[string] (strsplit qt "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def l:string (itemAt lines i)
            if ((strlen (trim l)) > 0) {
                def t:EVGElement (SpacesApp.tx("sp-say-me-tx" l))
                if (tw > 0.0) {
                    UiTree.inline(t "width" (SpacesApp.px(tw)))
                }
                b.addChild(t)
            }
            i = (i + 1)
        }
        col.addChild(b)
        if (UiTree.beginsWith(qk "@")) {
            def act:EVGElement (SpacesApp.box("sp-msgacts"))
            act.addChild((SpacesApp.box("sp-grow")))
            act.addChild((SpacesApp.btn(("sp-copy-q-" + (to_string j)) "sp-link sp-link-quiet" (SpWords.pick(lang "Copy" "Kopioi")))))
            col.addChild(act)
        }
        row.addChild(col)
        return row
    }

    ; A text that does not fit on one short line wraps in a full bubble.
    sfn longText:boolean (t:string) {
        return ((((strlen t) > 56) || ((indexOf t "\n") >= 0)) || ((indexOf t "**") >= 0))
    }

    ; The assistant's answer: on the left, under "Assistant", with what it
    ; made or changed as cards under it.
    fn aiSaid:EVGElement (j:int inner:double) {
        def col:EVGElement (SpacesApp.box("sp-msgcol"))
        col.addChild((SpacesApp.tx("sp-msgwho" (SpWords.pick(lang "Assistant" "Avustaja")))))
        def text:string (itemAt answers j)
        def b:EVGElement (UiTree.div(("sp-answer-" + (to_string j)) "sp-say-ai"))
        b.role = "text"
        def busy:boolean (assistBusy && (j == ((array_length answers) - 1)))
        if busy {
            UiTree.addClass(b "sp-say-busy")
        }
        def bw:double (this.bubbleW(inner))
        def tw:double -1.0
        if (SpacesApp.longText(text)) {
            UiTree.inline(b "width" (SpacesApp.px(bw)))
            tw = (bw - 30.0)
        }
        this.mdInto(b text tw "sp-md-p")
        ; a short answer is a short bubble
        def brow:EVGElement (SpacesApp.box("sp-msg"))
        brow.addChild(b)
        brow.addChild((SpacesApp.box("sp-grow")))
        col.addChild(brow)
        def cards@(optional):EVGElement (this.doneCards(j bw))
        if (!null? cards) {
            col.addChild((unwrap cards))
        }
        if (busy == false) {
            def act:EVGElement (SpacesApp.box("sp-msgacts"))
            def latest:boolean (j == ((array_length answers) - 1))
            if (latest && ((itemAt asked j) == "qPlan")) {
                act.addChild((SpacesApp.btn("sp-write-plan" "sp-link" (SpWords.pick(lang "Save as a document" "Tallenna dokumentiksi")))))
            }
            if (latest && ((itemAt asked j) == "qWeek")) {
                act.addChild((SpacesApp.btn("sp-write-summary" "sp-link" (SpWords.pick(lang "Save as a document" "Tallenna dokumentiksi")))))
            }
            act.addChild((SpacesApp.btn(("sp-copy-a-" + (to_string j)) "sp-link sp-link-quiet" (SpWords.pick(lang "Copy answer" "Kopioi vastaus")))))
            col.addChild(act)
        }
        return col
    }

    ; What one answer made, changed or removed, as cards; a press on one
    ; opens the entry. None when it did nothing.
    fn doneCards@(optional):EVGElement (j:int w:double) {
        def none@(optional):EVGElement
        if (j >= (array_length doneIds)) {
            return none
        }
        def ids:[string] (UiTree.splitWs((itemAt doneIds j)))
        def gone:[string] (SpacesApp.nonEmpty((strsplit (itemAt doneGone j) "\n")))
        def notes:[string] (SpacesApp.nonEmpty((strsplit (itemAt doneNotes j) "\n")))
        def cards:[EVGElement]
        def cw:double w
        if (cw > 460.0) {
            cw = 460.0
        }
        def k:int 0
        while (k < (array_length ids)) {
            def found@(optional):SpEvent (space.byRemote((itemAt ids k)))
            if (!null? found) {
                def e:SpEvent found
                push cards (this.doneCard(("sp-done-" + (to_string j) + "-" + (to_string k)) e cw))
            }
            k = (k + 1)
        }
        def g:int 0
        while (g < (array_length gone)) {
            def c:EVGElement (SpacesApp.box("sp-done sp-done-gone"))
            c.role = "text"
            def t:EVGElement (SpacesApp.tx("sp-done-title sp-done-struck" (itemAt gone g)))
            UiTree.inline(t "width" (SpacesApp.px((cw - 80.0))))
            c.addChild((SpacesApp.tx("sp-done-mark sp-done-mark-gone" "−")))
            def tc:EVGElement (SpacesApp.box("sp-done-text"))
            tc.addChild(t)
            tc.addChild((SpacesApp.tx("sp-done-sub" (SpWords.pick(lang "Removed" "Poistettu")))))
            c.addChild(tc)
            UiTree.inline(c "width" (SpacesApp.px(cw)))
            push cards c
            g = (g + 1)
        }
        if (((array_length cards) == 0) && ((array_length notes) == 0)) {
            return none
        }
        def box:EVGElement (UiTree.div(("sp-donelist-" + (to_string j)) "sp-donelist"))
        box.role = "group"
        def head:string (SpWords.pick(lang "Done" "Tehty"))
        box.a11yLabel = head
        box.addChild((SpacesApp.tx("sp-msgwho" ((head + " (" + (to_string ((array_length cards) + (array_length notes)))) + ")"))))
        def c2:int 0
        while (c2 < (array_length cards)) {
            box.addChild((itemAt cards c2))
            c2 = (c2 + 1)
        }
        def m:int 0
        while (m < (array_length notes)) {
            box.addChild((SpacesApp.tx("sp-done-note" ("✓ " + (itemAt notes m)))))
            m = (m + 1)
        }
        def res@(optional):EVGElement box
        return res
    }

    sfn inList:boolean (l:[string] x:string) {
        def i:int 0
        while (i < (array_length l)) {
            if ((itemAt l i) == x) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn nonEmpty:[string] (l:[string]) {
        def out:[string]
        def i:int 0
        while (i < (array_length l)) {
            if ((strlen (trim (itemAt l i))) > 0) {
                push out (itemAt l i)
            }
            i = (i + 1)
        }
        return out
    }

    ; One entry the assistant made or changed: its type, title, day and time
    ; and whose it is.
    fn doneCard:EVGElement (id:string e:SpEvent w:double) {
        def c:EVGElement (UiTree.div(id "sp-done"))
        c.role = "button"
        c.a11yFocusable = true
        UiTree.inline(c "width" (SpacesApp.px(w)))
        def bits:[string]
        push bits (this.typeName(e.typeId))
        if (e.dated()) {
            def when:string (SpWords.dayLabel(lang e.day))
            if (e.startMin >= 0) {
                when = (when + " " + (SpWords.clock(lang e.startMin)))
                if (e.endMin > e.startMin) {
                    when = (when + "–" + (SpWords.clock(lang e.endMin)))
                }
            }
            if (e.repeats()) {
                when = (when + " " + (SpWords.pick(lang "(repeats)" "(toistuu)")))
            }
            push bits when
        }
        def who:string (space.resourceName(e.resource))
        if ((strlen who) > 0) {
            push bits who
        }
        def sub:string (join bits " · ")
        c.a11yLabel = (e.title + ", " + sub)
        def mark:EVGElement (SpacesApp.tx(("sp-done-mark sp-c-" + (this.colorOfEvent(e))) "✓"))
        mark.a11yHidden = true
        c.addChild(mark)
        def tc:EVGElement (SpacesApp.box("sp-done-text"))
        tc.a11yHidden = true
        def t:EVGElement (SpacesApp.tx("sp-done-title" e.title))
        UiTree.inline(t "width" (SpacesApp.px((w - 80.0))))
        tc.addChild(t)
        def s:EVGElement (SpacesApp.tx("sp-done-sub" sub))
        UiTree.inline(s "width" (SpacesApp.px((w - 80.0))))
        tc.addChild(s)
        c.addChild(tc)
        c.addChild((SpacesApp.tx("sp-done-open" "›")))
        return c
    }

    ; A press on a card: the entry opens in the form.
    fn openDone:boolean (target:string) {
        def parts:[string] (strsplit (substring target 8 (strlen target)) "-")
        if ((array_length parts) != 2) {
            return false
        }
        def jj@(optional):int (to_int (itemAt parts 0))
        def kk@(optional):int (to_int (itemAt parts 1))
        if ((null? jj) || (null? kk)) {
            return false
        }
        def j:int (unwrap jj)
        def k:int (unwrap kk)
        if ((j < 0) || (j >= (array_length doneIds))) {
            return false
        }
        def ids:[string] (UiTree.splitWs((itemAt doneIds j)))
        if ((k < 0) || (k >= (array_length ids))) {
            return false
        }
        def found@(optional):SpEvent (space.byRemote((itemAt ids k)))
        if (null? found) {
            return false
        }
        def e:SpEvent found
        editId = e.id
        editOcc = -1
        editType = e.typeId
        this.fillForm(e)
        return true
    }

    fn ask:void (q:string) {
        push asked q
        push answers (SpAssist.answer(space lang today q))
        this.noneDone()
    }

    ; An answer that made nothing (yet): its rows of what was done.
    fn noneDone:void () {
        push doneIds ""
        push doneGone ""
        push doneNotes ""
    }

    ; The field, the pictures added and Send.
    fn assistInput:EVGElement () {
        def box:EVGElement (UiTree.div("sp-assist" "sp-assist"))
        assistField.multiline = true
        assistField.maxLines = 12
        def fr:EVGElement (this.field(assistField "sp-assist-text" (SpWords.pick(lang "Message to the assistant" "Viesti avustajalle")) (SpWords.pick(lang "Write a message, or paste a letter or a timetable…" "Kirjoita viesti tai liitä tiedote tai aikataulu…")) "text"))
        ; as wide as the view: a letter is long
        def fw:double ((this.mainW()) - 40.0)
        if ((tab == "assistant") && (addOpen == false)) {
            fw = (this.chatInner())
            UiTree.inline(box "margin-bottom" "6px")
        }
        UiTree.inline(fr "width" (SpacesApp.px(fw)))
        box.addChild(fr)
        if ((array_length pics) > 0) {
            def prow:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
            def i:int 0
            while (i < (array_length pics)) {
                def nm:string (itemAt picNames i)
                prow.addChild((SpacesApp.btn(("sp-assist-drop-" + (to_string i)) "sp-chip" ("× " + nm))))
                i = (i + 1)
            }
            box.addChild(prow)
        }
        def row:EVGElement (SpacesApp.box("sp-row"))
        row.addChild((SpacesApp.btn("sp-assist-image" "sp-action" (SpWords.pick(lang "Add a picture" "Lisää kuva")))))
        row.addChild((SpacesApp.box("sp-grow")))
        if assistBusy {
            row.addChild((SpacesApp.tx("sp-cardsub" (SpWords.pick(lang "The assistant is working…" "Avustaja työskentelee…")))))
        } {
            if ((this.narrow()) == false) {
                row.addChild((SpacesApp.tx("sp-hint" (SpWords.pick(lang "Ctrl+Enter sends" "Ctrl+Enter lähettää")))))
            }
            row.addChild((SpacesApp.btn("sp-assist-send" "sp-action sp-action-primary" (SpWords.pick(lang "Send" "Lähetä")))))
        }
        box.addChild(row)
        return box
    }

    ; The colour of an entry's card: its own, its ward's, or its group's.
    fn colorOfEvent:string (e:SpEvent) {
        if ((strlen e.color) > 0) {
            return e.color
        }
        if ((strlen e.resource) > 0) {
            def c:string (space.resourceColor(e.resource))
            if ((strlen c) > 0) {
                return c
            }
        }
        def o:SpOccur (new SpOccur())
        o.typeId = e.typeId
        return (SpacesApp.groupColor((this.groupOfOcc(o))))
    }

    ; What the assistant can add and the details each takes: a short list
    ; under its field. The kinds follow the entry types' groups,
    ; questions and the space's own wards and places.
    fn addHelp:EVGElement () {
        def box:EVGElement (SpacesApp.box("sp-help"))
        box.role = "region"
        box.a11yLabel = (SpWords.pick(lang "What you can add" "Mitä voi lisätä"))
        def w:double ((this.mainW()) - 40.0)
        def head:EVGElement (SpacesApp.tx("sp-addgroup-name" (SpWords.pick(lang "What you can add (write several at once; Enter makes a new line, Ctrl+Enter sends)" "Mitä voi lisätä (useampi kerralla käy; Enter tekee rivinvaihdon, Ctrl+Enter lähettää)"))))
        UiTree.inline(head "width" (SpacesApp.px(w)))
        box.addChild(head)
        def keys:[string] ([] _:string (
            (SpWords.pick(lang "Events" "Menot ja juhlat"))
            (SpWords.pick(lang "Hobbies" "Harrastukset"))
            (SpWords.pick(lang "School and daycare" "Koulu ja päiväkoti"))
            (SpWords.pick(lang "Childcare" "Hoito"))
            (SpWords.pick(lang "Health" "Terveys"))
            (SpWords.pick(lang "Trips and bookings" "Matkat ja varaukset"))
            (SpWords.pick(lang "Money" "Raha"))
            (SpWords.pick(lang "Things to get" "Hankinnat"))
            (SpWords.pick(lang "Questions" "Kyselyt"))
            (SpWords.pick(lang "Home and things" "Koti ja tavarat"))
            (SpWords.pick(lang "Reminders" "Muistutukset"))
            (SpWords.pick(lang "Family and places" "Perhe ja paikat"))
        ))
        def vals:[string] ([] _:string (
            (SpWords.pick(lang "Birthday invitation, party, school event, parents' evening, meeting, an event you found (paste its link). Day and time or a range, place, whose, who takes, reply by, gift." "Synttärikutsu, juhla, koulun tapahtuma, vanhempainilta, tapaaminen, löytämäsi tapahtuma (liitä linkki). Päivä ja kellonaika tai aikaväli, paikka, kenen, kuka vie, vastaa viimeistään, lahja."))
            (SpWords.pick(lang "Hobby and its sessions, match, camp, course sign-up. Weekdays and times, season from–to, place, fee, gear." "Harrastus ja sen kerrat, ottelu, leiri, kurssi-ilmoittautuminen. Viikonpäivät ja ajat, kausi alkaa–päättyy, paikka, maksu, varusteet."))
            (SpWords.pick(lang "School day times, holidays and exception days, exams, daycare days, term." "Koulupäivän ajat, lomat ja poikkeuspäivät, kokeet, päiväkotipäivät, lukukausi."))
            (SpWords.pick(lang "Childcare shift or a suggested time, babysitter, change to the usual, rides. Date range, times, who looks after whom, price." "Hoitovuoro tai hoitoaikaehdotus, babysitter, poikkeus normaalirytmiin, kuljetukset. Päivämääräväli, kellonajat, kuka hoitaa kenet, hinta."))
            (SpWords.pick(lang "Doctor, dentist, health check, medication period. Time, place, whose, what to bring." "Lääkäri, hammaslääkäri, neuvola tai tarkastus, lääkitysjakso. Aika, paikka, kenen, mitä mukaan."))
            (SpWords.pick(lang "Trip, flight, train or ferry, accommodation, holiday home, travel card. Dates from–to, booking code, price, who goes, card balance." "Matka, lento, juna tai laiva, majoitus, loma-asunto, matkakortti. Päivät alkaen–asti, varaustunnus, hinta, ketkä, kortin saldo."))
            (SpWords.pick(lang "Bill, expected or recurring expense, insurance. Amount, due date, how often; amounts go to the budget." "Lasku, menovaraus, toistuva kulu, vakuutus. Summa, eräpäivä, kuinka usein; summat menevät budjettiin."))
            (SpWords.pick(lang "Need, purchase idea, gift idea, Christmas gift, an offer you found (paste its link), thing to sell. Price or budget, size, for whom, where from, get from–by." "Ostotarve, tavarahankintaidea, lahjaidea, joululahja, löytämäsi tarjous (liitä linkki), myytävä tavara. Hinta tai budjetti, koko, kenelle, mistä, hanki aikaisintaan–viimeistään."))
            (SpWords.pick(lang "”Ask Tero: can you take the kids on Sat 25.10. at 10–16?” To whom, what, day or range, times, an amount to settle. A yes goes in the calendar." "”Kysy Terolta: otatko lapset hoitoon la 25.10. klo 10–16?” Kenelle, mitä, päivä tai aikaväli, kellonajat, tasattava summa. Kyllä-vastaus menee kalenteriin."))
            (SpWords.pick(lang "Maintenance, repair, home task, cleaning, smoke alarm, storage check. Due date, how often, who does it, cost." "Huolto, korjaus, kotityö, siivous, palohälytin, varaston tarkastus. Määräpäivä, kuinka usein, kuka hoitaa, kustannus."))
            (SpWords.pick(lang "Reminder, a call to make, deadline, passport renewal, contact. Day and how many days before to remind." "Muistutus, soitettava asia, määräpäivä, passin uusiminen, yhteystieto. Päivä ja montako päivää ennen muistutetaan."))
            (SpWords.pick(lang "Children, pets or a car, their sizes and clothes, places for the weather. ”Leo's shoe size is 32”, ”add the place Kuopio”." "Lapset, lemmikit tai auto, vaatekoot ja vaatteet, paikkakunnat säätä varten. ”Leon kengänkoko on 32”, ”lisää paikkakunta Kuopio”."))
        ))
        def narrow:boolean (this.narrow())
        def kw:double 150.0
        def i:int 0
        while (i < (array_length keys)) {
            def row:EVGElement (SpacesApp.box("sp-helprow"))
            def k:EVGElement (SpacesApp.tx("sp-helpk" (itemAt keys i)))
            def v:EVGElement (SpacesApp.tx("sp-helpv" (itemAt vals i)))
            if narrow {
                row = (SpacesApp.box("sp-helprow sp-helprow-narrow"))
                UiTree.inline(k "width" (SpacesApp.px(w)))
                UiTree.inline(v "width" (SpacesApp.px(w)))
            } {
                UiTree.inline(k "width" (SpacesApp.px(kw)))
                UiTree.inline(v "width" (SpacesApp.px(((w - kw) - 12.0))))
            }
            row.addChild(k)
            row.addChild(v)
            box.addChild(row)
            i = (i + 1)
        }
        return box
    }

    sfn clip:string (t:string n:int) {
        if ((strlen t) <= n) {
            return t
        }
        return ((substring t 0 n) + "…")
    }

    ; A picture for the assistant, from the host: its type, base64 and name.
    fn addImage:void (name:string mime:string data:string) {
        if ((array_length pics) >= 3) {
            status = (SpWords.pick(lang "At most three pictures at a time" "Enintään kolme kuvaa kerralla"))
            this.rebuild()
            return
        }
        push pics data
        push picTypes mime
        def nm:string name
        if ((strlen nm) == 0) {
            nm = (SpWords.pick(lang "Picture" "Kuva"))
        }
        push picNames (SpacesApp.clip(nm 24))
        if (addOpen == false) {
            tab = "assistant"
        }
        this.rebuild()
    }

    fn dropImage:void (k:int) {
        def p2:[string]
        def t2:[string]
        def n2:[string]
        def i:int 0
        while (i < (array_length pics)) {
            if (i != k) {
                push p2 (itemAt pics i)
                push t2 (itemAt picTypes i)
                push n2 (itemAt picNames i)
            }
            i = (i + 1)
        }
        pics = p2
        picTypes = t2
        picNames = n2
    }

    ; What is written and the pictures go to the server's assistant, with
    ; the conversation so far.
    fn sendAssist:void () {
        this.sendAssistOf(assistField "")
    }

    ; `fld`'s text and the pictures to the assistant; `purpose` "question"
    ; when written on the Questions view, to be asked of another member.
    fn sendAssistOf:void (fld:InputCtl purpose:string) {
        def text:string (trim fld.value)
        if (((strlen text) == 0) && ((array_length pics) == 0)) {
            status = (SpWords.pick(lang "Write something or add a picture" "Kirjoita jotain tai lisää kuva"))
            focused = fld.tid
            return
        }
        if assistBusy {
            return
        }
        def o:VlJson (VlJson.objectValue())
        o.setMember("space_id" (SpRemote.str(spaceId)))
        o.setMember("text" (SpRemote.str(text)))
        o.setMember("today" (SpRemote.str((SpSpace.dateText(today)))))
        if ((strlen purpose) > 0) {
            o.setMember("purpose" (SpRemote.str(purpose)))
        }
        def ims:VlJson (VlJson.arrayValue())
        def i:int 0
        while (i < (array_length pics)) {
            def im:VlJson (VlJson.objectValue())
            im.setMember("mimeType" (SpRemote.str((itemAt picTypes i))))
            im.setMember("data" (SpRemote.str((itemAt pics i))))
            push ims.arr im
            i = (i + 1)
        }
        o.setMember("images" ims)
        def hist:VlJson (VlJson.arrayValue())
        def j:int 0
        while (j < (array_length asked)) {
            def qk:string (itemAt asked j)
            if (UiTree.beginsWith(qk "@")) {
                def hu:VlJson (VlJson.objectValue())
                hu.setMember("role" (SpRemote.str("user")))
                hu.setMember("text" (SpRemote.str((substring qk 1 (strlen qk)))))
                push hist.arr hu
                def ha:VlJson (VlJson.objectValue())
                ha.setMember("role" (SpRemote.str("assistant")))
                ha.setMember("text" (SpRemote.str((itemAt answers j))))
                push hist.arr ha
            }
            j = (j + 1)
        }
        o.setMember("history" hist)
        def shown:string text
        if ((array_length pics) > 0) {
            def tag:string (SpWords.pick(lang "picture" "kuva"))
            if ((array_length pics) > 1) {
                tag = ((to_string (array_length pics)) + (SpWords.pick(lang " pictures" " kuvaa")))
            }
            shown = ("[" + tag + "]")
            if ((strlen text) > 0) {
                shown = (text + " [" + tag + "]")
            }
        }
        push asked ("@" + shown)
        sentText = text
        sentPics = pics
        sentTypes = picTypes
        sentNames = picNames
        push answers (SpWords.pick(lang "Reading…" "Luetaan…"))
        this.noneDone()
        if ((tab == "assistant") && (addOpen == false)) {
            reveal = "sp-chat"
        }
        this.queue("assist" (SpRemote.write(o)) (to_string ((array_length answers) - 1)))
        if addOpen {
            addAsked = ((array_length answers) - 1)
        }
        sentPurpose = purpose
        if (purpose == "question") {
            askAiAsked = ((array_length answers) - 1)
        }
        assistBusy = true
        fld.setValue("")
        def none:[string]
        pics = none
        def none2:[string]
        picTypes = none2
        def none3:[string]
        picNames = none3
    }

    ; What an answer did, from the server's answer: the entries it made or
    ; changed (shown once the space is read again), the titles of those it
    ; removed (read before the space is) and its other changes as words.
    fn readDone:void (row:string o:VlJson) {
        def k@(optional):int (to_int row)
        if (null? k) {
            return
        }
        def n:int (unwrap k)
        if ((n < 0) || (n >= (array_length doneIds))) {
            return
        }
        def ids:[string]
        def ev:VlJson (o.get("event_ids"))
        def i:int 0
        while (i < (ev.count())) {
            def id:string ((ev.at(i)).asString())
            if (((strlen id) > 0) && ((SpacesApp.inList(ids id)) == false)) {
                push ids id
            }
            i = (i + 1)
        }
        def gone:[string]
        def del:VlJson (o.get("deleted"))
        def d:int 0
        while (d < (del.count())) {
            def rid:string ((del.at(d)).asString())
            def found@(optional):SpEvent (space.byRemote(rid))
            if (!null? found) {
                def e:SpEvent found
                push gone e.title
            } {
                push gone (SpWords.pick(lang "An entry" "Merkintä"))
            }
            d = (d + 1)
        }
        def notes:[string]
        def calls:VlJson (o.get("calls"))
        def c:int 0
        while (c < (calls.count())) {
            def call:VlJson (calls.at(c))
            if (call.boolOr("ok" false)) {
                def w:string (this.toolDone((call.stringOr("tool" ""))))
                if (((strlen w) > 0) && ((SpacesApp.inList(notes w)) == false)) {
                    push notes w
                }
            }
            c = (c + 1)
        }
        set doneIds n (join ids " ")
        set doneGone n (join gone "\n")
        set doneNotes n (join notes "\n")
    }

    ; What a call that changes something other than an entry did, in words;
    ; "" for the entries' own calls (shown as cards) and for reading.
    fn toolDone:string (tool:string) {
        if ((tool == "set_ward") || (tool == "add_ward")) {
            return (SpWords.pick(lang "Family member's details saved" "Perheenjäsenen tiedot tallennettu"))
        }
        if (tool == "remove_ward") {
            return (SpWords.pick(lang "Family member removed" "Perheenjäsen poistettu"))
        }
        if (tool == "add_place") {
            return (SpWords.pick(lang "Place added" "Paikkakunta lisätty"))
        }
        if (tool == "remove_place") {
            return (SpWords.pick(lang "Place removed" "Paikkakunta poistettu"))
        }
        if (tool == "invite_member") {
            return (SpWords.pick(lang "Invitation sent" "Kutsu lähetetty"))
        }
        if (tool == "remove_member") {
            return (SpWords.pick(lang "Member removed" "Jäsen poistettu"))
        }
        if (tool == "set_space") {
            return (SpWords.pick(lang "Space settings saved" "Tilan asetukset tallennettu"))
        }
        return ""
    }

    ; The bottom of the element to scroll into view, once: -1 for none.
    fn takeReveal:double () {
        if ((strlen reveal) == 0) {
            return -1.0
        }
        def id:string reveal
        reveal = ""
        this.laidOut()
        def r:EVGElement (unwrap root)
        def el@(optional):EVGElement (UiTree.findById(r id))
        if (null? el) {
            return -1.0
        }
        def e:EVGElement (unwrap el)
        return (e.calculatedY + e.calculatedHeight)
    }

    ; The assistant's answer, in the row it was asked in.
    fn assistAnswered:void (row:string text:string ok:boolean) {
        assistBusy = false
        def k@(optional):int (to_int row)
        if (null? k) {
            return
        }
        def n:int (unwrap k)
        if ((n >= 0) && (n < (array_length answers))) {
            def t:string text
            if ((strlen t) == 0) {
                t = (SpWords.pick(lang "Done." "Valmis."))
            }
            if (ok == false) {
                ; a server older than the page has no assistant yet
                if (t == "No such call.") {
                    t = (SpWords.pick(lang "the assistant is not on the server yet; it comes with the server's next update. What you wrote is kept below." "avustaja ei ole vielä palvelimella, se tulee palvelimen seuraavassa päivityksessä. Kirjoittamasi teksti on tallessa alla."))
                }
                t = ((SpWords.pick(lang "That did not go through: " "Se ei mennyt läpi: ")) + t)
                ; what was written and the pictures are back in the field, to
                ; send again
                def back:InputCtl assistField
                if (sentPurpose == "question") {
                    back = askAiField
                }
                if (((strlen (trim back.value)) == 0) && ((array_length pics) == 0)) {
                    back.setValue(sentText)
                    pics = sentPics
                    picTypes = sentTypes
                    picNames = sentNames
                }
            }
            set answers n t
        }
    }

    ; =========================================================================
    ; entries: the Add menu, the form, deleting and Undo
    ; =========================================================================

    fn typeOf@(optional):SpType (id:string) {
        def tid:string id
        if ((strlen tid) == 0) {
            tid = "event"
        }
        return (types.find(tid))
    }

    fn typeName:string (id:string) {
        def t@(optional):SpType (this.typeOf(id))
        if (null? t) {
            return (SpWords.noun(lang pack "event"))
        }
        def tt:SpType t
        return (tt.name.text(lang))
    }

    fn kindOf:string (id:string) {
        return (types.kindOf(id))
    }

    ; "+ Add…" and, when open, the types of the space's words.
    fn addBar:EVGElement () {
        def bar:EVGElement (SpacesApp.box("sp-addbar"))
        def b:EVGElement (SpacesApp.btn("sp-add" "sp-action sp-action-primary" (SpWords.ui(lang "add"))))
        b.a11yExpanded = (SpacesApp.tri(addOpen))
        def row:EVGElement (SpacesApp.box("sp-row"))
        row.addChild(b)
        bar.addChild(row)
        if addOpen {
            bar.addChild((this.addMenu()))
        }
        return bar
    }

    ; Opening the Add menu starts it over: on a server the assistant is first
    ; and its field is focused, the types to pick by hand stay folded.
    fn toggleAdd:void () {
        addOpen = (addOpen == false)
        if (addOpen == false) {
            focused = ""
            return
        }
        addManual = false
        addGroup = ""
        addAsked = -1
        typeSearch.setValue("")
        if ((this.narrow()) == false) {
            if (this.addAssists()) {
                focused = "sp-assist-text"
            } {
                focused = "sp-addsearch"
            }
        }
    }

    ; The assistant can make the entries: a space on a server.
    fn addAssists:boolean () {
        return (server && ((strlen spaceId) > 0))
    }

    ; The Add menu. On a server the assistant comes first: what is written or
    ; pictured becomes entries. Below it, folded, the types to pick by hand;
    ; without a server only those.
    fn addMenu:EVGElement () {
        def menu:EVGElement (UiTree.div("sp-addmenu" "sp-addmenu"))
        menu.role = "group"
        menu.a11yLabel = (SpWords.ui(lang "add"))
        if (this.addAssists()) {
            def lead:EVGElement (SpacesApp.tx("sp-addgroup-name" (SpWords.pick(lang "Tell the assistant: write or paste a letter, a timetable or an invitation, or add a picture, and it makes the entries" "Kerro avustajalle: kirjoita tai liitä tiedote, aikataulu tai kutsu, tai lisää kuva, niin se tekee merkinnät"))))
            UiTree.inline(lead "width" (SpacesApp.px(((this.mainW()) - 40.0))))
            menu.addChild(lead)
            menu.addChild((this.assistInput()))
            if ((addAsked >= 0) && (addAsked < (array_length answers))) {
                def w:double ((this.mainW()) - 60.0)
                def a:EVGElement (this.markdown("sp-add-answer" (itemAt answers addAsked) w))
                UiTree.addClass(a "sp-bubble-a")
                menu.addChild(a)
                def cards@(optional):EVGElement (this.doneCards(addAsked w))
                if (!null? cards) {
                    menu.addChild((unwrap cards))
                }
            }
            menu.addChild((this.addHelp()))
            def mark:string "▸ "
            if addManual {
                mark = "▾ "
            }
            def mb:EVGElement (SpacesApp.btn("sp-add-manual" "sp-chip" (mark + (SpWords.pick(lang "Add by hand" "Lisää käsin")))))
            mb.a11yLabel = (SpWords.pick(lang "Add by hand" "Lisää käsin"))
            mb.a11yExpanded = (SpacesApp.tri(addManual))
            def mrow:EVGElement (SpacesApp.box("sp-row"))
            mrow.addChild(mb)
            menu.addChild(mrow)
            if (addManual == false) {
                return menu
            }
        }
        menu.addChild((this.typePicker()))
        return menu
    }

    ; The types the Add menu offers: on the lists page those kept on lists.
    fn addTypes:[SpType] () {
        if (tab == "lists") {
            return (types.listedFor(pack))
        }
        return (types.forPack(pack))
    }

    ; A type's group as the menu groups it: an unknown one with the first.
    sfn groupOf:string (t:SpType) {
        if (SpacesApp.knownGroup(t.group)) {
            return t.group
        }
        def all:[string] (SpTypes.groups())
        return (itemAt all 0)
    }

    ; The types the search or the group picked shows. A pack of a few types
    ; shows them all; of many, none until something is searched or picked.
    fn addMatches:[SpType] () {
        def res:[SpType]
        def list:[SpType] (this.addTypes())
        def q:string (to_lowercase (trim typeSearch.value))
        def many:boolean ((array_length list) > 12)
        if (many && (((strlen q) == 0) && ((strlen addGroup) == 0))) {
            return res
        }
        def i:int 0
        while (i < (array_length list)) {
            def t:SpType (itemAt list i)
            def g:string (SpacesApp.groupOf(t))
            def ok:boolean true
            if ((strlen q) > 0) {
                def hay:string (to_lowercase ((t.name.en) + " " + (t.name.fi) + " " + (SpWords.groupName(lang g))))
                ok = ((indexOf hay q) >= 0)
            } {
                if ((strlen addGroup) > 0) {
                    ok = (g == addGroup)
                }
            }
            if ok {
                push res t
            }
            i = (i + 1)
        }
        return res
    }

    ; Picking a type by hand: a search, the groups to browse, and the types
    ; found. Enter in the search opens the first.
    fn typePicker:EVGElement () {
        def box:EVGElement (SpacesApp.box("sp-addpick"))
        def fr:EVGElement (this.field(typeSearch "sp-addsearch" (SpWords.pick(lang "Search for a type" "Hae tyyppiä")) (SpWords.pick(lang "E.g. invitation, doctor, bill" "Esim. kutsu, lääkäri, lasku")) "text"))
        if ((this.narrow()) == false) {
            UiTree.inline(fr "width" "320px")
        }
        box.addChild(fr)
        def list:[SpType] (this.addTypes())
        def q:string (trim typeSearch.value)
        def many:boolean ((array_length list) > 12)
        if (many && ((strlen q) == 0)) {
            def grow:EVGElement (SpacesApp.box("sp-addgroup"))
            grow.role = "group"
            grow.a11yLabel = (SpWords.pick(lang "Groups" "Ryhmät"))
            def groups:[string] (SpTypes.groups())
            def g:int 0
            while (g < (array_length groups)) {
                def gid:string (itemAt groups g)
                def n:int 0
                def i:int 0
                while (i < (array_length list)) {
                    def t:SpType (itemAt list i)
                    if ((SpacesApp.groupOf(t)) == gid) {
                        n = (n + 1)
                    }
                    i = (i + 1)
                }
                if (n > 0) {
                    def on:boolean (gid == addGroup)
                    def cls:string "sp-chip"
                    if on {
                        cls = "sp-chip sp-chip-on"
                    }
                    def gb:EVGElement (SpacesApp.btn(("sp-addgrp-" + gid) cls (SpWords.groupName(lang gid))))
                    gb.a11yPressed = (SpacesApp.tri(on))
                    grow.addChild(gb)
                }
                g = (g + 1)
            }
            box.addChild(grow)
        }
        def hits:[SpType] (this.addMatches())
        if ((array_length hits) == 0) {
            def msg:string (SpWords.pick(lang "Nothing found" "Ei osumia"))
            if ((strlen q) == 0) {
                msg = ((SpWords.pick(lang "Search or pick a group: " "Hae tai valitse ryhmä: ")) + (to_string (array_length list)) + (SpWords.pick(lang " types" " tyyppiä")))
            }
            box.addChild((SpacesApp.tx("sp-cardsub" msg)))
            return box
        }
        def row:EVGElement (SpacesApp.box("sp-addgroup"))
        row.role = "menu"
        row.a11yLabel = (SpWords.ui(lang "add"))
        def k:int 0
        while (k < (array_length hits)) {
            def t2:SpType (itemAt hits k)
            def it:EVGElement (SpacesApp.btn(("sp-addtype-" + t2.id) "sp-chip" (t2.name.text(lang))))
            it.role = "menuitem"
            row.addChild(it)
            k = (k + 1)
        }
        box.addChild(row)
        return box
    }

    sfn knownGroup:boolean (g:string) {
        def all:[string] (SpTypes.groups())
        def i:int 0
        while (i < (array_length all)) {
            if ((itemAt all i) == g) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; The occurrence a press or the focus is on: a calendar event (its box,
    ; chip, agenda row or all-day bar), a summary row or a list row. "" for
    ; none.
    fn occOfTarget:string (target:string) {
        if (UiTree.beginsWith(target "sp-item-")) {
            def n@(optional):int (to_int (substring target 8 (strlen target)))
            if (!null? n) {
                def k:int (unwrap n)
                if ((k >= 0) && (k < (array_length itemOccs))) {
                    return (itemAt itemOccs k)
                }
            }
            return ""
        }
        if (UiTree.beginsWith(target "sp-entry-")) {
            return (substring target 9 (strlen target))
        }
        def prefixes:[string] ([] _:string ( "spc-ev-" "spc-rz-" "spc-chip-" "spc-ag-" "spc-band-" ))
        def i:int 0
        while (i < (array_length prefixes)) {
            def pf:string (itemAt prefixes i)
            if (UiTree.beginsWith(target pf)) {
                def rest:string (substring target (strlen pf) (strlen target))
                def dash:int (indexOf rest "-")
                if (dash > 0) {
                    rest = (substring rest 0 dash)
                }
                def k2:int (this.boardIndex(rest))
                if (k2 >= 0) {
                    return (itemAt occIds k2)
                }
                return ""
            }
            i = (i + 1)
        }
        return ""
    }

    fn selectedOcc:string () {
        return (this.occOfTarget(focused))
    }

    ; A double-click at a point: the event under it opens in the form.
    fn openAt:boolean (x:double y:double) {
        def id0:string (this.hitId(x y))
        def id:string id0
        if (this.onBoard(id0)) {
            id = (board.refine(id0 x y))
        }
        def occ:string (this.occOfTarget(id))
        if ((strlen occ) == 0) {
            return false
        }
        def r:boolean (this.openOcc(occ))
        this.rebuild()
        return r
    }

    ; The event of an occurrence in the form; a sheet's row is the sheet's.
    fn openOcc:boolean (occ:string) {
        def id:string (space.eventIdOf(occ))
        if ((strlen id) == 0) {
            status = (SpWords.pick(lang "Rows from a sheet are changed in the sheet" "Taulukon rivit muutetaan taulukossa"))
            return false
        }
        def found@(optional):SpEvent (space.event(id))
        if (null? found) {
            return false
        }
        def e:SpEvent found
        editId = id
        editOcc = (SpSpace.occDayOf(occ))
        editType = e.typeId
        this.fillForm(e)
        return true
    }

    ; A new entry of a type: on the calendar's day (or today), a record
    ; without one.
    fn openNew:void (typeId:string) {
        def tid:string typeId
        if (tid == "event") {
            tid = ""
        }
        ; added on the lists page, its list is the one shown
        if (tab == "lists") {
            listType = typeId
        }
        def e (new SpEvent())
        e.typeId = tid
        e.day = today
        if ((tab == "calendar") && (board.cursor > 0)) {
            e.day = board.cursor
        }
        def kind:string (this.kindOf(tid))
        if (kind == "record") {
            e.day = -1
        }
        if (kind == "event") {
            e.startMin = 720
            e.endMin = 780
        }
        e.endDay = e.day
        editId = ""
        editOcc = -1
        editType = tid
        this.fillForm(e)
    }

    fn addText:void (key:string value:string) {
        def c (new InputCtl())
        c.setValue(value)
        push formKeys key
        push formCtls c
    }

    fn addPick:void (key:string value:string) {
        push pickKeys key
        push pickVals value
    }

    ; The form, filled from an event (a new one is not in the space yet).
    fn fillForm:void (e:SpEvent) {
        def k:[string]
        formKeys = k
        def c:[InputCtl]
        formCtls = c
        def pk:[string]
        pickKeys = pk
        def pv:[string]
        pickVals = pv
        formErr = ""
        dateOpen = -1
        addOpen = false
        askKind = ""
        editing = true
        focused = ""
        def kind:string (this.kindOf(e.typeId))
        this.addText("title" e.title)
        def dateText:string ""
        if (e.dated()) {
            dateText = (UiDate.isoOfDays(e.day))
        }
        this.addText("date" dateText)
        if (kind == "event") {
            def endText:string ""
            if ((e.endDay > e.day) && (e.dated())) {
                endText = (UiDate.isoOfDays(e.endDay))
            }
            this.addText("end_date" endText)
            this.addText("start" (SpSpace.timeText(e.startMin)))
            this.addText("end" (SpSpace.timeText(e.endMin)))
        }
        if ((array_length space.resources) > 0) {
            this.addPick("ward" e.resource)
        }
        if (kind != "record") {
            this.addText("who" (SpWho.listText(e.who)))
        }
        if (kind == "event") {
            this.addText("place" e.place)
            def tp@(optional):SpType (this.typeOf(e.typeId))
            def repeatable:boolean (e.repeats())
            if (!null? tp) {
                def tt:SpType tp
                if tt.repeats {
                    repeatable = true
                }
            }
            if repeatable {
                this.addPick("repeat" e.rule.freq)
                def untilText:string ""
                if (e.rule.until > 0) {
                    untilText = (UiDate.isoOfDays(e.rule.until))
                }
                this.addText("until" untilText)
            }
        }
        def t@(optional):SpType (this.typeOf(e.typeId))
        formCost = e.hasCost
        if (!null? t) {
            def ty:SpType t
            if ty.hasCost {
                formCost = true
            }
            def i:int 0
            while (i < (array_length ty.fields)) {
                def f:SpField (itemAt ty.fields i)
                if (f.picked()) {
                    this.addPick(("f:" + f.key) (e.fieldText(f.key)))
                } {
                    def ft:string (e.fieldText(f.key))
                    if (f.type == "weektimes") {
                        def wk:SpWeek (SpWeek.read(ft))
                        if wk.ok {
                            ft = (wk.shown(lang))
                        }
                    }
                    this.addText(("f:" + f.key) ft)
                }
                i = (i + 1)
            }
        }
        this.addText("notes" e.notes)
        if (kind != "record") {
            def imp:string "false"
            if e.important {
                imp = "true"
            }
            this.addPick("important" imp)
            this.addPick("color" e.color)
        }
        if formCost {
            def amount:string ""
            def payer:string ""
            def inst:string ""
            def first:string ""
            def every:string ""
            def remind:string ""
            if e.hasCost {
                amount = (SpTypes.numText(e.cost.amount))
                payer = e.cost.payer
                inst = (to_string e.cost.instalments)
                if (e.cost.first >= 0) {
                    first = (UiDate.isoOfDays(e.cost.first))
                }
                every = (to_string e.cost.everyMonths)
                if (e.cost.remindDays >= 0) {
                    remind = (to_string e.cost.remindDays)
                }
            }
            this.addText("cost:amount" amount)
            this.addText("cost:payer" payer)
            this.addText("cost:instalments" inst)
            this.addText("cost:first" first)
            this.addText("cost:every" every)
            this.addText("cost:remind" remind)
        }
        ; when to get it, and what it is reckoned to cost and did, in whose
        ; budget (the common fields)
        this.addText("get:from" (e.fieldText("get_from")))
        this.addText("get:by" (e.fieldText("get_by")))
        this.addText("budget:min" (e.fieldText("estimated_cost_min")))
        this.addText("budget:max" (e.fieldText("estimated_cost_max")))
        this.addText("budget:actual" (e.fieldText("actual_cost")))
        def scope:string (e.fieldText("budget_scope"))
        if (((strlen scope) == 0) && e.hasCost) {
            scope = e.cost.scope
        }
        if (scope != "personal") {
            scope = "shared"
        }
        this.addPick("budget:scope" scope)
        def owner:string (e.fieldText("budget_owner"))
        if ((((strlen owner) == 0) && e.hasCost) && (scope == "personal")) {
            owner = e.cost.payer
        }
        this.addText("budget:owner" owner)
        ; a deadline's days to do it on, one calendar each
        if (kind == "deadline") {
            def plan:[int] (space.plannedDays(e))
            def pi:int 0
            while (pi < (array_length plan)) {
                this.addText(("plan:" + (to_string pi)) (UiDate.isoOfDays((itemAt plan pi))))
                pi = (pi + 1)
            }
            if ((array_length plan) == 0) {
                this.addText("plan:0" "")
            }
        }
    }

    ; The form's planned days ("plan:0", "plan:1"…), in the order made.
    fn planKeys:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length formKeys)) {
            if (UiTree.beginsWith((itemAt formKeys i) "plan:")) {
                push out (itemAt formKeys i)
            }
            i = (i + 1)
        }
        return out
    }

    ; The common fields the form's get: and budget: keys keep, and the kind
    ; of value each is.
    sfn commonKeys:[string] () {
        return ([] _:string ( "get:from" "get:by" "budget:min" "budget:max" "budget:actual" "budget:scope" "budget:owner" ))
    }

    sfn commonField:string (key:string) {
        if (key == "get:from") {
            return "get_from"
        }
        if (key == "get:by") {
            return "get_by"
        }
        if (key == "budget:min") {
            return "estimated_cost_min"
        }
        if (key == "budget:max") {
            return "estimated_cost_max"
        }
        if (key == "budget:actual") {
            return "actual_cost"
        }
        if (key == "budget:scope") {
            return "budget_scope"
        }
        return "budget_owner"
    }

    sfn commonType:string (key:string) {
        if (UiTree.beginsWith(key "get:")) {
            return "date"
        }
        if (((key == "budget:min") || (key == "budget:max")) || (key == "budget:actual")) {
            return "money"
        }
        if (key == "budget:scope") {
            return "choice"
        }
        return "person"
    }

    fn formText:string (key:string) {
        def i:int 0
        while (i < (array_length formKeys)) {
            if ((itemAt formKeys i) == key) {
                def c:InputCtl (itemAt formCtls i)
                return (trim c.value)
            }
            i = (i + 1)
        }
        return ""
    }

    fn hasText:boolean (key:string) {
        def i:int 0
        while (i < (array_length formKeys)) {
            if ((itemAt formKeys i) == key) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn pickOf:string (key:string) {
        def i:int 0
        while (i < (array_length pickKeys)) {
            if ((itemAt pickKeys i) == key) {
                return (itemAt pickVals i)
            }
            i = (i + 1)
        }
        return ""
    }

    fn hasPick:boolean (key:string) {
        def i:int 0
        while (i < (array_length pickKeys)) {
            if ((itemAt pickKeys i) == key) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn editField@(optional):SpField (key:string) {
        def none@(optional):SpField
        if ((UiTree.beginsWith(key "f:")) == false) {
            return none
        }
        def t@(optional):SpType (this.typeOf(editType))
        if (null? t) {
            return none
        }
        def tt:SpType t
        return (tt.field((substring key 2 (strlen key))))
    }

    ; A form key's label.
    fn formLabel:string (key:string) {
        if (((strlen askKind) > 0) && (editing == false)) {
            if (key == "title") {
                return (SpWords.pick(lang "The question in your own words (optional)" "Kysymys omin sanoin (vapaaehtoinen)"))
            }
            if (key == "notes") {
                return (SpWords.pick(lang "More for the one asked" "Lisätietoa kysyttävälle"))
            }
        }
        def f@(optional):SpField (this.editField(key))
        if (!null? f) {
            def ff:SpField f
            return (ff.label(lang))
        }
        if (key == "ward") {
            return (SpWords.noun(lang pack "resource"))
        }
        if (key == "place") {
            return (SpWords.noun(lang pack "place"))
        }
        if (UiTree.beginsWith(key "plan:")) {
            return (SpWords.pick(lang "Planned day" "Suunniteltu päivä"))
        }
        if (key == "date") {
            def kind:string (this.kindOf(editType))
            if (kind == "deadline") {
                return (SpWords.ui(lang "dueDate"))
            }
            if (kind == "record") {
                return (SpWords.ui(lang "dateOptional"))
            }
        }
        if (key == "cost:amount") {
            def t@(optional):SpType (this.typeOf(editType))
            if (!null? t) {
                def tt:SpType t
                if tt.hasCost {
                    return (tt.cost.text(lang) + " (€)")
                }
            }
        }
        return (SpWords.ui(lang key))
    }

    ; A form key that holds a day: the form's own dates, the common fields'
    ; and every field the types call "date". Each is a calendar, never a text
    ; field (`dateField`); app-check walks every type to hold that.
    fn isDateKey:boolean (key:string) {
        if (((key == "date") || (key == "end_date")) || ((key == "until") || (key == "cost:first"))) {
            return true
        }
        if (UiTree.beginsWith(key "plan:")) {
            return true
        }
        if ((SpacesApp.isCommonKey(key)) && ((SpacesApp.commonType(key)) == "date")) {
            return true
        }
        def f@(optional):SpField (this.editField(key))
        if (!null? f) {
            def ff:SpField f
            return (ff.type == "date")
        }
        return false
    }

    sfn isCommonKey:boolean (key:string) {
        def keys:[string] (SpacesApp.commonKeys())
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == key) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; What a text field expects.
    fn formHint:string (key:string) {
        if (((strlen askKind) > 0) && (editing == false)) {
            if (key == "title") {
                return (SpWords.pick(lang "Made from the rest when left empty" "Muodostetaan muista tiedoista, jos tyhjä"))
            }
            if (key == "f:options") {
                return (SpWords.pick(lang "E.g. Sat 10:00; Sun 12:00" "Esim. la klo 10; su klo 12"))
            }
            if (key == "f:what") {
                return (SpWords.pick(lang "E.g. winter shoes, the school, the swimming hall" "Esim. talvikengät, koulu, uimahalli"))
            }
        }
        def f@(optional):SpField (this.editField(key))
        def type:string "text"
        if (!null? f) {
            def ff:SpField f
            type = ff.type
        }
        if (this.isDateKey(key)) {
            return (SpWords.pick(lang "Choose a day" "Valitse päivä"))
        }
        if (((key == "start") || (key == "end")) || (type == "time")) {
            return (SpWords.pick(lang "HH:MM" "hh.mm"))
        }
        if (key == "who") {
            return (SpWords.ui(lang "whoHint"))
        }
        if (type == "weektimes") {
            return (SpWords.pick(lang "Mon 8:15–13:00; Tue 9:00–14:15" "ma 8.15–13.00; ti 9.00–14.15"))
        }
        if (((type == "money") || (key == "cost:amount")) || ((SpacesApp.commonType(key)) == "money")) {
            return "0,00 €"
        }
        if (key == "cost:remind") {
            return "3"
        }
        if (key == "cost:instalments") {
            return "1"
        }
        if (key == "cost:every") {
            return "1"
        }
        return ""
    }

    ; The buttons a picked key chooses from: values, "" for none.
    fn pickOptions:[string] (key:string) {
        def out:[string]
        if (key == "ward") {
            push out ""
            def i:int 0
            while (i < (array_length space.resources)) {
                def r:SpResource (itemAt space.resources i)
                push out r.id
                i = (i + 1)
            }
            return out
        }
        if (key == "repeat") {
            return ([] _:string ( "" "daily" "weekly" "monthly" ))
        }
        if (key == "color") {
            def cs:[string] ([] _:string ( "" ))
            def pal:[string] (SpSpace.palette())
            def ci:int 0
            while (ci < (array_length pal)) {
                push cs (itemAt pal ci)
                ci = (ci + 1)
            }
            return cs
        }
        if (key == "cost:scope") {
            return ([] _:string ( "personal" "shared" ))
        }
        if (key == "budget:scope") {
            return ([] _:string ( "shared" "personal" ))
        }
        if (key == "f:ask_to") {
            return (this.askable())
        }
        def f@(optional):SpField (this.editField(key))
        if (!null? f) {
            def ff:SpField f
            if (ff.type == "ward") {
                push out ""
                def k:int 0
                while (k < (array_length space.resources)) {
                    def r2:SpResource (itemAt space.resources k)
                    push out r2.id
                    k = (k + 1)
                }
                return out
            }
            if (ff.type == "choice") {
                return ff.options
            }
        }
        return out
    }

    ; A switch rather than a choice.
    fn pickIsSwitch:boolean (key:string) {
        if (key == "important") {
            return true
        }
        def f@(optional):SpField (this.editField(key))
        if (!null? f) {
            def ff:SpField f
            return (ff.type == "bool")
        }
        return false
    }

    fn optionLabel:string (key:string v:string) {
        if ((strlen v) == 0) {
            if (key == "repeat") {
                return (SpWords.ui(lang "once"))
            }
            if (key == "color") {
                return (SpWords.ui(lang "colorDefault"))
            }
            return (SpWords.ui(lang "none"))
        }
        if (key == "ward") {
            return (space.resourceName(v))
        }
        if (((key == "repeat") || (key == "cost:scope")) || (key == "budget:scope")) {
            return (SpWords.ui(lang v))
        }
        if (key == "color") {
            return (SpWords.ui(lang ("color:" + v)))
        }
        def f@(optional):SpField (this.editField(key))
        if (!null? f) {
            def ff:SpField f
            if (ff.type == "ward") {
                return (space.resourceName(v))
            }
            return (ff.optionLabel(lang v))
        }
        return v
    }

    ; --- the form ----------------------------------------------------------------------

    fn formW:double () {
        return ((this.mainW()) - 38.0)
    }

    ; One labelled text field of the form.
    fn textField:EVGElement (i:int) {
        def key:string (itemAt formKeys i)
        if (this.isDateKey(key)) {
            return (this.dateField(i))
        }
        def c:InputCtl (itemAt formCtls i)
        def label:string (this.formLabel(key))
        def wide:boolean ((((key == "title") || (key == "notes")) || (key == "who")) || (key == "place"))
        def f@(optional):SpField (this.editField(key))
        if (!null? f) {
            def ff:SpField f
            if (((ff.type == "longtext") || (ff.type == "text")) || (ff.type == "weektimes")) {
                wide = true
            }
        }
        def w:double 200.0
        if (wide || (this.narrow())) {
            w = (this.formW())
        }
        def box:EVGElement (SpacesApp.box("sp-fld"))
        def lb:EVGElement (SpacesApp.tx("sp-fldlabel" label))
        lb.a11yHidden = true
        box.addChild(lb)
        def kind:string "text"
        if (key == "cost:payer") {
            kind = "text"
        }
        def fr:EVGElement (this.field(c ("sp-ed-" + (to_string i)) label (this.formHint(key)) kind))
        UiTree.inline(fr "width" (SpacesApp.px(w)))
        box.addChild(fr)
        UiTree.inline(box "width" (SpacesApp.px(w)))
        return box
    }

    ; A day as the button shows it: "la 17.10.2026", "Sat 2026-10-17"; the
    ; text as it is when it does not read as a day.
    fn dateShown:string (v:string) {
        def year:int (itemAt (SpSpace.ymdOf(today)) 0)
        def d:int (SpTypes.dayOf(v year))
        if (d < 0) {
            return v
        }
        def p:[int] (SpSpace.ymdOf(d))
        def wd:string (EcI18n.dayShort(lang (UiDate.weekday(d))))
        if (lang == "fi") {
            return ((((((wd + " ") + (to_string (itemAt p 2))) + ".") + (to_string (itemAt p 1))) + ".") + (to_string (itemAt p 0)))
        }
        return ((wd + " ") + (UiDate.isoOfDays(d)))
    }

    ; One labelled date: a button with the day on it, and while it is open
    ; EVGUI's calendar under it with Today and Clear.
    fn dateField:EVGElement (i:int) {
        def key:string (itemAt formKeys i)
        def c:InputCtl (itemAt formCtls i)
        def label:string (this.formLabel(key))
        def w:double 200.0
        if (this.narrow()) {
            w = (this.formW())
        }
        def open:boolean (dateOpen == i)
        def bw:double w
        if open {
            if (w < 300.0) {
                w = 300.0
            }
        }
        def box:EVGElement (SpacesApp.box("sp-fld"))
        UiTree.inline(box "width" (SpacesApp.px(w)))
        def lb:EVGElement (SpacesApp.tx("sp-fldlabel" label))
        lb.a11yHidden = true
        box.addChild(lb)
        def v:string (trim c.value)
        def shown:string (this.dateShown(v))
        def cls:string "sp-datebtn"
        if ((strlen v) == 0) {
            shown = (this.formHint(key))
            cls = "sp-datebtn sp-datebtn-empty"
        }
        if open {
            cls = (cls + " sp-datebtn-open")
        }
        def b:EVGElement (SpacesApp.btn(("sp-date-" + (to_string i)) cls ("📅 " + shown)))
        b.a11yLabel = ((label + ", ") + shown)
        b.a11yHasPopup = "dialog"
        b.a11yExpanded = (SpacesApp.tri(open))
        UiTree.inline(b "width" (SpacesApp.px(bw)))
        box.addChild(b)
        if open {
            UiTree.dress(datePick)
            def cal:EVGElement (unwrap datePick.rootEl)
            cal.a11yLabel = label
            box.addChild(cal)
            def row:EVGElement (SpacesApp.box("sp-formrow"))
            row.addChild((SpacesApp.btn("sp-dp-today" "sp-opt" (SpWords.pick(lang "Today" "Tänään")))))
            if ((strlen v) > 0) {
                row.addChild((SpacesApp.btn("sp-dp-clear" "sp-opt" (SpWords.pick(lang "Clear" "Tyhjennä")))))
            }
            box.addChild(row)
        }
        return box
    }

    ; Open the calendar of form index `i` on its day, or on today.
    fn openDate:void (i:int) {
        dateOpen = i
        def c:InputCtl (itemAt formCtls i)
        def p:[int] (SpSpace.ymdOf(today))
        def pick (new CalendarCtl())
        pick.tid = "sp-dp"
        pick.name = (this.formLabel((itemAt formKeys i)))
        if (lang == "fi") {
            pick.lang = "fi"
        }
        pick.weekStart = 1
        pick.setToday((itemAt p 0) (itemAt p 1) (itemAt p 2))
        pick.setMonth((itemAt p 0) (itemAt p 1))
        pick.startYear = ((itemAt p 0) - 15)
        pick.endYear = ((itemAt p 0) + 10)
        def d:int (SpTypes.dayOf((trim c.value) (itemAt p 0)))
        if (d >= 0) {
            def q:[int] (SpSpace.ymdOf(d))
            pick.setSelected((itemAt q 0) (itemAt q 1) (itemAt q 2))
            pick.setMonth((itemAt q 0) (itemAt q 1))
            if ((itemAt q 0) < pick.startYear) {
                pick.startYear = (itemAt q 0)
            }
            if ((itemAt q 0) > pick.endYear) {
                pick.endYear = (itemAt q 0)
            }
        }
        if (pick.startYear < 1970) {
            pick.startYear = 1970
        }
        datePick = pick
        focused = (pick.dayTid((pick.currentFocusDay())))
    }

    ; The open calendar's day `d` goes into its field, and the calendar closes.
    fn putDate:void (d:int) {
        if ((dateOpen < 0) || (dateOpen >= (array_length formCtls))) {
            dateOpen = -1
            return
        }
        def c:InputCtl (itemAt formCtls dateOpen)
        if (d < 0) {
            c.setValue("")
        } {
            c.setValue((UiDate.isoOfDays(d)))
        }
        focused = ("sp-date-" + (to_string dateOpen))
        dateOpen = -1
    }

    ; A press on a date button or in its calendar.
    fn pressDate:boolean (target:string) {
        if (UiTree.beginsWith(target "sp-date-")) {
            def n@(optional):int (to_int (substring target 8 (strlen target)))
            if (!null? n) {
                def k:int (unwrap n)
                if (k == dateOpen) {
                    dateOpen = -1
                } {
                    if ((k >= 0) && (k < (array_length formCtls))) {
                        this.openDate(k)
                    }
                }
            }
            return true
        }
        if (dateOpen < 0) {
            return false
        }
        if (target == "sp-dp-today") {
            this.putDate(today)
            return true
        }
        if (target == "sp-dp-clear") {
            this.putDate(-1)
            return true
        }
        if (UiTree.beginsWith(target "sp-dp")) {
            ; a day is chosen even when it is the one already chosen: the
            ; calendar's own second click clears, which a form does not want
            def day:int (datePick.dayOfTid(target))
            if (day >= 0) {
                if ((datePick.isDisabledDay(day)) == false) {
                    this.putDate(day)
                }
                return true
            }
            datePick.activate(target)
            return true
        }
        return false
    }

    ; One labelled row of buttons (a choice) or a switch.
    fn pickField:EVGElement (i:int) {
        def key:string (itemAt pickKeys i)
        def val:string (itemAt pickVals i)
        def label:string (this.formLabel(key))
        def box:EVGElement (SpacesApp.box("sp-fld"))
        UiTree.inline(box "width" (SpacesApp.px((this.formW()))))
        if (this.pickIsSwitch(key)) {
            def on:boolean (val == "true")
            def cls:string "sp-opt"
            if on {
                cls = "sp-opt sp-opt-on"
            }
            def mark:string "○ "
            if on {
                mark = "● "
            }
            def sw:EVGElement (SpacesApp.btn(("sp-tog-" + (to_string i)) cls (mark + label)))
            sw.role = "switch"
            sw.a11yLabel = label
            sw.a11yChecked = (SpacesApp.tri(on))
            def row0:EVGElement (SpacesApp.box("sp-formrow"))
            row0.addChild(sw)
            box.addChild(row0)
            return box
        }
        def lb:EVGElement (SpacesApp.tx("sp-fldlabel" label))
        lb.a11yHidden = true
        box.addChild(lb)
        def row:EVGElement (UiTree.div(("sp-pickrow-" + (to_string i)) "sp-formrow"))
        row.role = "group"
        row.a11yLabel = label
        def opts:[string] (this.pickOptions(key))
        def k:int 0
        while (k < (array_length opts)) {
            def o:string (itemAt opts k)
            def on2:boolean (o == val)
            def pc:string "sp-opt"
            if on2 {
                pc = "sp-opt sp-opt-on"
            }
            def pb:EVGElement (SpacesApp.btn(("sp-pick-" + (to_string i) + "-" + (to_string k)) pc (this.optionLabel(key o))))
            if ((key == "color") && ((strlen o) > 0)) {
                pb = (SpacesApp.swatchBtn(("sp-pick-" + (to_string i) + "-" + (to_string k)) pc o (this.optionLabel(key o))))
            }
            pb.a11yPressed = (SpacesApp.tri(on2))
            row.addChild(pb)
            k = (k + 1)
        }
        box.addChild(row)
        return box
    }

    fn textIndex:int (key:string) {
        def i:int 0
        while (i < (array_length formKeys)) {
            if ((itemAt formKeys i) == key) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn pickIndex:int (key:string) {
        def i:int 0
        while (i < (array_length pickKeys)) {
            if ((itemAt pickKeys i) == key) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; The fields whose keys start with `prefix` ("" for the entry's own,
    ; "f:" for the type's, "cost:" for the cost), in the order they were
    ; made, into `into`.
    fn addFields:void (into:EVGElement prefix:string) {
        def keys:[string] (this.formOrder())
        def j:int 0
        while (j < (array_length keys)) {
            def key:string (itemAt keys j)
            def mine:boolean false
            if (prefix == "") {
                mine = ((((UiTree.beginsWith(key "f:")) == false) && ((UiTree.beginsWith(key "cost:")) == false)) && (((UiTree.beginsWith(key "get:")) == false) && ((UiTree.beginsWith(key "budget:")) == false)))
                if (UiTree.beginsWith(key "plan:")) {
                    mine = false
                }
            } {
                mine = (UiTree.beginsWith(key prefix))
            }
            if mine {
                def ti:int (this.textIndex(key))
                if (ti >= 0) {
                    into.addChild((this.textField(ti)))
                } {
                    def pi:int (this.pickIndex(key))
                    if (pi >= 0) {
                        into.addChild((this.pickField(pi)))
                    }
                }
            }
            j = (j + 1)
        }
    }

    ; Every key of the form in the order it is shown.
    fn formOrder:[string] () {
        def out:[string]
        def own:[string] ([] _:string ( "title" "ward" "date" "end_date" "start" "end" "repeat" "until" "who" "place" "important" "color" ))
        def i:int 0
        while (i < (array_length own)) {
            def key:string (itemAt own i)
            if ((this.hasText(key)) || (this.hasPick(key))) {
                push out key
            }
            i = (i + 1)
        }
        def t@(optional):SpType (this.typeOf(editType))
        if (!null? t) {
            def tt:SpType t
            def k:int 0
            while (k < (array_length tt.fields)) {
                def f:SpField (itemAt tt.fields k)
                push out ("f:" + f.key)
                k = (k + 1)
            }
        }
        def plans:[string] (this.planKeys())
        def pk:int 0
        while (pk < (array_length plans)) {
            push out (itemAt plans pk)
            pk = (pk + 1)
        }
        push out "notes"
        def cost:[string] ([] _:string ( "cost:amount" "cost:payer" "cost:instalments" "cost:first" "cost:every" "cost:remind" "get:from" "get:by" "budget:min" "budget:max" "budget:actual" "budget:scope" "budget:owner" ))
        def c:int 0
        while (c < (array_length cost)) {
            def ck:string (itemAt cost c)
            if ((this.hasText(ck)) || (this.hasPick(ck))) {
                push out ck
            }
            c = (c + 1)
        }
        return out
    }

    fn editorView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        def name:string (this.typeName(editType))
        def title:string name
        if ((strlen editId) == 0) {
            title = ((SpWords.ui(lang "new")) + ": " + name)
        }
        def help:string ""
        def t@(optional):SpType (this.typeOf(editType))
        if (!null? t) {
            def tt:SpType t
            help = (tt.help.text(lang))
        }
        v.addChild((this.heading(title help)))
        def c:EVGElement (UiTree.div("sp-card-editor" "sp-card"))
        c.role = "form"
        c.a11yLabel = title
        if ((strlen formErr) > 0) {
            def er:EVGElement (UiTree.label("sp-formerr" "sp-formerr" formErr))
            er.role = "alert"
            c.addChild(er)
        }
        def own:EVGElement (SpacesApp.box("sp-form"))
        this.addFields(own "")
        c.addChild(own)
        if ((array_length (this.typeFieldKeys())) > 0) {
            c.addChild((SpacesApp.tx("sp-formhead" (SpWords.ui(lang "details")))))
            def more:EVGElement (SpacesApp.box("sp-form"))
            this.addFields(more "f:")
            c.addChild(more)
        }
        if ((array_length (this.planKeys())) > 0) {
            c.addChild((SpacesApp.tx("sp-formhead" (SpWords.pick(lang "Planned days" "Suunnitellut päivät")))))
            def plans:EVGElement (SpacesApp.box("sp-form"))
            this.addFields(plans "plan:")
            plans.addChild((SpacesApp.btn("sp-plan-add" "sp-opt" (SpWords.pick(lang "+ Add a day" "+ Lisää päivä")))))
            c.addChild(plans)
        }
        c.addChild((SpacesApp.tx("sp-formhead" (SpWords.ui(lang "getHead")))))
        def gets:EVGElement (SpacesApp.box("sp-form"))
        this.addFields(gets "get:")
        c.addChild(gets)
        c.addChild((SpacesApp.tx("sp-formhead" (SpWords.ui(lang "budgetHead")))))
        def budget:EVGElement (SpacesApp.box("sp-form"))
        this.addFields(budget "budget:")
        c.addChild(budget)
        if formCost {
            c.addChild((SpacesApp.tx("sp-formhead" (SpWords.ui(lang "cost")))))
            def cost:EVGElement (SpacesApp.box("sp-form"))
            this.addFields(cost "cost:")
            c.addChild(cost)
        }
        this.addLinks(c)
        def bar:EVGElement (SpacesApp.box("sp-formrow"))
        bar.addChild((SpacesApp.btn("sp-ed-save" "sp-action sp-action-primary" (SpWords.ui(lang "save")))))
        bar.addChild((SpacesApp.btn("sp-ed-cancel" "sp-action" (SpWords.ui(lang "cancel")))))
        if ((strlen editId) > 0) {
            if (editOcc >= 0) {
                bar.addChild((SpacesApp.btn("sp-ed-delday" "sp-action" (SpWords.ui(lang "deleteDay")))))
            }
            bar.addChild((SpacesApp.btn("sp-ed-delete" "sp-action" (SpWords.ui(lang "delete")))))
            def found@(optional):SpEvent (space.event(editId))
            if (!null? found) {
                def fe:SpEvent found
                if ((fe.dated()) && ((this.kindOf(fe.typeId)) != "record")) {
                    bar.addChild((SpacesApp.btn("sp-ed-showcal" "sp-link" (SpWords.ui(lang "showCal")))))
                }
                if ((fe.dated()) && ((strlen fe.remoteId) > 0) && ((strlen space.remoteId) > 0)) {
                    bar.addChild((SpacesApp.btn("sp-ed-ics" "sp-link" (SpWords.pick(lang "Download .ics" "Lataa .ics")))))
                }
            }
        }
        c.addChild(bar)
        v.addChild(c)
        return v
    }

    ; An entry's name in a link: its type's and its own.
    fn linkName:string (e:SpEvent) {
        if ((strlen e.typeId) == 0) {
            return e.title
        }
        return ((this.typeName(e.typeId)) + ": " + e.title)
    }

    ; The entries linked with the one being edited (a thing and its repair,
    ; a gift and the reminder to buy it), each opening it or unlinked, and a
    ; search for more. Only saved entries link: the server keeps both ends.
    fn addLinks:void (c:EVGElement) {
        if ((strlen editId) == 0) {
            return
        }
        def found@(optional):SpEvent (space.event(editId))
        if (null? found) {
            return
        }
        def e:SpEvent found
        if ((strlen e.remoteId) == 0) {
            return
        }
        c.addChild((SpacesApp.tx("sp-formhead" (SpWords.pick(lang "Related" "Liittyvät")))))
        def have:[SpEvent] (space.linksOf(e))
        def i:int 0
        while (i < (array_length have)) {
            def o:SpEvent (itemAt have i)
            def row:EVGElement (SpacesApp.box("sp-formrow"))
            def ob:EVGElement (SpacesApp.btn(("sp-linkopen-" + o.id) "sp-link" (this.linkName(o))))
            ob.role = "link"
            row.addChild(ob)
            def ub:EVGElement (SpacesApp.btn(("sp-unlink-" + o.id) "sp-link" "✕"))
            ub.a11yLabel = ((SpWords.pick(lang "Unlink" "Poista linkki")) + ": " + o.title)
            row.addChild(ub)
            c.addChild(row)
            i = (i + 1)
        }
        c.addChild((this.field(linkSearch "sp-linksearch" (SpWords.pick(lang "Link an entry" "Linkitä merkintä")) (SpWords.pick(lang "Search by name" "Hae nimellä")) "text")))
        def hits:[SpEvent] (this.linkMatches(e))
        def k:int 0
        while (k < (array_length hits)) {
            def h:SpEvent (itemAt hits k)
            c.addChild((SpacesApp.btn(("sp-linkadd-" + h.id) "sp-link" ("+ " + (this.linkName(h))))))
            k = (k + 1)
        }
    }

    ; At most six saved entries the link search finds, not `e` nor linked.
    fn linkMatches:[SpEvent] (e:SpEvent) {
        def out:[SpEvent]
        def q:string (to_lowercase (trim linkSearch.value))
        if ((strlen q) == 0) {
            return out
        }
        def i:int 0
        while ((i < (array_length space.events)) && ((array_length out) < 6)) {
            def o:SpEvent (itemAt space.events i)
            if ((((strlen o.remoteId) > 0) && (o.id != e.id)) && ((e.linked(o.remoteId)) == false)) {
                def hay:string (to_lowercase ((o.title) + " " + (this.typeName(o.typeId))))
                if ((indexOf hay q) >= 0) {
                    push out o
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; Link the entry being edited with `otherId` (on) or unlink them.
    fn linkEdited:void (otherId:string on:boolean) {
        def a@(optional):SpEvent (space.event(editId))
        def b@(optional):SpEvent (space.event(otherId))
        if ((null? a) || (null? b)) {
            return
        }
        def ae:SpEvent a
        def be:SpEvent b
        space.link(ae be on)
        linkSearch.setValue("")
        this.queueSaves()
    }

    fn typeFieldKeys:[string] () {
        def out:[string]
        def t@(optional):SpType (this.typeOf(editType))
        if (!null? t) {
            def tt:SpType t
            def i:int 0
            while (i < (array_length tt.fields)) {
                def f:SpField (itemAt tt.fields i)
                push out f.key
                i = (i + 1)
            }
        }
        return out
    }

    ; --- saving ------------------------------------------------------------------------

    ; The form into its event: a new one is added. False, with `formErr`
    ; naming the fields, when something does not read.
    fn saveForm:boolean () {
        if (editing == false) {
            return false
        }
        def bad:[string]
        def kind:string (this.kindOf(editType))
        def year:int (itemAt (SpSpace.ymdOf(today)) 0)
        def title:string (this.formText("title"))
        if ((strlen title) == 0) {
            title = (this.typeName(editType))
        }
        def day:int -1
        def dateText:string (this.formText("date"))
        if ((strlen dateText) > 0) {
            day = (SpTypes.dayOf(dateText year))
            if (day < 0) {
                push bad (this.formLabel("date"))
            }
        } {
            if (kind != "record") {
                push bad (this.formLabel("date"))
            }
        }
        def lastDay:int day
        def endText:string (this.formText("end_date"))
        if ((strlen endText) > 0) {
            lastDay = (SpTypes.dayOf(endText year))
            if (lastDay < day) {
                push bad (this.formLabel("end_date"))
            }
        }
        def s:int -1
        def en:int -1
        def startText:string (this.formText("start"))
        if ((strlen startText) > 0) {
            s = (SpTypes.minuteOf(startText))
            if (s < 0) {
                push bad (this.formLabel("start"))
            }
        }
        def endT:string (this.formText("end"))
        if ((s >= 0) && ((strlen endT) > 0)) {
            en = (SpTypes.minuteOf(endT))
            if (en < 0) {
                push bad (this.formLabel("end"))
            }
        }
        if ((s >= 0) && (en <= s)) {
            en = (s + 60)
        }
        def until:int 0
        def untilText:string (this.formText("until"))
        if ((strlen untilText) > 0) {
            until = (SpTypes.dayOf(untilText year))
            if (until < 0) {
                push bad (this.formLabel("until"))
            }
        }
        ; the type's own fields, as the server keeps them
        def fkeys:[string]
        def fvals:[string]
        def fkinds:[string]
        def t@(optional):SpType (this.typeOf(editType))
        if (!null? t) {
            def tt:SpType t
            def i:int 0
            while (i < (array_length tt.fields)) {
                def f:SpField (itemAt tt.fields i)
                def v:string ""
                if (f.picked()) {
                    v = (this.pickOf(("f:" + f.key)))
                    if ((f.type == "bool") && (v != "true")) {
                        v = "false"
                    }
                } {
                    def err:[string]
                    v = (SpTypes.normalize(f.type (this.formText(("f:" + f.key))) year err))
                    if ((array_length err) > 0) {
                        push bad (f.label(lang))
                    }
                }
                push fkeys f.key
                push fvals v
                push fkinds (f.valueKind())
                i = (i + 1)
            }
        }
        ; the common fields of the get: and budget: keys
        def ck:[string] (SpacesApp.commonKeys())
        def ci:int 0
        while (ci < (array_length ck)) {
            def cKey:string (itemAt ck ci)
            def ct:string (SpacesApp.commonType(cKey))
            def cv:string ""
            if (ct == "choice") {
                ; the family's budget is what an entry is in unless said
                if ((this.pickOf(cKey)) == "personal") {
                    cv = "personal"
                }
            } {
                def cerr:[string]
                cv = (SpTypes.normalize(ct (this.formText(cKey)) year cerr))
                if ((array_length cerr) > 0) {
                    push bad (this.formLabel(cKey))
                }
            }
            push fkeys (SpacesApp.commonField(cKey))
            push fvals cv
            push fkinds (SpTypes.kindOfField(ct))
            ci = (ci + 1)
        }
        ; the days to do it on, in order and once each
        def plans:[string] (this.planKeys())
        if ((array_length plans) > 0) {
            def days:[string]
            def pj:int 0
            while (pj < (array_length plans)) {
                def perr:[string]
                def pv:string (SpTypes.normalize("date" (this.formText((itemAt plans pj))) year perr))
                if ((array_length perr) > 0) {
                    push bad (this.formLabel((itemAt plans pj)))
                } {
                    if (((strlen pv) > 0) && ((indexOf (join days ";") pv) < 0)) {
                        push days pv
                    }
                }
                pj = (pj + 1)
            }
            push fkeys "planned_days"
            push fvals (join days "; ")
            push fkinds "string"
        }
        def gf:string (this.formText("get:from"))
        def gb:string (this.formText("get:by"))
        if (((strlen gf) > 0) && ((strlen gb) > 0)) {
            if ((SpTypes.dayOf(gf year)) > (SpTypes.dayOf(gb year))) {
                push bad (this.formLabel("get:from"))
            }
        }
        ; the cost: an empty amount is no cost
        def cost (new SpCost())
        def withCost:boolean false
        if formCost {
            def amountText:string (this.formText("cost:amount"))
            if ((strlen amountText) > 0) {
                if (SpTypes.readsAsNumber(amountText)) {
                    cost.amount = (SpTypes.amountOf(amountText))
                    withCost = true
                } {
                    push bad (this.formLabel("cost:amount"))
                }
            }
            cost.payer = (this.formText("cost:payer"))
            cost.scope = "shared"
            if ((this.pickOf("budget:scope")) == "personal") {
                cost.scope = "personal"
                ; an own budget is its owner's, who then pays it
                if ((strlen cost.payer) == 0) {
                    cost.payer = (this.formText("budget:owner"))
                }
                if (withCost && ((strlen cost.payer) == 0)) {
                    push bad (this.formLabel("budget:owner"))
                }
            }
            def remindText:string (this.formText("cost:remind"))
            if ((strlen remindText) > 0) {
                cost.remindDays = (SpText.number(remindText))
                if ((cost.remindDays < 0) || (cost.remindDays > 60)) {
                    push bad (this.formLabel("cost:remind"))
                }
            }
            def instText:string (this.formText("cost:instalments"))
            if ((strlen instText) > 0) {
                cost.instalments = (SpText.number(instText))
                if (cost.instalments < 1) {
                    push bad (this.formLabel("cost:instalments"))
                }
            }
            def everyText:string (this.formText("cost:every"))
            if ((strlen everyText) > 0) {
                cost.everyMonths = (SpText.number(everyText))
                if (cost.everyMonths < 1) {
                    push bad (this.formLabel("cost:every"))
                }
            }
            def firstText:string (this.formText("cost:first"))
            if ((strlen firstText) > 0) {
                cost.first = (SpTypes.dayOf(firstText year))
                if (cost.first < 0) {
                    push bad (this.formLabel("cost:first"))
                }
            }
        }
        if ((array_length bad) > 0) {
            formErr = ((SpWords.ui(lang "check")) + ": " + (join bad ", "))
            return false
        }

        def e (new SpEvent())
        if ((strlen editId) > 0) {
            def found@(optional):SpEvent (space.event(editId))
            if (null? found) {
                editing = false
                return false
            }
            e = (unwrap found)
        } {
            e = (space.addEvent(title day s en (this.pickOf("ward"))))
        }
        e.title = title
        e.day = day
        e.endDay = day
        e.startMin = s
        e.endMin = en
        if (s < 0) {
            e.endMin = -1
            if (lastDay > day) {
                e.endDay = lastDay
            }
        }
        e.resource = (this.pickOf("ward"))
        e.place = (this.formText("place"))
        e.notes = (this.formText("notes"))
        if (this.hasText("who")) {
            e.who = (SpWho.parseList((this.formText("who"))))
        }
        e.important = ((this.pickOf("important")) == "true")
        if (this.hasPick("color")) {
            def col:string (this.pickOf("color"))
            if (((strlen col) == 0) && ((strlen e.color) > 0)) {
                e.colorDrop = true
            }
            e.color = col
        }
        e.typeId = editType
        if (this.hasPick("repeat")) {
            def freq:string (this.pickOf("repeat"))
            if (freq != e.rule.freq) {
                def none:[int]
                e.rule.byDay = none
            }
            e.rule.freq = freq
            e.rule.until = until
            if ((strlen freq) == 0) {
                def none2:[int]
                e.exdates = none2
            }
        }
        def k:int 0
        while (k < (array_length fkeys)) {
            e.setField((itemAt fkeys k) (itemAt fvals k) (itemAt fkinds k))
            k = (k + 1)
        }
        ; times per weekday: it repeats on those days, and its own time is
        ; its first day's (what the server keeps too)
        def week:SpWeek (space.weekOf(e))
        if (week.ok && (e.dated())) {
            e.rule.freq = "weekly"
            e.rule.byDay = (week.days())
            def wd:int (UiDate.weekday(e.day))
            def n:int 0
            while ((n < 7) && ((week.on(((wd + n) % 7))) == false)) {
                n = (n + 1)
            }
            if (n < 7) {
                e.startMin = (itemAt week.starts ((wd + n) % 7))
                e.endMin = (itemAt week.ends ((wd + n) % 7))
                e.endDay = e.day
            }
        }
        if withCost {
            e.setCost(cost)
        } {
            e.clearCost()
        }
        ; the server works out the reminder again
        e.remindFrom = -1
        e.touch()
        editing = false
        focused = ""
        status = ((SpWords.ui(lang "saved")) + ": " + title)
        this.fillBoard()
        this.queueSaves()
        this.budgetChanged()
        return true
    }

    ; --- deleting ----------------------------------------------------------------------

    ; Delete an event, or with `day` one day of a repeating one. Undo brings
    ; it back.
    fn deleteEntry:boolean (id:string day:int) {
        def found@(optional):SpEvent (space.event(id))
        if (null? found) {
            return false
        }
        def e:SpEvent found
        editing = false
        focused = ""
        if ((day >= 0) && (e.repeats())) {
            space.skipDay(id day)
            undoKind = "day"
            undoId = id
            undoDay = day
            status = ((SpWords.ui(lang "deleted")) + ": " + e.title + ", " + (SpWords.dayLabel(lang day)))
            this.fillBoard()
            this.queueSaves()
            return true
        }
        space.removeEvent(id)
        push trash e
        undoKind = "entry"
        undoId = id
        undoDay = -1
        status = ((SpWords.ui(lang "deleted")) + ": " + e.title)
        if (server && ((strlen spaceId) > 0)) {
            if ((strlen e.remoteId) > 0) {
                this.queue("delete_event" (SpRemote.deleteBody(spaceId e.remoteId)) id)
            }
            ; a save not sent yet is not needed; one on its way is answered
            ; with the id the delete then goes to
            this.dropQueued("save_event" id)
        }
        this.fillBoard()
        this.budgetChanged()
        return true
    }

    ; Calls of `op` about `ref` that are still waiting (not the first, which
    ; may be on its way); whether there were any.
    fn dropQueued:boolean (op:string ref:string) {
        def rest:[SpCall]
        def did:boolean false
        def i:int 0
        while (i < (array_length outbox)) {
            def c:SpCall (itemAt outbox i)
            if (((i > 0) && (c.op == op)) && (c.ref == ref)) {
                did = true
            } {
                push rest c
            }
            i = (i + 1)
        }
        outbox = rest
        return did
    }

    fn trashed@(optional):SpEvent (id:string) {
        def found@(optional):SpEvent
        def i:int 0
        while (i < (array_length trash)) {
            def e:SpEvent (itemAt trash i)
            if (e.id == id) {
                found = e
            }
            i = (i + 1)
        }
        return found
    }

    fn untrash:void (id:string) {
        def kept:[SpEvent]
        def i:int 0
        while (i < (array_length trash)) {
            def e:SpEvent (itemAt trash i)
            if (e.id != id) {
                push kept e
            }
            i = (i + 1)
        }
        trash = kept
    }

    ; The selected event: Backspace and Delete take it away.
    fn deleteSelected:boolean () {
        def occ:string (this.selectedOcc())
        if ((strlen occ) == 0) {
            return false
        }
        def id:string (space.eventIdOf(occ))
        if ((strlen id) == 0) {
            status = (SpWords.pick(lang "Rows from a sheet are changed in the sheet" "Taulukon rivit muutetaan taulukossa"))
            return true
        }
        return (this.deleteEntry(id (SpSpace.occDayOf(occ))))
    }

    ; What the last delete took away comes back.
    fn undo:boolean () {
        if (undoKind == "day") {
            space.unskipDay(undoId undoDay)
            this.queueSaves()
        }
        if (undoKind == "entry") {
            def found@(optional):SpEvent (this.trashed(undoId))
            if (!null? found) {
                def e:SpEvent found
                this.untrash(undoId)
                ; a delete still waiting is not sent; one already sent made
                ; it new again
                if ((this.dropQueued("delete_event" undoId)) == false) {
                    if ((strlen e.remoteId) > 0) {
                        e.remoteId = ""
                        e.touch()
                    }
                }
                if ((strlen e.remoteId) == 0) {
                    e.touch()
                }
                space.putBack(e)
                this.queueSaves()
            }
        }
        if ((strlen undoKind) == 0) {
            return false
        }
        undoKind = ""
        status = (SpWords.ui(lang "restored"))
        this.fillBoard()
        this.budgetChanged()
        return true
    }

    ; --- lists -------------------------------------------------------------------------

    ; One entry in a list: its title, the day, its state and its cost.
    fn entryRow:EVGElement (e:SpEvent) {
        def due:string (space.dueOf(e today))
        def kind:string (this.kindOf(e.typeId))
        def cls:string "sp-item"
        if ((kind == "deadline") && ((strlen due) > 0)) {
            cls = "sp-item sp-item-important"
        }
        def row:EVGElement (UiTree.div(("sp-entry-" + e.id) cls))
        row.role = "button"
        row.a11yFocusable = true
        def parts:[string]
        if (kind == "deadline") {
            if (due == "late") {
                push parts (SpWords.ui(lang "late"))
            }
            if (due == "due") {
                push parts (SpWords.ui(lang "dueSoon"))
            }
        }
        if (e.dated()) {
            push parts (SpWords.dayLabel(lang e.day))
        }
        def t@(optional):SpType (this.typeOf(e.typeId))
        if (!null? t) {
            def tt:SpType t
            def i:int 0
            while (i < (array_length tt.fields)) {
                def f:SpField (itemAt tt.fields i)
                def v:string (e.fieldText(f.key))
                if ((f.type == "weektimes") && ((strlen v) > 0)) {
                    def wk2:SpWeek (SpWeek.read(v))
                    if wk2.ok {
                        push parts (wk2.shown(lang))
                    }
                }
                if (((strlen v) > 0) && ((f.type == "choice") || ((f.type == "person") || (f.type == "phone")))) {
                    if (f.type == "choice") {
                        push parts (f.optionLabel(lang v))
                    } {
                        push parts v
                    }
                }
                if ((f.type == "bool") && (v == "true")) {
                    push parts (f.label(lang))
                }
                if (((f.type == "number") || (f.type == "money")) && ((strlen v) > 0)) {
                    push parts ((f.label(lang)) + " " + v)
                }
                i = (i + 1)
            }
        }
        def ward:string (space.resourceName(e.resource))
        if ((strlen ward) > 0) {
            push parts ward
        }
        if e.hasCost {
            push parts (SpTypes.money(lang e.cost.amount))
        }
        def meta:string (join parts " · ")
        row.a11yLabel = (e.title + ", " + meta)
        def icon:string "•"
        if ((kind == "deadline") && ((strlen due) > 0)) {
            icon = "⚑"
        }
        def ic:EVGElement (SpacesApp.tx("sp-star" icon))
        ic.a11yHidden = true
        row.addChild(ic)
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        def tt2:EVGElement (SpacesApp.tx("sp-title" e.title))
        tt2.a11yHidden = true
        col.addChild(tt2)
        if ((strlen meta) > 0) {
            def mt:EVGElement (SpacesApp.tx("sp-meta" meta))
            mt.a11yHidden = true
            col.addChild(mt)
        }
        row.addChild(col)
        return row
    }

    fn listsView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        v.addChild((this.heading((SpWords.ui(lang "lists")) (SpWords.pick(lang "Things, supplies, ideas, renewals and contacts: kept here, not on the calendar." "Tavarat, tarvikkeet, ideat, uusittavat ja yhteystiedot: täällä, ei kalenterissa.")))))
        def listed:[SpType] (types.listedFor(pack))
        ; an older type the space still has entries of
        def lt:int 0
        while (lt < (array_length types.types)) {
            def old:SpType (itemAt types.types lt)
            if ((old.legacy && (old.listed())) && ((array_length (space.entriesOf(old.id))) > 0)) {
                push listed old
            }
            lt = (lt + 1)
        }
        v.addChild((this.addBar()))
        ; only the lists that have something, and the one picked last
        def full:[SpType]
        def li:int 0
        while (li < (array_length listed)) {
            def lt2:SpType (itemAt listed li)
            if (((array_length (space.entriesOf(lt2.id))) > 0) || (lt2.id == listType)) {
                push full lt2
            }
            li = (li + 1)
        }
        listed = full
        if ((array_length listed) == 0) {
            v.addChild((SpacesApp.tx("sp-empty" (SpWords.pick(lang "Nothing on the lists yet. Add something above." "Listoilla ei ole vielä mitään. Lisää jotain yläpuolelta.")))))
            return v
        }
        def cur:SpType (itemAt listed 0)
        def i:int 0
        while (i < (array_length listed)) {
            def t:SpType (itemAt listed i)
            if (t.id == listType) {
                cur = t
            }
            i = (i + 1)
        }
        def bar:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
        bar.role = "tablist"
        def k:int 0
        while (k < (array_length listed)) {
            def t2:SpType (itemAt listed k)
            def on:boolean (t2.id == cur.id)
            def cls:string "sp-tab"
            if on {
                cls = "sp-tab sp-tab-on"
            }
            def n:int (array_length (space.entriesOf(t2.id)))
            def tb:EVGElement (SpacesApp.btn(("sp-list-" + t2.id) cls (t2.name.text(lang))))
            if (n > 0) {
                ; the count sits in its own pill so it reads as a count, not part of the name
                tb.a11yLabel = ((t2.name.text(lang)) + " " + (to_string n))
                def badge:EVGElement (UiTree.div("" "sp-count"))
                badge.a11yHidden = true
                badge.addChild((SpacesApp.tx("sp-count-tx" (to_string n))))
                tb.addChild(badge)
            }
            tb.role = "tab"
            tb.a11ySelected = (SpacesApp.tri(on))
            bar.addChild(tb)
            k = (k + 1)
        }
        v.addChild(bar)
        def c:EVGElement (this.card(("list-" + cur.id) (cur.name.text(lang))))
        def help:string (cur.help.text(lang))
        if ((strlen help) > 0) {
            c.addChild((SpacesApp.tx("sp-cardsub" help)))
        }
        def entries:[SpEvent] (space.entriesOf(cur.id))
        if ((array_length entries) == 0) {
            c.addChild((SpacesApp.tx("sp-empty" (SpWords.ui(lang "noEntries")))))
        }
        def j:int 0
        while (j < (array_length entries)) {
            c.addChild((this.entryRow((itemAt entries j))))
            j = (j + 1)
        }
        c.addChild((SpacesApp.btn(("sp-addtype-" + cur.id) "sp-link" ((SpWords.ui(lang "addOne")) + ": " + (cur.name.text(lang))))))
        v.addChild(c)
        return v
    }

    ; --- questions ----------------------------------------------------------------------
    ; A question to another member (mcp-go/wardenask.go): the assistant
    ; first, then the kinds to ask by hand, each a short form of only what it
    ; asks; then the questions waiting for the person's answer, those they
    ; asked and the answered ones. A yes makes the calendar entry, the
    ; purchase or the budget settlement on the server.

    sfn askKinds:[string] () {
        return ([] _:string ( "care_time" "take_kids" "school" "hobby" "event" "buy" "suggest" "payment" "free" ))
    }

    ; A kind's name, from the question type's own labels.
    fn askLabel:string (kind:string) {
        def t@(optional):SpType (this.typeOf("question"))
        if (!null? t) {
            def tt:SpType t
            def f@(optional):SpField (tt.field("ask"))
            if (!null? f) {
                def ff:SpField f
                return (ff.optionLabel(lang kind))
            }
        }
        return kind
    }

    ; Whom a question can go to: everyone else, then each other member by
    ; name.
    fn askable:[string] () {
        def out:[string]
        def others:[string] (this.askOthers())
        if ((array_length others) > 0) {
            push out (this.askAllLabel())
        }
        def i:int 0
        while (i < (array_length others)) {
            push out (itemAt others i)
            i = (i + 1)
        }
        return out
    }

    fn askAllLabel:string () {
        return (SpWords.pick(lang "Everyone else" "Kaikki muut"))
    }

    fn askOthers:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length space.members)) {
            def m:SpMember (itemAt space.members i)
            if ((m.uid != account.uid) && ((strlen (trim m.name)) > 0)) {
                push out m.name
            }
            i = (i + 1)
        }
        return out
    }

    fn questions:[SpEvent] () {
        def out:[SpEvent]
        def i:int 0
        while (i < (array_length space.events)) {
            def e:SpEvent (itemAt space.events i)
            if (e.typeId == "question") {
                push out e
            }
            i = (i + 1)
        }
        return out
    }

    sfn askOpen:boolean (e:SpEvent) {
        return ((strlen (e.fieldText("answer"))) == 0)
    }

    ; Asked of the person and not answered yet.
    fn askForMe:boolean (e:SpEvent) {
        if ((strlen account.uid) == 0) {
            return false
        }
        if ((SpacesApp.askOpen(e)) == false) {
            return false
        }
        def to:string (e.fieldText("ask_to_uid"))
        ; asked of everyone else: any of them answers
        if (to == "*") {
            return ((e.fieldText("asked_by_uid")) != account.uid)
        }
        return (to == account.uid)
    }

    ; The open questions: the person's to answer first, then those they
    ; asked, then the rest.
    fn askOpenList:[SpEvent] () {
        def qs:[SpEvent] (this.questions())
        def mine:[SpEvent]
        def sent:[SpEvent]
        def rest:[SpEvent]
        def i:int 0
        while (i < (array_length qs)) {
            def e:SpEvent (itemAt qs i)
            if (this.askForMe(e)) {
                push mine e
            } {
                if (SpacesApp.askOpen(e)) {
                    if ((e.fieldText("asked_by_uid")) == account.uid) {
                        push sent e
                    } {
                        push rest e
                    }
                }
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length sent)) {
            push mine (itemAt sent j)
            j = (j + 1)
        }
        def k:int 0
        while (k < (array_length rest)) {
            push mine (itemAt rest k)
            k = (k + 1)
        }
        return mine
    }

    fn askWaiting:int () {
        def n:int 0
        def qs:[SpEvent] (this.questions())
        def i:int 0
        while (i < (array_length qs)) {
            if (this.askForMe((itemAt qs i))) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; The form of a kind: only the fields it asks, in the form's own keys so
    ; its dates are EVGUI's calendar like every other form's.
    fn openAsk:void (kind:string) {
        askKind = kind
        def k:[string]
        formKeys = k
        def c:[InputCtl]
        formCtls = c
        def pk:[string]
        pickKeys = pk
        def pv:[string]
        pickVals = pv
        formErr = ""
        dateOpen = -1
        editing = false
        editId = ""
        editType = "question"
        def to:[string] (this.askable())
        def first:string ""
        if ((array_length to) > 0) {
            first = (itemAt to 0)
        }
        def was:string (this.askWas("ask_to_uid"))
        if (((strlen was) > 0) && (was != "*")) {
            first = (this.askWas("ask_to"))
        }
        this.addPick("f:ask_to" first)
        if (((array_length space.resources) > 0) && (kind != "payment")) {
            this.addPick("ward" (this.askWas("ward")))
        }
        if ((kind != "care_time") && ((kind != "take_kids") && (kind != "payment"))) {
            this.addText("f:what" (this.askWas("what")))
        }
        if ((kind != "payment") && (kind != "suggest")) {
            this.addText("f:on_date" (this.askWas("on_date")))
        }
        if (kind == "care_time") {
            this.addText("f:until_date" (this.askWas("until_date")))
        }
        if ((kind == "take_kids") || ((kind == "event") || ((kind == "school") || ((kind == "hobby") || (kind == "free"))))) {
            this.addText("f:from_time" (this.askWas("from_time")))
            this.addText("f:to_time" (this.askWas("to_time")))
        }
        if (kind == "take_kids") {
            this.addText("f:hours" (this.askWas("hours")))
        }
        if ((kind == "school") || (kind == "hobby")) {
            this.addPick("f:direction" (SpacesApp.orOf((this.askWas("direction")) "take")))
        }
        if ((kind == "payment") || (kind == "buy")) {
            this.addText("f:amount" (this.askWas("amount")))
        }
        if ((kind == "suggest") || (kind == "free")) {
            this.addText("f:options" (this.askWas("options")))
        }
        if ((kind != "buy") && (kind != "payment")) {
            this.addPick("f:add_to_calendar" (SpacesApp.orOf((this.askWas("add_to_calendar")) "true")))
        }
        this.addText("title" (this.askWas("title")))
        this.addText("notes" (this.askWas("notes")))
        focused = ""
    }

    sfn orOf:string (v:string dflt:string) {
        if ((strlen v) > 0) {
            return v
        }
        return dflt
    }

    ; A value of the question being asked anew ("" for a new one): its
    ; fields, and title, notes and ward.
    fn askWas:string (key:string) {
        if ((strlen askEdit) == 0) {
            return ""
        }
        def found@(optional):SpEvent (space.event(askEdit))
        if (null? found) {
            return ""
        }
        def e:SpEvent found
        if (key == "title") {
            return e.title
        }
        if (key == "notes") {
            return e.notes
        }
        if (key == "ward") {
            return e.resource
        }
        return (e.fieldText(key))
    }

    ; An open question of the person's own, into the form to change.
    fn editAsk:void (e:SpEvent) {
        askEdit = e.id
        askNew = true
        this.openAsk((SpacesApp.orOf((e.fieldText("ask")) "free")))
    }

    ; The kinds whose form asks for a day.
    sfn askNeedsDay:boolean (kind:string) {
        return ((kind == "care_time") || ((kind == "take_kids") || ((kind == "event") || ((kind == "school") || (kind == "hobby")))))
    }

    ; The form to ask_question; false (and the form says why) when it is not
    ; complete.
    fn sendAsk:boolean () {
        def to:string (this.pickOf("f:ask_to"))
        def bad:[string]
        if ((strlen to) == 0) {
            push bad (this.formLabel("f:ask_to"))
        }
        if ((SpacesApp.askNeedsDay(askKind)) && ((strlen (this.formText("f:on_date"))) == 0)) {
            push bad (this.formLabel("f:on_date"))
        }
        if ((askKind == "buy") && ((strlen (this.formText("f:what"))) == 0)) {
            push bad (this.formLabel("f:what"))
        }
        if ((askKind == "free") && (((strlen (this.formText("title"))) == 0) && ((strlen (this.formText("f:what"))) == 0))) {
            push bad (this.formLabel("title"))
        }
        def o:VlJson (VlJson.objectValue())
        o.setMember("space_id" (SpRemote.str(spaceId)))
        o.setMember("kind" (SpRemote.str(askKind)))
        if (to == (this.askAllLabel())) {
            o.setMember("to" (SpRemote.str("all")))
        } {
            o.setMember("to" (SpRemote.str(to)))
        }
        if ((strlen askEdit) > 0) {
            def found@(optional):SpEvent (space.event(askEdit))
            if (!null? found) {
                def ee:SpEvent found
                o.setMember("event_id" (SpRemote.str(ee.remoteId)))
            }
        }
        def texts:[string] ([] _:string ( "title" "question" "f:what" "what" "f:on_date" "date" "f:until_date" "until" "notes" "notes" ))
        def i:int 0
        while (i < (array_length texts)) {
            def v:string (this.formText((itemAt texts i)))
            if ((strlen v) > 0) {
                o.setMember((itemAt texts (i + 1)) (SpRemote.str(v)))
            }
            i = (i + 2)
        }
        def times:[string] ([] _:string ( "f:from_time" "start" "f:to_time" "end" ))
        def j:int 0
        while (j < (array_length times)) {
            def tv:string (this.formText((itemAt times j)))
            if ((strlen tv) > 0) {
                def mm:int (SpTypes.minuteOf(tv))
                if (mm < 0) {
                    push bad (this.formLabel((itemAt times j)))
                } {
                    o.setMember((itemAt times (j + 1)) (SpRemote.str((SpTypes.hhmm(mm)))))
                }
            }
            j = (j + 2)
        }
        def nums:[string] ( [] _:string ( "f:hours" "hours" "f:amount" "amount" ))
        def n:int 0
        while (n < (array_length nums)) {
            def nv:string (this.formText((itemAt nums n)))
            if ((strlen nv) > 0) {
                if (SpTypes.readsAsNumber(nv)) {
                    o.setMember((itemAt nums (n + 1)) (VlJson.numberValue((SpTypes.amountOf(nv)))))
                } {
                    push bad (this.formLabel((itemAt nums n)))
                }
            }
            n = (n + 2)
        }
        if ((askKind == "payment") && ((strlen (this.formText("f:amount"))) == 0)) {
            push bad (this.formLabel("f:amount"))
        }
        def ward:string (this.pickOf("ward"))
        if ((strlen ward) > 0) {
            o.setMember("ward" (SpRemote.str(ward)))
        }
        if (this.hasPick("f:direction")) {
            o.setMember("direction" (SpRemote.str((this.pickOf("f:direction")))))
        }
        if (this.hasPick("f:add_to_calendar")) {
            o.setMember("add_to_calendar" (VlJson.boolValue(((this.pickOf("f:add_to_calendar")) == "true"))))
        }
        def opts:[string] (SpacesApp.askOptions((this.formText("f:options"))))
        if ((array_length opts) > 0) {
            def arr:VlJson (VlJson.arrayValue())
            def k:int 0
            while (k < (array_length opts)) {
                push arr.arr (SpRemote.str((itemAt opts k)))
                k = (k + 1)
            }
            o.setMember("options" arr)
        }
        if ((array_length bad) > 0) {
            formErr = ((SpWords.pick(lang "Check: " "Tarkista: ")) + (join bad ", "))
            return false
        }
        formErr = ""
        this.queue("ask_question" (SpRemote.write(o)) to)
        status = (SpWords.pick(lang "Sending the question…" "Lähetetään kysymystä…"))
        return true
    }

    ; Options as written: separated by semicolons, commas or new lines.
    sfn askOptions:[string] (text:string) {
        def out:[string]
        def cur:string ""
        def i:int 0
        def n:int (strlen text)
        while (i <= n) {
            def ch:string ";"
            if (i < n) {
                ch = (substring text i (i + 1))
            }
            if ((ch == ";") || ((ch == ",") || (ch == "\n"))) {
                def t:string (trim cur)
                if ((strlen t) > 0) {
                    push out t
                }
                cur = ""
            } {
                cur = (cur + ch)
            }
            i = (i + 1)
        }
        return out
    }

    ; An answer to answer_question: "yes", "no", an option or words.
    fn sendAnswer:void (e:SpEvent answer:string) {
        if ((strlen (trim answer)) == 0) {
            status = (SpWords.pick(lang "Write the answer first" "Kirjoita vastaus ensin"))
            focused = "sp-answer-text"
            return
        }
        def o:VlJson (VlJson.objectValue())
        o.setMember("space_id" (SpRemote.str(spaceId)))
        o.setMember("event_id" (SpRemote.str(e.remoteId)))
        o.setMember("answer" (SpRemote.str((trim answer))))
        if (askSel == e.id) {
            def note:string (trim answerField.value)
            if (((strlen note) > 0) && (note != (trim answer))) {
                o.setMember("note" (SpRemote.str(note)))
            }
        }
        this.queue("answer_question" (SpRemote.write(o)) e.id)
        status = (SpWords.pick(lang "Sending the answer…" "Lähetetään vastausta…"))
    }

    ; A question's day and times as words.
    fn askWhen:string (e:SpEvent) {
        def year:int (itemAt (SpSpace.ymdOf(today)) 0)
        def parts:[string]
        def d:int (SpTypes.dayOf((e.fieldText("on_date")) year))
        if (d >= 0) {
            def w:string (SpWords.dayLabel(lang d))
            def u:int (SpTypes.dayOf((e.fieldText("until_date")) year))
            if (u > d) {
                w = (w + " – " + (SpWords.dayLabel(lang u)))
            }
            push parts w
        }
        def from:string (e.fieldText("from_time"))
        if ((strlen from) > 0) {
            def to:string (e.fieldText("to_time"))
            if ((strlen to) > 0) {
                push parts (from + "–" + to)
            } {
                push parts from
            }
        }
        def h:string (e.fieldText("hours"))
        if ((strlen h) > 0) {
            push parts (h + (SpWords.pick(lang " h" " h")))
        }
        return (join parts " ")
    }

    fn questionsView:EVGElement () {
        def none:[string]
        askIds = none
        def v:EVGElement (SpacesApp.box("sp-view"))
        v.addChild((this.heading((SpWords.ui(lang "questions")) "")))
        ; a new question: the assistant first, then the kinds by hand
        if (askNew == false) {
            def nrow:EVGElement (SpacesApp.box("sp-row"))
            nrow.addChild((SpacesApp.btn("sp-ask-new" "sp-action sp-action-primary" (SpWords.pick(lang "Add a new question" "Lisää uusi kysymys")))))
            v.addChild(nrow)
        } {
            def ctitle:string (SpWords.pick(lang "New question" "Uusi kysymys"))
            if ((strlen askEdit) > 0) {
                ctitle = (SpWords.pick(lang "Change the question" "Muokkaa kysymystä"))
            }
            def ai:EVGElement (this.card("ask-ai" ctitle))
            if ((strlen askEdit) == 0) {
                askAiField.multiline = true
                askAiField.maxLines = 4
                def fr:EVGElement (this.field(askAiField "sp-askai-text" (SpWords.pick(lang "Write what you want to ask the other family members" "Kirjoita mitä haluat kysyä muilta perheenjäseniltä")) (SpWords.pick(lang "E.g. Can someone pick Leo up from school on Tuesday at 14?" "Esim. Voiko joku hakea Leon koulusta tiistaina klo 14?")) "text"))
                UiTree.inline(fr "width" (SpacesApp.px(((this.mainW()) - 40.0))))
                ai.addChild(fr)
                def arow:EVGElement (SpacesApp.box("sp-row"))
                arow.addChild((SpacesApp.box("sp-grow")))
                if assistBusy {
                    arow.addChild((SpacesApp.tx("sp-cardsub" (SpWords.pick(lang "Reading…" "Luetaan…")))))
                } {
                    arow.addChild((SpacesApp.btn("sp-askai-send" "sp-action sp-action-primary" (SpWords.pick(lang "Ask" "Kysy")))))
                }
                ai.addChild(arow)
                if ((askAiAsked >= 0) && (askAiAsked < (array_length answers))) {
                    def bubble:EVGElement (this.markdown("sp-askai-answer" (itemAt answers askAiAsked) ((this.mainW()) - 60.0)))
                    UiTree.addClass(bubble "sp-bubble-a")
                    ai.addChild(bubble)
                }
                ai.addChild((SpacesApp.tx("sp-cardsub" (SpWords.pick(lang "Or pick what to ask" "Tai valitse mitä kysyt")))))
            }
            def chips:EVGElement (SpacesApp.box("sp-addgroup"))
            chips.role = "group"
            chips.a11yLabel = (SpWords.pick(lang "What to ask" "Mitä kysyt"))
            def kinds:[string] (SpacesApp.askKinds())
            def i:int 0
            while (i < (array_length kinds)) {
                def kd:string (itemAt kinds i)
                def on:boolean (kd == askKind)
                def cls:string "sp-chip"
                if on {
                    cls = "sp-chip sp-chip-on"
                }
                def b:EVGElement (SpacesApp.btn(("sp-askkind-" + kd) cls (this.askLabel(kd))))
                b.a11yPressed = (SpacesApp.tri(on))
                chips.addChild(b)
                i = (i + 1)
            }
            ai.addChild(chips)
            if ((strlen askKind) > 0) {
                if ((array_length (this.askable())) == 0) {
                    ai.addChild((SpacesApp.tx("sp-cardsub" (SpWords.pick(lang "There is no one else in the space yet: invite a member on the Members page." "Tilassa ei ole vielä muita: kutsu jäsen Jäsenet-sivulla.")))))
                }
                if ((strlen formErr) > 0) {
                    def er:EVGElement (UiTree.label("sp-formerr" "sp-formerr" formErr))
                    er.role = "alert"
                    ai.addChild(er)
                }
                def form:EVGElement (SpacesApp.box("sp-form"))
                def keys:[string] ([] _:string ( "f:ask_to" "ward" "f:what" "f:on_date" "f:until_date" "f:from_time" "f:to_time" "f:hours" "f:direction" "f:amount" "f:options" "f:add_to_calendar" "title" "notes" ))
                def j:int 0
                while (j < (array_length keys)) {
                    def key:string (itemAt keys j)
                    def ti:int (this.textIndex(key))
                    if (ti >= 0) {
                        form.addChild((this.textField(ti)))
                    } {
                        def pi:int (this.pickIndex(key))
                        if (pi >= 0) {
                            form.addChild((this.pickField(pi)))
                        }
                    }
                    j = (j + 1)
                }
                ai.addChild(form)
            }
            def bar:EVGElement (SpacesApp.box("sp-formrow"))
            if ((strlen askKind) > 0) {
                def sl:string (SpWords.pick(lang "Send the question" "Lähetä kysymys"))
                if ((strlen askEdit) > 0) {
                    sl = (SpWords.pick(lang "Save the question" "Tallenna kysymys"))
                }
                bar.addChild((SpacesApp.btn("sp-ask-send" "sp-action sp-action-primary" sl)))
            }
            bar.addChild((SpacesApp.btn("sp-ask-cancel" "sp-action" (SpWords.ui(lang "cancel")))))
            ai.addChild(bar)
            v.addChild(ai)
        }
        ; the questions
        def qs:[SpEvent] (this.questions())
        def mine:[SpEvent]
        def sent:[SpEvent]
        def others:[SpEvent]
        def done:[SpEvent]
        def q:int 0
        while (q < (array_length qs)) {
            def e:SpEvent (itemAt qs q)
            if (this.askForMe(e)) {
                push mine e
            } {
                if (SpacesApp.askOpen(e)) {
                    if ((e.fieldText("asked_by_uid")) == account.uid) {
                        push sent e
                    } {
                        push others e
                    }
                } {
                    push done e
                }
            }
            q = (q + 1)
        }
        v.addChild((this.askCard("ask-mine" (SpWords.pick(lang "Waiting for your answer" "Odottaa vastaustasi")) mine (SpWords.pick(lang "Nothing to answer" "Ei vastattavaa")))))
        v.addChild((this.askCard("ask-sent" (SpWords.pick(lang "You asked, no answer yet" "Kysyit, ei vielä vastausta")) sent "")))
        if ((array_length others) > 0) {
            v.addChild((this.askCard("ask-others" (SpWords.pick(lang "Other open questions" "Muut avoimet kysymykset")) others "")))
        }
        v.addChild((this.askCard("ask-done" (SpWords.pick(lang "Answered" "Vastatut")) done "")))
        return v
    }

    fn askCard:EVGElement (id:string title:string list:[SpEvent] empty:string) {
        def c:EVGElement (this.card(id title))
        if ((array_length list) == 0) {
            def msg:string empty
            if ((strlen msg) == 0) {
                msg = (SpWords.pick(lang "None" "Ei yhtään"))
            }
            c.addChild((SpacesApp.tx("sp-empty" msg)))
            return c
        }
        def i:int 0
        while (i < (array_length list)) {
            c.addChild((this.askRow((itemAt list i) (this.mainW()))))
            i = (i + 1)
        }
        return c
    }

    ; One question: what is asked, by whom of whom, when; the answer or,
    ; for the person asked, the buttons to answer with.
    fn askRow:EVGElement (e:SpEvent w:double) {
        def k:int (array_length askIds)
        push askIds e.id
        def ks:string (to_string k)
        def forMe:boolean (this.askForMe(e))
        def cls:string "sp-ask"
        if forMe {
            cls = "sp-ask sp-ask-me"
        }
        def row:EVGElement (UiTree.div(("sp-ask-" + ks) cls))
        row.role = "listitem"
        def parts:[string]
        push parts (this.askLabel((e.fieldText("ask"))))
        push parts ((e.fieldText("asked_by")) + " → " + (e.fieldText("ask_to")))
        def ward:string (space.resourceName(e.resource))
        if ((strlen ward) > 0) {
            push parts ward
        }
        def when:string (this.askWhen(e))
        if ((strlen when) > 0) {
            push parts when
        }
        def amt:string (e.fieldText("amount"))
        if ((strlen amt) > 0) {
            push parts (SpTypes.money(lang (e.fieldNumber("amount" 0.0))))
        }
        def meta:string (join parts " · ")
        def tt:EVGElement (SpacesApp.tx("sp-title" e.title))
        row.addChild(tt)
        row.addChild((SpacesApp.tx("sp-meta" meta)))
        if ((strlen e.notes) > 0) {
            row.addChild((SpacesApp.tx("sp-meta" e.notes)))
        }
        def ans:string (e.fieldText("answer"))
        if ((strlen ans) > 0) {
            def said:string ans
            if (ans == "yes") {
                said = (SpWords.pick(lang "Yes" "Kyllä"))
            }
            if (ans == "no") {
                said = (SpWords.pick(lang "No" "Ei"))
            }
            def line:string ((SpWords.pick(lang "Answer: " "Vastaus: ")) + said)
            def by:string (e.fieldText("answered_by"))
            if ((strlen by) > 0) {
                line = (line + " (" + by + ")")
            }
            def an:EVGElement (SpacesApp.tx("sp-title" line))
            row.addChild(an)
            def note:string (e.fieldText("answer_note"))
            if ((strlen note) > 0) {
                row.addChild((SpacesApp.tx("sp-meta" note)))
            }
        }
        if forMe {
            def bar:EVGElement (SpacesApp.box("sp-formrow"))
            bar.role = "group"
            bar.a11yLabel = (SpWords.pick(lang "Answer" "Vastaa"))
            def opts:[string] (SpacesApp.askOptions((e.fieldText("options"))))
            if ((array_length opts) > 0) {
                def o:int 0
                while (o < (array_length opts)) {
                    bar.addChild((SpacesApp.btn(("sp-ans-" + ks + "-" + (to_string o)) "sp-opt" (itemAt opts o))))
                    o = (o + 1)
                }
            } {
                if ((e.fieldText("ask")) != "suggest") {
                    bar.addChild((SpacesApp.btn(("sp-ans-" + ks + "-y") "sp-action sp-action-primary" (SpWords.pick(lang "Yes" "Kyllä")))))
                }
            }
            bar.addChild((SpacesApp.btn(("sp-ans-" + ks + "-n") "sp-action" (SpWords.pick(lang "No" "Ei")))))
            def wl:string (SpWords.pick(lang "Answer in words" "Vastaa omin sanoin"))
            if ((e.fieldText("ask")) == "suggest") {
                wl = (SpWords.pick(lang "Suggest" "Ehdota"))
            }
            bar.addChild((SpacesApp.btn(("sp-ans-" + ks + "-w") "sp-link" wl)))
            row.addChild(bar)
            if (askSel == e.id) {
                answerField.multiline = true
                answerField.maxLines = 3
                def hint:string (SpWords.pick(lang "A note with your answer" "Lisätieto vastaukseesi"))
                if ((e.fieldText("ask")) == "suggest") {
                    hint = (SpWords.pick(lang "E.g. Saturday at 10" "Esim. lauantaina klo 10"))
                }
                def af:EVGElement (this.field(answerField "sp-answer-text" wl hint "text"))
                UiTree.inline(af "width" (SpacesApp.px((w - 80.0))))
                row.addChild(af)
                if ((e.fieldText("ask")) == "suggest") {
                    def srow:EVGElement (SpacesApp.box("sp-formrow"))
                    srow.addChild((SpacesApp.btn(("sp-ans-" + ks + "-s") "sp-action sp-action-primary" (SpWords.pick(lang "Send" "Lähetä")))))
                    row.addChild(srow)
                }
            }
        }
        if ((SpacesApp.askOpen(e)) && (((e.fieldText("asked_by_uid")) == account.uid) && ((strlen account.uid) > 0))) {
            def dbar:EVGElement (SpacesApp.box("sp-formrow"))
            dbar.addChild((SpacesApp.btn(("sp-askedit-" + ks) "sp-link" (SpWords.pick(lang "Change" "Muokkaa")))))
            dbar.addChild((SpacesApp.btn(("sp-askdel-" + ks) "sp-link" (SpWords.pick(lang "Withdraw the question" "Peru kysymys")))))
            row.addChild(dbar)
        }
        return row
    }

    ; A press on the Questions view: true when it was one.
    fn pressAsk:boolean (target:string) {
        if (UiTree.beginsWith(target "sp-askkind-")) {
            def kd:string (substring target 11 (strlen target))
            if (kd == askKind) {
                askKind = ""
            } {
                this.openAsk(kd)
            }
            askNew = true
            return true
        }
        if (target == "sp-ask-send") {
            if (this.sendAsk()) {
                focused = ""
            }
            return true
        }
        if (target == "sp-ask-cancel") {
            askKind = ""
            askEdit = ""
            askNew = false
            formErr = ""
            focused = ""
            return true
        }
        if (target == "sp-ask-new") {
            askNew = true
            askEdit = ""
            askKind = ""
            focused = "sp-askai-text"
            return true
        }
        if (target == "sp-askmore") {
            this.press("sp-nav-questions")
            return true
        }
        if (UiTree.beginsWith(target "sp-askedit-")) {
            def en@(optional):int (to_int (substring target 11 (strlen target)))
            if (!null? en) {
                def ek:int (unwrap en)
                if ((ek >= 0) && (ek < (array_length askIds))) {
                    def found@(optional):SpEvent (space.event((itemAt askIds ek)))
                    if (!null? found) {
                        def fe:SpEvent found
                        this.editAsk(fe)
                        if (tab != "questions") {
                            this.press("sp-nav-questions")
                        }
                    }
                }
            }
            return true
        }
        if (target == "sp-askai-send") {
            this.sendAssistOf(askAiField "question")
            return true
        }
        if (UiTree.beginsWith(target "sp-askdel-")) {
            def dn@(optional):int (to_int (substring target 10 (strlen target)))
            if (!null? dn) {
                def dk:int (unwrap dn)
                if ((dk >= 0) && (dk < (array_length askIds))) {
                    this.deleteEntry((itemAt askIds dk) -1)
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-ans-")) {
            def rest:string (substring target 7 (strlen target))
            def dash:int (indexOf rest "-")
            if (dash <= 0) {
                return true
            }
            def an@(optional):int (to_int (substring rest 0 dash))
            if (null? an) {
                return true
            }
            def ak:int (unwrap an)
            if ((ak < 0) || (ak >= (array_length askIds))) {
                return true
            }
            def found@(optional):SpEvent (space.event((itemAt askIds ak)))
            if (null? found) {
                return true
            }
            def e:SpEvent found
            def what:string (substring rest (dash + 1) (strlen rest))
            if (what == "w") {
                if (askSel == e.id) {
                    askSel = ""
                } {
                    askSel = e.id
                    answerField.setValue("")
                    focused = "sp-answer-text"
                }
                return true
            }
            if (what == "y") {
                this.sendAnswer(e "yes")
                return true
            }
            if (what == "n") {
                this.sendAnswer(e "no")
                return true
            }
            if (what == "s") {
                this.sendAnswer(e answerField.value)
                return true
            }
            def on@(optional):int (to_int what)
            if (!null? on) {
                def oi:int (unwrap on)
                def opts:[string] (SpacesApp.askOptions((e.fieldText("options"))))
                if ((oi >= 0) && (oi < (array_length opts))) {
                    this.sendAnswer(e (itemAt opts oi))
                }
            }
            return true
        }
        return false
    }

    ; --- the budget ----------------------------------------------------------------------

    fn budgetStart:int () {
        if (budgetFrom < 0) {
            budgetFrom = (SpBudget.monthOfDay(today))
        }
        return budgetFrom
    }

    ; The budget shown: the server's, or worked out here.
    fn currentBudget:SpBudget () {
        def from:int (this.budgetStart())
        if server {
            if (!null? budgetAnswer) {
                def b:SpBudget budgetAnswer
                return b
            }
        }
        return (SpBudget.compute(space from (from + 5) budgetPayer))
    }

    ; On a server, ask for the months shown (once for each question).
    fn askBudget:void () {
        if ((server == false) || ((strlen spaceId) == 0)) {
            return
        }
        def from:int (this.budgetStart())
        def body:string (SpRemote.budgetBody(spaceId (SpBudget.monthText(from)) (SpBudget.monthText((from + 5))) budgetPayer))
        if (body == budgetAsked) {
            return
        }
        budgetAsked = body
        if ((this.queued("budget" "")) == false) {
            this.queue("budget" body "")
        }
    }

    ; Costs changed: the server's budget is out of date.
    fn budgetChanged:void () {
        budgetAsked = ""
        if (tab == "budget") {
            this.askBudget()
        }
    }

    fn budgetView:EVGElement () {
        if budgetOwn {
            return (this.ownView())
        }
        def v:EVGElement (SpacesApp.box("sp-view"))
        def b:SpBudget (this.currentBudget())
        def from:int (this.budgetStart())
        def range:string ((this.monthName(from)) + " – " + (this.monthName((from + 5))))
        v.addChild((this.heading((SpWords.ui(lang "budget")) range)))
        v.addChild((this.addBar()))
        v.addChild((this.budgetParts()))
        def bar:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
        bar.addChild((SpacesApp.btn("sp-bud-prev" "sp-action" (SpWords.ui(lang "earlier")))))
        bar.addChild((SpacesApp.btn("sp-bud-next" "sp-action" (SpWords.ui(lang "later")))))
        def pills:EVGElement (SpacesApp.box("sp-pills"))
        pills.role = "group"
        pills.a11yLabel = (SpWords.ui(lang "payer"))
        def allOn:boolean ((strlen budgetPayer) == 0)
        def ac:string "sp-pill"
        if allOn {
            ac = "sp-pill sp-pill-on"
        }
        def all:EVGElement (SpacesApp.btn("sp-bud-all" ac (SpWords.ui(lang "everyone"))))
        all.a11yPressed = (SpacesApp.tri(allOn))
        pills.addChild(all)
        def payers:[string] (space.payers())
        def i:int 0
        while (i < (array_length payers)) {
            def name:string (itemAt payers i)
            def on:boolean (name == budgetPayer)
            def pc:string "sp-pill"
            if on {
                pc = "sp-pill sp-pill-on"
            }
            def pb:EVGElement (SpacesApp.btn(("sp-bud-payer-" + (to_string i)) pc name))
            pb.a11yPressed = (SpacesApp.tri(on))
            def pe:string (space.emailOf(name))
            if ((strlen pe) > 0) {
                pb.a11yLabel = (name + ", " + pe)
            }
            pills.addChild(pb)
            i = (i + 1)
        }
        bar.addChild(pills)
        v.addChild(bar)
        ; the chosen person's email under the pills, where a touch screen
        ; shows no tooltip
        if (allOn == false) {
            def be:string (space.emailOf(budgetPayer))
            if ((strlen be) > 0) {
                def who:EVGElement (SpacesApp.tx("sp-meta" (budgetPayer + " · " + be)))
                who.id = "sp-bud-email"
                v.addChild(who)
            }
        }

        def sum:EVGElement (this.card("budget-sum" (SpWords.ui(lang "total"))))
        sum.addChild((this.moneyRow("sp-bud-total" (SpWords.ui(lang "total")) b.total true)))
        if allOn {
            sum.addChild((this.moneyRow("sp-bud-shared" (SpWords.ui(lang "sharedTotal")) b.shared false)))
            def k:int 0
            while (k < (array_length b.byPayer.names)) {
                def pn:string (itemAt b.byPayer.names k)
                def label:string pn
                if ((strlen pn) == 0) {
                    label = (SpWords.ui(lang "noPayer"))
                }
                sum.addChild((this.moneyRow(("sp-bud-by-" + (to_string k)) label (itemAt b.byPayer.sums k) false)))
                k = (k + 1)
            }
        }
        v.addChild(sum)
        if ((array_length b.settlements) > 0) {
            ; money paid between members to even out the costs: in the
            ; books, not costs
            def sc:EVGElement (this.card("budget-settle" (SpWords.pick(lang "Settlements" "Budjetin tasaukset"))))
            def si:int 0
            while (si < (array_length b.settlements)) {
                def sl:SpBudgetLine (itemAt b.settlements si)
                def sr:EVGElement (SpacesApp.box("sp-moneyrow"))
                sr.role = "listitem"
                def smeta:string (sl.payer + " → " + sl.to)
                def sd:int (SpTypes.dayOf(sl.date 2000))
                if (sd >= 0) {
                    smeta = ((SpWords.dayLabel(lang sd)) + " · " + smeta)
                }
                def smoney:string (SpTypes.money(lang sl.amount))
                sr.a11yLabel = (sl.title + ", " + smeta + ": " + smoney)
                def scol:EVGElement (SpacesApp.box("sp-itemtext"))
                def stt:EVGElement (SpacesApp.tx("sp-title" sl.title))
                stt.a11yHidden = true
                scol.addChild(stt)
                def smt:EVGElement (SpacesApp.tx("sp-meta" smeta))
                smt.a11yHidden = true
                scol.addChild(smt)
                sr.addChild(scol)
                def smv:EVGElement (SpacesApp.tx("sp-money" smoney))
                smv.a11yHidden = true
                sr.addChild(smv)
                sc.addChild(sr)
                si = (si + 1)
            }
            ; what each paid once the settlements are counted
            sc.addChild((SpacesApp.tx("sp-formhead" (SpWords.pick(lang "Paid, with the settlements" "Maksettu tasausten jälkeen")))))
            def sn:int 0
            while (sn < (array_length b.settled.names)) {
                def who:string (itemAt b.settled.names sn)
                def after:double ((b.byPayer.of(who)) + (itemAt b.settled.sums sn))
                sc.addChild((this.moneyRow(("sp-bud-after-" + (to_string sn)) who after false)))
                sn = (sn + 1)
            }
            v.addChild(sc)
        }
        def any:boolean false
        def m:int 0
        while (m < (array_length b.months)) {
            def bm:SpBudgetMonth (itemAt b.months m)
            if ((array_length bm.lines) > 0) {
                any = true
                def mi:int (SpBudget.monthOf(bm.month))
                def mc:EVGElement (this.card(("month-" + bm.month) (this.monthName(mi))))
                def j:int 0
                while (j < (array_length bm.lines)) {
                    def l:SpBudgetLine (itemAt bm.lines j)
                    mc.addChild((this.budgetLine(l)))
                    j = (j + 1)
                }
                mc.addChild((this.moneyRow("" (SpWords.ui(lang "total")) bm.total true)))
                v.addChild(mc)
            }
            m = (m + 1)
        }
        if (any == false) {
            v.addChild((SpacesApp.tx("sp-empty" (SpWords.ui(lang "noCosts")))))
        }
        return v
    }

    fn monthName:string (idx:int) {
        def y:int (idiv idx 12)
        def m:int ((idx - (y * 12)) + 1)
        def fi:[string] ([] _:string ( "tammikuu" "helmikuu" "maaliskuu" "huhtikuu" "toukokuu" "kesäkuu" "heinäkuu" "elokuu" "syyskuu" "lokakuu" "marraskuu" "joulukuu" ))
        def en:[string] ([] _:string ( "January" "February" "March" "April" "May" "June" "July" "August" "September" "October" "November" "December" ))
        if (lang == "fi") {
            return ((itemAt fi (m - 1)) + " " + (to_string y))
        }
        return ((itemAt en (m - 1)) + " " + (to_string y))
    }

    fn moneyRow:EVGElement (id:string label:string v:double strong:boolean) {
        def row:EVGElement (UiTree.div(id "sp-moneyrow"))
        row.role = "listitem"
        def money:string (SpTypes.money(lang v))
        row.a11yLabel = (label + ": " + money)
        def lb:EVGElement (SpacesApp.tx("sp-moneylabel" label))
        lb.a11yHidden = true
        row.addChild(lb)
        row.addChild((SpacesApp.box("sp-grow")))
        def cls:string "sp-money"
        if strong {
            cls = "sp-money sp-money-strong"
        }
        def mv:EVGElement (SpacesApp.tx(cls money))
        mv.a11yHidden = true
        row.addChild(mv)
        return row
    }

    fn budgetLine:EVGElement (l:SpBudgetLine) {
        def row:EVGElement (SpacesApp.box("sp-moneyrow"))
        row.role = "listitem"
        def parts:[string]
        def d:int (SpTypes.dayOf(l.date 2000))
        if (d >= 0) {
            push parts (SpWords.dayLabel(lang d))
        }
        if (l.of > 1) {
            push parts ((to_string l.n) + "/" + (to_string l.of))
        }
        if ((strlen l.payer) > 0) {
            push parts l.payer
        }
        push parts (SpWords.ui(lang l.scope))
        def meta:string (join parts " · ")
        def money:string (SpTypes.money(lang l.amount))
        row.a11yLabel = (l.title + ", " + meta + ": " + money)
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        def tt:EVGElement (SpacesApp.tx("sp-title" l.title))
        tt.a11yHidden = true
        col.addChild(tt)
        def mt:EVGElement (SpacesApp.tx("sp-meta" meta))
        mt.a11yHidden = true
        col.addChild(mt)
        row.addChild(col)
        def mv:EVGElement (SpacesApp.tx("sp-money" money))
        mv.a11yHidden = true
        row.addChild(mv)
        return row
    }

    ; --- the own budget ----------------------------------------------------------------
    ; The person's own money, which only they see: what is left of a month
    ; on average and month by month, the items by kind, and the form that
    ; adds or changes one.

    ; The two parts of the Budget view: the family's and the person's own.
    fn budgetParts:EVGElement () {
        def pills:EVGElement (UiTree.div("sp-bud-parts" "sp-pills"))
        pills.role = "group"
        pills.a11yLabel = (SpWords.ui(lang "budget"))
        def fc:string "sp-pill"
        def oc:string "sp-pill"
        if budgetOwn {
            oc = "sp-pill sp-pill-on"
        } {
            fc = "sp-pill sp-pill-on"
        }
        def fam:EVGElement (SpacesApp.btn("sp-bud-part-family" fc (SpWords.noun(lang pack "together"))))
        fam.a11yPressed = (SpacesApp.tri((budgetOwn == false)))
        pills.addChild(fam)
        def mine:EVGElement (SpacesApp.btn("sp-bud-part-own" oc (SpWords.pick(lang "🔒 My own" "🔒 Oma talous"))))
        mine.a11yPressed = (SpacesApp.tri(budgetOwn))
        pills.addChild(mine)
        return pills
    }

    ; On a server, read the person's own items once.
    fn askOwn:void () {
        if ((server == false) || own.loaded) {
            return
        }
        if ((this.queued("own_budget" "")) == false) {
            this.queue("own_budget" "{}" "")
        }
    }

    sfn ownKindName:string (lang:string kind:string) {
        if (kind == "regular_income") {
            return (SpWords.pick(lang "Regular income" "Säännölliset tulot"))
        }
        if (kind == "regular_expense") {
            return (SpWords.pick(lang "Regular expenses" "Säännölliset menot"))
        }
        if (kind == "estimate") {
            return (SpWords.pick(lang "Estimated budget" "Arviobudjetti"))
        }
        if (kind == "irregular_income") {
            return (SpWords.pick(lang "Irregular income" "Epäsäännölliset tulot"))
        }
        return (SpWords.pick(lang "Irregular and surprise expenses" "Epäsäännölliset ja yllättävät menot"))
    }

    ; one item of the kind, for the form's buttons and its hint
    sfn ownKindOne:string (lang:string kind:string) {
        if (kind == "regular_income") {
            return (SpWords.pick(lang "Regular income" "Säännöllinen tulo"))
        }
        if (kind == "regular_expense") {
            return (SpWords.pick(lang "Regular expense" "Säännöllinen meno"))
        }
        if (kind == "estimate") {
            return (SpWords.pick(lang "Estimate" "Arvio"))
        }
        if (kind == "irregular_income") {
            return (SpWords.pick(lang "Irregular income" "Epäsäännöllinen tulo"))
        }
        return (SpWords.pick(lang "Irregular expense" "Epäsäännöllinen meno"))
    }

    sfn ownKindHint:string (lang:string kind:string) {
        if (kind == "regular_income") {
            return (SpWords.pick(lang "e.g. salary" "esim. palkka"))
        }
        if (kind == "regular_expense") {
            return (SpWords.pick(lang "e.g. rent, car insurance" "esim. vuokra, autovakuutus"))
        }
        if (kind == "estimate") {
            return (SpWords.pick(lang "e.g. food, fuel" "esim. ruoka, polttoaine"))
        }
        if (kind == "irregular_income") {
            return (SpWords.pick(lang "e.g. tax refund" "esim. veronpalautus"))
        }
        return (SpWords.pick(lang "e.g. car repair" "esim. auton korjaus"))
    }

    fn ownEveryText:string (n:int) {
        if (n <= 1) {
            return (SpWords.pick(lang "monthly" "kuukausittain"))
        }
        if (n == 12) {
            return (SpWords.pick(lang "yearly" "vuosittain"))
        }
        return ((to_string n) + (SpWords.pick(lang " months apart" " kk välein")))
    }

    fn ownView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        v.addChild((this.heading((SpWords.ui(lang "budget")) (SpWords.pick(lang "My own money: only you see this part" "Oma talous: tämän osan näet vain sinä")))))
        v.addChild((this.budgetParts()))
        if (server && (own.loaded == false)) {
            v.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "Reading…" "Luetaan…")))))
        }
        def now:int (SpBudget.monthOfDay(today))
        def avg:[double] (own.monthly(now))
        def inc:double (itemAt avg 0)
        def exp:double (itemAt avg 1)
        def sum:EVGElement (this.card("own-sum" (SpWords.pick(lang "A month on average" "Kuukaudessa keskimäärin"))))
        sum.addChild((this.moneyRow("sp-own-in" (SpWords.pick(lang "Income" "Tulot")) inc false)))
        sum.addChild((this.moneyRow("sp-own-out" (SpWords.pick(lang "Expenses" "Menot")) exp false)))
        sum.addChild((this.moneyRow("sp-own-left" (SpWords.pick(lang "Left to spend" "Käytettävissä")) (inc - exp) true)))
        sum.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "Regular income and expenses and the estimates, spread over the months." "Säännölliset tulot ja menot sekä arviot kuukausille jaettuna.")))))
        v.addChild(sum)

        def from:int (this.budgetStart())
        def bar:EVGElement (SpacesApp.box("sp-tabs sp-wrap"))
        bar.addChild((SpacesApp.btn("sp-bud-prev" "sp-action" (SpWords.ui(lang "earlier")))))
        bar.addChild((SpacesApp.btn("sp-bud-next" "sp-action" (SpWords.ui(lang "later")))))
        v.addChild(bar)
        def mc:EVGElement (this.card("own-months" (SpWords.pick(lang "Month by month" "Kuukausittain"))))
        def m:int 0
        while (m < 6) {
            def om:SpOwnMonth (own.month((from + m)))
            mc.addChild((this.moneyRow(("sp-own-m-" + (to_string m)) (this.monthName((from + m))) (om.income - om.expenses) true)))
            def parts:[string]
            push parts ((SpWords.pick(lang "income " "tulot ")) + (SpTypes.money(lang om.income)))
            push parts ((SpWords.pick(lang "expenses " "menot ")) + (SpTypes.money(lang om.expenses)))
            def j:int 0
            while (j < (array_length om.lines)) {
                def l:SpOwnItem (itemAt om.lines j)
                if (SpOwn.isOnce(l.kind)) {
                    def sign:string "−"
                    if (SpOwn.isIncome(l.kind)) {
                        sign = "+"
                    }
                    push parts (l.title + " " + sign + (SpTypes.money(lang l.amount)))
                }
                j = (j + 1)
            }
            mc.addChild((SpacesApp.tx("sp-meta" (join parts " · "))))
            m = (m + 1)
        }
        v.addChild(mc)

        def kinds:[string] (SpOwn.kinds())
        def k:int 0
        while (k < (array_length kinds)) {
            def kind:string (itemAt kinds k)
            def kc:EVGElement (this.card(("own-" + kind) (SpacesApp.ownKindName(lang kind))))
            def any:boolean false
            def i:int 0
            while (i < (array_length own.items)) {
                def it:SpOwnItem (itemAt own.items i)
                if (it.kind == kind) {
                    any = true
                    kc.addChild((this.ownRow(it i)))
                }
                i = (i + 1)
            }
            if (any == false) {
                kc.addChild((SpacesApp.tx("sp-meta" (SpWords.pick(lang "None yet" "Ei vielä yhtään")))))
            }
            v.addChild(kc)
            k = (k + 1)
        }
        v.addChild((this.ownForm()))
        return v
    }

    fn ownRow:EVGElement (it:SpOwnItem i:int) {
        def row:EVGElement (SpacesApp.box("sp-moneyrow"))
        row.role = "listitem"
        def parts:[string]
        if (SpOwn.isOnce(it.kind)) {
            if ((strlen it.date) > 0) {
                push parts (this.dateShown(it.date))
            }
        } {
            push parts (this.ownEveryText(it.every))
            if ((strlen it.date) > 0) {
                push parts ((SpWords.pick(lang "from " "alkaen ")) + (this.dateShown(it.date)))
            }
            if ((strlen it.until) > 0) {
                push parts ((SpWords.pick(lang "until " "päättyy ")) + (this.dateShown(it.until)))
            }
        }
        if ((strlen it.note) > 0) {
            push parts it.note
        }
        def meta:string (join parts " · ")
        def money:string (SpTypes.money(lang it.amount))
        row.a11yLabel = (it.title + ", " + meta + ": " + money)
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        def tt:EVGElement (SpacesApp.tx("sp-title" it.title))
        tt.a11yHidden = true
        col.addChild(tt)
        def mt:EVGElement (SpacesApp.tx("sp-meta" meta))
        mt.a11yHidden = true
        col.addChild(mt)
        row.addChild(col)
        def mv:EVGElement (SpacesApp.tx("sp-money" money))
        mv.a11yHidden = true
        row.addChild(mv)
        row.addChild((SpacesApp.btn(("sp-own-ed-" + (to_string i)) "sp-action" (SpWords.pick(lang "Change" "Muuta")))))
        row.addChild((SpacesApp.btn(("sp-own-rm-" + (to_string i)) "sp-action" (SpWords.ui(lang "remove")))))
        return row
    }

    fn ownForm:EVGElement () {
        def title:string (SpWords.pick(lang "Add to my own budget" "Lisää omaan talouteen"))
        if ((strlen ownEdit) > 0) {
            title = (SpWords.pick(lang "Change" "Muuta"))
        }
        def c:EVGElement (this.card("own-form" title))
        def pills:EVGElement (SpacesApp.box("sp-pills sp-wrap"))
        pills.role = "group"
        pills.a11yLabel = (SpWords.pick(lang "Kind" "Laji"))
        def kinds:[string] (SpOwn.kinds())
        def k:int 0
        while (k < (array_length kinds)) {
            def kind:string (itemAt kinds k)
            def on:boolean (kind == ownKind)
            def pc:string "sp-pill"
            if on {
                pc = "sp-pill sp-pill-on"
            }
            def pb:EVGElement (SpacesApp.btn(("sp-own-kind-" + (to_string k)) pc (SpacesApp.ownKindOne(lang kind))))
            pb.a11yPressed = (SpacesApp.tri(on))
            pills.addChild(pb)
            k = (k + 1)
        }
        c.addChild(pills)
        def row:EVGElement (SpacesApp.box("sp-formrow"))
        row.addChild((this.field(ownTitle "sp-own-title" (SpWords.pick(lang "What" "Mikä")) (SpacesApp.ownKindHint(lang ownKind)) "text")))
        row.addChild((this.field(ownAmount "sp-own-amount" (SpWords.pick(lang "Amount (€)" "Summa (€)")) "0" "text")))
        c.addChild(row)
        def once:boolean (SpOwn.isOnce(ownKind))
        if (once == false) {
            def ep:EVGElement (SpacesApp.box("sp-pills sp-wrap"))
            ep.role = "group"
            ep.a11yLabel = (SpWords.pick(lang "How often" "Kuinka usein"))
            def evs:[int] ([] _:int ( 1 3 6 12 ))
            def e:int 0
            while (e < (array_length evs)) {
                def n:int (itemAt evs e)
                def eon:boolean (n == ownEvery)
                def ec:string "sp-pill"
                if eon {
                    ec = "sp-pill sp-pill-on"
                }
                def eb:EVGElement (SpacesApp.btn(("sp-own-every-" + (to_string n)) ec (this.ownEveryText(n))))
                eb.a11yPressed = (SpacesApp.tri(eon))
                ep.addChild(eb)
                e = (e + 1)
            }
            c.addChild(ep)
        }
        def dates:EVGElement (SpacesApp.box("sp-formrow"))
        if once {
            dates.addChild((this.ownDateField("date" (SpWords.pick(lang "Day" "Päivä")) ownDate)))
        } {
            dates.addChild((this.ownDateField("date" (SpWords.pick(lang "First payment" "Ensimmäinen maksu")) ownDate)))
            dates.addChild((this.ownDateField("until" (SpWords.pick(lang "Ends" "Päättyy")) ownUntil)))
        }
        c.addChild(dates)
        def btns:EVGElement (SpacesApp.box("sp-formrow"))
        def save:string (SpWords.ui(lang "addOne"))
        if ((strlen ownEdit) > 0) {
            save = (SpWords.pick(lang "Save" "Tallenna"))
            btns.addChild((SpacesApp.btn("sp-own-cancel" "sp-action" (SpWords.ui(lang "cancel")))))
        }
        btns.addChild((SpacesApp.btn("sp-own-save" "sp-action sp-action-primary" save)))
        c.addChild(btns)
        return c
    }

    ; A day of the own form: a button with the day on it, and while it is
    ; open EVGUI's calendar under it with Today and Clear.
    fn ownDateField:EVGElement (which:string label:string v:string) {
        def w:double 200.0
        if (this.narrow()) {
            w = (this.formW())
        }
        def open:boolean (ownDateOpen == which)
        def bw:double w
        if (open && (w < 300.0)) {
            w = 300.0
        }
        def box:EVGElement (SpacesApp.box("sp-fld"))
        UiTree.inline(box "width" (SpacesApp.px(w)))
        def lb:EVGElement (SpacesApp.tx("sp-fldlabel" label))
        lb.a11yHidden = true
        box.addChild(lb)
        def shown:string (this.dateShown(v))
        def cls:string "sp-datebtn"
        if ((strlen v) == 0) {
            shown = (SpWords.pick(lang "Pick a day" "Valitse päivä"))
            cls = "sp-datebtn sp-datebtn-empty"
        }
        if open {
            cls = (cls + " sp-datebtn-open")
        }
        def b:EVGElement (SpacesApp.btn(("sp-owndate-" + which) cls ("📅 " + shown)))
        b.a11yLabel = ((label + ", ") + shown)
        b.a11yHasPopup = "dialog"
        b.a11yExpanded = (SpacesApp.tri(open))
        UiTree.inline(b "width" (SpacesApp.px(bw)))
        box.addChild(b)
        if open {
            UiTree.dress(ownPick)
            def cal:EVGElement (unwrap ownPick.rootEl)
            cal.a11yLabel = label
            box.addChild(cal)
            def row:EVGElement (SpacesApp.box("sp-formrow"))
            row.addChild((SpacesApp.btn("sp-odp-today" "sp-opt" (SpWords.pick(lang "Today" "Tänään")))))
            if ((strlen v) > 0) {
                row.addChild((SpacesApp.btn("sp-odp-clear" "sp-opt" (SpWords.pick(lang "Clear" "Tyhjennä")))))
            }
            box.addChild(row)
        }
        return box
    }

    fn openOwnDate:void (which:string) {
        ownDateOpen = which
        def v:string ownDate
        if (which == "until") {
            v = ownUntil
        }
        def p:[int] (SpSpace.ymdOf(today))
        def pick (new CalendarCtl())
        pick.tid = "sp-odp"
        if (lang == "fi") {
            pick.lang = "fi"
        }
        pick.weekStart = 1
        pick.setToday((itemAt p 0) (itemAt p 1) (itemAt p 2))
        pick.setMonth((itemAt p 0) (itemAt p 1))
        pick.startYear = ((itemAt p 0) - 15)
        pick.endYear = ((itemAt p 0) + 10)
        def d:int (SpTypes.dayOf(v (itemAt p 0)))
        if (d >= 0) {
            def q:[int] (SpSpace.ymdOf(d))
            pick.setSelected((itemAt q 0) (itemAt q 1) (itemAt q 2))
            pick.setMonth((itemAt q 0) (itemAt q 1))
        }
        ownPick = pick
        focused = (pick.dayTid((pick.currentFocusDay())))
    }

    fn putOwnDate:void (d:int) {
        def v:string ""
        if (d >= 0) {
            v = (UiDate.isoOfDays(d))
        }
        if (ownDateOpen == "until") {
            ownUntil = v
        } {
            ownDate = v
        }
        focused = ("sp-owndate-" + ownDateOpen)
        ownDateOpen = ""
    }

    fn ownReset:void () {
        ownEdit = ""
        ownTitle.setValue("")
        ownAmount.setValue("")
        ownDate = ""
        ownUntil = ""
        ownDateOpen = ""
        ownEvery = 1
    }

    ; The form's item saved: on the page, and on a server for the person.
    fn ownSave:void () {
        def t:string (trim ownTitle.value)
        if ((strlen t) == 0) {
            status = (SpWords.pick(lang "Write what it is" "Kirjoita, mikä se on"))
            focused = "sp-own-title"
            return
        }
        def at:string (trim ownAmount.value)
        if ((SpTypes.readsAsNumber(at)) == false) {
            status = (SpWords.pick(lang "Write the amount in euros" "Kirjoita summa euroina"))
            focused = "sp-own-amount"
            return
        }
        def once:boolean (SpOwn.isOnce(ownKind))
        if (once && ((strlen ownDate) == 0)) {
            status = (SpWords.pick(lang "Pick its day" "Valitse päivä"))
            focused = "sp-owndate-date"
            return
        }
        def it (new SpOwnItem())
        it.added = (SpBudget.monthText((SpBudget.monthOfDay(today))))
        def was:int (own.indexOf(ownEdit))
        if (was >= 0) {
            def old:SpOwnItem (itemAt own.items was)
            it.id = old.id
            it.added = old.added
            it.note = old.note
        } {
            ownSeq = (ownSeq + 1)
            it.id = ("n" + (to_string ownSeq))
        }
        it.kind = ownKind
        it.title = t
        it.amount = (SpTypes.amountOf(at))
        it.date = ownDate
        if (once == false) {
            it.every = ownEvery
            it.until = ownUntil
        }
        own.put(it)
        if (server && ((this.queued("save_own_item" it.id)) == false)) {
            this.queue("save_own_item" "" it.id)
        }
        status = ((SpWords.pick(lang "Saved " "Tallennettu ")) + t)
        this.ownReset()
    }

    ; The server saved the page's item `ref` as `id`: an item new on the page
    ; takes its id, and so do the calls still waiting for it.
    fn ownSaved:void (ref:string id:string) {
        if (((strlen id) == 0) || (ref == id)) {
            return
        }
        def at:int (own.indexOf(ref))
        if (at < 0) {
            ; removed while it was on its way: now it has an id to delete
            this.queue("delete_own_item" (SpRemote.body(([] _:string ( "item_id" id )))) id)
            return
        }
        def it:SpOwnItem (itemAt own.items at)
        it.id = id
        if (ownEdit == ref) {
            ownEdit = id
        }
        def i:int 0
        while (i < (array_length outbox)) {
            def c:SpCall (itemAt outbox i)
            if ((c.op == "save_own_item") && (c.ref == ref)) {
                c.ref = id
            }
            i = (i + 1)
        }
    }

    ; A press in the own budget: true when it was one.
    fn pressOwn:boolean (target:string) {
        if (target == "sp-bud-part-own") {
            budgetOwn = true
            this.askOwn()
            return true
        }
        if (target == "sp-bud-part-family") {
            budgetOwn = false
            this.askBudget()
            return true
        }
        if (UiTree.beginsWith(target "sp-owndate-")) {
            def which:string (substring target 11 (strlen target))
            if (which == ownDateOpen) {
                ownDateOpen = ""
            } {
                this.openOwnDate(which)
            }
            return true
        }
        if ((strlen ownDateOpen) > 0) {
            if (target == "sp-odp-today") {
                this.putOwnDate(today)
                return true
            }
            if (target == "sp-odp-clear") {
                this.putOwnDate(-1)
                return true
            }
            if (UiTree.beginsWith(target "sp-odp")) {
                def day:int (ownPick.dayOfTid(target))
                if (day >= 0) {
                    if ((ownPick.isDisabledDay(day)) == false) {
                        this.putOwnDate(day)
                    }
                    return true
                }
                ownPick.activate(target)
                return true
            }
        }
        if ((UiTree.beginsWith(target "sp-own-")) == false) {
            return false
        }
        ownDateOpen = ""
        if (UiTree.beginsWith(target "sp-own-kind-")) {
            def kn@(optional):int (to_int (substring target 12 (strlen target)))
            if (!null? kn) {
                def kinds:[string] (SpOwn.kinds())
                def kk:int (unwrap kn)
                if ((kk >= 0) && (kk < (array_length kinds))) {
                    ownKind = (itemAt kinds kk)
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-own-every-")) {
            def en@(optional):int (to_int (substring target 13 (strlen target)))
            if (!null? en) {
                ownEvery = (unwrap en)
            }
            return true
        }
        if (target == "sp-own-save") {
            this.ownSave()
            return true
        }
        if (target == "sp-own-cancel") {
            this.ownReset()
            return true
        }
        if (UiTree.beginsWith(target "sp-own-ed-")) {
            def n@(optional):int (to_int (substring target 10 (strlen target)))
            if (!null? n) {
                def k:int (unwrap n)
                if ((k >= 0) && (k < (array_length own.items))) {
                    def it:SpOwnItem (itemAt own.items k)
                    ownEdit = it.id
                    ownKind = it.kind
                    ownEvery = it.every
                    ownTitle.setValue(it.title)
                    ownAmount.setValue((to_string it.amount))
                    ownDate = it.date
                    ownUntil = it.until
                    focused = "sp-own-title"
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-own-rm-")) {
            def n2@(optional):int (to_int (substring target 10 (strlen target)))
            if (!null? n2) {
                def k2:int (unwrap n2)
                if ((k2 >= 0) && (k2 < (array_length own.items))) {
                    def gone:SpOwnItem (itemAt own.items k2)
                    own.drop(gone.id)
                    if (ownEdit == gone.id) {
                        this.ownReset()
                    }
                    if (server && ((substring gone.id 0 1) != "n")) {
                        this.queue("delete_own_item" (SpRemote.body(([] _:string ( "item_id" gone.id )))) gone.id)
                    }
                    status = ((SpWords.pick(lang "Removed " "Poistettu ")) + gone.title)
                }
            }
            return true
        }
        return false
    }

    ; A press on the form, the Add menu, the lists or the budget: true when
    ; it was one.
    fn pressEntries:boolean (target:string) {
        if (target == "sp-add") {
            this.toggleAdd()
            return true
        }
        if (target == "sp-add-manual") {
            addManual = (addManual == false)
            if addManual {
                focused = "sp-addsearch"
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-addgrp-")) {
            def gid:string (substring target 10 (strlen target))
            if (gid == addGroup) {
                addGroup = ""
            } {
                addGroup = gid
            }
            return true
        }
        if (target == "sp-addfirst") {
            def hits:[SpType] (this.addMatches())
            if ((array_length hits) > 0) {
                def first:SpType (itemAt hits 0)
                this.openNew(first.id)
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-addtype-")) {
            this.openNew((substring target 11 (strlen target)))
            return true
        }
        if (target == "sp-undo") {
            this.undo()
            return true
        }
        if (target == "sp-ed-save") {
            this.saveForm()
            return true
        }
        if (target == "sp-plan-add") {
            this.addText(("plan:" + (to_string (array_length (this.planKeys())))) "")
            this.openDate(((array_length formKeys) - 1))
            return true
        }
        if (target == "sp-ed-cancel") {
            editing = false
            focused = ""
            return true
        }
        if (target == "sp-ed-delete") {
            this.deleteEntry(editId -1)
            return true
        }
        if (target == "sp-ed-delday") {
            this.deleteEntry(editId editOcc)
            return true
        }
        if (target == "sp-ed-ics") {
            def found2@(optional):SpEvent (space.event(editId))
            if (!null? found2) {
                def e2:SpEvent found2
                action = ("open:ics/" + space.remoteId + "/" + e2.remoteId + ".ics")
            }
            return true
        }
        if (target == "sp-ed-showcal") {
            def found@(optional):SpEvent (space.event(editId))
            if (!null? found) {
                def e:SpEvent found
                board.cursor = e.day
                if (editOcc >= 0) {
                    board.cursor = editOcc
                }
                board.view = "day"
                board.applySettings()
            }
            editing = false
            tab = "calendar"
            focused = ""
            return true
        }
        if (UiTree.beginsWith(target "sp-tog-")) {
            def n@(optional):int (to_int (substring target 7 (strlen target)))
            if (!null? n) {
                def k:int (unwrap n)
                if ((k >= 0) && (k < (array_length pickVals))) {
                    if ((itemAt pickVals k) == "true") {
                        set pickVals k "false"
                    } {
                        set pickVals k "true"
                    }
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-pick-")) {
            def rest:string (substring target 8 (strlen target))
            def dash:int (indexOf rest "-")
            if (dash > 0) {
                def a@(optional):int (to_int (substring rest 0 dash))
                def b@(optional):int (to_int (substring rest (dash + 1) (strlen rest)))
                if ((!null? a) && (!null? b)) {
                    def pi:int (unwrap a)
                    def oi:int (unwrap b)
                    if ((pi >= 0) && (pi < (array_length pickKeys))) {
                        def opts:[string] (this.pickOptions((itemAt pickKeys pi)))
                        if ((oi >= 0) && (oi < (array_length opts))) {
                            set pickVals pi (itemAt opts oi)
                        }
                    }
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-entry-")) {
            this.openOcc((substring target 9 (strlen target)))
            return true
        }
        if (UiTree.beginsWith(target "sp-linkopen-")) {
            this.openOcc((substring target 12 (strlen target)))
            return true
        }
        if (UiTree.beginsWith(target "sp-linkadd-")) {
            this.linkEdited((substring target 11 (strlen target)) true)
            return true
        }
        if (UiTree.beginsWith(target "sp-unlink-")) {
            this.linkEdited((substring target 10 (strlen target)) false)
            return true
        }
        if (UiTree.beginsWith(target "sp-list-")) {
            listType = (substring target 8 (strlen target))
            return true
        }
        if ((target == "sp-bud-prev") || (target == "sp-bud-next")) {
            def from:int (this.budgetStart())
            if (target == "sp-bud-prev") {
                budgetFrom = (from - 6)
            } {
                budgetFrom = (from + 6)
            }
            this.askBudget()
            return true
        }
        if (target == "sp-bud-all") {
            budgetPayer = ""
            this.askBudget()
            return true
        }
        if (UiTree.beginsWith(target "sp-bud-payer-")) {
            def pn@(optional):int (to_int (substring target 13 (strlen target)))
            if (!null? pn) {
                def payers:[string] (space.payers())
                def pk:int (unwrap pn)
                if ((pk >= 0) && (pk < (array_length payers))) {
                    budgetPayer = (itemAt payers pk)
                }
            }
            this.askBudget()
            return true
        }
        return false
    }

    ; =========================================================================
    ; input
    ; =========================================================================

    fn onBoard:boolean (id:string) {
        return (board.owns(id))
    }

    fn press:boolean (target:string) {
        status = ""
        if (target != "sp-undo") {
            undoKind = ""
        }
        if (target == "") {
            def wasOpen:boolean ((dateOpen >= 0) || ((strlen ownDateOpen) > 0))
            dateOpen = -1
            ownDateOpen = ""
            if ((board.closeOverlays()) || wasOpen) {
                this.rebuild()
            }
            return false
        }
        if (this.onBoard(target)) {
            board.focused = focused
            board.hovered = hovered
            def r:boolean (board.press(target))
            focused = board.focused
            this.syncBack()
            this.rebuild()
            return r
        }
        board.closeOverlays()
        focused = target
        if (this.pressDate(target)) {
            this.rebuild()
            return true
        }
        dateOpen = -1
        if (this.pressOwn(target)) {
            this.rebuild()
            return true
        }
        def asField@(optional):InputCtl (this.fieldOf(target))
        if (!null? asField) {
            def fc:InputCtl asField
            focused = fc.tid
            this.rebuild()
            return true
        }
        if (this.pressAsk(target)) {
            this.rebuild()
            return true
        }
        if (this.pressEntries(target)) {
            this.rebuild()
            return true
        }
        if (server && (this.pressServer(target))) {
            this.rebuild()
            return true
        }
        if (server && (this.pressInfo(target))) {
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-wxplace-")) {
            def wn@(optional):int (to_int (substring target 11 (strlen target)))
            def all:[SpWeather] (this.shownWeather())
            if (!null? wn) {
                def wk:int (unwrap wn)
                if ((wk >= 0) && (wk < (array_length all))) {
                    def ww:SpWeather (itemAt all wk)
                    wxSel = ww.place
                }
            }
            this.rebuild()
            return true
        }
        if (target == "sp-phone") {
            phoneOpen = (phoneOpen == false)
            this.rebuild()
            return true
        }
        if (target == "sp-phone-close") {
            phoneOpen = false
            focused = "sp-phone"
            this.rebuild()
            return true
        }
        if (target == "sp-menu") {
            menuOpen = (menuOpen == false)
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-nav-")) {
            menuOpen = false
            tab = (substring target 7 (strlen target))
            editing = false
            addOpen = false
            if (tab == "budget") {
                this.askBudget()
                if budgetOwn {
                    this.askOwn()
                }
            }
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-pack-")) {
            pack = (substring target 8 (strlen target))
            this.load()
            return true
        }
        if (UiTree.beginsWith(target "sp-lang-")) {
            lang = (substring target 8 (strlen target))
            this.load()
            return true
        }
        if ((target == "sp-cal-gets") || (target == "sp-cal-pays")) {
            if (target == "sp-cal-gets") {
                showGets = (showGets == false)
            } {
                showPays = (showPays == false)
            }
            this.fillBoard()
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-item-")) {
            ; an event opens in the form; a sheet's row on the calendar
            def occ:string (this.occOfTarget(target))
            if ((strlen (space.eventIdOf(occ))) > 0) {
                this.openOcc(occ)
                this.rebuild()
                return true
            }
            def n@(optional):int (to_int (substring target 8 (strlen target)))
            if (!null? n) {
                def k:int (unwrap n)
                if ((k >= 0) && (k < (array_length itemDays))) {
                    board.cursor = (itemAt itemDays k)
                    board.view = "day"
                    board.applySettings()
                    tab = "calendar"
                    focused = ""
                }
            }
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-done-")) {
            ; a deadline of the page's own, ticked off on the summary
            def did:string (substring target 8 (strlen target))
            def i:int 0
            while (i < (array_length space.deadlines)) {
                def d:SpDeadline (itemAt space.deadlines i)
                if (d.id == did) {
                    d.done = true
                    status = ((SpWords.pick(lang "Done: " "Tehty: ")) + d.title)
                }
                i = (i + 1)
            }
            focused = ""
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-htab-")) {
            homeTab = (substring target 8 (strlen target))
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-tick-")) {
            ; an entry ticked off on the summary: its status is done, saved
            ; like any change
            def e@(optional):SpEvent (space.event((substring target 8 (strlen target))))
            if (!null? e) {
                def ev:SpEvent (unwrap e)
                ev.setField("status" "done" "string")
                ev.touch()
                status = ((SpWords.pick(lang "Done: " "Tehty: ")) + ev.title)
                this.queueSaves()
            }
            focused = ""
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-day-")) {
            def dn@(optional):int (to_int (substring target 7 (strlen target)))
            if (!null? dn) {
                board.cursor = (unwrap dn)
                board.view = "day"
                board.applySettings()
                tab = "calendar"
                focused = ""
            }
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-opensheet-")) {
            sheetSel = (substring target 13 (strlen target))
            tab = "sheets"
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-sheet-")) {
            sheetSel = (substring target 9 (strlen target))
            this.rebuild()
            return true
        }
        if (target == "sp-import") {
            action = "import"
            return true
        }
        if (UiTree.beginsWith(target "sp-export-")) {
            action = ("export:" + (substring target 10 (strlen target)))
            return true
        }
        if (UiTree.beginsWith(target "sp-doc-")) {
            docSel = (substring target 7 (strlen target))
            this.rebuild()
            return true
        }
        if (target == "sp-write-summary") {
            this.writeDoc("summary")
            this.rebuild()
            return true
        }
        if (target == "sp-write-plan") {
            this.writeDoc("plan")
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-q-")) {
            this.ask((substring target 5 (strlen target)))
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-turl-")) {
            def ui@(optional):int (to_int (substring target 8 (strlen target)))
            if (!null? ui) {
                def un:int (unwrap ui)
                if ((un >= 0) && (un < (array_length linkUrls))) {
                    action = ("open:" + (itemAt linkUrls un))
                }
            }
            this.rebuild()
            return true
        }
        if (UiTree.beginsWith(target "sp-copy-")) {
            this.copyRow((substring target 8 (strlen target)))
            this.rebuild()
            return true
        }
        this.rebuild()
        return false
    }

    ; =========================================================================
    ; a space on a server
    ; =========================================================================

    ; The page's first call: who is signed in, and their spaces.
    fn start:void () {
        if (server == false) {
            return
        }
        loading = true
        this.queue("list_spaces" "{}" "")
        this.rebuild()
    }

    fn queue:SpCall (op:string body:string ref:string) {
        def c (new SpCall())
        c.op = op
        c.body = body
        c.ref = ref
        push outbox c
        return c
    }

    fn outCount:int () {
        return (array_length outbox)
    }

    ; The first call's op, "" when there is none.
    fn outOp:string () {
        if ((array_length outbox) == 0) {
            return ""
        }
        def c:SpCall (itemAt outbox 0)
        return c.op
    }

    ; The first call's body. An event's is taken now, so it carries every
    ; change made while it waited.
    fn outBody:string () {
        if ((array_length outbox) == 0) {
            return "{}"
        }
        def c:SpCall (itemAt outbox 0)
        if (c.op == "save_own_item") {
            def oat:int (own.indexOf(c.ref))
            if (oat >= 0) {
                c.body = (SpOwn.saveBody((itemAt own.items oat)))
            }
        }
        if (c.op == "save_event") {
            def found@(optional):SpEvent (space.event(c.ref))
            if (!null? found) {
                def e:SpEvent found
                c.rev = e.rev
                c.body = (SpRemote.saveBody(spaceId e))
            }
        }
        return c.body
    }

    fn takeFirst:SpCall () {
        def c:SpCall (itemAt outbox 0)
        def rest:[SpCall]
        def i:int 1
        while (i < (array_length outbox)) {
            push rest (itemAt outbox i)
            i = (i + 1)
        }
        outbox = rest
        return c
    }

    fn queued:boolean (op:string ref:string) {
        def i:int 0
        while (i < (array_length outbox)) {
            def c:SpCall (itemAt outbox i)
            if ((c.op == op) && (c.ref == ref)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; A save_event for every changed event that has none waiting. One at a
    ; time per event: a new event has no id on the server until its first
    ; save is answered.
    fn queueSaves:void () {
        if ((server == false) || ((strlen spaceId) == 0)) {
            return
        }
        def dirty:[SpEvent] (space.dirtyEvents())
        def i:int 0
        while (i < (array_length dirty)) {
            def e:SpEvent (itemAt dirty i)
            if ((this.queued("save_event" e.id)) == false) {
                this.queue("save_event" "" e.id)
            }
            i = (i + 1)
        }
    }

    fn openSpace:void (id:string) {
        spaceId = id
        loading = true
        tab = "home"
        this.queue("get_space" (SpRemote.body(([] _:string ( "space_id" id )))) id)
    }

    ; Live changes: the host asks every few seconds (`poll`) whether the
    ; space changed on the server, when nothing of the page's own is on its
    ; way. A change made elsewhere (an assistant through Warden's MCP server,
    ; another member's page) reads the space again, once the page is idle:
    ; no form open and nothing left to save. False: nothing was asked.
    fn poll:boolean () {
        if (((server == false) || ((strlen spaceId) == 0)) || loading) {
            return false
        }
        if ((array_length outbox) > 0) {
            return false
        }
        if (stale && (this.idle())) {
            this.reload()
            return true
        }
        this.queue("changes" (SpRemote.body(([] _:string ( "space_id" spaceId )))) spaceId)
        return true
    }

    fn idle:boolean () {
        if ((editing || addOpen) || (!null? seed)) {
            return false
        }
        return ((array_length (space.dirtyEvents())) == 0)
    }

    fn reload:void () {
        stale = false
        def c:SpCall (this.queue("get_space" (SpRemote.body(([] _:string ( "space_id" spaceId )))) spaceId))
        c.quiet = true
    }

    ; The space read again for a change made elsewhere: the tab, the sheet
    ; or document open and the page's own sheets and documents stay.
    fn refreshSpace:void (sp:VlJson events:VlJson) {
        def keepTab:string tab
        def keepSheets:[SpSheet] space.sheets
        def keepDocs:[SpDoc] space.docs
        def keepSheet:string sheetSel
        def keepDoc:string docSel
        this.showSpace(sp events)
        space.sheets = keepSheets
        space.docs = keepDocs
        tab = keepTab
        sheetSel = keepSheet
        docSel = keepDoc
        if (tab == "budget") {
            this.askBudget()
        }
    }

    ; The server's answer to the first call.
    fn answer:void (text:string) {
        if ((array_length outbox) == 0) {
            return
        }
        def c:SpCall (this.takeFirst())
        def o:VlJson (SpRemote.parse(text))
        if (c.op == "changes") {
            def at:string (o.stringOr("changed" ""))
            if ((c.ref == spaceId) && (at != changed)) {
                changed = at
                if ((o.boolOr("mine" false)) == false) {
                    stale = true
                }
            }
            if (stale && (this.idle())) {
                this.reload()
            }
            ; nothing on the page changed yet
            return
        }
        if (c.op == "list_spaces") {
            account = (SpRemote.account(text))
            def pick:string ""
            if (!null? (account.find(prefer))) {
                pick = prefer
            }
            if (((strlen pick) == 0) && ((array_length account.spaces) > 0)) {
                def first:SpSpaceInfo (itemAt account.spaces 0)
                pick = first.id
            }
            if ((strlen pick) > 0) {
                this.openSpace(pick)
            } {
                loading = false
                tab = "spaces"
            }
        }
        if (c.op == "get_space") {
            if (c.ref == spaceId) {
                changed = (o.stringOr("changed" ""))
                if (c.quiet == false) {
                    this.showSpace((o.get("space")) (o.get("events")))
                    if (revealOnLoad && (tab == "assistant")) {
                        reveal = "sp-chat"
                    }
                    revealOnLoad = false
                } {
                    if (this.idle()) {
                        this.refreshSpace((o.get("space")) (o.get("events")))
                    } {
                        ; edited meanwhile: read again once it is saved
                        stale = true
                    }
                }
            }
        }
        if (c.op == "create_space") {
            nameField.setValue("")
            this.showSpace(o (VlJson.arrayValue()))
            tab = "home"
            status = ((SpWords.pick(lang "Created " "Luotu ")) + space.name)
        }
        if (((c.op == "set_space") || (c.op == "invite_member")) || (c.op == "remove_member")) {
            if ((o.stringOr("space_id" "")) == spaceId) {
                SpRemote.readMeta(space o)
                account.put((SpRemote.info(o)))
            }
            if (c.op == "invite_member") {
                inviteField.setValue("")
                status = ((SpWords.pick(lang "Invited " "Kutsuttu ")) + c.ref)
            }
        }
        if (c.op == "save_event") {
            def found@(optional):SpEvent (space.event(c.ref))
            if (!null? found) {
                def e:SpEvent found
                e.remoteId = (o.stringOr("event_id" e.remoteId))
                e.saved(c.rev)
                def rf:string (o.stringOr("remind_from" ""))
                if ((strlen rf) > 0) {
                    e.remindFrom = (SpText.dayOf(rf (itemAt (SpSpace.ymdOf(today)) 0)))
                }
            } {
                ; deleted while its first save was on its way: now it has
                ; an id to delete
                def gone@(optional):SpEvent (this.trashed(c.ref))
                if (!null? gone) {
                    def g:SpEvent gone
                    g.remoteId = (o.stringOr("event_id" g.remoteId))
                    if (((strlen g.remoteId) > 0) && ((this.queued("delete_event" c.ref)) == false)) {
                        this.queue("delete_event" (SpRemote.deleteBody(spaceId g.remoteId)) c.ref)
                    }
                }
            }
            this.queueSaves()
            this.budgetChanged()
        }
        if (c.op == "ask_question") {
            askKind = ""
            askEdit = ""
            askNew = false
            formErr = ""
            status = ((SpWords.pick(lang "Asked: " "Kysytty: ")) + c.ref)
            this.reload()
        }
        if (c.op == "answer_question") {
            askSel = ""
            answerField.setValue("")
            status = (SpWords.pick(lang "Answered" "Vastattu"))
            def made:VlJson (o.get("made"))
            if (made.isObject()) {
                status = (status + (SpWords.pick(lang "; added: " "; lisätty: ")) + (made.stringOr("title" "")))
            }
            this.reload()
        }
        if (c.op == "budget") {
            if (c.body == budgetAsked) {
                budgetAnswer = (SpBudget.read(text))
            }
        }
        if (c.op == "own_budget") {
            own.read(text)
        }
        if (c.op == "email_summary") {
            if (c.ref == spaceId) {
                space.emailSummary = (o.stringOr("period" space.emailSummary))
            }
        }
        if ((c.op == "list_backups") || (c.op == "restore_backup")) {
            this.backupsAnswered(c o)
        }
        if (c.op == "save_own_item") {
            this.ownSaved(c.ref (o.stringOr("item_id" "")))
        }
        if (c.op == "add_ward") {
            if (UiTree.beginsWith(c.ref "wnew-")) {
                ; one added on the Members page takes the server's id
                def sid:string (o.stringOr("id" ""))
                if ((strlen sid) > 0) {
                    space.renameWard(c.ref sid)
                }
            } {
                this.seedWardAdded(c.ref (o.stringOr("id" "")))
            }
        }
        if ((c.op == "add_place") || (c.op == "remove_place")) {
            if ((o.stringOr("space_id" "")) == spaceId) {
                SpRemote.readPlaces(space o)
            }
        }
        if ((c.op == "assist") && (c.ref == "info")) {
            infoBusy = false
            status = (o.stringOr("text" ""))
            this.reload()
            this.rebuild()
            return
        }
        if (c.op == "info_screen") {
            if (c.ref == spaceId) {
                space.infoMorning = (o.boolOr("morning" space.infoMorning))
            }
        }
        if (c.op == "assist") {
            this.assistAnswered(c.ref (o.stringOr("text" "")) true)
            ; it may have changed the person's own budget too
            if (o.boolOr("changed" false)) {
                own.loaded = false
                if ((tab == "budget") && budgetOwn) {
                    this.askOwn()
                }
            }
            this.readDone(c.ref o)
            ; what it made or changed, from the server
            if ((o.boolOr("changed" false)) && ((strlen spaceId) > 0)) {
                def keep:string tab
                this.openSpace(spaceId)
                tab = keep
                revealOnLoad = ((tab == "assistant") && (addOpen == false))
            }
        }
        if (c.op == "import_events") {
            def none@(optional):SpSpace
            seed = none
            def n:int (o.intOr("created" 0))
            status = ((SpWords.pick(lang "Demo data saved: " "Esimerkkidata tallennettu: ")) + (to_string n))
            this.openSpace(spaceId)
        }
        this.rebuild()
    }

    ; A space and its events on the page, replacing what was there.
    fn showSpace:void (sp:VlJson events:VlJson) {
        if ((sp.isObject()) == false) {
            loading = false
            return
        }
        def s (new SpSpace())
        s.today = today
        s.types = types
        SpRemote.readWhole(s sp events)
        space = s
        spaceId = s.remoteId
        account.put((SpRemote.info(sp)))
        if ((strlen s.vocab) > 0) {
            pack = s.vocab
        }
        if server {
            pack = "family"
        }
        if ((strlen s.lang) > 0) {
            lang = s.lang
        }
        loading = false
        sheetSel = ""
        docSel = ""
        editing = false
        def none@(optional):SpBudget
        budgetAnswer = none
        budgetAsked = ""
        this.newBoard()
    }

    ; The first call failed: the server said why, or the host did.
    fn failed:void (message:string) {
        if ((array_length outbox) == 0) {
            return
        }
        def c:SpCall (this.takeFirst())
        if (c.op == "changes") {
            ; asked again in a moment
            return
        }
        status = message
        loading = false
        if (c.op == "delete_event") {
            ; the server keeps it: so does the page
            def found@(optional):SpEvent (this.trashed(c.ref))
            if (!null? found) {
                def e:SpEvent found
                this.untrash(c.ref)
                space.putBack(e)
                undoKind = ""
                this.fillBoard()
            }
        }
        if (c.op == "budget") {
            budgetAsked = ""
        }
        if ((c.op == "save_own_item") || (c.op == "delete_own_item")) {
            ; the server kept what it had: the page reads it again
            own.loaded = false
            this.askOwn()
        }
        if (((c.op == "remove_ward") || (c.op == "add_place")) || (c.op == "remove_place")) {
            ; the server kept what it had: so does the page
            this.openSpace(spaceId)
            tab = "members"
        }
        if ((c.op == "assist") && (c.ref == "info")) {
            infoBusy = false
        }
        if ((c.op == "assist") && (c.ref != "info")) {
            this.assistAnswered(c.ref message false)
        }
        if (c.op == "info_screen") {
            this.reload()
        }
        if ((c.op == "add_ward") && (UiTree.beginsWith(c.ref "wnew-"))) {
            ; the server did not take it: nor does the page
            space.removeWard(c.ref)
        }
        if ((c.op == "add_ward") || (c.op == "import_events")) {
            ; the demo data stops where it failed
            def none@(optional):SpSpace
            seed = none
            def rest:[SpCall]
            def i:int 0
            while (i < (array_length outbox)) {
                def k:SpCall (itemAt outbox i)
                if ((k.op != "add_ward") && (k.op != "import_events")) {
                    push rest k
                }
                i = (i + 1)
            }
            outbox = rest
        }
        this.rebuild()
    }

    ; The demo data of the space's words: its wards first, then, with the ids
    ; the server gave them, its events in one import.
    fn startSeed:void () {
        if ((strlen spaceId) == 0) {
            return
        }
        def s:SpSpace (SpSeed.build(pack lang today))
        seed = s
        seedLeft = (array_length s.resources)
        def i:int 0
        while (i < (array_length s.resources)) {
            def r:SpResource (itemAt s.resources i)
            this.queue("add_ward" (SpRemote.body(([] _:string ( "space_id" spaceId "name" r.name "color" r.color )))) r.id)
            i = (i + 1)
        }
        if (seedLeft == 0) {
            this.queue("import_events" (SpRemote.importBody(spaceId (SpSeed.serverEvents(s)))) "")
        }
    }

    fn seedWardAdded:void (localId:string serverId:string) {
        if (null? seed) {
            return
        }
        def s:SpSpace seed
        if ((strlen serverId) > 0) {
            s.renameWard(localId serverId)
        }
        seedLeft = (seedLeft - 1)
        if (seedLeft <= 0) {
            this.queue("import_events" (SpRemote.importBody(spaceId (SpSeed.serverEvents(s)))) "")
        }
    }

    ; A press that is about the server: true when it was one.
    fn pressServer:boolean (target:string) {
        if (this.pressPlaces(target)) {
            return true
        }
        if (this.pressBackups(target)) {
            return true
        }
        if (target == "sp-assist-send") {
            this.sendAssist()
            return true
        }
        if (target == "sp-assist-image") {
            action = "image"
            return true
        }
        if (target == "sp-assist-help") {
            helpOpen = (helpOpen == false)
            return true
        }
        if (UiTree.beginsWith(target "sp-ex-")) {
            def ek@(optional):int (to_int (substring target 6 (strlen target)))
            def all:[string] (this.examples())
            if (!null? ek) {
                def en:int (unwrap ek)
                if ((en >= 0) && (en < (array_length all))) {
                    assistField.setValue((itemAt all en))
                    focused = "sp-assist-text"
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-done-")) {
            this.openDone(target)
            return true
        }
        if (UiTree.beginsWith(target "sp-assist-drop-")) {
            def dk@(optional):int (to_int (substring target 15 (strlen target)))
            if (!null? dk) {
                this.dropImage((unwrap dk))
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-open-")) {
            this.openSpace((substring target 8 (strlen target)))
            return true
        }
        if (UiTree.beginsWith(target "sp-newpack-")) {
            newPack = (substring target 11 (strlen target))
            return true
        }
        if (target == "sp-create") {
            def nm:string (trim nameField.value)
            if ((strlen nm) == 0) {
                status = (SpWords.pick(lang "Give the space a name" "Anna tilalle nimi"))
                focused = "sp-new-name"
                return true
            }
            this.queue("create_space" (SpRemote.body(([] _:string ( "name" nm "vocab" newPack "lang" lang )))) "")
            return true
        }
        if (target == "sp-feed-gets") {
            feedGets = (feedGets == false)
            this.rebuild()
            return true
        }
        if (target == "sp-feed-pays") {
            feedPays = (feedPays == false)
            this.rebuild()
            return true
        }
        if (((target == "sp-sum-off") || (target == "sp-sum-day")) || (target == "sp-sum-week")) {
            def p:string (substring target 7 (strlen target))
            space.emailSummary = p
            this.queue("email_summary" (SpRemote.body(([] _:string ( "space_id" spaceId "period" p )))) spaceId)
            if (p != "off") {
                summaryShow = p
            }
            this.rebuild()
            return true
        }
        if ((target == "sp-sumprev-day") || (target == "sp-sumprev-week")) {
            summaryShow = (substring target 11 (strlen target))
            this.rebuild()
            return true
        }
        if (target == "sp-feed-alarms") {
            feedAlarms = (feedAlarms == false)
            this.rebuild()
            return true
        }
        if (target == "sp-feed-open") {
            def u:string (this.feedAddress())
            def at:int (indexOf u "://")
            if (at > 0) {
                action = ("open:webcal" + (substring u at (strlen u)))
            }
            return true
        }
        if (target == "sp-feed-share") {
            feedShare = (feedShare == false)
            this.rebuild()
            return true
        }
        if (target == "sp-feed-copy") {
            copyText = (this.feedAddress())
            action = "copy"
            return true
        }
        ; the webcal address: tapped on an iPhone or a Mac it opens the
        ; subscription in Apple's calendar
        if (target == "sp-feed-copyapple") {
            def ua:string (this.feedAddress())
            def uat:int (indexOf ua "://")
            if (uat > 0) {
                copyText = ("webcal" + (substring ua uat (strlen ua)))
                action = "copy"
            }
            return true
        }
        if (target == "sp-invite") {
            def email:string (trim inviteField.value)
            if ((indexOf email "@") <= 0) {
                status = (SpWords.pick(lang "Write an email address" "Kirjoita sähköpostiosoite"))
                focused = "sp-invite-email"
                return true
            }
            this.queue("invite_member" (SpRemote.body(([] _:string ( "space_id" spaceId "email" email )))) email)
            return true
        }
        if (UiTree.beginsWith(target "sp-remove-")) {
            def n@(optional):int (to_int (substring target 10 (strlen target)))
            if (!null? n) {
                def k:int (unwrap n)
                if ((k >= 0) && (k < (array_length space.members))) {
                    def m:SpMember (itemAt space.members k)
                    def who:string m.uid
                    if ((strlen who) == 0) {
                        who = m.email
                    }
                    this.queue("remove_member" (SpRemote.body(([] _:string ( "space_id" spaceId "member" who )))) who)
                }
            }
            return true
        }
        if (target == "sp-addward") {
            def wn:string (trim wardField.value)
            if ((strlen wn) == 0) {
                status = (SpWords.pick(lang "Give it a name" "Anna nimi"))
                focused = "sp-ward-name"
                return true
            }
            if ((strlen (space.resourceFor(wn))) > 0) {
                status = ((SpWords.pick(lang "Already there: " "On jo: ")) + wn)
                return true
            }
            def pal2:[string] (SpSpace.palette())
            def nw:SpResource (space.addResource((space.nextId("wnew-")) wn (itemAt pal2 ((array_length space.resources) % (array_length pal2)))))
            if (server && ((strlen spaceId) > 0)) {
                this.queue("add_ward" (SpRemote.body(([] _:string ( "space_id" spaceId "name" nw.name "color" nw.color )))) nw.id)
            }
            wardField.setValue("")
            status = ((SpWords.pick(lang "Added " "Lisätty ")) + wn)
            this.fillBoard()
            return true
        }
        if (this.clothesClick(target)) {
            this.fillBoard()
            return true
        }
        if (target == "sp-unward-no") {
            wardAsk = ""
            return true
        }
        if (target == "sp-unward-yes") {
            def gone:string (space.resourceName(wardAsk))
            space.removeWard(wardAsk)
            if (server && ((strlen spaceId) > 0)) {
                this.queue("remove_ward" (SpRemote.body(([] _:string ( "space_id" spaceId "ward" wardAsk )))) wardAsk)
            }
            wardAsk = ""
            status = ((SpWords.pick(lang "Removed " "Poistettu ")) + gone)
            this.fillBoard()
            return true
        }
        if (UiTree.beginsWith(target "sp-wardcolor-")) {
            def n4@(optional):int (to_int (substring target 13 (strlen target)))
            if (!null? n4) {
                def k4:int (unwrap n4)
                if ((k4 >= 0) && (k4 < (array_length space.resources))) {
                    def wc:SpResource (itemAt space.resources k4)
                    def pal:[string] (SpSpace.palette())
                    def at:int (indexOf pal wc.color)
                    wc.color = (itemAt pal ((at + 1) % (array_length pal)))
                    if (server && ((strlen spaceId) > 0)) {
                        this.queue("set_ward" (SpRemote.body(([] _:string ( "space_id" spaceId "ward" wc.id "color" wc.color )))) wc.id)
                    }
                    this.fillBoard()
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-unward-")) {
            def n3@(optional):int (to_int (substring target 10 (strlen target)))
            if (!null? n3) {
                def k3:int (unwrap n3)
                if ((k3 >= 0) && (k3 < (array_length space.resources))) {
                    def wr:SpResource (itemAt space.resources k3)
                    wardAsk = wr.id
                }
            }
            return true
        }
        if (UiTree.beginsWith(target "sp-uninvite-")) {
            def n2@(optional):int (to_int (substring target 12 (strlen target)))
            if (!null? n2) {
                def k2:int (unwrap n2)
                if ((k2 >= 0) && (k2 < (array_length space.invites))) {
                    def email2:string (itemAt space.invites k2)
                    this.queue("remove_member" (SpRemote.body(([] _:string ( "space_id" spaceId "member" email2 )))) email2)
                }
            }
            return true
        }
        if (target == "sp-seed") {
            this.startSeed()
            return true
        }
        ; the words and the language are the space's own: kept on the server
        ; when the owner changes them, and only on this page otherwise
        if (UiTree.beginsWith(target "sp-pack-")) {
            pack = (substring target 8 (strlen target))
            space.vocab = pack
            this.spaceChanged("vocab" pack)
            return true
        }
        if (UiTree.beginsWith(target "sp-lang-")) {
            lang = (substring target 8 (strlen target))
            this.spaceChanged("lang" lang)
            return true
        }
        return false
    }

    fn spaceChanged:void (key:string value:string) {
        if ((strlen spaceId) > 0) {
            if (space.myRole == "owner") {
                this.queue("set_space" (SpRemote.body(([] _:string ( "space_id" spaceId key value )))) "")
            }
        }
        this.newBoard()
    }

    ; The host's answer to "import": a sheet from CSV or pasted cells.
    fn importSheet:boolean (name:string text:string) {
        def sh:SpSheet (SpSheet.parse("" name text))
        if ((array_length sh.cols) == 0) {
            status = (SpWords.pick(lang "Nothing to import" "Ei tuotavaa"))
            this.rebuild()
            return false
        }
        space.addSheet(sh)
        sheetSel = sh.id
        tab = "sheets"
        this.fillBoard()
        def dated:int (array_length (space.sheetEvents(sh)))
        status = (name + ": " + (to_string (sh.rowCount())) + " " + (SpWords.ui(lang "rows")) + ", " + (to_string dated) + " " + (SpWords.ui(lang "dated")))
        this.rebuild()
        return true
    }

    fn sheetCsv:string (id:string) {
        def i:int 0
        while (i < (array_length space.sheets)) {
            def sh:SpSheet (itemAt space.sheets i)
            if (sh.id == id) {
                return (sh.toCsv())
            }
            i = (i + 1)
        }
        return ""
    }

    fn sheetFileName:string (id:string) {
        return ((this.sheetName(id)) + ".csv")
    }

    ; "a-<row>" (an answer), "q-<row>" (what was asked) or "r-<n>" (a Muista
    ; box) to the clipboard
    fn copyRow:void (what:string) {
        def k@(optional):int (to_int (substring what 2 (strlen what)))
        if (null? k) {
            return
        }
        def n:int (unwrap k)
        if (UiTree.beginsWith(what "r-")) {
            if ((n >= 0) && (n < (array_length remindTexts))) {
                copyText = (itemAt remindTexts n)
                action = "copy"
            }
            return
        }
        if ((n < 0) || (n >= (array_length answers))) {
            return
        }
        def t:string (itemAt answers n)
        if (UiTree.beginsWith(what "q-")) {
            def qk:string (itemAt asked n)
            if ((UiTree.beginsWith(qk "@")) == false) {
                return
            }
            t = (substring qk 1 (strlen qk))
        }
        copyText = t
        action = "copy"
    }

    ; the calendar feed's address, without what the switches leave out
    fn feedAddress:string () {
        def q:[string]
        if (feedGets == false) {
            push q "get=0"
        }
        if (feedPays == false) {
            push q "pay=0"
        }
        if (feedAlarms == false) {
            push q "alarm=0"
        }
        if ((array_length q) == 0) {
            return space.feed
        }
        return (space.feed + "?" + (join q "&"))
    }

    ; the host says whether the clipboard took it
    fn copied:void (ok:boolean) {
        if ok {
            status = (SpWords.pick(lang "Copied" "Kopioitu"))
        } {
            status = (SpWords.pick(lang "Could not copy" "Kopiointi ei onnistunut"))
        }
        this.rebuild()
    }

    fn takeAction:string () {
        def a:string action
        action = ""
        return a
    }

    fn pointerDown:boolean (id:string x:double y:double) {
        this.laidOut()
        lastX = x
        lastY = y
        def f@(optional):InputCtl (this.fieldOf(id))
        if (!null? f) {
            def c:InputCtl f
            board.closeOverlays()
            focused = c.tid
            c.focused = true
            c.textPointerDownAt(id x y 1 false)
            this.rebuild()
            return true
        }
        if (this.onBoard(id)) {
            board.focused = focused
            board.hovered = hovered
            board.pointerDown(id x y)
            ; an event pressed is selected (the card leaves an all-day bar
            ; unfocused until it is moved)
            def ref:string (board.refine(id x y))
            if ((strlen (this.occOfTarget(ref))) > 0) {
                board.focused = ref
            }
            focused = board.focused
            this.rebuild()
            return true
        }
        this.press(id)
        return true
    }

    fn pointerMove:boolean (x:double y:double) {
        lastX = x
        lastY = y
        def f@(optional):InputCtl (this.fieldOf(focused))
        if (!null? f) {
            def c:InputCtl f
            if c.dragging {
                c.textPointerDragAt(x y)
                this.rebuild()
                return true
            }
        }
        if ((strlen board.armed) == 0) {
            return false
        }
        this.laidOut()
        if (board.pointerMove(x y)) {
            this.rebuild()
            return true
        }
        return false
    }

    fn pointerUp:boolean () {
        def f@(optional):InputCtl (this.fieldOf(focused))
        if (!null? f) {
            def c:InputCtl f
            c.textPointerUp()
        }
        if ((strlen board.armed) == 0) {
            return false
        }
        board.focused = focused
        def clicked:boolean (board.dragging == false)
        def pressed:string board.armed
        def r:boolean (board.pointerUp())
        focused = board.focused
        this.syncBack()
        ; a click on an event (not a drag) opens it in the form, an all-day
        ; bar over several days too; a sheet's row only takes the focus
        if clicked {
            def occ:string (this.occOfTarget(pressed))
            if (((strlen occ) > 0) && ((strlen (space.eventIdOf(occ))) > 0)) {
                this.openOcc(occ)
            }
        }
        this.rebuild()
        return r
    }

    fn scrollBy:boolean (dy:double) {
        if (tab != "calendar") {
            return false
        }
        def id:string (this.hitId(lastX lastY))
        if ((this.onBoard(id)) == false) {
            return false
        }
        if (board.scrollBy(dy)) {
            this.rebuild()
            return true
        }
        return false
    }

    fn cursorAt:string (x:double y:double) {
        lastX = x
        lastY = y
        def id:string (this.hitId(x y))
        if (this.onBoard(id)) {
            return (board.cursorFor((board.refine(id x y))))
        }
        if ((strlen id) > 0) {
            return "pointer"
        }
        return ""
    }

    ; The tooltip of what is at (x, y): a person's email on the budget's
    ; person filter and on the members page, "" for none.
    fn tipAt:string (x:double y:double) {
        def id:string (this.hitId(x y))
        if (UiTree.beginsWith(id "sp-bud-payer-")) {
            def pn@(optional):int (to_int (substring id 13 (strlen id)))
            if (!null? pn) {
                def payers:[string] (space.payers())
                def pk:int (unwrap pn)
                if ((pk >= 0) && (pk < (array_length payers))) {
                    return (space.emailOf((itemAt payers pk)))
                }
            }
        }
        if (UiTree.beginsWith(id "sp-member-")) {
            def mn@(optional):int (to_int (substring id 10 (strlen id)))
            if (!null? mn) {
                def mk:int (unwrap mn)
                if ((mk >= 0) && (mk < (array_length space.members))) {
                    def m:SpMember (itemAt space.members mk)
                    return m.email
                }
            }
        }
        return ""
    }

    fn collectFocusable:void (el:EVGElement out:[string]) {
        if (el.a11yFocusable && ((strlen el.id) > 0)) {
            push out el.id
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.collectFocusable((el.getChild(i)) out)
            i = (i + 1)
        }
    }

    fn tab1:boolean (back:boolean) {
        def ring:[string]
        this.collectFocusable((unwrap root) ring)
        def n:int (array_length ring)
        if (n == 0) {
            return false
        }
        def at:int -1
        def i:int 0
        while (i < n) {
            if ((itemAt ring i) == focused) {
                at = i
            }
            i = (i + 1)
        }
        if (at < 0) {
            if back {
                focused = (itemAt ring (n - 1))
            } {
                focused = (itemAt ring 0)
            }
        } {
            if back {
                at = (at - 1)
            } {
                at = (at + 1)
            }
            if ((at < 0) || (at >= n)) {
                return false
            }
            focused = (itemAt ring at)
        }
        this.rebuild()
        return true
    }

    fn keyWith:boolean (k:string shift:boolean ctrl:boolean) {
        def f@(optional):InputCtl (this.fieldOf(focused))
        if ((!null? f) && (k != "Tab")) {
            def c:InputCtl f
            ; in a field of many lines Enter is a line break, Ctrl+Enter sends
            if ((k == "Enter") && (c.multiline && (ctrl == false))) {
                c.keyDownWith(c.tid k shift ctrl)
                this.rebuild()
                return true
            }
            if (k == "Enter") {
                def go:string (SpacesApp.submitOf(c.tid))
                if (((go == "sp-ed-save") && (editing == false)) && ((strlen askKind) > 0)) {
                    ; a field of the Questions view's form
                    go = "sp-ask-send"
                }
                if ((strlen go) > 0) {
                    return (this.press(go))
                }
                return false
            }
            if (k == "Escape") {
                focused = ""
                this.rebuild()
                return true
            }
            ; a shortcut other than Ctrl+A is the page's, not the field's
            if (ctrl && (k != "a")) {
                return false
            }
            c.keyDownWith(c.tid k shift ctrl)
            this.rebuild()
            return true
        }
        if (dateOpen >= 0) {
            if (k == "Escape") {
                focused = ("sp-date-" + (to_string dateOpen))
                dateOpen = -1
                this.rebuild()
                return true
            }
            def day:int (datePick.dayOfTid(focused))
            if (day >= 0) {
                if ((k == "Enter") || (k == " ")) {
                    return (this.press(focused))
                }
                def to:string (datePick.keyDown(focused k))
                if ((strlen to) > 0) {
                    focused = to
                    this.rebuild()
                    return true
                }
            }
        }
        if ((strlen ownDateOpen) > 0) {
            if (k == "Escape") {
                focused = ("sp-owndate-" + ownDateOpen)
                ownDateOpen = ""
                this.rebuild()
                return true
            }
            def oday:int (ownPick.dayOfTid(focused))
            if (oday >= 0) {
                if ((k == "Enter") || (k == " ")) {
                    return (this.press(focused))
                }
                def oto:string (ownPick.keyDown(focused k))
                if ((strlen oto) > 0) {
                    focused = oto
                    this.rebuild()
                    return true
                }
            }
        }
        if ((k == "Escape") && phoneOpen) {
            phoneOpen = false
            focused = "sp-phone"
            this.rebuild()
            return true
        }
        if ((k == "Escape") && (editing || addOpen)) {
            editing = false
            addOpen = false
            focused = ""
            this.rebuild()
            return true
        }
        if (ctrl && ((k == "z") && ((strlen undoKind) > 0))) {
            this.undo()
            this.rebuild()
            return true
        }
        if (((k == "Backspace") || (k == "Delete")) && (editing == false)) {
            if (this.deleteSelected()) {
                this.rebuild()
                return true
            }
        }
        if ((k == "Enter") && (editing == false)) {
            def occ:string (this.selectedOcc())
            if (((strlen occ) > 0) && ((UiTree.beginsWith(focused "sp-")) == false)) {
                this.openOcc(occ)
                this.rebuild()
                return true
            }
        }
        if (k == "Tab") {
            if (this.onBoard(focused)) {
                def back:string (board.closeLists())
                if ((strlen back) > 0) {
                    focused = back
                }
            }
            return (this.tab1(shift))
        }
        if ((this.onBoard(focused)) || ((strlen board.armed) > 0)) {
            board.focused = focused
            board.hovered = hovered
            def r:boolean (board.keyWith(k shift))
            focused = board.focused
            this.syncBack()
            this.rebuild()
            return r
        }
        if ((k == "Enter") || (k == " ")) {
            if ((strlen focused) > 0) {
                return (this.press(focused))
            }
        }
        return false
    }

    fn key:boolean (k:string) {
        return (this.keyWith(k false false))
    }

    fn setHover:void (id:string) {
        def was:string hovered
        hovered = id
        if (was != id) {
            this.rebuild()
        }
    }

    fn setPressed:void (id:string) {
        pressed = id
    }

    fn setFocus:void (id:string) {
        focused = id
    }

    ; =========================================================================
    ; layout and output
    ; =========================================================================

    fn rebuild:void () {
        root = (this.page())
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        el.isFocused = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
            if (el.id == focused) {
                el.isFocused = true
            }
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.markStates((el.getChild(i)))
            i = (i + 1)
        }
    }

    fn laidOut:EVGLayout () {
        if ((pageW != builtW) || (null? root)) {
            this.rebuild()
        }
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        UiTree.inline(r "width" (SpacesApp.px(pageW)))
        UiTree.inline(r "height" (SpacesApp.px(pageH)))
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r "")
        def t:EVGTransition transitions
        t.reconcileTree(r)
        if layout {
            def lay:EVGLayout (unwrap layout)
            if ((s.layoutClean()) == false) {
                lay.setPageSize(pageW pageH)
                lay.layout(r)
                this.fitHeight(lay)
                this.placeFields(lay)
            }
            return lay
        }
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        this.fitHeight(fresh)
        this.placeFields(fresh)
        return fresh
    }

    fn fitHeight:void (lay:EVGLayout) {
        def r:EVGElement (unwrap root)
        def bottom:double 0.0
        def i:int 0
        while (i < (r.getChildCount())) {
            def c:EVGElement (r.getChild(i))
            def b:double (SpacesApp.deepest(c))
            if (b > bottom) {
                bottom = b
            }
            i = (i + 1)
        }
        def want:double (to_double (to_int ((bottom + 24.0) + 0.999)))
        if (want < minH) {
            want = minH
        }
        def diff:double (want - pageH)
        if ((diff > 0.5) || (diff < -0.5)) {
            pageH = want
            def s:EVGStyleSheet (unwrap sheet)
            UiTree.inline(r "height" (SpacesApp.px(pageH)))
            s.setViewport(pageW pageH false)
            s.applyTree(r "")
            lay.setPageSize(pageW pageH)
            lay.layout(r)
        }
    }

    ; the lowest edge of an element or anything in it
    sfn deepest:double (el:EVGElement) {
        def b:double (el.calculatedY + el.calculatedHeight)
        def i:int 0
        while (i < (el.getChildCount())) {
            def c:double (SpacesApp.deepest((el.getChild(i))))
            if (c > b) {
                b = c
            }
            i = (i + 1)
        }
        return b
    }

    fn displayListJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(r)
        return (dl.toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r (this.appName()) generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Spaces" 1 ""))
        return (t.lint())
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    fn tick:boolean (dtMs:double) {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        t.advanceTree(r dtMs)
        return (t.busy(r))
    }

    fn busyNow:boolean () {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        return (t.busy(r))
    }

    fn setWidth:void (w:double minHeight:double) {
        pageW = w
        minH = minHeight
    }

    fn widthPx:double () {
        return pageW
    }

    fn heightPx:double () {
        this.laidOut()
        return pageH
    }
}
