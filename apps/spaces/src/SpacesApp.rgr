    def changed:string ""
    def stale:boolean false
    ; the demo data on its way to the server, and how many wards are left
    ; to add before its events go
    def seed@(optional):SpSpace
    def seedLeft:int 0
    ; the words picked for a new space
    def newPack:string "family"
    ; text fields: the ones on the page now, and the fields themselves
    def shown:[InputCtl]
    def nameField:InputCtl (new InputCtl())
    def inviteField:InputCtl (new InputCtl())
    def wardField:InputCtl (new InputCtl())
    ; the ward whose clothing is open on the Members page, and its fields
