    def sizeWhat:InputCtl (new InputCtl())
    def sizeNow:InputCtl (new InputCtl())
    def sizeNext:InputCtl (new InputCtl())
    def sizeBy:InputCtl (new InputCtl())
    def clothItem:InputCtl (new InputCtl())
    def clothSize:InputCtl (new InputCtl())
    def clothNeed:InputCtl (new InputCtl())
    ; the places' search: the town written, whose place it becomes (a
