; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; SpacesApp — the Spaces page: the summary first, then the calendar, sheets,
; documents and the assistant
; =============================================================================
; One EVG tree, built again on every change, as Sliqtly's editor and the EVGUI
; demos are: `page()` builds it, the host paints `displayListJson()`, asks
; `hitId(x y)` what is under the pointer and mirrors `a11yJson()` into the DOM.
;
; The data is a SpSpace (SpacesModel.rgr). The calendar is EVGUI's event
; calendar card (EcBoard), filled from the space's occurrences; a move or a
; new event made on the card is written back to the space (`syncBack`) and
; the card filled again, so the summary and the calendar never disagree.
;
; What the host does that the tree cannot: read a file or the clipboard for
; an import, and save a download. A press that needs one leaves `action` set
; ("import", "export:<sheet id>") for the host to take.
; =============================================================================

Import "SpacesModel.rgr"
Import "SpacesVocab.rgr"
Import "SpacesAssist.rgr"
Import "../evgui/src/EventCalBoard.rgr"
Import "../evgui/src/EventCalCtl.rgr"
Import "../evgui/src/EventCalI18n.rgr"
Import "../evgui/src/UiTree.rgr"
Import "../evgui/src/UiDate.rgr"
Import "pkg:evg/EVGTextEngine.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGStyleSheet.rgr"
Import "pkg:evg/EVGTransition.rgr"
Import "pkg:evg/EVGA11yTree.rgr"
Import "pkg:evg/EVGA11yFromTree.rgr"
Import "pkg:evg/EVGHitTest.rgr"

class SpacesApp {
    def space:SpSpace (new SpSpace())
    def pack:string "demo"
    def lang:string "fi"
    def tab:string "home"
    def today:int 0
    def nowMin:int 600
    def browserOff:int 0

    def board:EcBoard (new EcBoard())
    ; the card's event ids ("o0", "o1" …) and what each one is in the space
    def boardIds:[string]
    def occIds:[string]
    def occDay:[int]
    def occStart:[int]
    def occEnd:[int]

    ; the days the summary's rows open in the calendar, by row
    def itemDays:[int]
    def sheetSel:string ""
    def docSel:string ""
    ; the assistant's conversation: question keys and answers
    def asked:[string]
    def answers:[string]
    ; what the host has to do after a press ("import", "export:<id>")
    def action:string ""
    def status:string ""

    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    def transitions:EVGTransition (new EVGTransition())
    def layout@(optional):EVGLayout
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    def pageW:double 1200.0
    def pageH:double 900.0
    def builtW:double 0.0
    def lastX:double 0.0
    def lastY:double 0.0
    ; the page is as tall as what is on it, and at least the window
    def minH:double 600.0

    Constructor () {
    }

    ; =========================================================================
    ; set-up
    ; =========================================================================

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s
        if (today == 0) {
            this.useClock(2026 10 21 600 0)
        }
    }

    ; Today and now, from the host's clock. The checks keep Wednesday
    ; 21 October 2026 at 10:00.
    fn useClock:void (y:int m:int d:int minute:int offset:int) {
        today = (UiDate.toDays(y m d))
        nowMin = minute
        browserOff = offset
        this.load()
    }

    ; A fresh space of the pack's demo data, in the page's language.
    fn load:void () {
        space = (SpSeed.build(pack lang today))
        sheetSel = ""
        docSel = ""
        def none:[string]
        asked = none
        def none2:[string]
        answers = none2
        this.newBoard()
        this.rebuild()
    }

    fn newBoard:void () {
        def keepView:string "week"
        def keepCursor:int today
        if (board.today > 0) {
            keepView = board.view
            keepCursor = board.cursor
        }
        board = (new EcBoard())
        board.browserOff = browserOff
        board.begin("spc" false today nowMin)
        board.lang = lang
        board.weekStart = 1
        board.view = keepView
        board.startH = 7
        board.endH = 22
        board.newTitle = (SpWords.noun(lang pack "event"))
        board.hasSettings = false
        def i:int 0
        while (i < (array_length space.resources)) {
            def r:SpResource (itemAt space.resources i)
            push board.lanes (EcBoard.col(today r.id r.name r.color))
            i = (i + 1)
        }
        this.fillBoard()
        board.settle()
        board.cursor = keepCursor
    }

    ; =========================================================================
    ; the calendar card and the space
    ; =========================================================================

    ; The card's events: every occurrence from three months back to six ahead.
    fn fillBoard:void () {
        def keep:[CalEvent]
        board.model.events = keep
        def b:[string]
        boardIds = b
        def o:[string]
        occIds = o
        def d:[int]
        occDay = d
        def s:[int]
        occStart = s
        def e:[int]
        occEnd = e
        def occ:[SpOccur] (space.occurrences((today - 92) (today + 184)))
        def i:int 0
        while (i < (array_length occ)) {
            def oc:SpOccur (itemAt occ i)
            def id:string ("o" + (to_string i))
            if (oc.allDay()) {
                def ad:CalEvent (board.model.addAllDay(id oc.title oc.day oc.endDay))
                ad.color = oc.color
                ad.resource = oc.resource
            } {
                board.model.addEvent(id oc.title oc.day oc.startMin oc.endMin oc.resource oc.color)
            }
            push boardIds id
            push occIds oc.id
            push occDay oc.day
            push occStart oc.startMin
            push occEnd oc.endMin
            i = (i + 1)
        }
    }

    ; What the card changed, written to the space: a moved or resized event,
    ; and a new one. True when anything was.
    fn syncBack:boolean () {
        def changed:boolean false
        def i:int 0
        while (i < (array_length board.model.events)) {
            def ce:CalEvent (itemAt board.model.events i)
            def k:int (this.boardIndex(ce.id))
            if (k >= 0) {
                def moved:boolean ((ce.startDay != (itemAt occDay k)) || ((ce.allDay == false) && ((ce.startMin != (itemAt occStart k)) || (ce.endMin != (itemAt occEnd k)))))
                if moved {
                    if (space.moveOccurrence((itemAt occIds k) ce.startDay ce.startMin ce.endMin)) {
                        status = (SpWords.pick(lang "Moved " "Siirretty ") + ce.title)
                    } {
                        status = (SpWords.pick(lang "Rows from a sheet are changed in the sheet" "Taulukon rivit muutetaan taulukossa"))
                    }
                    changed = true
                }
            } {
                ; made on the card
                if ce.allDay {
                    space.addAllDay(ce.title ce.startDay ce.endDay ce.resource)
                } {
                    space.addEvent(ce.title ce.startDay ce.startMin ce.endMin ce.resource)
                }
                status = (SpWords.pick(lang "Added " "Lisätty ") + ce.title)
                changed = true
            }
            i = (i + 1)
        }
        if changed {
            this.fillBoard()
        }
        return changed
    }

    fn boardIndex:int (id:string) {
        def i:int 0
        while (i < (array_length boardIds)) {
            if ((itemAt boardIds i) == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; =========================================================================
    ; the tree
    ; =========================================================================

    sfn tri:int (on:boolean) {
        if on {
            return (EVGA11yTri.yes())
        }
        return (EVGA11yTri.no())
    }

    sfn px:string (v:double) {
        return ((to_string (to_int v)) + "px")
    }

    sfn box:EVGElement (cls:string) {
        return (UiTree.div("" cls))
    }

    sfn tx:EVGElement (cls:string text:string) {
        return (UiTree.label("" cls text))
    }

    sfn btn:EVGElement (id:string cls:string label:string) {
        def el:EVGElement (UiTree.div(id cls))
        el.role = "button"
        el.a11yFocusable = true
        el.a11yLabel = label
        def t:EVGElement (UiTree.label("" (SpacesApp.txClasses(cls)) label))
        t.a11yHidden = true
        el.addChild(t)
        return el
    }

    ; a button's label takes each of the button's classes with "-tx":
    ; "sp-pill sp-pill-on" labels with "sp-pill-tx sp-pill-on-tx"
    sfn txClasses:string (cls:string) {
        def parts:[string] (UiTree.splitWs(cls))
        def out:[string]
        def i:int 0
        while (i < (array_length parts)) {
            push out ((itemAt parts i) + "-tx")
            i = (i + 1)
        }
        return (join out " ")
    }

    sfn dot:EVGElement (color:string) {
        def d:EVGElement (UiTree.div("" ("sp-dot sp-c-" + color)))
        d.a11yHidden = true
        return d
    }

    fn narrow:boolean () {
        return (pageW < 760.0)
    }

    fn mainW:double () {
        if (this.narrow()) {
            return (pageW - 24.0)
        }
        return ((pageW - 220.0) - 48.0)
    }

    fn page:EVGElement () {
        builtW = pageW
        def shell:EVGElement (UiTree.div("sp-shell" "sp-shell"))
        shell.addChild((this.topBar()))
        def body:EVGElement (SpacesApp.box("sp-body"))
        if (this.narrow()) {
            body = (SpacesApp.box("sp-body sp-body-narrow"))
        }
        body.addChild((this.nav()))
        def main:EVGElement (UiTree.div("sp-main" "sp-main"))
        main.role = "main"
        UiTree.inline(main "width" (SpacesApp.px((this.mainW()))))
        if (tab == "calendar") {
            main.addChild((this.calendarView()))
        } {
            if (tab == "sheets") {
                main.addChild((this.sheetsView()))
            } {
                if (tab == "docs") {
                    main.addChild((this.docsView()))
                } {
                    if (tab == "assistant") {
                        main.addChild((this.assistantView()))
                    } {
                        main.addChild((this.homeView()))
                    }
                }
            }
        }
        body.addChild(main)
        shell.addChild(body)
        if ((strlen status) > 0) {
            def st:EVGElement (UiTree.label("sp-status" "sp-status" status))
            st.role = "status"
            shell.addChild(st)
        }
        return shell
    }

    fn topBar:EVGElement () {
        def bar:EVGElement (SpacesApp.box("sp-top"))
        if (this.narrow()) {
            bar = (SpacesApp.box("sp-top sp-top-narrow"))
        }
        bar.role = "banner"
        def brand:EVGElement (SpacesApp.box("sp-brand"))
        def mark:EVGElement (SpacesApp.box("sp-mark"))
        mark.addChild((SpacesApp.tx("sp-mark-tx" "S")))
        brand.addChild(mark)
        brand.addChild((SpacesApp.tx("sp-brand-tx" "Spaces")))
        bar.addChild(brand)
        if ((this.narrow()) == false) {
            def name:EVGElement (SpacesApp.tx("sp-spacename" space.name))
            bar.addChild(name)
        }
        bar.addChild((SpacesApp.box("sp-grow")))
        if ((this.narrow()) == false) {
            bar.addChild((SpacesApp.tx("sp-pills-label" (SpWords.ui(lang "words")))))
        }
        def packs:[string] (SpWords.packs())
        def pills:EVGElement (SpacesApp.box("sp-pills"))
        pills.role = "group"
        pills.a11yLabel = (SpWords.ui(lang "words"))
        def i:int 0
        while (i < (array_length packs)) {
            def pk:string (itemAt packs i)
            def cls:string "sp-pill"
            if (pk == pack) {
                cls = "sp-pill sp-pill-on"
            }
            def b:EVGElement (SpacesApp.btn(("sp-pack-" + pk) cls (SpWords.packName(lang pk))))
            b.a11yPressed = (SpacesApp.tri((pk == pack)))
            pills.addChild(b)
            i = (i + 1)
        }
        bar.addChild(pills)
        def lg:EVGElement (SpacesApp.box("sp-pills"))
        lg.role = "group"
        lg.a11yLabel = (SpWords.ui(lang "lang"))
        def langs:[string] (SpWords.langs())
        def k:int 0
        while (k < (array_length langs)) {
            def l:string (itemAt langs k)
            def lc:string "sp-pill"
            if (l == lang) {
                lc = "sp-pill sp-pill-on"
            }
            def lb:EVGElement (SpacesApp.btn(("sp-lang-" + l) lc (to_uppercase l)))
            lb.a11yPressed = (SpacesApp.tri((l == lang)))
            lg.addChild(lb)
            k = (k + 1)
        }
        bar.addChild(lg)
        return bar
    }

    fn nav:EVGElement () {
        def nav:EVGElement (SpacesApp.box("sp-nav"))
        if (this.narrow()) {
            nav = (SpacesApp.box("sp-nav sp-nav-row"))
        }
        nav.role = "navigation"
        def tabs:[string] ([] _:string ( "home" "calendar" "sheets" "docs" "assistant" ))
        def glyphs:[string] ([] _:string ( "◎" "▦" "▤" "▧" "✦" ))
        def i:int 0
        while (i < (array_length tabs)) {
            def t:string (itemAt tabs i)
            def cls:string "sp-navbtn"
            if (t == tab) {
                cls = "sp-navbtn sp-navbtn-on"
            }
            def label:string (SpWords.ui(lang t))
            def b:EVGElement (UiTree.div(("sp-nav-" + t) cls))
            b.role = "button"
            b.a11yFocusable = true
            b.a11yLabel = label
            b.a11yPressed = (SpacesApp.tri((t == tab)))
            def g:EVGElement (SpacesApp.tx("sp-navglyph" (itemAt glyphs i)))
            g.a11yHidden = true
            b.addChild(g)
            def tl:EVGElement (SpacesApp.tx("sp-navbtn-tx" label))
            tl.a11yHidden = true
            b.addChild(tl)
            nav.addChild(b)
            i = (i + 1)
        }
        return nav
    }

    fn heading:EVGElement (title:string sub:string) {
        def h:EVGElement (UiTree.div("sp-head" "sp-head"))
        def t:EVGElement (SpacesApp.tx("sp-h1" title))
        t.role = "heading"
        h.addChild(t)
        if ((strlen sub) > 0) {
            h.addChild((SpacesApp.tx("sp-sub" sub)))
        }
        return h
    }

    ; --- the summary --------------------------------------------------------------

    fn homeView:EVGElement () {
        def none:[int]
        itemDays = none
        def v:EVGElement (SpacesApp.box("sp-view"))
        def todayLong:string (EcI18n.dayTitle(lang today))
        v.addChild((this.heading((SpWords.ui(lang "home")) (todayLong + " · " + space.name))))
        def ranges:[SpRange] (space.summary(today))
        def cols:EVGElement (SpacesApp.box("sp-cols"))
        if (this.narrow()) {
            cols = (SpacesApp.box("sp-cols sp-cols-narrow"))
        }
        def w:double (((this.mainW()) - 32.0) / 3.0)
        if (this.narrow()) {
            w = (this.mainW())
        }
        def i:int 0
        while (i < 3) {
            def r:SpRange (itemAt ranges i)
            def card:EVGElement (this.rangeCard(r (i > 0)))
            UiTree.inline(card "width" (SpacesApp.px(w)))
            cols.addChild(card)
            i = (i + 1)
        }
        v.addChild(cols)

        def row:EVGElement (SpacesApp.box("sp-cols"))
        if (this.narrow()) {
            row = (SpacesApp.box("sp-cols sp-cols-narrow"))
        }
        def c1:EVGElement (this.lateCard())
        def c2:EVGElement (this.sheetsCard())
        def c3:EVGElement (this.loadCard())
        UiTree.inline(c1 "width" (SpacesApp.px(w)))
        UiTree.inline(c2 "width" (SpacesApp.px(w)))
        UiTree.inline(c3 "width" (SpacesApp.px(w)))
        row.addChild(c1)
        row.addChild(c2)
        row.addChild(c3)
        v.addChild(row)
        v.addChild((this.writeCard()))
        return v
    }

    fn card:EVGElement (id:string title:string) {
        def c:EVGElement (UiTree.div(("sp-card-" + id) "sp-card"))
        c.role = "region"
        c.a11yLabel = title
        def t:EVGElement (SpacesApp.tx("sp-cardtitle" title))
        t.role = "heading"
        c.addChild(t)
        return c
    }

    fn rangeCard:EVGElement (r:SpRange withDay:boolean) {
        def c:EVGElement (this.card(r.key (SpWords.ui(lang r.key))))
        if ((r.key != "today") && (r.to >= r.from)) {
            c.addChild((SpacesApp.tx("sp-cardsub" ((SpWords.dayLabel(lang r.from)) + " – " + (SpWords.dayLabel(lang r.to))))))
        }
        if (r.to < r.from) {
            c.addChild((SpacesApp.tx("sp-empty" (SpWords.ui(lang "weekEnds")))))
            return c
        }
        if (r.isEmpty()) {
            c.addChild((SpacesApp.tx("sp-empty" (SpWords.ui(lang "nothing")))))
            return c
        }
        def lastDay:int -1
        def i:int 0
        while (i < (array_length r.items)) {
            def o:SpOccur (itemAt r.items i)
            if (withDay && (o.day != lastDay)) {
                c.addChild((SpacesApp.tx("sp-daylabel" (SpWords.dayLabel(lang o.day)))))
                lastDay = o.day
            }
            c.addChild((this.itemRow(o)))
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length r.deadlines)) {
            c.addChild((this.deadlineRow((itemAt r.deadlines k) false)))
            k = (k + 1)
        }
        return c
    }

    fn itemRow:EVGElement (o:SpOccur) {
        def n:int (array_length itemDays)
        push itemDays o.day
        def who:string (space.resourceName(o.resource))
        def label:string ((SpWords.timeOf(lang o)) + " " + o.title)
        if ((strlen who) > 0) {
            label = (label + ", " + who)
        }
        def row:EVGElement (UiTree.div(("sp-item-" + (to_string n)) "sp-item"))
        row.role = "button"
        row.a11yFocusable = true
        row.a11yLabel = label
        row.addChild((SpacesApp.dot(o.color)))
        def tm:EVGElement (SpacesApp.tx("sp-time" (SpWords.timeOf(lang o))))
        tm.a11yHidden = true
        row.addChild(tm)
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        def tt:EVGElement (SpacesApp.tx("sp-title" o.title))
        tt.a11yHidden = true
        col.addChild(tt)
        def meta:string who
        if ((strlen o.source) > 0) {
            def sh:string (this.sheetName(o.source))
            if ((strlen meta) > 0) {
                meta = (meta + " · ")
            }
            meta = (meta + "▤ " + sh)
        }
        if (o.repeats) {
            if ((strlen meta) > 0) {
                meta = (meta + " · ")
            }
            meta = (meta + "↻")
        }
        if ((strlen meta) > 0) {
            def mt:EVGElement (SpacesApp.tx("sp-meta" meta))
            mt.a11yHidden = true
            col.addChild(mt)
        }
        row.addChild(col)
        return row
    }

    fn sheetName:string (id:string) {
        def i:int 0
        while (i < (array_length space.sheets)) {
            def sh:SpSheet (itemAt space.sheets i)
            if (sh.id == id) {
                return sh.name
            }
            i = (i + 1)
        }
        return ""
    }

    fn deadlineRow:EVGElement (d:SpDeadline late:boolean) {
        def row:EVGElement (SpacesApp.box("sp-deadline"))
        if late {
            row = (SpacesApp.box("sp-deadline sp-late"))
        }
        row.role = "listitem"
        def who:string (space.resourceName(d.resource))
        def txt:string (d.title + " · " + (SpWords.ui(lang "due")) + " " + (SpWords.dayLabel(lang d.day)))
        if ((strlen who) > 0) {
            txt = (txt + " · " + who)
        }
        row.addChild((SpacesApp.tx("sp-flag" "⚑")))
        row.addChild((SpacesApp.tx("sp-deadline-tx" txt)))
        return row
    }

    fn lateCard:EVGElement () {
        def c:EVGElement (this.card("late" ((SpWords.ui(lang "overdue")) + " · " + (SpWords.noun(lang pack "deadlines")))))
        def late:[SpDeadline] (space.overdue(today))
        if ((array_length late) == 0) {
            c.addChild((SpacesApp.tx("sp-empty" (SpWords.pick(lang "Nothing is overdue" "Mikään ei ole myöhässä")))))
        }
        def i:int 0
        while (i < (array_length late)) {
            c.addChild((this.deadlineRow((itemAt late i) true)))
            i = (i + 1)
        }
        return c
    }

    fn sheetsCard:EVGElement () {
        def c:EVGElement (this.card("sheets" (SpWords.ui(lang "fromSheets"))))
        def i:int 0
        while (i < (array_length space.sheets)) {
            def sh:SpSheet (itemAt space.sheets i)
            def dated:int (array_length (space.sheetEvents(sh)))
            def b:EVGElement (UiTree.div(("sp-opensheet-" + sh.id) "sp-sheetrow"))
            b.role = "button"
            b.a11yFocusable = true
            b.a11yLabel = sh.name
            b.addChild((SpacesApp.tx("sp-sheeticon" "▤")))
            def col:EVGElement (SpacesApp.box("sp-itemtext"))
            col.addChild((SpacesApp.tx("sp-title" sh.name)))
            def meta:string ((to_string (sh.rowCount())) + " " + (SpWords.ui(lang "rows")))
            if (dated > 0) {
                meta = (meta + " · " + (to_string dated) + " " + (SpWords.ui(lang "dated")))
            }
            col.addChild((SpacesApp.tx("sp-meta" meta)))
            b.addChild(col)
            c.addChild(b)
            i = (i + 1)
        }
        c.addChild((SpacesApp.btn("sp-import" "sp-link" (SpWords.ui(lang "import")))))
        return c
    }

    fn loadCard:EVGElement () {
        def c:EVGElement (this.card("load" ((SpWords.noun(lang pack "resources")) + " · " + (SpWords.ui(lang "load")))))
        def mon:int (SpSpace.mondayOf(today))
        def load:[int] (space.loadOf(mon (mon + 13)))
        def most:int 1
        def i:int 0
        while (i < (array_length load)) {
            if ((itemAt load i) > most) {
                most = (itemAt load i)
            }
            i = (i + 1)
        }
        def barMax:double (((((this.mainW()) - 32.0) / 3.0) - 36.0) - 130.0)
        if (this.narrow()) {
            barMax = ((this.mainW()) - 170.0)
        }
        def k:int 0
        while (k < (array_length space.resources)) {
            def r:SpResource (itemAt space.resources k)
            def n:int (itemAt load k)
            def row:EVGElement (SpacesApp.box("sp-loadrow"))
            row.role = "listitem"
            row.a11yLabel = (r.name + ": " + (to_string n))
            def nm:EVGElement (SpacesApp.tx("sp-loadname" r.name))
            nm.a11yHidden = true
            row.addChild(nm)
            def bar:EVGElement (SpacesApp.box(("sp-bar sp-c-" + r.color)))
            def bw:double ((barMax * (to_double n)) / (to_double most))
            if (bw < 4.0) {
                bw = 4.0
            }
            UiTree.inline(bar "width" (SpacesApp.px(bw)))
            row.addChild(bar)
            def num:EVGElement (SpacesApp.tx("sp-loadnum" (to_string n)))
            num.a11yHidden = true
            row.addChild(num)
            c.addChild(row)
            k = (k + 1)
        }
        return c
    }

    fn writeCard:EVGElement () {
        def c:EVGElement (UiTree.div("sp-writecard" "sp-writecard"))
        if (this.narrow()) {
            c = (UiTree.div("sp-writecard" "sp-writecard sp-writecard-narrow"))
        }
        c.role = "region"
        c.a11yLabel = (SpWords.ui(lang "assistant"))
        c.addChild((SpacesApp.tx("sp-spark" "✦")))
        def col:EVGElement (SpacesApp.box("sp-itemtext"))
        col.addChild((SpacesApp.tx("sp-title" (SpWords.ui(lang "assistant")))))
        col.addChild((SpacesApp.tx("sp-meta" (SpWords.ui(lang "local")))))
        if (this.narrow()) {
            UiTree.inline(col "width" (SpacesApp.px(((this.mainW()) - 40.0))))
        }
        c.addChild(col)
        c.addChild((SpacesApp.box("sp-grow")))
        c.addChild((SpacesApp.btn("sp-write-summary" "sp-action" (SpWords.ui(lang "newSummary")))))
        c.addChild((SpacesApp.btn("sp-write-plan" "sp-action sp-action-primary" (SpWords.ui(lang "newPlan")))))
        return c
    }

    ; --- the calendar ---------------------------------------------------------------

    fn calendarView:EVGElement () {
        def v:EVGElement (SpacesApp.box("sp-view"))
        v.addChild((this.heading((SpWords.ui(lang "calendar")) (SpWords.pick(lang "Drag to move, drag an empty slot to add. Sheet rows are changed in their sheet." "Siirrä vetämällä, lisää vetämällä tyhjään kohtaan. Taulukon rivit muutetaan taulukossa.")))))
        board.cardW = (this.mainW())
        board.narrow = (this.narrow())
        board.focused = focused
        board.hovered = hovered
        v.addChild((board.card()))
        return v
