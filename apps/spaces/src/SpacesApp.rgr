; One call for the host to make: POST <op> with `body`. `ref` is what the
; answer is about (an event's or a ward's id here), `rev` the event's change
; count when its body was taken. A quiet get_space reads the space again
; for a change made elsewhere and keeps the page as it is.
class SpCall {
    def op:string ""
    def body:string "{}"
    def ref:string ""
    def rev:int 0
    def quiet:boolean false
    Constructor () {
    }
}

; The weather of one place, as the host read it (Open-Meteo's numbers,
; rounded): now, today's high and low, the chance of rain and the WMO code.
class SpWeather {
    def place:string ""
    def temp:int 0
    def hi:int 0
    def lo:int 0
    def rain:int 0
    def code:int 0
    ; by the hour from today's midnight (the place's time), when the host
    ; read them: the temperature, the chance of rain and the WMO code
    def hourT:[int]
    def hourRain:[int]
    def hourCode:[int]
    Constructor () {
    }
}

class SpacesApp {
    def space:SpSpace (new SpSpace())
    def pack:string "demo"
    def lang:string "fi"
    def tab:string "home"
    def today:int 0
    def nowMin:int 600
