    ; Two teams and the ball bags; Niko and Sara coach.
    sfn sports:void (s:SpSpace lang:string today:int mon:int) {
        s.addResource("u12" "U12" "blue")
        s.addResource("u14" "U14" "amber")
        s.addResource("kit" (SpWords.pick(lang "Ball bags" "Pallokassit")) "emerald")
        SpSeed.who((SpSeed.weekly(s (SpWords.pick(lang "U12 practice" "U12 treenit")) (mon - 28) 1020 1110 "u12" ([] _:int ( 1 3 )))) lang "coaches" "valmentaa" "Niko")
        SpSeed.who((SpSeed.weekly(s (SpWords.pick(lang "U14 practice" "U14 treenit")) (mon - 28) 1110 1200 "u14" ([] _:int ( 2 4 )))) lang "coaches" "valmentaa" "Sara")
        s.addEvent((SpWords.pick(lang "Coaches' meeting" "Valmentajapalaveri")) today 1080 1140 "")
