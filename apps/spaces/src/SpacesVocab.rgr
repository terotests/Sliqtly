; =============================================================================
; SpacesVocab — the words a space is shown in, and its demo data
; =============================================================================
; The model has one set of nouns (space, ward, responsibility, event, place,
; deadline): a ward is what the space looks after (a child, a pet, a car, a
; client, a team) and a responsibility who looks after an event, and how;
; a vocabulary pack names them for one kind of group. `demo` is the neutral
; one; `family`, `business` and `sports` are the same app with other words
; and their own demo data. The page's own words (navigation, headings) are
; `SpWords.ui`, in English and Finnish.
; =============================================================================

Import "SpacesModel.rgr"
Import "../evgui/src/UiDate.rgr"

class SpWords {

    sfn packs:[string] () {
        return ([] _:string ( "demo" "family" "business" "sports" ))
    }

    sfn langs:[string] () {
        return ([] _:string ( "fi" "en" ))
    }

    sfn pick:string (lang:string en:string fi:string) {
        if (lang == "fi") {
            return fi
        }
        return en
    }

    sfn packName:string (lang:string pack:string) {
        if (pack == "family") {
            return (SpWords.pick(lang "Family" "Perhe"))
        }
        if (pack == "business") {
            return (SpWords.pick(lang "Business" "Yritys"))
        }
        if (pack == "sports") {
            return (SpWords.pick(lang "Sports" "Urheilu"))
        }
        return (SpWords.pick(lang "Demo" "Demo"))
    }

    ; A noun of the model, named by the pack: space, resources (the wards),
    ; resource (one ward), responsibility, event, place, deadlines.
    sfn noun:string (lang:string pack:string key:string) {
        if (key == "space") {
            if (pack == "family") {
                return (SpWords.pick(lang "Family" "Perhe"))
            }
            if (pack == "business") {
                return (SpWords.pick(lang "Team" "Tiimi"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Club" "Seura"))
            }
            return (SpWords.pick(lang "Space" "Tila"))
        }
        if (key == "resources") {
            if (pack == "family") {
                return (SpWords.pick(lang "Dependants" "Hoidettavat"))
            }
            if (pack == "business") {
                return (SpWords.pick(lang "Clients and equipment" "Asiakkaat ja laitteet"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Players and kit" "Pelaajat ja kalusto"))
            }
            return (SpWords.pick(lang "Wards" "Vastuukohteet"))
        }
        if (key == "resource") {
            if (pack == "family") {
                return (SpWords.pick(lang "Dependant" "Hoidettava"))
            }
            if (pack == "business") {
                return (SpWords.pick(lang "Client or equipment" "Asiakas tai laite"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Player or kit" "Pelaaja tai väline"))
            }
            return (SpWords.pick(lang "Ward" "Vastuukohde"))
        }
        if (key == "responsibility") {
            if (pack == "family") {
                return (SpWords.pick(lang "Turn" "Hoitovuoro"))
            }
            if (pack == "business") {
                return (SpWords.pick(lang "Owner" "Vastuuhenkilö"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Coach in charge" "Vastuuvalmentaja"))
            }
            return (SpWords.pick(lang "Responsibility" "Vastuu"))
        }
        if (key == "event") {
            if (pack == "family") {
                return (SpWords.pick(lang "Plan" "Meno"))
            }
            if (pack == "business") {
                return (SpWords.pick(lang "Meeting" "Palaveri"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Session" "Treeni"))
            }
            return (SpWords.pick(lang "Event" "Tapahtuma"))
        }
        if (key == "place") {
            if (pack == "business") {
                return (SpWords.pick(lang "Location" "Toimipiste"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Venue" "Kenttä"))
            }
            return (SpWords.pick(lang "Place" "Paikka"))
        }
        if (key == "deadlines") {
            if (pack == "family") {
                return (SpWords.pick(lang "To remember" "Muistettavaa"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Sign-ups and dues" "Ilmoittautumiset ja maksut"))
            }
            return (SpWords.pick(lang "Deadlines" "Määräajat"))
        }
        return key
    }

    ; The page's own words.
    sfn ui:string (lang:string key:string) {
        if (key == "home") { return (SpWords.pick(lang "Summary" "Koonti")) }
        if (key == "calendar") { return (SpWords.pick(lang "Calendar" "Kalenteri")) }
        if (key == "sheets") { return (SpWords.pick(lang "Sheets" "Taulukot")) }
        if (key == "docs") { return (SpWords.pick(lang "Documents" "Dokumentit")) }
        if (key == "assistant") { return (SpWords.pick(lang "Assistant" "Avustaja")) }
        if (key == "today") { return (SpWords.pick(lang "Today" "Tänään")) }
        if (key == "week") { return (SpWords.pick(lang "Later this week" "Myöhemmin tällä viikolla")) }
        if (key == "next") { return (SpWords.pick(lang "Next week" "Ensi viikolla")) }
        if (key == "nothing") { return (SpWords.pick(lang "Nothing planned" "Ei suunniteltua")) }
        if (key == "weekEnds") { return (SpWords.pick(lang "The week ends today" "Viikko päättyy tänään")) }
        if (key == "allDay") { return (SpWords.pick(lang "all day" "koko päivän")) }
        if (key == "overdue") { return (SpWords.pick(lang "Overdue" "Myöhässä")) }
        if (key == "due") { return (SpWords.pick(lang "due" "viimeistään")) }
        if (key == "fromSheets") { return (SpWords.pick(lang "From sheets" "Taulukoista")) }
        if (key == "rows") { return (SpWords.pick(lang "rows" "riviä")) }
        if (key == "dated") { return (SpWords.pick(lang "dated rows in the calendar" "päivättyä riviä kalenterissa")) }
        if (key == "load") { return (SpWords.pick(lang "This week and next" "Tämä ja ensi viikko")) }
        if (key == "words") { return (SpWords.pick(lang "Words" "Sanasto")) }
        if (key == "lang") { return (SpWords.pick(lang "Language" "Kieli")) }
        if (key == "import") { return (SpWords.pick(lang "Import CSV or paste from a spreadsheet" "Tuo CSV tai liitä taulukosta")) }
        if (key == "exportCsv") { return (SpWords.pick(lang "Download CSV" "Lataa CSV")) }
        if (key == "newSummary") { return (SpWords.pick(lang "Write this week's summary" "Kirjoita viikkokooste")) }
        if (key == "newPlan") { return (SpWords.pick(lang "Plan next week" "Suunnittele ensi viikko")) }
        if (key == "ask") { return (SpWords.pick(lang "Ask about your days" "Kysy päivistäsi")) }
        if (key == "qToday") { return (SpWords.pick(lang "What's on today?" "Mitä tänään?")) }
        if (key == "qWeek") { return (SpWords.pick(lang "Summarise this week" "Kooste tästä viikosta")) }
        if (key == "qNext") { return (SpWords.pick(lang "What's next week?" "Mitä ensi viikolla?")) }
        if (key == "qLate") { return (SpWords.pick(lang "Is anything overdue?" "Onko jotain myöhässä?")) }
        if (key == "qPlan") { return (SpWords.pick(lang "Draft a plan for next week" "Luonnostele ensi viikon suunnitelma")) }
        if (key == "local") { return (SpWords.pick(lang "Answers come from this space's calendar, sheets and deadlines." "Vastaukset tulevat tämän tilan kalenterista, taulukoista ja määräajoista.")) }
        if (key == "noDocs") { return (SpWords.pick(lang "No documents yet" "Ei vielä dokumentteja")) }
        if (key == "members") { return (SpWords.pick(lang "Members" "Jäsenet")) }
        if (key == "spaces") { return (SpWords.pick(lang "Spaces" "Tilat")) }
        if (key == "owner") { return (SpWords.pick(lang "owner" "omistaja")) }
        if (key == "member") { return (SpWords.pick(lang "member" "jäsen")) }
        if (key == "invited") { return (SpWords.pick(lang "Invited, not joined yet" "Kutsuttu, ei vielä liittynyt")) }
        if (key == "invite") { return (SpWords.pick(lang "Invite" "Kutsu")) }
        if (key == "email") { return (SpWords.pick(lang "Email address" "Sähköpostiosoite")) }
        if (key == "remove") { return (SpWords.pick(lang "Remove" "Poista")) }
        if (key == "newSpace") { return (SpWords.pick(lang "New space" "Uusi tila")) }
        if (key == "spaceName") { return (SpWords.pick(lang "Name of the space" "Tilan nimi")) }
        if (key == "create") { return (SpWords.pick(lang "Create" "Luo")) }
        if (key == "open") { return (SpWords.pick(lang "Open" "Avaa")) }
        if (key == "seed") { return (SpWords.pick(lang "Load demo data" "Lataa esimerkkidata")) }
        if (key == "empty") { return (SpWords.pick(lang "This space is empty. Add events on the calendar, or start from the demo data." "Tila on tyhjä. Lisää tapahtumia kalenterissa tai aloita esimerkkidatasta.")) }
        if (key == "noSpaces") { return (SpWords.pick(lang "You have no spaces yet. Create one, or ask to be invited to one." "Sinulla ei ole vielä tiloja. Luo uusi tai pyydä kutsu johonkin.")) }
        if (key == "loading") { return (SpWords.pick(lang "Loading…" "Ladataan…")) }
        if (key == "saving") { return (SpWords.pick(lang "Saving…" "Tallennetaan…")) }
        if (key == "important") { return (SpWords.pick(lang "Important" "Tärkeä")) }
        return key
    }

    ; "Mon 19.10." / "Mon Oct 19"
    sfn dayLabel:string (lang:string d:int) {
        def p:[int] (SpSpace.ymdOf(d))
        def wd:int (UiDate.weekday(d))
        if (lang == "fi") {
            def fi:string (itemAt ([] _:string ( "su" "ma" "ti" "ke" "to" "pe" "la" )) wd)
            return (fi + " " + (to_string (itemAt p 2)) + "." + (to_string (itemAt p 1)) + ".")
        }
        def en:string (itemAt ([] _:string ( "Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat" )) wd)
        def mo:string (itemAt ([] _:string ( "Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec" )) ((itemAt p 1) - 1))
        return (en + " " + mo + " " + (to_string (itemAt p 2)))
    }

    ; "9.30" / "9:30"
    sfn clock:string (lang:string m:int) {
        def h:int (idiv m 60)
        def mm:int (m - (h * 60))
        def ms:string (to_string mm)
        if (mm < 10) {
            ms = ("0" + ms)
        }
        if (lang == "fi") {
            return ((to_string h) + "." + ms)
        }
        return ((to_string h) + ":" + ms)
    }

    sfn timeOf:string (lang:string o:SpOccur) {
        if (o.allDay()) {
            return (SpWords.ui(lang "allDay"))
        }
        if (o.endMin > o.startMin) {
            return ((SpWords.clock(lang o.startMin)) + "–" + (SpWords.clock(lang o.endMin)))
        }
        return (SpWords.clock(lang o.startMin))
    }
}

; Demo data for each pack, laid out around `today` so the summary always has
; something today, this week and next week.
class SpSeed {

    sfn build:SpSpace (pack:string lang:string today:int) {
        def s (new SpSpace())
        s.vocab = pack
        s.today = today
        s.name = (SpWords.noun(lang pack "space"))
        def mon:int (SpSpace.mondayOf(today))
        if (pack == "family") {
            SpSeed.family(s lang today mon)
            return s
        }
        if (pack == "business") {
            SpSeed.business(s lang today mon)
            return s
        }
        if (pack == "sports") {
            SpSeed.sports(s lang today mon)
            return s
        }
        SpSeed.demo(s lang today mon)
        return s
    }

    sfn weekly:SpEvent (s:SpSpace title:string first:int startMin:int endMin:int res:string days:[int]) {
        def e:SpEvent (s.addEvent(title first startMin endMin res))
        e.rule.freq = "weekly"
        e.rule.byDay = days
        return e
    }

    ; who is responsible: "Takes: Alex"
    sfn who:SpEvent (e:SpEvent lang:string en:string fi:string name:string) {
        e.addWho(name (SpWords.pick(lang en fi)))
        return e
    }

    ; Wards here are a child, a dog and a car; Alex, Sam and Kim look after
    ; them.
    sfn demo:void (s:SpSpace lang:string today:int mon:int) {
        s.name = (SpWords.pick(lang "Demo space" "Demotila"))
        def car:string (SpWords.pick(lang "Car" "Auto"))
        s.addResource("aino" "Aino" "rose")
        s.addResource("otso" "Otso" "amber")
        s.addResource("car" car "blue")
        SpSeed.who((SpSeed.weekly(s (SpWords.pick(lang "Swimming lesson" "Uimakoulu")) (mon - 28) 1020 1065 "aino" ([] _:int ( 1 )))) lang "takes" "vie" "Alex")
        SpSeed.who((SpSeed.weekly(s (SpWords.pick(lang "Dog walk" "Koiralenkki")) (mon - 28) 1080 1140 "otso" ([] _:int ( 2 4 )))) lang "walks" "ulkoiluttaa" "Sam")
        def vet:SpEvent (SpSeed.who((s.addEvent((SpWords.pick(lang "Vet" "Eläinlääkäri")) today 690 750 "otso")) lang "takes" "vie" "Kim"))
        vet.important = true
        SpSeed.who((s.addEvent((SpWords.pick(lang "Car service" "Auton huolto")) (mon + 3) 780 930 "car")) lang "takes" "vie" "Alex")
        SpSeed.who((s.addAllDay((SpWords.pick(lang "Camp" "Leiri")) (mon + 9) (mon + 11) "aino")) lang "picks up" "hakee" "Sam")
        SpSeed.who((s.addEvent((SpWords.pick(lang "Parents' evening" "Vanhempainilta")) (mon + 8) 1080 1170 "aino")) lang "attends" "osallistuu" "Kim")
        s.addDeadline((SpWords.pick(lang "Renew the car insurance" "Uusi auton vakuutus")) (mon + 4) "car")
        s.addDeadline((SpWords.pick(lang "Book the dog's vaccination" "Varaa koiran rokotus")) (mon + 10) "otso")
        s.addDeadline((SpWords.pick(lang "Return the forms" "Palauta lomakkeet")) (today - 2) "aino")
        s.addSheet((SpSeed.sheet("s1" (SpWords.pick(lang "Shared schedule" "Yhteinen aikataulu")) lang
            ([] _:string ( "date" "time" "what" "who" ))
            ([] _:int ( (today + 1) (mon + 7) (mon + 12) ))
            ([] _:string ( "16-17" (SpWords.pick(lang "Drive to practice" "Treenikyyti")) "Aino" "9-10" (SpWords.pick(lang "Grooming" "Trimmaus")) "Otso" "" (SpWords.pick(lang "Tyre change" "Renkaanvaihto")) car )))))
        s.addDoc((SpWords.pick(lang "How we work" "Näin toimimme"))
            (SpWords.pick(lang "# How we work\n\n- The summary shows today, this week and next week.\n- Each event names its ward and who looks after it.\n- Shared schedules live in Sheets; dated rows show in the calendar.\n- Ask the assistant for a summary or a plan."
                "# Näin toimimme\n\n- Koonti näyttää tämän päivän, tämän viikon ja ensi viikon.\n- Jokaisessa tapahtumassa näkyy vastuukohde ja kuka siitä huolehtii.\n- Yhteiset aikataulut ovat Taulukoissa; päivätyt rivit näkyvät kalenterissa.\n- Pyydä avustajalta koostetta tai suunnitelmaa.")) (mon - 3))
    }

