            ([] _:string ( "18-19.30" (SpWords.pick(lang "Home game" "Kotiottelu")) "U14" "10-11.30" (SpWords.pick(lang "Away game" "Vierasottelu")) "U12" "12-13.30" (SpWords.pick(lang "Home game" "Kotiottelu")) "U14" )))))
        s.addDoc((SpWords.pick(lang "Season plan" "Kausisuunnitelma"))
            (SpWords.pick(lang "# Season plan\n\n- Two practices a week per team.\n- Match schedule in Sheets.\n- Fees due before the first game."
                "# Kausisuunnitelma\n\n- Kaksi treeniä viikossa joukkuetta kohden.\n- Otteluohjelma Taulukoissa.\n- Maksut ennen ensimmäistä ottelua.")) (mon - 6))
    }

    ; What a space on a server keeps of the seed: its wards and its events,
    ; each deadline as an important all-day event. Sheets and documents stay
    ; in the page.
    sfn serverEvents:[SpEvent] (s:SpSpace) {
        def out:[SpEvent]
        def i:int 0
        while (i < (array_length s.events)) {
            push out (itemAt s.events i)
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length s.deadlines)) {
            def d:SpDeadline (itemAt s.deadlines k)
            def e (new SpEvent())
            e.title = d.title
            e.day = d.day
            e.endDay = d.day
            e.resource = d.resource
            e.important = true
            push out e
            k = (k + 1)
        }
        return out
    }

    ; A sheet with English or Finnish headings: `heads` are the English keys,
    ; `days` one per row and `rest` the other columns row by row.
    sfn sheet:SpSheet (id:string name:string lang:string heads:[string] days:[int] rest:[string]) {
        def sh (new SpSheet())
        sh.id = id
        sh.name = name
        def i:int 0
        while (i < (array_length heads)) {
            push sh.cols (SpSeed.heading(lang (itemAt heads i)))
            i = (i + 1)
        }
        def per:int ((array_length heads) - 1)
        def r:int 0
        while (r < (array_length days)) {
            def row:[string]
            def p:[int] (SpSpace.ymdOf((itemAt days r)))
            if (lang == "fi") {
                push row ((to_string (itemAt p 2)) + "." + (to_string (itemAt p 1)) + "." + (to_string (itemAt p 0)))
            } {
                push row (UiDate.iso((itemAt p 0) (itemAt p 1) (itemAt p 2)))
            }
            def c:int 0
            while (c < per) {
                push row (itemAt rest ((r * per) + c))
                c = (c + 1)
            }
            sh.addRow(row)
            r = (r + 1)
        }
        return sh
    }

    sfn heading:string (lang:string key:string) {
        if (lang != "fi") {
            return ((to_uppercase (substring key 0 1)) + (substring key 1 (strlen key)))
        }
        if (key == "date") { return "Päivä" }
        if (key == "time") { return "Aika" }
        if (key == "what") { return "Mitä" }
        if (key == "who") { return "Kuka" }
        return key
    }
}
