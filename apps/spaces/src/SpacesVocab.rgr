; =============================================================================
; SpacesVocab — the words a space is shown in, and its demo data
; =============================================================================
; The model has one set of nouns (space, resource, event, place, deadline);
; a vocabulary pack names them for one kind of group. `demo` is the neutral
; one; `family`, `business` and `sports` are the same app with other words
; and their own demo data. The page's own words (navigation, headings) are
; `SpWords.ui`, in English and Finnish.
; =============================================================================

Import "SpacesModel.rgr"
Import "../evgui/src/UiDate.rgr"

class SpWords {

    sfn packs:[string] () {
        return ([] _:string ( "demo" "family" "business" "sports" ))
    }

    sfn langs:[string] () {
        return ([] _:string ( "fi" "en" ))
    }

    sfn pick:string (lang:string en:string fi:string) {
        if (lang == "fi") {
            return fi
        }
        return en
    }

    sfn packName:string (lang:string pack:string) {
        if (pack == "family") {
            return (SpWords.pick(lang "Family" "Perhe"))
        }
        if (pack == "business") {
            return (SpWords.pick(lang "Business" "Yritys"))
        }
        if (pack == "sports") {
            return (SpWords.pick(lang "Sports" "Urheilu"))
        }
        return (SpWords.pick(lang "Demo" "Demo"))
    }

    ; A noun of the model, named by the pack: space, resources, resource,
    ; event, place, deadlines.
    sfn noun:string (lang:string pack:string key:string) {
        if (key == "space") {
            if (pack == "family") {
                return (SpWords.pick(lang "Family" "Perhe"))
            }
            if (pack == "business") {
                return (SpWords.pick(lang "Team" "Tiimi"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Club" "Seura"))
            }
            return (SpWords.pick(lang "Space" "Tila"))
        }
        if (key == "resources") {
            if (pack == "family") {
                return (SpWords.pick(lang "Family members" "Perheenjäsenet"))
            }
            if (pack == "business") {
                return (SpWords.pick(lang "People and rooms" "Ihmiset ja tilat"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Teams" "Joukkueet"))
            }
            return (SpWords.pick(lang "Resources" "Resurssit"))
        }
        if (key == "event") {
            if (pack == "family") {
                return (SpWords.pick(lang "Plan" "Meno"))
            }
            if (pack == "business") {
                return (SpWords.pick(lang "Meeting" "Palaveri"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Session" "Treeni"))
            }
            return (SpWords.pick(lang "Event" "Tapahtuma"))
        }
        if (key == "place") {
            if (pack == "business") {
                return (SpWords.pick(lang "Location" "Toimipiste"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Venue" "Kenttä"))
            }
            return (SpWords.pick(lang "Place" "Paikka"))
        }
        if (key == "deadlines") {
            if (pack == "family") {
                return (SpWords.pick(lang "To remember" "Muistettavaa"))
            }
            if (pack == "sports") {
                return (SpWords.pick(lang "Sign-ups and dues" "Ilmoittautumiset ja maksut"))
            }
            return (SpWords.pick(lang "Deadlines" "Määräajat"))
        }
        return key
    }

    ; The page's own words.
    sfn ui:string (lang:string key:string) {
        if (key == "home") { return (SpWords.pick(lang "Summary" "Koonti")) }
        if (key == "calendar") { return (SpWords.pick(lang "Calendar" "Kalenteri")) }
        if (key == "sheets") { return (SpWords.pick(lang "Sheets" "Taulukot")) }
        if (key == "docs") { return (SpWords.pick(lang "Documents" "Dokumentit")) }
        if (key == "assistant") { return (SpWords.pick(lang "Assistant" "Avustaja")) }
        if (key == "today") { return (SpWords.pick(lang "Today" "Tänään")) }
        if (key == "week") { return (SpWords.pick(lang "Later this week" "Myöhemmin tällä viikolla")) }
        if (key == "next") { return (SpWords.pick(lang "Next week" "Ensi viikolla")) }
        if (key == "nothing") { return (SpWords.pick(lang "Nothing planned" "Ei suunniteltua")) }
        if (key == "weekEnds") { return (SpWords.pick(lang "The week ends today" "Viikko päättyy tänään")) }
        if (key == "allDay") { return (SpWords.pick(lang "all day" "koko päivän")) }
        if (key == "overdue") { return (SpWords.pick(lang "Overdue" "Myöhässä")) }
        if (key == "due") { return (SpWords.pick(lang "due" "viimeistään")) }
        if (key == "fromSheets") { return (SpWords.pick(lang "From sheets" "Taulukoista")) }
        if (key == "rows") { return (SpWords.pick(lang "rows" "riviä")) }
        if (key == "dated") { return (SpWords.pick(lang "dated rows in the calendar" "päivättyä riviä kalenterissa")) }
        if (key == "load") { return (SpWords.pick(lang "This week and next" "Tämä ja ensi viikko")) }
        if (key == "words") { return (SpWords.pick(lang "Words" "Sanasto")) }
        if (key == "lang") { return (SpWords.pick(lang "Language" "Kieli")) }
        if (key == "import") { return (SpWords.pick(lang "Import CSV or paste from a spreadsheet" "Tuo CSV tai liitä taulukosta")) }
        if (key == "exportCsv") { return (SpWords.pick(lang "Download CSV" "Lataa CSV")) }
        if (key == "newSummary") { return (SpWords.pick(lang "Write this week's summary" "Kirjoita viikkokooste")) }
        if (key == "newPlan") { return (SpWords.pick(lang "Plan next week" "Suunnittele ensi viikko")) }
        if (key == "ask") { return (SpWords.pick(lang "Ask about your days" "Kysy päivistäsi")) }
        if (key == "qToday") { return (SpWords.pick(lang "What's on today?" "Mitä tänään?")) }
        if (key == "qWeek") { return (SpWords.pick(lang "Summarise this week" "Kooste tästä viikosta")) }
        if (key == "qNext") { return (SpWords.pick(lang "What's next week?" "Mitä ensi viikolla?")) }
        if (key == "qLate") { return (SpWords.pick(lang "Is anything overdue?" "Onko jotain myöhässä?")) }
        if (key == "qPlan") { return (SpWords.pick(lang "Draft a plan for next week" "Luonnostele ensi viikon suunnitelma")) }
        if (key == "local") { return (SpWords.pick(lang "Answers come from this space's calendar, sheets and deadlines." "Vastaukset tulevat tämän tilan kalenterista, taulukoista ja määräajoista.")) }
        if (key == "noDocs") { return (SpWords.pick(lang "No documents yet" "Ei vielä dokumentteja")) }
        return key
    }

    ; "Mon 19.10." / "Mon Oct 19"
    sfn dayLabel:string (lang:string d:int) {
        def p:[int] (SpSpace.ymdOf(d))
        def wd:int (UiDate.weekday(d))
        if (lang == "fi") {
            def fi:string (itemAt ([] _:string ( "su" "ma" "ti" "ke" "to" "pe" "la" )) wd)
            return (fi + " " + (to_string (itemAt p 2)) + "." + (to_string (itemAt p 1)) + ".")
        }
        def en:string (itemAt ([] _:string ( "Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat" )) wd)
        def mo:string (itemAt ([] _:string ( "Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec" )) ((itemAt p 1) - 1))
        return (en + " " + mo + " " + (to_string (itemAt p 2)))
    }

    ; "9.30" / "9:30"
    sfn clock:string (lang:string m:int) {
        def h:int (idiv m 60)
        def mm:int (m - (h * 60))
        def ms:string (to_string mm)
        if (mm < 10) {
            ms = ("0" + ms)
        }
        if (lang == "fi") {
            return ((to_string h) + "." + ms)
        }
        return ((to_string h) + ":" + ms)
    }

    sfn timeOf:string (lang:string o:SpOccur) {
        if (o.allDay()) {
            return (SpWords.ui(lang "allDay"))
        }
        if (o.endMin > o.startMin) {
            return ((SpWords.clock(lang o.startMin)) + "–" + (SpWords.clock(lang o.endMin)))
        }
        return (SpWords.clock(lang o.startMin))
    }
}

; Demo data for each pack, laid out around `today` so the summary always has
; something today, this week and next week.
class SpSeed {

    sfn build:SpSpace (pack:string lang:string today:int) {
        def s (new SpSpace())
        s.vocab = pack
        s.today = today
        s.name = (SpWords.noun(lang pack "space"))
        def mon:int (SpSpace.mondayOf(today))
        if (pack == "family") {
            SpSeed.family(s lang today mon)
            return s
        }
        if (pack == "business") {
            SpSeed.business(s lang today mon)
            return s
        }
        if (pack == "sports") {
            SpSeed.sports(s lang today mon)
            return s
        }
        SpSeed.demo(s lang today mon)
        return s
    }

    sfn weekly:SpEvent (s:SpSpace title:string first:int startMin:int endMin:int res:string days:[int]) {
        def e:SpEvent (s.addEvent(title first startMin endMin res))
        e.rule.freq = "weekly"
        e.rule.byDay = days
        return e
    }

    sfn demo:void (s:SpSpace lang:string today:int mon:int) {
        s.name = (SpWords.pick(lang "Demo space" "Demotila"))
        s.addResource("a" "Alex" "blue")
        s.addResource("b" "Sam" "emerald")
        s.addResource("c" "Kim" "violet")
        SpSeed.weekly(s (SpWords.pick(lang "Weekly check-in" "Viikkokatsaus")) (mon - 28) 540 570 "a" ([] _:int ( 1 )))
        SpSeed.weekly(s (SpWords.pick(lang "Gym" "Sali")) (mon - 28) 1080 1140 "b" ([] _:int ( 2 4 )))
        s.addEvent((SpWords.pick(lang "Lunch with Kim" "Lounas Kimin kanssa")) today 690 750 "c")
        s.addEvent((SpWords.pick(lang "Workshop" "Työpaja")) (mon + 3) 780 930 "a")
        s.addAllDay((SpWords.pick(lang "Trip" "Matka")) (mon + 9) (mon + 11) "b")
        s.addEvent((SpWords.pick(lang "Review" "Katselmointi")) (mon + 8) 600 660 "c")
        s.addDeadline((SpWords.pick(lang "Send the report" "Lähetä raportti")) (mon + 4) "a")
        s.addDeadline((SpWords.pick(lang "Book the venue" "Varaa tila")) (mon + 10) "b")
        s.addDeadline((SpWords.pick(lang "Return the forms" "Palauta lomakkeet")) (today - 2) "c")
        s.addSheet((SpSeed.sheet("s1" (SpWords.pick(lang "Shared schedule" "Yhteinen aikataulu")) lang
            ([] _:string ( "date" "time" "what" "who" ))
            ([] _:int ( (today + 1) (mon + 7) (mon + 12) ))
            ([] _:string ( "16-17" (SpWords.pick(lang "Cleaning rota" "Siivousvuoro")) "Kim" "9-10" (SpWords.pick(lang "Planning" "Suunnittelu")) "Alex" "" (SpWords.pick(lang "Open day" "Avoimet ovet")) "Sam" )))))
        s.addDoc((SpWords.pick(lang "How we work" "Näin toimimme"))
            (SpWords.pick(lang "# How we work\n\n- The summary shows today, this week and next week.\n- Shared schedules live in Sheets; dated rows show in the calendar.\n- Ask the assistant for a summary or a plan."
                "# Näin toimimme\n\n- Koonti näyttää tämän päivän, tämän viikon ja ensi viikon.\n- Yhteiset aikataulut ovat Taulukoissa; päivätyt rivit näkyvät kalenterissa.\n- Pyydä avustajalta koostetta tai suunnitelmaa.")) (mon - 3))
    }

    sfn family:void (s:SpSpace lang:string today:int mon:int) {
        s.addResource("aino" "Aino" "rose")
        s.addResource("eero" "Eero" "blue")
        s.addResource("mia" "Mia" "amber")
        s.addResource("leo" "Leo" "emerald")
        SpSeed.weekly(s (SpWords.pick(lang "Football practice" "Jalkapallotreenit")) (mon - 28) 1050 1140 "eero" ([] _:int ( 2 4 )))
        SpSeed.weekly(s (SpWords.pick(lang "Piano lesson" "Pianotunti")) (mon - 28) 960 1005 "aino" ([] _:int ( 3 )))
        SpSeed.weekly(s (SpWords.pick(lang "Swimming" "Uinti")) (mon - 28) 600 660 "leo" ([] _:int ( 6 )))
        s.addEvent((SpWords.pick(lang "Dentist" "Hammaslääkäri")) today 840 870 "aino")
        s.addEvent((SpWords.pick(lang "Parents' evening" "Vanhempainilta")) (mon + 3) 1080 1170 "mia")
        s.addAllDay((SpWords.pick(lang "Grandparents visit" "Isovanhemmat kylässä")) (mon + 12) (mon + 13) "")
        s.addEvent((SpWords.pick(lang "Birthday party" "Synttärit")) (mon + 12) 780 900 "leo")
        s.addDeadline((SpWords.pick(lang "Pay the school trip" "Maksa luokkaretki")) (mon + 4) "mia")
        s.addDeadline((SpWords.pick(lang "Sign the permission slip" "Allekirjoita lupalappu")) (mon + 8) "eero")
        s.addDeadline((SpWords.pick(lang "Return library books" "Palauta kirjaston kirjat")) (today - 1) "aino")
        s.addSheet((SpSeed.sheet("s1" (SpWords.pick(lang "Driving rota" "Kuskausvuorot")) lang
            ([] _:string ( "date" "time" "what" "who" ))
            ([] _:int ( (today + 1) (mon + 8) (mon + 10) ))
            ([] _:string ( "17.15" (SpWords.pick(lang "Drive to practice" "Treenikyyti")) "Mia" "17.15" (SpWords.pick(lang "Drive to practice" "Treenikyyti")) "Leo" "15.45" (SpWords.pick(lang "Pick up from piano" "Haku pianotunnilta")) "Mia" )))))
        s.addDoc((SpWords.pick(lang "Holiday plans" "Lomasuunnitelmat"))
            (SpWords.pick(lang "# Holiday plans\n\n- Cabin week: decide the dates.\n- Who looks after the cat?\n- Packing list in Sheets."
                "# Lomasuunnitelmat\n\n- Mökkiviikko: päätetään päivät.\n- Kuka hoitaa kissan?\n- Pakkauslista Taulukoissa.")) (mon - 5))
    }

    sfn business:void (s:SpSpace lang:string today:int mon:int) {
        s.addResource("ops" (SpWords.pick(lang "Operations" "Operatiivinen")) "blue")
        s.addResource("sales" (SpWords.pick(lang "Sales" "Myynti")) "emerald")
        s.addResource("room" (SpWords.pick(lang "Meeting room" "Neuvotteluhuone")) "violet")
        SpSeed.weekly(s (SpWords.pick(lang "Team stand-up" "Tiimin aamupalaveri")) (mon - 28) 540 555 "ops" ([] _:int ( 1 2 3 4 5 )))
        SpSeed.weekly(s (SpWords.pick(lang "Sales pipeline" "Myyntiputki")) (mon - 28) 780 840 "sales" ([] _:int ( 3 )))
        s.addEvent((SpWords.pick(lang "Customer workshop" "Asiakastyöpaja")) today 600 720 "room")
        s.addEvent((SpWords.pick(lang "Quarterly review" "Kvartaalikatsaus")) (mon + 9) 780 900 "room")
        s.addAllDay((SpWords.pick(lang "Trade fair" "Messut")) (mon + 10) (mon + 11) "sales")
        s.addDeadline((SpWords.pick(lang "Offer to customer" "Tarjous asiakkaalle")) (mon + 4) "sales")
        s.addDeadline((SpWords.pick(lang "Monthly report" "Kuukausiraportti")) (mon + 7) "ops")
        s.addDeadline((SpWords.pick(lang "Approve invoices" "Hyväksy laskut")) (today - 1) "ops")
        s.addSheet((SpSeed.sheet("s1" (SpWords.pick(lang "Shift list" "Vuorolista")) lang
            ([] _:string ( "date" "time" "what" "who" ))
            ([] _:int ( today (today + 1) (mon + 8) ))
            ([] _:string ( "12-16" (SpWords.pick(lang "Customer desk" "Asiakaspalvelu")) (SpWords.pick(lang "Sales" "Myynti")) "8-12" (SpWords.pick(lang "Customer desk" "Asiakaspalvelu")) (SpWords.pick(lang "Operations" "Operatiivinen")) "8-16" (SpWords.pick(lang "Stock count" "Inventaario")) (SpWords.pick(lang "Operations" "Operatiivinen")) )))))
        s.addDoc((SpWords.pick(lang "Q4 goals" "Q4-tavoitteet"))
            (SpWords.pick(lang "# Q4 goals\n\n- Three new customers.\n- Shift list kept in Sheets.\n- Review every Friday."
                "# Q4-tavoitteet\n\n- Kolme uutta asiakasta.\n- Vuorolista Taulukoissa.\n- Katsaus joka perjantai.")) (mon - 4))
    }

    sfn sports:void (s:SpSpace lang:string today:int mon:int) {
        s.addResource("u12" "U12" "blue")
        s.addResource("u14" "U14" "amber")
        s.addResource("hall" (SpWords.pick(lang "Sports hall" "Urheiluhalli")) "emerald")
        SpSeed.weekly(s (SpWords.pick(lang "U12 practice" "U12 treenit")) (mon - 28) 1020 1110 "u12" ([] _:int ( 1 3 )))
        SpSeed.weekly(s (SpWords.pick(lang "U14 practice" "U14 treenit")) (mon - 28) 1110 1200 "u14" ([] _:int ( 2 4 )))
        s.addEvent((SpWords.pick(lang "Coaches' meeting" "Valmentajapalaveri")) today 1080 1140 "hall")
        s.addAllDay((SpWords.pick(lang "Tournament" "Turnaus")) (mon + 12) (mon + 13) "u12")
        s.addDeadline((SpWords.pick(lang "Tournament sign-up" "Turnausilmoittautuminen")) (mon + 4) "u12")
        s.addDeadline((SpWords.pick(lang "Season fees" "Kausimaksut")) (mon + 9) "u14")
        s.addDeadline((SpWords.pick(lang "Kit order" "Asutilaus")) (today - 3) "u14")
        s.addSheet((SpSeed.sheet("s1" (SpWords.pick(lang "Match schedule" "Otteluohjelma")) lang
            ([] _:string ( "date" "time" "what" "who" ))
            ([] _:int ( (today + 1) (mon + 6) (mon + 13) ))
            ([] _:string ( "18-19.30" (SpWords.pick(lang "Home game" "Kotiottelu")) "U14" "10-11.30" (SpWords.pick(lang "Away game" "Vierasottelu")) "U12" "12-13.30" (SpWords.pick(lang "Home game" "Kotiottelu")) "U14" )))))
        s.addDoc((SpWords.pick(lang "Season plan" "Kausisuunnitelma"))
            (SpWords.pick(lang "# Season plan\n\n- Two practices a week per team.\n- Match schedule in Sheets.\n- Fees due before the first game."
                "# Kausisuunnitelma\n\n- Kaksi treeniä viikossa joukkuetta kohden.\n- Otteluohjelma Taulukoissa.\n- Maksut ennen ensimmäistä ottelua.")) (mon - 6))
    }

    ; A sheet with English or Finnish headings: `heads` are the English keys,
    ; `days` one per row and `rest` the other columns row by row.
    sfn sheet:SpSheet (id:string name:string lang:string heads:[string] days:[int] rest:[string]) {
        def sh (new SpSheet())
        sh.id = id
        sh.name = name
        def i:int 0
        while (i < (array_length heads)) {
            push sh.cols (SpSeed.heading(lang (itemAt heads i)))
            i = (i + 1)
        }
        def per:int ((array_length heads) - 1)
        def r:int 0
        while (r < (array_length days)) {
            def row:[string]
            def p:[int] (SpSpace.ymdOf((itemAt days r)))
            if (lang == "fi") {
                push row ((to_string (itemAt p 2)) + "." + (to_string (itemAt p 1)) + "." + (to_string (itemAt p 0)))
            } {
                push row (UiDate.iso((itemAt p 0) (itemAt p 1) (itemAt p 2)))
            }
            def c:int 0
            while (c < per) {
                push row (itemAt rest ((r * per) + c))
                c = (c + 1)
            }
            sh.addRow(row)
            r = (r + 1)
        }
        return sh
    }

    sfn heading:string (lang:string key:string) {
        if (lang != "fi") {
            return ((to_uppercase (substring key 0 1)) + (substring key 1 (strlen key)))
        }
        if (key == "date") { return "Päivä" }
        if (key == "time") { return "Aika" }
        if (key == "what") { return "Mitä" }
        if (key == "who") { return "Kuka" }
        return key
    }
}
