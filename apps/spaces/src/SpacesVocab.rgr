    sfn family:void (s:SpSpace lang:string today:int mon:int) {
        s.addResource("aino" "Aino" "rose")
        s.addResource("eero" "Eero" "blue")
        s.addResource("leo" "Leo" "emerald")
        s.addResource("nappi" "Nappi" "amber")
        SpSeed.who((SpSeed.weekly(s (SpWords.pick(lang "Football practice" "Jalkapallotreenit")) (mon - 28) 1050 1140 "eero" ([] _:int ( 2 4 )))) lang "takes" "vie" "Juho")
        SpSeed.who((SpSeed.weekly(s (SpWords.pick(lang "Piano lesson" "Pianotunti")) (mon - 28) 960 1005 "aino" ([] _:int ( 3 )))) lang "picks up" "hakee" "Mia")
        SpSeed.who((SpSeed.weekly(s (SpWords.pick(lang "Swimming" "Uinti")) (mon - 28) 600 660 "leo" ([] _:int ( 6 )))) lang "takes" "vie" "Mia")
        SpSeed.who((s.addEvent((SpWords.pick(lang "Dentist" "Hammaslääkäri")) today 840 870 "aino")) lang "takes" "vie" "Juho")
        SpSeed.who((s.addEvent((SpWords.pick(lang "Parents' evening" "Vanhempainilta")) (mon + 3) 1080 1170 "")) lang "attends" "osallistuu" "Mia")
        def vac:SpEvent (SpSeed.who((s.addEvent((SpWords.pick(lang "Cat's vaccination" "Nappin rokotus")) (mon + 9) 600 630 "nappi")) lang "takes" "vie" "Juho"))
        vac.important = true
        s.addAllDay((SpWords.pick(lang "Grandparents visit" "Isovanhemmat kylässä")) (mon + 12) (mon + 13) "")
        SpSeed.who((s.addEvent((SpWords.pick(lang "Birthday party" "Synttärit")) (mon + 12) 780 900 "leo")) lang "takes" "vie" "Mia")
        s.addDeadline((SpWords.pick(lang "Pay the school trip" "Maksa luokkaretki")) (mon + 4) "eero")
        s.addDeadline((SpWords.pick(lang "Sign the permission slip" "Allekirjoita lupalappu")) (mon + 8) "eero")
        s.addDeadline((SpWords.pick(lang "Return library books" "Palauta kirjaston kirjat")) (today - 1) "aino")
        s.addSheet((SpSeed.sheet("s1" (SpWords.pick(lang "Driving rota" "Kuskausvuorot")) lang
            ([] _:string ( "date" "time" "what" "who" ))
            ([] _:int ( (today + 1) (mon + 8) (mon + 10) ))
            ([] _:string ( "17.15" (SpWords.pick(lang "Drive to practice" "Treenikyyti")) "Eero" "17.15" (SpWords.pick(lang "Drive to practice" "Treenikyyti")) "Leo" "15.45" (SpWords.pick(lang "Pick up from piano" "Haku pianotunnilta")) "Aino" )))))
        s.addDoc((SpWords.pick(lang "Holiday plans" "Lomasuunnitelmat"))
            (SpWords.pick(lang "# Holiday plans\n\n- Cabin week: decide the dates.\n- Who looks after the cat?\n- Packing list in Sheets."
                "# Lomasuunnitelmat\n\n- Mökkiviikko: päätetään päivät.\n- Kuka hoitaa kissan?\n- Pakkauslista Taulukoissa.")) (mon - 5))
    }

    ; Two clients and a van; Ella and Oskari own them.
    sfn business:void (s:SpSpace lang:string today:int mon:int) {
        def van:string (SpWords.pick(lang "Delivery van" "Pakettiauto"))
        s.addResource("kide" (SpWords.pick(lang "Kide Ltd" "Kide Oy")) "blue")
        s.addResource("vireo" (SpWords.pick(lang "Vireo Ltd" "Vireo Oy")) "emerald")
        s.addResource("van" van "violet")
        SpSeed.weekly(s (SpWords.pick(lang "Team stand-up" "Tiimin aamupalaveri")) (mon - 28) 540 555 "" ([] _:int ( 1 2 3 4 5 )))
        SpSeed.who((SpSeed.weekly(s (SpWords.pick(lang "Account review" "Asiakaskatsaus")) (mon - 28) 780 840 "vireo" ([] _:int ( 3 )))) lang "leads" "vetää" "Oskari")
        SpSeed.who((s.addEvent((SpWords.pick(lang "Customer workshop" "Asiakastyöpaja")) today 600 720 "kide")) lang "leads" "vetää" "Ella")
        def qr:SpEvent (SpSeed.who((s.addEvent((SpWords.pick(lang "Quarterly review" "Kvartaalikatsaus")) (mon + 9) 780 900 "kide")) lang "leads" "vetää" "Ella"))
        qr.important = true
        SpSeed.who((s.addAllDay((SpWords.pick(lang "Trade fair" "Messut")) (mon + 10) (mon + 11) "van")) lang "drives" "ajaa" "Oskari")
        s.addDeadline((SpWords.pick(lang "Offer to customer" "Tarjous asiakkaalle")) (mon + 4) "vireo")
        s.addDeadline((SpWords.pick(lang "Van inspection" "Pakettiauton katsastus")) (mon + 7) "van")
        s.addDeadline((SpWords.pick(lang "Approve invoices" "Hyväksy laskut")) (today - 1) "kide")
        s.addSheet((SpSeed.sheet("s1" (SpWords.pick(lang "Visits and deliveries" "Käynnit ja toimitukset")) lang
            ([] _:string ( "date" "time" "what" "who" ))
            ([] _:int ( today (today + 1) (mon + 8) ))
            ([] _:string ( "12-16" (SpWords.pick(lang "Site visit" "Asiakaskäynti")) (SpWords.pick(lang "Vireo Ltd" "Vireo Oy")) "8-12" (SpWords.pick(lang "Delivery" "Toimitus")) van "8-16" (SpWords.pick(lang "Installation" "Asennus")) (SpWords.pick(lang "Kide Ltd" "Kide Oy")) )))))
        s.addDoc((SpWords.pick(lang "Q4 goals" "Q4-tavoitteet"))
            (SpWords.pick(lang "# Q4 goals\n\n- Three new customers.\n- Visits and deliveries kept in Sheets.\n- Review every Friday."
                "# Q4-tavoitteet\n\n- Kolme uutta asiakasta.\n- Käynnit ja toimitukset Taulukoissa.\n- Katsaus joka perjantai.")) (mon - 4))
