; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; SpacesTypes — what an entry of a space can be: its type, kind and fields
; =============================================================================
; The schema is one JSON file shared with the server
; (mcp-go/assets/warden-types.json); the build writes it into
; SpacesTypesData.rgr, and the server offers the same list with
; list_entry_types. Each type has an id, a kind (event: on the calendar;
; deadline: a day something is due, with a reminder; record: kept in a list,
; a date optional), the vocabulary packs that offer it ("*" for all; the
; demo pack offers every type), a name and help in English and Finnish, its
; fields and, for a type that costs something, the cost's label.
;
; Field values are kept as text with their JSON kind (string, number, bool);
; `SpTypes.normalize` turns what was typed into a field into that value, or
; says why it does not read. Nothing here draws.
; =============================================================================

Import "SpacesTypesData.rgr"
Import "../vela/src/VlJson.rgr"
Import "../evgui/src/UiDate.rgr"

; A word in English and Finnish.
class SpWord {
    def key:string ""
    def en:string ""
    def fi:string ""
    Constructor () {
    }

    fn text:string (lang:string) {
        if ((lang == "fi") && ((strlen fi) > 0)) {
            return fi
        }
        return en
    }

    sfn read:SpWord (key:string o:VlJson) {
        def w (new SpWord())
        w.key = key
        if (o.isObject()) {
            w.en = (o.stringOr("en" ""))
            w.fi = (o.stringOr("fi" ""))
        }
        return w
    }
}

class SpField {
    def key:string ""
    ; text, longtext, date, time, number, money, bool, choice, ward, person,
    ; phone, email, url, months, weektimes
    def type:string "text"
    def name:SpWord (new SpWord())
    def options:[string]
    def labels:[SpWord]
    Constructor () {
    }

    fn label:string (lang:string) {
        return (name.text(lang))
    }

    ; An option's label, or the option itself.
    fn optionLabel:string (lang:string option:string) {
        def i:int 0
        while (i < (array_length labels)) {
            def w:SpWord (itemAt labels i)
            if (w.key == option) {
                return (w.text(lang))
            }
            i = (i + 1)
        }
        return option
    }

    ; How the value is kept in JSON: "number", "bool" or "string".
    fn valueKind:string () {
        return (SpTypes.kindOfField(type))
    }

    ; Picked from a few buttons rather than typed.
    fn picked:boolean () {
        return (((type == "choice") || (type == "bool")) || (type == "ward"))
    }
}

class SpType {
    def id:string ""
    ; event, deadline or record
    def kind:string "event"
    def packs:[string]
    def icon:string ""
    def name:SpWord (new SpWord())
    def help:SpWord (new SpWord())
    def fields:[SpField]
    def hasCost:boolean false
    def cost:SpWord (new SpWord())
    def repeats:boolean false
    ; what kind of family item it is (event, activity, booking, deadline,
    ; financial, asset_action, care, health, travel, reminder)
    def group:string "event"
    ; the page that shows its entries instead of the lists and the Add menu
    ; ("questions"; "" for none)
    def page:string ""
    ; kept for entries made before; new ones take `replacedBy`
    def legacy:boolean false
    def replacedBy:string ""
    ; the types whose days an entry of this one skips, for the same ward
    def skips:[string]
    ; its own window to get something in: the date field it is got by ("date":
    ; the entry's day; "": none), while `whenField` is `whenIs`, until one of
    ; `doneFields` is set (or has the value of `doneIs` beside it)
    def getBy:string ""
    def whenField:string ""
    def whenIs:string ""
    def doneFields:[string]
    def doneIs:[string]
    ; the other types' lists an entry is in too, while its alsoField is alsoIs
    def alsoTypes:[string]
    def alsoFields:[string]
    def alsoIs:[string]
    ; number fields that remind at once when at most a limit: the field in
    ; `lowAts` beside it, or `lowDefaults` when that is not set
    def lowFields:[string]
    def lowAts:[string]
    def lowDefaults:[double]
    Constructor () {
    }

    fn field@(optional):SpField (key:string) {
        def found@(optional):SpField
        def i:int 0
        while (i < (array_length fields)) {
            def f:SpField (itemAt fields i)
            if (f.key == key) {
                found = f
            }
            i = (i + 1)
        }
        return found
    }

    ; Offered in a vocabulary pack: "*" offers it everywhere, and the demo
    ; pack offers every type.
    fn offeredIn:boolean (pack:string) {
        if (pack == "demo") {
            return true
        }
        def i:int 0
        while (i < (array_length packs)) {
            def p:string (itemAt packs i)
            if ((p == "*") || (p == pack)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; On the calendar (event, deadline) or kept in a list (record).
    fn listed:boolean () {
        return ((kind == "record") || (kind == "deadline"))
    }
}

class SpTypes {
    def types:[SpType]
    Constructor () {
    }

    ; The schema the page was built with.
    sfn builtin:SpTypes () {
        return (SpTypes.parse((SpTypesData.json())))
    }

    ; {types:[…]} — the schema file and list_entry_types answer alike. An
    ; answer that does not read is no types.
    sfn parse:SpTypes (text:string) {
        def p (new VlJsonParser())
        def v:VlJson (p.parse(text))
        def out (new SpTypes())
        if ((p.ok == false) || ((v.isObject()) == false)) {
            return out
        }
        out.read((v.get("types")))
        return out
    }

    fn read:void (list:VlJson) {
        def none:[SpType]
        types = none
        def i:int 0
        while (i < (list.count())) {
            def o:VlJson (list.at(i))
            if (o.isObject()) {
                push types (SpTypes.readType(o))
            }
            i = (i + 1)
        }
    }

    sfn readType:SpType (o:VlJson) {
        def t (new SpType())
        t.id = (o.stringOr("id" ""))
        t.kind = (o.stringOr("kind" "event"))
        t.icon = (o.stringOr("icon" ""))
        t.name = (SpWord.read(t.id (o.get("name"))))
        t.help = (SpWord.read("" (o.get("help"))))
        t.repeats = (o.boolOr("repeats" false))
        t.group = (o.stringOr("group" "event"))
        t.legacy = (o.boolOr("legacy" false))
        t.page = (o.stringOr("page" ""))
        t.replacedBy = (o.stringOr("replaced_by" ""))
        def c:VlJson (o.get("cost"))
        if (c.isObject()) {
            t.hasCost = true
            t.cost = (SpWord.read("cost" c))
        }
        def sk:VlJson (o.get("skips"))
        def si:int 0
        while (si < (sk.count())) {
            def sv:VlJson (sk.at(si))
            if (sv.isString()) {
                push t.skips sv.str
            }
            si = (si + 1)
        }
        def g:VlJson (o.get("get"))
        if (g.isObject()) {
            t.getBy = (g.stringOr("by" ""))
            def w:VlJson (g.get("when"))
            if (w.isObject()) {
                t.whenField = (w.stringOr("field" ""))
                t.whenIs = (w.stringOr("is" ""))
            }
            def dn:VlJson (g.get("done"))
            def q:int 0
            while (q < (dn.count())) {
                def dc:VlJson (dn.at(q))
                if (dc.isObject()) {
                    push t.doneFields (dc.stringOr("field" ""))
                    push t.doneIs (dc.stringOr("is" ""))
                }
                q = (q + 1)
            }
        }
        def al:VlJson (o.get("also"))
        def ai:int 0
        while (ai < (al.count())) {
            def ao:VlJson (al.at(ai))
            if (ao.isObject()) {
                def aw:VlJson (ao.get("when"))
                if (aw.isObject()) {
                    push t.alsoTypes (ao.stringOr("type" ""))
                    push t.alsoFields (aw.stringOr("field" ""))
                    push t.alsoIs (aw.stringOr("is" ""))
                }
            }
            ai = (ai + 1)
        }
        def lows:VlJson (o.get("low"))
        def li:int 0
        while (li < (lows.count())) {
            def lo:VlJson (lows.at(li))
            if (lo.isObject()) {
                push t.lowFields (lo.stringOr("field" ""))
                push t.lowAts (lo.stringOr("at" ""))
                push t.lowDefaults (lo.doubleOr("default" 0.0))
            }
            li = (li + 1)
        }
        def ps:VlJson (o.get("packs"))
        def i:int 0
        while (i < (ps.count())) {
            def p:VlJson (ps.at(i))
            if (p.isString()) {
                push t.packs p.str
            }
            i = (i + 1)
        }
        def fs:VlJson (o.get("fields"))
        def k:int 0
        while (k < (fs.count())) {
            def fo:VlJson (fs.at(k))
            if (fo.isObject()) {
                def f (new SpField())
                f.key = (fo.stringOr("key" ""))
                f.type = (fo.stringOr("type" "text"))
                f.name = (SpWord.read(f.key (fo.get("name"))))
                def opts:VlJson (fo.get("options"))
                def j:int 0
                while (j < (opts.count())) {
                    def ov:VlJson (opts.at(j))
                    if (ov.isString()) {
                        push f.options ov.str
                    }
                    j = (j + 1)
                }
                def labels:VlJson (fo.get("labels"))
                if (labels.isObject()) {
                    def m:int 0
                    while (m < (array_length labels.keys)) {
                        def lk:string (itemAt labels.keys m)
                        push f.labels (SpWord.read(lk (labels.get(lk))))
                        m = (m + 1)
                    }
                }
                push t.fields f
            }
            k = (k + 1)
        }
        return t
    }

    fn find@(optional):SpType (id:string) {
        def found@(optional):SpType
        def i:int 0
        while (i < (array_length types)) {
            def t:SpType (itemAt types i)
            if (t.id == id) {
                found = t
            }
            i = (i + 1)
        }
        return found
    }

    ; The kind of a type id: "" (no type) and unknown types are events.
    fn kindOf:string (id:string) {
        def t@(optional):SpType (this.find(id))
        if (null? t) {
            return "event"
        }
        def tt:SpType t
        return tt.kind
    }

    ; The types a pack offers, in the schema's order; not the legacy ones,
    ; nor those a page of their own shows (questions).
    fn forPack:[SpType] (pack:string) {
        def out:[SpType]
        def i:int 0
        while (i < (array_length types)) {
            def t:SpType (itemAt types i)
            if ((t.offeredIn(pack)) && ((t.legacy == false) && ((strlen t.page) == 0))) {
                push out t
            }
            i = (i + 1)
        }
        return out
    }

    ; The types of a pack that are kept in lists (records and deadlines).
    fn listedFor:[SpType] (pack:string) {
        def out:[SpType]
        def all:[SpType] (this.forPack(pack))
        def i:int 0
        while (i < (array_length all)) {
            def t:SpType (itemAt all i)
            if (t.listed()) {
                push out t
            }
            i = (i + 1)
        }
        return out
    }

    ; The groups of a pack's types, in the order the Add menu shows them.
    sfn groups:[string] () {
        return ([] _:string ( "event" "activity" "care" "health" "travel" "booking" "deadline" "reminder" "financial" "asset_action" ))
    }

    sfn kindOfField:string (type:string) {
        if ((((type == "number") || (type == "money")) || (type == "months"))) {
            return "number"
        }
        if (type == "bool") {
            return "bool"
        }
        return "string"
    }

    ; --- reading what was typed ----------------------------------------------------

    ; A number as typed: "12", "12.50", "12,50", "1 200,5", "12 €"; -1.0
    ; when there is no number in it.
    sfn amountOf:double (text:string) {
        def t:string ""
        def i:int 0
        def n:int (strlen text)
        while (i < n) {
            def c:int (charAt text i)
            if (c == 44) {
                t = (t + ".")
            } {
                if ((c >= 48) && (c <= 57)) {
                    t = (t + (substring text i (i + 1)))
                }
                if ((c == 46) || (c == 45)) {
                    t = (t + (substring text i (i + 1)))
                }
            }
            i = (i + 1)
        }
        if ((strlen t) == 0) {
            return -1.0
        }
        def d@(optional):double (str2double t)
        if (null? d) {
            return -1.0
        }
        return (unwrap d)
    }

    ; Whether `text` reads as a number: digits with one decimal point or
    ; comma, spaces, and a euro sign.
    sfn readsAsNumber:boolean (text:string) {
        def t:string (trim text)
        if ((strlen t) == 0) {
            return false
        }
        def digits:int 0
        def points:int 0
        def i:int 0
        while (i < (strlen t)) {
            def c:int (charAt t i)
            def ok:boolean false
            if ((c >= 48) && (c <= 57)) {
                digits = (digits + 1)
                ok = true
            }
            if ((c == 44) || (c == 46)) {
                points = (points + 1)
                ok = true
            }
            if ((c == 32) || (c == 160)) {
                ok = true
            }
            if ((c == 8364) || ((c == 45) && (i == 0))) {
                ok = true
            }
            if (ok == false) {
                return false
            }
            i = (i + 1)
        }
        return ((digits > 0) && (points <= 1))
    }

    ; What a field's typed text is kept as: "" for an empty field (the value
    ; is removed), the text itself for text fields, a plain number ("12.5")
    ; for numbers, "true"/"false" for a switch, "YYYY-MM-DD" for a date,
    ; "HH:MM" for a time and "MO 08:15-13:00; TU …" for times per weekday.
    ; `err` is set to the field type when it does not read, and the text is
    ; returned as it was.
    sfn normalize:string (type:string text:string year:int err:[string]) {
        def t:string (trim text)
        if ((strlen t) == 0) {
            return ""
        }
        def kind:string (SpTypes.kindOfField(type))
        if (kind == "number") {
            if ((SpTypes.readsAsNumber(t)) == false) {
                push err type
                return t
            }
            def v:double (SpTypes.amountOf(t))
            if ((type == "months") || (type == "number")) {
                if (type == "months") {
                    if (v < 1.0) {
                        push err type
                        return t
                    }
                }
            }
            return (SpTypes.numText(v))
        }
        if (kind == "bool") {
            def l:string (to_lowercase t)
            if ((((l == "true") || (l == "yes")) || (l == "kyllä")) || (l == "1")) {
                return "true"
            }
            return "false"
        }
        if (type == "date") {
            def d:int (SpTypes.dayOf(t year))
            if (d < 0) {
                push err type
                return t
            }
            return (UiDate.isoOfDays(d))
        }
        if (type == "time") {
            def m:int (SpTypes.minuteOf(t))
            if (m < 0) {
                push err type
                return t
            }
            return (SpTypes.hhmm(m))
        }
        if (type == "weektimes") {
            def wk:SpWeek (SpWeek.read(t))
            if (wk.ok == false) {
                push err type
                return t
            }
            return (wk.toText())
        }
        if (type == "email") {
            if ((indexOf t "@") <= 0) {
                push err type
            }
            return t
        }
        return t
    }

    ; A number as JSON writes it: "12", "12.5", "0.25".
    sfn numText:string (v:double) {
        def j:VlJson (VlJson.numberValue(v))
        def w (new VlJsonWriter())
        return (w.write(j))
    }

    ; "2026-10-19", "19.10.2026", "19.10." (in `year`) into a day, or -1.
    sfn dayOf:int (s:string year:int) {
        def t:string (trim s)
        if ((indexOf t "-") > 0) {
            def p:[string] (strsplit t "-")
            if ((array_length p) == 3) {
                return (SpTypes.ymd((SpTypes.digits((itemAt p 0))) (SpTypes.digits((itemAt p 1))) (SpTypes.digits((itemAt p 2)))))
            }
            return -1
        }
        if ((indexOf t ".") > 0) {
            def q:[string] (strsplit t ".")
            if ((array_length q) >= 2) {
                def y:int year
                if ((array_length q) >= 3) {
                    if ((strlen (trim (itemAt q 2))) > 0) {
                        y = (SpTypes.digits((itemAt q 2)))
                    }
                }
                return (SpTypes.ymd(y (SpTypes.digits((itemAt q 1))) (SpTypes.digits((itemAt q 0)))))
            }
        }
        return -1
    }

    sfn ymd:int (y:int m:int d:int) {
        if ((y < 1970) || ((m < 1) || ((m > 12) || (d < 1)))) {
            return -1
        }
        if (d > (UiDate.daysInMonth(y m))) {
            return -1
        }
        return (UiDate.toDays(y m d))
    }

    sfn digits:int (s:string) {
        def t:string (trim s)
        if ((strlen t) == 0) {
            return -1
        }
        def v:int 0
        def i:int 0
        while (i < (strlen t)) {
            def c:int (charAt t i)
            if ((c < 48) || (c > 57)) {
                return -1
            }
            v = ((v * 10) + (c - 48))
            i = (i + 1)
        }
        return v
    }

    ; "9", "9:30", "9.30" into minutes, or -1.
    sfn minuteOf:int (s:string) {
        def t:string (trim s)
        if ((strlen t) == 0) {
            return -1
        }
        def at:int (indexOf t ":")
        if (at < 0) {
            at = (indexOf t ".")
        }
        if (at < 0) {
            def h0:int (SpTypes.digits(t))
            if ((h0 < 0) || (h0 > 23)) {
                return -1
            }
            return (h0 * 60)
        }
        def h:int (SpTypes.digits((substring t 0 at)))
        def m:int (SpTypes.digits((substring t (at + 1) (strlen t))))
        if ((h < 0) || ((h > 23) || ((m < 0) || (m > 59)))) {
            return -1
        }
        return ((h * 60) + m)
    }

    sfn hhmm:string (m:int) {
        def h:int (idiv m 60)
        def mm:int (m - (h * 60))
        def hs:string (to_string h)
        if (h < 10) {
            hs = ("0" + hs)
        }
        def ms:string (to_string mm)
        if (mm < 10) {
            ms = ("0" + ms)
        }
        return (hs + ":" + ms)
    }

    ; Euros as people write them: "12,50 €" in Finnish, "€12.50" in English;
    ; whole euros without the cents.
    sfn money:string (lang:string v:double) {
        def neg:boolean (v < 0.0)
        def a:double v
        if neg {
            a = (0.0 - v)
        }
        def cents:int (to_int ((a * 100.0) + 0.5))
        def whole:int (idiv cents 100)
        def rest:int (cents - (whole * 100))
        def ws:string (to_string whole)
        def body:string ws
        if (rest > 0) {
            def rs:string (to_string rest)
            if (rest < 10) {
                rs = ("0" + rs)
            }
            if (lang == "fi") {
                body = (ws + "," + rs)
            } {
                body = (ws + "." + rs)
            }
        }
        def sign:string ""
        if neg {
            sign = "-"
        }
        if (lang == "fi") {
            return (sign + body + " €")
        }
        return (sign + "€" + body)
    }
}

; A start and an end time for each weekday (a weektimes field: a school's
; day, "MO 08:15-13:00; TU 09:00-14:15"). Read from what people write in
; English or Finnish: "ma 8.15-13, ti 9-14.15", "ma–to klo 8.15–14"; days
; written without a time take the next time given. Weekdays are UiDate's,
; 0 = Sunday; a day off is -1.
class SpWeek {
    def starts:[int]
    def ends:[int]
    def ok:boolean false
    Constructor () {
        def i:int 0
        while (i < 7) {
            push starts -1
            push ends -1
            i = (i + 1)
        }
    }

    ; the ways a weekday is written, Monday first
    sfn names:[string] () {
        return ([] _:string ( "mo mon monday ma maanantai maanantaisin" "tu tue tuesday ti tiistai tiistaisin" "we wed wednesday ke keskiviikko keskiviikkoisin" "th thu thursday to torstai torstaisin" "fr fri friday pe perjantai perjantaisin" "sa sat saturday la lauantai lauantaisin" "su sun sunday sunnuntai sunnuntaisin" ))
    }

    ; a written weekday as UiDate's weekday, or -1
    sfn dayOf:int (word:string) {
        def w:string (to_lowercase (trim word))
        if ((strlen w) == 0) {
            return -1
        }
        def all:[string] (SpWeek.names())
        def i:int 0
        while (i < 7) {
            def ns:[string] (strsplit (itemAt all i) " ")
            def k:int 0
            while (k < (array_length ns)) {
                if ((itemAt ns k) == w) {
                    return ((i + 1) % 7)
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        return -1
    }

    ; dashes as "-", the separators of items as ","; dots and colons after a
    ; day's name ("ma." "ma:") dropped
    sfn clean:string (text:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen text)) {
            def c:int (charAt text i)
            def s:string (substring text i (i + 1))
            if ((c == 8211) || (c == 8212)) {
                s = "-"
            }
            if ((c == 59) || (c == 10)) {
                s = ","
            }
            out = (out + s)
            i = (i + 1)
        }
        return out
    }

    sfn read:SpWeek (text:string) {
        def w (new SpWeek())
        def items:[string] (strsplit (SpWeek.clean(text)) ",")
        def pending:[int]
        def i:int 0
        while (i < (array_length items)) {
            def item:string (trim (itemAt items i))
            if ((strlen item) > 0) {
                ; the days are what comes before the first digit
                def at:int 0
                def n:int (strlen item)
                while ((at < n) && (((charAt item at) < 48) || ((charAt item at) > 57))) {
                    at = (at + 1)
                }
                def dayPart:string (substring item 0 at)
                def timePart:string (substring item at n)
                def words:[string]
                def raw:[string] (strsplit (to_lowercase dayPart) " ")
                def r:int 0
                while (r < (array_length raw)) {
                    def word:string (trim (itemAt raw r))
                    def last:int ((strlen word) - 1)
                    if (last >= 0) {
                        def lc:int (charAt word last)
                        if ((lc == 46) || (lc == 58)) {
                            word = (substring word 0 last)
                        }
                    }
                    if ((strlen word) > 0) {
                        if ((((word != "klo") && (word != "kello")) && (word != "at")) && (word != "from")) {
                            push words word
                        }
                    }
                    r = (r + 1)
                }
                def days:[int]
                def joined:string (join words " ")
                def dash:int (indexOf joined "-")
                if (dash >= 0) {
                    def a:int (SpWeek.dayOf((substring joined 0 dash)))
                    def b:int (SpWeek.dayOf((substring joined (dash + 1) (strlen joined))))
                    ; Monday-first positions
                    def pa:int ((a + 6) % 7)
                    def pb:int ((b + 6) % 7)
                    if (((a < 0) || (b < 0)) || (pb < pa)) {
                        return w
                    }
                    def p:int pa
                    while (p <= pb) {
                        push days ((p + 1) % 7)
                        p = (p + 1)
                    }
                } {
                    def k:int 0
                    while (k < (array_length words)) {
                        def d:int (SpWeek.dayOf((itemAt words k)))
                        if (d < 0) {
                            return w
                        }
                        push days d
                        k = (k + 1)
                    }
                }
                if ((array_length days) == 0) {
                    return w
                }
                def m:int 0
                while (m < (array_length days)) {
                    push pending (itemAt days m)
                    m = (m + 1)
                }
                if ((strlen (trim timePart)) > 0) {
                    def se:[string] (strsplit timePart "-")
                    if ((array_length se) != 2) {
                        return w
                    }
                    def s:int (SpTypes.minuteOf((itemAt se 0)))
                    def e:int (SpTypes.minuteOf((itemAt se 1)))
                    if (((s < 0) || (e < 0)) || (e <= s)) {
                        return w
                    }
                    def q:int 0
                    while (q < (array_length pending)) {
                        def pd:int (itemAt pending q)
                        if ((itemAt w.starts pd) >= 0) {
                            return w
                        }
                        set w.starts pd s
                        set w.ends pd e
                        q = (q + 1)
                    }
                    def none:[int]
                    pending = none
                }
            }
            i = (i + 1)
        }
        if ((array_length pending) > 0) {
            return w
        }
        def any:boolean false
        def z:int 0
        while (z < 7) {
            if ((itemAt w.starts z) >= 0) {
                any = true
            }
            z = (z + 1)
        }
        w.ok = any
        return w
    }

    fn on:boolean (wd:int) {
        return ((itemAt starts wd) >= 0)
    }

    ; the weekdays it has, 0 = Sunday, Monday first
    fn days:[int] () {
        def out:[int]
        def p:int 0
        while (p < 7) {
            def wd:int ((p + 1) % 7)
            if (this.on(wd)) {
                push out wd
            }
            p = (p + 1)
        }
        return out
    }

    ; "MO 08:15-13:00; TU 09:00-14:15", as the server keeps it
    fn toText:string () {
        def codes:[string] ([] _:string ( "SU" "MO" "TU" "WE" "TH" "FR" "SA" ))
        def parts:[string]
        def ds:[int] (this.days())
        def i:int 0
        while (i < (array_length ds)) {
            def wd:int (itemAt ds i)
            push parts ((itemAt codes wd) + " " + (SpTypes.hhmm((itemAt starts wd))) + "-" + (SpTypes.hhmm((itemAt ends wd))))
            i = (i + 1)
        }
        return (join parts "; ")
    }

    ; as people read it: "ma 8.15–13.00; ti 9.00–14.15" in Finnish, "Mon
    ; 8:15–13:00; Tue 9:00–14:15" in English
    fn shown:string (lang:string) {
        def fi:boolean (lang == "fi")
        def names:[string] ([] _:string ( "Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat" ))
        if fi {
            names = ([] _:string ( "su" "ma" "ti" "ke" "to" "pe" "la" ))
        }
        def parts:[string]
        def ds:[int] (this.days())
        def i:int 0
        while (i < (array_length ds)) {
            def wd:int (itemAt ds i)
            push parts ((itemAt names wd) + " " + (SpWeek.clock((itemAt starts wd) fi)) + "–" + (SpWeek.clock((itemAt ends wd) fi)))
            i = (i + 1)
        }
        return (join parts "; ")
    }

    sfn clock:string (m:int fi:boolean) {
        def h:int (idiv m 60)
        def mm:int (m - (h * 60))
        def ms:string (to_string mm)
        if (mm < 10) {
            ms = ("0" + ms)
        }
        if fi {
            return ((to_string h) + "." + ms)
        }
        return ((to_string h) + ":" + ms)
    }
}
