{
  "hosting": {
    "public": "web/dist-view",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "/main/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/*.@(js|mjs|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/gl/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/skins/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(pres|ui|chart-editor|toolbar|hint|panels).css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/themes/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/i18n/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|mjs|css|json|md|svg|ttf|csv)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/editor",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/editor/**",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/main/admin/api/**",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/mcp",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/oauth/**",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/**",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/.well-known/openid-configuration",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/d/**",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/hit",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/view/**",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/export/**",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/card/**",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/s/**",
        "run": {
          "serviceId": "sliqtly-mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/main/admin",
        "destination": "/main/admin.html"
      }
    ],
    "redirects": [
      {
        "source": "/download/sliqtly-personal_amd64.deb",
        "destination": "https://firebasestorage.googleapis.com/v0/b/sliqtly.firebasestorage.app/o/downloads%2Fpersonal%2Fsliqtly-personal_latest_amd64.deb?alt=media",
        "type": 302
      },
      {
        "source": "/download/sliqtly-personal_arm64.deb",
        "destination": "https://firebasestorage.googleapis.com/v0/b/sliqtly.firebasestorage.app/o/downloads%2Fpersonal%2Fsliqtly-personal_latest_arm64.deb?alt=media",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
